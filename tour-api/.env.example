# Pynwheel Tour App API - environment. Copy to .env (git-ignored) and edit.

# The Pynwheel database (the same one the Rails CMS uses). The API opens it
# READ-ONLY: every connection sets default_transaction_read_only=on, so even
# a bug cannot write. Development example; production uses the CMS's DATABASE_URL.
TOUR_API_DATABASE_URL=postgres://zubairzulifqar@localhost/pynwheel_development

# The Rails CMS, for the two calls the API makes to it: the Doorkeeper
# password grant (login) and token revocation (logout).
TOUR_API_RAILS_URL=http://127.0.0.1:3100

# Public base for upload URLs when the database names a file without an S3
# copy (development only; production records carry S3 URLs).
TOUR_API_PUBLIC_UPLOADS_URL=http://127.0.0.1:3100

# Browser / Capacitor origins allowed to call the API.
TOUR_API_CORS_ORIGINS=http://127.0.0.1:3012,http://localhost:3012,capacitor://localhost,http://localhost,https://localhost,ionic://localhost

# development | staging | production (production hides the OpenAPI docs).
TOUR_API_ENV=development
TOUR_API_LOG_LEVEL=INFO

# Caches (seconds). The graph cache is keyed by the property's graph version,
# so a changed stop, path or configuration is seen on the next request.
TOUR_API_GRAPH_CACHE_TTL=900
TOUR_API_PROPERTY_LIST_CACHE_TTL=60
