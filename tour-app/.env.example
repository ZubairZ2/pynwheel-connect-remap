# Pynwheel Tour - app configuration (Vite). Copy to .env.local (git-ignored) to override.
# Where the Pynwheel CMS runs: the Tour App API is the Rails app (Api::TourApp::V1, under /api/tour/v1). No trailing slash.
VITE_TOUR_API_URL=http://127.0.0.1:3000
# pynwheel-api (real data, default) | dummy (offline demo data; development only)
VITE_TOUR_DATA_SOURCE=pynwheel-api
VITE_TOUR_API_TIMEOUT=20000

# Release APK / IPA: .env.production points at the Heroku CMS (https). For a build that talks to the CMS on
# your own machine instead, create .env.production.local (git-ignored):
#   VITE_TOUR_API_URL=http://<your-machine-lan-ip>:3100
# then `npm run build && npx cap sync android`; the phone must be on the same Wi-Fi, Rails must listen on
# 0.0.0.0, and only debug builds allow plain http (android/app/src/debug/AndroidManifest.xml).
# Delete .env.production.local again before a release build - it overrides .env.production.
