# Pynwheel Tour - app configuration (Vite). Copy to .env.local (git-ignored) to override.
# Where the Pynwheel Tour App API (tour-api/) runs. No trailing slash.
VITE_TOUR_API_URL=http://127.0.0.1:8000
# pynwheel-api (real data, default) | dummy (offline demo data; development only)
VITE_TOUR_DATA_SOURCE=pynwheel-api
VITE_TOUR_API_TIMEOUT=20000

# For an APK / IPA that talks to the API on your own machine, create .env.production.local (git-ignored):
#   VITE_TOUR_API_URL=http://<your-machine-lan-ip>:8000
# then `npm run build && npx cap sync`. The phone must be on the same network and the API must listen on 0.0.0.0.
