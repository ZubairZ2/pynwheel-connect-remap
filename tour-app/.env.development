# Development: the Tour App API is served by the Rails CMS (Api::TourApp::V1, prefix /api/tour/v1 on the
# CMS host). `rails server` listens on :3000; the verify server (.claude/launch.json `rails-cms-verify`) on
# :3100 - override here or in .env.development.local, or at launch (VITE_TOUR_API_URL=http://127.0.0.1:3100 npm run dev).
VITE_TOUR_API_URL=http://127.0.0.1:3000
VITE_TOUR_DATA_SOURCE=pynwheel-api
