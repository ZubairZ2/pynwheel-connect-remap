# Production build (`npm run build`, used by `npx cap sync`). The Tour App API is the Rails CMS itself,
# under /api/tour/v1 on the CMS host. This is the Heroku CMS; a custom domain later just replaces it.
# A release build must use https: the web view is strict (no mixed content, no cleartext).
#
# Precedence: an environment variable on the command line beats every file, and a git-ignored
# .env.production.local beats this file - so for a release APK either delete .env.production.local
# (it is only for a LAN development server) or build with the URL spelled out:
#   VITE_TOUR_API_URL=https://pyn-system-16a05cad79df.herokuapp.com npm run build && npx cap sync android
VITE_TOUR_API_URL=https://pyn-system-16a05cad79df.herokuapp.com
VITE_TOUR_DATA_SOURCE=pynwheel-api
