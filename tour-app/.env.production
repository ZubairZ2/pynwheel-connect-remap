# Production build. VITE_TOUR_API_URL is NOT committed: pass it in the build environment, e.g.
#   VITE_TOUR_API_URL=https://tour-api.pynwheel.com npm run build && npx cap sync
# It must be an https URL: release builds keep the web view strict (no mixed content, no cleartext).
VITE_TOUR_DATA_SOURCE=pynwheel-api
