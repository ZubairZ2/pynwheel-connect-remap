# Production build. VITE_TOUR_API_URL is NOT committed: pass it in the build environment - the https URL of
# the Pynwheel CMS host (the Tour App API is the Rails app itself, under /api/tour/v1), e.g.
#   VITE_TOUR_API_URL=https://<cms host> npm run build && npx cap sync android
# It must be an https URL: release builds keep the web view strict (no mixed content, no cleartext).
VITE_TOUR_DATA_SOURCE=pynwheel-api
