# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal
.ruby-gemset
.ruby-version
vendor/bundle/

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.idea/

public/uploads/*
vendor/bundle/
test/

.ruby-gemset
.ruby-version
/db/schema.rb
# Ignore Byebug command history file.
.byebug_history
config/database.yml
config/application.yml
config/database.yml
config/environments/development.rb
db/schema.rb

# Claude Code local tooling
.claude/

# ---------------------------------------------------------------------------
# Local-only material (never committed, not needed on Heroku). See context.md §9.
# ---------------------------------------------------------------------------

# The vendored bundle tree (`bundle install` with BUNDLE_PATH inside the repo)
/gems/
/cache/
/specifications/
/extensions/
/bundler/
/build_info/

# Generated binstubs and their lock files; the committed bin/* scripts stay tracked
/bin/*
!/bin/bundle
!/bin/delayed_job
!/bin/rails
!/bin/rake
!/bin/setup
!/bin/spring
!/bin/update

# Database dumps and restore leftovers
*.dump
latest.dump*
/toc.list
/toc-trimmed.list

