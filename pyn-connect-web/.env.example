# --- required ---------------------------------------------------------------
# Base URL of the existing Pynwheel CMS (Rails) application. Server-side only;
# this app makes every Rails call itself, so the value never reaches a browser.
PYNWHEEL_CMS_URL=http://127.0.0.1:3000

# --- optional ---------------------------------------------------------------
# Same URL, exposed to the browser for the "Forgot password?" link only.
NEXT_PUBLIC_CMS_URL=http://127.0.0.1:3000

# Text in the environment chip in the header. Defaults to STAGING.
NEXT_PUBLIC_ENV_LABEL=local

# Whether the session cookies carry the Secure flag. Defaults to true in
# production. Set to false ONLY when a production-mode instance is served over
# plain HTTP (an internal host, say) — otherwise the browser drops the cookie
# and sign-in appears to succeed but never sticks.
# PYN_CONNECT_COOKIE_SECURE=true

# Set to `off` to send every Connect route to the legacy Rails UI instead.
# PYN_CONNECT_REACT_FLOW=off
