.modal-dialog
  .modal-content
    = form_for @home_page_image,url: update_home_page_image_community_home_page_index_path(current_community,home_page_image_id: @home_page_image.id),method: :put do |f|
      .modal-body
        .image-crop
          = image_tag @home_page_image.image.url(:thumb), id: "cropbox",width: "600", height: "600"
          - %w[x y w h].each do |attribute|
            = f.hidden_field "crop_#{attribute}"  
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
            %i.fa.fa-close
        .form-group
          %label{:for => "exampleInputEmail1"} Image Title
          = f.text_field :name , class: "form-control", placeholder: "Name"
        .form-group
          %button.btn.btn-success.pull-right.btn-sm.mb-20#crop_image{:type => "submit"}
            Apply Changes
            %i.fa.fa-check
        .clearfix
:javascript 
  var width = $("#cropbox").width();
  var height = $("#cropbox").height();
  $("#crop_image").on("click",function(e){
    $(".divLoading").removeClass("hidden")
  });
  
  $('#cropbox').Jcrop({
    trueSize: [width, height],
    onSelect: update_crop,
    onChange: update_crop,
    aspectRatio: 1
  });
  

  function update_crop(coords){
    console.log(coords);
    var ratioW = $('#cropbox')[0].naturalWidth / $('#cropbox').width();
    var ratioH = $('#cropbox')[0].naturalHeight / $('#cropbox').height();
    var currentRatio = Math.min(ratioW, ratioH);
    $('#home_page_image_crop_x').val(Math.round(coords.x * currentRatio));
    $('#home_page_image_crop_y').val(Math.round(coords.y * currentRatio));
    $('#home_page_image_crop_w').val(Math.round(coords.w * currentRatio));
    $('#home_page_image_crop_h').val(Math.round(coords.h * currentRatio));
    //update_preview(coords);
  } 

  function update_preview(coords){
  var width = Math.round(100/coords.w * $('#cropbox').width()) + 'px';
  var height = Math.round(100/coords.h * $('#cropbox').height()) + 'px';
  var margin_left = '-' + Math.round(100/coords.w * coords.x) + 'px';
  var margin_top = '-' + Math.round(100/coords.h * coords.y) + 'px';
  $('#preview').css({"width": width,"height": height,"marginLeft": margin_left,"marginTop": margin_top});
  }      