.text-center.image-upload.home-page-drag-box#file-load-drop{:ondrop => "dropHandler(event);"}
  = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
  %p Drop video file here or click to upload.
- if current_community.design.home_page_video.present?
  .row
    .col-lg-3
      .slide-image
        .image-box.video-box
          .images.height-200
            = video_tag current_community.design.home_page_video.video.url.present? ? current_community.design.home_page_video.video.url : "", :controls => true, :autobuffer => true,:type => "video/mp4"
          .icons
            %a.text-danger{"data-name"=>"Video","data-href" => "/communities/#{current_community.id}/home_page/delete_home_page_video?home_page_video_id=#{current_community.design.home_page_video.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "##"} 
              %i.fa.fa-close
        %h4= current_community.design.home_page_video.video.filename     
          