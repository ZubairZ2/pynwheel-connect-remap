  var community_id = #{params[:community_id]}
  var design_id = #{current_community.design.id}

  $(document).ready(function(e){
    if (!(#{current_user.welcome_prompt}))
    {
      $('#welcome-prompt-modal1').modal('show');
    }
  });
  if (!#{current_user.welcome_homepage_page})
  {
    $('[data-toggle="selectHomepageTypePopover"]').popover({
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding">Changing the Home Page Type will change whether the home page shows a video or slideshow.</div><div class="popover-footer"><a id="selectHomepageTypePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
