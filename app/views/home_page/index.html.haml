- content_for :title, "Home Page - Pynwheel"
.divLoading.hidden
%section.is-home_page
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-home
        = @community.name.capitalize  
        %br
          -if current_user.is_super_admin?
            %small.text-primary
              = @community.code

    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          HOME PAGE
          %span
    %h4.mt-30
      Select Home Page Type
      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "selectHomepageTypePopover","data-content" => " "}
        %span#propertyDetailNameText
          Changing the Home Page Type will change whether the home page shows a video or slideshow.
    .row
      .col-lg-12.p-0
        .form-group 
          .radio.radio-primary.pull-left
            %input#images-loop-type-radio{:name => "loop_type_radio", :type => "radio", :value => "images_loop_type_radio",:checked=>current_community.design.has_images_loop_type? ? true : false}
              %label{:for => "main_screen_radio",:style=>"cursor: auto;"}
                Images
          .radio.radio-primary.pull-left.ml-20{:style => "margin-top:12px;"}
            %input#video-loop-type-radio{:name => "loop_type_radio", :type => "radio", :value => "video_loop_type_radio",:checked=>current_community.design.has_video_loop_type? ? true : false}
              %label{:for => "home_screen_radio",:style=>"cursor: auto;"}
                Video           
          - if gables_theme(@community)
            = link_to "Secondary Images", community_homepage_icons_path(@community), class: "btn btn-primary btn-file pull-right"
    .row
      .col-lg-4        
        .form-group        
          %label
            Animation
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "animationPopover","data-content" => " "}
              %span#propertyDetailNameText
                Changing Animation will change the movement of the menu buttons on the home page.
          = select_tag :animation, options_for_select(["bouncing effects","none"],@community.design.animation),{:class=>"form-control"}    
    .box.box-widget.panel-box.add-plan.pt-30
    
      = form_for @community, :method=>"PUT", :html=>{:id=>"home-page-image-form"}, :remote=>true  do |f|
        = hidden_field_tag "home_page_tab", true
        = f.fields_for :design do |d|
          = d.fields_for :expressionist do |e|
            .form-group.mt-30
              .row
                .form-group.mt-30
                  .col-lg-10
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Overlay text
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = e.text_area :overlay_text,:class=>"form-control mb-20 home-page-image-field ",:placeholder=>"Enter Overlay Text...", :rows => "3"
              .row
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Overlay text font
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = e.select :overlay_font , options_for_select(font_families,e.object.overlay_font),{},{class: "form-control home-page-image-field"}
              .row
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Overlay font size
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = e.select :overlay_size , options_for_select(font_sizes,e.object.overlay_size.present? ? e.object.overlay_size : '18px'),{},{class: "form-control home-page-image-field"}

              .row
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Overlay text color
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .input-group.colorpicker-style.hex-format-colorpicker
                        .input-group-addon
                          %i
                          = e.text_field :overlay_color , class: "form-control home-page-image-field",autocomplete: true,:value=>e.object.overlay_color.present? ? e.object.overlay_color : "#000000"
              .row
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Overlay text opacity
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = e.select :overlay_opacity , options_for_select(opacity_options,e.object.overlay_opacity.present? ? e.object.overlay_opacity : '100%'),{},{class: "form-control home-page-image-field"}
              .row
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Overlay text Position
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = e.select :overlay_text_position , options_for_select(["Left","Right","Center"],e.object.overlay_text_position.present? ? e.object.overlay_text_position : "Left"),{},{class: "form-control home-page-image-field"}
              .row
                .col-lg-10
                  .form-group.mt-30{:style => "margin-bottom: 0px;"}
                    .col-sm-12.col-lg-12.col-md-12
                      %button.btn-primary.done_btn{:onclick => "home_page_goBack()", :style => "margin-top: 0px;"}
                        DONE

    .bs-example.bs-example-tabs{"data-example-id" => "togglable-tabs"}
      #myTabContent.tab-content
        #image-slide.tab-pane.fade.active.in{:role => "tabpanel"}
          .row
            .col-lg-12

              .title-home
                %h4
                  Slide Show Images
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "slideShowImagePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Adding files will add images to the home page slide show. You can drag and drop the images below to rearrange them.
                  .br
                  %h4#slide_show_span
                    Images will appear at a size of 1920 x 1080 px. Please note that images that are too small may appear pixelated.

                %span.btn.btn-success.btn-file.text-UP{:onclick=>"$('#home-page-image-upload-holder').click();"}
                  %i.fa.fa-plus-circle
                  Add Files

          .row
            .col-lg-12
              .pull-right

          #images-index
            = render 'index'

        #video-slide.tab-pane.fade{:role => "tabpanel"}
          .row
            .col-lg-12
              .title-home
                %h4 Video Show
                %h4#slide_show_span
                  Home Page video size limit is 500MB.

                %span.btn.btn-success.btn-file.text-UP#file-load
                  %i.fa.fa-plus-circle
                  Add Video

                %div{:style => "margin-left: 125px;"}
                  %i.propertyDetailName.fa.fa-question-circle{:style => " margin-top: 10px;"}
                    %span#propertyDetailNameText
                      Adding a video file (MP4 files only) will change the video that appears on the the home page.

          .slide-imgage-boxs
            #videos-index
            = render 'videos_index'

        = form_for @uploader, url: upload_video_direct_community_home_page_index_path(@community), html: { multipart: true } do |f|
          = f.file_field :video, id: "video_field", class: "hidden"
          = f.submit "Upload Video", id: "video_submit", class: "hidden"

  #edit-image.modal.fade.edit-image
:javascript
  $("#file-load").on('click', function(e) {
    $('#video_field').click();
  });
  function home_page_goBack()
  {
    $('#home-page-image-form').submit();
    window.location.reload();

  }

  $("#file-load-drop").on('drop', function(e) {
  });
  function dropHandler(e)
  {
    if (e.dataTransfer.files[0].size < 500000000)
    {
      if (e.dataTransfer.files[0].type == "video/mp4")
      {
        $(".divLoading").removeClass("hidden");
        e.preventDefault();
        console.log(e.dataTransfer);
        video_field.files = e.dataTransfer.files;
        $("#video_submit").click();
      }
      else
      {
        $('#video-upload-warning').modal('show');
      }
    }
    else
    {
      $('#video-size-warning').modal('show');
    }
  }
  $("#video_field").on('change', function(e) {
    if (e.currentTarget.files[0].size < 500000000)
    {
      if (e.currentTarget.files[0].type == "video/mp4")
      {
        $(".divLoading").removeClass("hidden");
        $("#video_submit").click();
      }
      else
      {
        $('#video-upload-warning').modal('show');
      }
    }
    else
    {
      $('#video-size-warning').modal('show');
    }
  });
  
