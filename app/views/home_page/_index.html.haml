.row.slide-imgage-boxs.sortable
  - sortable_fetch(@home_page_images) do |home_page_image, id_tag|
    .col-lg-3{:id=> id_tag}
      .slide-image
        .image-box
          .images
            = image_tag home_page_image.image.url(:thumb)
          .icons
            = link_to show_image_in_modal_community_home_page_index_path(current_community,home_page_image_id: home_page_image.id), remote: true do 
              %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}
            
            %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{current_community.id}/home_page/delete_home_page_image?home_page_image_id=#{home_page_image.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
              %i.fa.fa-close
        %h4= home_page_image.name       

.modal.fade.bs-example-modal-lg.edit-image{"aria-hidden" => "true", "aria-labelledby" => "myLargeModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-body
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
            %i.fa.fa-close
        #carousel-example-generic.carousel.slide{"data-ride" => "carousel"}
          / Wrapper for slides
          .carousel-inner{:style=>"height: 500px;"}
            - @home_page_images.each_with_index do |home_page_image,index|
              .item.text-center{:class=>"#{index == 0 ? 'active' : ''}"}
                = image_tag home_page_image.image.url(:thumb),width: "600", height: "600"
                .carousel-caption
                  = home_page_image.name
            
          / Controls
          %a.left.carousel-control{"data-slide" => "prev", :href => "#carousel-example-generic", :role => "button"}
            %span.glyphicon.glyphicon-chevron-left
          %a.right.carousel-control{"data-slide" => "next", :href => "#carousel-example-generic", :role => "button"}
            %span.glyphicon.glyphicon-chevron-right 
:javascript
  $('.sortable').railsSortable({axis: "x"}); 
  var images_size = #{@home_page_images.size}
  images_size = parseInt(images_size);
  if(images_size == 0){
    $('#slideshow-button').hide();
  }
  else{
    $('#slideshow-button').show();
  }
                      