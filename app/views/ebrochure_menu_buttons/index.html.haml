- content_for :title, "Add Weblinks - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa{:class=>"fa-star"}
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title{:style => "margin-bottom: 0px"} Add Weblinks
          .col-md-6
            .mt-35
              - if @community.favorite_setting.ebrochure_menu_buttons.size <5
                = link_to new_community_favorite_setting_ebrochure_menu_button_path(@community,@favorite_setting), :class=>"btn btn-success pull-right" do
                  %i.fa.fa-plus-circle
                  ADD WEBLINKS
          .col-md-12.col-lg-12
            %button.btn-success.done_btn.mb-20{:onclick => "ebrochure_menu_button_goBack()",:style => "float: right;"}
              %i.fa.fa-plus-circle
              DONE
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header  
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #
                      %th Name
                      %th Link
                      %th Actions
                  %tbody
                    - @ebrochure_menu_buttons.each_with_index  do |e,index|
                      %tr
                        %td
                          = index+1
                        %td
                          = e.name
                        %td
                          = e.url
                        %td
                          = link_to edit_community_favorite_setting_ebrochure_menu_button_path(@community,@favorite_setting,e), :class=>"text-success" do
                            %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Weblink","data-href" => "/communities/#{@community.id}/favorite_settings/#{@favorite_setting.id}/ebrochure_menu_buttons/#{e.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size

                          

            
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12

:javascript
  function ebrochure_menu_button_goBack()
  {
    if (window.history.length == 1)
     {
      window.location.reload();
     }
     else
     {
      window.history.back();
     }
  }