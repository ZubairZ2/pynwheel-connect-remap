- content_for :title, "EbrochureMenuButton - Pynwheel"
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-star
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Add 
          %span Weblinks
      / /.box-header
      / form start
      / <form class="form-horizontal">
      = form_for [@community,@favorite_setting,@ebrochure_menu_button],:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , community_favorite_setting_ebrochure_menu_buttons_path(@community,@favorite_setting), :class=>"btn btn-default pull-right"
          = f.submit "SUBMIT", :class=>"btn btn-success pull-right mr-10"
