.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Amenity Name",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      Amenity.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img
        %a.preview-image{:href=>f.object.image? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Amenity Image"}
          = image_tag f.object.image? ? f.object.image.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :image     