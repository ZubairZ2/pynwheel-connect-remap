%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Home
    %li.active Settings
  .clearfix
.clearfix
/ Main content
%section
  .content
    .row.mt-25.mb-20
      .form-group
        %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
          Select Community
        .col-sm-12.col-lg-12.col-md-12.col-xs-12    
          = select_tag :communities, options_for_select(@communities.collect{|c| [c.name,c.id]}), :class=>"form-control"
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          %span Settings
      .box-body
        .row
          .col-lg-9.col-lg-offset-1
            #settings-form

:javascript
  showCredentialsForm(); 
  $('#communities').on('change', function() {
    showCredentialsForm(); 
  });        

      