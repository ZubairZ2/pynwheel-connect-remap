- content_for :title, "Data - Pynwheel"
.divLoading.hidden
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-gears
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    - if can? :add_settings, current_user 
      .row.mt-25.mb-20
        .form-group{:style=>"display: none;"}
          %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
            Select Community
          .col-sm-12.col-lg-12.col-md-12.col-xs-12    
            = select_tag :communities_on_settings, options_for_select(@communities.collect{|c| [c.name,c.id]},@community.id), :class=>"form-control"
      .box.box-info.add-plan.mt-20
        .box-header
          %h3.box-title
            %span Settings
        #settings-form

    .row#data-connection-buttons
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Test Data Connection 
        .box.box-widget.panel-box.pl-20.pr-20.pb-20
          .box-header
            %p
              This option allows you to test connection settings in the data section.A new browser window will open and attempt to write the data feed output.
            = link_to "Test Connection" , community_test_connection_path(current_community) , :class=>"btn btn-primary",:target=>"_blank"
            = link_to "Test Pricing" , community_psi_pricing_test_connection_path(current_community) , :class=>"btn btn-primary credential_fields",:target=>"_blank", :id => "entrata_pricing_button"
            = link_to "Test Space Configuration" , community_psi_space_configuration_test_connection_path(current_community) , :class=>"btn btn-primary credential_fields",:target=>"_blank", :id => "entrata_space_configuration_button"
            / = link_to "Store Pricing" , community_realpage_load_pricing_data_path(current_community) , :class=>"btn btn-primary credential_fields", :id => "realpage_store_pricing_button"
            / = link_to "Show Pricing" , community_show_realpage_pricing_data_path(current_community) , :class=>"btn btn-primary credential_fields",:target=>"_blank", :id => "realpage_show_pricing_button"
            %p{:style => "margin-bottom: -7px; margin-top: 10px;"}
              If the page that opens contains a bunch of data, it's probably good! If it contains one line that is an error message, then your data cannot be imported into Pynwheel. Please contact your data provider to troubleshoot.
        - if current_user.is_super_admin?
          .row
            .col-md-6
              %h4.title Import Vendor Data
          .box.box-widget.panel-box.pl-20.pr-20.pb-20
            .box-header
              %p
                This option allows you to import vendor data based on the settings in the data section.
              .callout.callout-danger
                %p
                  %i.fa.fa-warning
                  This action will either create new, or update existing, Unit and Floor plan records, based on the vendor's record IDs.
              = link_to "Import Unit Data" , community_import_path(current_community) , :class=>"btn btn-primary import_data"
              .btn.btn-warning{"data-name"=>"Previous data","data-href" => "/communities/#{current_community.id}/delete_imported_data", "data-target" => "#confirm-delete-replace-data", "data-toggle" => "modal", :href => "javascrip::;"} Replace Data
              .btn.btn-warning{"data-name"=>"Update data","data-href" => "/communities/#{current_community.id}/update_imported_data", "data-target" => "#confirm-delete-update-data", "data-toggle" => "modal", :href => "javascrip::;"} Update Data
              -#= link_to "Update Data" , community_update_imported_data_path(current_community) , :class=>"btn btn-warning"




:javascript
  var community_id = #{params[:community_id]}
  //showCredentialsForm(); 
  $.ajax({
        url: "/communities/"+community_id+"/credentials",
        type: "GET"
    }).done(function(){
      //validation for xlsx
      $("#community_credential_attributes_file").on('change',function(){
          if(this.files[0].type != "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"){
            $(this).val('');
            $('#spreadsheet-file-upload-warning').modal('show');
          }
      });
    });

  $('#communities_on_settings').on('change', function() {
    showCredentialsForm(); 
  });
  $('#realpage_store_pricing_button').click(function() {
    $('#realpage_store_pricing_button').attr("disabled", "disabled");
  });
  $(document).ready(function() {
    if (#{current_community.realpage_pricing_data_uploaded})
    {
      $('#realpage_store_pricing_button').prop('disabled', true);
    }
    else
    {
      $('#realpage_store_pricing_button').attr("disabled", "disabled");
    }
  });

        

      