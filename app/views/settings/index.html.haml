- content_for :title, "Settings - Pynwheel"
.divLoading.hidden
%section
  .content
    .row.mt-25.mb-20
      .form-group{:style=>"display: none;"}
        %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
          Select Community
        .col-sm-12.col-lg-12.col-md-12.col-xs-12    
          = select_tag :communities_on_settings, options_for_select(@communities.collect{|c| [c.name,c.id]},@community.id), :class=>"form-control"
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          %span Settings
      #settings-form


:javascript
  showCredentialsForm(); 
  $('#communities_on_settings').on('change', function() {
    showCredentialsForm(); 
  });        

      