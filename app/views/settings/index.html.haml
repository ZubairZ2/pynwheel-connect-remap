%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Home
    %li.active Settings
  .clearfix
.clearfix
/ Main content
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Communities
          %span Setting
      .box-body
        .row
          .col-lg-9.col-lg-offset-1
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Community
              .col-sm-12.col-lg-9.col-md-9.col-xs-12    
                = select_tag :communities, options_for_select(@communities.collect{|c| [c.name,c.id]}), :class=>"form-control" 
            #settings-form

:javascript
  showCredentialsForm(); 
  $('#communities').on('change', function() {
    showCredentialsForm(); 
  });        

      