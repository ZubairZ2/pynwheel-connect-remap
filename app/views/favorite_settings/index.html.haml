- content_for :title, "Favorites - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-star
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Favorite Settings
        .pull-right.btn-btn-danger
          = link_to "Favorite Images", community_favorite_setting_favorite_images_path(@community,@favorite), class: "btn btn-primary"
        .pull-right.btn-btn-danger.mr-20
          = link_to "Ebrochure menu buttons", community_favorite_setting_ebrochure_menu_buttons_path(@community,@community.favorite_setting), class: "btn btn-primary"  

      = form_for [@community,@favorite],:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "Cancel" , community_favorite_settings_path(@community), :class=>"btn btn-default pull-right"
          = f.submit "Save", :class=>"btn btn-success pull-right mr-10"