- content_for :title, "Favorites Page - Pynwheel"
.divLoading.hidden
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-heart
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          EBROCHURE SETTINGS
          %span
        .mt-10{ :style => "margin-left: -15px;" }
          .col-lg-12
            .btn-btn-danger
              = link_to community_favorite_setting_favorite_images_path(@community,@favorite),style: "width: 142px;", class: "btn btn-success loader_class" do
                %i.fa.fa-plus-circle
                ADD IMAGES
              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteAddImagesPopover","data-content" => " "}
                %span#propertyDetailNameText
                  Click "Add Images" to add images that will always appear at the top of the eBrochure
          .col-lg-12.mt-5
            .btn-btn-danger
              = link_to  community_favorite_setting_ebrochure_menu_buttons_path(@community,@community.favorite_setting), class: "btn btn-success loader_class" do
                %i.fa.fa-plus-circle
                ADD WEBLINKS
              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteAddWebLinksPopover","data-content" => " "}
                %span#propertyDetailNameText
                  Click "Add Weblinks" to add weblink buttons that will always appear at the top of the eBrochure.

      = form_for [@community,@favorite],:html=>{:class=>"form-horizontal",:id=>"favorite-settings-form"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f => f}
        / /.box-body
        -#.box-footer
          -#= link_to "Cancel" , community_favorite_settings_path(@community), :class=>"btn btn-default pull-right"
          -#= f.submit "Save", :class=>"btn btn-success pull-right mr-10"

:javascript
  if (!#{current_user.welcome_favorite_page})
  {
     $('[data-toggle="favoriteAddImagesPopover"]').popover({
        html: true,
        template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding">Click "Add Images" to add images that will always appear at the top of the eBrochure.</div><div class="popover-footer"><a id="favoriteAddImagesPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }

