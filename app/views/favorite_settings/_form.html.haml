.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email From

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.email_field :email_from, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email From",:maxlength=>"50"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email Bcc

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :email_bcc, :class=>"form-control validate[required,custom[email_list]]", :placeholder=>"Email Bcc" ,:maxlength=>"150"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email Body

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :email_body, :class=>"tinymce", :rows => 20, :cols => 80
    = tinymce
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Page Name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :favorite_name, :class=>"form-control" ,:maxlength=>"13"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Show Page

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :show_favorite
      %label.label-primary{:for => "favorite_setting_show_favorite"}
      %span.pl-15 Yes 