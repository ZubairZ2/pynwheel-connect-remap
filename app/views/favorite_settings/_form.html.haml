.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email From

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.email_field :email_from, :class=>"form-control validate[required]", :placeholder=>"Email From",:maxlength=>"50"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email Bcc

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.email_field :email_bcc, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email Bcc" ,:maxlength=>"150"