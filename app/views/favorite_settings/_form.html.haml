.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Page Name
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoritePageNamePopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the Page Name will change the menu label for this page in the Pynwheel app.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :favorite_name, :class=>"form-control favorite_setting_field"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Show Page

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :show_favorite, :class=>"favorite_setting_field"
      %label.label-primary{:for => "favorite_setting_show_favorite"}
      %span.pl-15 Yes

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email From
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteEmailFormPopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the Email From address will change the "from" email address for the eBrochure.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.email_field :email_from, :class=>"form-control validate[custom[email]] favorite_setting_field", :placeholder=>"Email From"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email Bcc
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteEmailBccPopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the Email Bcc address will change the email address that receives a copy of each eBrochure.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :email_bcc, :class=>"form-control validate[custom[email]] favorite_setting_field", :placeholder=>"Email Bcc" ,:maxlength=>"150", :onchange => "function1()"
.form-group#email_body_div
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.auto_save
    Email Body
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteEmailBodyPopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the Email Body will change the copy that appears on the top of each eBrochure.
    %span#saved_text
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :email_body, :rows => 20, :cols => 100,:id => "email_body_class",:class=>"email_body_class wysihtml5",:value=>f.object.email_body.present? ? f.object.email_body.gsub("<community_name>",@community.name).gsub("\n","<br>") : ""



.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Equal housing opportunity logo
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteEqualHousingOpportunityPopover","data-content" => " "}
      %span#propertyDetailNameText
        Switching this will change whether or not the Equal Opportunity logo appears at the bottom of the eBrochure.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :equal_housing_opportunity_logo, :class=>"favorite_setting_field"
      %label.label-primary{:for => "favorite_setting_equal_housing_opportunity_logo"}
      %span.pl-15 Yes

.form-group#HandicapDiv
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Handicap accessible logo
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "favoriteHandicapAccessiblePopover","data-delay"=>'{"hide": 1000}',"data-content" => " "}
      %span#propertyDetailNameText
        Switching the logo will change whether or not it appears at the bottom of the eBrochure.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :handicap_accessible_logo, :class=>"favorite_setting_field"
      %label.label-primary{:for => "favorite_setting_handicap_accessible_logo"}
      %span.pl-15 Yes
    -#.row
    -#  .col-sm-6.col-lg-6.col-md-4.col-xs-12
    -#    .checkbox
    -#      = f.check_box :handicap_accessible_logo
    -#      %label Handicap accessible logo
%button.btn-primary.done_btn{:onclick => "favorite_goBack()"}
  DONE
:javascript
  function favorite_goBack()
  {
    $('#favorite-settings-form').submit();
    window.location.reload();
  }
  $('.favorite_setting_field').change(function(){
    $('#favorite-settings-form').submit();
  });
  // $('#tinymce_ifr').bind("DOMSubtreeModified",function() {
  //   alert("fefef");
  // });
  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false},
        events: {
        change: function() {
            $('#favorite-settings-form').submit();
        }
        }
        });
      });

  });
