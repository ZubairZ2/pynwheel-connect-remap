                            %td.flexibleContainerCell{:valign => "top", :width => "620"}
                              %table{:align => "left", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                %tr
                                  %td#invisibleIntroduction.flexibleContainerBox{:align => "left", :style => "display:none !important;", :valign => "middle"}
                                    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "max-width:100%;", :width => "100%"}
                                      %tr
                                        %td.textContent{:align => "left"}
                                          %div{:style => "font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#828282;text-align:center;line-height:120%;"}
            %table#emailBody{:bgcolor => "#FFFFFF", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
              %tr
                %td{:align => "center", :valign => "top"}
                  %table{:bgcolor => "#CCCCCC", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF;", :width => "100%"}
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
                          %tr
                            %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                              %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                                %tr
                                  %td.textContent{:align => "center", :style => "padding: 0px 20px; text-align: center;", :valign => "top"}
                                    = image_tag "pynwheel-default-logo.png", :class => "email-logo",  :width => "200"
                                    %p.companyText{:style => "margin-top: 0;text-align: center;color: #000000;"} Pynwheel Inc.

                  %table{:border => "0", :cellpadding => "20", :cellspacing => "0", :width => "100%"}
                    %tr
                      %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                        %table{:border => "0", :cellpadding => "0", :cellspacing => "0    ", :width => "100%"}
                          %tr
                            %td
                              %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
                                %p The <strong>#{@community.touchscreen_app ? "Touch App" : ""} #{@community.touchscreen_app && @community.self_tour ? "," : ""} #{@community.self_tour ? "Pynwheel Tour App" : ""} </strong> is complete for <strong>#{@community.company.name} - #{@community.name}</strong>. Please review. If approved, Release in pynwheellaunch.com

                          %tr
                            %td
                              %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:5px;"}
                                %p Thank you!
                                %p  support@pynwheel.com
                            %tr
                              %td
                                %div{:style => "height:15px;"}
            %table#emailFooter{:bgcolor => "#CCCCCC", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
              %tr
                %td
                  %table#templateBody{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %table.templateContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "background-color:#CCCCCC ; ", :width => "100%"}
                          %tr
                            %td.bodyContainer{:style => "padding-top:10px;", :valign => "top"}
                              %table.mcnTextBlock{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                %tbody.mcnTextBlockOuter
                                  %tr
                                    %td.mcnTextBlockInner{:valign => "top"}
                                      %table.mcnTextContentContainer{:align => "center", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                        %tbody
                                          %tr
                                            %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 15px; padding-left: 18px; color:#000000; text-align:center;", :valign => "top"}
                                              %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                Pynwheel Inc. Denver, Colorado

                                              %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                303-640-3652

                                              %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
