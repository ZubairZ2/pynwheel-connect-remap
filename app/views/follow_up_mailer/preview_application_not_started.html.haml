%table#emailBody{:bgcolor => "#FFFFFF", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620", :leftmargin => "10"}
  %tr
    %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p Hi there,
  %tr
    %td
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p Just checking in. It looks like you have not yet submitted any content to Pynwheel Launch. If you need more time, that's fine! If you are having trouble accessing your account or would like me to create another account for someone else to submit content, let me know. Following data needs to be submitted on Pynwheel Launch to complete the on-boarding process.
  %tr
    %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p
          - @forms.each_with_index do |form, index|
            #{index + 1}. #{form[:name]}}
            %br
  %tr
    %td
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p OR
  %tr
    %td
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p To access Pynwheel Launch, <a href="https://pynwheel-user-portal.herokuapp.com/"> click here </a> and provide details in each section of the dashboard.
  %tr
    %td
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p As a reminder, production begins after we have received all content and we have made a successful connection to your data feed. Production typically takes 2-4 weeks.
  %tr
    %td
      %div{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:15px;margin-bottom:0;margin-top:3px;color:#000000;line-height:135%;"}
        %p Let me know if you have any questions.
  %tr
    %td
      %div{:style => "height:15px;"}