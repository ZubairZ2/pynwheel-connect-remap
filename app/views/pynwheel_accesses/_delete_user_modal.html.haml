.modal{:role => "dialog", :id => "deletePynwheelAccessModal", :tabindex => "-1"}
  .modal-dialog.modal-lg{:role => "document"}
    .modal-content
      .modal-header
        %h3.modal-title 
          %strong Delete Pynwheel Access User

      .modal-body
        %p Are you sure you want to delete this User ? This cannot be undone.
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel
        %button.btn.btn-danger{:type => "button", :onclick => "deletePynwheelAccessUser()"} Delete