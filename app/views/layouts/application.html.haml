!!!
%html
  %head
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title= yield(:title)
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    = csrf_meta_tags
    = stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    %link{:href => "https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800", :rel => "stylesheet"}/
  %body.hold-transition.skin-blue.sidebar-mini{:id => "#{controller_name == "home" || controller_name == "companies" ? "no-sidemenu" : ""}"}
    .wrapper
      = render partial: "/header"
      - unless controller_name == "home" || controller_name == "companies"
        - if controller_name == "communities"
          = render partial: "/sidemenu_communities"
        - else
          = render partial: "/side_menu"
      .content-wrapper
        = render partial: "/messages"
        = render partial: "/breadcrumbs"
        = yield
      = render partial: "/footer"

