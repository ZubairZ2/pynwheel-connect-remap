.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Name", :value=>''
        - if @stop_type == 'unit'
          %small n case building name present name must be formatted as BuildingName-MarketingName otherwise name must be same as unit marketing name (Manual Override Required)
        - elsif @stop_type == 'amenity'
          %small format must as name of amenity (Manual Override Required)
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :remote_lock_type, :class=>"form-control validate[required]", :placeholder=>"Lock Type", :value=> f.object.remote_lock_type,  readonly: ''
        %small type of the current lock (uneditable)
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.hidden_field :stop_id, :value=> @stop_id
        = f.hidden_field :stop_type, :value=> @stop_type
        = f.hidden_field :stop_name, :value=> @stop_name