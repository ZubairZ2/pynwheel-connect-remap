- content_for :title, "Amenities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-plus-square
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Amenities
          .col-md-6
            .mt-35
              /%span.btn.btn-primary.btn-file.pull-right.mb-20
              = link_to "Plot Amenity", plotexp_community_sitemaps_path, class: "btn btn-primary btn-file pull-right"
              %span.btn.btn-success.btn-file.pull-right.mb-20.some{ :style => "margin-right: 5px;" }
                %i.fa.fa-plus-circle
                Add Amenity
                %input#amenity-images{:multiple => "multiple", :type => "file"}/ 
            .divLoading.hidden
        #images-index
          = render :partial=>'index'
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}

        