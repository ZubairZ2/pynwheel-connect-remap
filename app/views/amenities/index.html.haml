- content_for :title, "Amenities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-plus-square
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            %h4.title Amenity Images
            %h4#slide_show_span
              %p
                Upload images here to add to your property map. Then plot them on the property map so that they appear in the correct place.
              %p
                Images will appear at a size of 300 x 200 px. Please note that images that are too small may appear pixelated.

            .mt-35
              /%span.btn.btn-primary.btn-file.pull-right.mb-20
              %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
                %i.fa.fa-plus-circle
                ADD FILES
                %input#amenity-images{:multiple => "multiple", :type => "file"}/
              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "amenityAddFilesPopover","data-content" => " "}
                %span#propertyDetailNameText
                  Import property amenity photos or renderings here. After you import an image, you will be able to plot a marker on the Property Map. For example, add an image of the courtyard and then plot an amenity marker for the courtyard on the Property Map.
            .mt-10
              - if @community.is_sitemap && (current_user.is_super_admin? || current_user.is_community_admin? )
                = link_to "PLOT AMENITIES", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
            .divLoading.hidden
        #images-index
          = render :partial=>'index'
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  $('#amenity-images').change(function () {
    $('.plot_amenities_btn').removeClass('hidden');
  });
  if (#{@amenities.count > 0})
  {
    $('.plot_amenities_btn').removeClass('hidden');
  }
  $('[data-toggle="amenityAddFilesPopover"]').popover({
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding">Changing the Name will change the name of the property on the "Favorites" page.</div><div class="popover-footer"><a id="amenityAddFilesPopoverClose" href="#" class="btn btn-info btn-sm">Close</a></div></div>'
    }).popover('show');
    $(document).on("click", "#amenityAddFilesPopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
    });