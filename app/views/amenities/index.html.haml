- content_for :title, "Amenities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-plus-square
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row{:style => "margin-bottom: 70px;"}
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            %h4.title Amenity Images
            %h4#slide_show_span
              %p
                Upload images here to add to your property map. Then plot them on the property map so that they appear in the correct place.
              %p
                Images will appear at a size of 500 x 400 px. Please note that images that are too small may appear pixelated.

            .mt-35
              = render :partial=>'amenity_name_toggle_form'

              %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
                %i.fa.fa-plus-circle
                ADD FILES
                %input#amenity-images{:multiple => "multiple", :type => "file"}/
              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "amenityAddFilesPopover","data-content" => " "}
                %span#propertyDetailNameText
                  Import property amenity photos or renderings here. After you import an image, you will be able to plot a marker on the Property Map. For example, add an image of the courtyard and then plot an amenity marker for the courtyard on the Property Map.
            .mt-10
              - if @community.is_sitemap && @community.show_map &&  (current_user.is_admin? )
                = link_to "PLOT AMENITIES", plot_amenities_community_sitemaps_path(@community), class: "loader_class btn btn-primary hidden btn-file plot_amenities_btn"
            .divLoading.hidden

        #images-index
          = render :partial=>'index'
.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "amenity_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE

#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  function amenity_goBack()
  {
    window.location.reload();
  }
  $('#amenity-images').change(function () {
    $('.plot_amenities_btn').removeClass('hidden');
  });
  if (#{@amenities.count > 0})
  {
    $('.plot_amenities_btn').removeClass('hidden');
  }
  if (!#{current_user.welcome_amenity_page})
  {
    $('[data-toggle="amenityAddFilesPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Import property amenity photos or renderings here. After you import an image, you will be able to plot a marker on the Property Map. For example, add an image of the courtyard and then plot an amenity marker for the courtyard on the Property Map.</div><div class="popover-footer"><a id="amenityAddFilesPopoverClose" href="#" class="btn btn-info btn-sm">Close</a></div></div>'
    }).popover('show');
  }

    $(document).on("click", "#amenityAddFilesPopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        #{current_user.welcome_amenity_page = true}
        #{current_user.save}
    });
  var amenity_id = null;
