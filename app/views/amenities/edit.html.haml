-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Property Map - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Amenity
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @amenity,url: (params[:floorNo].nil? and params[:from].nil?) ? community_amenity_path(current_community,@amenity) : ( params[:floorNo].present? ? community_amenity_path(:id=>@amenity.id,:community_id=>@community.id) <<  "?floorNo=#{params[:floorNo]}" : community_amenity_path(:id=>@amenity.id,:community_id=>@community.id) <<  '?from=unit'+ (@unit.present? ? '?&unit='+@unit.id.to_s : '')), method: :put do |f|
            = hidden_field_tag "community_id", @community.id
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control amenity_edit_field", :placeholder=>"Name",:maxlength=>"30"
            
            - if params[:from].nil?
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Video Link Button Label
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :video_link_button_label, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link button label", :maxlength=>"15"
            
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Tour Visiting Order Number
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.number_field :tour_visiting_order_number, class: "form-control amenity_edit_field", placeholder: "Tour Visiting Order Number", min: 1, step: 1

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Video Link
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :video_link, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link"

              - bool_check = @community.show_map ? f.object.amenityable.present? && f.object.amenityable_type == "Floorplate" : true
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Building
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :building ,  class: "form-control amenity_edit_field", placeholder: "building"

              - if !@community.is_sitemap && bool_check
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Floor
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.select :floor , (f.object.amenityable.floors.flatten.uniq.sort),{:include_blank => true}, class: "form-control amenity_edit_field", placeholder: "Floor"
              - else
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Floor
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.text_field :floor, :class=>"form-control amenity_edit_field", :placeholder=> "Floor"

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Amenity Type
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select :amenity_type , options_for_select(Amenity::AMENITY_TYPE, f.object.amenity_type),{},{:class=>"form-control amenity_edit_field"}

              - if @community.enable_locks

                = render :partial=>'shared/hidden_locks_data.html',locals: {community: @community, all_locks: @all_locks, locks_present_hash: @current_locks_provider || {}}
                - if @doors.present?
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Select the door
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = select_tag :door_id, options_for_select(@doors.collect{|d| [d.name, d.id]}, selected: @doors.first.id), class: "form-control"

                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Select Lock Provider
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    - if @doors.present?
                      = select_tag :lock_provider , options_for_select(@community.lock_options(@current_locks_provider), @doors.first.lock_provider),{:class=>"form-control"}
                    - else
                      = f.select :lock_provider , options_for_select(@community.lock_options(@current_locks_provider), f.object.lock_provider),{},{:id=> "lock_provider", :class=>"form-control"}

                .form-group.hidden.mt-30#access_code_field
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Access Code
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :access_code, (@doors.present?) ? @doors.first.access_code : @amenity.access_code, :name => "access_code" , :oninput => "this.value = this.value.replace(/[^0-9#*]/g, '')", :class=>"form-control amenity_edit_field", :placeholder=>"Access Code",:maxLength => "10"

                .form-group.hidden.mt-30#digital_lock_field
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Select the lock
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    
                    - if @doors.present?
                      = hidden_field_tag "dwelo_lock_name"     , @doors.first.dwelo_lock.present?     ?  @doors.first.dwelo_lock.name + " (" + @doors.first.dwelo_lock.remote_lock_type + ")" : ''
                      = hidden_field_tag "edgestate_lock_name" , @doors.first.edgestate_lock.present? ?  @doors.first.edgestate_lock.name + " (" + @doors.first.edgestate_lock.remote_lock_type + ")" : ''
                      = hidden_field_tag "latch_lock_name"     , @doors.first.latch_lock.present?     ?  @doors.first.latch_lock.lock_name : ''
                      = hidden_field_tag "zerv_lock_name"      , @doors.first.zerv_lock.present?      ?  @doors.first.zerv_lock.sub_location_name + " (" + @doors.first.zerv_lock.sub_location_friendly_name + ")" : ''
                      = hidden_field_tag "igloohome_lock_name" , @doors.first.igloohome_lock.present? ?  @doors.first.igloohome_lock.device_name : ''
                    - else
                      = hidden_field_tag "dwelo_lock_name"     , @amenity.dwelo_locks.present?     ?  @amenity.dwelo_locks.first.name + " (" + @amenity.dwelo_locks.first.remote_lock_type + ")" : ''
                      = hidden_field_tag "edgestate_lock_name" , @amenity.edgestate_locks.present? ?  @amenity.edgestate_locks.first.name + " (" + @amenity.edgestate_locks.first.remote_lock_type + ")" : ''
                      = hidden_field_tag "latch_lock_name"     , @amenity.latch_locks.present?     ?  @amenity.latch_locks.first.lock_name : ''
                      = hidden_field_tag "zerv_lock_name"      , @amenity.zerv_locks.present?      ?  @amenity.zerv_locks.first.sub_location_name + " (" + @amenity.zerv_locks.first.sub_location_friendly_name + ")" : ''
                      = hidden_field_tag "igloohome_lock_name" , @amenity.igloohome_locks.present? ? @amenity.igloohome_locks.first.device_name : ''

                    = text_field_tag :lock_name, '', :placeholder => "Search by lock name", :list => "locks_list", :autocomplete=> "off", :type => "text", :class => "form-control amenity_edit_field"
                    %datalist#locks_list
                    = hidden_field_tag "lock_id", ""

            - if @community.self_tour
              - if params[:from].nil?
                .row
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                      Show in Stops List
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .TriSea-technologies-Switch
                        %span.pr-15 No
                        = f.check_box :breezway_lock_visible, :id => "amenity-breezway-lock-visible",:class => "form-control amenity_edit_field"
                        %label.label-primary{:for => "amenity-breezway-lock-visible"}
                        %span.pl-15 Yes
              .row
                .form-group{:style => "margin-right: 15px;"}
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                    Description
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        This description will appear above the image. Only the first #{ENV["DESCRIPTION_LIMIT"].to_i} characters will appear on the page with the image; the rest of the description can be accessed by pulling up a separate page in the app.

                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :description, :class=>"form-control amenity_edit_field amenity_edit_wysihtml5", :placeholder=>"Description"
                    <!-- %span.amenity_description_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: #{ENV["DESCRIPTION_LIMIT"].to_i} -->

              .row
                .form-group{:style => "margin-right: 15px;"}
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                    Directional Text
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        This description will appear above the image. Only the first #{ENV["DESCRIPTION_LIMIT"].to_i} characters will appear on the page with the image; the rest of the description can be accessed by pulling up a separate page in the app.
                      %span#characterLimitCount{:style => "display: none"} #{ENV["DESCRIPTION_LIMIT"].to_i}
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :directional_text, :class=>"form-control amenity_edit_field amenity_edit_directional_wysihtml5", :placeholder=>"Directional Text"
                    <!-- %span.amenity_directional_text_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: #{ENV["DESCRIPTION_LIMIT"].to_i} -->
                    
            = submit_tag 'Save', class: "hidden"


    %span.btn.btn-primary.btn-file
      %i.fa.fa-upload
      Upload File
      %input#amenity-images{:type => "file"}/

    .text-center.image-upload.home-page-drag-box#amenity-image-upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container{:style => "height: 250px !important;"}
          - rn =  rand(9999999999999999999999999)
          %a.preview-image{:href=>@amenity.image.present? ? (@amenity.image.url + "?timestamp=#{rn}") : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Amenity Image"}
            = image_tag @amenity.image.present? ? (@amenity.image.url  + "?timestamp=#{rn}") : "default.jpeg",:width=>"100%",:id=>"preview-image"
        - if  @amenity.image.present?
          .col-lg-1
            .icon{style: "margin-left: -15px;"}
              = link_to show_amenity_image_in_modal_community_amenity_path(), remote: true do
                %span.btn.btn-default.black-button.btn-sm.btn-file{"data-target" => "#edit-name", "data-toggle" => "modal"}
                  Crop
    //////////////////////// Amenity Gallery
    .box.box-info.add-plan

      .col-lg-12
        %h4{:style => "color: grey;"}
          Upload Amenity Gallery
      .col-lg-12.mt-35
        /%span.btn.btn-primary.btn-file.pull-right.mb-20
        %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
          %i.fa.fa-plus-circle
          ADD FILES
          %input#amenity-gallery-images{:multiple => "multiple", :type => "file"}/
        .mt-10
          - if @community.is_sitemap && (current_user.is_admin? )
            = link_to "PLOT AMENITIES", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
        .divLoading.hidden
        #images-index1
          = render :partial=>'edit_amenity'
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              - if @unit.present?
                %a.btn-primary.mb-20.done_btn.direct_btn{href: edit_community_unit_path(@community.id,@unit.id)} DONE
              - else
                %button.btn-primary.mb-20.done_btn#on_done{:style => " margin-top: 0px;  margin-bottom: 0px;" }
                  DONE
#edit-gallery-image.modal.fade.edit-gallery-image
#crop-amenity-image.modal.fade.edit-image

:javascript

  var amenity_id = #{@amenity.id}
  var amenity_name = '#{@amenity.name}'
  var community_id = #{ @community.id}
  var from = #{ @from_unit}

  $(document).ready(function(){
    update_locks_fields()
  });

  $('.sortable_amenity').railsSortable();

  $('#lock_provider').change(function(){
    update_locks_fields()
    $('#lock_name')[0].value = '';
    if ($('#lock_provider').val().length == 0)
      $('.edit_amenity').submit();
  });

  $("#lock_name").change(function() {
    var optionFound = false,
    datalist = this.list;
    for (var j = 0; j < datalist.options.length; j++) {
        if (this.value == datalist.options[j].value) {
            optionFound = true;
            break;
        }
    }
    if (optionFound) {
      this.setCustomValidity('');
    } else {
      //if ( $("#lock_name").val() != "" )
          this.setCustomValidity('Lock does not exist');
    }
  });

  $('#on_done').click(function(e){
    $('.edit_amenity').append('<input type="hidden" name="done_action" value="true">');
    submit_form()
  })

  $('.amenity_edit_field').change(function(){
    setTimeout(function(){
      submit_form()
    },300)
  });

  $("#door_id").change(function(){
    var door_id = this.value
    $.ajax({
      type: "get",
      url:  "/communities/" + community_id + "/return_door_lock?door_id=" + door_id,
      cache: false,
      success: function(res) {

        $("#lock_provider").val(res.lock_provider)
        $('#access_code').val(res.access_code.length === 0 ? '' : res.access_code)
        $('#edgestate_lock_name').val(res.digital_lock.edgestate_lock === null ? '' : res.digital_lock.edgestate_lock.name + " (" + res.digital_lock.edgestate_lock.remote_lock_type + ")")
        $('#dwelo_lock_name').val(res.digital_lock.dwelo_lock === null ? '' : res.digital_lock.dwelo_lock.name + " (" + res.digital_lock.dwelo_lock.remote_lock_type + ")")
        $('#latch_lock_name').val(res.digital_lock.latch_lock === null ? '' : res.digital_lock.latch_lock.lock_name)
        $('#zerv_lock_name').val(res.digital_lock.zerv_lock === null ? '' : res.digital_lock.zerv_lock.sub_location_name + " (" + res.digital_lock.zerv_lock.sub_location_friendly_name + ")")
        $('#igloohome_lock_name').val(res.digital_lock.igloohome_lock === null ? '' : res.digital_lock.igloohome_lock.device_name)
        if(res.lock_provider == "EdgeState")
          $('#lock_id').val(res.digital_lock.edgestate_lock === null ? '' : res.digital_lock.edgestate_lock.device_id)
        else if(res.lock_provider == "Dwelo")
          $('#lock_id').val(res.digital_lock.dwelo_lock === null ? '' : res.digital_lock.dwelo_lock.device_id)
        else if(res.lock_provider == "Latch")
          $('#lock_id').val(res.digital_lock.latch_lock === null ? '' : res.digital_lock.latch_lock.lock_id)
        else if(res.lock_provider == "Zerv")
          $('#lock_id').val(res.digital_lock.zerv_lock === null ? '' : res.digital_lock.zerv_lock.mac_id)
        else if(res.lock_provider == "Igloohome")
          $('#lock_id').val(res.digital_lock.igloohome_lock === null ? '' : res.digital_lock.igloohome_lock.device_id)
        else if(res.lock_provider == "Manual" || res.lock_provider == "")
          $('#lock_id').val('')

        update_locks_fields()
      },
      fail: function(){},
    })
  })

  function submit_form(){
    var digital_lock = $("#lock_name")
    var digital_lock_field = $('#digital_lock_field')
    if (digital_lock.length > 0 && !digital_lock_field.hasClass("hidden")){
      var lock = digital_lock[0];

      if(lock.checkValidity() == true){
        lock_id = $("#locks_list [value='" + lock.value + "']").data('value')
        $("#lock_id").val(lock_id)
        $('.edit_amenity').submit();
      }
      else if ($(lock).val() == ""){
        $("#lock_id").val("")
        $('.edit_amenity').submit();
      }
      else
        lock.reportValidity();
    }
    else
      $('.edit_amenity').submit();
  }

  function update_locks_fields(){
    if($('#lock_provider').val() == '' || $('#lock_provider').val() == null){
        $('#access_code_field').addClass('hidden')
        $('#digital_lock_field').addClass('hidden')
    }
    else if($('#lock_provider').val() == "Manual" ){
        $('#digital_lock_field').addClass('hidden')
        $('#access_code_field').removeClass('hidden')
    }
    else{
        $('#digital_lock_field').removeClass('hidden')
        $('#access_code_field').addClass('hidden') 
        
        lock_provider         =  $('#lock_provider').val().toLowerCase()
        selected_lock_name    =  $("#"+lock_provider+"_lock_name").val()
        selected_lock_options =  $('.'+lock_provider+"_options").html()

        $('datalist#locks_list').html(selected_lock_options)
        $('#lock_name').val(selected_lock_name)
    }
  }
