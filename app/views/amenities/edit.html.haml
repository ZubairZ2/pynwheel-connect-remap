-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Property Map - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Amenity
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @amenity,url: params[:floorNo].nil? ? community_amenity_path(current_community,@amenity) : community_amenity_path(:id=>@amenity.id,:community_id=>@community.id) <<  '?floorNo=' + params[:floorNo] , method: :put do |f|
            = hidden_field_tag "community_id", @community.id
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control amenity_edit_field", :placeholder=>"Name",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Access Code
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :access_code, :oninput => "this.value = this.value.replace(/[^0-9#*]/, '')", :class=>"form-control amenity_edit_field", :placeholder=>"Access Code"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Video Link Button Label
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :video_link_button_label, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link button label", :maxlength=>"15"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Video Link
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :video_link, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link"
            - if EdgeState.find_by(community_id: @community.id).present?
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Remote Lock
                  %i.unit_manualoverride.fa.fa-question-circle
                    %span#unit_manualoverride_text
                      Name of Remote lock must be same as amenity name
                  %span Assign the lock to this amenity
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  %select.form-control#remote_lock{name: "remote_lock"}
                  %button#update-btn.btn.btn-primary.update-lock.hidden{type: "button"}
                    %a#a-lock.btn-text-color{href: "#"} Update selected lock

            - bool_check = @community.show_map ? f.object.amenityable.present? && f.object.amenityable_type == "Floorplate" : true
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building ,  class: "form-control amenity_edit_field", placeholder: "building" 
            - if !@community.is_sitemap && bool_check      

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Floor
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select :floor , (f.object.amenityable.floors.flatten.uniq.sort),{:include_blank => true}, class: "form-control amenity_edit_field", placeholder: "Floor"

                  -#= f.text_field :floor, :class=>"form-control amenity_edit_field validate[required,custom[onlyNumber&Decimal]]", :placeholder=>"Floor"
            - if @community.self_tour
              .row
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                    Description
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :description, :class=>"form-control amenity_edit_field amenity_edit_wysihtml5", :placeholder=>"Description"
              .row
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                    Directional Text
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :directional_text, :class=>"form-control amenity_edit_field amenity_edit_wysihtml5", :placeholder=>"Directional Text"
                    
            = submit_tag 'Save', class: "hidden"

    %span.btn.btn-primary.btn-file
      %i.fa.fa-upload
      Upload File
      %input#amenity-images{:type => "file"}/

    .text-center.image-upload.home-page-drag-box#amenity-image-upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container{:style => "height: 250px !important;"}
          %a.preview-image{:href=>@amenity.image.present? ? @amenity.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Amenity Image"}
            = image_tag @amenity.image.present? ? @amenity.image.url : "default.jpeg",:width=>"100%",:id=>"preview-image"
    //////////////////////// Amenity Gallery
    .box.box-info.add-plan

      .col-lg-12
        %h4{:style => "color: grey;"}
          Upload Amenity Gallery
      .col-lg-12.mt-35
        /%span.btn.btn-primary.btn-file.pull-right.mb-20
        %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
          %i.fa.fa-plus-circle
          ADD FILES
          %input#amenity-gallery-images{:multiple => "multiple", :type => "file"}/
        .mt-10
          - if @community.is_sitemap && (current_user.is_super_admin? || current_user.is_community_admin? )
            = link_to "PLOT AMENITIES", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
        .divLoading.hidden
        #images-index1
          = render :partial=>'edit_amenity'
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %a.btn-primary.mb-20.done_btn{:href => "#{params[:floorNo].nil? ? community_tours_path(current_community) : community_tours_path(current_community) << '?floorNo=' + params[:floorNo]}",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#edit-gallery-image.modal.fade.edit-gallery-image

:javascript

  $('.amenity_edit_field').change(function(){
    $('.edit_amenity').submit();
  });

  var amenity_id = #{@amenity.id}
  var amenity_name = '#{@amenity.name}'
  var community_id = #{ @community.id}

  var assigned_lock_name = '#{ @assigned_lock.present? ? @assigned_lock.name : '' }'
  var assigned_lock_type = '#{ @assigned_lock.present? ? @assigned_lock.remote_lock_type : '' }'

  var IsSelectedLockMatch = function(){
    if($('#remote_lock :selected').text() != "Select your option"){
      var index = $('#remote_lock :selected').text().lastIndexOf(" ");
      var lock_name = $('#remote_lock :selected').text().substring(0, index);

      if(lock_name != $('#amenity_name').val()){
        $('#remote_lock').addClass('lock_mismatch')
        $("#update-btn").removeClass('hidden')

        var id = $('#remote_lock :selected').val()
        var href = '/communities/' + community_id + '/remote_locks/' + id + '/edit?stop_id=' + amenity_id + '&stop_name=' + amenity_name + '&stop_type=amenity'

        $("#a-lock").attr("href",href);
      }
      else{
        $('#remote_lock').removeClass('lock_mismatch')
        $("#update-btn").addClass('hidden')
        $("#a-lock").attr("href","#");
      }
    }
    else{
        $('#remote_lock').removeClass('lock_mismatch')
        $("#update-btn").addClass('hidden')
        $("#a-lock").attr("href","#");
    }
  }

  function clear_assigned_lock(){
    $.ajax({
      type: 'POST',
      url: '/communities/'+ community_id + '/amenities/' + amenity_id +'/clear_locks',
      dataType: 'json',
      cache: false,
      success: function(data){
        console.log(data)
      },
      fail: function(error){
        console.log(error)
      }
    })
  }

  $(document).ready(function(){
    var params = {"amenity_name": amenity_name}
    var assigned_lock_present = false
     
    $.ajax({
      type: 'POST',
      url: '/communities/'+ community_id + '/amenities/' + amenity_id +'/load_remotelock_data',
      dataType: 'json',
      data: params,
      cache: false,
      success: function(data){
        locks = data['locks']
        for (var item in locks) {
            if (assigned_lock_name == locks[item].name && assigned_lock_type == locks[item].remote_lock_type){
              $('#remote_lock').prepend(`<option value="${locks[item].device_id}" , selected="selected">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
              assigned_lock_present = true
            }
            else{
              $('#remote_lock').append(`<option value="${locks[item].device_id}">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
            }
        }
        if(assigned_lock_present == false){
            $('#remote_lock').prepend(`<option value="" , selected="selected">Select your option</option>`)
            // clear_assigned_lock()
        }
        else
          IsSelectedLockMatch()
      },
      fail: function(error){
        console.log(error)
      }
    });

    $("#remote_lock").change(function () {
      IsSelectedLockMatch()
    });

    $("#amenity_name").keyup(function() {
      IsSelectedLockMatch()
    });
    
  });

  var community_id = #{params[:community_id]}
  var amenity_id = #{@amenity.id}
  $('.sortable_amenity').railsSortable();