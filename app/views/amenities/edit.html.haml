-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Property Map - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Amenity
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @amenity,url: (params[:floorNo].nil? and params[:from].nil?) ? community_amenity_path(current_community,@amenity) : ( params[:floorNo].present? ? community_amenity_path(:id=>@amenity.id,:community_id=>@community.id) <<  "?floorNo=#{params[:floorNo]}" : community_amenity_path(:id=>@amenity.id,:community_id=>@community.id) <<  '?from=unit'+ (@unit.present? ? '?&unit='+@unit.id.to_s : '')), method: :put do |f|
            = hidden_field_tag "community_id", @community.id
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control amenity_edit_field", :placeholder=>"Name",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Video Link Button Label
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :video_link_button_label, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link button label", :maxlength=>"15"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Video Link
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :video_link, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link"

            - bool_check = @community.show_map ? f.object.amenityable.present? && f.object.amenityable_type == "Floorplate" : true
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building ,  class: "form-control amenity_edit_field", placeholder: "building"
            - if !@community.is_sitemap && bool_check

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Floor
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select :floor , (f.object.amenityable.floors.flatten.uniq.sort),{:include_blank => true}, class: "form-control amenity_edit_field", placeholder: "Floor"

            - if @community.enable_locks
              - if @community.locks_provider == "EdgeState" and @community.edge_state.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Remote Lock
                    %span Assign the lock to this amenity
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :edgestate_locks_input, @amenity.remote_locks.present? ? @amenity.remote_locks.last.name + " (" + @amenity.remote_locks.last.remote_lock_type + ")" : '', :placeholder => "Search by lock name", :list => "edgestate_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control amenity_edit_field"
                    %datalist#edgestate_locks_list
                      - @all_locks[:edgestate_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Dwelo" and @community.dwelo.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Dwelo lock
                    %span Assign the lock to this amenity
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :dwelo_locks_input, @amenity.remote_locks.present? ? @amenity.remote_locks.last.name + " (" + @amenity.remote_locks.last.remote_lock_type + ")" : '', :placeholder => "Search by lock name", :list => "dwelo_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control amenity_edit_field"
                    %datalist#dwelo_locks_list
                      - @all_locks[:dwelo_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Latch" and @community.latch.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Latch lock
                    %span Assign the lock to this amenity
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :latch_locks_input, @amenity.latch_locks.present? ?  @amenity.latch_locks.last.lock_name : '', :placeholder => "Search by lock name", :list => "latch_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control amenity_edit_field"
                    %datalist#latch_locks_list
                      - @all_locks[:latch_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Zerv" and @community.zerv.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Pynwheel Access (zerv)
                    %span Assign the lock to this amenity
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :zerv_locks_input, @amenity.zerv_locks.present? ?  @amenity.zerv_locks.last.sub_location_name + " (" + @amenity.zerv_locks.last.sub_location_friendly_name + ")" : '', :placeholder => "Search by lock name", :list => "zerv_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control amenity_edit_field"
                    %datalist#zerv_locks_list
                      - @all_locks[:zerv_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == nil or @community.locks_provider == ""
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Access Code
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.text_field :access_code, :oninput => "this.value = this.value.replace(/[^0-9#*]/, '')", :class=>"form-control amenity_edit_field", :placeholder=>"Access Code"

            - if @community.self_tour
              .row
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                    Description
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        This description will appear above the image. Only the first 90 characters will appear on the page with the image; the rest of the description can be accessed by pulling up a separate page in the app.

                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :description, :class=>"form-control amenity_edit_field amenity_edit_wysihtml5", :placeholder=>"Description"
                    %span.amenity_description_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 90

              .row
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{:style => "padding-left: 29px;"}
                    Directional Text
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        This description will appear above the image. Only the first 90 characters will appear on the page with the image; the rest of the description can be accessed by pulling up a separate page in the app.

                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :directional_text, :class=>"form-control amenity_edit_field amenity_edit_directional_wysihtml5", :placeholder=>"Directional Text"
                    %span.amenity_directional_text_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 90
                    
            = submit_tag 'Save', class: "hidden"


    %span.btn.btn-primary.btn-file
      %i.fa.fa-upload
      Upload File
      %input#amenity-images{:type => "file"}/

    .text-center.image-upload.home-page-drag-box#amenity-image-upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container{:style => "height: 250px !important;"}
          - rn =  rand(9999999999999999999999999)
          %a.preview-image{:href=>@amenity.image.present? ? (@amenity.image.url + "?timestamp=#{rn}") : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Amenity Image"}
            = image_tag @amenity.image.present? ? (@amenity.image.url  + "?timestamp=#{rn}") : "default.jpeg",:width=>"100%",:id=>"preview-image"
        - if  @amenity.image.present?
          .col-lg-1
            .icon{style: "margin-left: -15px;"}
              = link_to show_amenity_image_in_modal_community_amenity_path(), remote: true do
                %span.btn.btn-default.black-button.btn-sm.btn-file{"data-target" => "#edit-name", "data-toggle" => "modal"}
                  Crop
    //////////////////////// Amenity Gallery
    .box.box-info.add-plan

      .col-lg-12
        %h4{:style => "color: grey;"}
          Upload Amenity Gallery
      .col-lg-12.mt-35
        /%span.btn.btn-primary.btn-file.pull-right.mb-20
        %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
          %i.fa.fa-plus-circle
          ADD FILES
          %input#amenity-gallery-images{:multiple => "multiple", :type => "file"}/
        .mt-10
          - if @community.is_sitemap && (current_user.is_super_admin? || current_user.is_community_admin? )
            = link_to "PLOT AMENITIES", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
        .divLoading.hidden
        #images-index1
          = render :partial=>'edit_amenity'
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              - if @unit.present?
                %a.btn-primary.mb-20.done_btn.direct_btn{href: edit_community_unit_path(@community.id,@unit.id)} DONE
              - else
                %button.btn-primary.mb-20.done_btn#on_done{:style => " margin-top: 0px;  margin-bottom: 0px;" }
                  DONE
#edit-gallery-image.modal.fade.edit-gallery-image
#crop-amenity-image.modal.fade.edit-image

:javascript
  var locks_provider = "#{@locks_provider}"
  var amenity_id = #{@amenity.id}
  var amenity_name = '#{@amenity.name}'
  var community_id = #{ @community.id}
  var from = #{ @from_unit}

  var locks_input, locks_list, param_name, load_btn = "";

  if(locks_provider == "EdgeState"){
    locks_input = "#edgestate_locks_input"
    locks_list = "#edgestate_locks_list"
    param_name = "remote_lock"
  }
  else if(locks_provider == "Dwelo"){
    locks_input = "#dwelo_locks_input"
    locks_list = "#dwelo_locks_list"
    param_name = "dwelo_remote_lock"
  }
  else if(locks_provider == "Latch"){
    locks_input = "#latch_locks_input"
    locks_list = "#latch_locks_list"
    param_name = "latch_lock"
  }
  else if(locks_provider == "Zerv"){
    locks_input = "#zerv_locks_input"
    locks_list = "#zerv_locks_list"
    param_name = "zerv_lock"
  }


  $('#amenity_building').change(function(){
    $.ajax({
      type: "POST",
      url: 'extract_floors',
      data: {building: $('#amenity_building').val()},
      success: function(response) {
        for(i=0; i < response.floors.length; i++ )
        {
          $('#amenity_floor').append('<option value='+response.floors[i]+'>  '+ response.floors[i] +' </option>')
        }
      }

    });
    event.preventDefault();
  });


  unit = #{@unit.present? ? @unit.id : 111111000000000}
  $('.amenity_edit_field').change(function(){

    setTimeout(function(){ 
      var lock = $(locks_input)[0];
      if(lock.value == "")
          lock.setCustomValidity('')

      if(lock.checkValidity() == true){
        lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
        input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
        $("#" + lock.id).closest('form').append(input)
        $('.edit_amenity').submit();
      }
      else{ lock.reportValidity(); }
    }, 300);
    
  });

  if (unit != 111111000000000){
    var from = #{ @from_unit}
  }

  $('.amenity_edit_field').change(function(){
      action = "change"
      $('#on_done').click(function(e){
        action = "clicked"

        setTimeout(function(){ 
          var lock = $(locks_input)[0];
          if(lock.value == "")
            lock.setCustomValidity('')

          if(lock.checkValidity() == true){
            lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
            input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
            $("#" + lock.id).closest('form').append(input)

            $('.edit_amenity').submit(function() {
              $(this).append('<input type="hidden" name="done_action" value="true">');
              $(this).append('<input type="hidden" name="from_id" value="' + from + '">');
              if (unit != 111111000000000) {
                $(this).append('<input type="hidden" name="unit_render" value="' + unit + '">');
              }
            });

          }
          else{ lock.reportValidity(); }
        }, 300);
      })
  });

  $('#on_done').click(function(e){
    setTimeout(function(){ 
      var lock = $(locks_input)[0];
      if(lock.value == "")
            lock.setCustomValidity('')

      if(lock.checkValidity() == true){
        lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
        input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
        $("#" + lock.id).closest('form').append(input)
        $('.edit_amenity').submit();
      }
      else{ lock.reportValidity(); }
    }, 300);
  })

  var inputs = document.querySelectorAll('input[list]');
  for (var i = 0; i < inputs.length; i++) {
    inputs[i].addEventListener('change', function() {
      var optionFound = false,
      datalist = this.list;
      for (var j = 0; j < datalist.options.length; j++) {
          if (this.value == datalist.options[j].value) {
              optionFound = true;
              break;
          }
      }
      if (optionFound) {
        this.setCustomValidity('');
      } else {
        if ( $(locks_input).val() != "" )
            this.setCustomValidity('Lock does not exist');
      }
    });
  }

  $('.sortable_amenity').railsSortable();