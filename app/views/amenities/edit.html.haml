-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Property Map - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Amenity
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @amenity,url: community_amenity_path(current_community,@amenity),method: :put do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control amenity_edit_field", :placeholder=>"Name",:maxlength=>"30"

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Description

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :description, :class=>"form-control amenity_edit_field", :placeholder=>"Description",:maxlength=>"70"

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :directional_text, :class=>"form-control amenity_edit_field", :placeholder=>"Directional Text",:maxlength=>"70"

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Access Code
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :access_code, :class=>"form-control amenity_edit_field", :placeholder=>"Access Code"

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Video Link Button Label
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :video_link_button_label, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link button label", :maxlength=>"15"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Video Link
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :video_link, :class=>"form-control amenity_edit_field", :placeholder=>"Video Link"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Remote Lock
                %i.unit_manualoverride.fa.fa-question-circle
                  %span#unit_manualoverride_text
                    The name of Remote lock from the dropdown list must be same as the name of amenity
                %span Assign the lock to this amenity
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                %select.form-control#remote_lock{name: "amenity[remote_lock]", required: ""}
                  %option{disabled: "disabled", selected: "selected", value: ""} Select your option
                  %option{value: "1"} AA-111
              %button#update-btn.btn.btn-primary.hidden{type: "button"}
                %a#a-lock{href: "#"} Update selected lock
              
            - if !@community.is_sitemap && f.object.amenityable.present?
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Floor
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  -#= f.text_field :floor, :class=>"form-control amenity_edit_field validate[required,custom[onlyNumber&Decimal]]", :placeholder=>"Floor"
                  = f.select :floor , f.object.amenityable.floors,{}, class: "form-control", placeholder: "Floor"
            = submit_tag 'Save', class: "hidden"

    %span.btn.btn-primary.btn-file
      %i.fa.fa-upload
      Upload File
      %input#amenity-images{:type => "file"}/

    .text-center.image-upload.home-page-drag-box#amenity-image-upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container
          %a.preview-image{:href=>@amenity.image.present? ? @amenity.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Amenity Image"}
            = image_tag @amenity.image.present? ? @amenity.image.url : "default.jpeg",:height=>"100%",:width=>"100%",:id=>"preview-image"
    //////////////////////// Amenity Gallery
    .box.box-info.add-plan

      .col-lg-12
        %h4{:style => "color: grey;"}
          Upload Amenity Gallery
      .col-lg-12.mt-35
        /%span.btn.btn-primary.btn-file.pull-right.mb-20
        %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
          %i.fa.fa-plus-circle
          ADD FILES
          %input#amenity-gallery-images{:multiple => "multiple", :type => "file"}/
        .mt-10
          - if @community.is_sitemap && (current_user.is_super_admin? || current_user.is_community_admin? )
            = link_to "PLOT AMENITIES", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
        .divLoading.hidden
        #images-index1
          = render :partial=>'edit_amenity'
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %a.btn-primary.mb-20.done_btn{:href => "#{community_tours_path(current_community)}",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#edit-gallery-image.modal.fade.edit-gallery-image
:javascript
  $('.amenity_edit_field').change(function(){
    $('.edit_amenity').submit();
  });

  $(document).ready(function(){
      var amenity_id = #{@amenity.id}
      var amenity_name = '#{@amenity.name}'
      var community_id = #{ @community.id}
      var params = {"amenity_name": amenity_name}
      $.ajax({
          type: 'POST',
          url: '/communities/'+ community_id + '/amenities/' + amenity_id +'/load_remotelock_data',
          dataType: 'json',
          data: params,
          cache: false,
          success: function(data){
            locks = data['locks']
            for (var item in locks) {
              $('#remote_lock').append(`<option value="${locks[item].device_id}">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
            }
            
          },
          fail: function(error){
            console.log(error)
          }
    });

    $("#remote_lock").change(function () {
      if($('#remote_lock :selected').text() != "Select your option"){
        var lock_name = $('#remote_lock :selected').text().replace(' (lock)','');
        if(lock_name != $('#unit_provider_unit_id').val()){
          $(this).addClass('lock_mismatch')
          $("#update-btn").removeClass('hidden')

          var amenity_id = #{@amenity.id}
          var amenity_name = '#{@amenity.name}'
          var community_id = #{ @community.id}
          var stop_type = "amenity"

          var id = $('#remote_lock :selected').val()
          var href = '/communities/' + community_id + '/remote_locks/' + id + '/edit?stop_id=' + amenity_id + '&stop_type=' + stop_type + '&stop_name=' + amenity_name

          $("#a-lock").attr("href",href);
        }
        else{
          $(this).removeClass('lock_mismatch')
          $("#update-btn").addClass('hidden')
          $("#a-lock").attr("href","#");
        }
      }
    });
    
  });

  var community_id = #{params[:community_id]}
  var amenity_id = #{@amenity.id}