- content_for :title, "Edit Amenity - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Edit
          %span Amenity

      = form_for [@community,@sitemap,@amenity],:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , list_amenities_community_sitemaps_path(@community), :class=>"btn btn-default pull-right"
          = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right mr-10"


