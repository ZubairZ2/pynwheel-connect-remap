:css
  /* Scoped to .map-analytics — every rule below starts there so nothing here can
     reach the AdminLTE chrome or another screen's markup. */
  .map-analytics-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .map-analytics-head-icon {
    width: 44px; height: 44px; border-radius: 10px; flex: 0 0 44px;
    display: flex; align-items: center; justify-content: center;
    background: #eaf4ec; color: #3c8c51; font-size: 20px;
  }
  .map-analytics-head-text h3 { margin: 0 0 4px; font-size: 20px; font-weight: 600; color: #2f3640; }
  .map-analytics-head-text p  { margin: 0; color: #7b8794; font-size: 13px; }

  /* Current state, read before anything is changed. */
  .map-analytics-status {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 16px; border-radius: 8px; margin-bottom: 22px;
    font-size: 13px; border: 1px solid transparent;
  }
  .map-analytics-status--on  { background: #eaf4ec; border-color: #cfe6d5; color: #2c6b3f; }
  .map-analytics-status--off { background: #f5f6f8; border-color: #e3e6ea; color: #626d7a; }
  .map-analytics-status b { font-weight: 600; }

  /* One numbered step per decision. */
  .map-analytics-step { display: flex; gap: 16px; padding: 22px 0; border-top: 1px solid #edeff2; }
  .map-analytics-step:first-of-type { border-top: 0; padding-top: 4px; }
  .map-analytics-step-num {
    width: 28px; height: 28px; flex: 0 0 28px; border-radius: 50%;
    background: #3c8c51; color: #fff; font-size: 13px; font-weight: 600;
    display: flex; align-items: center; justify-content: center; margin-top: 2px;
  }
  .map-analytics-step-body { flex: 1 1 auto; min-width: 0; }
  .map-analytics-step-body h4 { margin: 2px 0 6px; font-size: 15px; font-weight: 600; color: #2f3640; }
  .map-analytics-step-body .hint { color: #7b8794; font-size: 13px; margin: 0 0 14px; line-height: 1.5; }

  .map-analytics-toggle { display: flex; align-items: center; gap: 10px; font-weight: 500; cursor: pointer; }
  .map-analytics-toggle input { width: 16px; height: 16px; margin: 0; cursor: pointer; }

  /* Action checkboxes. Two columns on desktop, one on a narrow screen. */
  .map-analytics-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 900px) { .map-analytics-actions { grid-template-columns: 1fr; } }
  .map-analytics-action {
    display: flex; gap: 10px; padding: 12px 14px; cursor: pointer;
    border: 1px solid #e3e6ea; border-radius: 8px; background: #fff; margin: 0;
    font-weight: 400; transition: border-color .12s, background .12s;
  }
  .map-analytics-action:hover { border-color: #b9c6cf; }
  .map-analytics-action input { margin: 2px 0 0; width: 15px; height: 15px; flex: 0 0 15px; cursor: pointer; }
  .map-analytics-action-name { display: block; font-weight: 600; font-size: 13px; color: #2f3640; }
  .map-analytics-action-code {
    display: block; font-family: Menlo, Consolas, monospace; font-size: 11px; color: #3c8c51; margin: 2px 0;
    word-break: break-all;
  }
  .map-analytics-action-note { display: block; font-size: 11px; color: #93a0ad; }
  .map-analytics-badge {
    display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: .3px;
    background: #eaf4ec; color: #3c8c51; border-radius: 3px; padding: 1px 6px; margin-left: 6px;
    text-transform: uppercase; vertical-align: middle;
  }

  .map-analytics-origin { max-width: 460px; }
  .map-analytics-origin input[type="text"] {
    width: 100%; padding: 9px 12px; border: 1px solid #d8dde2; border-radius: 6px; font-size: 13px;
  }

  /* Copy-ready handoff blocks. */
  .map-analytics-snippet { position: relative; margin-bottom: 16px; }
  .map-analytics-snippet pre {
    background: #2f3640; color: #e6e9ec; border: 0; border-radius: 8px;
    padding: 16px 16px 16px 18px; font-size: 12px; line-height: 1.6; overflow-x: auto; margin: 0;
    white-space: pre;
  }
  .map-analytics-copy {
    position: absolute; top: 10px; right: 10px; border: 0; border-radius: 5px;
    background: rgba(255,255,255,.14); color: #fff; font-size: 11px; padding: 5px 10px; cursor: pointer;
  }
  .map-analytics-copy:hover { background: rgba(255,255,255,.26); }

  .map-analytics-warn {
    background: #fdf3e6; border: 1px solid #f2ddbe; color: #8a5d16;
    padding: 12px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px;
  }
  .map-analytics-warn code { background: rgba(0,0,0,.06); color: inherit; }

  .map-analytics-checklist { margin: 0; padding-left: 18px; color: #55606d; font-size: 13px; line-height: 1.9; }

  .map-analytics-save {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 0 4px; border-top: 1px solid #edeff2; margin-top: 6px;
  }
  .map-analytics-save .btn-save {
    background: #3c8c51; border: 0; color: #fff; padding: 10px 26px; border-radius: 6px;
    font-size: 14px; font-weight: 500; cursor: pointer;
  }
  .map-analytics-save .btn-save:hover { background: #347946; }
  .map-analytics-save .note { color: #93a0ad; font-size: 12px; }
