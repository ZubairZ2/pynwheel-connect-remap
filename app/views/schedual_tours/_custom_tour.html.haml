.modal.fade{:id => "customTourModal", :class => "customTourModal", "aria-hidden" => "true", "aria-labelledby" => "customTourModal#{tour_user.id}", :role => "dialog", :tabindex => "-1"}
  .modal-dialog.modal-md
    .modal-content
      .modal-header
        %h4#myModalLabel.modal-title 
          %strong Manage Scheduled Tour
        %button.close.close-modal-btn{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"} ×
      .modal-body
        %strong Tour Date & Time:
        = scheduled_tour_date_time(tour)
        %br
        %strong Visitor Name: 
        = tour_user_name(tour_user)
        %br
        %strong Visitor Email:
        = tour_user.email
        %br
        %strong Visitor Phone:
        = tour_user.phone_number
        %br

        %alert.alert-info.set-standard-tour
          %span Your customized tour is removed and set to community standard tour

      .modal-footer
        - if tour.is_tour_completed
          %a.btn.btn-success.pull-right{:href => schedule_tour_of_user(community, community_code, tour_user.id)} Schedule Another Tour

        - else
          - if is_tour_in_future(community, tour)
            %a.btn.btn-success{:href => reschedule_tour(tour, community, community_code)} Reschedule Tour
            %a.btn.btn-primary{"data-target" => "#customizeStopsModal#{tour.id}", "data-toggle" => "modal", :href => "#"} Customize Tour

          - if is_tour_customized(tour)
            %button.btn.btn-warning{:type => "button", :onclick => "resetToStandardTour(#{community.id}, #{tour_user.id})"} Reset to Standard Tour

= render :partial => 'customize_tour_stops', :locals => {tour_user: tour_user, tour: tour, community: community, community_code: community_code, community_tour_stops: community_tour_stops}
%div{ :id => "customize-tour-stops-#{tour.id}", data: { tour_stops: get_visible_tour_stops(community, tour) } }
