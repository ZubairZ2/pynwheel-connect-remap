- content_for :title, "Schedule Tours - Pynwheel"
.divLoading.hidden
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          VISITORS
    .row{:style => "margin-bottom: 70px;"}
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12#outer_div
            .box.box-widget.panel-box.add-plan.pt-30
              
              %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units.schedule_tour_table
                %thead
                  %tr
                    %th{:style => "width: 55px;"}
                      Sr #
                    %th
                      Date & Time
                    %th
                      Name
                    %th
                      Email
                    %th
                      Phone
                    %th
                      Action

              
                %tbody
                  - ind = 0
                  - @schedual_tours.each_with_index  do |tour,index|
                    - @tour_user = tour.tour_user
                    - if @tour_user.present?
                      .row
                        %tr
                          %td
                            = ind = ind + 1
                          %td
                            = tour.tour_date.to_s + " " + tour.tour_time.strftime("%I:%M%p")
                          %td
                            = @tour_user.first_name.present? ? (@tour_user.first_name + " " + @tour_user.last_name) : @tour_user.name 
                          %td
                            = @tour_user.email
                          %td
                            = @tour_user.phone_number
                          %td
                            %a.text-danger{"data-name"=>"Tour","data-href" => "/communities/#{@community.id}/schedual_tours/#{tour.id}?delete_type=page", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash.icon_size
                          

.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "visitor_index_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
:javascript
  if(window.location.href.includes('userSearch'))
  {
    email = window.location.href.split('userSearch');
    oTable = $('#miyazaki').DataTable(); 
    oTable.search(email[1]).draw();
  }