- content_for :title, "Schedule Tours - Pynwheel"
.divLoading.hidden
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          Scheduled Tours
        - unless (@community&.credential&.use_different_crm_provider && @community&.crm_credential&.crm_provider == "salesforce")
          %a.btn.btn-success.pull-right{:href => schedule_tour_url(@community, @community_code)} Schedule Tour
        
    .row{:style => "margin-bottom: 70px;"}
      .col-lg-12.col-md-12
        .row
          .col-md-12#outer_div
            .box.box-widget.panel-box.add-plan.pt-30
              %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units.schedule_tour_table.scheduled-visitors-detailed-table.scheduled-tours-table{"data-source" => schedual_tours_url(community:@community,community_code:@community_code,format: "json")}
                %thead
                  %tr
                    %th{:style => "width: 55px;"} Sr #
                    %th Date & Time
                    %th Tour Type
                    %th Name
                    %th Email
                    %th Phone
                    %th Created By
                    %th Actions
              
                %tbody

%div{ :id => "edit-modal-data" }

:javascript
  $(document).ready(function () {
    $('#miyazaki.scheduled-tours-table').DataTable(
      {
        "paging": true,
        "info": true,
        "sAjaxSource": $('#miyazaki').data('source'),
        "bProcessing": true,
        "sSearch": true,
        "oLanguage": {
          "sProcessing": '<div class="divLoading" ></div>'
        },
        "bServerSide": true,
        "bDeferRender": true,
        "columnReorder": true,
        "lengthMenu": [ 5, 10, 25, 50, 100 ],
        "pageLength": 10,
        'columnDefs': [{ 'orderable': false, 'targets': [0,7] }], // hide sort icon on header of first column
        'aaSorting': [[1, 'asc']]
        //"iSortCol_0": true; 
      }
    );
      
      $('.input-sm').on('keyup',function(){
        $(".dataTables_processing").hide();
      });
    $('.dataTables_length').addClass('bs-select');
  });
  if(window.location.href.includes('userSearch'))
  {
    email = window.location.href.split('userSearch=');
    oTable = $('#miyazaki').DataTable(); 
    oTable.search(email[1]).draw();
  }