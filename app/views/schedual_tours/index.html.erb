<p id="notice"><%= notice %></p>

<h1>Schedual Tours</h1>

<table>
  <thead>
    <tr>
      <th>Tour date</th>
      <th>Tour time</th>
      <th>Tour user</th>
      <th>Tour</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @schedual_tours.each do |schedual_tour| %>
      <tr>
        <td><%= schedual_tour.tour_date %></td>
        <td><%= schedual_tour.tour_time %></td>
        <td><%= schedual_tour.tour_user %></td>
        <td><%= schedual_tour.tour %></td>
        <td><%= link_to 'Show', schedual_tour %></td>
        <td><%= link_to 'Edit', edit_schedual_tour_path(schedual_tour) %></td>
        <td><%= link_to 'Destroy', schedual_tour, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Schedual Tour', new_schedual_tour_path %>
