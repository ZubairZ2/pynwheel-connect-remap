.modal.fade{:id => "customizeStopsModal#{tour.id}", :class => "customizeStopsModal", "aria-hidden" => "true", "aria-labelledby" => "customizeStopsModal#{tour.id}", :role => "dialog", :tabindex => "-1"}
  .modal-dialog.modal-md
    .modal-content
      .modal-header
        %h4#myModalLabel.modal-title 
          %strong Customize Tour
        %button.close.close-modal-btn{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"} ×
      - if tour_user.customized_tour(community)
        .modal-body
          %div{:style => "color: red"} 
            %strong{:style => "font-size: 16px;"} Note:
            %span Visitor already customized their tour from Pynwheel Tour app you can not customize tour for this user.
      - else 
        .modal-body
          .row.tour_stop_display
            .col-lg-2.col-md-2.col-sm-2
              %strong Builing
            .col-lg-2.col-md-2.col-sm-2
              %strong Floor
            .col-lg-6.col-md-6.col-sm-6
              %strong Stop Name
            .col-lg-2.col-md-2.col-sm-2
              %strong Visibility

          - if community_tour_stops.present?
            - community_tour_stops.each do |stop|
              .row.tour_stop_display
                .col-lg-2.col-md-2.col-sm-2
                  %span 
                    = get_building(stop, community)
                .col-lg-2.col-md-2.col-sm-2
                  %span 
                    = get_floor(stop, community)
                .col-lg-6.col-md-6.col-sm-6
                  %span{:id => "stopName#{stop.id}", :class => "#{is_visible(tour, stop) ? "" : "add-line-on-stop"}"}
                    = stop.name
                  
                .col-lg-2.col-md-2.col-sm-2
                  - if stop_should_be_visible(stop)
                    %i.tour_stop_visibility{ id: "display_stop", :onclick => "handleTourStopsVisibility(#{ stop.id }, #{tour_user.id});", :data => {:idattr => stop.id}, class: "stop_eye_slash#{stop.id}#{tour_user.id} fa #{is_visible(tour, stop) ? "fa-eye" : "fa-eye-slash"} text-warning ml-5" }
                
                  %alert.alert-info.customize-stop-success{:id => "customize-stop-success-#{stop.id}"}
                    %span{:id => "customize-stop-success-text-#{stop.id}" } Tour stop is customized
            

          - else
            %secondry Tour does not have any stop 
          
          %alert.alert-info.save-customized-stops
            %span Your tour has been customized

        .modal-footer
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Close
          %a.btn.btn-success{:onclick => "CustomizeUserTour(#{community.id}, #{tour_user.id})" } Customize Stops