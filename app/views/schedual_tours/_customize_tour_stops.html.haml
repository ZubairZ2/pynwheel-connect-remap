.modal.fade{:id => "customizeStopsModal#{tour.id}", :class => "customizeStopsModal", "aria-hidden" => "true", "aria-labelledby" => "customizeStopsModal#{tour.id}", :role => "dialog", :tabindex => "-1"}
  .modal-dialog.modal-md
    .modal-content
      .modal-header
        %h4#myModalLabel.modal-title 
          %strong Customize Tour
        %button.close.close-modal-btn{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"} ×
      .modal-body
        %strong Tour Stops :
        %br
        - if community_tour_stops.present?
          - community_tour_stops.each_with_index do |stop, index|
            .row.tour_stop_display
              .col-lg-6.col-md-6.col-sm-6
                %span
                  = stop.name
              .col-lg-6.col-md-6.col-sm-6
                %i.tour_stop_visibility{ id: "display_stop", :onclick => "handleTourStopsVisibility(#{ stop.id }, #{tour_user.id});", :data => {:idattr => stop.id}, class: "stop_eye_slash#{stop.id}#{tour_user.id} fa #{is_visible(tour_user, stop) ? "fa-eye" : "fa-eye-slash"} text-warning ml-5" }
              
                %alert.alert-info.customize-stop-success{:id => "customize-stop-success-#{stop.id}"}
                  %span{:id => "customize-stop-success-text-#{stop.id}" } Tour stop is customized
          

        - else
          %secondry Tour does not have any stop 
        
        %alert.alert-info.save-customized-stops
          %span Your tour has been customized

      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Close
        %a.btn.btn-success{:onclick => "CustomizeUserTour(#{community.id}, #{tour_user.id})" } Customize Stops