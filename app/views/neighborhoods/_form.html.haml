        html: true,
        template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding" style="color: black;">Change the address to change the address of the property. </div><div class="popover-footer"><a id="neighbourhoodAddressPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
