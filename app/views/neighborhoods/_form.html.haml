.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Page Name
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        Changing the Page Name will change the menu label for this page in the Pynwheel app .


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :neighborhood_name, :class=>"form-control neighborhood-form-field"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Show Page
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        Switching show this page will change whether or not this page appears in the Pynwheel app.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :show_neighborhood, class: "neighborhood-form"
      %label.label-primary{:for => "neighborhood_show_neighborhood"}
      %span.pl-15 Yes
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Add to Home Page Menu
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        Switching add to home page menu will change whether or not there is a menu button for this page on the home page of the Pynwheel app.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :display_neighborhood_on_homepage, class: "neighborhood-form"
      %label.label-primary{:for => "neighborhood_display_neighborhood_on_homepage"}
      %span.pl-15 Yes

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        Change the address to change the address of the property.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :address, :class=>"form-control validate[required]", :placeholder=>"Address", :maxlength=>"150", :value=> @neighborhood.address.present? ? @neighborhood.address : @community.make_address
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Latitude
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        The latitude and longitudinal position of the property is pre-populated by the property's address. If the property marker appears in the incorrect position on the neighborhood map, manually adjust the latitude and/or longitude to reposition it.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :latitude, :class=>"form-control validate[required,custom[onlyLatitude]] neighborhood-form-field", :placeholder=>"Latitude" ,:maxlength=>"15", :id=>"latitude", :value=> @neighborhood.latitude.present? ? @neighborhood.latitude : @community.latitude
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Longitude
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        The latitude and longitudinal position of the property is pre-populated by the property's address. If the property marker appears in the incorrect position on the neighborhood map, manually adjust the latitude and/or longitude to reposition it.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :longitude, :class=>"form-control validate[required,custom[onlyLongitude]] neighborhood-form-field", :placeholder=>"Longitude" ,:maxlength=>"15", :id=>"longitude", :value=> @neighborhood.longitude.present? ? @neighborhood.longitude : @community.longitude
- if current_user.is_super_admin?    
  .form-group
    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
      Radius
      %i.propertyDetailName.fa.fa-question-circle
        %span#propertyDetailNameText
          Change the radius to change the distance of the results on the neighborhood map are from the property. The smaller the radius; the closer the results.

    .col-sm-12.col-lg-9.col-md-9.col-xs-12
      = f.text_field :radius, :class=>"form-control validate[required,custom[onlyNumber&Decimal]] neighborhood-form-field", :placeholder=>"Radius", :value=> @neighborhood.radius.present? ? @neighborhood.radius : 5000,:maxlength=>"10"
  .form-group
    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
      Zoom
      %i.propertyDetailName.fa.fa-question-circle
        %span#propertyDetailNameText
          Change the zoom to change how close the map is zoomed around the property on the neighborhood page.

    .col-sm-12.col-lg-9.col-md-9.col-xs-12
      = f.text_field :zoom, :class=>"form-control validate[required,custom[onlyNumber],custom[zoomRange]] neighborhood-form-field", :placeholder=>"Zoom", :value=> @neighborhood.zoom.present? ? @neighborhood.zoom : 14, :maxlength=>"2"
  .form-group
    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
      Remove Listing
      %i.propertyDetailName.fa.fa-question-circle
        %span#propertyDetailNameText
          Add a business name here to remove it from the results on the neighborhood map.

    .col-sm-12.col-lg-9.col-md-9.col-xs-12
      = f.text_field :listing, :class=>"form-control neighborhood-form-field","data-role"=>"tagsinput"     
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Categories
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        Changing the categories will change the categories that can be seen on the neighborhood map.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .multiselect
      .show-categories
        = @neighborhood.category
      %ul#multiselect{style: "display:none;"}
        %li{:class=> set_active_class('Dining',@neighborhood.category), 'data-title' => 'Dining'}
          %a
            %i.fa.fa-check
            Dining
        %li{:class=> set_active_class('Shopping',@neighborhood.category), 'data-title' => 'Shopping'}
          %a
            %i.fa.fa-check 
            Shopping
        %li{:class=> set_active_class('Entertainment',@neighborhood.category), 'data-title' => 'Entertainment'}
          %a
            %i.fa.fa-check 
            Entertainment
        %li{:class=> set_active_class('Schools',@neighborhood.category), 'data-title' => 'Schools'}
          %a
            %i.fa.fa-check
            Schools
        %li{:class=> set_active_class('Banks',@neighborhood.category), 'data-title' => 'Banks'}
          %a
            %i.fa.fa-check 
            Banks
        %li{:class=> set_active_class('Parks',@neighborhood.category), 'data-title' => 'Parks'}
          %a
            %i.fa.fa-check 
            Parks
        %li{:class=> set_active_class('Errands',@neighborhood.category), 'data-title' => 'Errands'}
          %a
            %i.fa.fa-check 
            Errands
= f.hidden_field :category, :multiple => true, id: "categories_field",:class=>"neighborhood-form-field"

- unless @neighborhood.new_record?
  .btn-btn-danger
    = link_to community_neighborhood_locations_path(@community,@neighborhood),style: "font-family: unset;", class: "btn btn-success" do
      %i.fa.fa-plus-circle
      ADD PLACES
    %i.propertyDetailName.fa.fa-question-circle
      %span#propertyDetailNameText
        Click on "Add Places" to add businesses to the results of the neighborhood map.

    
:javascript

  $('#neighborhood_show_neighborhood').change(function(){
    if (!($(this).is(':checked')))
    {
      $('#neighborhood_display_neighborhood_on_homepage').prop('checked',false); 
    }
    $('.neighborhood-form-field').submit();
  });
  $('#neighborhood_display_neighborhood_on_homepage').change(function(){
    if (!($('#neighborhood_show_neighborhood').is(':checked')))
    {
      $('#neighborhood_display_neighborhood_on_homepage').prop('checked',false);
      
    }
    else
    {
      $('.neighborhood-form-field').submit();
    }
  });
