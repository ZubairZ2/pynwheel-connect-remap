.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :address, :class=>"form-control validate[required]", :placeholder=>"Address", :maxlength=>"150", :value=> @neighborhood.address.present? ? @neighborhood.address : @community.make_address
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Latitude

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :latitude, :class=>"form-control validate[required,custom[onlyLatitude]]", :placeholder=>"Latitude" ,:maxlength=>"15", :id=>"latitude", :value=> @neighborhood.latitude.present? ? @neighborhood.latitude : @community.latitude
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Longitude

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :longitude, :class=>"form-control validate[required,custom[onlyLongitude]]", :placeholder=>"Longitude" ,:maxlength=>"15", :id=>"longitude", :value=> @neighborhood.longitude.present? ? @neighborhood.longitude : @community.longitude
- if current_user.is_super_admin?    
  .form-group
    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
      Radius

    .col-sm-12.col-lg-9.col-md-9.col-xs-12
      = f.text_field :radius, :class=>"form-control validate[required,custom[onlyNumber&Decimal]]", :placeholder=>"Radius" ,:maxlength=>"10"