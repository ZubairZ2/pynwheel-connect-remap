- content_for :title, "Neighborhood - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Neighborhood

      = form_for [@community,@neighborhood],:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "Cancel" , community_neighborhoods_path(@community), :class=>"btn btn-default pull-right"
          = f.submit "Add Neighborhood", :class=>"btn btn-success pull-right mr-10"