- content_for :title, "Neighborhood - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-bank
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          NEIGHBORHOOD
          %span SETTINGS

      = form_for [@community,@neighborhood], :html=>{:class=>"form-horizontal neighborhood-form"},:remote=>true do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        / .box-footer
        /   = link_to "Cancel" , community_neighborhoods_path(@community), :class=>"btn btn-default pull-right"
        /   = f.submit "Save", :class=>"btn btn-success pull-right mr-10"
:javascript
  $('.neighborhood-form-field').change(function(){
    $('.neighborhood-form').submit();
  });
