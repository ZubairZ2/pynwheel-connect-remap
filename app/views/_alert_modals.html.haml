- unless current_community.nil?       
  #share-webpages.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
    .modal-dialog
      .modal-content
        .modal-header
          Share Webpages Link
        .modal-body
          %input.form-control#url{:value =>'<iframe src="'+community_webpages_url(current_community)+'" width="100%" height="800"></iframe>'}/
        .modal-footer
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} cancel
          %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#url"} Copy to clipboard
#image-size-warning.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Warning
      .modal-body
        File cannot be greater than 10MB
      .modal-footer
