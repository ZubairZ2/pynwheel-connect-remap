- unless current_community.nil?       
  #share-webpages.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
    .modal-dialog
      .modal-content
        .modal-header
          Copy and paste the Pynwheel Map iframe embed code or page url below and share it with your web developer to add the interactive map to your website.
        .modal-body
          %strong Pynwheel map page url:
          .input-group.mb-2
            %input.form-control#web-url{:value => current_community.map_link()}
            %span.input-group-btn
              %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#web-url"} Copy

          %br

          %strong Pynwheel map iframe embed code:
          .input-group.mb-2
            %input.form-control#embed-url{:value => current_community.map_embed_code()}
            %span.input-group-btn
              %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#embed-url"} Copy

          - if current_community.is_floor_level_map
            %br
            %div{:style => "border-top: 1px solid #ccc; margin-top: 10px; margin-bottom: 10px;"}
              %br
              %strong Floor Level Map URLs:
            - current_community.property_floor_numbers.each do |floor|
              .input-group{:style => "margin-bottom: 5px;"}
                %span.input-group-addon 
                  %strong Level #{floor}
                %input.form-control{:id => "map_floor_#{floor}", :value => current_community.map_link(nil, floor)}
                %span.input-group-btn
                  %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#map_floor_#{floor}"} Copy
          
        .modal-footer
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Close


  #share-scheduler-widget.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
    .modal-dialog
      .modal-content
        .modal-header
          Copy and paste the code below and share it with your web developer to add the scheduler widget to your website.
        .modal-body
          - dimension = "height: " + @schedule_widget_setting.btn_height.to_s + "px; width: " + @schedule_widget_setting.btn_width.to_s + "px;"
          %input.form-control#schedule-url{:value =>'<embed style="'+ dimension +'"src="'+root_url+'/scheduler_widget/scheduler_widget_button?community_id='+current_community.id.to_s+'&community_code='+@community_code+'&id='+@schedule_widget_setting.id.to_s+'"width="fit-content%" height="fit-content" />'}

        .modal-footer
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel
          %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#schedule-url"} Copy to clipboard
  #share-scheduler-widget-link1.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
    .modal-dialog
      .modal-content
        .modal-header
          Copy and paste the code below and share it with your web developer to add the scheduler widget to your website.
        .modal-body
          %input.form-control#schedule-link-url{:value =>root_url+'scheduler_widget/test_widget?community_id='+current_community.id.to_s+'&community_code='+@community_code+'&direct=true'}

        .modal-footer
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel
          %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#schedule-link-url"} Copy to clipboard        
  -# #share-chat-widget.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  -#   .modal-dialog
