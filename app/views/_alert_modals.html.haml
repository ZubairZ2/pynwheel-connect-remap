#image-upload-warning.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Warning
      .modal-body
        Only JPEG,PNG,JPG files are allowed
      .modal-footer
        %button.btn.btn-primary{"data-dismiss" => "modal", :type => "button"} Ok
