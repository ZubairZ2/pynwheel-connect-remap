#welcome-prompt-modal1.modal.welcome_modal.fade{"aria-hidden" => "true","data-backdrop" => "static", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content.welcome_content
      %img{:alt => "Smiley face", :src => "/assets/message_box.png"}/
      .modal-footer
        %button.btn.btn-primary{"data-dismiss" => "modal",:class => "welcome_prompt_btn1", :type => "button"} Ok
