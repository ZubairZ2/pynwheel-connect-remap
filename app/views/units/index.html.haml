
%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "#"} Home
    %li.active
      %a{:href => "#"} Units
  .clearfix
.clearfix
/ Main content
%section
  .row.mt-25.mb-20
    .form-group
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
        Select Community
      .col-sm-12.col-lg-12.col-md-12.col-xs-12    
        = select_tag :communities_at_units, options_for_select(@communities.collect{|c| [c.name,c.id]},params[:community_id]), :class=>"form-control"
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Units
    #units-index
      = render 'index'
:javascript
  $("#communities_at_units").change(function(){
    var community_id = $('#communities_at_units').val();

    $.ajax({
      url: "/communities/"+community_id+"/units",
      type: "GET",
      dataType: "script"
    });
  });      
