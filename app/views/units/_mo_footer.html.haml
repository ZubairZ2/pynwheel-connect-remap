-# Shared dialog footer. The count is filled in by the page's JS from the live
-# grid selection, so every dialog states exactly what it is about to change.
.mo-foot
  %span.mo-target.js-mo-target
  .mo-foot-actions
    %button.btn.btn-ghost{type: "button", "data-mo-close" => true} Cancel
    %button.btn.btn-primary{type: "submit"}= verb
