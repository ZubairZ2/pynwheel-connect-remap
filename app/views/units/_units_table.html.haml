-# The filterable half of the units page. Rendered standalone (no layout) for the
-# toolbar's XHR, so filtering, sorting and paging never re-render the page
-# chrome or the mass override modals.
- show_on_map = SHOW_ON_MAP.include?(@community.data_provider)
- tour_order = PROPERTIES_LIST.include?(@community.id)

.units-meta
  %span.units-count
    = pluralize(@units.total_entries, "unit")
    - if @units.total_pages > 1
      %span.units-page-n= "· page #{@units.current_page} of #{@units.total_pages}"
    - if per_page_capped?
      %span.units-page-n= "· showing the first #{number_with_delimiter(per_page)}"
  .units-perpage
    %span.muted Rows
    - UnitsController::PER_PAGE_OPTIONS.each do |option|
      = link_to option, units_page_path(per_page: option, page: nil), class: "pp#{' on' if !showing_all? && per_page == option}", "data-remote-nav" => true
    = link_to "All", units_page_path(per_page: "all", page: nil), class: "pp#{' on' if showing_all?}", "data-remote-nav" => true, title: "Show every matching unit on one page"

- if @units.empty?
  .units-empty
    %p.units-empty-title No units match these filters.
    %p.muted Try widening the search, or clear the filters to see all #{pluralize(@community.units.count, 'unit')}.
- else
  .table-wrap
    %table.units-table
      %thead
        %tr
          %th.cb
            %input#select-page{type: "checkbox", title: "Select every unit on this page"}
          = render "sort_header", key: "name", label: "Unit"
          = render "sort_header", key: "floorplan", label: "Floor Plan"
          = render "sort_header", key: "price", label: "Price", align: "right"
          = render "sort_header", key: "available_date", label: "Availability"
          = render "sort_header", key: "floor", label: "Location"
          %th.flag{title: "Manual Override — when on, these values stop following the property's data feed"} Override
          %th.flag Sold
          - if show_on_map
            %th.flag{title: "Show on Map"} Map
          - if tour_order
            %th Tour Order
          %th Lock
          %th Plan
          %th.right Actions
      %tbody
        - @units.each do |u|
          - floorplan = @floorplans_by_provider_id[u.floorplan_id]
          %tr{class: ("overridden" if u.manual_override), "data-unit-id" => u.id}
            %td.cb
              %input.js-row-cb{type: "checkbox", value: u.id}
            %td.c-unit
              .u-name{feed_pinned_attrs(u.name_is_updated, "Unit name")}
                = best_in_place u, :marketing_name, url: community_unit_path(@community, u), display_as: (@community.data_provider == "yardi" ? :provider_unit_id : :unit_market)
              - if u.provider_unit_id.present? && @community.data_provider != "yardi"
                .u-sub= u.provider_unit_id
            %td.c-plan
              .u-plan{feed_pinned_attrs(u.floorplan_id_is_updated, "Floor plan")}
                = best_in_place u, :floorplan_id, as: :select, collection: @floorplans.map { |f| [f.provider_floorplan_id, f.name] }, url: community_unit_path(@community, u)
              - if floorplan
                .u-sub= floorplan_specs(floorplan, unit_square_feet: u.square_feet)
            %td.right.c-price{feed_pinned_attrs(u.effective_rent_is_updated, "Price")}
              %span.cur= @currency_symbol
              = best_in_place u, :effective_rent, as: :input, url: community_unit_path(@community, u), display_as: :show_integer_rent
            %td.c-avail
              %span.u-flag{class: [(u.available ? "yes" : "no"), ("edited" if u.available_is_updated || u.availability_is_updated)].compact.join(" "), title: ((u.available_is_updated || u.availability_is_updated) ? "Availability was set by hand, so the data feed will not update it. Clear it with Mass overrides → Field overrides." : nil)}
                = best_in_place u, :available, as: :checkbox, collection: { false: "Not available", true: "Available" }, url: community_unit_path(@community, u)
              .u-sub{feed_pinned_attrs(u.available_date_is_updated, "Available date")}
                = best_in_place u, :available_date, as: :date, url: community_unit_path(@community, u), place_holder: (u.sold ? "Never available" : "—")
            %td.c-loc
              .u-kv
                %span.k Floor
                %span.v{feed_pinned_attrs(u.floor_is_updated, "Floor")}
                  = best_in_place u, :floor, url: community_unit_path(@community, u), place_holder: "—"
              .u-kv
                %span.k Bldg
                %span.v{feed_pinned_attrs(u.building_is_updated, "Building")}
                  = best_in_place u, :building, url: community_unit_path(@community, u), place_holder: "—"
            %td.flag
              %span.u-flag{class: (u.manual_override ? "on" : "off")}
                = best_in_place u, :manual_override, as: :checkbox, collection: { false: "No", true: "Yes" }, url: community_unit_path(@community, u)
            %td.flag
              %span.u-flag{class: [(u.sold ? "sold" : "off"), ("edited" if u.sold_is_updated)].compact.join(" ")}
                = best_in_place u, :sold, as: :checkbox, collection: { false: "No", true: "Yes" }, url: community_unit_path(@community, u)
            - if show_on_map
              %td.flag
                %span.u-flag{class: (u.show_on_map ? "on" : "off")}
                  = best_in_place u, :show_on_map, as: :checkbox, collection: { false: "No", true: "Yes" }, url: community_unit_path(@community, u)
            - if tour_order
              %td= best_in_place u, :tour_visiting_order_number, as: :input, url: community_unit_path(@community, u), place_holder: "—"
            %td.c-lock
              - if unit_lock_provider(u).present?
                = render partial: "attached_lock", locals: { u: u, community: @community }
              - else
                %span.u-none &mdash;
            %td.c-img
              - thumb = u.validated_image_url || (floorplan && (floorplan.validated_image_url || (floorplan.secondary_image.present? && floorplan.secondary_image.url)))
              - if thumb
                = image_tag thumb, class: "u-thumb", loading: "lazy", alt: ""
              - else
                %span.u-thumb.empty
            %td.right.c-actions
              .u-actions
                = link_to edit_community_unit_path(@community, u), class: "ico", title: "Edit unit" do
                  %i.fa.fa-pencil
                = link_to community_unit_amenities_path(@community, u), class: "ico", title: "Manage interior images" do
                  %i.fa.fa-picture-o
                - if @community.enable_pynwheel_pricing_calculator?
                  = link_to preview_unit_community_pricing_calculators_path(@community, unit_id: u.id), class: "ico", title: "Calculate cost", target: "_blank" do
                    %i.fa.fa-calculator
                - elsif @community.enable_pricing_calculator? && @community.pricing_calculator_embed_code.present?
                  = link_to "https://sightmap.com/embed/#{@community.pricing_calculator_embed_code}?unit_number=#{u.marketing_name}&mode=expense_calculator", class: "ico", title: "Calculate cost", target: "_blank" do
                    %i.fa.fa-calculator
                - if u.plotted_on_map?
                  %span.ico.static{title: "Plotted on the map"}
                    %i.fa.fa-map-marker
                - else
                  = link_to "#", class: "ico unit_toggle", title: "Show or hide this unit in the plotting list", data: { unit_id: u.id } do
                    %i.fa{class: u.visible ? "fa-eye" : "fa-eye-slash"}
                %a.ico.danger{href: "javascript:;", title: "Delete unit", "data-name" => "Unit", "data-href" => community_unit_path(@community, u), "data-target" => "#confirm-delete", "data-toggle" => "modal"}
                  %i.fa.fa-trash

  -# Cross-page escape hatch: rather than shipping ids the browser never
  -# rendered, this flips the next mass override to "everything matching the
  -# current filters", which the server re-resolves from the same filter params.
  #select-all-banner{style: "display:none", "data-total" => @units.total_entries}
    %span#sab-text
    %a#sab-all{href: "#"}= "Select all #{@units.total_entries} units matching these filters"
    %a#sab-clear{href: "#", style: "display:none"} Clear selection

  - if @units.total_pages > 1
    .pager
      = will_paginate @units, params: @filter.to_query_params
