.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-6.col-md-3.col-xs-12
        = f.select :floorplan_id, options_for_select(@community.floorplans.collect{|f| [f.name,f.id]}),{},{ :class=>"form-control"}
        %small Floorplan 
      .col-sm-6.col-lg-6.col-md-3.col-xs-12
        = f.select :availability, options_for_select(["Occupied","Unoccupied"]),{},{ :class=>"form-control"} 
        %small Availability 
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
   
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-3.col-xs-12
        = f.text_field :effective_rent, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"Rent"
        %small Base Rent
      .col-sm-6.col-lg-4.col-md-3.col-xs-12
        = f.text_field :building, :class=>"form-control", :placeholder=>"Building"
        %small Building
      .col-sm-6.col-lg-4.col-md-3.col-xs-12
        = f.text_field :marketing_name, :class=>"form-control validate[required]", :placeholder=>"Marketing Name"
        %small Unit Number  

:javascript
  $("form").validationEngine();          