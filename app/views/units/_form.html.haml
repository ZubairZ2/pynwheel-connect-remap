.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Unit Number
    %span Specify number here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :number, :class=>"form-control", :placeholder=>"Unit Number",:required=>true
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floorplan
    %span Specify Floorplan here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.select :floorplan_id, options_for_select(@community.floorplans.collect{|f| [f.name,f.id]}),{},{ :class=>"form-control"}
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Availability
    %span 
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.select :availability, options_for_select(["Occupied","Unoccupied"]),{},{ :class=>"form-control"}  
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Building
    %span 
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :building, :class=>"form-control", :placeholder=>"Building",:required=>true 
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Rent
    %span 
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :min_rent, :class=>"form-control", :placeholder=>"Rent",:required=>true        