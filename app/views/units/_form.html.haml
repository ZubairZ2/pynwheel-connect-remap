-# Unit form, shared by new and edit. Every field name, element id, validation
-# class and JS hook is unchanged from the original layout - only the structure
-# and styling are new. The lock section in particular is driven by the script at
-# the bottom of this file by id, so #unit_lock_provider, #manual_access_code,
-# #lock_access_code (which must contain a <label> the script rewrites),
-# #lock_input, #locks_list, #lock_id and the .*_options blocks all stay put.
- gated_hint = "Editable once Manual Override is on."

.u-section
  .u-section-head
    %h2 Data feed control
    %p This property syncs from its property management software. Turn Manual Override on to hand-edit the fields marked #{content_tag(:span, "feed", class: "gate-badge inline")} below and stop the feed overwriting them.
  .u-section-body
    .u-toggle-row
      %label.u-choice
        = f.radio_button :manual_override, true, class: "settings-field"
        %span
          %b Yes
          Hand-edited values win and stay put.
      %label.u-choice
        = f.radio_button :manual_override, false, class: "settings-field"
        %span
          %b No
          The data feed keeps this unit up to date.

.u-section
  .u-section-head
    %h2 Unit details
  .u-section-body
    .u-grid
      = unit_field "Marketing name", gated: true, hint: gated_hint do
        = f.text_field :marketing_name, class: "form-control validate[required]", placeholder: "e.g. 103-B"
      = unit_field "Provider unit ID", gated: true do
        = f.text_field :provider_unit_id, class: "form-control validate[required]", placeholder: "ID from your data provider"
      = unit_field "Floor plan", gated: true do
        = f.select :floorplan_id, [["", nil]] + @community.floorplans.order(:name).map { |fp| [floorplan_option_label(fp), fp.provider_floorplan_id] }, {}, { class: "form-control" }
      = unit_field "Price", gated: true do
        .u-prefix
          %span= @community.get_currency_symbol
          = f.text_field :effective_rent, class: "form-control validate[required,custom[onlyDecimal]]", placeholder: "0", maxlength: "9", value: f.object.effective_rent.to_i
      = unit_field "Availability", gated: true, hint: "Occupied units are hidden from the app regardless of the date below." do
        = f.select :availability, [["Occupied — not available", "Occupied"], ["Unoccupied — available", "Unoccupied"]], {}, { class: "form-control" }
      = unit_field "Available date", gated: true do
        = f.text_field :available_date, class: "form-control datepicker", placeholder: "Select a date", maxlength: "15", autocomplete: "off", readonly: true
      = unit_field "Unit status" do
        = f.text_field :unit_status, class: "form-control", placeholder: "e.g. Notice", value: f.object.unit_status
      = unit_field "Tour visiting order", hint: "Position of this unit in a self-guided tour." do
        = f.number_field :tour_visiting_order_number, class: "form-control", placeholder: "e.g. 1", min: 1, step: 1

.u-section
  .u-section-head
    %h2 Placement &amp; size
    %p A unit only appears on the interactive map once it has a floor.
  .u-section-body
    .u-grid
      = unit_field "Building", gated: true do
        = f.text_field :building, class: "form-control", placeholder: "e.g. B", maxlength: "20"
      = unit_field "Floor", gated: true do
        - if !@community.is_sitemap && f.object.floorplate.present?
          = f.select :floor, f.object.floorplate.floors, {}, class: "form-control validate[custom[floor]]"
        - else
          = f.text_field :floor, class: "form-control validate[custom[floor]]", placeholder: "e.g. 3"
      = unit_field "Square footage", gated: true, hint: "Leave at 0 to fall back to the floor plan's." do
        = f.text_field :square_feet, class: "form-control", placeholder: "0", value: f.object.square_feet.to_i

.u-section
  .u-section-head
    %h2 Status
  .u-section-body
    .u-grid
      = unit_field "Sold", gated: true, hint: "For-sale properties only. Marking sold also marks the unit occupied." do
        .u-inline-choices
          %label.u-radio
            = f.radio_button :sold, true, class: "settings-field"
            %span Yes
          %label.u-radio
            = f.radio_button :sold, false, class: "settings-field"
            %span No
      = unit_field "Model unit" do
        %label.u-check
          = f.check_box :modal_unit
          %span Show this unit as a model unit

.u-section
  .u-section-head
    %h2 Buttons &amp; links
    %p Buttons shown on the unit's card in the app. Additional buttons appear on the Pynwheel Map only.
  .u-section-body
    .u-grid
      = unit_field "Button label" do
        = f.text_field :virtual_tour_button_label, class: "form-control", placeholder: "3D Tour", maxlength: 15
      = unit_field "Button URL", span: 2 do
        = f.text_field :virtual_tour_url, class: "form-control", placeholder: "https://…"
      = unit_field "Open in new tab" do
        %label.u-check
          = f.check_box :link1_open_new_tab, { id: "link1_open_new_tab" }
          %span Open the button URL in a new tab
      = unit_field "Additional button label" do
        = f.text_field :additional_button, class: "form-control", placeholder: "Additional Button Label"
      = unit_field "Additional button URL", span: 2 do
        = f.text_field :additional_url, class: "form-control", placeholder: "https://…"
      = unit_field "Open in new tab" do
        %label.u-check
          = f.check_box :link2_open_new_tab, { id: "link2_open_new_tab" }
          %span Open the additional button URL in a new tab
      = unit_field "Additional button 2 label" do
        = f.text_field :scheduler_label, class: "form-control", placeholder: "Additional Button Label"
      = unit_field "Additional button 2 URL", span: 2 do
        = f.text_field :scheduler_url, class: "form-control", placeholder: "https://…"
      = unit_field "Open in new tab" do
        %label.u-check
          = f.check_box :link3_open_new_tab, { id: "link3_open_new_tab" }
          %span Open the second additional button URL in a new tab

= f.hidden_field :provider

- if @community.enable_locks
  - locks_present_hash = {}
  - locks_present_hash["Dwelo"] = @community.multiple_locks_provider.include?("Dwelo") && @community.dwelo.present? && @all_locks[:dwelo_locks].any?
  - locks_present_hash["EdgeState"] = @community.multiple_locks_provider.include?("EdgeState") && @community.edge_state.present? && @all_locks[:edgestate_locks].any?
  - locks_present_hash["Latch"] = @community.multiple_locks_provider.include?("Latch") && @community.latch.present? && @all_locks[:latch_locks].any?
  - locks_present_hash["Zerv"] = @community.multiple_locks_provider.include?("Zerv") && @community.zerv.present? && @all_locks[:zerv_locks].any?
  - locks_present_hash["Igloohome"] = @community.multiple_locks_provider.include?("Igloohome") && @community.igloohome.present? && @all_locks[:igloohome_locks].any?

  -# Hidden inputs and option pools the lock script reads from, by id/class.
  - if locks_present_hash["Dwelo"]
    = hidden_field_tag "dwelo_lock_input_value", (@door.present?) ? (@door.dwelo_lock.present? ? @door.dwelo_lock.name + " (" + @door.dwelo_lock.remote_lock_type + ")" : '') : (@unit.dwelo_locks.present? ? @unit.dwelo_locks.first.name + " (" + @unit.dwelo_locks.first.remote_lock_type + ")" : '')
    .dwelo_options.hide_it
      - @all_locks[:dwelo_locks].each do |lock|
        %option{value: "#{lock[:name]}", 'data-value' => "#{lock[:id]}"}
  - if locks_present_hash["EdgeState"]
    = hidden_field_tag "edgestate_lock_input_value", (@door.present?) ? (@door.edgestate_lock.present? ? @door.edgestate_lock.name + " (" + @door.edgestate_lock.remote_lock_type + ")" : '') : (@unit.edgestate_locks.present? ? @unit.edgestate_locks.first.name + " (" + @unit.edgestate_locks.first.remote_lock_type + ")" : '')
    .edgestate_options.hide_it
      - @all_locks[:edgestate_locks].each do |lock|
        %option{value: "#{lock[:name]}", 'data-value' => "#{lock[:id]}"}
  - if locks_present_hash["Latch"]
    = hidden_field_tag "latch_lock_input_value", (@door.present?) ? (@door.latch_lock.present? ? @door.latch_lock.lock_name : '') : (@unit.latch_locks.present? ? @unit.latch_locks.first.lock_name : '')
    .latch_options.hide_it
      - @all_locks[:latch_locks].each do |lock|
        %option{value: "#{lock[:name]}", 'data-value' => "#{lock[:id]}"}
  - if locks_present_hash["Zerv"]
    = hidden_field_tag "zerv_lock_input_value", (@door.present?) ? (@door.zerv_lock.present? ? @door.zerv_lock.sub_location_name + " (" + @door.zerv_lock.sub_location_friendly_name + ")" : '') : (@unit.zerv_locks.present? ? @unit.zerv_locks.first.sub_location_name + " (" + @unit.zerv_locks.first.sub_location_friendly_name + ")" : '')
    .zerv_options.hide_it
      - @all_locks[:zerv_locks].each do |lock|
        %option{value: "#{lock[:name]}", 'data-value' => "#{lock[:id]}"}
  - if locks_present_hash["Igloohome"]
    = hidden_field_tag "igloohome_lock_input_value", (@door.present?) ? (@door.igloohome_lock.present? ? @door.igloohome_lock.device_name : '') : (@unit.igloohome_locks.present? ? @unit.igloohome_locks.first.device_name : '')
    .igloohome_options.hide_it
      - @all_locks[:igloohome_locks].each do |lock|
        %option{value: "#{lock[:name]}", 'data-value' => "#{lock[:id]}"}

  .u-section
    .u-section-head
      %h2 Smart lock access
      %p Choose the access provider for this unit, then pick the physical lock it maps to.
    .u-section-body
      .u-grid
        = unit_field "Lock type" do
          = f.select :lock_provider, options_for_select(@community.lock_options(locks_present_hash), (@door.present?) ? @door.lock_provider : f.object.lock_provider), {}, { class: "form-control lock_provider_input" }

        -# Both of these are toggled by the script below and start hidden. The
        -# <label> inside #lock_access_code is rewritten by it with the chosen
        -# provider's name, so it has to stay a plain label element.
        .u-field.hide_it#manual_access_code
          %label.u-flabel Access code
          - access_code_value = f.object.door.present? ? f.object.door.access_code : f.object.access_code
          = f.text_field :access_code, oninput: "this.value = this.value.replace(/[^0-9#*]/g, '')", class: "form-control", placeholder: "Digits, # and * only", maxLength: "10", value: access_code_value

        .u-field.span-2.hide_it#lock_access_code
          %label.u-flabel Lock
          = text_field_tag :lock_input, '', placeholder: "Search by lock name", list: "locks_list", autocomplete: "off", type: "text", class: "form-control lock_provider_input"
          %datalist#locks_list
        = hidden_field_tag "lock_id", ""

-# Fees, Details title and Details used to sit inside the `enable_locks`
-# conditional above, so properties without smart locks could not edit any of
-# them from this page at all.
.u-section
  .u-section-head
    %h2 Content
    %p Copy shown on this unit's card when a renter opens it on the map.
  .u-section-body
    .u-stack
      = unit_field "Fees" do
        = f.text_area :additional_fee, class: "form-control wysihtml5", placeholder: "Enter Additional Fees"
      = unit_field "Details title", hint: 'Heading above the Details section. Defaults to "More Details".' do
        = f.text_field :description_title, class: "form-control", placeholder: "More Details"
      = unit_field "Details" do
        = f.text_area :description, class: "form-control unit-description-wysihtml5", placeholder: "Enter Description"
      - if @community.self_tour
        = unit_field "Directional text", hint: "Appears above the image on the self-guided tour. Only the first #{ENV['DESCRIPTION_LIMIT'].to_i} characters show on the page." do
          = f.text_area :stop_description, class: "form-control wysihtml5", placeholder: "Enter Directional Description", rows: "8"

.u-section
  .u-section-head
    %h2 Floor plan images
    %p Images render at 325 × 300 px. Anything smaller may look pixelated.
  .u-section-body
    .u-images
      = render "image_upload", f: f, attribute: :image, title: "Primary floor plan image",
                               note: "Replaces the floor plan's standard image for this unit.",
                               preview_id: "preview-image", lightbox_title: "Unit Primary Image",
                               crop_path: (f.object.image.present? && @unit.persisted? ? show_unit_image_in_modal_community_unit_path : nil),
                               remove_key: "primary"
      = render "image_upload", f: f, attribute: :secondary_image, title: "Secondary floor plan image",
                               note: "An optional second view of this unit's floor plan.",
                               preview_id: "preview-secondary-image", lightbox_title: "Unit Secondary Image",
                               crop_path: (f.object.secondary_image.present? && @unit.persisted? ? show_unit_secondary_image_in_modal_community_unit_path : nil),
                               remove_key: "secondary"

:javascript
  var characterLimit = parseInt("#{ENV["DESCRIPTION_LIMIT"]}")
  var community_id = #{params[:community_id]}
  var unit_id = #{@unit.id || 0}
  var door = '#{(@community.auto_wayfinding and @door.present?) ? "present" : "undefined"}'

  var locks_input, locks_list = "#locks_list";
  $(document).ready(function(){
    // run it on ready
    update_locks_select_and_lock_code_field()
    // provide locks on change
    $('#unit_lock_provider').change(function(){
      update_locks_select_and_lock_code_field();
    });

    function update_locks_select_and_lock_code_field(){
      if ($('#unit_lock_provider').length === 0) return;
      // if any lock selected
      if ($('#unit_lock_provider').val().length > 0 && $('#unit_lock_provider').val() != "Manual" ){
        $('#manual_access_code').addClass('hide_it')
        // initialize elements
        lock_provider_type = $('#unit_lock_provider').val().toLowerCase()
        lock_input_value = "#" + lock_provider_type + "_lock_input_value"
        options = '.' + lock_provider_type + "_options"
        locks_input = "#lock_input"
        // assign values
        if (lock_provider_type == "zerv")
          $('#lock_access_code').find('label').html("Lock <span>Assign the lock to this unit</span>")
        else
          $('#lock_access_code').find('label').html(capitalize(lock_provider_type) + " Lock <span>Assign the lock to this unit</span>")

        $('#lock_input').val( $(lock_input_value).val() )
        $('datalist#locks_list').html($(options).html())
        $('#lock_access_code').removeClass('hide_it')
      }
      else if ($('#unit_lock_provider').val().length > 0){
        $('#lock_access_code').addClass('hide_it')
        $('#manual_access_code').removeClass('hide_it')
        locks_input = undefined
      }
      else
      {
        $('#lock_access_code').addClass('hide_it')
        $('#manual_access_code').addClass('hide_it')
      }
    }
    setTimeout(function(){ $('.lock_provider_input').change(); }, 500);
    $('.lock_provider_input').change(function(){
      if (locks_input){
        var lock = $(locks_input)[0];
        if(lock.value == "")
            lock.setCustomValidity('')

        if(lock.checkValidity() == true){
          lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
          $('#lock_id').val(lock_id)
        }
      }
    });
  });

  $(".datepicker").datepicker({dateFormat: 'yy-mm-dd' });

  // The preview script swaps the <img> src in place; drop the empty styling so a
  // freshly chosen file renders at full strength.
  $(document).on("change", ".u-image-actions input[type=file]", function () {
    $(this).closest(".u-image").find(".u-image-frame").removeClass("empty");
  });

  // Mirrors the server rule: without Manual Override the data feed owns these
  // fields, so the form says so instead of repeating it under every input.
  (function () {
    var radios = document.querySelectorAll(".settings-field[name='unit[manual_override]']");
    function syncGates() {
      var on = document.querySelector(".settings-field[name='unit[manual_override]']:checked");
      var overridden = on && on.value === "true";
      document.querySelectorAll(".u-field.gated").forEach(function (field) {
        field.classList.toggle("feed-locked", !overridden);
      });
    }
    radios.forEach(function (r) { r.addEventListener("change", syncGates); });
    syncGates();
  })();

  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : true},
        events: {
                change: function(){
                    var el = $('#unit_stop_description');
                    if (!el.length || !el.data("wysihtml5")) return;
                    var wysihtml5Editor = el.data("wysihtml5").editor;
                    var t = wysihtml5Editor.getValue();
                    wysihtml5Editor.setValue(t.substr(0, characterLimit) + t.substr(characterLimit, t.length));
                },
                load: function(){
                    var el = $('#unit_stop_description');
                    if (!el.length || !el.data("wysihtml5")) return;
                    var wysihtml5Editor = el.data("wysihtml5").editor;
                    $('.wysihtml5-sandbox').contents().find('body').on("keydown", function(event) {
                      if (wysihtml5Editor.getValue() != "") {
                        var text_split = $('.unit_directional_text').text().split(" ")
                        var total_length = wysihtml5Editor.getValue().replace(/<(?:.|\n)*?>/gm, '').replace(/(\r\n|\n|\r)/gm,"").replace(/\&nbsp;/g, '').length
                        $('.unit_directional_text').text( text_split[0] + " " + text_split[1] + " " + (characterLimit - total_length)).toString()
                      }
                    });
                    var t = wysihtml5Editor.getValue();
                    wysihtml5Editor.setValue(t.substr(0, characterLimit) + t.substr(characterLimit, t.length));
                }
            }
        });
      });

      $('.unit-description-wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : true},
        events: {
                change: function(){
                    var el = $('#unit_description');
                    if (!el.length || !el.data("wysihtml5")) return;
                    var wysihtml5Editor = el.data("wysihtml5").editor;
                    var t = wysihtml5Editor.getValue();
                    wysihtml5Editor.setValue(t.substr(0, characterLimit) + t.substr(characterLimit, t.length));
                },
                load: function(){
                    var el = $('#unit_description');
                    if (!el.length || !el.data("wysihtml5")) return;
                    var wysihtml5Editor = el.data("wysihtml5").editor;
                    var t = wysihtml5Editor.getValue();
                    wysihtml5Editor.setValue(t.substr(0, characterLimit) + t.substr(characterLimit, t.length));
                }
            }
        });
      });
  })

  if (localStorage.getItem("floorplanCropped") == "1")
  {
    localStorage.setItem("floorplanCropped", "0");
    location.reload(true);
  }
