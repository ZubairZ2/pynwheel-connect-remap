.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Manual Override
    %i.unit_manualoverride.fa.fa-question-circle
      %span#unit_manualoverride_text
        When Manual Override is set to Yes, then the items that have been changed will not update automatically from the property's property management software data feed (if the property is using a third party data feed).

  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :manual_override, true, class: "settings-field"
    = f.label :manual_override, "Yes", :value => "true"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :manual_override, false, class: "settings-field"
    = f.label :manual_override, "No", :value => "false"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-3.col-xs-12
        = f.select :floorplan_id, @community.floorplans.collect{|f| [f.name,f.provider_floorplan_id]},{},{ :class=>"form-control"}
        %small Floor plan (Manual Override Required)
      .col-sm-6.col-lg-4.col-md-3.col-xs-12
        = f.select :availability, [['No', 'Occupied'], ['Yes', 'Unoccupied']],{},{ :class=>"form-control"}
        %small Availability (Manual Override Required)
      .col-sm-6.col-lg-4.col-md-3.col-xs-12
        = f.text_field :provider_unit_id, :class=>"form-control validate[required]", :placeholder=>"Provider Unit ID",:maxlength=>"7"
        %small Provider Unit ID  
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12

        = f.text_field :effective_rent, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"Rent",:maxlength=>"9", :value => f.object.effective_rent.to_i
        %small Price (Manual Override Required)
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :marketing_name, :class=>"form-control validate[required]", :placeholder=>"Marketing Name",:maxlength=>"5"
        %small Marketing Name (Manual Override Required)
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :available_date, :class=>"form-control datepicker", :placeholder=>"Available Date",:maxlength=>"15",:autocomplete=>"off",:readonly=>true
        %small Available Date (Manual Override Required)
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :building, :class=>"form-control", :placeholder=>"Building",:maxlength=>"20"
        %small Building (Manual Override Required)
      - unless @community.is_sitemap
        .col-sm-6.col-lg-4.col-md-4.col-xs-12
          = f.text_field :floor, :class=>"form-control validate[custom[floor]]", :placeholder=>"Floor"
          %small Floor (Manual Override Required)
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :square_feet, :class=>"form-control ", :placeholder=>"Unit space", :value => f.object.square_feet.to_i
        %small Square footage (Manual Override Required)

= f.hidden_field :provider
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Details

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :description,:class=>"form-control mb-20 validate[required] wysihtml5",:placeholder=>"Enter Description"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Available

  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :available, true, class: "settings-field"
    = f.label :manually_updated, "Yes", :value => "true"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :available, false, class: "settings-field"
    = f.label :available, "No", :value => "false"          
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Sold
    %i.unit_sold.fa.fa-question-circle
      %span#unit_sold_text
        This option is for For Sale properties only. When a Sold is set to Yes, then the details on the unit pop-up will show that the unit is sold.




  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :sold, true, class: "settings-field"
    = f.label :sold, "Yes", :value => "true"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :sold, false, class: "settings-field"
    = f.label :sold, "No", :value => "false"          

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Primary Image
    %span
      Upload primary image of this Unit.
      -#%br/

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .image-box.video-box
      .images.height-200
        %a.preview-image{:href=>f.object.image.present? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Unit Primary Image"}
          = image_tag f.object.image.present? ? f.object.image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-image", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :image

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Secondary Image
    %span
      Upload secondary image of this Unit.
      -#%br/

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .image-box.video-box
      .images.height-200
        %a.preview-image{:href=>f.object.secondary_image.present? ? f.object.secondary_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Unit Secondary Image"}
          = image_tag f.object.secondary_image.present? ? f.object.secondary_image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-secondary-image", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :secondary_image
:javascript
  $(".datepicker").datepicker({dateFormat: 'yy-mm-dd' });
  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
      });
  })