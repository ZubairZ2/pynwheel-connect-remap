.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Sold
    %i.unit_sold.fa.fa-question-circle
      %span#unit_sold_text
        This option is for For Sale properties only. When a Sold is set to Yes, then the details on the unit pop-up will show that the unit is sold.

  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :sold, true, class: "settings-field"
    = f.label :sold, "Yes", :value => "true"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :sold, false, class: "settings-field"
    = f.label :sold, "No", :value => "false"          

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Model Unit
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-6.col-md-4.col-xs-12
        .checkbox
          = f.check_box :modal_unit
          %label Model unit

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{style: "margin-top: 50px;"}
    Primary Floor Plan Image
    %span
      THIS WILL REPLACE THE STANDARD FLOOR PLAN IMAGE FOR THIS UNIT.
      %br/
      Images will appear at a size of 325 x 300 px. Please note that images that are too small may appear pixelated.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .col-lg-5.col-md-5.col-sm-6.col-xs-6
      .slide-image
        .image-box.video-box
          .images.height-200
            %a.preview-image{:href=>f.object.image.present? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Unit Primary Image"}
              = image_tag f.object.image.present? ? f.object.image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-image", :style => "max-height: 190px; max-width: 270px;"
          = image_tag "exclamation-mark.png", class: "waring_exal #{f.object.image.present? ? ((f.object.image.width < 300 && f.object.image.height < 250) ? "" : "hidden") : "hidden"}", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"
        - if f.object.image.present?
          .icons
            %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{@community.id}/units/#{@unit.id}/remove_pri_scnd_image?image=primary", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
              %i.fa.fa-close{ style:"margin-right: 50PX;"}
      %span.btn.btn-default.black-button.btn-sm.btn-file
        Select Image
        = f.file_field :image

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label{style: "margin-top: 50px;"}
    Secondary Floor Plan Image
    %span
      Upload secondary floor plan image of this Unit.
      %br/
      Images will appear at a size of 325 x 300 px. Please note that images that are too small may appear pixelated.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .col-lg-5.col-md-5.col-sm-6.col-xs-6
      .slide-image
        .image-box.video-box
          .images.height-200
            %a.preview-image{:href=>f.object.secondary_image.present? ? f.object.secondary_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Unit Secondary Image"}
              = image_tag f.object.secondary_image.present? ? f.object.secondary_image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-secondary-image", :style => "max-height: 190px; max-width: 270px;"
          = image_tag "exclamation-mark.png", class: "waring_exal #{f.object.secondary_image.present? ? ((f.object.secondary_image.width < 300 && f.object.secondary_image.height < 250) ? "" : "hidden") : "hidden"}", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"
        - if f.object.secondary_image.present?
          .icons
            %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{@community.id}/units/#{@unit.id}/remove_pri_scnd_image?image=secondary", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
              %i.fa.fa-close{ style:"margin-right: 50PX;"}
      %span.btn.btn-default.black-button.btn-sm.btn-file
        Select Image
        = f.file_field :secondary_image
:javascript
  $(".datepicker").datepicker({dateFormat: 'yy-mm-dd' });
  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false},
        events: {
                change: function(){
                    var wysihtml5Editor = $('#unit_stop_description').data("wysihtml5").editor;
                    var t = wysihtml5Editor.getValue();
                    t1 = t.substr(0, 90)
                    t2 = t.substr(90, t.length)
                    t2 = t2.fontcolor("red");
                    wysihtml5Editor.setValue(t1 + t2);
                },
                load: function(){
                    $('.wysihtml5-sandbox').contents().find('body').on("keydown",function(event) {
                    if (wysihtml5Editor.getValue() != "")
                    {
                        var text_split = $('.unit_directional_text').text().split(" ")
                        var total_length = wysihtml5Editor.getValue().replace(/<(?:.|\n)*?>/gm, '').replace(/(\r\n|\n|\r)/gm,"").replace(/\&nbsp;/g, '').length
                        $('.unit_directional_text').text( text_split[0] + " " + text_split[1] + " " + (90 - total_length)).toString()
                        }
                    });
                    var wysihtml5Editor = $('#unit_stop_description').data("wysihtml5").editor;
                    var t = wysihtml5Editor.getValue();
                    t1 = t.substr(0, 90)
                    t2 = t.substr(90, t.length)
                    t2 = t2.fontcolor("red");
                    wysihtml5Editor.setValue(t1 + t2);
                    var text_split = $('.unit_directional_text').text().split(" ")
                    var total_length = wysihtml5Editor.getValue().replace(/<(?:.|\n)*?>/gm, '').replace(/(\r\n|\n|\r)/gm,"").replace(/\&nbsp;/g, '').length
                    $('.unit_directional_text').text( text_split[0] + " " + text_split[1] + " " + (90 - total_length)).toString()

                }
            }
        });

      });
  })

