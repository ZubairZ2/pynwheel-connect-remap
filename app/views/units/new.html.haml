%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Home
    %li
      %a{:href => "#"} Appartments
    %li
      %a{:href => "#{community_units_path(@community)}"} Units
    %li.active Add Unit
  .clearfix
.clearfix
/ Main content
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add Unit
          -#%span Plan
      / /.box-header
      / form start
      / <form class="form-horizontal">
      = form_for @unit,:url=>community_units_path(:community_id=>@community.id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "ADD UNIT", :class=>"btn btn-success pull-right"
