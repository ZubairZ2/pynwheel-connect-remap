  / End Panel left Side
  :javascript
     $(document).ready(function(){

      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
      });
    })
   
    $('#select_all_units_for_manual_override').change(function(){
      if($(this).is(':checked')){
        $('.manual-override-checkbox').prop('checked',true)
      }
      else{
        $('.manual-override-checkbox').prop('checked',false)
      }
    });
    $('#select_all_units_for_description').change(function(){
      if($(this).is(':checked')){
        $('.description-checkbox').prop('checked',true)
      }
      else{
        $('.description-checkbox').prop('checked',false)
      }
    });
    $('#select_all_units_for_sold').change(function(){
      if($(this).is(':checked')){
        $('.sold-checkbox').prop('checked',true)
      }
      else{
        $('.sold-checkbox').prop('checked',false)
      }
    });

    $('#select_all_units_for_available').change(function(){
      if($(this).is(':checked')){
        $('.available-checkbox').prop('checked',true)
      }
      else{
        $('.available-checkbox').prop('checked',false)
      }
    });

    $('#select_all_units_for_available_date').change(function(){
      if($(this).is(':checked')){
        $('.available-date-checkbox').prop('checked',true)
      }
      else{
        $('.available-date-checkbox').prop('checked',false)
      }
    });

    $('#select_all_units_for_image').change(function(){
      if($(this).is(':checked')){
        $('.image-checkbox').prop('checked',true)
      }
      else{
        $('.image-checkbox').prop('checked',false)
      }
    });

    $('#select_all_units_for_floor').change(function(){
      if($(this).is(':checked')){
        $('.floor-checkbox').prop('checked',true)
      }
      else{
        $('.floor-checkbox').prop('checked',false)
      }
    });

    $(".datepicker").datepicker({dateFormat: 'yy-mm-dd' }); 
    var url = "#{community_units_path(@community)}"
    $.datepicker.setDefaults({dateFormat: 'yy-mm-dd' }); 
    $('.best_in_place').bind("ajax:success", function () {
      var field = ""
      console.log($(this));
      switch($(this).data('bipAttribute')) {
        case 'effective_rent':
            field = "Rent"
            break;
        case 'floorplan_id':
            field = "Floor Plan"
            break;
        case 'marketing_name':
            field = 'Marketing Name'
            break;
        case 'availability':
            field = "Availability"
            break
        case 'available_date':
            field = "Available Date"
            break
        case 'manual_override':
            field = "Manual Override"
            break    
        case 'available':
            field = "Available"
            break    
        case 'sold':
            field = "Sold"
            break
        case 'square_feet':
            field = "Unit Space"
            break

      } 
      $(this).parent().parent().css('background-color','#cecece');
      var id = $(this).attr("id");
      id = id.split('_');
      if($(this).data('bipAttribute') == 'sold' && $(this).html() == 'Yes'){
        $('#best_in_place_unit_'+id[4]+'_manual_override').html('Yes');
        $('#best_in_place_unit_'+id[4]+'_available_date').html('Never Available');
        $('#best_in_place_unit_'+id[4]+'_available_date').css("pointer-events","none");

      }
      if($(this).data('bipAttribute') == 'sold' && $(this).html() == 'No'){
        $('#best_in_place_unit_'+id[4]+'_available_date').html("-");
        $('#best_in_place_unit_'+id[4]+'_available_date').css("pointer-events","");
      }
      if($('#best_in_place_unit_'+id[4]+'_manual_override').html() == 'No'){
        $(this).parent().parent().css('background-color','');
      }
      $('#flash-message').html('<div class="alert alert-success">'+field+' updated successfully.</div>');

      $('#best_in_place_unit_'+id[4]+'_floorplan_id').change(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
      });
      $('#best_in_place_unit_'+id[4]+'_marketing_name').change(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
      });
      $('#best_in_place_unit_'+id[4]+'_effective_rent').change(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
      });
      $('#best_in_place_unit_'+id[4]+'_available').click(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
      });
      $('#best_in_place_unit_'+id[4]+'_sold').click(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
      });
      $('#best_in_place_unit_'+id[4]+'_floor').change(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
      });
      $('#best_in_place_unit_'+id[4]+'_available_date').change(function(){
        //alert($('#best_in_place_unit_'+id[4]+'_available_date').html());
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
        if ($('#best_in_place_unit_'+id[4]+'_sold').html() == 'Yes' && $('#best_in_place_unit_'+id[4]+'_available_date').html() == '-')
        {
          $('#best_in_place_unit_'+id[4]+'_available_date').html('Never Available');
        }
      });

    });




    $('#best_in_place_unit_317_manual_override').change(function(){
      alert('okk');
    });

    $('.best_in_place').on('best_in_place:error', function (event, request, error) {
      $.each($.parseJSON(request.responseText), function (index, value) {
        if (typeof value === "object")
        {
          value = index + " " + value.toString();
        }
        $('#flash-message').html('<div class="alert alert-danger">'+value+'</div>');
      });
    });