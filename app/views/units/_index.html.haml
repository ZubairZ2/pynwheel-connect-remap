.row
  .col-lg-12.col-md-12
    .row
      .col-md-12
        .title-heading
          .box.box-info.add-plan
            .box-header
              %h3.box-title Units
      .col-md-12
        %a.btn.btn-success.loader_class{:href => "/communities/#{@community.id}/units/new",:style => "width: 140px;"}
          %i.fa.fa-plus-circle
          ADD UNIT
      .col-md-12
        .dropdown.mt-5
          %button.dropbtn.btn.btn-primary MASS OVERRIDES
          .dropdown-content.mass_override_dropdown
            %a{:href => "##",'data-target' =>'#modal-to-set-available', 'data-toggle' => 'modal'} Available
            %a{:href => "##","data-target" =>"#modal-to-set-available-date", "data-toggle" => "modal"} Available Date
            %a{:href => "##","data-target" =>"#modal-to-set-manual-override", "data-toggle" => "modal"} Manual Override
            %a{:href => "##","data-target" => "#modal-to-set-sold", "data-toggle" => "modal"} Sold
            %a{:href => '##',"data-target" => "#modal-to-change-floor", "data-toggle" => "modal"} Units Floor
            %a{:href => '##',"data-target" => "#modal-to-change-building", "data-toggle" => "modal"} Add Buildings
            %a{:href => "##","data-target" => "#modal-to-add-description", "data-toggle" => "modal"} Add Details
            %a{:href => "##","data-target" => "#modal-to-set-additional-fee", "data-toggle" => "modal"} Add Additional Fees
            %a{:href => "##","data-target" => "#modal-to-set-image", "data-toggle" => "modal"} Floor Plan Images

        %i.propertyDetailName.mb-20.fa.fa-question-circle{ "data-toggle" => "unitMassOverridePopover","data-content" => " "}
          %span#propertyDetailNameText
            Use this button to change data for multiple units at once, such as availability, floor number, details, and images.

      .col-md-12
        %h4{:style => "margin-left: 3px; color: grey;"}
          %p
            Add and manage units below.*
          %p
            Change "Manual Override" Yes to make quick changes directly in the grid.
          %p
            Or click the "edit" icon to manage the full unit details, including adding a unit-specific floor plan image and adding additional information about the unit such as finishes, specials, or unit-specific features.
          %p
            Details that have been changed manually will appear in red in the grid below.
          %p
            Click on "manage images" to add interior images.
      .col-md-12
        .box.box-widget.panel-box.mb-15.alert-danger
          %h5.ml-15.mb-20
            *Note: If you have made changes to units in your property management software, please contact Pynwheel support at support@pynwheel.com to import your data.
     
    .box.box-widget.panel-box
      .box-header     
        .row
          .col-md-12
            %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units.unit_data_table
              %thead
                %tr
                  %th Sr #
                  %th
                    Manual Override
                    %i.unit_manualoverride.fa.fa-question-circle{ "data-toggle" => "unitManualOverridePopover","data-content" => " "}
                      %span#unit_manualoverride_text
                        When Manual Override is set to Yes, then the items that have been changed will not update automatically from the property's property management software data feed.
                  %th
                    Name
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridNamePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the unit name will change how the name appears in the Pynwheel app.
                  %th
                    Floor Plan
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorplanPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the floor plan will change the floor plan associated with each unit.
                  %th
                    Price
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridPricePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the price will change the price associated with each unit.
                  %th
                    Available Date
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridAvailableDatePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the Available Date will change when the unit is displayed as available as long as Available is set to "Yes."
                  %th
                    Available
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridAvailablePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing Available to "No" will exclude this unit from appearing as available in the app, regardless of the date that is set.
                  - if PROPERTIES_LIST.include?(@community.id)
                    %th
                      Tour Order

                  %th
                    Lock Provider
                    
                  %th
                    Sold
                    %i.unit_sold.fa.fa-question-circle{ "data-toggle" => "unitGridSoldPopover","data-content" => " "}
                      %span#unit_sold_text
                        This option is for For Sale properties only. When a Sold is set to Yes, then the details on the unit pop-up will show that the unit is sold.
                  %th
                    Floor
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the Floor will change the floor that each unit appears on in the interactive map. Units will not appear on the interactive map unless a floor has been selected.

                  %th
                    Building
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridBuildingPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the Building will change the building that each unit appears on in the interactive map. Units will not appear on the interactive map unless a building has been selected.

                  %th
                    Interior Images
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridInteriorImagesPopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Add or change images (such as interior photography or renderings) associated with each unit.

                  %th Floor Plan Image
                  %th
                    Actions
                    %i.additionalPageAction.fa.fa-question-circle{ "data-toggle" => "unitGridActionPopover","data-content" => " "}
                      %span#additionalPageActionText
                        Click the edit icon to view or change the details associated with each such as building number, images, and details.
              %tbody

                - @community_info.units.map{|i| i.marketing_name = '' if i.marketing_name.nil? }
                - units = @community_info.units.map {|i| i.marketing_name.gsub(/\d+/) {|s| "%08d" % s.to_i } }.zip(@community_info.units).sort.map{|x,y| y}
                - units.each_with_index  do |u,index|
                  - floorplan = @community_info.floorplans.select{|f| f.provider_floorplan_id == u.floorplan_id}.first
                  %tr{style: "color: #{u.manual_override ? '#dd4a39' : ''};"}
                    %td= index+1
                    %td= best_in_place u, :manual_override, :as => :checkbox, collection: {false: "No", true: "Yes"}, :url => community_unit_path(@community,u), :data => {:manual_override => u.manual_override }
                    
                    - if @community.data_provider == "yardi"
                      %td= best_in_place u, :marketing_name, :url => community_unit_path(@community,u),:display_as => :provider_unit_id, :data => {:number => u.marketing_name },:style => u.name_is_updated? ? "color: #dd4a39;" : ""
                    - else
                      %td= best_in_place u, :marketing_name, :url => community_unit_path(@community,u),:display_as => :unit_market, :data => {:number => u.marketing_name },:style => u.name_is_updated? ? "color: #dd4a39;" : ""
                    
                    %td= best_in_place u, :floorplan_id, :as => :select, :collection => @community_info.floorplans.collect{|f| [f.provider_floorplan_id,f.name]}, :url => community_unit_path(@community,u), :data => {:floorplan_id => floorplan.present? ? floorplan.id : nil },:style => u.floorplan_id_is_updated? ? "color: #dd4a39;" : ""
                    %td= best_in_place u, :effective_rent, :as => :input, :url => community_unit_path(@community,u),:display_as => :show_integer_rent, :data => {:rent => u.effective_rent },:style => u.effective_rent_is_updated? ? "color: #dd4a39;" : ""
                    %td= best_in_place u, :available_date,:as => :date, :url => community_unit_path(@community,u), :place_holder => (u.sold  ? "Never Available" : "-"), :data => {:available_date => u.available_date },:style => u.available_date_is_updated? ? "color: #dd4a39;" : ""
                    %td= best_in_place u, :available, :as => :checkbox, collection: {false: "No", true: "Yes"}, :url => community_unit_path(@community,u), :data => {:available => u.available },:style => u.available_is_updated? ? "color: #dd4a39;" : ""
                    
                    - if PROPERTIES_LIST.include?(@community.id)
                      %td= best_in_place u, :tour_visiting_order_number, :as => :input, :url => community_unit_path(@community,u), :data => {:tour_visiting_order_number => u.tour_visiting_order_number}
                    
                    %td.locks-field-width
                      = render :partial=>'attached_lock',:locals=>{:u=>u, :community=>@community}
                       
                    %td= best_in_place u, :sold, :as => :checkbox, collection: {false: "No", true: "Yes"}, :url => community_unit_path(@community,u), :data => {:sold => u.sold },:style => u.sold_is_updated? ? "color: #dd4a39;" : ""
                    
                    %td= best_in_place u, :floor, :url => community_unit_path(@community,u), :data => {:floor => u.floor },:style => u.floor_is_updated? ? "color: #dd4a39;" : ""
                    %td= best_in_place u, :building, :url => community_unit_path(@community,u), :data => {:building => u.building },:style => u.building_is_updated? ? "color: #dd4a39;" : ""
                    
                    %td
                      = link_to 'Manage Images' , community_unit_amenities_path(@community,u),:class=>"btn btn-default black-button"
                    %td
                      .drop-img
                        = image_tag u.standard_image_url.present? ? u.standard_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.standard_image_url : "/assets/default.jpeg")
                    %td
                      %a.text-success{:href => "#{edit_community_unit_path(@community,u)}"}
                        %i.fa.fa-edit.icon_size
                      
                      %a.text-danger{"data-name"=>"Unit","data-href" => "#{community_unit_path(@community,u)}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
                        %i.fa.fa-trash.icon_size
                      - if u.x_plot > 0 && u.y_plot > 0
                        %i.additionalPageAction.fa.fa-map-marker.icon_size{"data-toggle" => "unitGridActionPopover","data-content" => " ", :style => "margin-left: 5px;"}
                          %span#additionalPageActionText
                            If it is marker icon, that means the unit has already been plotted on the map.
                      - else
                        = link_to "", id: "display_unit", data: { unit_id: u.id }, class: "unit_toggle text-warning ml-5" do
                          %i.additionalPageAction.fa.icon_size{class: u.visible ? "fa-eye" : "fa-eye-slash", "data-toggle" => "unitGridActionPopover","data-content" => " "}
                            %span#additionalPageActionText
                              Click the eye icon to hide the unit from the units to be plotted on the map. If it is marker icon, that means the unit has already been plotted on the map.
                      

.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "unit_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
