        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
        $('#best_in_place_unit_'+id[4]+'_floorplan_id').css("color","#dd4a39");
      });

      $('#best_in_place_unit_'+id[4]+'_marketing_name').change(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
        $('#best_in_place_unit_'+id[4]+'_marketing_name').css("color","#dd4a39");
      });

      $('#best_in_place_unit_'+id[4]+'_effective_rent').change(function(){
        $('#best_in_place_unit_'+id[4]+'_manually_updated').html('Yes');
        $('#best_in_place_unit_'+id[4]+'_effective_rent').css("color","#dd4a39");
