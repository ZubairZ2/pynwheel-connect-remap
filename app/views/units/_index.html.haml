.row
  / Start Panel left Side
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title Units
      .col-md-6
        .mt-35
          %a.btn.btn-success.pull-right.mb-20{:href => "/communities/#{@community.id}/units/new"}
            %i.fa.fa-plus-circle
            ADD UNIT
          .dropdown.pull-right.mb-20.mr-5
            %button.dropbtn.btn.btn-primary.pull-right.mb-20.mr-5 Mass Overrides
            .dropdown-content.mass_override_dropdown
              %a{:href => "##",'data-target' =>'#modal-to-set-available', 'data-toggle' => 'modal'} Available
              %a{:href => "##","data-target" =>"#modal-to-set-available-date", "data-toggle" => "modal"} Available Date
              %a{:href => "##","data-target" =>"#modal-to-set-manual-override", "data-toggle" => "modal"} Manual Override 
              %a{:href => "##","data-target" => "#modal-to-set-sold", "data-toggle" => "modal"} Sold
              - unless @community.is_sitemap
                %a{:href => '##',"data-target" => "#modal-to-change-floor", "data-toggle" => "modal"} Units Floor
              %a{:href => "##","data-target" => "#modal-to-add-description", "data-toggle" => "modal"} Add Description
              %a{:href => "##","data-target" => "#modal-to-set-image", "data-toggle" => "modal"} Upload Image

          / - unless @community.is_sitemap  
          /   %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-change-floor", "data-toggle" => "modal"}
          /     %i.fa.fa-adjust
          /     Set UNITS FLOOR
          / %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-set-available-date", "data-toggle" => "modal"}
          /   %i.fa.fa-adjust
          /   Set Available Date       
          / %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-set-available", "data-toggle" => "modal"}
          /   %i.fa.fa-adjust
          /   Set Available       
          / %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-set-manual-override", "data-toggle" => "modal"}
          /   %i.fa.fa-adjust
          /   Set Manual Override       
          / %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-set-sold", "data-toggle" => "modal"}
          /   %i.fa.fa-adjust
          /   Set Sold       
          / %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-set-image", "data-toggle" => "modal"}
          /   %i.fa.fa-adjust
          /   Upload Image       
    .box.box-widget.panel-box
      .box-header     
        .row
          .col-md-12
            %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units
              %thead
                %tr
                  %th{:width => "79"} Sr #
                  %th Marketing Name
                  %th Floor Plan
                  %th Rent
                  %th Manually Updated
                  %th Available
                  %th Manual Override
                  %th Sold
                  %th Unit Space
                  - unless @community.is_sitemap
                    %th Floor
                  %th Available Date
                  %th Description
                  %th Image
                  %th Amenities
                  %th Actions
              %tbody
                - units = @community_info.units.sort_by { |u| u.marketing_name }
                - units.each_with_index  do |u,index|
                  - floorplan = @community_info.floorplans.select{|f| f.provider_floorplan_id == u.floorplan_id}.first
                  %tr{style: "background-color: #{u.manual_override ? '#cecece' : ''}"}
                    %td= index+1
                    %td= best_in_place u, :marketing_name,:url => community_unit_path(@community,u), :data => {:number => u.marketing_name }
                    %td= best_in_place u, :floorplan_id, :as => :select, :collection => @community_info.floorplans.collect{|f| [f.provider_floorplan_id,f.name]}, :url => community_unit_path(@community,u), :data => {:floorplan_id => floorplan.present? ? floorplan.id : nil }
                    %td= best_in_place u, :effective_rent, :as => :input, :url => community_unit_path(@community,u), :data => {:rent => u.effective_rent }
                    %td{:id=>"best_in_place_unit_#{u.id}_manually_updated"}= u.manually_updated ? "Yes" : "No"
                    %td= best_in_place u, :available, :as => :checkbox, collection: {false: "No", true: "Yes"}, :url => community_unit_path(@community,u), :data => {:available => u.available }
                    %td= best_in_place u, :manual_override, :as => :checkbox, collection: {false: "No", true: "Yes"}, :url => community_unit_path(@community,u), :data => {:manual_override => u.manual_override }
                    %td= best_in_place u, :sold, :as => :checkbox, collection: {false: "No", true: "Yes"}, :url => community_unit_path(@community,u), :data => {:sold => u.sold }
                    %td= best_in_place u, :square_feet, :as => :input, :url => community_unit_path(@community,u), :data => {:square_feet => u.square_feet }
                    - unless @community.is_sitemap
                      %td= best_in_place u, :floor, :url => community_unit_path(@community,u), :data => {:floor => u.floor }
                    %td= best_in_place u, :available_date,:as => :date, :url => community_unit_path(@community,u), :place_holder => (u.sold  ? "Never Available" : "-"), :data => {:available_date => u.available_date }
                    %td= raw(u.description)
                    %td
                      .drop-img
                        = image_tag u.standard_image_url.present? ? u.standard_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.standard_image_url : "/assets/default.jpeg")
                    %td
                      = link_to 'Amenities' , plot_amenities_community_unit_amenities_path(@community,u),:class=>"btn-info btn-xs.mr-5"
                    %td
                      %a.text-success{:href => "#{edit_community_unit_path(@community,u)}"}
                        %i.fa.fa-edit
                      %a.text-danger{"data-name"=>"Unit","data-href" => "#{community_unit_path(@community,u)}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
                        %i.fa.fa-trash

#modal-to-change-floor.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Set Floor
      = form_tag set_floor_community_units_path(@community) do  
        .modal-body.set-floor-modal-body
          = text_field_tag :floor, nil,:class=>"form-control mb-20 validate[required]",:placeholder=>"Enter Floor"
          .row
            .col-md-4
              = check_box_tag 'select_all_units_for_floor'
              %label Select all
          .row
            - units.each do |unit|
              .col-md-2.pt-5.pb-5
                = check_box_tag 'unit_ids[]', unit.id,false,class: 'floor-checkbox'
                = h unit.marketing_name  
        .modal-footer
          = submit_tag 'Submit',:class=>"btn btn-success"
          %button.btn.btn-primary{"data-dismiss" => "modal", :type => "button"} Cancel
#modal-to-set-available-date.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
