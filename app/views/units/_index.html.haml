  :javascript
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.unit_toggle').forEach(function(link) {
          link.addEventListener('click', function(event) {
            event.preventDefault();
            var unit_id = this.dataset.unitId;

            $.ajax({
                url: "/communities/#{@community.id}/units/" + unit_id + "/display_unit",
                type: "PUT",
              }).done(function (data) {
                if (data.visible) {
                  link.querySelector('.fa').classList.remove('fa-eye-slash');
                  link.querySelector('.fa').classList.add('fa-eye');
                  $(".strike_" + unit_id).css("text-decoration", "");
                } else {
                  link.querySelector('.fa').classList.remove('fa-eye');
                  link.querySelector('.fa').classList.add('fa-eye-slash');
                  $(".strike_" + unit_id).css("text-decoration", "line-through");
                }
            });
          });
        });
      });

    function unit_goBack() {
      window.location.reload();
    }


    $(document).ready(function(){

      var $chkboxes = $('.mass-override');
      var lastChecked = null;

      $chkboxes.click(function(e) {
          if (!lastChecked) {
              lastChecked = this;
              return;
          }

          if (e.shiftKey) {
              var start = $chkboxes.index(this);
              var end = $chkboxes.index(lastChecked);

              $chkboxes.slice(Math.min(start,end), Math.max(start,end)+ 1).prop('checked', lastChecked.checked);
          }

          lastChecked = this;
      });

      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
      });
    })

    if (#{@community.is_sitemap}){
      $('#miyazaki.unit_data_table').DataTable({
          'aoColumnDefs': [{
              'bSortable': false,
              'aTargets': [9,11],
          }],
          "ordering": true,
          "stateSave": true,
          "paging": false
      });
    }
    else {
      $('#miyazaki.unit_data_table').DataTable({
          'aoColumnDefs': [{
              'bSortable': false,
              'aTargets': [12,13],
          }],
          "ordering": true,
          "stateSave": true,
          "paging": false
      });
    }
    $('#select_all_units_for_manual_override').change(function(){
      if($(this).is(':checked')){
        $('.manual-override-checkbox').prop('checked',true)
      }
      else{
        $('.manual-override-checkbox').prop('checked',false)
      }
    });
    $('#select_all_units_for_description').change(function(){
      if($(this).is(':checked')){
        $('.description-checkbox').prop('checked',true)
      }
      else{
        $('.description-checkbox').prop('checked',false)
      }
    });
    $('#select_all_units_for_sold').change(function(){
      if($(this).is(':checked')){
        $('.sold-checkbox').prop('checked',true)
      }
      else{
        $('.sold-checkbox').prop('checked',false)
      }
    });

    $('#select_all_units_for_available').change(function(){
      if($(this).is(':checked')){
        $('.available-checkbox').prop('checked',true)
      }
      else{
        $('.available-checkbox').prop('checked',false)
      }
    });

    $('#select_all_units_for_available_date').change(function(){
      if($(this).is(':checked')){
        $('.available-date-checkbox').prop('checked',true)
      }
      else{
        $('.available-date-checkbox').prop('checked',false)
      }
    });

