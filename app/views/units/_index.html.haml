      }

      if($('#best_in_place_unit_'+id[4]+'_manual_override').html() == 'No'){
        $(this).parent().parent().css('color','#00000');
      }

      $('#flash-message').html('<div class="alert alert-success">'+field+' updated successfully.</div>');

