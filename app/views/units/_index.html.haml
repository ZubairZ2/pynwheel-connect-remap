.row
  / Start Panel left Side
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title Units
      .col-md-6
        .mt-35
          %a.btn.btn-success.pull-right.mb-20{:href => "/communities/#{@community.id}/units/new"}
            %i.fa.fa-plus-circle
            ADD UNIT
          - unless @community.is_sitemap  
            %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-change-floor", "data-toggle" => "modal"}
              %i.fa.fa-adjust
              SET UNITS FLOOR
          %button.btn.btn-primary.pull-right.mb-20.mr-5{"data-target" => "#modal-to-set-available-date", "data-toggle" => "modal"}
            %i.fa.fa-adjust
            SET Available Date       
    .box.box-widget.panel-box
      .box-header     
        .row
          .col-md-12
            %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units
              %thead
                %tr
                  %th{:width => "79"} Sr #
                  %th Marketing Name
                  %th Floor Plan
                  %th Rent
                  / %th Availability
                  - unless @community.is_sitemap
                    %th Floor
                  %th Available Date
                  %th Image
                  %th Actions
              %tbody
                - units = @community_info.units.sort_by { |u| u.id }
                - units.each_with_index  do |u,index|
                  - floorplan = @community_info.floorplans.select{|f| f.provider_floorplan_id == u.floorplan_id}.first
                  %tr
                    %td= index+1
                    %td= best_in_place u, :marketing_name,:url => community_unit_path(@community,u), :data => {:number => u.marketing_name }
                    %td= best_in_place u, :floorplan_id, :as => :select, :collection => @community_info.floorplans.collect{|f| [f.provider_floorplan_id,f.name]}, :url => community_unit_path(@community,u), :data => {:floorplan_id => floorplan.present? ? floorplan.id : nil }
                    %td= best_in_place u, :effective_rent, :as => :input, :url => community_unit_path(@community,u), :data => {:rent => u.effective_rent }
                    / %td= best_in_place u, :availability, :as => :select, :collection => [['Occupied', 'Occupied'], ['Unoccupied', 'Unoccupied']], :url => community_unit_path(@community,u), :data => {:availability => u.availability }
                    - unless @community.is_sitemap
                      %td= best_in_place u, :floor, :url => community_unit_path(@community,u), :data => {:floor => u.floor }
                    %td= best_in_place u, :available_date,:as => :date, :url => community_unit_path(@community,u), :data => {:available_date => u.available_date }
                    %td
                      .drop-img
                        = image_tag u.standard_image_url.present? ? u.standard_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.standard_image_url : "/assets/default.jpeg")
                    %td
                      %a.text-success{:href => "#{edit_community_unit_path(@community,u)}"}
                        %i.fa.fa-edit
                      %a.text-danger{"data-name"=>"Unit","data-href" => "#{community_unit_path(@community,u)}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
                        %i.fa.fa-trash

#modal-to-change-floor.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Set Floor
      = form_tag set_floor_community_units_path(@community) do  
        .modal-body.set-floor-modal-body
          = text_field_tag :floor, nil,:class=>"form-control mb-20 validate[required]",:placeholder=>"Enter Floor"
          .row
            - units.each do |unit|
              .col-md-2.pt-5.pb-5
                = check_box_tag 'unit_ids[]', unit.id
                = h unit.marketing_name  
        .modal-footer
          = submit_tag 'Submit',:class=>"btn btn-success"
          %button.btn.btn-primary{"data-dismiss" => "modal", :type => "button"} Cancel
#modal-to-set-available-date.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Set Available Date
      = form_tag set_available_date_community_units_path(@community) do  
        .modal-body.set-floor-modal-body
          = text_field_tag :available_date, nil,:class=>"form-control mb-20 datepicker",:placeholder=>"Enter Available Date",:readonly=>true
          .row
            - units.each do |unit|
              .col-md-2.pt-5.pb-5
                = check_box_tag 'unit_ids[]', unit.id
                = h unit.marketing_name  
        .modal-footer
          = submit_tag 'Submit',:class=>"btn btn-success"
          %button.btn.btn-primary{"data-dismiss" => "modal", :type => "button"} Cancel                                   

        
  / End Panel left Side
  :javascript
    $(".datepicker").datepicker({dateFormat: 'yy-mm-dd' }); 
    $.datepicker.setDefaults({dateFormat: 'yy-mm-dd' }); 
    $('.best_in_place').bind("ajax:success", function () {
      var field = ""
      switch($(this).data('bipAttribute')) {
        case 'effective_rent':
            field = "Rent"
            break;
        case 'floorplan_id':
            field = "Floor Plan"
            break;
        case 'marketing_name':
            field = 'Marketing Name'
            break;
        case 'availability':
            field = "Availability"
            break
        case 'available_date':
            field = "Available Date"
            break        
      } 
      $('#flash-message').html('<div class="alert alert-success">'+field+' updated successfully.</div>'); 
    });

    
    $('.best_in_place').on('best_in_place:error', function (event, request, error) {
      $.each($.parseJSON(request.responseText), function (index, value) {
            if (typeof value === "object") 
            {
              value = index + " " + value.toString(); 
            }
            $('#flash-message').html('<div class="alert alert-danger">'+value+'</div>');
       });            
    });
    

