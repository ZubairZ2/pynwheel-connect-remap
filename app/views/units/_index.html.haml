.row
  / Start Panel left Side
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title UNITS FOR #{@community.name}
      .col-md-6
        .mt-35
          %a.btn.btn-success.pull-right.mb-20{:href => "/communities/#{@community.id}/units/new"}
            %i.fa.fa-plus-circle
            ADD UNIT
    .box.box-widget.panel-box
      .box-header     
        .row
          .col-md-12
            %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
              %thead
                %tr
                  %th{:width => "79"} Sr #
                  %th Marketing Name
                  %th Floor Plan
                  %th Rent
                  %th Availability
                  %th Actions
              %tbody
                - @units.each_with_index  do |u,index|
                  %tr
                    %td= index+1
                    %td= best_in_place u, :marketing_name,:url => community_unit_path(@community,u), :data => {:number => u.marketing_name }
                    %td= best_in_place u, :floorplan_id, :as => :select, :collection => @community.floorplans.collect{|f| [f.provider_floorplan_id,f.name]}, :url => community_unit_path(@community,u), :data => {:floorplan_id => u.floorplan ? u.floorplan.name : nil }
                    %td= best_in_place u, :effective_rent, :as => :input, :url => community_unit_path(@community,u), :data => {:rent => u.effective_rent }
                    %td= best_in_place u, :availability, :type => :select, :collection => [['Occupied', 'Occupied'], ['Unoccupied', 'Unoccupied']], :url => community_unit_path(@community,u), :data => {:availability => u.availability }
                    %td
                      -#%a.text-success{:href => "#{edit_community_unit_path(@community,u)}"}
                      -#  %i.fa.fa-edit
                      %a.text-danger{:href => "#{community_unit_path(@community,u)}","data-method"=>:delete,"data-confirm"=>"Are you sure?"}
                        %i.fa.fa-trash

        
  / End Panel left Side
