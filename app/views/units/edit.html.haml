- content_for :title, "Edit Unit - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        .col-lg-12
          %h3.box-title
            Unit Details
            %span
        .col-md-12
          = link_to "<Back to All Units", community_units_path(@community), class: "btn btn-primary mt-10", style: "background: #8f4a9c; color: white;"
          -# - if (current_community.self_tour)
            -# = link_to "Manage Unit Tour", community_unit_amenities_path(@community,@unit), class: "btn btn-primary mt-10", style: "background: #8f4a9c; color: white;"
      / /.box-header
      / form start
      = form_for @unit,:url=> params[:floorNo].nil? ? community_unit_path(:id=>@unit.id,:community_id=>@community.id) : community_unit_path(:id=>@unit.id,:community_id=>@community.id) <<  '?floorNo=' + params[:floorNo] ,:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "Save Changes", :class=>"btn btn-success pull-right loader_class"
#crop-unit-secondary-image.modal.fade.edit-image
#crop-unit-image.modal.fade.edit-image
- if @community.self_tour    
  %section
    .content
      .box.box-info.add-plan.mt-20#logo_header
        .box-header
          %h3.box-title
            Unit Tour Setup
      .row
        .col-lg-12.col-md-12
          .row
            .col-md-12
              %h4.title
                = @unit.marketing_name + " Unit Images"
              %h4{:style => "color: grey;"}
                %p
                  Use the “Add Image” button or drag & drop area below to import images associated with the unit.
                %p
                  Once images have been added, a button will appear to allow you to plot them on the unit.
              = link_to "PLOT IMAGES ON UNIT", plot_amenities_community_unit_amenities_path(@community,@unit), class: "btn btn-primary mb-20", id: "amenity_image"
            .col-md-6
              .mt-35
                %span.btn.btn-success.btn-file
                  %i.fa.fa-plus-circle
                  Add image to this unit
                  %input#unit-amenity-images{:multiple => "multiple", :type => "file"}
                %button.dropbtn.btn.btn-primary{"data-target" => "#modal-to-set-image", "data-toggle" => "modal"} Add images to multiple units
              .divLoading.hidden
          #images-index-unit
            = render :partial=>'edit'

  #edit-image.modal.fade.edit-image
  
  #modal-to-set-image.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
    .modal-dialog
      .modal-content
        .modal-header
          %b Upload Interior Image for Multiple Units
        = form_tag '/', :id=>"amenities-for-multiple-units", multipart: true do
          .modal-body.set-floor-modal-body
            %input#units-amenities-images{:multiple => "multiple", :type => "file", :required=>"required"}
            .row
              .col-md-4
                = check_box_tag 'select_all_units_for_image'
                %label Select all
            .row
              - if @units.present?
                - @units.each do |unit|
                  .col-md-3.pt-5.pb-5
                    = check_box_tag 'unit_ids[]', unit.id,false,class: 'image-checkbox mass-override'
                    = h unit.marketing_name
          .modal-footer
            = submit_tag 'Submit',:class=>"btn btn-success"
            %button.btn.btn-primary{"data-dismiss" => "modal", :type => "button"} Cancel

:javascript

  $("#unit_secondary_image").change(function(){
      readSecondaryURL(this);   
  });

  var unit_id = #{ @unit.id }
  var unit_name = '#{ @unit.name }'
  var building_name = '#{ @unit.building.present? ? @unit.building : '' }'
  var community_id = #{ @community.id }
  var form_id = "#edit_unit_" + #{ @unit.id }
  var lock_name_should_be

  if (building_name.length > 0){
    lock_name_should_be = building_name + '-' + unit_name}
  else{
    lock_name_should_be = unit_name}

  var assigned_lock_name = '#{ @assigned_lock.present? ? @assigned_lock.name : '' }'
  var assigned_lock_type = '#{ @assigned_lock.present? ? @assigned_lock.remote_lock_type : '' }'

  var IsSelectedDweloLockMatch = function (){
    if($('#dwelo_remote_lock :selected').text() != "Select your option"){
      var index = $('#dwelo_remote_lock :selected').text().lastIndexOf(" ");
      var lock_name = $('#dwelo_remote_lock :selected').text();

      var name_should_be

      if($('#unit_building').val().length > 0){
        name_should_be = $('#unit_building').val() + '-' + $('#unit_marketing_name').val()
      }
      else{
        name_should_be = $('#unit_marketing_name').val()
      }

      if(lock_name != name_should_be){
        dwelo_device_id = $("#dwelo_remote_lock").val();
        var dwelo = #{ @community.dwelo.present? ? @community.dwelo.id : "undefined"};
        unit_lock_device_id = "#{@unit.remote_locks.present? ? @unit.remote_locks.first.device_id : "undefined"}";

        if (dwelo_device_id != unit_lock_device_id){
          $('#dwelo_remote_lock').addClass('lock_mismatch')
          $("#dwelo_lock_update_btn").removeClass('hidden')

          var id = $('#dwelo_remote_lock :selected').val()
          var href = '/communities/' + community_id + '/remote_locks/' + id + '/edit?stop_id=' + unit_id + '&stop_name=' + unit_name + '&stop_type=unit'

          $("#a-dwelo-lock").attr("href",href);
        }
      }
      else{
        $('#dwelo_remote_lock').removeClass('lock_mismatch')
        $("#dwelo_lock_update_btn").addClass('hidden')
        var id = $('#dwelo_remote_lock :selected').val()
        $.ajax({
          type: 'Put',
          url: "/communities/#{@community.id}/units/#{@unit.id}",
          data: { lock_id: id, assigning_lock: "true"},
          cache: false,
          success: function () {}
        })
      }
    }
    else{
      $('#dwelo_remote_lock').removeClass('lock_mismatch')
      $("#dwelo_lock_update_btn").addClass('hidden')
      $("#a-dwelo-lock").attr("href","#");
    }
  }
  
  var IsSelectedLockMatch = function(){
    if($('#remote_lock :selected').text() != "Select your option"){
      var index = $('#remote_lock :selected').text().lastIndexOf(" ");
      var lock_name = $('#remote_lock :selected').text().substring(0, index);

      var name_should_be
      if($('#unit_building').val().length > 0){
        name_should_be = $('#unit_building').val() + '-' + $('#unit_marketing_name').val()
      }
      else{
        name_should_be = $('#unit_marketing_name').val()
      }

      if(lock_name != name_should_be){
        $('#remote_lock').addClass('lock_mismatch')
        $("#update-btn").removeClass('hidden')

        var id = $('#remote_lock :selected').val()
        var href = '/communities/' + community_id + '/remote_locks/' + id + '/edit?stop_id=' + unit_id + '&stop_name=' + unit_name + '&stop_type=unit'

        $("#a-lock").attr("href",href);
      }
      else{
        $('#remote_lock').removeClass('lock_mismatch')
        $("#update-btn").addClass('hidden')
        $("#a-lock").attr("href","#");
      }
    }
    else{
        $('#remote_lock').removeClass('lock_mismatch')
        $("#update-btn").addClass('hidden')
        $("#a-lock").attr("href","#");
    }
  }
  function clear_assigned_lock(){
    $.ajax({
      type: 'POST',
      url: '/communities/'+ community_id + '/units/' + unit_id +'/clear_locks',
      dataType: 'json',
      cache: false,
      success: function(data){
        console.log(data)
      },
      fail: function(error){
        console.log(error)
      }
    })
  }

  function get_dwelo_locks(){
    var assigned_lock_present = false
    var params = {"unit_name": unit_name}
    var dwelo = #{ @community.dwelo.present? ? @community.dwelo.id : "undefined"};
    if (dwelo != undefined){
      $.ajax({
        type: 'GET',
        url: '/communities/' + community_id + '/dwelos',
        dataType: 'json',
        data: { params, community_id },
        cache: false,
        success: function(data){
          locks = data
          for (var item in locks) {
            if (assigned_lock_name == locks[item].name && assigned_lock_type == locks[item].remote_lock_type && locks[item].dwelo_id == dwelo){
              $('#dwelo_remote_lock').prepend(`<option value="${locks[item].device_id}" , selected="selected">${locks[item].name}</option>`)
              assigned_lock_present = true
            }
            else if (locks[item].dwelo_id == dwelo && locks[item].stop_id == null)
            {
              $('#dwelo_remote_lock').append(`<option value="${locks[item].device_id}">${locks[item].name}</option>`)
            }
          }
          if(assigned_lock_present == false){
              $('#dwelo_remote_lock').prepend(`<option value="" , selected="selected">Select your option</option>`)
              // clear_assigned_lock()
          }
          else
            IsSelectedDweloLockMatch()
        },
        fail: function(error){
          console.log(error)
        }
      });
    }
  }

  function get_edgestate_locks(){
    var assigned_lock_present = false
    var params = {"unit_name": unit_name}
    $.ajax({
      type: 'POST',
      url: '/communities/'+ community_id + '/units/' + unit_id +'/load_remotelock_data',
      dataType: 'json',
      data: params,
      cache: false,
      success: function(data){
        locks = data['locks']
        for (var item in locks) {
          if (assigned_lock_name == locks[item].name && assigned_lock_type == locks[item].remote_lock_type){
            $('#remote_lock').prepend(`<option value="${locks[item].device_id}" , selected="selected">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
            assigned_lock_present = true
          }
          else{
            $('#remote_lock').append(`<option value="${locks[item].device_id}">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
          }
        }
        if(assigned_lock_present == false){
            $('#remote_lock').prepend(`<option value="" , selected="selected">Select your option</option>`)
            // clear_assigned_lock()
        }
        else
          IsSelectedLockMatch()
      },
      fail: function(error){
        console.log(error)
      }
    });
  }

  $(document).ready(function(){
    var params = {"unit_name": unit_name}
    var locks_provider = "#{ @community.locks_provider.present? ? @community.locks_provider : nil}";
    
    if (locks_provider == "EdgeState"){
      get_edgestate_locks()
    }
    else if (locks_provider == "Dwelo") {
      get_dwelo_locks()
    }
  });



  $("#remote_lock").change(function () {
    IsSelectedLockMatch()
  });

  $('#unit_building').keyup(function() {
    IsSelectedLockMatch()
  });

  $('#unit_marketing_name').keyup(function() {
    IsSelectedLockMatch()
  });
    $("#dwelo_remote_lock").change(function () {
    IsSelectedDweloLockMatch()
  });

  $('#unit_building').keyup(function() {
    IsSelectedDweloLockMatch()
  });

  $('#unit_marketing_name').keyup(function() {
    IsSelectedDweloLockMatch()
  });

  if(#{@unit.amenities.count} == 0){
    $('#amenity_image').hide();
  }

  if(#{@unit.amenities.count.to_i} > 0){
    $('#amenity_image').show();
  }

  $('#unit_marketing_name').keyup(function() {
    IsSelectedDweloLockMatch()
  });

  $(form_id).submit(function(){
    if($("#latch_lock_name").val() == '' && $("#latch_key_id").val() != '')
    {
      $("#latch_lock_name").prop('required',true);
      $('.divLoading').removeClass('divLoading')
    }
    else if($("#latch_lock_name").val() != '' && $("#latch_key_id").val() == '')
    {
      $("#latch_key_id").prop('required',true);
      $('.divLoading').removeClass('divLoading')
    }
  })

  $('#select_all_units_for_image').change(function(){
      if($(this).is(':checked')){
        $('.image-checkbox').prop('checked',true)
      }
      else{
        $('.image-checkbox').prop('checked',false)
      }
  });

  var $chkboxes = $('.mass-override');
  var lastChecked = null;

  $chkboxes.click(function(e) {
      if (!lastChecked) {
          lastChecked = this;
          return;
      }

      if (e.shiftKey) {
          var start = $chkboxes.index(this);
          var end = $chkboxes.index(lastChecked);

          $chkboxes.slice(Math.min(start,end), Math.max(start,end)+ 1).prop('checked', lastChecked.checked);
      }

      lastChecked = this;
  });