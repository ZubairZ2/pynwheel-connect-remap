- content_for :title, "Edit Unit - Pynwheel"
= render "form_theme"

:css
  .unit-form-page .u-tour-head { display: flex; align-items: flex-start; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
  .unit-form-page .u-tour-head .grow { flex: 1; min-width: 240px; }
  .unit-form-page .u-tour-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .unit-form-page .u-modal-units { max-height: 340px; overflow-y: auto; border: 1px solid #eef0f3; border-radius: 8px; padding: 10px 12px; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 6px 12px; }
  .unit-form-page .u-modal-units label { font-weight: 400; font-size: 13px; color: #374151; display: inline-flex; align-items: center; gap: 6px; margin: 0; }

%section
  .content
    .unit-form-page
      = link_to community_units_path(@community), class: "back" do
        %i.fa.fa-angle-left
        All units
      %h1= @unit.marketing_name.presence || "Unit ##{@unit.id}"
      %p.sub
        %b= @community.name
        - if @community.code.present?
          = "· #{@community.code}"
        - if @unit.provider_unit_id.present?
          = "· Provider ID #{@unit.provider_unit_id}"

      = form_for @unit, url: params[:floorNo].nil? ? community_unit_path(id: @unit.id, community_id: @community.id) : community_unit_path(id: @unit.id, community_id: @community.id) << ('?floorNo=' + params[:floorNo]), html: { class: "unit-form" } do |f|
        = render partial: "form", locals: { f: f }

        .u-actionbar
          %span.grow Changes to feed-managed fields need Manual Override switched on.
          = link_to "Cancel", community_units_path(@community), class: "btn btn-ghost"
          = f.submit "Save changes", class: "btn btn-success submit_button"

      #crop-unit-secondary-image.modal.fade.edit-image
      #crop-unit-image.modal.fade.edit-image

      - if @community.self_tour
        .u-section
          .u-section-head
            %h2 Unit tour images
            %p
              Import images associated with this unit, then plot them so they appear in the
              self-guided tour.
          .u-section-body
            .u-tour-head
              .grow
              .u-tour-actions
                %span.btn.btn-success.btn-file
                  %i.fa.fa-plus-circle
                  Add image to this unit
                  %input#unit-amenity-images{multiple: "multiple", type: "file"}
                %button.btn.btn-ghost{type: "button", "data-target" => "#modal-to-set-image", "data-toggle" => "modal"}
                  %i.fa.fa-clone
                  Add images to multiple units
                = link_to "Plot images on unit", plot_amenities_community_unit_amenities_path(@community, @unit), class: "btn btn-primary", id: "amenity_image"
            .divLoading.hidden
            #images-index-unit
              = render partial: "edit"

        #edit-image.modal.fade.edit-image

        #modal-to-set-image.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", role: "dialog", tabindex: "-1"}
          .modal-dialog
            .modal-content
              .modal-header
                %b Upload interior image for multiple units
              = form_tag '/', id: "amenities-for-multiple-units", multipart: true do
                .modal-body
                  %input#units-amenities-images{multiple: "multiple", type: "file", required: "required"}
                  .mt-15.mb-10
                    %label
                      = check_box_tag 'select_all_units_for_image'
                      Select all
                  .u-modal-units
                    - if @units.present?
                      - @units.each do |unit|
                        %label
                          = check_box_tag 'unit_ids[]', unit.id, false, class: 'image-checkbox mass-override'
                          = h unit.marketing_name
                .modal-footer
                  = submit_tag 'Submit', class: "btn btn-success"
                  %button.btn.btn-primary{"data-dismiss" => "modal", type: "button"} Cancel

:javascript
  $("#unit_secondary_image").change(function(){
      readSecondaryURL(this);
  });

  if (#{@unit.amenities.count} == 0) {
    $('#amenity_image').hide();
  } else {
    $('#amenity_image').show();
  }

  $('#select_all_units_for_image').change(function(){
      $('.image-checkbox').prop('checked', $(this).is(':checked'));
  });

  // shift-click selects a range of units in the multi-unit image modal
  var $chkboxes = $('.mass-override');
  var lastChecked = null;
  $chkboxes.click(function(e) {
      if (!lastChecked) { lastChecked = this; return; }
      if (e.shiftKey) {
          var start = $chkboxes.index(this);
          var end = $chkboxes.index(lastChecked);
          $chkboxes.slice(Math.min(start,end), Math.max(start,end) + 1).prop('checked', lastChecked.checked);
      }
      lastChecked = this;
  });

  var inputs = document.querySelectorAll('input[list]');
  for (var i = 0; i < inputs.length; i++) {
    inputs[i].addEventListener('change', function() {
      var optionFound = false, datalist = this.list;
      for (var j = 0; j < datalist.options.length; j++) {
          if (this.value == datalist.options[j].value) { optionFound = true; break; }
      }
      if (optionFound) {
        this.setCustomValidity('');
      } else {
        if ( $(locks_input).val() != "" )
            this.setCustomValidity('Lock does not exist');
      }
    });
  }
