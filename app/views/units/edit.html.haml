- content_for :title, "Edit Unit - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        .col-lg-12
          %h3.box-title
            Unit Details
            %span
        .col-md-12
          = link_to "<Back to All Units", community_units_path(@community), class: "btn btn-primary mt-10", style: "background: #8f4a9c; color: white;"
          - if (current_community.self_tour)
            = link_to "Manage Unit Tour", community_unit_amenities_path(@community,@unit), class: "btn btn-primary mt-10", style: "background: #8f4a9c; color: white;"
      / /.box-header
      / form start
      = form_for @unit,:url=>community_unit_path(:id=>@unit.id,:community_id=>@community.id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "Save Changes", :class=>"btn btn-success pull-right loader_class"

:javascript

  $("#unit_secondary_image").change(function(){
      readSecondaryURL(this);   
  });

  var unit_id = #{ @unit.id }
  var unit_name = '#{ @unit.name }'
  var building_name = '#{ @unit.building.present? ? @unit.building : '' }'
  var community_id = #{ @community.id }
  var lock_name_should_be

  if (building_name.length > 0){
    lock_name_should_be = building_name + '-' + unit_name
  }
  else{
    lock_name_should_be = unit_name
  }

  var assigned_lock_name = '#{ @assigned_lock.present? ? @assigned_lock.name : '' }'
  var assigned_lock_type = '#{ @assigned_lock.present? ? @assigned_lock.remote_lock_type : '' }'
  
  var IsSelectedLockMatch = function(){
    if($('#remote_lock :selected').text() != "Select your option"){
      var index = $('#remote_lock :selected').text().lastIndexOf(" ");
      var lock_name = $('#remote_lock :selected').text().substring(0, index);

      var name_should_be
      if($('#unit_building').val().length > 0){
        name_should_be = $('#unit_building').val() + '-' + $('#unit_marketing_name').val()
      }
      else{
        name_should_be = $('#unit_marketing_name').val()
      }

      if(lock_name != name_should_be){
        $('#remote_lock').addClass('lock_mismatch')
        $("#update-btn").removeClass('hidden')

        var id = $('#remote_lock :selected').val()
        var href = '/communities/' + community_id + '/remote_locks/' + id + '/edit?stop_id=' + unit_id + '&stop_name=' + unit_name + '&stop_type=unit'

        $("#a-lock").attr("href",href);
      }
      else{
        $('#remote_lock').removeClass('lock_mismatch')
        $("#update-btn").addClass('hidden')
        $("#a-lock").attr("href","#");
      }
    }
    else{
        $('#remote_lock').removeClass('lock_mismatch')
        $("#update-btn").addClass('hidden')
        $("#a-lock").attr("href","#");
    }
  }
  
  function clear_assigned_lock(){
    $.ajax({
      type: 'POST',
      url: '/communities/'+ community_id + '/units/' + unit_id +'/clear_locks',
      dataType: 'json',
      cache: false,
      success: function(data){
        console.log(data)
      },
      fail: function(error){
        console.log(error)
      }
    })
  }

  $(document).ready(function(){
      var assigned_lock_present = false
      
      var params = {"unit_name": unit_name}
      $.ajax({
        type: 'POST',
        url: '/communities/'+ community_id + '/units/' + unit_id +'/load_remotelock_data',
        dataType: 'json',
        data: params,
        cache: false,
        success: function(data){
          locks = data['locks']
          for (var item in locks) {
            if (assigned_lock_name == locks[item].name && assigned_lock_type == locks[item].remote_lock_type){
              $('#remote_lock').prepend(`<option value="${locks[item].device_id}" , selected="selected">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
              assigned_lock_present = true
            }
            else{
              $('#remote_lock').append(`<option value="${locks[item].device_id}">${locks[item].name} (${locks[item].remote_lock_type})</option>`)
            }
          }
          if(assigned_lock_present == false){
              $('#remote_lock').prepend(`<option value="" , selected="selected">Select your option</option>`)
              // clear_assigned_lock()
          }
          else
            IsSelectedLockMatch()
        },
        fail: function(error){
          console.log(error)
        }
      });


      $("#remote_lock").change(function () {
        IsSelectedLockMatch()
      });      

      $('#unit_building').keyup(function() {
        IsSelectedLockMatch()
      });

      $('#unit_marketing_name').keyup(function() {
        IsSelectedLockMatch()
      });
  });