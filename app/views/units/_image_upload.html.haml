-# One floor plan image slot. Both slots behave identically apart from which
-# attribute they write to, so they share this.
-#
-# The <a class="preview-image"><img id="preview-image"> pair is always rendered,
-# even with no image: the live file preview in custom.js sets the src on that id
-# and the href on its parent, so removing either when empty would break the
-# preview on exactly the case that needs it most - a fresh upload.
- image = f.object.send(attribute)
- cache_bust = rand(9_999_999_999_999_999)
- url = image.present? ? "#{image.url}?timestamp=#{cache_bust}" : nil
- too_small = (image.present? && image.width < 300 && image.height < 250 rescue false)

.u-image
  .u-image-head
    %h3= title
    %p= note
  .u-image-frame{class: ("empty" unless url)}
    %a.preview-image{href: url || asset_path("default.jpeg"), "data-toggle" => "lightbox", "data-title" => lightbox_title}
      = image_tag(url || "default.jpeg", id: preview_id, alt: title)
    - if too_small
      = image_tag "exclamation-mark.png", class: "waring_exal", style: "width: 22px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", href: "#"
  .u-image-actions
    %span.btn.btn-ghost.btn-file
      %i.fa.fa-upload
      = url ? "Replace" : "Upload"
      = f.file_field attribute
    - if crop_path.present? && image.content_type != "image/svg+xml"
      = link_to crop_path, remote: true, class: "btn btn-ghost" do
        %i.fa.fa-crop
        Crop
    - if url && @unit.persisted?
      %a.btn.btn-ghost.danger{href: "javascript:;", "data-name" => "Image", "data-href" => "/communities/#{@community.id}/units/#{@unit.id}/remove_pri_scnd_image?image=#{remove_key}", "data-target" => "#confirm-delete", "data-toggle" => "modal"}
        %i.fa.fa-trash
        Remove
