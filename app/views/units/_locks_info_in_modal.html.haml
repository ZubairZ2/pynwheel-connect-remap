.locks-section-in-modal
    - if community.enable_locks
        .form-group
            %label.col-sm-12.col-lg-4.col-md-3.col-xs-12.control-label
                Select Lock Providers
            .col-sm-12.col-lg-8.col-md-9.col-xs-12
                = select_tag :unit_lock_provider , options_for_select(community.lock_options(locks_present_hash)),{:name => "unit[lock_provider]" ,:class=>"form-control lock_provider_input"}

        .form-group.hide_it#manual_access_code
            %label.col-sm-12.col-lg-4.col-md-3.col-xs-12.control-label
                Access Code
            .col-sm-12.col-lg-8.col-md-9.col-xs-12
                = text_field_tag :unit_access_code, unit.access_code ,:name => "unit[access_code]" , :oninput => "this.value = this.value.replace(/[^0-9#*]/g, '')", :class=>"form-control", :placeholder=>"Access Code",:maxLength => "6"

        .form-group#lock_access_code
            %label.col-sm-12.col-lg-4.col-md-3.col-xs-12.control-label
                Select the lock
            .col-sm-12.col-lg-8.col-md-9.col-xs-12
                = hidden_field_tag "dwelo_lock_input_value", unit.remote_locks.dwelo_locks.present? ? unit.remote_locks.dwelo_locks.last.name + " (" + unit.remote_locks.dwelo_locks.last.remote_lock_type + ")" : ''
                = hidden_field_tag "edgestate_lock_input_value", unit.remote_locks.edgestate_locks.present? ? unit.remote_locks.edgestate_locks.last.name + " (" + unit.remote_locks.edgestate_locks.last.remote_lock_type + ")" : ''
                = hidden_field_tag "latch_lock_input_value", unit.latch_locks.present? ? unit.latch_locks.last.lock_name : ''
                = hidden_field_tag "zerv_lock_input_value", unit.zerv_locks.present? ? unit.zerv_locks.last.sub_location_name + " (" + unit.zerv_locks.last.sub_location_friendly_name + ")" : ''
                = text_field_tag :lock_input, '', :placeholder => "Search by lock name", :list => "locks_list", :autocomplete=> "off", :type => "text", :class => "form-control lock_provider_input"
                %datalist#locks_list
            = hidden_field_tag "lock_id", ""
