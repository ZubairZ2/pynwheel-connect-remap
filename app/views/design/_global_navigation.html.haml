= form_for @community,:method=>"PUT",:html=>{:id=>"global-navigation-form"},:remote=>true  do |f|
  = hidden_field_tag "global_navigation_tab", true
  = f.fields_for :design do |d|
    .row
      .col-md-12
        %p.title-box Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed dictum dolor sem, quis pharetra dui ultricies vel. Cras non pulvinar tellus, vel bibendum magna. Morbi tellus nulla, cursus non nisi sed, porttitor dignissim erat. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc facilisis commodo lectus. Vivamus vel tincidunt enim, non vulputate ipsum. Ut pellentesque consectetur arcu sit amet scelerisque. Fusce commodo leo eros, ut eleifend massa congue at.
    .row
      .col-lg-12
        %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
          Global Navigation Options
    = d.fields_for :expressionist do |e|
      .form-group
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display global navigation button color
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = e.check_box :display_global_navigation_button_bg_color, {class: "global-navigation-field",:checked=>e.object.display_global_navigation_button_bg_color.present? ? e.object.display_global_navigation_button_bg_color : true }
            %label.label-primary{:for => "community_design_attributes_expressionist_attributes_display_global_navigation_button_bg_color"}
            %span.pl-15 Yes
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Button font family
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :global_navigation_button_font_family , options_for_select(font_families,e.object.global_navigation_button_font_family),{},{class: "form-control global-navigation-field"}             
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Button font size
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :global_navigation_button_font_size , options_for_select(global_navigation_button_font_sizes,e.object.global_navigation_button_font_size),{},{class: "form-control global-navigation-field"}              
      .form-group
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display global navigation button icon
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = e.check_box :display_global_navigation_button_icon, {class: "global-navigation-field"}
            %label.label-primary{:for => "community_design_attributes_expressionist_attributes_display_global_navigation_button_icon"}
            %span.pl-15 Yes        
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button border color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = e.text_field :global_navigation_button_border_color , class: "form-control global-navigation-field",autocomplete: true,:value=>e.object.global_navigation_button_border_color.present? ? e.object.global_navigation_button_border_color : "#ffff"
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button font color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = d.text_field :global_navigation_font_color , class: "form-control global-navigation-field",autocomplete: true,:value=>d.object.global_navigation_font_color.present? ? d.object.global_navigation_font_color : "#ffff"
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation background color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = d.text_field :global_navigation_background_color , class: "form-control global-navigation-field",autocomplete: true ,:value=>d.object.global_navigation_background_color.present? ? d.object.global_navigation_background_color : "#565455"
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation buttons opacity 
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :global_navigation_buttons_opacity , options_for_select(opacity_options,d.object.global_navigation_buttons_opacity.present? ? d.object.global_navigation_buttons_opacity : "100%"),{},{class: "form-control global-navigation-field"}
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation background opacity 
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :global_nav_bg_opacity , options_for_select(opacity_options,d.object.global_nav_bg_opacity.present? ? d.object.global_nav_bg_opacity : "100%"),{},{class: "form-control global-navigation-field"}                      
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button height 
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :global_nav_buttons_height , options_for_select(navigation_button_height_options,d.object.global_nav_buttons_height),{},{class: "form-control global-navigation-field"}
      .row.button-width-field-on-global-navigation
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button width 
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :global_nav_buttons_width , options_for_select(navigation_button_width_options,d.object.global_nav_buttons_width),{},{class: "form-control global-navigation-field"}        
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = d.text_field :global_navigation_button_color , class: "form-control global-navigation-field",autocomplete: true,:value=>d.object.global_navigation_button_color.present? ? d.object.global_navigation_button_color : "#3B3B3B"
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Button shape 
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :button_shape , options_for_select(button_shape_options,d.object.button_shape),{},{class: "form-control global-navigation-field"}  
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button border
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :secondary_page_menu_border , options_for_select(border_options,d.object.secondary_page_menu_border.present? ? d.object.secondary_page_menu_border : 'All sides'),{},{class: "form-control global-navigation-field"}            
      .form-group
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display button on background color
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = e.check_box :display_button_on_bg_color, {class: "global-navigation-field"}
            %label.label-primary{:for => "community_design_attributes_expressionist_attributes_display_button_on_bg_color"}
            %span.pl-15 Yes
      .row.button-on-background-color-field.hidden
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Button on background color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = e.text_field :button_on_bg_color , class: "form-control global-navigation-field",autocomplete: true ,:value=>e.object.button_on_bg_color.present? ? e.object.button_on_bg_color : "#565455"      
      .row.button-on-background-color-field.hidden
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Button on background color opacity
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :button_on_bg_color_opacity , options_for_select(opacity_options,e.object.button_on_bg_color_opacity.present? ? e.object.button_on_bg_color_opacity : "100%"),{},{class: "form-control global-navigation-field"}            
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Global navigation button on font color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = e.text_field :global_navigation_button_on_font_color , class: "form-control global-navigation-field",autocomplete: true ,:value=>e.object.global_navigation_button_on_font_color.present? ? e.object.global_navigation_button_on_font_color : "#565455"      
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Application background color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = e.text_field :application_background_color , class: "form-control global-navigation-field",autocomplete: true ,:value=>e.object.application_background_color.present? ? e.object.application_background_color : "#ffff"      
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Application background color opacity
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :application_background_color_opacity , options_for_select(opacity_options,e.object.application_background_color_opacity.present? ? e.object.application_background_color_opacity : "100%"),{},{class: "form-control global-navigation-field"}                        
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Spacing between buttons
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :spacing_between_buttons , options_for_select(spacing_options,e.object.spacing_between_buttons.present? ? e.object.spacing_between_buttons : '0px'),{},{class: "form-control global-navigation-field"}                        
      .row
        .col-md-12
          %ul.nav.nav-tabs
            %li.active
              %a{"data-toggle" => "tab", :href => "#global-navigation-button-on"} Global navigation button on
            %li
              %a{"data-toggle" => "tab", :href => "#global-navigation-button-off"} Global navigation button off
            %li
              %a{"data-toggle" => "tab", :href => "#application-background-image"} Application background image
          .tab-content
            #global-navigation-button-on.tab-pane.fade.in.active
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Upload global navigation button on image
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = d.check_box :global_nav_button_on_as_image, {class: "global-navigation-field"}
                    %label.label-primary{:for => "community_design_attributes_global_nav_button_on_as_image"}
                    %span.pl-15 Yes 
              .row.global-nav-button-on-upload-fields.hidden
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Global navigation button on
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .select-logo.mb-20.mt-30
                        .select-logo-logo
                          %a.preview-image{:href=>current_community.design.global_nav_button_on.present? ? current_community.design.global_nav_button_on.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Secondary Page Background Image"}
                            = image_tag current_community.design.global_nav_button_on.present? ? current_community.design.global_nav_button_on.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"global-nav-button-on-preview-image"
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15   
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      %span.btn.btn-primary.btn-file.mt-30
                        %i.fa.fa-upload
                        Upload File
                        = file_field_tag :global_nav_button_on
              .text-center.drag-box.mt-15.image-upload#global-nav-button-on-image-upload-holder.global-nav-button-on-upload-fields.hidden
                %span.icon-upload
                  = image_tag "upload-image.png"
                  %p Drag &amp; Drop file to Upload
            #global-navigation-button-off.tab-pane.fade
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Upload global navigation button off image
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = d.check_box :global_nav_button_off_as_image, {class: "global-navigation-field"}
                    %label.label-primary{:for => "community_design_attributes_global_nav_button_off_as_image"}
                    %span.pl-15 Yes
              .row.global-nav-button-off-upload-fields.hidden
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Global navigation button off
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .select-logo.mb-20.mt-30
                        .select-logo-logo
                          %a.preview-image{:href=>current_community.design.global_nav_button_off.present? ? current_community.design.global_nav_button_off.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Secondary Page Background Image"}
                            = image_tag current_community.design.global_nav_button_off.present? ? current_community.design.global_nav_button_off.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"global-nav-button-off-preview-image"
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15   
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      %span.btn.btn-primary.btn-file.mt-30
                        %i.fa.fa-upload
                        Upload File
                        = file_field_tag :global_nav_button_off
              .text-center.drag-box.mt-15.image-upload#global-nav-button-off-image-upload-holder.global-nav-button-off-upload-fields.hidden
                %span.icon-upload
                  = image_tag "upload-image.png"
                  %p Drag &amp; Drop file to Upload    
            #application-background-image.tab-pane.fade
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Upload application background image
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = e.check_box :display_application_background_image, {class: "global-navigation-field"}
                    %label.label-primary{:for => "community_design_attributes_expressionist_attributes_display_application_background_image"}
                    %span.pl-15 Yes
              .row.application-background-image-fields.hidden
                .col-lg-10
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Application background image
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .select-logo.mb-20.mt-30
                        .select-logo-logo
                          %a.preview-image{:href=>current_community.design.expressionist.application_background_image.present? ? current_community.design.expressionist.application_background_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Application Background Image"}
                            = image_tag current_community.design.expressionist.application_background_image.present? ? current_community.design.expressionist.application_background_image.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"application-background-preview-image"
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15   
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      %span.btn.btn-primary.btn-file.mt-30
                        %i.fa.fa-upload
                        Upload File
                        = file_field_tag :application_background_image
              .text-center.drag-box.mt-15.image-upload#application-background-image-upload-holder.application-background-image-fields.hidden
                %span.icon-upload
                  = image_tag "upload-image.png"
                  %p Drag &amp; Drop file to Upload    
:javascript 
  var global_nav_button_on_as_image = "#{current_community.design.global_nav_button_on_as_image}" 
  var global_nav_button_off_as_image = "#{current_community.design.global_nav_button_off_as_image}" 
  var display_button_on_bg_color = "#{current_community.design.expressionist.display_button_on_bg_color}"
  var display_application_background_image = "#{current_community.design.expressionist.display_application_background_image}"

  if(global_nav_button_on_as_image == "true")
    $('.global-nav-button-on-upload-fields').removeClass('hidden');
  if(global_nav_button_off_as_image == "true")
    $('.global-nav-button-off-upload-fields').removeClass('hidden');
  if(display_button_on_bg_color == "true")
    $('.button-on-background-color-field').removeClass('hidden');
  if(display_application_background_image == "true")
    $('.application-background-image-fields').removeClass('hidden');

  $('#community_design_attributes_global_nav_button_on_as_image').change(function(){
    if($(this).is(':checked')){
        $('.global-nav-button-on-upload-fields').removeClass('hidden');
      }
    else{
        $('.global-nav-button-on-upload-fields').addClass('hidden');
     }
  });

  $('#community_design_attributes_global_nav_button_off_as_image').change(function(){
    if($(this).is(':checked')){
        $('.global-nav-button-off-upload-fields').removeClass('hidden');
      }
    else{
        $('.global-nav-button-off-upload-fields').addClass('hidden');
     }
  });

  $('#community_design_attributes_expressionist_attributes_display_button_on_bg_color').change(function(){
    if($(this).is(':checked')){
        $('.button-on-background-color-field').removeClass('hidden');
      }
    else{
        $('.button-on-background-color-field').addClass('hidden');
     }
  });

  $('#community_design_attributes_expressionist_attributes_display_application_background_image').change(function(){
    if($(this).is(':checked')){
        $('.application-background-image-fields').removeClass('hidden');
      }
    else{
        $('.application-background-image-fields').addClass('hidden');
     }
  });
  
  
  adjustBorderOptionsOnGlobalNaviagtion($("#community_design_attributes_secondary_page_menu_border"),$('#community_design_attributes_button_shape').val());

  $('#community_design_attributes_button_shape').change(function(){
    setBorderOptionsOnGlobalNaviagtion($("#community_design_attributes_secondary_page_menu_border"),$(this).val());
  });