.row
  .col-lg-12
    .form-group
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
        Upload Logo
        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "primaryLogoPopover","data-content" => " "}
          %span#propertyDetailNameText
            Uploading a logo will change the logo that appears on the touchscreen and on the eBrochure.
        %span{:style => "font-size: 16px;"}
          %p
            Upload your property logo to be displayed in each page of your Pynwheel Touch app and in your eBrochure.
          %p
            Image will appear at a size of 400 x 120 px. Please note that images that are too small may appear pixelated.
    %span.btn.btn-primary.btn-file.ml-15
      %i.fa.fa-upload
      Upload File
      = file_field_tag :logo

.text-center.drag-box.mt-15.image-upload#design-page-logo-upload-holder
  %span.icon-upload
    = image_tag "upload-image.png"
    %p Drag &amp; Drop file to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container
          - rn =  rand(9999999999999999999999999)
          %a.preview-image{:href=>current_community.logo.present? ? (current_community.crop_x.present? ? current_community.logo.url + "?timestamp=#{rn}" : current_community.logo.url + "?timestamp=#{rn}")  : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Logo"}
            = image_tag current_community.logo.present? ? (current_community.crop_x.present? ? current_community.logo.url + "?timestamp=#{rn}" : current_community.logo.url + "?timestamp=#{rn}") : "default.jpeg",:height=>"100%",:width=>"100%",:id=>"preview-image"
            = image_tag "exclamation-mark.png", class: "waring_exal #{(current_community.logo.present? ? ((current_community.logo.width < 200 && current_community.logo.height < 200) rescue "hidden") ? "" : "hidden" : "hidden") rescue "hidden" }", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"
      - if current_community.logo.present?
        .row{:style => "padding-left: 47%;"}
          = link_to show_logo_in_modal_community_design_index_path(),:class => "", remote: true do
            %span.btn.btn-primary.btn-success.ml-15#crop_logo{"data-target" => "#edit-name", "data-toggle" => "modal"}
              Crop
-#  %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}
-#
-#%span.btn.btn-primary.btn-success.ml-15#crop_logo
-#  Crop
-#%span.btn.btn-primary.btn-success.ml-15#crop_done
-#  Done