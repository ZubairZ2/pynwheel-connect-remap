.row
  .col-lg-10
    .form-group
      %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
        Upload Logo
        %span Upload site logo to display in page
      
      
.row
  .col-lg-10
    .form-group
      %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
      .col-sm-12.col-lg-8.col-md-8.col-xs-12
        .select-logo.mb-20.mt-30
          .select-logo-logo
            %a.preview-image{:href=>current_community.logo.present? ? current_community.logo.url : "##","data-toggle"=>"lightbox"}
              = image_tag current_community.logo.present? ? current_community.logo.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"preview-image"
      %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label   
      .col-sm-12.col-lg-8.col-md-8.col-xs-12
        %span.btn.btn-primary.btn-file.mt-30
          %i.fa.fa-upload
          Upload File
          = file_field_tag :logo

.text-center.drag-box.mt-15.image-upload#design-page-logo-upload-holder
  %span.icon-upload
    = image_tag "upload-image.png"
    %p Drag &amp; Drop file to Upload                    