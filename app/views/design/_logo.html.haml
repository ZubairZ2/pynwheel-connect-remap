-#.row
-#  .col-md-12
-#    .form-group
-#      - if gables_theme(@community) || @community.is_panther? || @community.is_expressionist?
-#        = link_to "Home Page Logo", secondary_logo_community_design_index_path(@community), class: "btn btn-primary btn-file pull-right mr-15"
.row
  .col-lg-12
    .form-group
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
        Upload Logo
        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "primaryLogoPopover","data-content" => " "}
          %span#propertyDetailNameText
            Uploading a logo will change the logo that appears on the touchscreen and on the eBrochure.
        %span{:style => "font-size: 16px;"}
          %p
            Upload your property logo to be displayed in each page of your Pynwheel app and in your eBrochure.
          %p
            Image will appear at a size of 400 x 200 px. Please note that images that are too small may appear pixelated.
    %span.btn.btn-primary.btn-file.ml-15
      %i.fa.fa-upload
      Upload File
      = file_field_tag :logo

.text-center.drag-box.mt-15.image-upload#design-page-logo-upload-holder
  %span.icon-upload
    = image_tag "upload-image.png"
    %p Drag &amp; Drop file to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container
          %a.preview-image{:href=>current_community.logo.present? ? current_community.logo.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Logo"}
            = image_tag current_community.logo.present? ? current_community.logo.url : "default.jpeg",:height=>"100%",:width=>"100%",:id=>"preview-image"