= form_for @community,:method=>"PUT",:html=>{:id=>"map-marker-form"},:remote=>true  do |f|
  = hidden_field_tag "map_marker_tab", true
  = f.fields_for :design do |d|
    .row
      .col-md-12
        %p.title-box Customize Neighborhood Map Marker
    .row
      .col-lg-12
        %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
          Neighborhood Map Marker Options
    .row
      .col-lg-10
        .form-group.mt-30
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            Neighborhood Map marker background color
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            .input-group.colorpicker-style.hex-format-colorpicker
              .input-group-addon
                %i
                = d.text_field :marker_background_color , class: "form-control map-marker-field",autocomplete: true,:value=>d.object.marker_background_color.present? ? d.object.marker_background_color : "#565455"      
    .row
      .col-lg-10
        .form-group.mt-30
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            Neighborhood Map marker style
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            -# = d.select :marker_style , options_for_select([["","fa fa-map-marker",{"data-icon"=>"fa fa-map-marker"}]],d.object.marker_style),{},{class: "form-control selectpicker map-marker-field"}
            = d.select :marker_style , options_for_select(["Tear Drop","Circle"],d.object.marker_style),{},{class: "form-control selectpicker map-marker-field"}


    .row
      .col-lg-10
        .form-group
          .col-lg-12.col-md-12
            %button.btn-success.done_btn{:onclick => "map_marker_goBack()",:style => "margin-top: 35px;"}
              %i.fa.fa-plus-circle
              DONE

:javascript
  function map_marker_goBack()
  {
    $('.map-marker-form').submit();
     window.location.reload();
  }