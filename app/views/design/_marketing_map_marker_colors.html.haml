%div{style: "margin-bottom: 20px;"}
  %label
    = radio_button_tag :map_type, "property", false, class: "map-type-radio"
    By Property
  %label
    = radio_button_tag :map_type, "floorplan", true, class: "map-type-radio"
    By Floor Plan


%div#map-type-container
  %div#floorplan-map
    = render 'floorplan_map_marker_colors'

  %div#property-map{ style: "display:none;" }
    = render 'property_map_marker_colors'

:javascript
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".map-type-radio").forEach(function(radio) {
      radio.addEventListener("change", function() {
        if (this.value === "floorplan") {
          document.getElementById("floorplan-map").style.display = "block";
          document.getElementById("property-map").style.display = "none";
        } else {
          document.getElementById("floorplan-map").style.display = "none";
          document.getElementById("property-map").style.display = "block";
        }
      });
    });
  });
