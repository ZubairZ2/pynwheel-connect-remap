= form_for @community,:method=>"PUT",:html=>{:id=>"gables-form"},:remote=>true  do |f|
  = hidden_field_tag "gables_tab", true
  = f.fields_for :design do |d|
    = d.fields_for :gable do |g|
      .row
        .col-md-12
          %p.title-box Customize Gables Theme
      .row
        .col-lg-12
          %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
            Gables Options
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
              Tagline
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .TriSea-technologies-Switch
                %span.pr-15 No
                = g.check_box :hide_tagline, {class: "gables-field"}
                %label.label-primary{:for => "community_design_attributes_gable_attributes_hide_tagline"}
                %span.pl-15 Yes 
      / = g.check_box :hide_tagline, {class: "gables-field"}
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Gables Theme
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.select :theme_name , options_for_select(gables_theme_options,f.object.any_gables_theme? ? f.object.theme_name : 'gables_energetic'),{},{class: "form-control"}
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Appartment buton color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :appartment_button_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.appartment_button_color.present? ? g.object.appartment_button_color : "#8A8A8D" 
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Gallery buton color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :gallery_button_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.gallery_button_color.present? ? g.object.gallery_button_color : "#44797B" 
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Neighborhood buton color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :neighborhood_button_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.neighborhood_button_color.present? ? g.object.neighborhood_button_color : "#0475A9" 
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Favorite buton color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :favorite_button_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.favorite_button_color.present? ? g.object.favorite_button_color : "#D5C228" 
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Filter panel color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :filter_panel_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.filter_panel_color.present? ? g.object.filter_panel_color : "#467A7D"                                                        
      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Webpages button color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :webpages_button_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.webpages_button_color.present? ? g.object.webpages_button_color : "#96348F"                                                        

      .row
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Image pages button color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = g.text_field :imagepages_button_color , class: "form-control gables-field",autocomplete: true,"data-value"=>g.object.imagepages_button_color.present? ? g.object.imagepages_button_color : "#96348F"

      .form-group
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display home page image
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = g.check_box :display_home_page_nav_bg_image_button, {class: "gables-field"}
            %label.label-primary{:for => "community_design_attributes_gable_attributes_display_home_page_nav_bg_image_button"}
            %span.pl-15 Yes
      #home_page_nav_bg_image_fields.hidden
        .row
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Display Home page Navigation Background image
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .select-logo.mb-20.mt-30
                  .select-logo-logo
                    %a.preview-image{:href=>current_community.design.gable.home_page_nav_bg_image.present? ? current_community.design.gable.home_page_nav_bg_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Home page button image"}
                      = image_tag current_community.design.gable.home_page_nav_bg_image.present? ? current_community.design.gable.home_page_nav_bg_image.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"gable-home-page-nav-bg-image-preview"
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                %span.btn.btn-primary.btn-file.mt-30
                  %i.fa.fa-upload
                  Upload File
                  = file_field_tag :home_page_nav_bg_image
        .text-center.drag-box.mt-15.image-upload#gable-home-page-nav-bg-image-upload-holder
          %span.icon-upload
            = image_tag "upload-image.png"
            %p Drag &amp; Drop file to Upload
            /---------------------------------------------------------------------------
      .form-group
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display Global Navigation Background Image
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = g.check_box :display_global_nav_bg_image_button, {class: "gables-field"}
            %label.label-primary{:for => "community_design_attributes_gable_attributes_display_global_nav_bg_image_button"}
            %span.pl-15 Yes
      #global_nav_bg_image_fields.hidden
        .row
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Global Navigation Background Image
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .select-logo.mb-20.mt-30
                  .select-logo-logo
                    %a.preview-image{:href=>current_community.design.gable.global_nav_bg_image.present? ? current_community.design.gable.global_nav_bg_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Home page button image"}
                      = image_tag current_community.design.gable.global_nav_bg_image.present? ? current_community.design.gable.global_nav_bg_image.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"gable-global-nav-bg-image-preview"
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                %span.btn.btn-primary.btn-file.mt-30
                  %i.fa.fa-upload
                  Upload File
                  = file_field_tag :global_nav_bg_image
        .text-center.drag-box.mt-15.image-upload#gable-global-nav-bg-image-upload-holder
          %span.icon-upload
            = image_tag "upload-image.png"
            %p Drag &amp; Drop file to Upload
            /---------------------------------------

      .form-group
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display Filter Panel Background Image
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = g.check_box :display_filter_panel_bg_image_button, {class: "gables-field"}
            %label.label-primary{:for => "community_design_attributes_gable_attributes_display_filter_panel_bg_image_button"}
            %span.pl-15 Yes
      #filter_panel_background_image_fields.hidden
        .row
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Filter Panel Background Image
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .select-logo.mb-20.mt-30
                  .select-logo-logo
                    %a.preview-image{:href=>current_community.design.gable.filter_panel_bg_image.present? ? current_community.design.gable.filter_panel_bg_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Home page button image"}
                      = image_tag current_community.design.gable.filter_panel_bg_image.present? ? current_community.design.gable.filter_panel_bg_image.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"gable-filter-panel-bg-image-preview"
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                %span.btn.btn-primary.btn-file.mt-30
                  %i.fa.fa-upload
                  Upload File
                  = file_field_tag :filter_panel_bg_image
        .text-center.drag-box.mt-15.image-upload#gable-filter-panel-bg-image-upload-holder
          %span.icon-upload
            = image_tag "upload-image.png"
            %p Drag &amp; Drop file to Upload

:javascript
  var display_home_page_image = "#{current_community.design.gable.display_home_page_nav_bg_image_button}"
  if(display_home_page_image == "true")
    $('#home_page_nav_bg_image_fields').removeClass('hidden');
  $('#community_design_attributes_gable_attributes_display_home_page_nav_bg_image_button').change(function(){
    if($(this).is(':checked')){
        $('#home_page_nav_bg_image_fields').removeClass('hidden');
      }
    else{
        $('#home_page_nav_bg_image_fields').addClass('hidden');
     }
  });

  var display_global_image = "#{current_community.design.gable.display_global_nav_bg_image_button}"

  if(display_global_image == "true")
    $('#global_nav_bg_image_fields').removeClass('hidden');

  $('#community_design_attributes_gable_attributes_display_global_nav_bg_image_button').change(function(){
    if($(this).is(':checked')){
        $('#global_nav_bg_image_fields').removeClass('hidden');
      }
    else{
        $('#global_nav_bg_image_fields').addClass('hidden');
     }
  });

  var display_filter_panel_image = "#{current_community.design.gable.display_filter_panel_bg_image_button}"

  if(display_filter_panel_image == "true")
    $('#filter_panel_background_image_fields').removeClass('hidden');

  $('#community_design_attributes_gable_attributes_display_filter_panel_bg_image_button').change(function(){
    if($(this).is(':checked')){
        $('#filter_panel_background_image_fields').removeClass('hidden');
      }
    else{
        $('#filter_panel_background_image_fields').addClass('hidden');
     }
  });

  setGablesThemeDefaultValues();
  $('#community_theme_name').change(function(){
    var gables_theme = $(this).val();
    if(gables_theme == 'gables_organic'){
      setGablesOrganicValues()
    }
    if(gables_theme == 'gables_refined'){
      setGablesRefinedValues()
    }
    if(gables_theme == 'gables_energetic'){
      setGablesEnergeticValues()
    }
    if(gables_theme == 'gables_natural'){
      setGablesNaturalValues()
    }
    if(gables_theme == 'gables_custom'){
      setGablesCustomValues()
    }
  });