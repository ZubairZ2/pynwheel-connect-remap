                    %a.preview-image{:href=>current_community.design.gable.home_page_nav_bg_image.present? ? current_community.design.gable.home_page_nav_bg_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Home Page Navigation Background Image"}
                      = image_tag current_community.design.gable.home_page_nav_bg_image.present? ? current_community.design.gable.home_page_nav_bg_image.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"gable-home-page-nav-bg-image-preview"
