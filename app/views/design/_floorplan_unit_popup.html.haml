        .form-group.mt-30
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            Unit header background color
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            .input-group.colorpicker-style.hex-format-colorpicker
              .input-group-addon
                %i
                = d.text_field :unit_header_bg_color , class: "form-control floorplan-unit-popup-field",autocomplete: true,:value=>d.object.unit_header_bg_color.present? ? d.object.unit_header_bg_color : "#565455"
