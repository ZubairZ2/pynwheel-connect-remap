= form_for @community,:method=>"PUT",:html=>{:id=>"theme-form"},:remote=>true do |f|
  = hidden_field_tag "theme_tab", true
  .row
    .col-lg-6
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
        Select Theme
        %span Select a theme from below.
    .col-lg-6
      = link_to "Clone Community" , community_clone_community_path(current_community) , :class=>"btn btn-primary",:style => "float: right; margin-right: 15px;"
  .row
    .col-lg-12
      .col-lg-3.col-md-6.col-sm-12
        .select-theme#futurist-theme{:class=>"#{@community.is_futurist? ? 'active-theme' : 'active'}"}
          .theme-img{:style => "background:url(#{asset_path('theme-image-1.jpg')});"}
          .themes-detail
            .pull-left
              %h4 Futurist
            .pull-right
              /%a{:href => "##"} View Theme
              = f.radio_button :theme_name,"futurist",style: "display: none;" 
              %a.btn.btn-success.theme-selection{:href => "javascript:;","data-theme-name"=>"futurist"} Select
          %i.fa.fa-check
      .col-lg-3.col-md-6.col-sm-12
        .select-theme#cubist-theme{:class=>"#{@community.is_cubist? ? 'active-theme' : 'active'}"}
          .theme-img{:style => "background:url(#{asset_path('theme-image-2.jpg')});"}
          .themes-detail
            .pull-left
              %h4 Cubist
            .pull-right
              /%a{:href => "#"} View Theme
              = f.radio_button :theme_name,"cubist",style: "display: none;"  
              %a.btn.btn-success.theme-selection{:href => "javascript:;","data-theme-name"=>"cubist"} Select
          %i.fa.fa-check   
      .col-lg-3.col-md-6.col-sm-12
        .select-theme#modernist-theme{:class=>"#{@community.is_modernist? ? 'active-theme' : 'active'}"}
          .theme-img{:style => "background:url(#{asset_path('theme-image-3.jpg')});"}
          .themes-detail
            .pull-left
              %h4 Modernist
            .pull-right
              /%a{:href => "#"} View Theme
              = f.radio_button :theme_name,"modernist",style: "display: none;" 
              %a.btn.btn-success.theme-selection{:href => "javascript:;","data-theme-name"=>"modernist"} Select
          %i.fa.fa-check  
      .col-lg-3.col-md-6.col-sm-12
        .select-theme#expressionist-theme{:class=>"#{@community.is_expressionist? ? 'active-theme' : 'active'}"}
          .theme-img{:style => "background:url(#{asset_path('theme-image-4.jpg')});"}
          .themes-detail
            .pull-left
              %h4 Expressionist
            .pull-right
              /%a{:href => "#"} View Theme
              = f.radio_button :theme_name,"expressionist",style: "display: none;" 
              %a.btn.btn-success.theme-selection{:href => "javascript:;","data-theme-name"=>"expressionist"} Select
          %i.fa.fa-check
      .col-lg-3.col-md-6.col-sm-12
        .select-theme{:class=>"#{@community.any_gables_theme? ? 'active-theme' : 'active'}",:id=>"#{@community.any_gables_theme? ? @community.theme_name : 'gables_energetic'}-theme"}
          .theme-img{:style => "background:url(#{asset_path('gables-organic.jpg')});"}
          .themes-detail
            .pull-left
              %h4 Gables
            .pull-right
              /%a{:href => "#"} View Theme
              = f.radio_button :theme_name,"#{@community.any_gables_theme? ? @community.theme_name : 'gables_energetic'}",style: "display: none;" 
              %a.btn.btn-success.theme-selection{:href => "javascript:;","data-theme-name"=>"#{@community.any_gables_theme? ? @community.theme_name : 'gables_energetic'}"} Select
          %i.fa.fa-check
      .col-lg-3.col-md-6.col-sm-12
        .select-theme#panther-theme{:class=>"#{@community.is_panther? ? 'active-theme' : 'active'}"}
          .theme-img{:style => "background:url(#{asset_path('panther.jpg')});"}
          .themes-detail
            .pull-left
              %h4 Panther
            .pull-right
              /%a{:href => "#"} View Theme
              = f.radio_button :theme_name,"panther",style: "display: none;" 
              %a.btn.btn-success.theme-selection{:href => "javascript:;","data-theme-name"=>"panther"} Select
          %i.fa.fa-check
      
  .row
    .col-lg-12
      .box-footer.mt-30.pt-15
        %button.btn-success.done_btn{:onclick => "design_goBack()"}
          %i.fa.fa-plus-circle
          DONE

:javascript
  function design_goBack()
  {
     if (window.history.length == 1)
     {
      window.location.reload();
     }
     else
     {
      window.history.back();
     }
  }
  //$( "#expressionist-theme" ).click(function() {
  //$.ajax({
  //    url: "/communities/"+#{current_community.id}+"/change_expressionist_default",
  //    type: "GET",
  //    dataType: "script"
  //  });
  //  location.reload();
  //});