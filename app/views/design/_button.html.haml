.row
  .col-md-12
    %p.title-box Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed dictum dolor sem, quis pharetra dui ultricies vel. Cras non pulvinar tellus, vel bibendum magna. Morbi tellus nulla, cursus non nisi sed, porttitor dignissim erat. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc facilisis commodo lectus. Vivamus vel tincidunt enim, non vulputate ipsum. Ut pellentesque consectetur arcu sit amet scelerisque. Fusce commodo leo eros, ut eleifend massa congue at.
.row
  .col-lg-12
    %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
      Upload Buttons
.row
  .col-lg-10
    .form-group.mt-30
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
        Upload Buttons For ?
        %span For Which Screen You want to Upload
      .col-sm-12.col-lg-9.col-md-9.col-xs-12
        .radio.radio-primary.pull-left
          %input#main-screen-radio{:name => "screen_radio", :type => "radio", :value => "main_screen_radio",:checked=>params[:radio_button].present? ? false : true}
            %label{:for => "main_screen_radio"}
              Main Screen
        .radio.radio-primary.pull-left.ml-20{:style => "margin-top:12px;"}
          %input#home-screen-radio{:name => "screen_radio", :type => "radio", :value => "home_screen_radio",:checked=>params[:radio_button].present? ? true : false}
            %label{:for => "home_screen_radio"}
              Landing Page
#main-screen              
  = form_for @community,:method=>"PUT",:html=>{:id=>"main-screen-button-style-form"},:remote=>true do |f|
    = hidden_field_tag "button_main_screen_tab", true
    = f.fields_for :design do |d|
      = d.fields_for :main_screen do |m|  
        = hidden_field_tag :main_screen_id,m.object.id            
        .row
          .col-lg-10
            .mt-30
        .row
          .col-lg-10
            .row
              .col-lg-3.col-xs-12.col-md-4
                %ul.nav.nav-tabs.tabs-left.images-tabs
                  %li.active
                    %a{"data-toggle" => "tab", :href => "#main-apppartments"}
                      Apppartments
                      %span Upload Appartments Button
                  %li
                    %a{"data-toggle" => "tab", :href => "#main-gallery"}
                      Gallery
                      %span Upload Gallery Button
                  %li
                    %a{"data-toggle" => "tab", :href => "#main-neighbourhood"}
                      Neighbourhood
                      %span Upload Neighbourhood Button
                  %li
                    %a{"data-toggle" => "tab", :href => "#main-favorites"}
                      Favorites
                      %span Upload Favorites Button    
              .col-lg-9.col-xs-12.col-md-8
                / Tab panes
                .tab-content.tab-content-new
                  #main-apppartments.tab-pane.active
                    .col-lg-10
                      .form-group
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .select-img.mb-20.mt-30
                            .select-img-img= image_tag m.object.appartments_button.present? ? m.object.appartments_button.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-main-screen-appartments-button-image"      
                          %span.btn.btn-primary.btn-file.mt-30
                            %i.fa.fa-upload
                            Upload File
                            = m.file_field :appartments_button 
                  #main-gallery.tab-pane
                    .col-lg-10
                      .form-group
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .select-img.mb-20.mt-30
                            .select-img-img= image_tag m.object.galleries_button.present? ? m.object.galleries_button.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-main-screen-galleries-button-image"      
                          %span.btn.btn-primary.btn-file.mt-30
                            %i.fa.fa-upload
                            Upload File
                            = m.file_field :galleries_button
                  #main-neighbourhood.tab-pane
                    .col-lg-10
                      .form-group
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .select-img.mb-20.mt-30
                            .select-img-img= image_tag m.object.neighborhood_button.present? ? m.object.neighborhood_button.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-main-screen-neighborhood-button-image"      
                          %span.btn.btn-primary.btn-file.mt-30
                            %i.fa.fa-upload
                            Upload File
                            = m.file_field :neighborhood_button
                  #main-favorites.tab-pane
                    .col-lg-10
                      .form-group
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .select-img.mb-20.mt-30
                            .select-img-img= image_tag m.object.favorities_button.present? ? m.object.favorities_button.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-main-screen-favorities-button-image"      
                          %span.btn.btn-primary.btn-file.mt-30
                            %i.fa.fa-upload
                            Upload File
                            = m.file_field :favorities_button
                    .clearfix
      = d.fields_for :menu do |m|                
        .row
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Menu Position
                %span Select position of menu
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = m.select :position , options_for_select(menu_position,m.object.position),{},{class: "form-control main-screen-field",id: "main_screen_menu_position"}
        .row#main-screen-vertical-menu-position
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Vertical Menu Position
                %span Select vertical position of menu
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = m.select :vertical_menu_position , options_for_select(vertical_menu_position,m.object.vertical_menu_position),{},{class: "form-control main-screen-field"}
        .row#main-screen-horizontal-menu-position
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Horizontal Menu Position
                %span Select horizontal position of menu
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = m.select :horizontal_menu_position , options_for_select(horizontal_menu_position,m.object.horizontal_menu_position),{},{class: "form-control main-screen-field"}             
        .row
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                Manage Background
                %span Manage navigation background
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = m.check_box :manage_background,id: "TriSeaPrimary2",:class=>"main-screen-field"
                  %label.label-primary{:for => "TriSeaPrimary2"}
                  %span.pl-15 Yes
        #m-style-background-color           
          .row
            .col-lg-10
              .form-group.mt-30
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Background color
                  %span Select menu background color & opacity
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .input-group.colorpicker-style.rgba-format-colorpicker
                    .input-group-addon
                      %i
                      = m.text_field :background_color ,id: "m-style-background-color-text-field", class: "form-control main-screen-field",readonly: true,autocomplete: true      
        .row
          .col-md-12
            .box-footer.mt-30.pt-15
              
