- content_for :title, "Design - Pynwheel"
.divLoading.hidden
%section.is-home-page
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Design
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12.mt-30
        .bs-example.bs-example-tabs.theme-setting{"data-example-id" => "togglable-tabs"}
          %ul#myTabs.nav.nav-tabs{:role => "tablist"}
            %li.active{:role => "presentation"}
              %a#home-tab{"aria-expanded" => "true", "data-toggle" => "tab", :href => "#home", :role => "tab"} Logo Options
            - if can? :select_theme, current_user  
              %li{:role => "presentation"}
                %a#theme-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-theme", :role => "tab"} Select Theme     
            %li.hidden{:role => "presentation"}
              %a#font-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-font", :role => "tab"} Font
            %li.hidden{:role => "presentation"}
              %a#menu-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-menu", :role => "tab"} Menu  
            %li.hidden{:role => "presentation"}
              %a#overlay-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-overlay", :role => "tab"} Expressionist Options   
            %li.hidden.dropdown{:role => "presentation"}
              %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#"}
                Style
                %span.caret
              %ul.dropdown-menu{"aria-labelledby" => "myTabDrop1"}
                %li
                  %a#custom-style-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#c-style", :role => "tab"} Custom Menu Buttons 
                %li
                  %a#button-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#u-button", :role => "tab"} Upload Menu Buttons
          #myTabContent.tab-content.add-plan
            / Start L>ogo Upload section
            #home.tab-pane.fade.active.in{:role => "tabpanel"}
              = render 'logo'
            #s-theme.tab-pane.fade{:role => "tabpanel"}
              = render 'theme'
            #s-overlay.tab-pane.fade{:role => "tabpanel"}
              = render 'overlay'    
            #s-font.tab-pane.fade{:role => "tabpanel"}
              = render 'font'
            #s-menu.tab-pane.fade{:role => "tabpanel"}
              = render 'menu'  
            #c-style.tab-pane.fade{:role => "tabpanel"}
              = render 'custom_style'
            #u-button.tab-pane.fade{:role => "tabpanel"}
              = render 'button'
:javascript 
  var community_id = #{params[:community_id]};
  var selected_theme = '#{@community.theme_name}';