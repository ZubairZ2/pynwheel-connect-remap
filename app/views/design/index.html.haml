- content_for :title, "Design - Pynwheel"
.divLoading.hidden
%section.is-home-page
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Design
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12.mt-30
        .bs-example.bs-example-tabs.theme-setting{"data-example-id" => "togglable-tabs"}
          %ul#myTabs.nav.nav-tabs{:role => "tablist"}
            %li.active{:role => "presentation"}
              %a#home-tab{"aria-expanded" => "true", "data-toggle" => "tab", :href => "#home", :role => "tab"} Logo Options
            - if can? :select_theme, current_user  
              %li{:role => "presentation"}
                %a#theme-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-theme", :role => "tab"} Select Theme     
            %li.hidden{:role => "presentation"}
              %a#font-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-font", :role => "tab"} Font 
            %li.hidden.dropdown{:role => "presentation"}
              %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#"}
                Menu
                %span.caret
              %ul.dropdown-menu{"aria-labelledby" => "myTabDrop1"}
                %li
                  %a#custom-style-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#c-style", :role => "tab"} Custom Style
                %li
                  %a#button-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#u-button", :role => "tab"} Upload Buttons
          #myTabContent.tab-content.add-plan
            / Start L>ogo Upload section
            #home.tab-pane.fade.active.in{:role => "tabpanel"}
              = render 'logo'
            #s-theme.tab-pane.fade{:role => "tabpanel"}
              = render 'theme'
            #s-color.tab-pane.fade{:role => "tabpanel"}
              = form_for @community,:method=>"PUT" do |f|
                = f.fields_for :design do |d|
                  .row
                    .col-md-12
                      %p.title-box Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed dictum dolor sem, quis pharetra dui ultricies vel. Cras non pulvinar tellus, vel bibendum magna. Morbi tellus nulla, cursus non nisi sed, porttitor dignissim erat. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc facilisis commodo lectus. Vivamus vel tincidunt enim, non vulputate ipsum. Ut pellentesque consectetur arcu sit amet scelerisque. Fusce commodo leo eros, ut eleifend massa congue at.
                  .row
                    .col-lg-12
                      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
                        Color Options
                  .row
                    .col-lg-10
                      .form-group.mt-30
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label.font-size-15
                          Select Primary Color
                          %span Select a color
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .input-group.colorpicker-style.hex-format-colorpicker
                            .input-group-addon
                              %i
                              = d.text_field :primary_color, class: "form-control validate[required]",readonly: true,autocomplete: true
                  .row
                    .col-lg-10
                      .form-group.mt-30
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label.font-size-15
                          Select Secondary Color
                          %span Select a color
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .input-group.colorpicker-style.hex-format-colorpicker
                            .input-group-addon
                              %i
                              = d.text_field :secondary_color, class: "form-control validate[required]",readonly: true,autocomplete: true
                  .mt-40
                  .row
                    .col-md-12
                      .box-footer.mt-30.pt-15
                        %button.btn.btn-success.pull-right{:type => "submit"}
                          %i.fa.fa-save
                          SAVE CHANGES
                / End Color section
            #s-overlay.tab-pane.fade{:role => "tabpanel"}
              = form_for @community,:method=>"PUT" do |f|
                = f.fields_for :design do |d|
