:javascript 
  var theme_tab = #{params[:tab].present? && params[:tab] == "theme"}
  var color_tab = #{params[:tab].present? && params[:tab] == "color"}
  var font_tab = #{params[:tab].present? && params[:tab] == "font"}
  var custom_style_tab = #{params[:tab].present? && params[:tab] == "custom_style"}
  var button_tab = #{params[:tab].present? && params[:tab] == "button"}
  var overlay_tab = #{params[:tab].present? && params[:tab] == "overlay"}
  hideShowBackgroundColorDiv($('#community_design_attributes_menu_attributes_manage_background'),$('#c-style-background-color '));
  hideShowBackgroundColorDiv($('#TriSeaPrimary2'),$('#m-style-background-color '));
  hideShowBackgroundColorDiv($('#TriSeaPrimary3'),$('#h-style-background-color '));
  $('#community_design_attributes_menu_attributes_manage_background').change(function(){
    hideShowBackgroundColorDiv($(this),$('#c-style-background-color '));
  });

  $('#TriSeaPrimary2').change(function(){
    hideShowBackgroundColorDiv($(this),$('#m-style-background-color '));
  });

  $('#TriSeaPrimary3').change(function(){
    hideShowBackgroundColorDiv($(this),$('#h-style-background-color '));
  });

  function hideShowBackgroundColorDiv(radio_button,element){
    if ($(radio_button).is(":checked")){
      $(element).show();
    }
    else{
      $(element).hide();
    }
  }
  