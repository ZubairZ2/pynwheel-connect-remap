                  .row
                    .col-lg-12
                      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
                        Color Options
                  .row
                    .col-lg-10
                      .form-group.mt-30
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
                          Select Primary Color
                          %span Select a color
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .input-group.colorpicker-style.hex-format-colorpicker
                            .input-group-addon
                              %i
                              = d.text_field :primary_color, class: "form-control validate[required]"
                  .row
                    .col-lg-10
                      .form-group.mt-30
                        %label.col-sm-12.col-lg-4.col-md-4.col-xs-12.control-label
                          Select Secondary Color
                          %span Select a color
                        .col-sm-12.col-lg-8.col-md-8.col-xs-12
                          .input-group.colorpicker-style.hex-format-colorpicker
                            .input-group-addon
                              %i
                              = d.text_field :secondary_color, class: "form-control validate[required]"
                  .mt-40
                  .row
                    .col-md-12
                      .box-footer.mt-30.pt-15
                        %button.btn.btn-success.pull-right{:type => "submit"}
                          %i.fa.fa-save
                          SAVE CHANGES
                / End Overlay section    
            #s-font.tab-pane.fade{:role => "tabpanel"}
              = render 'font'
            #c-style.tab-pane.fade{:role => "tabpanel"}
              = render 'custom_style'
            #u-button.tab-pane.fade{:role => "tabpanel"}
              = render 'button'
:javascript 
  var community_id = #{params[:community_id]};
  var selected_theme = '#{@community.theme_name}';