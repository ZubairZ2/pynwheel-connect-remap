                        .select-img.mb-20.mt-30
                          .select-img-img= image_tag f.object.logo.present? ? f.object.logo.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"      
                        %span.btn.btn-primary.btn-file.mt-30
                          %i.fa.fa-upload
                          Upload File
                          = f.file_field :logo          
                .row
                  .form-group
                    
                .row
                  .col-lg-12
                    .box-footer.mt-30.pt-15
                      %button.btn.btn-success.pull-right{:type => "submit"}
                        %i.fa.fa-save>
