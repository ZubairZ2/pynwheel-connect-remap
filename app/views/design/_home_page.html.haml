:javascript
  var display_home_page_image = "#{current_community.design.expressionist.display_home_page_image}"       
  var display_home_page_nav_background_image = "#{current_community.design.expressionist.display_home_page_nav_background_image}"       

  function homepage_goBack()
  {
    $('.home-page-form').submit();
     window.location.reload();
  }
  if(display_home_page_image == "true")
    $('#home-page-image-fields').removeClass('hidden');

  if(display_home_page_nav_background_image == "true")
    $('#home-page-background-image-fields').removeClass('hidden');

  $('#community_design_attributes_expressionist_attributes_display_home_page_image').change(function(){
    if($(this).is(':checked')){
        $('#home-page-image-fields').removeClass('hidden');
      }
    else{
        $('#home-page-image-fields').addClass('hidden');
     }
  });
  $('#community_design_attributes_expressionist_attributes_display_home_page_nav_background_image').change(function(){
    if($(this).is(':checked')){
        $('#home-page-background-image-fields').removeClass('hidden');
      }
    else{
        $('#home-page-background-image-fields').addClass('hidden');
     }
  });


  adjustBorderOptions($("#community_design_attributes_home_page_buttons_border"),$('#community_design_attributes_home_page_button_shape').val());

  $('#community_design_attributes_home_page_button_shape').change(function(){
    setBorderOptions($("#community_design_attributes_home_page_buttons_border"),$(this).val());
  });

  $('#community_design_attributes_expressionist_attributes_home_page_position_of_logo').change(function(){
    setLogoSize($(this).val());
  });
  $('.home_page_button_shape').change(function(){
    setHomePageIconsPosition($(this).val());
  });
  if ($('.home_page_button_shape').val() == 'Circular')
  {
    $('.homepage_icons_position').children("option").hide();
    $('.homepage_icons_position').val("Above the text");
  }
  adjustHomepagePositionOfLogo($('#home_page_menu_position').val());
  $('#home_page_menu_position').change(function(){
    adjustHomepagePositionOfLogo($(this).val());
  });
  adjustHomepagePositionOfLogoWithVerticalApp(#{current_community.is_vertical_app});
  $('#home_page_position_of_logo').change(function(){
  if ($(this).val() == "Top" || $(this).val() == "Bottom")
  {
    $('.logo_size_div_field').hide();
  }
  else
  {
    $('.logo_size_div_field').show();
  }
