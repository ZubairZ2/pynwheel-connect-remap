= form_for @community,:method=>"PUT",:html=>{:id=>"home-page-form"},:remote=>true  do |f|
  = hidden_field_tag "home_page_tab", true
  = f.fields_for :design do |d|
    / .row
    /   .col-md-12
    /     %p.title-box Customize Home Page

    .row
      .col-lg-12
        %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label{:style => "font-size: 23px; color: #1e8ece;"}
          Home Page Options
    %br
    = d.fields_for :expressionist do |e|
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label.global_navigation_heading{:style => "font-size: 20px;  color: #89c765;"}
        Logo options

      .row.global_navigation_sub_heading
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Position of logo
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :home_page_position_of_logo , options_for_select(home_page_position_of_logo,e.object.home_page_position_of_logo),{},{class: "form-control home-page-field",id: "home_page_position_of_logo"}
      .row.logo_size_div_field.global_navigation_sub_heading
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Logo size
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :home_page_logo_size , options_for_select(home_page_logo_size,e.object.home_page_logo_size),{},{class: "form-control home-page-field", id: "logo_size_field"}

      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label{:style => "font-size: 23px; color: #1e8ece;"}
        Home Page Navigation Options
      %br
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label.global_navigation_heading{:style => "font-size: 21px;  color: #89c765;"}
        Home Page Navigation Background
      .form-group.global_navigation_sub_heading
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display home page navigation background
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = e.check_box :display_home_page_nav_background, {class: "home-page-field"}
            %label.label-primary{:for => "community_design_attributes_expressionist_attributes_display_home_page_nav_background"}
            %span.pl-15 Yes
      .row.global_navigation_sub_heading
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Menu Position
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = e.select :home_page_menu_position , options_for_select(horizontal_menu_position_homepage,e.object.home_page_menu_position.present? ? e.object.home_page_menu_position : "Bottom"),{},{class: "form-control home-page-field",id: "home_page_menu_position"}
      .row.global_navigation_sub_heading
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15#home_page_navigation_background_height
              Home page navigation background height
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :home_page_navigation_background_height , options_for_select(navigation_background_height_options,d.object.home_page_navigation_background_height),{},{class: "form-control home-page-field"}
      .row.global_navigation_sub_heading
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Home page navigation background color
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i
                  = d.text_field :home_page_navigation_background_color , class: "form-control home-page-field",autocomplete: true,:value=>d.object.home_page_navigation_background_color.present? ? d.object.home_page_navigation_background_color : "#565455"
      .row.global_navigation_sub_heading
        .col-lg-10
          .form-group.mt-30
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              Home page navigation background opacity
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = d.select :home_page_navigation_background_opacity , options_for_select(opacity_options,d.object.home_page_navigation_background_opacity.present? ? d.object.home_page_navigation_background_opacity : "100%"),{},{class: "form-control home-page-field"}
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label.global_navigation_heading{:style => "font-size: 18px;  color: #ee3b31;"}
        Upload image for navigation background
      .form-group.global_navigation_sub_heading
        %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
          Display home page navigation background image
        .col-sm-12.col-lg-9.col-md-9.col-xs-12
          .TriSea-technologies-Switch
            %span.pr-15 No
            = e.check_box :display_home_page_nav_background_image, {class: "home-page-field"}
            %label.label-primary{:for => "community_design_attributes_expressionist_attributes_display_home_page_nav_background_image"}
            %span.pl-15 Yes
      #home-page-background-image-fields.hidden.global_navigation_sub_heading
        .row
          .col-lg-10
            .form-group.mt-30
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Home page navigation background image
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .select-logo.mb-20.mt-30
                  .select-logo-logo
                    %a.preview-image{:href=>current_community.design.expressionist.home_page_background_image.present? ? current_community.design.expressionist.home_page_background_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Home page background image"}
                      = image_tag current_community.design.expressionist.home_page_background_image.present? ? current_community.design.expressionist.home_page_background_image.url : "default.jpeg",:height=>"auto",:width=>"100%",:id=>"home-page-background-image-preview"
                      = image_tag "exclamation-mark.png", class: "exal_home_page_background_image #{(current_community.design.expressionist.home_page_background_image.present? ? ( (current_community.design.expressionist.home_page_background_image.width < 400 && current_community.design.expressionist.home_page_background_image.height < 400) rescue "hidden")? "" : "hidden" : "hidden")}", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"

              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                %span.btn.btn-primary.btn-file.mt-30
                  %i.fa.fa-upload
                  Upload File
                  = file_field_tag :home_page_background_image
        .text-center.drag-box.mt-15.image-upload#home-page-background-image-upload-holder
          %span.icon-upload
            = image_tag "upload-image.png"
            %p Drag &amp; Drop file to Upload
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label{:style => "font-size: 23px; color: #89c765;"}
        Home Page Navigation Button Options
      %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label{:style => "font-size: 23px; color: #9a5aa6;"}
