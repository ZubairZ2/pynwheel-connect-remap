- content_for :title, "Property Logo - Pynwheel"
.divLoading.hidden
- if @community.pynwheel_touch_enabled? || @community.pynwheel_tour_enabled? || @community.pynwheel_map_enabled?
  %section.is-home-page
    .content
      .title-heading
        %h4
          %i.fa.fa-cubes
          = @community.name.capitalize
          %br
            %small.text-primary
              = @community.code
      .box.box-info.add-plan.mt-20#logo_header
        .box-header
          %h3.box-title
            PROPERTY LOGO
            %span
      .row
        / Start Panel left Side
        .col-lg-12.col-md-12
          .bs-example.bs-example-tabs.theme-setting{"data-example-id" => "togglable-tabs"}
            #myTabContent.tab-content.add-plan
              / Start L>ogo Upload section
              #home.tab-pane.fade.active.in{:role => "tabpanel"}
                = render 'logo'

- if @community.pynwheel_touch_enabled?
  %section.is-home-page
    .content
      .row
        / Start Panel left Side
        .col-lg-12.col-md-12
          .bs-example.bs-example-tabs.theme-setting{"data-example-id" => "togglable-tabs"}
            #myTabContent.tab-content.add-plan
              / Start L>ogo Upload section
              #home.tab-pane.fade.active.in{:role => "tabpanel"}
                = render 'secondary_logo'

- if @community.pynwheel_tour_enabled?
  %section.is-home-page
    .content
      .row
        .col-lg-12.col-md-12
          .bs-example.bs-example-tabs.theme-setting{"data-example-id" => "togglable-tabs"}
            #myTabContent.tab-content.add-plan
              #home.tab-pane.fade.active.in{:role => "tabpanel"}
                = render 'self_tour_logo'

  %section.is-home-page
  .content
    .row
      .col-lg-12.col-md-12
        .bs-example.bs-example-tabs.theme-setting{"data-example-id" => "togglable-tabs"}
          #myTabContent.tab-content.add-plan
            #home.tab-pane.fade.active.in{:role => "tabpanel"}
              = render 'email_logo'     

.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %button.btn-primary.done_btn{:onclick => "logo_page_goBack()",:style => "margin-left: -15px;"}
                DONE

#crop-image.modal.fade.edit-image
#crop-secondary-logo.modal.fade.edit-image
:javascript
  function logo_page_goBack()
  {
    window.location.reload();
  }
  if (localStorage.getItem("logoCropped") == "1")
  {
    localStorage.setItem("logoCropped", "0");
    location.reload(true);
  }
  var community_id = #{params[:community_id]};
  var selected_theme = '#{@community.theme_name}';
  $(document).ready(function(e){
    if (!(#{current_user.welcome_prompt}))
    {
      $('#welcome-prompt-modal1').modal('show');
    }
  });
  if (!#{current_user.welcome_logo_page})
  {
  $('[data-toggle="primaryLogoPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="left: 123px !important;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Uploading a logo will change the logo that appears on the touchscreen and on the eBrochure.</div><div class="popover-footer"><a id="primaryLogoPopoverId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
    $('html, body').animate({ scrollTop: 200 });
  }

    $(document).on("click", "#primaryLogoPopoverId" , function(){
        $('html, body').animate({ scrollTop: 400 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="secondaryLogoPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Uploading a Home Page Logo will change the logo that appears on the home page.</div><div class="popover-footer"><a id="secondaryLogoPopoverId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#secondaryLogoPopoverId" , function(){
        $('html, body').animate({ scrollTop: 1200 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="selfLogoPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Uploading a Logo here will change the logo that appears on the splash page in the Pynwheel Tour mobile app.</div><div class="popover-footer"><a id="selfLogoPopover" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#selfLogoPopover" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        #{current_user.welcome_logo_page = true}
        #{current_user.save}
    });