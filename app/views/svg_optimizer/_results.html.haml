-# The filterable half of the list page. Rendered standalone (no layout) for
-# the live toolbar's XHR, so filtering as you type doesn't re-render the whole
-# page chrome on every keystroke.
- if properties.empty?
  .empty No eligible properties found.
- else
  %p.muted
    = "#{properties.total_entries} propert#{properties.total_entries == 1 ? 'y' : 'ies'}"
    - if properties.total_pages > 1
      = "· page #{properties.current_page} of #{properties.total_pages}"

  -# Only rows with at least one map are selectable, so the count the bulk bar
  -# shows can never promise work that has no target to act on.
  - selectable = properties.count { |row| row[:rollup][:total].to_i > 0 }

  .table-wrap
    %table
      %thead
        %tr
          %th.cb
            %input#select-page{type: "checkbox", title: "Select every selectable property on this page", disabled: selectable.zero?}
          %th Property
          %th Company
          %th Type
          %th Beans SVG
          %th Partners
          %th Maps
          %th Status
          %th
      %tbody
        - properties.each do |row|
          - community = row[:community]
          - rollup = row[:rollup]
          - has_targets = rollup[:total].to_i > 0
          %tr{"data-community-id" => community.id, "data-status-url" => svg_optimizer_status_path(community.id)}
            %td.cb
              - if has_targets
                %input.js-row-cb{type: "checkbox", value: community.id, "data-name" => community.name}
            %td
              %span.p-name= community.name.presence || "Community ##{community.id}"
            %td.p-company= community.company&.name.presence || "—"
            %td
              %span.type-tag= community.is_sitemap? ? "Site map" : "Floorplates"
            %td
              - if community.is_beans_svg?
                %span.flag.yes{title: "\"Beans Generated SVG\" is on for this property"} True
              - else
                %span.flag.no{title: "\"Beans Generated SVG\" is off for this property"} False
            %td.p-partners
              - enabled = Community::MAP_PARTNERS.select { |p| community.partner_map_enabled?(p[:key]) }
              - if enabled.any?
                - enabled.each do |p|
                  %span.ptag= p[:label]
              - else
                %span.muted —
            %td= rollup[:total]
            %td.js-status
              - if rollup[:state] == "in_progress"
                %span.pill.in_progress
                  Optimizing…
                  %span.cnt= "#{rollup[:done]}/#{rollup[:total]}"
              - elsif rollup[:state] == "partial"
                %span.pill.partial
                  Partly optimized
                  %span.cnt= "#{rollup[:done]}/#{rollup[:total]}"
              - elsif rollup[:state] == "done_with_errors"
                %span.pill.done_with_errors
                  Done with errors
                  %span.cnt= "#{rollup[:failed]} failed"
              - else
                %span.pill{class: rollup[:state]}= svg_state_label(rollup[:state])
            %td.right
              - if has_targets
                = link_to "Review & Optimize", svg_optimizer_review_path(community.id), class: "btn btn-primary"

  -# Selection is per-page (paging is a normal navigation, so checkboxes don't
  -# survive it). This banner is the cross-page escape hatch: it switches the
  -# bulk request from "these checked ids" to "everything matching the current
  -# filters", which the server re-resolves itself.
  - if properties.total_pages > 1
    #select-all-banner{style: "display:none", "data-total" => properties.total_entries}
      %span#sab-text
      %a{href: "#", id: "sab-all"}= "Select all #{properties.total_entries} properties matching these filters"
      %a{href: "#", id: "sab-clear", style: "display:none"} Clear selection

  - if properties.total_pages > 1
    .pager
      = will_paginate properties, params: { q: params[:q], company: params[:company], type: params[:type], beans: params[:beans], state: params[:state], partner: params[:partner] }
