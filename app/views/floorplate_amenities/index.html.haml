- content_for :title, "Amenities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-database
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Amenities
          .col-md-6
            .mt-35 
              %span.btn.btn-success.btn-file.pull-right.mb-20
                %i.fa.fa-plus-circle
                Add Amenity
                %input#amenity-images{:multiple => "multiple", :type => "file"}/ 
              / %a.btn.btn-success.pull-right.mb-20{:href => "/communities/#{@community.id}/floorplates/#{@floorplate.id}/amenities/new"}
              /   %i.fa.fa-plus-circle
              /   ADD AMENITY
              = link_to "Plot Amenties",plot_amenities_community_floorplate_amenities_path(@community,@floorplate), :class=>"btn btn-primary pull-right mr-5"
            .divLoading.hidden
        #images-index
          = render :partial=>'index'
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  var floorplate_id = #{@floorplate.id}

        