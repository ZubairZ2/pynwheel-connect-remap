%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Plot Amenities - Pynwheel"

- amenity_arr = []
%section.is-amenity
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-database
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code

    - locals = { is_svg: false, amenities: @amenities, community: @community, floorplate: @floorplate, current_floor: @floor, all_locks: @all_locks, current_locks_provider: @current_locks_provider, amenity_arr: amenity_arr }
    = render partial: 'floorplates/svg_or_image_amenity_plotting', locals: locals

    %br
    %h3 SVG section

    - locals[:is_svg] = true
    = render partial: 'floorplates/svg_or_image_amenity_plotting', locals: locals

= render partial: 'markers/shared/amenity_door_detail_modal', locals: { community: @community }

:javascript
  var assetTracker;
  var floor = current_floor = (#{raw @floor.present? ? @floor : "null" })
  if (current_floor === "null") {
    current_floor = null;
  }
  var unitsArr = #{raw amenity_arr.to_json}
  var mapped_units = #{raw @mapped_amenities.to_json}
  var has_floorplate = "#{@community.has_floorplates?}"

  var units_info = #{@amenity_with_doors.to_json.html_safe}
  var community_id = #{params[:community_id]}
  var floorplate_id_for_amenity = #{@floorplate.id}
  var fp_id = #{@floorplate.id}

  var self_tour = #{@community.self_tour}
  var enable_locks = #{@community.enable_locks}
  var automate_wayfinding = #{@community.auto_wayfinding}

  var addmode = false;
  var adddoorsmode = false;
  var accesspointplot = false;

  var amenity_type = "floorplate"
  hallways_coordinates = #{raw @hallways.to_json}

  $(document).ready(function () {
    $(".divLoading").removeClass("hidden");
    assetTracker = new AssetLoadingTracker({ loaderSelector: ".assetLoader" });
    parsedSVGs = [];

    const $imageZoomPan = $('#map.plot-image');
    if ($imageZoomPan[0]) {
      activateZoomPan($imageZoomPan[0], {}, true);
      const image = $imageZoomPan.find('img#viewArea')[0]
      if (image) {
        const asset = { id: `plot-image-1`,node: image, url: image.src, type: "img", completed: false };
        assetTracker.addOrUpdateAsset(asset, true);
      }
    }

    bindPlottingEvents();
    fetchSVGAndSetPlotCoordinates("amenity");
    draw_initial_hallways(hallways_coordinates)
  })

