- content_for :title, "Add Amenity - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Amenity

      = form_for @amenity,:url=>community_floorplate_amenities_path(@community,@floorplate),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'shared/amenity_form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , community_floorplate_amenities_path(@community,@floorplate), :class=>"btn btn-default pull-right"
          = f.submit "ADD AMENITY", :class=>"btn btn-success pull-right mr-10"