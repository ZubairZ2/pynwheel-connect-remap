- content_for :title, "Floorplates - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa{:class=>"#{params[:amenities].present? ? 'fa-plus-square' : 'fa-database'}"}
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    - if @amenities.present?
      = render :partial=>'floorplates'
    - else
      .row
        .col-lg-12.col-md-12
          .box.box-info.add-plan.mt-10
            .box-header
              %h3.box-title
                INTERACTIVE MAP (High Rise / Mid Rise)
          .row
            .col-md-12
              .box.box-widget.panel-box.add-plan.pt-30
                = form_tag community_save_apartment_settings_path(@community) ,{:class => 'apartment-settings-form'} do
                  = hidden_field_tag "community_id", @community.id
                  - if @community.pynwheel_touch_enabled?
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Page Name
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplatePageNamePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Changing the Page Name will change the menu label for the interactive map and dynamic floor plan gallery page in the Pynwheel app.
                      .col-sm-12.col-lg-6.col-md-6.col-xs-12
                        = text_field_tag :apartment_page_name, @community.apartment_page_name, :class=>"form-control apartment-setting-field"

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Show property map page
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateShowPropertyMapPagePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not this page appears in the Pynwheel app.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_sitemap, true, @community.display_sitemap, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_sitemap"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display floor plan gallery
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplayFloorplanGalleryPopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching display floor plan gallery will change whether or not the dynamic floor plan gallery appears in the app.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_floorplan_gallery, true, @community.display_floorplan_gallery, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_floorplan_gallery"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display on home page
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplayOnHomepagePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not there is a menu button for this page on the home page of the Pynwheel app.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_unit_on_homepage, true, @community.display_unit_on_homepage, class: "apartment-setting"
                          %label.label-primary{:for => "display_unit_on_homepage"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Price
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplaPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not pricing is displayed on the interactive property map and in the floor plan gallery.
                      
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_rent, true, @community.display_rent, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_rent"}
                          %span.pl-15 Yes

                    .form-group{ style: "display: #{'none' if @community.display_rent}" }
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Pricing Message (Optional)
                      .col-sm-12.col-lg-6.col-md-6.col-xs-12
                        = text_field_tag :pricing_message, @community.pricing_message, class: "form-control apartment-setting-field", placeholder: "Enter pricing message"

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Pricing Options (Matrix)
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplaPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not pricing options is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                      
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_pricing_options, true, @community.display_pricing_options, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_pricing_options"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Fees
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Display Fees will import any additional fees from the data feed if possible to the application.
                      
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_additional_fee, true, @community.display_additional_fee, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_additional_fee"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Manually Enter Fees
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            When "Manually Enter Fees" is toggled to "Yes" then that will override any fee information coming from the data feed.

                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_manual_additional_fee, true, @community.display_manual_additional_fee, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_manual_additional_fee"}
                          %span.pl-15 Yes

                    .form-group{style: "height: 200px"}
                      .col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        = text_area_tag :additional_fee, @community.additional_fee, class: 'form-control mb-20 wysihtml5', placeholder: 'Enter Additional Fees and Pricing'
                        .text-right
                          = button_tag 'Save', type: 'submit', class: 'btn btn-success'

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Building Number
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplayBuildingPopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not building number is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_building, true, @community.display_building, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_building"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Available date
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not available date is displayed on the interactive property map and in the floor plan gallery.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_available_date, true, @community.display_available_date, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_available_date"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display availability over 120 days
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Toggle to display units availability on all application over 120 days. Default is 'Yes'. Set to 'No' to limit availability to 120 days or less.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :units_availability_over_120_days, true, @community.units_availability_over_120_days, class: "apartment-setting-field"
                          %label.label-primary{:for => "units_availability_over_120_days"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Show property map key
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :show_property_map_key, true, @community.show_property_map_key, class: "apartment-setting-field"
                          %label.label-primary{:for => "show_property_map_key"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Property map key text
                      .col-sm-12.col-lg-6.col-md-6.col-xs-12
                        = text_field_tag :show_property_map_key_text, @community.show_property_map_key_text, :class=>"form-control apartment-setting-field"
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Show amenity key
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :show_amenity_key, true, @community.show_amenity_key, class: "apartment-setting-field"
                          %label.label-primary{:for => "show_amenity_key"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Amenity key text
                      .col-sm-12.col-lg-6.col-md-6.col-xs-12
                        = text_field_tag :show_amenity_key_text, @community.show_amenity_key_text, :class=>"form-control apartment-setting-field"

                  - elsif (@community.pynwheel_map_enabled? || @community.pynwheel_tour_enabled?)
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Price
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplaPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not pricing is displayed on the interactive property map and in the floor plan gallery.
                      
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_rent, true, @community.display_rent, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_rent"}
                          %span.pl-15 Yes
                    
                    .form-group{ style: "display: #{'none' if @community.display_rent}" }
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Pricing Message (Optional)
                      .col-sm-12.col-lg-6.col-md-6.col-xs-12
                        = text_field_tag :pricing_message, @community.pricing_message, class: "form-control apartment-setting-field", placeholder: "Enter pricing message"

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Pricing Options (Matrix)
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplaPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not pricing options is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                      
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_pricing_options, true, @community.display_pricing_options, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_pricing_options"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Fees
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Display Fees will import any additional fees from the data feed if possible to the application.
                      
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_additional_fee, true, @community.display_additional_fee, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_additional_fee"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Manually Enter Fees
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            When "Manually Enter Fees" is toggled to "Yes" then that will override any fee information coming from the data feed.
                
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_manual_additional_fee, true, @community.display_manual_additional_fee, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_manual_additional_fee"}
                          %span.pl-15 Yes
                    
                    .form-group{style: "height: 200px"}
                      .col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        = text_area_tag :additional_fee, @community.additional_fee, class: 'form-control mb-20 wysihtml5', placeholder: 'Enter Additional Fees and Pricing'
                        .text-right
                          = button_tag 'Save', type: 'submit', class: 'btn btn-success'

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Building Number
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateDisplayBuildingPopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not building number is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_building, true, @community.display_building, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_building"}
                          %span.pl-15 Yes

                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display Available date
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Switching this will change whether or not available date is displayed on the interactive property map and in the floor plan gallery.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :display_available_date, true, @community.display_available_date, class: "apartment-setting-field"
                          %label.label-primary{:for => "display_available_date"}
                          %span.pl-15 Yes
                          
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Display availability over 120 days
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                          %span#propertyDetailNameText
                            Toggle to display units availability on all application over 120 days. Default is 'Yes'. Set to 'No' to limit availability to 120 days or less.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :units_availability_over_120_days, true, @community.units_availability_over_120_days, class: "apartment-setting-field"
                          %label.label-primary{:for => "units_availability_over_120_days"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                        Show amenity key
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :show_amenity_key, true, @community.show_amenity_key, class: "apartment-setting-field"
                          %label.label-primary{:for => "show_amenity_key"}
                          %span.pl-15 Yes
                    
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Amenity key text
                      .col-sm-12.col-lg-6.col-md-6.col-xs-12
                        = text_field_tag :show_amenity_key_text, @community.show_amenity_key_text, :class=>"form-control apartment-setting-field"
                  
                  .form-group
                    .col-lg-12.col-md-12
                      %button.btn-success.done_btn.mb-20{:onclick => "floorplate_goBack()"}
                        DONE

                    = submit_tag 'Save', class: "hidden"

            .col-md-6
              .mt-35
                = link_to new_community_floorplate_path(current_community), :class=>"btn btn-success loader_class" do
                  %i.fa.fa-plus-circle
                  ADD FLOORPLATE
              .divLoading.hidden

          %h4{:style => "color: grey;"}
            %p
              Add and manage floorplates below.*
            %p
              Click on "plot units" to add unit markers to a floorplate.
            %p
              Click on "plot amenities" to add amenity images to a floorplate.
            %p
              Click on the "edit" icon to edit floorplate details.
          .box.box-widget.panel-box
            .box-header  
              .row
                .col-md-12
                  %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                    %thead
                      %tr
                        %th{:width => "79"} Sr #

                        %th Name
                        / %th Number
                        / %th Building
                        %th Range
                        %th Image
                        - if @community.mdu
                          %th Units
                        %th Amenities
                        %th
                          Actions
                          %i.additionalPageAction.fa.fa-question-circle{ "data-toggle" => "floorplateGridActionPopover","data-content" => " "}
                            %span#additionalPageActionText
                              Click the edit icon to view or change the details associated with each floorplate such as name, image, building number, and floors.
                    %tbody
                      - @floorplates.each_with_index  do |f,index|
                        - f_image = f.validated_image_url || f.validated_svg_image_url || asset_path("default.jpeg")

                        %tr{:style => "color: #{f.manual_override ? "#dd4a39": ""}"}
                          %td
                            = index+1
                          %td{:style => "color: #{f.name_is_updated ? "#dd4a39": ""}"}
                            = f.name
                          / %td
                          /   = f.number 
                          / %td{:style => "color: #{f.building_is_updated ? "#dd4a39": ""}"}
                          /   = f.building
                          %td
                            = f.range 
                          %td
                            - if f_image.present?
                              .drop-img
                                = image_tag f_image
                            - else  
                              .drop-img.drop-img-left

                          -if @community.mdu
                            %td
                              = link_to "Plot Units",community_floorplate_plotexp_path(current_community,f), :class=>"btn btn-default black-button"
                              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplatePlotUnitsPopover","data-content" => " "}
                                %span#propertyDetailNameText
                                  Add or change where unit markers appear on each floorplate. Each marker will represent the position of the unit marker on every floor. (For example, if the floorplate is for floors 2-4, units 201, 301, and 401 will be plotted at once, with one marker, and then appear on floors 2, 3, and 4 respectively.)
                          %td
                            - if f.range.include?('-')
                              = link_to community_floorplate_select_floor_path(current_community,f), remote: true do
                                %button.btn-default.black-button{"data-target" => "#select_floor", "data-toggle" => "modal"} Plot Amenities
                            - else
                              = link_to "Plot Amenities",plot_amenities_community_floorplate_amenities_path(current_community,f,floor: f.range), :class=>"btn btn-default black-button"
                            %i.additionalPageAction.fa.fa-question-circle{ "data-toggle" => "floorplatePlotAmenitiesPopover","data-content" => " "}
                              %span#additionalPageActionText
                                Add or change where amenity markers appear on each floorplate.
                          %td
                            = link_to edit_community_floorplate_path(current_community,f), :class=>"text-success" do
                              %i.fa.fa-edit.icon_size
                            %a.text-danger{"data-name"=>"Floor Plate","data-href" => "/communities/#{current_community.id}/floorplates/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash.icon_size
                                    
        / End Panel left Side
        / Start Panel Right Side
        .col-lg-4.col-md-12
          .row
            .col-md-12
  #select_floor.modal.fade.select_floor

:javascript
  $('.wysihtml5').each(function(i, elem) {
    $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
  });

  $('.apartment-setting-field').change(function(){
    $('.apartment-settings-form').submit();
  });
  
  function floorplate_goBack() {
    $('.apartment-settings-form').submit();
    window.location.reload();
  }

