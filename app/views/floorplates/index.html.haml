- content_for :title, "Floorplates - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa{:class=>"#{params[:amenities].present? ? 'fa-plus-square' : 'fa-database'}"}
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    - if @amenities.present?
      = render :partial=>'floorplates'
    - else
      .row
        / Start Panel left Side
        .col-lg-12.col-md-12
          .box.box-info.add-plan.mt-10
            .box-header
              %h3.box-title
                PROPERTY MAP PAGE (High Rise / Mid Rise)
          .row
            .col-md-12
              .box.box-widget.panel-box.add-plan.pt-30
                = form_tag community_save_apartment_settings_path(@community) ,{:class => 'apartment-settings-form'} do
                  = hidden_field_tag "community_id", @community.id
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Page Name
                    .col-sm-12.col-lg-6.col-md-6.col-xs-12
                      = text_field_tag :apartment_page_name, @community.apartment_page_name, :class=>"form-control apartment-setting-field"

                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                      Show property map/floor plans page
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .TriSea-technologies-Switch
                        %span.pr-15 No
                        = check_box_tag :show_apartment, true, @community.show_apartment, class: "apartment-setting"
                        %label.label-primary{:for => "show_apartment"}
                        %span.pl-15 Yes
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                      Display Rent
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .TriSea-technologies-Switch
                        %span.pr-15 No
                        = check_box_tag :display_rent, true, @community.display_rent, class: "apartment-setting-field"
                        %label.label-primary{:for => "display_rent"}
                        %span.pl-15 Yes
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                      Show property map page
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .TriSea-technologies-Switch
                        %span.pr-15 No
                        = check_box_tag :display_sitemap, true, @community.display_sitemap, class: "apartment-setting-field"
                        %label.label-primary{:for => "display_sitemap"}
                        %span.pl-15 Yes
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                      Display on home page
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      .TriSea-technologies-Switch
                        %span.pr-15 No
                        = check_box_tag :display_unit_on_homepage, true, @community.display_unit_on_homepage, class: "apartment-setting"
                        %label.label-primary{:for => "display_unit_on_homepage"}
                        %span.pl-15 Yes

                  = submit_tag 'Save', class: "hidden"
            -#.col-md-12
            -#  .box.box-info.add-plan.mt-10
            -#    .box-header
            -#      %h3.box-title
            -#        PROPERTY MAP PAGE (High Rise / Mid Rise)
            .col-md-6
              .mt-35
                = link_to new_community_floorplate_path(current_community), :class=>"btn btn-success mb-20" do
                  %i.fa.fa-plus-circle
                  ADD FLOORPLATE
              .divLoading.hidden
          %h4{:style => "color: grey;"}
            %p
              Add and manage floorplates below.*
            %p
              Click on "plot units" to add unit markers to a floorplate.
            %p
              Click on "plot amenities" to add amenity images to a floorplate.
            %p
              Click on the "edit" icon to edit floorplate details.
          .box.box-widget.panel-box
            .box-header  
              .row
                .col-md-12
                  %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                    %thead
                      %tr
                        %th{:width => "79"} Sr #

                        %th Name
                        / %th Number
                        %th Building
                        %th Range
                        %th Image
                        %th Units
                        %th Amenities
                        %th Actions
                    %tbody
                      - @floorplates.each_with_index  do |f,index|
                        %tr{:style => "color: #{f.manual_override ? "#dd4a39": ""}"}
                          %td
                            = index+1
                          %td{:style => "color: #{f.name_is_updated ? "#dd4a39": ""}"}
                            = f.name
                          / %td
                          /   = f.number 
                          %td{:style => "color: #{f.building_is_updated ? "#dd4a39": ""}"}
                            = f.building
                          %td
                            = f.range 
                          %td
                            - if f.image.present?
                              .drop-img.drop-img-left
                                = image_tag f.image.url
                            - else  
                              .drop-img.drop-img-left
                          %td
                            = link_to "Plot Units",community_floorplate_plotexp_path(current_community,f), :class=>"btn btn-default black-button"
                          %td
                            = link_to "Manage Amenities",plot_amenities_community_floorplate_amenities_path(current_community,f), :class=>"btn btn-default black-button"

                          %td
                            = link_to edit_community_floorplate_path(current_community,f), :class=>"text-success" do
                              %i.fa.fa-edit
                            %a.text-danger{"data-name"=>"Floor Plate","data-href" => "/communities/#{current_community.id}/floorplates/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash
                              
                            

              
                    
        / End Panel left Side
        / Start Panel Right Side
        .col-lg-4.col-md-12
          .row
            .col-md-12
:javascript
  $('.apartment-setting-field').change(function(){
    $('.apartment-settings-form').submit();
  });

  $('#show_apartment').change(function(){
    if (!($(this).is(':checked')))
    {
      $('#display_unit_on_homepage').prop('checked',false);
    }
    $('.apartment-settings-form').submit();
  });
  $('#display_unit_on_homepage').change(function(){
    if (!($('#show_apartment').is(':checked')))
    {
      $('#display_unit_on_homepage').prop('checked',false);

    }
    else
    {
      $('.apartment-settings-form').submit();
    }
  });
