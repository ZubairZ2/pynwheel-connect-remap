- content_for :title, "Floorplates - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa{:class=>"#{params[:amenities].present? ? 'fa-plus-square' : 'fa-database'}"}
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    - if @amenities.present?
      = render :partial=>'floorplates'
    - else
      .row
        / Start Panel left Side
        .col-lg-12.col-md-12
          .row
            .col-md-12
              .box.box-info.add-plan.mt-10
                .box-header
                  %h3.box-title
                    PROPERTY MAP PAGE (High Rise / Mid Rise)
            .col-md-6
              .mt-35
                = link_to new_community_floorplate_path(current_community), :class=>"btn btn-success mb-20" do
                  %i.fa.fa-plus-circle
                  ADD FLOORPLATE
              .divLoading.hidden
          %h4{:style => "color: grey;"}
            %p
              Add and manage floorplates below.*
            %p
              Click on "plot units" to add unit markers to a floorplate.
            %p
              Click on "plot amenities" to add amenity images to a floorplate.
            %p
              Click on the "edit" icon to edit floorplate details.
          .box.box-widget.panel-box
            .box-header  
              .row
                .col-md-12
                  %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                    %thead
                      %tr
                        %th{:width => "79"} Sr #

                        %th Name
                        / %th Number
                        %th Building
                        %th Range
                        %th Image
                        %th Units
                        %th Amenities
                        %th Actions
                    %tbody
                      - @floorplates.each_with_index  do |f,index|
                        %tr
                          %td
                            = index+1
                          %td
                            = f.name
                          / %td
                          /   = f.number 
                          %td
                            = f.building
                          %td
                            = f.range 
                          %td
                            - if f.image.present?
                              .drop-img.drop-img-left
                                = image_tag f.image.url
                            - else  
                              .drop-img.drop-img-left
                          %td
                            = link_to "Plot Units",community_floorplate_plotexp_path(current_community,f), :class=>"btn btn-default black-button"
                          %td
                            = link_to "Manage Amenities",plot_amenities_community_floorplate_amenities_path(current_community,f), :class=>"btn btn-default black-button"

                          %td
                            = link_to edit_community_floorplate_path(current_community,f), :class=>"text-success" do
                              %i.fa.fa-edit
                            %a.text-danger{"data-name"=>"Floor Plate","data-href" => "/communities/#{current_community.id}/floorplates/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash
                              
                            

              
                    
        / End Panel left Side
        / Start Panel Right Side
        .col-lg-4.col-md-12
          .row
            .col-md-12       