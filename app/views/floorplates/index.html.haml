- content_for :title, "Floor Plates - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa{:class=>"#{params[:amenities].present? ? 'fa-plus-square' : 'fa-database'}"}
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    - if @amenities.present?
      = render :partial=>'floorplates'
    - else
      .row
        .col-md-12
          .box.box-widget.panel-box.add-plan.pt-30
            = form_tag community_save_apartment_settings_path(@community) ,{:class => 'apartment-settings-form'} do
              = hidden_field_tag "community_id", @community.id
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Page Name
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :apartment_page_name, @community.apartment_page_name, :class=>"form-control apartment-setting-field" ,:maxlength=>"13"
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Show this page
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :show_apartment, true, @community.show_apartment, class: "apartment-setting-field"
                    %label.label-primary{:for => "show_apartment"}
                    %span.pl-15 Yes      
              = submit_tag 'Save', class: "hidden"
      .row
        / Start Panel left Side
        .col-lg-12.col-md-12
          .row
            .col-md-6
              %h4.title Floor Plates
            .col-md-6
              .mt-35
                = link_to new_community_floorplate_path(current_community), :class=>"btn btn-success pull-right mb-20" do 
                  %i.fa.fa-plus-circle
                  ADD FLOOR PLATE
              .divLoading.hidden
          .box.box-widget.panel-box
            .box-header  
              .row
                .col-md-12
                  %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                    %thead
                      %tr
                        %th{:width => "79"} Sr #

                        %th Name
                        / %th Number
                        %th Building
                        %th Range
                        %th Image
                        %th Units
                        %th Amenities
                        %th Actions
                    %tbody
                      - @floorplates.each_with_index  do |f,index|
                        %tr
                          %td
                            = index+1
                          %td
                            = f.name
                          / %td
                          /   = f.number 
                          %td
                            = f.building
                          %td
                            = f.range 
                          %td
                            - if f.image.present?
                              .drop-img.drop-img-left
                                = image_tag f.image.url
                            - else  
                              .drop-img.drop-img-left
                          %td
                            = link_to "Plot Now",community_floorplate_plotexp_path(current_community,f), :class=>"btn btn-default black-button" 
                          %td
                            = link_to "Amenties",plot_amenities_community_floorplate_amenities_path(current_community,f), :class=>"btn-info btn-xs mr-5"

                          %td
                            = link_to edit_community_floorplate_path(current_community,f), :class=>"text-success" do
                              %i.fa.fa-edit
                            %a.text-danger{"data-name"=>"Floor Plate","data-href" => "/communities/#{current_community.id}/floorplates/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash
                              
                            

              
                    
        / End Panel left Side
        / Start Panel Right Side
        .col-lg-4.col-md-12
          .row
            .col-md-12

:javascript

  $('.apartment-setting-field').change(function(){
    $('.apartment-settings-form').submit();
  });        