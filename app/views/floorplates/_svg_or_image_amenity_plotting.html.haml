- if community.theme_name.include?('gables')
  - map_marker_color = community.design.amenity_map_marker_color.present? ? community.design.amenity_map_marker_color : "#d37474"
- elsif community.theme_name == 'modernist'
  - map_marker_color = community.design.modernists_amenity_map_marker_color == 'no color' || community.design.modernists_amenity_map_marker_color == '' ? (community.design.primary_color.present? ? community.design.primary_color : '#cf492f') : community.design.modernists_amenity_map_marker_color
- elsif community.theme_name == 'futurist'
  - map_marker_color = community.design.futurist_amenity_map_marker_color.present? ? community.design.futurist_amenity_map_marker_color : "#d37474"
- elsif community.theme_name == 'expressionist'
  - map_marker_color = community.design.expressionist__amenity_map_marker_color.present? ? community.design.expressionist__amenity_map_marker_color : "#d37474"
- elsif community.theme_name == 'panther'
  - map_marker_color = community.design.panther_amenity_map_marker_color.present? ? community.design.panther_amenity_map_marker_color : "#d37474"
- else
  - map_marker_color = 'rgba(247, 0, 0, 0.61)'

- if community.theme_name.include?('gables')
  - fontsize = community.design.amenity_map_marker_size_integer.present? ? community.design.amenity_map_marker_size_integer : 30
- elsif community.theme_name == 'modernist'
  - fontsize = community.design.modernist_amenity_map_size.present? ? community.design.modernist_amenity_map_size : 30
- elsif community.theme_name == 'futurist'
  - fontsize = community.design.futurist_amenity_map_size.present? ? community.design.futurist_amenity_map_size : 30
- elsif community.theme_name == 'expressionist'
  - fontsize = community.design.expressionist_amenity_map_size.present? ? community.design.expressionist_amenity_map_size : 30
- elsif community.theme_name == 'panther'
  - fontsize = community.design.panther_amenity_map_size.present? ? community.design.panther_amenity_map_size : 30
- else
  - fontsize = 30

- left_margin       = 13
- top_margin        = 13
- fontsize          = fontsize -5
- camera_font_size  = fontsize / 2
- marker_font_size2 = fontsize
- camera_margin     = (marker_font_size2 <= 27 ? 3 : (marker_font_size2 <= 30 ? 4 : (marker_font_size2 <= 33 ? 5 : (marker_font_size2 <= 35 ? 6 : 6))))
- door_fontsize     = fontsize
- door_marker_color = "#3153d2"

%span.hidden#active_x_plot      0
%span.hidden#active_y_plot      0
%span.hidden#left_margin        #{left_margin}
%span.hidden#top_margin         #{top_margin}
%span.hidden#font_size          #{fontsize}
%span.hidden#marker_color       #{map_marker_color}
%span.hidden#camera_margin      #{camera_margin}
%span.hidden#door_fontsize      #{door_fontsize}
%span.hidden#door_marker_color  #{door_marker_color}

%h4{:style => "color: grey;"}
  %p
    Select amenity images to add a marker to the map. If nothing appears in the list, then there are no additional amenity images to add.
  - unless is_svg
    %p
      Drag and drop markers to reposition them on the property map.
  %p
    Click "Plot Units" to switch to plot units on the map.
.box.box-info.add-plan
  .box-header{ id: is_svg ? "svg_header" : "image_header" }
    %h3.box-title
      Plot
      %span= floorplate.name + " Amenities"

    .btn-btn-danger.mt-10
      = link_to "Back",community_floorplate_amenities_path(community, floorplate), :class=>"btn btn-primary mr-5 hidden" 
      = link_to "ADD AMENITY IMAGES", community_amenities_path(community), class: "btn btn-primary"
      %a.btn.btn-danger{"data-name" => "floorplate's amenities plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{community.id}/floorplates/#{floorplate.id}/amenities/remove_amenities_plot#{ is_svg ? (params[:floor].present? ? ('?floor=' + params[:floor].to_s + '&svg_deletion=true') : '?svg_deletion=true') : (params[:floor].present? ? ('?floor=' + params[:floor].to_s) : '') }"} RESET ALL PLOTS

  / form start
  = render partial: 'shared/hidden_locks_data', locals: { community: community, all_locks: all_locks, locks_present_hash: current_locks_provider }

  %form.form-horizontal
    .box-body.map-body-top
      .row.style{ style: "display: flex;" }
        .col-lg-9.p-0{ id: is_svg ? "svg-container" : "image-container" }
          = render partial: 'shared/zoom_control_buttons'
          - svg_data = svg_image_url_and_dimensions(floorplate) if is_svg
          .map-block{ style: "position: relative; #{svg_data && svg_data.values_at(:width, :height).sum.zero? ? 'display: flex; justify-content: center; align-items: center;' : ''}" }
            .assetLoader.hidden
            .plot-image{data: svg_data, id: is_svg ? 'svg_map' : 'map', style: "position: relative" }
              - if is_svg
                - unless floorplate.svg_image.present?
                  = image_tag "default.jpeg", id: "map_img", name: "viewArea", id: "viewArea", draggable: "false", class: 'viewArea', data: { 'map_id' => "map" }
              - else
                - width, height = image_original_dimensions(floorplate).values
                = image_tag (floorplate.validated_image_url || "default.jpeg"), name: "viewArea", id: "viewArea", draggable: "false", class: 'viewArea', data: { map_id: "map", height: height, width: width }

                - coordinates_array = []
                - amenities.where(floor: [current_floor, nil]).each do |amenity|
                  - x_plot, y_plot = coords = [amenity.x_plot, amenity.y_plot].map(&:to_i)
                  - if coords.sum.positive?
                    - unless coordinates_array.include?(coords)
                      - coordinates_array.push(coords)

                      %p{class: "marker", style: "left:#{x_plot - left_margin}px; top:#{y_plot - top_margin}px; position:absolute"}
                        = link_to "javascript:void(0);", :id => "m_#{amenity.id}", :title => amenity.name, data: {toggle: "tooltip", name: "plot", target: "#confirm-delete", toggle: "modal", href: "/communities/#{community.id}/floorplates/#{floorplate.id}/amenities/#{amenity.id}/remove_amenity?floor=#{current_floor}", plotted_category: "amenity"} do
                          %i{class: "custom-icon", style: "height:#{fontsize}px; width: #{fontsize}px; border: 2px solid  #{map_marker_color};"}
                            %i{class: "fas fa-camera-retro", style: "font-size:#{camera_font_size}px; color: #{map_marker_color}; margin-top: #{camera_margin}px;"}
                        
                        - if community.self_tour and community.auto_wayfinding
                          = link_to "javascript:void(0);", { id: "plus_#{amenity.id}", title:  "Click to plot this amenity door", data: {toggle: "tooltip", plotted_category: "create_amenity_door"}, onclick: 'plot_entry_point(event)'} do
                            %i{class: "fa fa-plus-circle fa-xs", style: "color: #59de83; font-size: #{fontsize/1.8}px;" }
                      
                      - if community.self_tour and community.auto_wayfinding
                        - amenity.ordered_doors.each do |door|
                          = link_to "javascript:void(0);", { id: "amenity_#{amenity.id}__door_#{door.id}", class: "marker", style: "left:#{door.x_plot}px; top:#{door.y_plot}px; position:absolute; font-size: #{door_fontsize}px", title: "#{door.name}", data: {door_id: "#{door.id}", toggle: "tooltip", toggle: "modal", target: "#amenity-door-detail-modal", plotted_category: "amenity_door"}, onclick: 'open_amenity_door_modal(event)'} do
                            %i{class: "fa fa-sign-in fa-xs", style: "color: #{door_marker_color};"}

                    - else
                      - puts "duplicated.........."
        .col-lg-3.multi-select-units{ class: is_svg ? "select-units-on-svg" : "select-units-on-page" }
          %h5.mt-40.mb-20 SELECT AMENITIES TO PLOT
          .imageselect
            .show-categories
              = "-- select image --"
            %ul#imageselect.disabled{:style => "display: none;"}
              - amenities.each do |amenity|
                - x_plot, y_plot = coords = (is_svg ? (amenity.svg_coordinates) : [amenity.x_plot, amenity.y_plot].map(&:to_i))
                - if coords.sum.zero?
                  %li{"data-id" => "#{amenity.id}","data-name" => "#{amenity.name}"}
                    %a
                      = image_tag amenity.image.present? ? amenity.image.url : "upload-image.png"
                      %span.ml-5
                        = amenity.name
                - amenity_arr.push({ providerId: amenity.id.to_s, xPlot: x_plot, yPlot: y_plot, name: amenity.name, svgPoint: is_svg })

          %h5.mt-40 SELECTED AMENITY
          .add-plan.mt-10.mb-20
            %ul#selected-units
          / %button.btn.btn-success#new{:type => "button"} PLOT NOW
          %label#newmsg Place marker for selected amenity on Map
    #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
      %i.icon-screenshot


:javascript
  var left_margin = #{raw left_margin}
  var top_margin = #{raw top_margin}
  var svgMode = false;

  $(document).ready(function() {
    map_marker_color = toRgbColor("#{raw map_marker_color}")
  });

:css
  @media (max-width: 1200px) {
    .map-body-top > div.row {
      flex-direction: column-reverse;
    }
  }

  .overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background-color: #fff;
    opacity: .9;
    display:none;
  }
