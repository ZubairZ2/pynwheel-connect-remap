.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Manual Override

  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :manual_override, true
    = f.label :manual_override, "Yes"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :manual_override, false
    = f.label :manual_override, "No"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floorplate Name
    %span Specify name here (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Floorplate Name",:maxlength=>"30"
/ .form-group
/   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
/     Number
/     %span Specify number here
/   .col-sm-12.col-lg-9.col-md-9.col-xs-12
/     = f.text_field :number, :class=>"form-control validate[required,custom[onlyNumber]]", :placeholder=>"Number",:maxlength=>"4"
/.form-group
/  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
/    Building
/    %span Specify building info here (Manual Override Required)
/  .col-sm-12.col-lg-9.col-md-9.col-xs-12
/    = f.text_field :building, :class=>"form-control", :placeholder=>"Building",:maxlength=>"4"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Range
    %span Enter the range of floors this floorplate covers
  .col-sm-12.col-lg-9.col-md-9.col-xs-12

    = f.text_field :range, :class=>"form-control validate[required,custom[onlyRange]]", :placeholder=>"Range",:maxlength=>"20"
    %small Valid formats: '3' one floor, '3-10' range, '3,5,7,[...]' for specific floors
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
    Add floor name
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :floor_name_added
      %label.label-primary{:for => "floorplate_floor_name_added"}
      %span.pl-15 Yes
.form-group#floor-name-field.hidden
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor name
    %span Enter name of floor
  .col-sm-12.col-lg-9.col-md-9.col-xs-12

    = f.text_field :floor_name, :class=>"form-control", :placeholder=>"Enter floor name",:maxlength=>"3"
    %small Enter floor names B1,B2,B3 etc
.form-group.hidden
  %label.col-sm-12.col-lg-12.col-md-3.col-xs-12.control-label
    %p.text-warning
      Please upload image or svg of dimensions 1412x932 for best results.      
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      floorplate.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .image-box.video-box
      .images.height-200
        %a.preview-image{:href=>f.object.image.present? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Floorplate Image"}
          = image_tag f.object.image? ? f.object.image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-image", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :image

.form-group.hidden
  %label.col-sm-12.col-lg-12.col-md-3.col-xs-12.control-label
    %p.text-warning
      Please upload SVG here.
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload SVG
    %span
      Upload SVG of this
      %br/
      floorplate.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .svg-box.video-box
      .images.height-200
        %a.preview-svg{:href=>f.object.svg_image.present? ? f.object.svg_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Floorplate SVG"}
          = image_tag f.object.svg_image? ? f.object.svg_image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-svg", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :svg_image

:javascript
  var floorplate_floor_name_added = #{@floorplate.floor_name_added}
  $('#floorplate_floor_name_added').change(function(){
    if($(this).is(':checked')){
      $('#floor-name-field').removeClass('hidden');
    }
    else{
      $('#floor-name-field').addClass('hidden');
    }
  });

  if(floorplate_floor_name_added)
    $('#floor-name-field').removeClass('hidden');  