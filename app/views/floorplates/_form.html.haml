.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plate Name
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Floor Plate Name",:maxlength=>"30"
/ .form-group
/   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
/     Number
/     %span Specify number here
/   .col-sm-12.col-lg-9.col-md-9.col-xs-12
/     = f.text_field :number, :class=>"form-control validate[required,custom[onlyNumber]]", :placeholder=>"Number",:maxlength=>"4"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Building
    %span Specify building info here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :building, :class=>"form-control validate[required]", :placeholder=>"Building",:maxlength=>"4"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Range
    %span Enter the range of floors this floorplate covers
  .col-sm-12.col-lg-9.col-md-9.col-xs-12

    = f.text_field :range, :class=>"form-control validate[required]", :placeholder=>"Range",:maxlength=>"4"
    %small Valid formats: '3' one floor, '3-10' range, '3,5,7,[...]' for specific floors
.form-group.hidden
  %label.col-sm-12.col-lg-12.col-md-3.col-xs-12.control-label
    %p.text-warning
      Please upload image or svg of dimensions 1412x932 for best results.      
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      floor plate.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img
        %a.preview-image{:href=>f.object.image.present? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Floor Plate Image"}
          = image_tag f.object.image? ? f.object.image.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :image     