- content_for :title, "Add Floorplate - Pynwheel"
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-database
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    %h4{:style => "color: grey;"}
      %p
        To change the image of the floorplate, upload a new image/SVG here. Please note that images that are too small may appear pixelated.
    .box.box-widget.panel-box.alert-danger
      %h5{style: "margin-left: 15px; margin-top: 0px;"}
        Note: If the new image uploaded is not the exact same dimensions as the existing image, the unit and amenity markers will not be in the correct place on the map.
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Add 
          %span Floorplate
      / /.box-header
      / form start
      / <form class="form-horizontal">
      = form_for @floorplate,:url=>community_floorplates_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , community_floorplates_path(current_community), :class=>"btn btn-default pull-right"
          = f.submit "ADD FLOORPLATE", :class=>"btn btn-success pull-right mr-10 loader_class"


:javascript

  $("#floorplate_image, #floorplate_svg_image").change(function(){
      readImageIncludingSVG(this);
  });
