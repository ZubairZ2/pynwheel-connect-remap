              %button.btn.btn-success
                Add Access Point
                %i.propertyDetailName.fa.fa-question-circle
                  %span#propertyDetailNameText{:style => "font-weight: normal;"}
                    Add Access point in hallways that are not associated with any specific unit or amenity- if @community.enable_locks and @community.self_tour and @community.auto_wayfinding
          - if false && @community.self_tour and @community.auto_wayfinding
            %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'automate_path()'}Automate Path

      = render :partial=>'shared/hidden_locks_data',locals: {community: @community, all_locks: @all_locks, locks_present_hash: @current_locks_provider}
      %form.form-horizontal
        .box-body.map-body-top
          .row
            .col-lg-9#container.p-0
              .buttons{:style=>"position: absolute; right: 20px; top: 5px;z-index:999;"}
                %a.btn.btn-sm.btn-primary.zoom-in.zoom-controls
                  %i.fa.fa-plus
                %a.btn.btn-sm.btn-primary.zoom-out.zoom-controls
