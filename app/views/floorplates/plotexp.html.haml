%script{:src => "https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js"}
%script{:src => "https://cdnjs.cloudflare.com/ajax/libs/jquery-mousewheel/3.1.13/jquery.mousewheel.min.js"}
%script{:src => "https://timmywil.com/panzoom/demo/panzoom.js"}
= render '/font_awesome_v5'
- content_for :title, "Plot Unit - Pynwheel"
.divLoading.hidden
%section.is-floorplate
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-database
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    %h4{:style => "color: grey;"}
      %p
        Select units to add a marker to the floorplate. If nothing appears in the list, then there are no additional units to add.
      %p
        Drag and drop markers to reposition them on the property map.
      %p
        Click "Grid" to add a grid overlay to the map to make positioning the plots easier.
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot

          - if @community.theme_name.include?('gables')
            - marker_color = @community&.design&.property_map_color || "#d37474"
          - elsif @community.theme_name == 'modernist'
            - marker_color = ( ['no color', ''].include?(@community&.design&.modernist_map_marker_color) ) ? (@community&.design&.primary_color || '#cf492f') : @community&.design&.modernist_map_marker_color
          - elsif @community.theme_name == 'futurist'
            - marker_color = @community&.design&.futurist_property_map_marker_color || "#d37474"
          - elsif @community.theme_name == 'expressionist'
            - marker_color = @community&.design&.expressionist_property_map_marker_color || "#d37474"
          - elsif @community.theme_name == 'panther'
            - marker_color = @community&.design&.panther_property_map_marker_color || "#d37474"
          - else
            - marker_color = 'rgba(247, 0, 0, 0.61)'
          -#-
          - if @community.theme_name.include?('gables')
            - fontsize =@community&.design&.property_map_size_integer || 30
          - elsif @community.theme_name == 'modernist'
            - fontsize = @community&.design&.modernist_property_map_size || 30
          - elsif @community.theme_name == 'futurist'
            - fontsize = @community&.design&.futurist_property_map_size || 30
          - elsif @community.theme_name == 'expressionist'
            - fontsize = @community&.design&.expressionist_property_map_size || 30
          - elsif @community.theme_name == 'panther'
            - fontsize = @community&.design&.panther_property_map_size || 30
          - else
            - fontsize = 30

          - left_margin = ((@community.design.property_map_size_integer.to_f - 25) / 2.0).to_i
          - right_margin = ((20.0 / 25.0).to_f * (@community.design.property_map_size_integer)).to_i

          %span.hidden#left_margin #{left_margin}
          %span.hidden#right_margin #{right_margin}
          %span.hidden#font_size #{fontsize}
          %span.hidden#marker_color #{marker_color}

          - door_fontsize     = fontsize
          - door_marker_color = "#3153d2"

          %span.hidden#door_fontsize #{door_fontsize}
          %span.hidden#door_marker_color #{door_marker_color}

          %span= @floorplate.name + " Units"
          %span.hidden#active_x_plot 0

          %span.hidden#active_y_plot 0
          %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnFloorplatePopover","data-content" => " "}
            %span#propertyDetailNameText
              Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.


        .btn-btn-danger.mt-10
          = link_to "ADD AMENITY IMAGES  <i class='propertyDetailName fa fa-question-circle' data-toggle='floorplateManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Click on 'Manage Amenities' to switch from plotting units to uploading and plotting amenity images.</span></i>".html_safe, community_amenities_path(@community), class: "btn btn-primary loader_class"
          %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>"showHideOverlayGrid();"}
            Grid Overlay
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplateGridOverlayPopover","data-content" => " "}
              %span#propertyDetailNameText{:style => "font-weight: normal;"}
                Add a grid overlay to the map to make it easier to see if the markers are straight.
          
          - if !@floorplate.is_ocr_enabled
            = link_to "Enable Suggestions <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Enabling suggestions will highlight possible matches on the map when units are selected from the list. You still have to click on the map to plot the marker for each unit/unit group.</span></i>".html_safe , "/communities/#{@community.id}/suggest_floorplate_units?floorplate_id=#{@floorplate.id}&&is_ocr_enabled=#{!@floorplate.is_ocr_enabled}" , :class=>"btn btn-success loader_class"
          - else 
            = link_to "Disable Suggestions <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Enabling suggestions will highlight possible matches on the map when units are selected from the list. You still have to click on the map to plot the marker for each unit/unit group.</span></i>".html_safe , "/communities/#{@community.id}/suggest_floorplate_units?floorplate_id=#{@floorplate.id}&&is_ocr_enabled=#{!@floorplate.is_ocr_enabled}" , :class=>"btn btn-success loader_class enable-suggestions-btn"
          
          - if current_user.is_super_admin?
            = link_to "Auto Plot <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Use Auto-plotting to add markers only when unit names in list and on map match exactly. All markers will be automatically added to the map.</span></i>".html_safe , "/communities/#{@community.id}/floorplate_auto_plot_units?floorplate_id=#{params[:floorplate_id]}", :class=>"btn btn-success loader_class"

            %a.btn.btn-danger{"data-name" => "floorplate's plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/remove_plots_from_floorplate?floorplate_id=#{params[:floorplate_id]}"} Reset all plots
          - if @community.self_tour and @community.auto_wayfinding
            %button.btn.btn-primary.grid-overlay{:type=>"button",id:"hallway_btn",:onclick=>'plotting_hallways($(this))'}Start Plotting Hallways
          - if false && @community.enable_locks and @community.self_tour and @community.auto_wayfinding
