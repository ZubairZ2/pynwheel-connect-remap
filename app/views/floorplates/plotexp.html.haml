%script{:src => "https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js"}
%script{:src => "https://cdnjs.cloudflare.com/ajax/libs/jquery-mousewheel/3.1.13/jquery.mousewheel.min.js"}
%script{:src => "https://timmywil.com/panzoom/demo/panzoom.js"}
= render '/font_awesome_v5'
- content_for :title, "Plot Unit - Pynwheel"

- units_arr = []
.divLoading.hidden
%section.is-floorplate
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-database
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code

    - locals = { is_svg: false, units: @floorplate_units || [], units_by_plotted_doors_order: @floorplate_units_by_plotted_doors_order || [], community: @community, floorplate: @floorplate, all_locks: @all_locks, current_locks_provider: @current_locks_provider, access_points: @access_points, current_user: current_user, units_arr: units_arr }
    = render partial: 'floorplates/svg_or_image_unit_plotting', locals: locals

    %br
    %h3 SVG section

    - locals[:is_svg] = true
    = render partial: 'floorplates/svg_or_image_unit_plotting', locals: locals

#ocrData{data: {ocr_data: @map_ocr_data.to_json, image_dimensions: @dimensions.to_json}}


:javascript
  var assetTracker;
  var multi_floors;
  var unitsArr = #{raw units_arr.to_json}
  var units_info = #{@unit_with_door.to_json.html_safe}
  var mapped_units = #{raw @mapped_units.to_json}
  var access_points = #{@access_points.to_json.html_safe}
  var building_starting_point = {x_plot: #{@community.community_tour.x_plot.to_json.html_safe}, y_plot: #{@community.community_tour.y_plot.to_json.html_safe} };

  var community_id = #{params[:community_id]}
  var floorplate_id = #{params[:floorplate_id]}

  var self_tour = #{@community.self_tour}
  var enable_locks = #{@community.enable_locks}
  var isBeansSvg = #{@community.is_beans_svg}
  var automate_wayfinding = #{@community.auto_wayfinding}

  var addmode = false;
  var adddoorsmode = false;
  var accesspointplot = false;

  var fp_id = #{params[:floorplate_id]}
  hallways_coordinates = #{raw @hallways.to_json}

  $(document).ready(function () {
    $(".divLoading").removeClass("hidden");
    assetTracker = new AssetLoadingTracker({ loaderSelector: ".assetLoader" });
    parsedSVGs = [];

    $('.wysihtml5').each(function(i, elem) {
      $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
    });

    if (#{current_user.welcome_floorplate_plot_page}) {
      $('[data-toggle="plotUnitOnFloorplatePopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.</div><div class="popover-footer"><a id="propertyDetailNameId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    }

    $(document).on("click", "#propertyDetailNameId" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');
      $('[data-toggle="floorplateManageAmenitiesPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding"  style="color: ;">Click on "Manage Amenities" to switch from plotting units to uploading and plotting amenity images.</div><div class="popover-footer"><a id="siteShowPropertyMapPagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#siteShowPropertyMapPagePopoverClose" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');
      $('[data-toggle="floorplateGridOverlayPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Add a grid overlay to the map to make it easier to see if the markers are straight.</div><div class="popover-footer"><a id="sitemapDisplayFloorplanGalleryPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#sitemapDisplayFloorplanGalleryPopoverClose" , function(){
      $('html, body').animate({ scrollTop: 200 });
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');
      $('[data-toggle="floorplateSelectPlotToUnitsPopover"]').popover({
        placement: 'left',
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">You can select one or multiple units to plot in one position (with one marker) on the map. If no units appear in the list, that means that all units that have been imported or entered have already been plotted on the map.</div><div class="popover-footer"><a id="sitempaDisplayHomepagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
      showHideOverlayGrid(document.querySelector('#map.plot-image'));
    });
    
    $(document).on("click", "#sitempaDisplayHomepagePopoverClose" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');
      #{current_user.welcome_floorplate_plot_page = false}
      #{current_user.save}
    });

    const $imageZoomPan = $('#map.plot-image');
    if ($imageZoomPan[0]) {
      activateZoomPan($imageZoomPan[0]);
      const image = $imageZoomPan.find('img#viewArea')[0]
      if (image) {
        const asset = { id: "plot-image-1", node: image, url: image.src, type: "img", completed: false };
        assetTracker.addOrUpdateAsset(asset, true);
      }
    }

    bindPlottingEvents();
    fetchSVGAndSetPlotCoordinates("unit", isBeansSvg);
    draw_initial_hallways(hallways_coordinates);
  })

