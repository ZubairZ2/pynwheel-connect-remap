                        - left = unit.x_plot - left_margin
                        - right = unit.y_plot - right_margin

                        %p{class: "marker", style: "left:#{unit.x_plot - left_margin }px; top:#{unit.y_plot - right_margin}px; position:absolute"}
                          = link_to "javascript:void(0);", { id: "m_#{unit.provider_unit_id}", style: "font-size: #{fontsize}px", data_provider: @community.data_provider, provider_unit_id: unit.provider_unit_id, title: (unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, data: {toggle: "tooltip", toggle: "modal", name: "plot", target: "#markers-modal", href: "/communities/#{@community.id}/units/#{unit.provider_unit_id}/remove_plot_from_floorplate?floorplate_id=#{params[:floorplate_id]}", horizontal: unit.x_plot, vertical: unit.y_plot, unit_form_url: "/communities/#{current_community.id}/units/#{unit.id}/adjust_position", plotted_category: "unit"}} do
                            %i{class: "fas fa-map-marker-alt", style: "color: #{marker_color};"}

                          - if !unit_door_exists and @community.self_tour and @community.auto_wayfinding
                            = link_to "javascript:void(0);", { id: "plus_#{unit.provider_unit_id}", style: "margin-left: -6px;", data_provider: @community.data_provider, provider_unit_id: unit.provider_unit_id, title:  "Click to plot this unit(s) door", data: {toggle: "tooltip", plotted_category: "create_unit_door"}, onclick: 'plot_entry_point(event)'} do
                              %i{class: "fa fa-plus-circle fa-xs", style: "color: #59de83; font-size: #{fontsize/2}px;" }
                            - unit_door_exists = false

                        - if unit_door_exists and @community.self_tour and @community.auto_wayfinding
                          - unit_door = unit.door
                          = link_to "javascript:void(0);", { id: "door_#{unit.provider_unit_id}", class: "marker", style: "left:#{unit_door.x_plot}px; top:#{unit_door.y_plot}px; position:absolute; font-size: #{door_fontsize}px", data_provider: @community.data_provider, provider_unit_id: unit.provider_unit_id, title: "#{unit_door.name}", data: {door_id: "#{unit_door.id}", toggle: "tooltip", toggle: "modal", target: "#ajax-doors-detail-modal", plotted_category: "unit_door"}} do
                            %i{class: "fa fa-sign-in fa-xs", style: "color: #{door_marker_color};"}

                      - else
                        - puts "duplicated.........."
                      .hidden{:class=>"h-#{unit.x_plot }-#{unit.y_plot}", :id=>"h-#{unit.provider_unit_id}","data-title"=>(unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, "data-name" => "plot", "data-href" => "/communities/#{@community.id}/units/#{unit.provider_unit_id}/remove_plot_from_floorplate?floorplate_id=#{params[:floorplate_id]}","data-unit-form-url"=>"/communities/#{current_community.id}/units/#{unit.id}/adjust_position"}

                  - if @community.enable_locks and @community.self_tour and @community.auto_wayfinding
                    - coordinates_array = []

                    - @access_points.each do |access_point|
                      - unless coordinates_array.include?([access_point.x_plot, access_point.y_plot])
                        - coordinates_array.push([access_point.x_plot, access_point.y_plot])

                        = link_to open_access_point_modal_community_floorplate_access_point_path(@community, @floorplate, access_point, x_plot: access_point.x_plot, y_plot: access_point.y_plot, plotted_id: access_point.id, locks_present_hash: @current_locks_provider.to_json), { id: "access_point_#{access_point.id}", class: "marker", style: "left:#{access_point.x_plot}px; top:#{access_point.y_plot}px; position:absolute; font-size: #{door_fontsize/2}px", title: "#{access_point.name}", data: {door_id: "#{access_point.id}", toggle: "tooltip", remote: true, plotted_category: "access_point"}} do
                          %i{class: "fa fa-lock", style: "color: #66bf60"}

            .col-lg-3.multi-select-units.select-units-on-page
              %h5.mt-40.mb-20
                SELECT UNITS TO PLOT
