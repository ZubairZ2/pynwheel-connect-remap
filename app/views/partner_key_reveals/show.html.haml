!!!
%html{ lang: "en" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    -# The key must never end up in a referrer, a proxy cache or a history entry.
    %meta{ name: "referrer", content: "no-referrer" }
    %meta{ name: "robots", content: "noindex, nofollow" }
    %title Your Pynwheel API key
    :css
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; padding: 40px 16px; background: #f4f6f8;
             font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
             color: #1f2d3d; }
      .card { max-width: 620px; margin: 0 auto; background: #fff; border-radius: 10px;
              box-shadow: 0 2px 14px rgba(16, 32, 56, .10); padding: 32px; }
      h1 { margin: 0 0 6px; font-size: 21px; font-weight: 600; }
      .sub { margin: 0 0 26px; color: #6b7a90; font-size: 14px; line-height: 1.5; }
      .key-row { display: flex; gap: 8px; align-items: stretch; }
      .key { flex: 1; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
             font-size: 14px; background: #f7f9fb; border: 1px solid #dfe5ec; border-radius: 6px;
             padding: 13px 14px; word-break: break-all; color: #12233b; }
      button { border: 0; border-radius: 6px; background: #2f7fe0; color: #fff; font-size: 14px;
               font-weight: 500; padding: 0 18px; cursor: pointer; white-space: nowrap; }
      button:hover { background: #2668b8; }
      .warn { margin-top: 22px; padding: 13px 15px; border-radius: 6px; font-size: 13px; line-height: 1.55;
              background: #fff6e5; border: 1px solid #f2dcae; color: #74521a; }
      .expired { text-align: center; padding: 14px 0 4px; }
      .expired .icon { font-size: 38px; line-height: 1; }
      .expired h1 { margin-top: 14px; }
      .usage { margin-top: 26px; border-top: 1px solid #edf1f5; padding-top: 20px; }
      .usage h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: #6b7a90; margin: 0 0 10px; }
      pre { margin: 0; background: #12233b; color: #d8e4f2; border-radius: 6px; padding: 14px;
            font-size: 12.5px; overflow-x: auto; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  %body
    .card
      - if @expired
        .expired
          .icon 🔒
          %h1 This link has already been used
          %p.sub
            An API key link can only be opened once, and expires after 72 hours.
            Ask your Pynwheel contact to issue a new one.
      - else
        %h1 Your Pynwheel Partner API key
        %p.sub
          Copy this key and store it somewhere safe, such as your secret manager.
          It cannot be shown again.
        .key-row
          .key#apiKey= @api_key
          %button#copyBtn{ type: "button" } Copy
        .warn
          %strong This page works only once.
          Refreshing or reopening the link will not show the key again. Treat it like a
          password — anyone holding it can call the Pynwheel Partner API as you.
        .usage
          %h2 Using the key
          %pre
            :preserve
              curl -H "X-API-Key: #{@api_key}" \
                https://#{request.host_with_port}/api/partner/maps/properties
        :javascript
          (function () {
            var btn = document.getElementById('copyBtn');
            var key = document.getElementById('apiKey').textContent;
            btn.addEventListener('click', function () {
              navigator.clipboard.writeText(key).then(function () {
                btn.textContent = 'Copied';
                setTimeout(function () { btn.textContent = 'Copy'; }, 1800);
              });
            });
          })();
