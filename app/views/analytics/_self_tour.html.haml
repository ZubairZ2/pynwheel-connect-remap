.box.box-info.add-plan.mt-20
  .box-header
    %h3.box-title
      Pynwheel Tour
      %span Analytics
    %h3.box-title.align-right
      Tours
      %span= @date_range_text
  .box-body.maps-box
    - if @self_tour_records.any?
      .row
        .col-lg-6.col-md-12.h-500
          .chart-title
            %p.chart_heading Tours
            = render 'title_info', {info_text: SELF_TOUR_TOURS_INFO }

          .col-lg-4.numbers_div
            .center_it
              .count_int= @track_session_count_self_tour
              .count_text= 'Total number of tours'
              .count_int= @avg_track_session_self_tour
              .count_text= 'Average number of tours per day'
          .col-lg-8
            = bar_chart @session_each_day_data_self_tour, @session_each_day_options_self_tour

        .col-lg-6.col-md-12.h-500
          .chart-title
            %p.chart_heading Tour Duration
            = render 'title_info', {info_text: SELF_TOUR_TOURS_DURATION }
          .col-lg-4.numbers_div
            .center_it
              .count_int= @average_duration_each_session_in_minutes_self_tour
              .count_text= 'Average duration of each tour in minutes'

          .col-lg-8
            = line_chart @session_each_day_minutes_data_self_tour, @session_each_day_minutes_options_self_tour

      - if current_user.is_super_admin?
        .row.mt-80
          .col-lg-12.col-md-12.h-500
            .chart-title
              %p.chart_heading Tours by Time of Day
              = render 'title_info', {info_text: SELF_TOUR_TOURS_BY_TIME_OF_DAY_INFO }
            .col-lg-3.numbers_div
              .center_it
                .count_int= @session_in_highest_hour_self_tour
                .count_text= 'Maximum number of tours at '
                .count_text=  @highest_hour_self_tour
            .col-lg-9
              = bar_chart @session_each_day_hour_data_self_tour, @session_each_day_hour_options_self_tour
      .row.mt-80
        .col-lg-12.col-md-12.h-500
          %p.chart_heading Single vs Multiple Page Visits
          .col-lg-2.numbers_div
            .center_it
              .pie_description
                %span.dot.single_page
                %span One page viewed tours
                %span= @percentage_single_page_visitor_self_tour
              .pie_description
                %span.dot.multiple_page
                %span Multiple page viewed tours
                %span= @percentage_multiple_page_visitor_self_tour
          .col-lg-5.pie_width
            = pie_chart @bounce_data_labels_self_tour, @bounce_data_options_self_tour

      - if current_user.is_super_admin?
        .row.mt-80
          .col-lg-12.h-500
            .chart-title
              %p.chart_heading Events
              = render 'title_info', {info_text: SELF_TOUR_EVENTS_INFO }

            .col-lg-2.numbers_div
              .center_it
                .count_int= @total_number_of_events_self_tour
                .count_text= 'Total number of events'
                .pie_description
                  %span.dot.events_with
                  %span Tours with events
                  %span= @percentage_session_with_events_self_tour
                .pie_description
                  %span.dot.events_without
                  %span Tours without events 
                  %span= @percentage_session_without_events_self_tour
            .col-lg-5.pie_width
              = pie_chart @pie_events_data_labels_self_tour, @pie_events_data_options_self_tour
            .col-lg-5
              = bar_chart @bar_events_data_labels_self_tour, @bar_events_data_options_self_tour

      .row.mt-80
        .col-lg-12.h-500
          .chart-title
            %p.chart_heading Tour Location
            = render 'title_info', {info_text: SELF_TOUR_TOUR_LOCATION_INFO }
          .col-lg-2.numbers_div
            .center_it
              .pie_description
                %span.dot.tour_site_true
                %span Onsite Tours
                %span= @percentage_tour_site_true_counts
              .pie_description
                %span.dot.tour_site_false
                %span Offsite Tours
                %span= @percentage_tour_site_false_counts
          .col-lg-5.pie_width
            = pie_chart @pie_tour_site_data_labels, @pie_tour_site_data_options
          .col-lg-5
            = bar_chart @bar_tour_site_data_labels, @bar_tour_site_data_options

      - if current_user.is_super_admin?
        .row.mt-80
          .col-lg-12.h-500
            .chart-title
              %p.chart_heading Apply Clicks
              = render 'title_info', {info_text: SELF_TOUR_APPLY_CLICKS_INFO }
            .col-lg-2.numbers_div
              .center_it
                .count_int= @total_number_of_apply_clicks_self_tour
                .count_text= 'Total number of apply clicks' 
                .pie_description
                  %span.dot.apply_clicks_with
                  %span Tours with apply clicks
                  %span= @percentage_session_with_apply_clicks_self_tour
                .pie_description
                  %span.dot.apply_clicks_without
                  %span Tours without apply clicks
                  %span= @percentage_session_without_apply_clicks_self_tour
            .col-lg-5.pie_width
              = pie_chart @pie_apply_click_data_labels_self_tour, @pie_apply_click_data_options_self_tour
            .col-lg-5
              = line_chart @line_apply_click_data_labels_self_tour, @line_apply_click_data_options_self_tour

      - if current_user.is_super_admin?
        .row.mt-80
          .col-lg-12.h-500
            .chart-title
              %p.chart_heading See Availability
              = render 'title_info', {info_text: SELF_TOUR_SEE_AVAILABILITY_INFO }
            .col-lg-2.numbers_div
              .center_it
                .count_int= @total_number_of_see_availability
                .count_text= 'Total number of See Availability' 
                .pie_description
                  %span.dot.see_availability_with
                  %span Tours With "See Availability"
                  %span= @percentage_session_with_see_availability
                .pie_description
                  %span.dot.see_availability_without
                  %span Tours Without "See Availability"
                  %span= @percentage_session_without_see_availability
            .col-lg-5.pie_width
              = pie_chart @pie_see_availbility_data_labels, @pie_see_availbility_data_options
            .col-lg-5
              = line_chart @line_see_availbility_data_labels, @line_see_availbility_data_options

      - if current_user.is_super_admin?
        .row.mt-80
          .col-lg-6.col-md-12.h-500
            %p.chart_heading Camera Opened
            .col-lg-4.numbers_div
              .center_it
                .count_int= @total_number_of_camera_opened_counter
                .count_text= "Total number of times camera was opened"
                .pie_description
                  %span.dot.tour_counter_with
                  %span Tours with Camera Opened
                  %span= @percentage_session_with_counts_camera_opened_counter
                .pie_description
                  %span.dot.tour_counter_without
                  %span Tours without Camera Opened
                  %span= @percentage_session_without_counts_camera_opened_counter
            .col-lg-8.pie_width
              = pie_chart @pie_camera_opened_counter_data_labels, @pie_camera_opened_counter_data_options
          .col-lg-6.col-md-12.h-500
            %p.chart_heading Notes Opened
            .col-lg-4.numbers_div
              .center_it
                .count_int= @total_number_of_notes_opened_counter
                .count_text= 'Total number of times notes was opened'
                .pie_description
                  %span.dot.tour_counter_with
                  %span Tours with Notes Opened
                  %span= @percentage_session_with_counts_notes_opened_counter
                .pie_description
                  %span.dot.tour_counter_without
                  %span Tours without Notes Opened
                  %span= @percentage_session_without_counts_notes_opened_counter
            .col-lg-8.pie_width
              = pie_chart @pie_notes_opened_counter_data_labels, @pie_notes_opened_counter_data_options

      .row.mt-80
        - if @only_scheduled_tours        
          .col-lg-12.col-md-12.h-500
            .chart-title
              %p.chart_heading No Shows
              = render 'title_info', {info_text: SELF_TOUR_NO_SHOWS }

            .col-lg-8
              = bar_chart @session_each_day_no_show_data, @session_each_day_no_show_options

            .col-lg-4.numbers_div
              .center_it
                .count_int= @no_show_count
                .count_text= "Total number of no shows"

        - else   
          .col-lg-6.col-md-12.h-500
            .chart-title
              %p.chart_heading Scheduled vs. Unscheduled
              = render 'title_info', {info_text: SELF_TOUR_SCHEDULED_VS_UNSCHEDULED_INFO }
            .col-lg-4.numbers_div
              .center_it
                .count_int= @tour_scheduled_counts
                .count_text= 'Total number of Scheduled Tours' 
                .count_int= @tour_unscheduled_counts
                .count_text= 'Total number of Unscheduled Tours' 
                .pie_description
                  %span.dot.tour_scheduled
                  %span Scheduled Tours
                  %span= @percentage_tour_scheduled_counts
                .pie_description
                  %span.dot.tour_unscheduled
                  %span Unscheduled Tours
                  %span= @percentage_tour_unscheduled_counts
            .col-lg-8.pie_width
              = pie_chart @pie_tour_type_data_labels, @pie_tour_type_data_options

          .col-lg-6.col-md-12.h-500
            .chart-title
              %p.chart_heading No Shows
              = render 'title_info', {info_text: SELF_TOUR_NO_SHOWS }
            .col-lg-4.numbers_div
              .center_it
                .count_int= @no_show_count
                .count_text= "Total number of no shows"
            .col-lg-8
              = bar_chart @session_each_day_no_show_data, @session_each_day_no_show_options

      .row.mt-80
        .col-lg-12.h-500
          .chart-title
            %p.chart_heading Tour Completions
            = render 'title_info', {info_text: SELF_TOUR_TOUR_COMPLETION_INFO }
          .col-lg-2.numbers_div
            .center_it
              .pie_description
                %span.dot.tour_site_true
                %span Completed Tours
                %span= @percentage_tour_state_true_counts
              .pie_description
                %span.dot.tour_site_false
                %span Incomplete Tours
                %span= @percentage_tour_state_false_counts
          .col-lg-5.pie_width
            = pie_chart @pie_tour_state_data_labels, @pie_tour_state_data_options
          .col-lg-5
            = bar_chart @bar_tour_state_data_labels, @bar_tour_state_data_options

      .row.mt-80
        -# .col-lg-6.col-md-12.h-500
        -#   .chart-title
        -#     %p.chart_heading Stops Per Tour
        -#     = render 'title_info', {info_text: SELF_TOUR_STOPS_PER_TOUR_INFO }
        -#   .col-lg-4.numbers_div
        -#     .center_it
        -#       .count_int= @average_number_of_stops_per_session_tour_stop
        -#       .count_text= "Average number of stops visited per tour"
        -#   .col-lg-8
        -#     = bar_chart @session_each_day_stops_hour_data, @session_each_day_stops_hour_options

        - if current_user.is_super_admin?
          .col-lg-12.col-md-12.h-500
            .chart-title
              %p.chart_heading Top Stops
              = render 'title_info', {info_text: SELF_TOUR_TOP_STOPS_INFO }
            .col-lg-8
              = horizontal_bar_chart @visited_per_tour_stop_data_labels, @visited_per_tour_stop_data_options

            .col-lg-4.numbers_div
              .center_it
                .count_int= @average_number_of_stops_per_session_tour_stop
                .count_text= "Average number of stops visited per tour"

    - else
      %h3 There is no record found on selected date range




