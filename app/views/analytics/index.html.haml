- content_for :title, "Analytics - Pynwheel"
%section.is-community-page
  .content
    - if current_user.role == "Dwelo admin"
      .box-info.add-plan{style: "margin-right: 10px;"}
        %img.dwelo-logo{:alt => "Smiley face", :src => "/assets/Dwelo-Logo.png"}
    - if @maps_records.any? 
      .box.box-info.add-plan.mt-20
        .box-header
          %h3.box-title
            Maps
            %span Analatics

        .box-body.maps-box
          .row
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .count_int= @track_session_count_maps
                  .count_text= 'Total number of session'
                  .count_int= @avg_track_session_maps
                  .count_text= 'Average number of session per day'
              .col-lg-8
                = bar_chart @session_each_day_data_maps, @session_each_day_options_maps
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .count_int= @average_duration_each_session_in_minutes_maps
                  .count_text= 'Average duration of each session in minutes'
              .col-lg-8
                = line_chart @session_each_day_minutes_data_maps, @session_each_day_minutes_options_maps
          
          .row.marg-150.hour_session_row
            .col-lg-12.h-700
              .col-lg-2.numbers_div_700
                .center_it
                  .count_int= @session_in_highest_hour_maps
                  .count_text= 'Maximum number of session at ' + @highest_hour_maps
              .col-lg-10.h-700
                = bar_chart @session_each_day_hour_data_maps, @session_each_day_hour_options_maps

           
          .row
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_events_maps
                  .count_text= 'Total number of events' 
              .col-lg-5
                = pie_chart @pie_events_data_labels_maps, @pie_events_data_options_maps
              .col-lg-5
                = bar_chart @bar_events_data_labels_maps, @bar_events_data_options_maps


          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_apply_clicks_maps
                  .count_text= 'Total number of apply clicks' 
              .col-lg-5
                = pie_chart @pie_apply_click_data_labels_maps, @pie_apply_click_data_options_maps
              .col-lg-5
                = line_chart @line_apply_click_data_labels_maps, @line_apply_click_data_options_maps

          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_favourite_saved
                  .count_text= 'Total number of favourite saved' 
              .col-lg-5
                = pie_chart @pie_favourite_saved_data_labels, @pie_favourite_saved_data_options
              .col-lg-5
                = bar_chart @bar_favourite_saved_data_labels, @bar_favourite_saved_data_options

          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_favourite_sent
                  .count_text= 'Total number of times favourite emailed' 
              .col-lg-5
                = pie_chart @pie_favourite_sent_data_labels, @pie_favourite_sent_data_options
              .col-lg-5
                = bar_chart @bar_favourite_sent_data_labels, @bar_favourite_sent_data_options


          .row.mt-80
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @percentage_single_page_visitor_maps
                  .count_text= "One page viewed session"
              .col-lg-8
                = pie_chart @bounce_data_labels_maps, @bounce_data_options_maps
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @total_number_of_price_opened_maps
                  .count_text= 'Total number of times price was opened'
              .col-lg-8
                = pie_chart @pie_price_opened_data_labels_maps, @pie_price_opened_data_options_maps

    - if @self_tour_records.any?
      .box.box-info.add-plan.mt-20
        .box-header
          %h3.box-title
            Self Tour
            %span Analatics

        .box-body.maps-box
          .row
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .count_int= @track_session_count_self_tour
                  .count_text= 'Total number of session'
                  .count_int= @avg_track_session_self_tour
                  .count_text= 'Average number of session per day'
              .col-lg-8
                = bar_chart @session_each_day_data_self_tour, @session_each_day_options_self_tour
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .count_int= @average_duration_each_session_in_minutes_self_tour
                  .count_text= 'Average duration of each session in minutes'
              .col-lg-8
                = line_chart @session_each_day_minutes_data_self_tour, @session_each_day_minutes_options_self_tour

          .row.marg-150.hour_session_row
            .col-lg-12.h-700
              .col-lg-2.numbers_div_700
                .center_it
                  .count_int= @session_in_highest_hour_self_tour
                  .count_text= 'Maximum number of session at ' + @highest_hour_self_tour
              .col-lg-10.h-700
                = bar_chart @session_each_day_hour_data_self_tour, @session_each_day_hour_options_self_tour

          .row
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_events_self_tour
                  .count_text= 'Total number of events' 
              .col-lg-5
                = pie_chart @pie_events_data_labels_self_tour, @pie_events_data_options_self_tour
              .col-lg-5
                = bar_chart @bar_events_data_labels_self_tour, @bar_events_data_options_self_tour

          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @percentage_tour_site_true_counts
                  .count_text= 'percentage of onsite tours' 
                  .half_count_int= @percentage_tour_site_false_counts
                  .count_text= 'percentage of offsite tours'
              .col-lg-5
                = pie_chart @pie_tour_site_data_labels, @pie_tour_site_data_options
              .col-lg-5
                = bar_chart @bar_tour_site_data_labels, @bar_tour_site_data_options

          .row.mt-80
            .col-lg-12
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @tour_scheduled_counts
                  .count_text= 'Total number of scheduled tours' 
                  .half_count_int= @tour_unscheduled_counts
                  .count_text= 'Total number of unscheduled tours'
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @percentage_tour_scheduled_counts
                  .count_text= 'percentage of scheduled tours' 
                  .half_count_int= @percentage_tour_unscheduled_counts
                  .count_text= 'percentage of unscheduled tours'
              .col-lg-4
                = pie_chart @pie_tour_type_data_labels, @pie_tour_type_data_options

          
          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_apply_clicks_self_tour
                  .count_text= 'Total number of apply clicks' 
              .col-lg-5
                = pie_chart @pie_apply_click_data_labels_self_tour, @pie_apply_click_data_options_self_tour
              .col-lg-5
                = line_chart @line_apply_click_data_labels_self_tour, @line_apply_click_data_options_self_tour

          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @total_number_of_see_availability
                  .count_text= 'Total number of see availability' 
              .col-lg-5
                = pie_chart @pie_see_availbility_data_labels, @pie_see_availbility_data_options
              .col-lg-5
                = line_chart @line_see_availbility_data_labels, @line_see_availbility_data_options

          .row.mt-80
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @total_number_of_camera_opened_counter
                  .count_text= "Total number of times camera was opened"
              .col-lg-8
                = pie_chart @pie_notes_opened_counter_data_labels, @pie_notes_opened_counter_data_options
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @total_number_of_notes_opened_counter
                  .count_text= 'Total number of times notes was opened'
              .col-lg-8
                = pie_chart @pie_camera_opened_counter_data_labels, @pie_camera_opened_counter_data_options


          .row.mt-80
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @percentage_single_page_visitor_self_tour
                  .count_text= "One page viewed session"
              .col-lg-8
                = pie_chart @bounce_data_labels_self_tour, @bounce_data_options_self_tour
            .col-lg-6.col-md-12.h-500
              .col-lg-4.numbers_div
                .center_it
                  .half_count_int= @total_number_of_price_opened_self_tour
                  .count_text= 'Total number of times price was opened'
              .col-lg-8
                = pie_chart @pie_price_opened_data_labels_self_tour, @pie_price_opened_data_options_self_tour

          .row.mt-80
            .col-lg-12
              .col-lg-2.numbers_div
                .center_it
                  .half_count_int= @percentage_tour_state_true_counts
                  .count_text= 'percentage of completed tours' 
                  .half_count_int= @percentage_tour_state_false_counts
                  .count_text= 'percentage of abandoned tours'
              .col-lg-5
                = pie_chart @pie_tour_state_data_labels, @pie_tour_state_data_options
              .col-lg-5
                = bar_chart @bar_tour_state_data_labels, @bar_tour_state_data_options
