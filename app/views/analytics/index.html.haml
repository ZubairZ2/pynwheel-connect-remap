- content_for :title, "Analytics - Pynwheel"
%link{:href => "https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css", :rel => "stylesheet"}/
%script{:src => "https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"}
%script{:src => "https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js", :type => "text/javascript"}
%link{:href => "https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css", :rel => "stylesheet", :type => "text/css"}/
%section.is-community-page
  - community_id =  defined?(@community_id).nil? ? '' : @community_id
  - company_id = defined?(@company_id).nil? ? '' : @company_id
  - region_id = defined?(@region_id).nil? ? '' : @region_id
  - product_type_selected =  defined?(@product_type).nil? ? 'all' : @product_type
  - admin_type_selected = defined?(@admin_type).nil? ? '' : @admin_type
  = hidden_field_tag "start_date", @start_date
  = hidden_field_tag "end_date", @end_date
  .content
    - if current_user.role == "Dwelo admin"
      .box-info.add-plan{style: "margin-right: 10px;"}
        %img.dwelo-logo{:alt => "Smiley face", :src => "/assets/Dwelo-Logo.png"}
    
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Filters

      .box-body
        .row
          .col-xl-4.col-lg-4
            %h4.empty_other{:title => "On Selected this other marked(*) filters will unselect"} Communities
            = select_tag 'communities', options_for_select(communities_list(current_user), community_id),:class=>"form-control filter_select2", :include_blank => 'Select any community'
          .col-xl-4.col-lg-4
            %h4 Product Type
            = select_tag 'product_type', options_for_select(product_type, product_type_selected),:class=>"form-control filter_select2"
          .col-xl-4.col-lg-4
            %h4 TimeFrame
            = text_field_tag 'timeframe', nil, class: 'date_range_filter'
        - unless current_user.is_comm_admin? || current_user.is_community_manager?
          .row
            - if current_user.is_super_admin? || current_user.is_dwelo_admin? || current_user.is_company_admin?
              .col-xl-4.col-lg-4
                %h4.empty_other{:title => "On Selected this other marked(*) filters will unselect"} Companies
                = select_tag 'companies', options_for_select(companies_list(current_user), company_id),:class=>"form-control filter_select2", :include_blank => 'Select any company'
              .col-xl-4.col-lg-4
                %h4.empty_other{:title => "On Selected this other marked(*) filters will unselect"} Regions
                = select_tag 'regions', options_for_select(regions_list(current_user), region_id),:class=>"form-control filter_select2", :include_blank => 'Select any region'
            - if current_user.is_super_admin?
              .col-xl-4.col-lg-4
                %h4.empty_other{:title => "On Selected this other marked(*) filters will unselect"} Admin Type
                = select_tag 'admin_type', options_for_select(admin_type, admin_type_selected),:class=>"form-control filter_select2", :include_blank => 'Select admin type'

    - if @product_type == "all" || @product_type == "maps"
      .box.box-info.add-plan.mt-20
        .box-header
          %h3.box-title
            Maps
            %span Analytics
          %h3.box-title.align-right
            Sessions
            %span= @date_range_text
        .box-body.maps-box
          - if @maps_records.any?
            .row
              .col-lg-6.col-md-12.h-500
                %p.chart_heading Sessions
                .col-lg-4.numbers_div
                  .center_it
                    .count_int= @track_session_count_maps
                    .count_text= 'Total number of session'
                    .count_int= @avg_track_session_maps
                    .count_text= 'Average number of session per day'
                .col-lg-8
                  = bar_chart @session_each_day_data_maps, @session_each_day_options_maps
              .col-lg-6.col-md-12.h-500
                %p.chart_heading Session Duration
                .col-lg-4.numbers_div
                  .center_it
                    .count_int= @average_duration_each_session_in_minutes_maps
                    .count_text= 'Average duration of each session in minutes'
                .col-lg-8
                  = line_chart @session_each_day_minutes_data_maps, @session_each_day_minutes_options_maps
             
            .row.mt-80
              .col-lg-6.col-md-12.h-500
                %p.chart_heading Sessions by Time of Day
                .col-lg-4.numbers_div
                  .center_it
                    .count_int= @session_in_highest_hour_maps
                    .count_text= 'Maximum number of session at ' + @highest_hour_maps
                .col-lg-8
                  = bar_chart @session_each_day_hour_data_maps, @session_each_day_hour_options_maps

              .col-lg-6.col-md-12.h-500
                %p.chart_heading Bounce Rate
                .col-lg-4.numbers_div
                  .center_it
                    .pie_description
                      %span.dot.single_page
                      %span One page viewed session
                      %span= @percentage_single_page_visitor_maps
                    .pie_description
                      %span.dot.multiple_page
                      %span Multiple page viewed session
                      %span= @percentage_multiple_page_visitor_maps
                .col-lg-8.pie_width
                  = pie_chart @bounce_data_labels_maps, @bounce_data_options_maps

            .row.mt-80
              .col-lg-12.h-500
                %p.chart_heading Events
                .col-lg-2.numbers_div
                  .center_it
                    .count_int= @total_number_of_events_maps
                    .count_text= 'Total number of events'
                    .pie_description
                      %span.dot.events_with
                      %span Session with events
                      %span= @percentage_session_with_events_maps
                    .pie_description
                      %span.dot.events_without
                      %span Session without events 
                      %span= @percentage_session_without_events_maps
                .col-lg-5.pie_width
                  = pie_chart @pie_events_data_labels_maps, @pie_events_data_options_maps
                .col-lg-5
                  = bar_chart @bar_events_data_labels_maps, @bar_events_data_options_maps


            .row.mt-80
              .col-lg-12.h-500
                %p.chart_heading Apply Clicks
                .col-lg-2.numbers_div
                  .center_it
                    .count_int= @total_number_of_apply_clicks_maps
                    .count_text= 'Total number of apply clicks' 
                    .pie_description
                      %span.dot.apply_clicks_with
                      %span Session with apply clicks
                      %span= @percentage_session_with_apply_clicks_maps
                    .pie_description
                      %span.dot.apply_clicks_without
                      %span Session without apply clicks
                      %span= @percentage_session_without_apply_clicks_maps
                .col-lg-5.pie_width
                  = pie_chart @pie_apply_click_data_labels_maps, @pie_apply_click_data_options_maps
                .col-lg-5
                  = line_chart @line_apply_click_data_labels_maps, @line_apply_click_data_options_maps

            .row.mt-80
              .col-lg-12.h-500
                %p.chart_heading Favourite Saved
                .col-lg-2.numbers_div
                  .center_it
                    .count_int= @total_number_of_favourite_saved_maps
                    .count_text= 'Total number of favourite saved' 
                    .pie_description
                      %span.dot.favourite_saved_with
                      %span Session with favourite saved
                      %span= @percentage_session_with_favourite_saved_maps
                    .pie_description
                      %span.dot.favourite_saved_without
                      %span Session without favourite saved
                      %span= @percentage_session_without_favourite_saved_maps
                .col-lg-5.pie_width
                  = pie_chart @pie_favourite_saved_data_labels_maps, @pie_favourite_saved_data_options_maps
                .col-lg-5
                  = bar_chart @bar_favourite_saved_data_labels_maps, @bar_favourite_saved_data_options_maps

            .row.mt-80
              .col-lg-12.h-500
                %p.chart_heading Favourite Mailed
                .col-lg-2.numbers_div
                  .center_it
                    .count_int= @total_number_of_favourite_sent_maps
                    .count_text= 'Total number of times favourite emailed' 
                    .pie_description
                      %span.dot.favourite_sent_with
                      %span Session with favourite mailed
                      %span= @percentage_session_with_favourite_sent_maps
                    .pie_description
                      %span.dot.favourite_sent_without
                      %span Session without favourite mailed
                      %span= @percentage_session_without_favourite_sent_maps
                .col-lg-5.pie_width
                  = pie_chart @pie_favourite_sent_data_labels_maps, @pie_favourite_sent_data_options_maps
                .col-lg-5
                  = bar_chart @bar_favourite_sent_data_labels_maps, @bar_favourite_sent_data_options_maps

            .row.mt-80
              .col-lg-6.col-md-12.h-500
                %p.chart_heading Price Opened
                .col-lg-4.numbers_div
                  .center_it
                    .count_int= @total_number_of_price_opened_maps
                    .count_text= 'Total number of times price was opened'
                    .pie_description
                      %span.dot.price_opened_with
                      %span Session with price opened
                      %span= @percentage_session_with_price_opened_maps
                    .pie_description
                      %span.dot.price_opened_without
                      %span Session without price opened
                      %span= @percentage_session_without_price_opened_maps
                .col-lg-8.pie_width
                  = pie_chart @pie_price_opened_data_labels_maps, @pie_price_opened_data_options_maps

          - else
            %h3 There is no record found on selected date range

    - if @product_type == "all" || @product_type == "self_tour"
      .box.box-info.add-plan.mt-20
        .box-header
          %h3.box-title
            Self Tour
            %span Analytics
          %h3.box-title.align-right
            Sessions
            %span= @date_range_text
        .box-body.maps-box
