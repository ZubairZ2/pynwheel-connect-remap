.box.box-info.add-plan.mt-20
  .box-header
    %h3.box-title
      Pywheel Touch
      %span Analytics
    %h3.box-title.align-right
      Sessions
      %span= @date_range_text
  .box-body.maps-box
    - if @metro_records.present? && @metro_records.any? 
      .row
        .col-lg-6.col-md-12.h-500
          .chart-title
            %p.chart_heading Sessions
            = render 'title_info', {info_text: TOUCH_SESSIONS_INFO }

          .col-lg-4.numbers_div
            .center_it
              .count_int= @track_session_count_metro
              .count_text= 'Total number of sessions'
              .count_int= @avg_track_session_metro
              .count_text= 'Average number of sessions per day'
          .col-lg-8
            = bar_chart @session_each_day_data_metro, @session_each_day_options_metro
        .col-lg-6.col-md-12.h-500
          .chart-title
            %p.chart_heading Activity Duration
            = render 'title_info', {info_text: TOUCH_SESSION_DURATION }
          .col-lg-4.numbers_div
            .center_it
              .count_int= @average_duration_each_session_in_minutes_metro
              .count_text= 'Average duration of activity in minutes'
          .col-lg-8
            = line_chart @session_each_day_minutes_data_metro, @session_each_day_minutes_options_metro
       
      .row.mt-80
        .col-lg-12.col-md-12.h-500
          .chart-title
            %p.chart_heading Sessions by Time of Day
            = render 'title_info', {info_text: TOUCH_SESSIONS_BY_TIME_OF_DAY_INFO }
          .col-lg-3.numbers_div
            .center_it
              .count_int= @session_in_highest_hour_metro
              .count_text= 'Maximum number of sessions at '
              .count_text=  @highest_hour_metro
          .col-lg-9
            = bar_chart @session_each_day_hour_data_metro, @session_each_day_hour_options_metro
        
      .row.mt-80
        .col-lg-12.col-md-12.h-500
          .chart-title
            %p.chart_heading Single vs Multiple Page Visits
            = render 'title_info', {info_text: TOUCH_SINGLE_VS_MULTIPLE_PAGE_VISITS_INFO }
          .col-lg-2.numbers_div
            .center_it
              .pie_description
                %span.dot.single_page
                %span One page viewed session
                %span= @percentage_single_page_visitor_metro
              .pie_description
                %span.dot.multiple_page
                %span Multiple page viewed session
                %span= @percentage_multiple_page_visitor_metro
          .col-lg-5.pie_width
            = pie_chart @bounce_data_labels_metro, @bounce_data_options_metro
      
      .row.mt-80
        .col-lg-12.h-500
          .chart-title
            %p.chart_heading Events
            = render 'title_info', {info_text: TOUCH_EVENTS_INFO }
          .col-lg-2.numbers_div
            .center_it
              .count_int= @total_number_of_events_metro
              .count_text= 'Total number of events'
              .pie_description
                %span.dot.events_with
                %span Sessions with events
                %span= @percentage_session_with_events_metro
              .pie_description
                %span.dot.events_without
                %span Sessions without events 
                %span= @percentage_session_without_events_metro
          .col-lg-5.pie_width
            = pie_chart @pie_events_data_labels_metro, @pie_events_data_options_metro
          .col-lg-5
            = bar_chart @bar_events_data_labels_metro, @bar_events_data_options_metro


      -# .row.mt-80
      -#   .col-lg-12.h-500
      -#     %p.chart_heading Apply Clicks
      -#     .col-lg-2.numbers_div
      -#       .center_it
      -#         .count_int= @total_number_of_apply_clicks_metro
      -#         .count_text= 'Total number of apply clicks' 
      -#         .pie_description
      -#           %span.dot.apply_clicks_with
      -#           %span Sessions with apply clicks
      -#           %span= @percentage_session_with_apply_clicks_metro
      -#         .pie_description
      -#           %span.dot.apply_clicks_without
      -#           %span Sessions without apply clicks
      -#           %span= @percentage_session_without_apply_clicks_metro
      -#     .col-lg-5.pie_width
      -#       = pie_chart @pie_apply_click_data_labels_metro, @pie_apply_click_data_options_metro
      -#     .col-lg-5
      -#       = line_chart @line_apply_click_data_labels_metro, @line_apply_click_data_options_metro

      .row.mt-80
        .col-lg-12.h-500
          .chart-title
            %p.chart_heading Favorite Saved
            = render 'title_info', {info_text: TOUCH_FAVORITE_SAVED_INFO }
          .col-lg-2.numbers_div
            .center_it
              .count_int= @total_number_of_favourite_saved_metro
              .count_text= 'Total number of favorite saved' 
              .pie_description
                %span.dot.favourite_saved_with
                %span Session with favorite saved
                %span= @percentage_session_with_favourite_saved_metro
              .pie_description
                %span.dot.favourite_saved_without
                %span Session without favorite saved
                %span= @percentage_session_without_favourite_saved_metro
          .col-lg-5.pie_width
            = pie_chart @pie_favourite_saved_data_labels_metro, @pie_favourite_saved_data_options_metro
          .col-lg-5
            = bar_chart @bar_favourite_saved_data_labels_metro, @bar_favourite_saved_data_options_metro

      .row.mt-80
        .col-lg-12.h-500
          .chart-title
            %p.chart_heading Favorite Mailed
            = render 'title_info', {info_text: TOUCH_FAVORITE_MAILED_INFO }
          .col-lg-2.numbers_div
            .center_it
              .count_int= @total_number_of_favourite_sent_metro
              .count_text= 'Total number of times favorite emailed' 
              .pie_description
                %span.dot.favourite_sent_with
                %span Session with favorite mailed
                %span= @percentage_session_with_favourite_sent_metro
              .pie_description
                %span.dot.favourite_sent_without
                %span Session without favorite mailed
                %span= @percentage_session_without_favourite_sent_metro
          .col-lg-5.pie_width
            = pie_chart @pie_favourite_sent_data_labels_metro, @pie_favourite_sent_data_options_metro
          .col-lg-5
            = bar_chart @bar_favourite_sent_data_labels_metro, @bar_favourite_sent_data_options_metro
      
      .row.mt-80
        .col-lg-12.h-500
          .chart-title
            %p.chart_heading Interface Used
            = render 'title_info', {info_text: TOUCH_INTERFACE_USED_INFO }
          .col-lg-2.numbers_div
            .center_it
              .count_int= @total_number_of_touch_sent_metro
              .count_text= 'Total number of times tablet used' 
              .pie_description
                %span.dot.ipad_interface_used
                %span Sessions on tablet
                %span= @percentage_ipad_interface_used_metro
              .pie_description
                %span.dot.metro_interface_used
                %span Sessions on touchscreen
                %span= @percentage_metro_interface_used_metro
          .col-lg-5.pie_width
            = pie_chart @pie_touch_data_labels_metro, @pie_touch_data_options_metro
          .col-lg-5
            = bar_chart @bar_touch_data_labels_metro, @bar_touch_data_options_metro

      .row.mt-80      
        .col-lg-6.col-md-12.h-500
          .chart-title
            %p.chart_heading Pages Per Session
            = render 'title_info', {info_text: TOUCH_PAGES_PER_SESSION_INFO }
          .col-lg-4.numbers_div
            .center_it
              .count_int= @average_number_of_pages_per_session_metro
              .count_text= "Average number of visited pages per session"
          .col-lg-8
            = bar_chart @session_each_day_hour_pages_data, @session_each_day_hour_pages_options

        .col-lg-6.col-md-12.h-500
          .chart-title
            %p.chart_heading Top Pages
            = render 'title_info', {info_text: TOUCH_TOP_PAGES_INFO }

          .col-lg-8
            = horizontal_bar_chart @visited_pages_data_labels, @visited_pages_data_options

    - else
      %h3 There is no record found on selected date range
