.box.box-info.add-plan
  .box-header
    %h3.box-title
      Plot

      = render 'decide_styling'

      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnFloorplatePopover","data-content" => " "}
        %span#propertyDetailNameText
          Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.

    .btn-btn-danger.mt-10
      - if @community.self_tour and @community.auto_wayfinding
        %button.btn.btn-primary.grid-overlay.header_map_btn{:type=>"button",id:"hallway_btn",:onclick=>'plotting_hallways($(this))'}Start Plotting Hallways
      - # Access points is hiding for now we will use it in future
      - if false && @community.enable_locks and @community.self_tour and @community.auto_wayfinding
        %button.btn.btn-success{onclick: 'start_access_point_plot(event)'}
          Add Access Point
          %i.propertyDetailName.fa.fa-question-circle
            %span#propertyDetailNameText{:style => "font-weight: normal;"}
              Add Access point in hallways that are not associated with any specific unit or amenity
      - if @community.self_tour and @community.auto_wayfinding
        %button.btn.btn-primary.grid-overlay.header_map_btn{:type=>"button",:onclick=>'run_algo(true, "sorting", true)'}Run Algo(Animated)
        // %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'automate_path()'}Automate Path
        // %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'run_algo(false, "actual shortest", true)'}Run Algo
        // %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'run_algo(true, "actual shortest", true)'}Run Algo With Animation
        // %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'run_algo(false, "sorting", true)'}Run Algo With Sorting
        // %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'run_algo(true, "sorting", true)'}Run Algo With Sorting And Animation
  = render :partial=>'shared/hidden_locks_data.html',locals: {community: @community, all_locks: @all_locks, locks_present_hash: @current_locks_provider}
  %form.form-horizontal
    .box-body.map-body-top
      .row
        .col-lg-12#container.p-0
          .buttons{:style=>"position: absolute; right: 20px; top: 5px;z-index:999;"}
            %a.btn.btn-sm.btn-primary.zoom-in.zoom-controls
              %i.fa.fa-plus
            %a.btn.btn-sm.btn-primary.zoom-out.zoom-controls
              %i.fa.fa-minus
            %a.btn.btn-sm.btn-primary.reset.zoom-controls
              %i.fa.fa-refresh
          .mapLoading.hidden
          .map-block{:style=>"position: relative;"}
            #map.plot-image
              .grid-graph.hidden
              - if @sitemap.present? && @sitemap.image.present? && @sitemap.image.content_type == "image/svg+xml"
                %object{:data => "your.svg", :type => "image/svg+xml"}
                  = image_tag (@sitemap.present? && @sitemap.image.present? ? @sitemap.image.url : "default.jpeg"), :style => "width: #{@sitemap.sitemap_image_width()}px; height: #{@sitemap.sitemap_image_height()}px;", id:"map_img",name:"viewArea", id:"viewArea",draggable:"false", class: 'viewArea', data: {'map_id' => "map"}
              - else
                = image_tag @sitemap.present? && @sitemap.image.present? ? @sitemap.image.url : "default.jpeg", id:"map_img",name:"viewArea", id:"viewArea",draggable:"false", class: 'viewArea', data: {'map_id' => "map"}
                - if @community.community_tour.x_plot.to_i + @community.community_tour.y_plot.to_i > 0
                  = link_to image_tag("/assets/star.png", style: 'width:15px;'), "#", :class => "start-point marker", 'data-toggle' => "tooltip", :title => "Starting Point", :id => "m_", :style => "left:#{@community.community_tour.x_plot}px; top:#{@community.community_tour.y_plot}px; position:absolute;", "data-name" => "plot", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/tours/#{@community.community_tour.id}/resetStartingPoint"
              - community_units = @community_units
              - units_by_plotted_doors_order = @community_units.sort_by {|obj| obj.door.present? ? obj.door.id : obj.id}
              - coordinates_array = []
              - units_by_plotted_doors_order.each do |unit|
                - if unit.x_plot.to_i + unit.y_plot.to_i > 0
                  - unless coordinates_array.include?([unit.x_plot, unit.y_plot])

                    - coordinates_array.push([unit.x_plot, unit.y_plot])
                    - unit_door_exists = unit.door.present? ? true : false

                    %p{class: "marker", style: "left:#{unit.x_plot}px; top:#{unit.y_plot}px; position:absolute"}
                      = link_to "javascript:void(0);", { id: "m_#{unit.provider_unit_id}", style: "font-size: #{@fontsize}px", title: (unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, data: {toggle: "tooltip", toggle: "modal", name: "plot", target: "#markers-modal", href: "/communities/#{@community.id}/units/#{unit.provider_unit_id}/remove_plot", horizontal: unit.x_plot, vertical: unit.y_plot, unit_form_url: "/communities/#{@community.id}/units/#{unit.id}/adjust_position", plotted_category: "unit"}} do
                        %i{class: "fas fa-map-marker-alt", style: "color: #{@marker_color};"}

                      - if !unit_door_exists and @community.self_tour and @community.auto_wayfinding
                        = link_to "javascript:void(0);", { id: "plus_#{unit.provider_unit_id}", style: "margin-left: -6px;", title:  "Click to plot this unit(s) door", data: {toggle: "tooltip", plotted_category: "create_unit_door"}, onclick: 'plot_entry_point(event)'} do
                          %i{class: "fa fa-plus-circle fa-xs", style: "color: #59de83; font-size: #{@fontsize.to_i/2}px;" }
                        - unit_door_exists = false

                    - if unit_door_exists and @community.self_tour and @community.auto_wayfinding
                      - unit_door = unit.door
                      = link_to "javascript:void(0);", { id: "door_#{unit.provider_unit_id}", class: "marker", style: "left:#{unit_door.x_plot}px; top:#{unit_door.y_plot}px; position:absolute; font-size: #{@door_fontsize}px", title: "#{unit_door.name}", data: {door_id: "#{unit_door.id}", toggle: "tooltip", toggle: "modal", target: "#ajax-doors-detail-modal", plotted_category: "unit_door"}} do
                        %i{class: "fa fa-sign-in fa-xs", style: "color: #{@door_marker_color};"}

                  - else
                    - puts "duplicated.........."
                  .hidden{:class=>"h-#{unit.x_plot }-#{unit.y_plot}", :id=>"h-#{unit.provider_unit_id}","data-title"=>(unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, "data-name" => "plot", "data-href" => "/communities/#{@community.id}/units/#{unit.provider_unit_id}/remove_plot","data-unit-form-url"=>"/communities/#{@community.id}/units/#{unit.id}/adjust_position"}
              - coordinates_array = []
              -  @all_amenities.where(floor: [@floor, nil]).each do |amenity|
                - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                  - unless coordinates_array.include?([amenity.x_plot, amenity.y_plot])

                    - coordinates_array.push([amenity.x_plot, amenity.y_plot])

                    %p{class: "marker", style: "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute"}
                      = link_to "javascript:void(0);", :id => "m_#{amenity.id}", :title => amenity.name, data: {toggle: "tooltip", name: "plot", target: "#confirm-delete", plotted_category: "amenity"} do
                        %i{class: "custom-icon", style: "height:#{@fontsize}px; width: #{@fontsize}px; border: 2px solid  #{@marker_color};"}
                          %i{class: "fas fa-camera-retro", style: "font-size:#{@camera_font_size}px; color: #{@marker_color}; margin-top: #{@camera_margin}px;"}

                      - if @community.self_tour and @community.auto_wayfinding
                        = link_to "javascript:void(0);", { id: "plus_#{amenity.id}", title:  "Click to plot this amenity door", data: {toggle: "tooltip", plotted_category: "create_amenity_door"}} do
                          %i{class: "fa fa-plus-circle fa-xs", style: "color: #59de83; font-size: #{@fontsize/1.8}px;" }

                    - if @community.self_tour and @community.auto_wayfinding
                      - amenity.ordered_doors.each do |door|
                        = link_to "javascript:void(0);", { id: "amenity_#{amenity.id}__door_#{door.id}", class: "marker", style: "left:#{door.x_plot}px; top:#{door.y_plot}px; position:absolute; font-size: #{@door_fontsize}px", title: "#{door.name}", data: {door_id: "#{door.id}", toggle: "tooltip", toggle: "modal", target: "#amenity-door-detail-modal", plotted_category: "amenity_door"}} do
                          %i{class: "fa fa-sign-in fa-xs", style: "color: #{@door_marker_color};"}

                  - else
                    - puts "duplicated.........."

              - # Access points is hiding for now we will use it in future
              - if false && @community.enable_locks and @community.self_tour and @community.auto_wayfinding
                - coordinates_array = []

                - @access_points.each do |access_point|
                  - unless coordinates_array.include?([access_point.x_plot, access_point.y_plot])
                    - coordinates_array.push([access_point.x_plot, access_point.y_plot])
                    = link_to open_access_point_modal_community_sitemap_access_point_path(@community, @sitemap, access_point, x_plot: access_point.x_plot, y_plot: access_point.y_plot, plotted_id: access_point.id, locks_present_hash: @current_locks_provider.to_json), { id: "access_point_#{access_point.id}", class: "marker", style: "left:#{access_point.x_plot}px; top:#{access_point.y_plot}px; position:absolute; font-size: #{@door_fontsize/2}px", title: "#{access_point.name}", data: {door_id: "#{access_point.id}", toggle: "tooltip", remote: true, plotted_category: "access_point"}} do
                      %i{class: "fa fa-lock", style: "color: #66bf60"}

:javascript
  $(document).ready(function () {
    document.addEventListener("touchstart", touchHandler, true);
    document.addEventListener("touchmove", touchHandler, true);
    document.addEventListener("touchend", touchHandler, true);
    document.addEventListener("touchcancel", touchHandler, true);
    let elem = document.querySelector('#map');
    window.mapPanZoom = panzoom(elem, {
        minZoom: 0.5,
        maxZoom: 1.0,
        bounds: true,
        boundsPadding: 0.3
    });
    var transform = mapPanZoom ? mapPanZoom.getTransform() : {};
    var scaleFactor = (1 / (transform.scale || 1));
    var previous_scale = 0;
    while ($('#map').width() / scaleFactor > $('.map-block').width() || $('#map').height() / scaleFactor > $('.map-block').height()) {
        mapPanZoom.zoomInOut(189);
        transform = mapPanZoom ? mapPanZoom.getTransform() : {};
        scaleFactor = (1 / (transform.scale || 1));
        if (scaleFactor === previous_scale) {
            break;
        }
        previous_scale = scaleFactor
    }
    mapPanZoom.moveTo(0, 0);
    })

  function touchHandler(event) {
    var touch = event.changedTouches[0];

    var simulatedEvent = document.createEvent("MouseEvent");
        simulatedEvent.initMouseEvent({
        touchstart: "mousedown",
        touchmove: "mousemove",
        touchend: "mouseup"
    }[event.type], true, true, window, 1,
        touch.screenX, touch.screenY,
        touch.clientX, touch.clientY, false,
        false, false, false, 0, null);

    touch.target.dispatchEvent(simulatedEvent);
    // event.preventDefault();
  }

  var units_info = #{@unit_with_door.to_json.html_safe};
  var amenities_info = #{@amenity_with_doors.to_json.html_safe};
  // var access_points = #{@access_points.to_json.html_safe};
  var building_starting_point = {x_plot: #{@community.community_tour.x_plot.to_json.html_safe}, y_plot: #{@community.community_tour.y_plot.to_json.html_safe} };
  var left_margin = #{raw @left_margin}
  var right_margin = #{raw @right_margin}
  var community_id = #{params[:community_id]};
  var sitemap_id = '#{@sitemap.id}';

  var self_tour = #{@community.self_tour}
  var enable_locks = #{@community.enable_locks}
  var automate_wayfinding = #{@community.auto_wayfinding}

  var addmode = false;
  var adddoorsmode = false;
  var accesspointplot = false;
  var sm_id = '#{@sitemap.id}';
  
  hallways_coordinates = #{raw @hallways.present? ? @hallways.to_json : []}

  $( document ).ready(function() {
    initialize_variables()
    draw_initial_hallways(hallways_coordinates)
  });