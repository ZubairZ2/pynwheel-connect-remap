.box.box-info.add-plan
  .box-header
    %h3.box-title
      Plot
      = render 'decide_styling'
      %span=# @floorplate.name + " Units"
      = hidden_field_tag "floor_to_floorplate_id" , @floor_to_floorplate_id.to_json
      = hidden_field_tag "floors" , @floors
      = hidden_field_tag "hallways" , @hallways.to_json

      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnFloorplatePopover","data-content" => " "}
        %span#propertyDetailNameText
          Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.

    - begin
      %h3 Select a Floor
      - @floors.sort.each do |f|
        %a.btn-default{:href => "/automate_plotting?community_id="+@community.id.to_s+"&floorNo="+ "#{f}", :style => "display: inline-block;width: 33px;height: 25px;background: #{@floor.first.to_i == f ? "#49d849;" : "#e0e0e0;"} padding: 3px;text-align: center;border-radius: 5px;color: black;font-weight: bold;"} #{f}
    - rescue
      - puts "rescued"
    .btn-btn-danger.mt-10
      - if @community.self_tour and @community.auto_wayfinding
        %button.btn.btn-primary.grid-overlay{:type=>"button",id:"hallway_btn",:onclick=>'plotting_hallways($(this))'}Start Plotting Hallways
      - if false && @community.enable_locks and @community.self_tour and @community.auto_wayfinding
        = link_to community_floorplate_select_many_floors_path(@community, @floorplate), remote: true do
          %button.btn.btn-success
            Add Access Point
            %i.propertyDetailName.fa.fa-question-circle
              %span#propertyDetailNameText{:style => "font-weight: normal;"}
                Add Access point in hallways that are not associated with any specific unit or amenity- if @community.enable_locks and @community.self_tour and @community.auto_wayfinding
      - if @community.self_tour and @community.auto_wayfinding
        //%button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>'automate_path()'}Automate Path
        %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>"run_algo(false, 'sorting')"}Run Algo
  = render :partial=>'shared/hidden_locks_data.html',locals: {community: @community, all_locks: @all_locks, locks_present_hash: @current_locks_provider}
  - # render map of each floor
  - @floors.each do |floor|
    = render :partial=>'show_map', :locals => {floor: floor}

:javascript
  $(document).ready(function () {
    document.addEventListener("touchstart", touchHandler, true);
    document.addEventListener("touchmove", touchHandler, true);
    document.addEventListener("touchend", touchHandler, true);
    document.addEventListener("touchcancel", touchHandler, true);
    let elem = document.querySelector('#map');
    window.mapPanZoom = panzoom(elem, {
        minZoom: 0.5,
        maxZoom: 1.0,
        bounds: true,
        boundsPadding: 0.3
    });
    var transform = mapPanZoom ? mapPanZoom.getTransform() : {};
    var scaleFactor = (1 / (transform.scale || 1));
    var previous_scale = 0;
    while ($('#map').width() / scaleFactor > $('.map-block').width() || $('#map').height() / scaleFactor > $('.map-block').height()) {
        mapPanZoom.zoomInOut(189);
        transform = mapPanZoom ? mapPanZoom.getTransform() : {};
        scaleFactor = (1 / (transform.scale || 1));
        if (scaleFactor === previous_scale) {
            break;
        }
        previous_scale = scaleFactor
    }
    mapPanZoom.moveTo(0, 0);
    })

  function touchHandler(event) {
    var touch = event.changedTouches[0];

    var simulatedEvent = document.createEvent("MouseEvent");
        simulatedEvent.initMouseEvent({
        touchstart: "mousedown",
        touchmove: "mousemove",
        touchend: "mouseup"
    }[event.type], true, true, window, 1,
        touch.screenX, touch.screenY,
        touch.clientX, touch.clientY, false,
        false, false, false, 0, null);

    touch.target.dispatchEvent(simulatedEvent);
    // event.preventDefault();
  }

  var multi_floors;
  var units_info = #{@unit_with_door.to_json.html_safe}
  var amenities_info = #{@amenity_with_doors.to_json.html_safe}
  // var access_points = #{@access_points.to_json.html_safe}
  var building_starting_point = {x_plot: #{@community.tour.x_plot.to_json.html_safe}, y_plot: #{@community.tour.y_plot.to_json.html_safe} };

  var left_margin = #{raw @left_margin}
  var right_margin = #{raw @right_margin}
  var community_id = #{params[:community_id]}

  var self_tour = #{@community.self_tour}
  var enable_locks = #{@community.enable_locks}
  var automate_wayfinding = #{@community.auto_wayfinding}
  var floor_to_floorplate_id = JSON.parse($('#floor_to_floorplate_id').val())
  var floors = $('#floors').val().split(' ')
  var hallways = JSON.parse($('#hallways').val())
  var addmode = false;
  var adddoorsmode = false;
  var accesspointplot = false;
  
  $( document ).ready(function() {
    for (var i = 0; i < floors.length; i++) {
      fp_id = floor_to_floorplate_id[floors[i]]
      map = "map_" + floors[i]
      hallways_coordinates = hallways[floors[i]]
      draw_initial_hallways(hallways_coordinates, map)
    }
  });
