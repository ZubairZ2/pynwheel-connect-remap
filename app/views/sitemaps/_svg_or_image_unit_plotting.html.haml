- community_units = units.sort_by{|u| u.marketing_name}
- coordinates_array = []

- if community.theme_name.include?('gables')
  - map_marker_color = community&.design&.property_map_color || "#d37474"
- elsif community.theme_name == 'modernist'
  - map_marker_color = ( ['no color', ''].include?(community&.design.modernist_map_marker_color) ) ? (community&.design&.primary_color || '#cf492f') : community&.design&.modernist_map_marker_color
- elsif community.theme_name == 'futurist'
  - map_marker_color = community&.design&.futurist_property_map_marker_color || "#d37474"
- elsif community.theme_name == 'expressionist'
  - map_marker_color = community&.design&.expressionist_property_map_marker_color || "#d37474"
- elsif community.theme_name == 'panther'
  - map_marker_color = community&.design&.panther_property_map_marker_color || "#d37474"
- else
  - map_marker_color = 'rgba(247, 0, 0, 0.61)'
-#-
- if community.theme_name.include?('gables')
  - fontsize =community&.design&.property_map_size_integer || 30
- elsif community.theme_name == 'modernist'
  - fontsize = community&.design&.modernist_property_map_size || 30
- elsif community.theme_name == 'futurist'
  - fontsize = community&.design&.futurist_property_map_size || 30
- elsif community.theme_name == 'expressionist'
  - fontsize = community&.design&.expressionist_property_map_size || 30
- elsif community.theme_name == 'panther'
  - fontsize = community&.design&.panther_property_map_size || 30
- else
  - fontsize = 30

- door_fontsize     = fontsize
- door_marker_color = "#3153d2"
- left_margin       = 13
- top_margin        = 34

%span.hidden#active_x_plot      0
%span.hidden#active_y_plot      0
%span.hidden#door_fontsize      #{door_fontsize}
%span.hidden#door_marker_color  #{door_marker_color}
%span.hidden#left_margin        #{left_margin}
%span.hidden#top_margin         #{top_margin}
%span.hidden#font_size          #{fontsize}
%span.hidden#marker_color       #{map_marker_color}

- if is_svg
  = render partial: "sitemaps/svg_uploader"
- else
  = render partial: "sitemaps/image_uploader"

%h4{:style => "color: grey;"}
  %p
    Select units to add a marker to the map. If nothing appears in the list, then there are no additional units to add.
  - unless is_svg
    %p
      Drag and drop markers to reposition them on the property map.
  %p
    Click "Grid" to add a grid overlay to the map to make positioning the plots easier.
  %p
    Click "Manage Amenities" to upload amenity images and plot them on the map.
.box.box-info.add-plan
  .box-header{ id: is_svg ? "svg_header" : "image_header" }
    %h3.box-title
      Plot Units on Property Map
      - if is_svg
        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnSitemapSvgPopover","data-content" => " "}
          %span#propertyDetailNameText
            Once you have selected unit(s) to plot, click on the correct position on the map to plot it. You can also click on a plot to see which units are associated with it; add a unit; or delete the marker.
      - else
        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnSitemapPopover","data-content" => " "}
          %span#propertyDetailNameText
            Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.
      %span

    .btn-btn-danger.mt-10
      = link_to "MANAGE AMENITIES <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Click on 'Manage Amenities' to switch from plotting units to uploading and plotting amenity images.</span></i>".html_safe , community_amenities_path(community), :class=>"btn btn-success loader_class"
      
      %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>"showHideOverlayGrid(this);"}
        GRID OVERLAY
        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapGridOverlayPopover","data-content" => " "}
          %span#propertyDetailNameText{:style => "font-weight: normal;"}
            Add a grid overlay to the map to make it easier to see if the markers are straight.

      - unless is_svg
        - if !sitemap.is_ocr_enabled
          = link_to "Enable Suggestions <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Enabling suggestions will highlight possible matches on the map when units are selected from the list. You still have to click on the map to plot the marker for each unit/unit group.</span></i>".html_safe , "/communities/#{community.id}/suggest_sitemap_units?is_ocr_enabled=#{!sitemap.is_ocr_enabled}" , :class=>"btn btn-success loader_class"
        - else 
          = link_to "Disable Suggestions <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Enabling suggestions will highlight possible matches on the map when units are selected from the list. You still have to click on the map to plot the marker for each unit/unit group.</span></i>".html_safe , "/communities/#{community.id}/suggest_sitemap_units?is_ocr_enabled=#{!sitemap.is_ocr_enabled}" , :class=>"btn btn-success loader_class enable-suggestions-btn"

      - if current_user.is_super_admin?
        - unless is_svg
          = link_to "Auto Plot <i class='propertyDetailName loader_class fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Use Auto-plotting to add markers only when unit names in list and on map match exactly. All markers will be automatically added to the map.</span></i>".html_safe , "/communities/#{community.id}/sitemap_auto_plot_units" , :class=>"btn btn-success loader_class"

        %a.btn.btn-danger{"data-name" => "sitemap's plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{community.id}/remove_plots#{is_svg ? "?svg_deletion=true" : ''}"} RESET ALL PLOTS

      - unless is_svg
        - if community.self_tour and community.auto_wayfinding
          %button.btn.btn-primary.grid-overlay{:type=>"button",id:"hallway_btn",:onclick=>'plotting_hallways($(this))'}Start Plotting Hallways
        - if false && community.enable_locks and community.self_tour and community.auto_wayfinding
          %button.btn.btn-success{onclick: 'start_access_point_plot(event)'}
            Add Access Point
            %i.propertyDetailName.fa.fa-question-circle
              %span#propertyDetailNameText{:style => "font-weight: normal;"}
                Add Access point in hallways that are not associated with any specific unit or amenity

  / /.box-header
  / form start
  - unless is_svg
    = render partial: 'shared/hidden_locks_data', locals: {community: community, all_locks: all_locks, locks_present_hash: current_locks_provider}

  %form.form-horizontal
    .box-body.map-body-top
      .row.style{ style: "display: flex;" }
        .col-lg-3.multi-select-units{ class: is_svg ? "select-units-on-svg" : "select-units-on-page" }
          %h5.mt-40.mb-20
            SELECT UNITS TO PLOT
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapSelectPlotToUnitsPopover","data-content" => " "}
              %span#propertyDetailNameText{:style => "font-weight: normal;"}
                You can select one or multiple units to plot in one position (with one marker) on the map. If no units appear in the list, that means that all units that have been imported or entered have already been plotted on the map.

          %select.amenities-list.form-control{:multiple=>"multiple"}
            - if community_units.present?
              - community_units.each do |u|
                - u.building = "" if u.building == nil
              - community_units = community_units.sort_by {|obj| obj.marketing_name.to_i}
              - community_units = community_units.sort_by {|obj| obj.building.to_i}
            - community_units.each do |unit|
              - x_plot, y_plot = coords = (is_svg ? (unit.svg_coordinates) : [unit.x_plot, unit.y_plot].map(&:to_i))
              - if coords.sum.zero? && unit.provider_unit_id.present?
                - if unit.building != nil && unit.building != ""
                  %option{:value=>unit.provider_unit_id}= "#{unit.building}-#{unit.marketing_name}"
                - elsif community.data_provider == "yardi"
                  %option{:value => "#{unit.provider_unit_id}"}= unit.provider_unit_id
                - else
                  %option{:value=>unit.provider_unit_id}= "#{unit.marketing_name}"

              - units_arr.push({ providerId: unit.provider_unit_id, xPlot: x_plot, yPlot: y_plot, name: unit.id.to_s, svgPoint: is_svg })

          %h5.mt-40 SELECTED UNITS
          .add-plan.mt-10.mb-20
            %ul#selected-units
          %label#newmsg Place marker for selected units on Map

        .col-lg-9.p-0{ id: is_svg ? "svg-container" : "image-container" }
          = render partial: 'shared/zoom_control_buttons'
          .mapLoading.hidden
          - svg_data = svg_image_url_and_dimensions(sitemap) if is_svg
          .map-block{ style: "position: relative; #{svg_data && svg_data.values_at(:width, :height).sum.zero? ? 'display: flex; justify-content: center; align-items: center;' : ''}" }
            .assetLoader.hidden
            .plot-image{data: svg_data, id: is_svg ? 'svg_map' : 'map', style: "position: relative" }
              .grid-graph.hidden
              - if is_svg
                - unless sitemap.svg_image.present?
                  = image_tag "default.jpeg", name: "viewArea", id: "viewArea", draggable: "false", class: 'viewArea', data: { 'map_id' => "map" }
                - units_by_plotted_doors_order.each do |unit|
                  - if unit.pointer_data.present?
                    - x_plot, y_plot = coords = unit.svg_coordinates
                    - if coords.sum.positive?
                      .hidden{ class: "svg-h-#{x_plot}-#{y_plot}", id: "h-#{unit.provider_unit_id}", **(fetch_unit_info_struct_for_ploting(unit, @floorplans_map[unit.floorplan_id])[:data_attributes].except(%i[data-target data-toggle])) }
              - else
                - width, height = image_original_dimensions(sitemap).values
                = image_tag (sitemap.validated_image_url || "default.jpeg"), name: "viewArea", id: "viewArea", draggable: "false", class: 'viewArea', data: { map_id: "map", height: height, width: width }
                - x_plot, y_plot = coords = [community.community_tour.x_plot, community.community_tour.y_plot].map(&:to_i)
                - if coords.sum.positive?
                  = link_to image_tag("/assets/star.png", style: 'width:15px;'), "#", :class => "start-point marker", 'data-toggle' => "tooltip", :title => "Starting Point", :id => "m_", :style => "left:#{x_plot}px; top:#{y_plot}px; position:absolute;", "data-name" => "plot", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{community.id}/tours/#{community.community_tour.id}/resetStartingPoint"

                - units_by_plotted_doors_order.each do |unit|
                  - x_plot, y_plot = coords = [unit.x_plot, unit.y_plot].map(&:to_i)
                  - if coords.sum.positive?
                    - unless coordinates_array.include?(coords)
                      - coordinates_array.push(coords)
                      - unit_door_exists = unit.door.present? ? true : false

                      %p{class: "marker", style: "left:#{x_plot - left_margin}px; top:#{y_plot - top_margin}px; position:absolute"}
                        = link_to "javascript:void(0);", { id: "m_#{unit.provider_unit_id}", style: "font-size: #{fontsize}px", title: (unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, data: {toggle: "tooltip", toggle: "modal", name: "plot", target: "#markers-modal", provider: community.data_provider, provider_unit_id: unit.provider_unit_id, title: (unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, href: "/communities/#{community.id}/units/#{unit.provider_unit_id}/remove_plot", horizontal: unit.x_plot, vertical: unit.y_plot, pointer_data: unit.pointer_data.to_json, unit_form_url: "/communities/#{community.id}/units/#{unit.id}/adjust_position", plotted_category: "unit"}} do
                          %i{class: "fas fa-map-marker-alt", style: "color: #{map_marker_color};"}

                        - if !unit_door_exists and community.self_tour and community.auto_wayfinding
                          = link_to "javascript:void(0);", { id: "plus_#{unit.provider_unit_id}", style: "margin-left: -6px;", title:  "Click to plot this unit(s) door", data: {toggle: "tooltip", plotted_category: "create_unit_door"}, onclick: 'plot_entry_point(event)'} do
                            %i{class: "fa fa-plus-circle fa-xs", style: "color: #59de83; font-size: #{fontsize.to_i/2}px;" }
                          - unit_door_exists = false

                      - if unit_door_exists and community.self_tour and community.auto_wayfinding
                        - unit_door = unit.door
                        = link_to "javascript:void(0);", { id: "door_#{unit.provider_unit_id}", class: "marker", style: "left:#{unit_door.x_plot}px; top:#{unit_door.y_plot}px; position:absolute; font-size: #{door_fontsize}px", title: "#{unit_door.name}", data: { provider: community.data_provider,  provider_unit_id: unit.provider_unit_id, title: "#{unit_door.name}", door_id: "#{unit_door.id}", toggle: "tooltip", toggle: "modal", target: "#ajax-doors-detail-modal", plotted_category: "unit_door"}} do
                          %i{class: "fa fa-sign-in fa-xs", style: "color: #{door_marker_color};"}

                    - else
                      - puts "duplicated.........."
                    .hidden{ class: "h-#{x_plot}-#{y_plot}", id: "h-#{unit.provider_unit_id}", **(fetch_unit_info_struct_for_ploting(unit, @floorplans_map[unit.floorplan_id])[:data_attributes].except(%i[data-target data-toggle])) }
                
                - if false && community.enable_locks and community.self_tour and community.auto_wayfinding
                  - coordinates_array = []
                  - access_points.each do |access_point|
                    - x_plot, y_plot = coords = [access_point.x_plot, access_point.y_plot].map(&:to_i)
                    - unless coordinates_array.include?(coords)
                      - coordinates_array.push(coords)

                      = link_to open_access_point_modal_community_sitemap_access_point_path(community, sitemap, access_point, x_plot: x_plot, y_plot: y_plot, plotted_id: access_point.id, locks_present_hash: current_locks_provider.to_json), { id: "access_point_#{access_point.id}", class: "marker", style: "left: #{x_plot}px; top: #{y_plot}px; position: absolute; font-size: #{door_fontsize.to_i/2}px", title: "#{access_point.name}", data: {door_id: "#{access_point.id}", toggle: "tooltip", remote: true, plotted_category: "access_point"}} do
                        %i{class: "fa fa-lock", style: "color: #66bf60"}

    #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
      %i.icon-screenshot

- redirect_path = plotexp_community_sitemaps_path(community)
= render partial: 'markers/shared/show_unit_marker_modal', locals: { is_svg: is_svg, redirect_path: redirect_path }
= render partial: 'markers/shared/add_plots_to_marker', locals: { is_svg: is_svg, units: community_units, redirect_path: redirect_path, form_tag_url: "/communities/#{community.id}/add_plots" }
- unless is_svg
  = render partial: 'markers/shared/add_door_marker_modal', locals: { community: community }
  = render partial: 'markers/shared/remaining_doors_modal'


:javascript
  var left_margin = #{raw left_margin}
  var top_margin = #{raw top_margin}
  var svgMode = false;

  $(document).ready(function() {
    map_marker_color = toRgbColor("#{raw map_marker_color}")

    $(document).on("click", "#sitemapDisplayPricePopoverClose" , function(){
        $('html, body').animate({ scrollTop: 650 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitemapUploadFilePopover"]').popover({
          html: true,
          template: '<div class="popover plotexp-uploading-popover" style="width: max-content;"><div class="arrow plotexp-uploading-popover-arrow"></div><div class="popover-body popover-padding">Uploading a file will change the property map image that appears in the Pynwheel app. Careful! Do not change the file unless you are sure that it is the exact same dimensions as the one already loaded, or the markers will all be in the wrong position.</div><div class="popover-footer"><a id="sitemapUploadFilePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
    });
    $("#sitemapUploadFilePopoverClose").on("click" , function(){
        $('html, body').animate({ scrollTop: 950 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="plotUnitOnSitemapPopover"]').popover({
          html: true,
          template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.</div><div class="popover-footer"><a id="plotUnitOnSitemapPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
    });
    $("#plotUnitOnSitemapPopoverClose").on("click" , function(){
        $('html, body').animate({ scrollTop: 1000 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitemapManageAmenitiesPopover"]').popover({
          html: true,
          template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding" style="color: ;">Click on "Manage Amenities" to switch from plotting units to uploading and plotting amenity images.</div><div class="popover-footer"><a id="sitemapManageAmenitiesPopoverClose" href="" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
    });
    $("#sitemapManageAmenitiesPopoverClose").on("click" , function(){
        $('html, body').animate({ scrollTop: 1100 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitemapGridOverlayPopover"]').popover({
          html: true,
          template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Add a grid overlay to the map to make it easier to see if the markers are straight.</div><div class="popover-footer"><a id="sitemapGridOverlayPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
    });
    $("#sitemapGridOverlayPopoverClose").on("click" , function(){
        $('html, body').animate({ scrollTop: 1200 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitemapSelectPlotToUnitsPopover"]').popover({
          html: true,
          template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">You can select one or multiple amenity images to plot in one position (with one marker) on the map. If no units appear in the list, that means that all units that have been imported or entered have already been plotted on the map.</div><div class="popover-footer"><a id="sitemapSelectPlotToUnitsPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
        showHideOverlayGrid(document.querySelector('#map.plot-image'));
    });
    $("#sitemapSelectPlotToUnitsPopoverClose").on("click" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitemapUploadSvgPopover"]').popover({
          html: true,
          template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Uploading an svg will change the property map image that appears in the Pynwheel app. Careful! Do not change the file if you are not sure about replotting all the plots.</div><div class="popover-footer"><a id="sitemapUploadSvgPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
