-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Plot Amenities - Pynwheel"
%section.is-amenity
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    %h4{:style => "color: grey;"}
      %p
        Select amenity images to add a marker to the map. If nothing appears in the list, then there are no additional amenity images to add.
      %p
        Drag and drop markers to reposition them on the property map.
      %p
        Click "Plot Units" to switch to plot units on the map.
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot Property
          %span Map Amenities
          %span.hidden#active_x_plot 0
          
          %span.hidden#active_y_plot 0

          - if @community.theme_name.include?('gables')
            - marker_color = @community.design.amenity_map_marker_color.present? ? @community.design.amenity_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'modernist'
            - marker_color = @community.design.modernists_amenity_map_marker_color == 'no color' || @community.design.modernists_amenity_map_marker_color == '' ? (@community.design.primary_color.present? ? @community.design.primary_color : '#cf492f') : @community.design.modernists_amenity_map_marker_color
          - elsif @community.theme_name == 'futurist'
            - marker_color = @community.design.futurist_amenity_map_marker_color.present? ? @community.design.futurist_amenity_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'expressionist'
            - marker_color = @community.design.expressionist__amenity_map_marker_color.present? ? @community.design.expressionist__amenity_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'panther'
            - marker_color = @community.design.panther_amenity_map_marker_color.present? ? @community.design.panther_amenity_map_marker_color : "#d37474"
          - else
            - marker_color = 'rgba(247, 0, 0, 0.61)'

          - if @community.theme_name.include?('gables')
            - marker_font_size = @community.design.amenity_map_marker_size_integer.present? ? @community.design.amenity_map_marker_size_integer : 30
          - elsif @community.theme_name == 'modernist'
            - marker_font_size = @community.design.modernist_amenity_map_size.present? ? @community.design.modernist_amenity_map_size : 30
          - elsif @community.theme_name == 'futurist'
            - marker_font_size = @community.design.futurist_amenity_map_size.present? ? @community.design.futurist_amenity_map_size : 30
          - elsif @community.theme_name == 'expressionist'
            - marker_font_size = @community.design.expressionist_amenity_map_size.present? ? @community.design.expressionist_amenity_map_size : 30
          - elsif @community.theme_name == 'panther'
            - marker_font_size = @community.design.panther_amenity_map_size.present? ? @community.design.panther_amenity_map_size : 30
          - else
            - marker_font_size = 30
          - marker_font_size2 = marker_font_size
          -#- marker_font_size = @community.design.amenity_map_marker_size_integer
          -#- marker_color = @community.theme_name.include?('gables') ? @community.design.amenity_map_marker_color : (@community.theme_name == 'modernist' ? (@community.design.modernist_map_marker_color == 'no color' || @community.design.modernists_amenity_map_marker_color == '' ? (@community.design.primary_color.present? ? @community.design.primary_color : '#cf492f') : @community.design.modernists_amenity_map_marker_color) : 'rgba(247, 0, 0, 0.61)')
          - marker_font_size = marker_font_size -5
          - camera_font_size = marker_font_size / 2
          - camera_margin = (marker_font_size2 <= 27 ? 3 : (marker_font_size2 <= 30 ? 4 : (marker_font_size2 <= 33 ? 5 : (marker_font_size2 <= 35 ? 6 : 6))))
          %span.hidden#marker-font-size #{marker_font_size}
          %span.hidden#marker-color #{marker_color}
          %span.hidden#camera-margin #{camera_margin}

        .btn-btn-danger.mt-10
          = link_to "ADD AMENITY IMAGES", community_amenities_path(@community), class: "btn btn-primary"
          = link_to "PLOT UNITS", plotexp_community_sitemaps_path(@community), class: "btn btn-primary"
          %a.btn.btn-danger{"data-name" => "sitemap's amenities plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/sitemaps/#{@sitemap.id}/amenities/remove_amenities_plot"} RESET ALL PLOTS
      / /.box-header
      / form start
      %form.form-horizontal
        .box-body.map-body-top
          .row
            .col-lg-9#container.p-0
              .map-block{:style=>"position: relative;"}
                .plot-image#map
                  = image_tag @sitemap.image.present? ? @sitemap.image.url : "default.jpeg"
                  - @sitemap.amenities.each do |amenity|
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                      = link_to "<i class='custom-icon' style=' height:#{marker_font_size}px; width: #{marker_font_size}px; border: 2px solid  #{marker_color};'  ><i class='fas fa-camera-retro' style=' font-size:#{camera_font_size}px; color: #{marker_color}; margin-top:#{camera_margin}px;'   ></i></i>".html_safe, "#", :class => "marker", 'data-toggle' => "tooltip", :title => amenity.name, :id => "m_#{amenity.id}", :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;", "data-name" => "plot", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/sitemaps/#{@sitemap.id}/amenities/#{amenity.id}/remove_amenity"
            .col-lg-3
              %h5.mt-40.mb-20 SELECT AMENITIES TO PLOT
              .imageselect
                .show-categories
                  = "-- select amenity --"
                %ul#imageselect{:style => "display: none;"}
                  - amenity_arr = []
                  - @amenities.each do |amenity|
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i == 0
                      %li{"data-id" => "#{amenity.id}","data-name" => "#{amenity.name}"}
                        %a
                          = image_tag amenity.image.present? ? amenity.image.url : "upload-image.png"
                          %span.ml-5
                            = amenity.name
                    - amenity_arr.push([amenity.id.to_s, amenity.x_plot.to_i, amenity.y_plot.to_i, true, amenity.name])

              %h5.mt-40 SELECTED AMENITIES
              .add-plan.mt-10.mb-20
                %ul#selected-units
              / %button.btn.btn-success#new{:type => "button"} PLOT NOW
              %label#newmsg Place marker for selected amenities on Map
        #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
          %i.icon-screenshot
:javascript
  var arr = #{raw amenity_arr}
  var lmargin = 0
  var rmargin = 0
  var community_id = #{params[:community_id]}
  var addmode = false;
  var sitemap_id = #{@sitemap.id}
  var isPlotAmenity = true;