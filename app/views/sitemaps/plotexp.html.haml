= render '/font_awesome_v5'
- content_for :title, "Property Map - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          INTERACTIVE MAP (Garden Style Property)
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_tag community_save_apartment_settings_path(@community) ,{:class => 'apartment-settings-form'} do
            = hidden_field_tag "community_id", @community.id
            - if @community.pynwheel_touch_enabled?
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Page Name
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapPageNamePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Changing the Page Name will change the menu label for the interactive map and dynamic floor plan gallery page in the Pynwheel app.
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :apartment_page_name, @community.apartment_page_name, :class=>"form-control apartment-setting-field"

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  
                  Show property map page
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "siteShowPropertyMapPagePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not this page appears in the Pynwheel app.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_sitemap, true, @community.display_sitemap, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_sitemap"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display floor plan gallery
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayFloorplanGalleryPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching display floor plan gallery will change whether or not the dynamic floor plan gallery appears in the app.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_floorplan_gallery, true, @community.display_floorplan_gallery, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_floorplan_gallery"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display on home page
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitempaDisplayHomepagePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not there is a menu button for this page on the home page of the Pynwheel app.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_unit_on_homepage, true, @community.display_unit_on_homepage, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_unit_on_homepage"}
                    %span.pl-15 Yes
            
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Auto Zoom on Site Map Image
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapAutoZoom","data-content" => ""}
                    %span#propertyDetailNameText
                      When toggled to “Yes” the image will automatically zoom to the center of the site map image on the site map page.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :sitemap_auto_zoom, true, @community.sitemap_auto_zoom, class: "apartment-setting-field"
                    %label.label-primary{:for => "sitemap_auto_zoom"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Building Number
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayBuildingPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not building number is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_building, true, @community.display_building, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_building"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Price
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not pricing is displayed on the interactive property map and in the floor plan gallery.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_rent, true, @community.display_rent, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_rent"}
                    %span.pl-15 Yes

              .form-group{ style: "display: #{'none' if @community.display_rent}" }
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Pricing Message (Optional)
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :pricing_message, @community.pricing_message, class: "form-control apartment-setting-field", placeholder: "Enter pricing message"

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Pricing Options (Matrix)
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not pricing options is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_pricing_options, true, @community.display_pricing_options, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_pricing_options"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Fees
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Display Fees will import any additional fees from the data feed if possible to the application.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_additional_fee, true, @community.display_additional_fee, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_additional_fee"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Manually Enter Fees
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      When "Manually Enter Fees" is toggled to "Yes" then that will override any fee information coming from the data feed.
          
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_manual_additional_fee, true, @community.display_manual_additional_fee, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_manual_additional_fee"}
                    %span.pl-15 Yes

              .form-group{style: "height: 200px"}
                .col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = text_area_tag :additional_fee, @community.additional_fee, class: 'form-control mb-20 wysihtml5', placeholder: 'Enter Additional Fees and Pricing'
                  .text-right
                    = button_tag 'Save', type: 'submit', class: 'btn btn-success'

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Available date
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not available date is displayed on the interactive property map and in the floor plan gallery.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_available_date, true, @community.display_available_date, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_available_date"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display availability over 120 days
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Toggle to display units availability on all application over 120 days. Default is 'Yes'. Set to 'No' to limit availability to 120 days or less.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :units_availability_over_120_days, true, @community.units_availability_over_120_days, class: "apartment-setting-field"
                    %label.label-primary{:for => "units_availability_over_120_days"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Show property map key
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :show_property_map_key, true, @community.show_property_map_key, class: "apartment-setting-field"
                    %label.label-primary{:for => "show_property_map_key"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Property map key text
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :show_property_map_key_text, @community.show_property_map_key_text, :class=>"form-control apartment-setting-field"
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Show amenity key
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :show_amenity_key, true, @community.show_amenity_key, class: "apartment-setting-field"
                    %label.label-primary{:for => "show_amenity_key"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Amenity key text
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :show_amenity_key_text, @community.show_amenity_key_text, :class=>"form-control apartment-setting-field"
          
            - elsif (@community.pynwheel_map_enabled? || @community.pynwheel_tour_enabled?)
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Building Number
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayBuildingPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not building number is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_building, true, @community.display_building, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_building"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Price
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not pricing is displayed on the interactive property map and in the floor plan gallery.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_rent, true, @community.display_rent, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_rent"}
                    %span.pl-15 Yes
              
              .form-group{ style: "display: #{'none' if @community.display_rent}" }
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Pricing Message (Optional)
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :pricing_message, @community.pricing_message, class: "form-control apartment-setting-field", placeholder: "Enter pricing message"

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Pricing Options (Matrix)
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not pricing options is displayed on all products (Pynwheel Touch Map, Pynwheel Tour pricing, and Pynwheel Map).
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_pricing_options, true, @community.display_pricing_options, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_pricing_options"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Fees
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Display Fees will import any additional fees from the data feed if possible to the application.
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_additional_fee, true, @community.display_additional_fee, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_additional_fee"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Manually Enter Fees
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      When "Manually Enter Fees" is toggled to "Yes" then that will override any fee information coming from the data feed.
          
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_manual_additional_fee, true, @community.display_manual_additional_fee, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_manual_additional_fee"}
                    %span.pl-15 Yes

              .form-group{style: "height: 200px"}
                .col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = text_area_tag :additional_fee, @community.additional_fee, class: 'form-control mb-20 wysihtml5', placeholder: 'Enter Additional Fees and Pricing'
                  .text-right
                    = button_tag 'Save', type: 'submit', class: 'btn btn-success'

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display Available date
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Switching this will change whether or not available date is displayed on the interactive property map and in the floor plan gallery.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :display_available_date, true, @community.display_available_date, class: "apartment-setting-field"
                    %label.label-primary{:for => "display_available_date"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Display availability over 120 days
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapDisplayPricePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Toggle to display units availability on all application over 120 days. Default is 'Yes'. Set to 'No' to limit availability to 120 days or less.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :units_availability_over_120_days, true, @community.units_availability_over_120_days, class: "apartment-setting-field"
                    %label.label-primary{:for => "units_availability_over_120_days"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                  Show amenity key
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :show_amenity_key, true, @community.show_amenity_key, class: "apartment-setting-field"
                    %label.label-primary{:for => "show_amenity_key"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Amenity key text
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = text_field_tag :show_amenity_key_text, @community.show_amenity_key_text, :class=>"form-control apartment-setting-field"

            .form-group
              .col-lg-12.col-md-12
                %button.btn-success.done_btn{:onclick => "sitemap_goBack()"}
                  %i.fa.fa-plus-circle
                  DONE

              = submit_tag 'Save', class: "hidden"

    %h4{:style => "color: grey;"}
      %p
        To change the image of the property map, upload a new image here. Please note that images that are too small may appear pixelated.
    
    .box.box-widget.panel-box.alert-danger
      %h5{style: "margin-left: 15px; margin-top: 0px;"}
        Note: If the new image uploaded is not the exact same dimensions as the existing image, the unit and amenity markers will not be in the correct place on the map.
    
    
    %span.btn.btn-primary.btn-file{:onclick=>"$('#sitemap-image-upload-holder').click();"}
      %i.fa.fa-upload
      Upload File
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapUploadFilePopover","data-content" => " "}
      %span#propertyDetailNameText{:style => "font-weight: normal;"}
        Uploading a file will change the property map image that appears in the Pynwheel app. Careful! Do not change the file unless you are sure that it is the exact same dimensions as the one already loaded, or the markers will all be in the wrong position.
    %br
    
    .text-center.image-upload.home-page-drag-box#sitemap-image-upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload
    %h4{:style => "color: grey;"}
      %p
        Select units to add a marker to the map. If nothing appears in the list, then there are no additional units to add.
      %p
        Drag and drop markers to reposition them on the property map.
      %p
        Click "Grid" to add a grid overlay to the map to make positioning the plots easier.
      %p
        Click "Manage Amenities" to upload amenity images and plot them on the map.
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot Units on Property Map
          %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnSitemapPopover","data-content" => " "}
            %span#propertyDetailNameText
              Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.
          %span
          %span.hidden#active_x_plot 0
          
          %span.hidden#active_y_plot 0


          - if @community.theme_name.include?('gables')
            - marker_color = @community&.design&.property_map_color || "#d37474"
          - elsif @community.theme_name == 'modernist'
            - marker_color = ( ['no color', ''].include?(@community&.design.modernist_map_marker_color) ) ? (@community&.design&.primary_color || '#cf492f') : @community&.design&.modernist_map_marker_color
          - elsif @community.theme_name == 'futurist'
            - marker_color = @community&.design&.futurist_property_map_marker_color || "#d37474"
          - elsif @community.theme_name == 'expressionist'
            - marker_color = @community&.design&.expressionist_property_map_marker_color || "#d37474"
          - elsif @community.theme_name == 'panther'
            - marker_color = @community&.design&.panther_property_map_marker_color || "#d37474"
          - else
            - marker_color = 'rgba(247, 0, 0, 0.61)'
          -#-
          - if @community.theme_name.include?('gables')
            - fontsize =@community&.design&.property_map_size_integer || 30
          - elsif @community.theme_name == 'modernist'
            - fontsize = @community&.design&.modernist_property_map_size || 30
          - elsif @community.theme_name == 'futurist'
            - fontsize = @community&.design&.futurist_property_map_size || 30
          - elsif @community.theme_name == 'expressionist'
            - fontsize = @community&.design&.expressionist_property_map_size || 30
          - elsif @community.theme_name == 'panther'
            - fontsize = @community&.design&.panther_property_map_size || 30
          - else
            - fontsize = 30

          - left_margin = (((@community&.design&.property_map_size_integer&.to_f || 30) - 25) / 2.0)&.to_i
          - right_margin = ((20.0 / 25.0).to_f * ( @community&.design&.property_map_size_integer || 30 ))&.to_i

          %span.hidden#left_margin #{left_margin}
          %span.hidden#right_margin #{right_margin}
          %span.hidden#font_size #{fontsize}
          %span.hidden#marker_color #{marker_color}

          - door_fontsize     = fontsize
