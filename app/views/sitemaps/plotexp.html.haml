                Show amenity key
                -#%i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapPageNamePopover","data-content" => " "}
                -#  %span#propertyDetailNameText
                -#    Changing the Page Name will change the menu label for the interactive map and dynamic floor plan gallery page in the Pynwheel app.
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                = text_field_tag :show_amenity_key_text, @community.show_amenity_key_text, :class=>"form-control apartment-setting-field"



            = submit_tag 'Save', class: "hidden"
    -#.box.box-info.add-plan
    -#  .box-header
    -#    %h3.box-title
    -#      PROPERTY MAP PAGE (Garden Style Property)
    %h4{:style => "color: grey;"}
      %p
        To change the image of the property map, upload a new image here.
      %p
        Images will appear at a size of 1412 x 932 px. Please note that images that are too small may appear pixelated.

    .box.box-widget.panel-box.alert-danger
      %h5{style: "margin-left: 15px; margin-top: 0px;"}
        Note: If the new image uploaded is not the exact same dimensions as the existing image, the unit and amenity markers will not be in the correct place on the map.


    %span.btn.btn-primary.btn-file{:onclick=>"$('#sitemap-image-upload-holder').click();"}
      %i.fa.fa-upload
      Upload File
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapUploadFilePopover","data-content" => " "}
      %span#propertyDetailNameText{:style => "font-weight: normal;"}
        Uploading a file will change the property map image that appears in the Pynwheel app. Careful! Do not change the file unless you are sure that it is the exact same dimensions as the one already loaded, or the markers will all be in the wrong position.

    .text-center.image-upload.home-page-drag-box#sitemap-image-upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload
    %h4{:style => "color: grey;"}
      %p
        Select units to add a marker to the map. If nothing appears in the list, then there are no additional units to add.
      %p
        Drag and drop markers to reposition them on the property map.
      %p
        Click "Grid" to add a grid overlay to the map to make positioning the plots easier.
      %p
        Click "Manage Amenities" to upload amenity images and plot them on the map.
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot Units on Property Map
          %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "plotUnitOnSitemapPopover","data-content" => " "}
            %span#propertyDetailNameText
              Once you have selected unit(s) to plot, click on the correct position on the map to place the marker. You can drag and drop each marker to reposition it. You can also click on a marker to see which units are associated with it; add a unit; or delete the marker.
          %span
          %span.hidden#active_x_plot 0

          %span.hidden#active_y_plot 0

          - if @community.theme_name.include?('gables')
            - marker_color = @community.design.property_map_color.present? ? @community.design.property_map_color : "#d37474"
          - elsif @community.theme_name == 'modernist'
            - marker_color = @community.design.modernist_map_marker_color == 'no color' || @community.design.modernist_map_marker_color == '' ? (@community.design.primary_color.present? ? @community.design.primary_color : '#cf492f') : @community.design.modernist_map_marker_color
          - elsif @community.theme_name == 'futurist'
            - marker_color = @community.design.futurist_property_map_marker_color.present? ? @community.design.futurist_property_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'expressionist'
            - marker_color = @community.design.expressionist_property_map_marker_color.present? ? @community.design.expressionist_property_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'panther'
            - marker_color = @community.design.panther_property_map_marker_color.present? ? @community.design.panther_property_map_marker_color : "#d37474"
          - else
            - marker_color = 'rgba(247, 0, 0, 0.61)'

          - if @community.theme_name.include?('gables')
            - fontsize = @community.design.property_map_size_integer.present? ? @community.design.property_map_size_integer : "30"
          - elsif @community.theme_name == 'modernist'
            - fontsize = @community.design.modernist_property_map_size.present? ? @community.design.modernist_property_map_size : "30"
          - elsif @community.theme_name == 'futurist'
            - fontsize = @community.design.futurist_property_map_size.present? ? @community.design.futurist_property_map_size : "30"
          - elsif @community.theme_name == 'expressionist'
            - fontsize = @community.design.expressionist_property_map_size.present? ? @community.design.expressionist_property_map_size : "30"
          - elsif @community.theme_name == 'panther'
            - fontsize = @community.design.panther_property_map_size.present? ? @community.design.panther_property_map_size : "30"
          - else
            - fontsize = '30'

          -#- fontsize = @community.design.property_map_size_integer
          - left_margin = ((@community.design.property_map_size_integer.to_f - 25) / 2.0).to_i
          - right_margin = ((20.0 / 25.0).to_f * (@community.design.property_map_size_integer)).to_i
          -#- marker_color = @community.theme_name.include?('gables') ? @community.design.property_map_color : (@community.theme_name == 'modernist' ? (@community.design.modernist_map_marker_color == 'no color' || @community.design.modernist_map_marker_color == '' ? (@community.design.primary_color.present? ? @community.design.primary_color : '#cf492f') : @community.design.modernist_map_marker_color) : 'rgba(247, 0, 0, 0.61)')
          %span.hidden#font_size #{fontsize}
          %span.hidden#left_margin #{left_margin}
          %span.hidden#right_margin #{right_margin}
          %span.hidden#marker_color #{marker_color}

        .btn-btn-danger.mt-10
          = link_to "MANAGE AMENITIES <i class='propertyDetailName fa fa-question-circle' data-toggle='sitemapManageAmenitiesPopover' data-content='test' ><span id='propertyDetailNameText' style='font-weight: normal;'>Click on 'Manage Amenities' to switch from plotting units to uploading and plotting amenity images.</span></i>".html_safe , community_amenities_path(@community), :class=>"btn btn-success"

          %button.btn.btn-primary.grid-overlay{:type=>"button",:onclick=>"showHideOverlayGrid();"}
            GRID OVERLAY
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapGridOverlayPopover","data-content" => " "}
              %span#propertyDetailNameText{:style => "font-weight: normal;"}
                Add a grid overlay to the map to make it easier to see if the markers are straight.
          - if current_user.is_super_admin?
            %a.btn.btn-danger{"data-name" => "sitemap's plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/remove_plots"} RESET ALL PLOTS
      / /.box-header
      / form start
      %form.form-horizontal
        .box-body.map-body-top
          .row
            .col-lg-9#container.p-0{:style => "float: right;"}
              .map-block{:style=>"position: relative;"}
                #map.plot-image
                  .grid-graph.hidden
                  = image_tag @sitemap.present? && @sitemap.image.present? ? @sitemap.image.url : "default.jpeg"
                  - units = @units.sort_by{|u| u.marketing_name}
                  - coordinates_array = []

                  - units.each do |unit|
                    - if unit.x_plot.to_i + unit.y_plot.to_i > 0
                      - unless coordinates_array.include?([unit.x_plot,unit.y_plot])
                        - coordinates_array.push([unit.x_plot - left_margin,unit.y_plot - right_margin])
                        = link_to "<i class='fas fa-map-marker-alt' style='color: #{marker_color};'></i>".html_safe, "#", :class => "marker", 'data-toggle' => "tooltip", :title => (unit.building.present? ? unit.building + '-' : '') + unit.marketing_name, :id => "m_#{unit.provider_unit_id}", :style => "left:#{unit.x_plot - left_margin}px; top:#{unit.y_plot - right_margin}px; position:absolute; font-size: #{fontsize}px", "data-name" => "plot", "data-target" => "#markers-modal", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/units/#{unit.provider_unit_id}/remove_plot","data-horizontal"=>unit.x_plot,"data-vertical"=>unit.y_plot,"data-unit-form-url"=>"/communities/#{@community.id}/units/#{unit.id}/adjust_position"


                      .hidden{:class=>"h-#{unit.x_plot}-#{unit.y_plot}","data-title"=>(unit.building.present? ? unit.building + '-' : '') + unit.marketing_name,:id=>"h-#{unit.provider_unit_id}", "data-name" => "plot", "data-href" => "/communities/#{@community.id}/units/#{unit.provider_unit_id}/remove_plot","data-unit-form-url"=>"/communities/#{@community.id}/units/#{unit.id}/adjust_position"}
            .col-lg-3.multi-select-units.select-units-on-page{:style => "float: left;"}

              %h5.mt-40.mb-20
                SELECT UNITS TO PLOT
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapSelectPlotToUnitsPopover","data-content" => " "}
                  %span#propertyDetailNameText{:style => "font-weight: normal;"}
                    You can select one or multiple amenity images to plot in one position (with one marker) on the map. If no units appear in the list, that means that all units that have been imported or entered have already been plotted on the map.
              %select.amenities-list.form-control{:multiple=>"multiple"}
                - arr = []
                - if units.present?
                  - units.each do |u|
                    - u.building = "" if u.building == nil
                  - units = units.sort_by {|obj| obj.marketing_name.to_i}
                  - units = units.sort_by {|obj| obj.building.to_i}
                - units.each do |unit|
                  - if unit.x_plot.to_i + unit.y_plot.to_i == 0 and unit.provider_unit_id.present?
                    - if unit.building != nil && unit.building != ""
                      %option{:value=>unit.provider_unit_id}= "#{unit.building}-#{unit.marketing_name}"
                    - else
                      %option{:value=>unit.provider_unit_id}= "#{unit.marketing_name}"


                  - arr.push([unit.provider_unit_id, unit.x_plot.to_i - left_margin, unit.y_plot.to_i - right_margin, true, unit.id.to_s, 5 , 0])
              %h5.mt-40 SELECTED UNITS
              .add-plan.mt-10.mb-20
                %ul#selected-units
              / %button.btn.btn-success#new{:type => "button"} PLOT NOW
              %label#newmsg Place marker for selected units on Map
        #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
          %i.icon-screenshot
#markers-modal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header#u-name

      = form_tag "" do
        .modal-body
          = hidden_field_tag 'redirect_path' , plotexp_community_sitemaps_path(@community)
          .form-group.row
            %label.col-sm-2.col-form-label X Position
            .col-sm-10
              = text_field_tag "horizontal_position",0,:class=>"form-control"
          .form-group.row
            %label.col-sm-2.col-form-label Y Position
            .col-sm-10
              = text_field_tag "vertical_position", 0,:class=>"form-control"
          .unit-buttons
        .modal-footer
          = submit_tag "Update",:class=>"btn btn-primary"
          %a.btn.btn-danger.delete-marker-ok{"data-method"=>"delete"} Delete Marker
          %a.btn.btn-primary{:onclick=>"addMarker()"} Add Marker
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel

#add-marker-modal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header#add-marker-heading
        Add Marker
      = form_tag "/communities/#{@community.id}/add_plots" do
        .modal-body
          = hidden_field_tag 'redirect_path' , plotexp_community_sitemaps_path(@community)
          = hidden_field_tag 'add_horizontal_position'
          = hidden_field_tag 'add_vertical_position'
          = hidden_field_tag 'unit_provider_ids',"[]"
          .form-group.row
            %label.col-sm-2.col-form-label
            .col-sm-10.unit-selects-in-popup
              %select.amenities-list-on-popup.form-control{:multiple=>"multiple"}
                - if units.present?
                  - units.each do |u|
                    - u.building = "" if u.building == nil
                  - units = units.sort_by {|obj| obj.marketing_name.to_i}
                  - units = units.sort_by {|obj| obj.building.to_i}
                - units.each do |unit|
                  - if unit.x_plot.to_i + unit.y_plot.to_i == 0 and unit.provider_unit_id.present?
                    - if unit.building != nil && unit.building != ""
                      %option{:value=>unit.provider_unit_id}= "#{unit.building}-#{unit.marketing_name}"
                    - else
                      %option{:value=>unit.provider_unit_id}= "#{unit.marketing_name}"


        .modal-footer
          = submit_tag "Add",:class=>"btn btn-primary" 
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel

:javascript
  $('.apartment-setting-field').change(function(){
    $('.apartment-settings-form').submit();
  });

  var arr = #{raw arr};
  var lmargin = #{raw left_margin}
  var rmargin = #{raw right_margin}
  var community_id = #{params[:community_id]};
  var addmode = false;
  var sitemap_id = '#{@sitemap.id}';

  if (!#{current_user.welcome_sitemap_page})
    {
      $('[data-toggle="sitemapPageNamePopover"]').popover({
        html: true,
        template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding">Changing the Page Name will change the menu label for the interactive map and dynamic floor plan gallery page in the Pynwheel app.</div><div class="popover-footer"><a id="propertyDetailNameId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }

    $(document).on("click", "#propertyDetailNameId" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="siteShowPropertyMapPagePopover"]').popover({
        html: true,
        template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding">Switching this will change whether or not this page appears in the Pynwheel app.</div><div class="popover-footer"><a id="siteShowPropertyMapPagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#siteShowPropertyMapPagePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitemapDisplayFloorplanGalleryPopover"]').popover({
        html: true,
        template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding">Switching display floor plan gallery will change whether or not the dynamic floor plan gallery appears in the app.</div><div class="popover-footer"><a id="sitemapDisplayFloorplanGalleryPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#sitemapDisplayFloorplanGalleryPopoverClose" , function(){
        $('html, body').animate({ scrollTop: 200 });
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="sitempaDisplayHomepagePopover"]').popover({
        html: true,
        template: '<div class="popover" style="width: max-content;"><div class="arrow"></div><div class="popover-body popover-padding">Switching this will change whether or not there is a menu button for this page on the home page of the Pynwheel app.</div><div class="popover-footer"><a id="sitempaDisplayHomepagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });
