- content_for :title, "Plot Unit - Pynwheel"
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot Property
          %span Map Units
          %span.hidden#active_x_plot 0
          
          %span.hidden#active_y_plot 0
        .pull-right.btn-btn-danger
          %a.btn.btn-danger{"data-name" => "sitemap's plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/remove_plots"} Reset all plots
      / /.box-header
      / form start
      %form.form-horizontal
        .box-body.map-body-top
          .row
            .col-lg-9#container
              .map-block#map{:style=>"position: relative;"}
                = image_tag @sitemap.present? ? @sitemap.image.url : ""
                - units = @units.to_a.sort!{ |a,b| [a['building'].to_s,a['marketing_name'].to_s] <=> [b['building'].to_s,b['marketing_name'].to_s] }
                - units.each do |unit|
                  - if unit.x_plot.to_i + unit.y_plot.to_i > 0
                    = link_to "<i class='fa fa-asterisk'></i>".html_safe, "#", :class => "marker", 'data-toggle' => "tooltip", :title => unit.marketing_name, :id => "m_#{unit.marketing_name}", :style => "left:#{unit.x_plot}px; top:#{unit.y_plot}px; position:absolute;", "data-name" => "plot", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/units/#{unit.marketing_name}/remove_plot"
            .col-lg-3
              %h5.mt-40.mb-20 SELECT UNITS TO PLOT
              %select.amenities-list.form-control
                %option{:value => ""} -- select unit --
                - arr = []
                - units.each do |unit|
                  - if unit.x_plot.to_i + unit.y_plot.to_i == 0
                    %option= "#{unit.marketing_name}"
                      
                    
                  - arr.push([unit.marketing_name, unit.x_plot.to_i, unit.y_plot.to_i, true, unit.id.to_s])
              %h5.mt-40 SELECTED UNITS
              .add-plan.mt-10.mb-20
                %ul#selected-units
              / %button.btn.btn-success#new{:type => "button"} PLOT NOW
              %label#newmsg Place marker for selected units on Map
        #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
          %i.icon-screenshot
:javascript
  var arr = #{raw arr}
  var community_id = #{params[:community_id]}
  var addmode = false;