%h3 Upload .svg Background

%div{:style => "border-top: 1px solid #ddd; padding: 15px 0; margin: 20px 0;"}
  %span.btn.btn-primary.btn-file{:onclick=>"$('#svg-background-upload-holder').click();"}
    %i.fa.fa-upload
    Upload SVG

  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "sitemapUploadSvgPopover", "data-content" => " " }
    %span#propertyDetailNameText{:style => "font-weight: normal; margin-left: 5px;"}
      Uploading an svg will change the map background that appears in the Pynwheel Map.
  
  %br

  .text-center.image-upload.home-page-drag-box#svg-background-upload-holder{:style => "margin-top: 10px; margin-bottom: 10px;"}
    = image_tag "upload-image.png", :class => "drag-image-padding-top"
    %p Drag &amp; Drop SVGs to Upload
  
  .row
    .col-lg-12.text-center
      .form-group.pt-15
        - background_svg_url = current_community.validated_background_svg_image_url || asset_path("default.jpeg")

        %a{ href: "#svgPreviewModal", data: { toggle: "modal" } }
          = image_tag background_svg_url, class: "img-responsive img-thumbnail", id: "preview-image", style: "max-width: 20%; cursor: pointer;"

  / ===== Modal for Preview =====
  .modal.fade#svgPreviewModal{ tabindex: "-1", role: "dialog" }
    .modal-dialog.modal-lg{ role: "document", style: "width: 90%; max-width: 1200px;" }
      .modal-content
        .modal-header
          %button.close{ type: "button", data: { dismiss: "modal" }, aria: { label: "Close" } }
            %span{ aria: { hidden: "true" } } ×
          %h4.modal-title.text-center Background SVG Map Preview
        .modal-body.text-center
          = image_tag background_svg_url, class: "img-responsive center-block", style: "max-height: 80vh;"


:javascript
  $(document).on('click', '[data-toggle="lightbox"]', function(event) {
    event.preventDefault();
    $(this).ekkoLightbox(); // requires ekko-lightbox plugin
  });
