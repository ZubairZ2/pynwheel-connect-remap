<section class="row-fluid">
  <%= render_partial 'community/subnav', :locals => {:community => @community} %>

  <div class="span9">
    <div class="row-fluid">
      <%= render_partial 'sitemap/topnav', :locals => {:sitemap => @sitemap} %>
    </div>
    <div class="row-fluid">
      <div class="alert span12">
         <!-- togle views -->
         <a class="btn btn-small btn-warning pull-right" href="/sitemaps/<%= @sitemap.id %>/reset" title="reset plotting"><i class="icon-exclamation-sign"></i> Reset All Plots</a>
         <span class="pull-right btn-group">
              <a id="gridview" class="btn btn-small" href="#" title="grid view"><i class="icon-th-list"></i></a>
              <a id="mapview" class="btn btn-small" href="/sitemaps/<%= @sitemap.id %>/plotexp" title="map view"><i class="icon-picture"></i></a>
          </span>
        </span>
      </div>
    </div>
    
    <% if @units %>
    <div class="row-fluid">
      <form action="/sitemaps/<%= @sitemap.id %>/save" method="post" onsubmit="return validate(this);">
        <div class="row-fluid">
          <div class="form-actions span12">
            <span>
              <span>Adjust All Plots X:</span>
              <input class="span1" type="text" id="shift_x" name="shift_x" value="0" />
              <span>Y:</span>
              <input class="span1" type="text" id="shift_y" name="shift_y" value="0" />
            </span>
            <input type="submit" class="btn btn-primary pull-right" value="Save Changes">
          </div>
          <table class="table table-hover">
            <tr>
              <th class="span2">
                <a>Building</a>
              </th>
              <th class="span2">
                <a>Unit Number</a>
              </th>
              <!--<th class="span1">
                <a>Building</a>
              </th>
              <th class="span1">
                <a>Floor</a>
              </th>-->
              <th class="span1">
                <a>X Pos</a>
              </th>
              <th class="span1">
                <a>Y Pos</a>
              </th>
            </tr>
            <% @units.sort! { |x, y| [x["building"].to_s, x["number"].to_s] <=> [y["building"].to_s, y["number"].to_s] }
               @units.each do |u| %>  
            <tr>  
              <td>
                <!--<span><%=h u.building %></span>-->
                <input class="span8" name="u[][building]" value="<%=h u.building %>" />
              </td>
              <td>
                <span><%=h u.number %></span>
                <input type="hidden" name="u[][id]" value="<%=h u.id %>" />
              </td>
              <!--<td>
                <input class="span8" name="u[][building]" value="<%=h u.building %>" isrequired />
              </td>
              <td>
                <input class="span8" name="u[][floor]" value="<%=h u.floor %>" isrequired />
              </td>-->
              <td>
                <input class="span8" name="u[][x_plot]" value="<%=h u.x_plot %>" isrequired />
              </td>
              <td>
                <input class="span8" name="u[][y_plot]" value="<%=h u.y_plot %>" isrequired />
              </td>
            </tr>  
            <% end %>
          </table>
          <div class="form-actions span12" style="margin-left:0">
            <input type="submit" class="btn btn-primary pull-right" value="Save Changes">
          </div>
        </div>
      </form>
    </div>
    <% end %> 
  </div>
</section>
