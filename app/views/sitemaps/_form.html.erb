<%= render_partial 'uploader', :locals => {:item => @sitemap} %>
<% form_for @sitemap, submit_path(@sitemap), {:method => submit_method(@sitemap) } do |f| %>
    <%= f.hidden_field :community_id, :value => @community.id %>

    <div class="control-group">
      <%= f.label :filename, :caption => 'Image File' %>
      <p class="help-block">(confirm with production team for dimensions)</p>
      <%= f.hidden_field :filename, :value => @sitemap.filename %>
      <div class="controls">
          <div id="altContent">
            <h1>FileUploader</h1>
            <p><a href="http://www.adobe.com/go/getflashplayer">Get Adobe Flash player</a></p>
          </div>
          <a id="viewfile" href="#" target="_blank">
            <% if @sitemap.filename.to_s.include? "swf" %>
              <!--<embed width="100%" height="100%" id="thumbfile" name="thumbfile" src="http://pynwheel.com/swoop/<%= @community.folder %>/assets/sitemaps/<%= @sitemap.filename %>" type="application/x-shockwave-flash"></embed>-->
              <embed width="100%" height="100%" id="thumbfile" name="thumbfile" src="http://pynwheel.com/swoop/<%= @community.project.app_path %>/assets/sitemap/<%= @sitemap.filename %>" type="application/x-shockwave-flash"></embed>
            <% else %>
              <!--<img id="thumbfile" src="http://pynwheel.com/swoop/<%= @community.folder %>/assets/sitemaps/<%= @sitemap.filename %>" width="90px"/>-->
              <img id="thumbfile" src="http://pynwheel.com/swoop/<%= @community.project.app_path %>/assets/sitemap/<%= @sitemap.filename %>" width="90px"/>
            <% end %>
            <i class="icon-search"></i>
          </a>
      </div>
    </div>

    <div class="control-group">
      <div class="controls span12">
        <span class="span2">
          <%= f.label :width, :caption => 'Width' %>
          <%= f.text_field :width, :value => @sitemap.sitemap_image_width(), :placeholder => "Width", :class => "span12 numeric", :required => true %>
        </span>

        <span class="span2">
          <%= f.label :height, :caption => 'Height' %>
          <%= f.text_field :height, :value => @sitemap.sitemap_image_height(), :placeholder => "Height", :class => "span12 numeric", :required => true %>
        </span>
      </div>
    </div>
    <div class="control-group">
      <span class="help-block">(Set width &amp; height when using a Flash image)</span>
    </div>

    <div class="control-group">
      <div class="form-actions">
        <%= f.submit "#{ @sitemap.new? ? "Add Sitemap" : "Update Sitemap"}", :class => "btn btn-primary" %>&nbsp;
        <%= link_to 'Cancel', path_for(:community, @community.id), :class => 'btn btn-small' %>
        <% if !@sitemap.new? %>
            <%= link_to 'Delete', path_for(:delete_sitemap, @sitemap.id), :class => 'btn btn-small' %>
        <% end %>
      </div>
    </div>

<% end %>
