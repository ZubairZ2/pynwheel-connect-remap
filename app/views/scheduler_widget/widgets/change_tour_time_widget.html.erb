<style type="text/css">
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap');
  .form-group input, .form-control input, .form-group select {
    border-color: #8c9192 !important;
  }
  .form-group {
    padding-bottom: 5px !important;
  }
  .Pyn_Modal{
    background: #fff;
    width: 520px;
    box-shadow: 0px 19px 30px -15px #888888;
    margin: 0 auto;
    padding: 20px;
    border-top: 4px solid #ef4d88;
  }
  .Pyn_Modal p{
    padding: 0px;
    font-size: 14px;
    text-align: center;
    font-weight: bold;
  }
  .Pyn_Modal label{
    font-size: 15px;
    font-weight: 300;
    color: #000;
  }
  .Pyn_Modal .form-control{
    font-size: 18px;
    height: 49px;
    font-weight: 300;
    border-radius: 0;
    line-height: normal;
    box-shadow: none;
  }
  .select_number{
    width: 36%;
    float: left;
  }
  .phoneNumber{
    width: 60%;
    float: right;
  }
  .cardNumber{
    width: 70%;
    float: left;
  }
  .expiry{
    width: 26%;
    float: right;
  }
  .btn_popup{
    width: 100%;
    border: none;
    background: #89c766;
    text-align: center;
    color: #fff;
    font-size: 19px;
    padding: 12px 0;
  }
  .inner_phn_wrap{
    float: left;
    margin-bottom: 15px;
    width: 100%;
  }
  .how_it_works {
    background: #008fd3;
    text-align: center;
    color: #fff;
  }
  .how_it_works_p {
    font-size: 18px;
    font-family: Poppins !important;
  }
  .how_it_works h2 {
    font-size: 32px;
    font-family: Poppins !important;
  }
  .confirmation-text {
    padding: 2% 0 0;
  }
  .continue_link {
    cursor: pointer;
    font-size: 18px;
  }
  @media only screen and (max-width: 760px) {
    .how_it_works_p{
      font-size: 17px;
      font-family: Poppins !important;
    }
  }
  @media only screen and (max-width: 560px) {
    .Pyn_Modal{
        background: #fff;
        width: 100%;
        box-shadow: 0px 19px 30px -15px #888888;
        margin: 0 auto;
        padding: 20px;
        border-top: 4px solid #ef4d88;
    }
  }
</style>


<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/>
    <meta charset="utf-8"/>
    <meta content="IE=edge" http-equiv="X-UA-Compatible"/>
    <title>Pynwheel | Dashboard</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport"/>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag 'jquery.mCustomScrollbar.css' %>
    <%= stylesheet_link_tag 'slick.css' %>
    <%= stylesheet_link_tag 'bootstrap-datetimepicker' %>
    <%= stylesheet_link_tag    'application', media: 'all' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.arrayUtilities' %>
    <%= javascript_include_tag 'slick' %>
    <%= javascript_include_tag 'moment' %>
    <%= javascript_include_tag 'bootstrap-datetimepicker' %>
    <%= favicon_link_tag 'logo-small.png' %>
    <%= render '/font_awesome_v5' %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap" rel="stylesheet">
  </head>
  
  <body>
    
    <div class="modal fade" id="scheduleMyTour" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
      aria-hidden="true">
      <div class="modal-dialog" role="document">
        <section>
          <div class="Pyn_Modal">
            <p>Select a date and time below to reschedule your Pynwheel Tour at <%= @community.name %></p>
            <form class="form_popup" id="scheduleMyTourForm">
              <div class="clearfix"></div>
              <div class="form-group">
                <label>Date/Time *</label>
                <%= text_field_tag :tour_time,"", :class=>"form-control datepickertime", :placeholder=>"Date/Time",:maxlength=>"15",:autocomplete=>"off", required: 'required' %>
              </div>
              <div class="clearfix"></div>

              <button class="btn_popup" style="float: left; width: 50%;">Confirm</button>
              <button class="btn_popup" id="cancel-visit" style="border-left: 1px solid #fff;  width: 50%;">Cancel my visit</button>
            </form>
          </div>
        </section>
      </div>
    </div>
      <div id="scheduleMyTourSuccess" tabindex="-1" aria-hidden="true">
        <section>
          <div class="container confirmation-text">
            <p id="reschedule-content" style="font-weight: normal; font-size: 20px;"></p>
          </div>
        </section>
        <section >
          <%= render 'shared/download_apps', :obj => {:ios_link => ios_link, :android_link => android_link } %>
          <section class="container">
            <div style="float: right;">
              <% if user_signed_in? %>
                <a onclick="redirectSheduledTourPage('/communities/<%= @community.id %>/scheduled_tours')" class="continue_link">Continue <%= '<i class="fa fa-long-arrow-right" aria-hidden="true"></i>'.html_safe %></a>
              <% end %>
            </div>
        </section>
          <section class="mt-15">
            <div class="container how_it_works">
                <%= render 'shared/instruction_card', :obj => {chat_control: @community.chat_control, property_tour_type: property_tour_type, community_name: community_name,tour_type: tour_type,
                property_access: @community.community_tour.tour_setting.enable_restricted_property_access} %>
            </div>
          </section>
      </div>
    <%# TODO: Remove after verification of confirmation page  %>
    <% if false %>
      <div class="modal fade" id="scheduleMyTourSuccess" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
          <section>
            <div class="Pyn_Modal">
              <p id="reschedule-content" style="font-weight: normal; font-size: 20px;"></p>
              <div class="clearfix"></div>
              <% if user_signed_in? %>
                <button class="btn_popup" onclick="redirectSheduledTourPage('/communities/<%= @community.id %>/scheduled_tours')">Ok</button>
              <% else %>
                <button class="btn_popup" id="close">Ok</button>
              <% end %>
            </div>
          </section>
        </div>
      </div>
    <%end%>

    <script type="text/javascript">
      $("#scheduleMyTourSuccess").hide();
      var success = "<%= flash[:success]  %>";
      var community_id = "<%= @community.id %>";

      <% flash[:success] = "" %>
      if(success){
        $("#modalLoginForm").modal('hide');
        $("#scheduleMyTourSuccess").show();
        // $("html, body").animate({ scrollTop: 0 }, 600);
      }

      var tour_id;

      $(document).ready(function(){
        $("#scheduleMyTourSuccess").hide();
        $('#scheduleMyTour').modal({backdrop: 'static', keyboard: false})  

        // $(".datepicker").datetimepicker({minDate: new Date(), format: 'MM/DD/YYYY'});
        var datepickertime = $('.datepickertime').datetimepicker({
          
          format : 'MM/DD/YYYY hh:mm A',
          minDate: moment(),

          sideBySide: true,
          showTodayButton: true,
          showClear: true,
          showClose: true,
          useCurrent: true,
          toolbarPlacement: "bottom",
          stepping: 15          
        });
        <% if params["datetime"].present? %>
          let dateTime = getTourDate('<%= params[:datetime] %>');
          $('.datepickertime').data("DateTimePicker").defaultDate(dateTime);
          $("#scheduleMyTour").modal()
        <% end %>

        $("#scheduleMyTourForm").on('submit', function(e){
          $.ajax({
            type: "POST",
            url: "/schedual_tours/<%= params[:id]%>.json",
            data: $(this).serialize(),
            cache: false,
            success: function(data){
              $("#reschedule-content").html(data.message)
              $("#scheduleMyTour").modal('hide');
              $("#scheduleMyTourSuccess").show();
            },
            fail: function(error){
              console.log(error)
            }
          });
          e.preventDefault();
        });

        $("#cancel-visit").on('click', function(e) {
          $.ajax({
            type: "POST",
            url: "/destroy_schedual_tours/<%= params[:id]%>.json",
            data: {community_id: community_id},
            cache: false,
            success: function(data){
              alert("Your tour has been canceled");

              if(data.logged_in) {
                window.location.href = `${window.location.origin}/communities/${community_id}/scheduled_tours`;
              } else {
                window.location.href = window.location.origin
              }
            },
            fail: function(error){
              console.log(error)
            }
          });
          e.preventDefault();
        });


        $("#close").on('click', function(){
          $("#scheduleMyTourSuccess").hide()
          // window.location.reload();
        });

      });

      function redirectSheduledTourPage(url){
        window.location.href = url
      }

      function getTourDate(datetime) {
        datetime = datetime.toUpperCase();

        if(datetime.includes("AM"))
          return new Date(datetime.split('AM').join(" AM"));
        else if(datetime.includes("PM"))
          return new Date(datetime.split('PM').join(" PM"));
        else
          return new Date();
      }

    </script>

  </body>
  
</html>