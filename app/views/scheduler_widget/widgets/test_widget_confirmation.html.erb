<style type="text/css">
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap');
  .how_it_works{
    background: #008fd3;
    text-align: center;
    color: #fff;
  }
  .how_it_works_p{
    font-size: 20px;
    font-family: Poppins !important;
  }
  .how_it_works h2{
    font-size: 32px;
    font-family: Poppins !important;
  }
  .confirmation-text{
    padding: 3% 0 0;
  }
  .btn_popup{
    width: 100%;
    border: none;
    text-align: center;
    color: #008fd3;
    font-size: 19px;
  }
  @media only screen and (max-width: 760px) {
    .how_it_works_p{
      font-size: 17px;
      font-family: Poppins !important;
  }
  }

</style>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/>
    <meta charset="utf-8"/>
    <meta content="IE=edge" http-equiv="X-UA-Compatible"/>
    <title>Pynwheel | Schedule Confirmation</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport"/>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag 'jquery.mCustomScrollbar.css' %>
    <%= stylesheet_link_tag 'slick.css' %>
    <%= stylesheet_link_tag 'bootstrap-datetimepicker' %>
    <%= stylesheet_link_tag    'application', media: 'all' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.arrayUtilities' %>
    <%= javascript_include_tag 'slick' %>
    <%= javascript_include_tag 'moment' %>
    <%= favicon_link_tag 'logo-small.png' %>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="divLoading hidden"></div>
    <div id="scheduleMyTourSuccess" tabindex="-1" aria-hidden="true">
      <%# <div class="container" role="document"> %>
        <section>
          <div class="container confirmation-text">
            <p>
              <%= flash[:success].html_safe if flash[:success].present? %>
            </p>
          </div>
        </section>
        <section class="clearfix">
          <%= render 'shared/download_apps', :obj => {:ios_link => ios_link, :android_link => android_link } %>
          <section class="container">
            <% if true %>
              <div style="float: right;">
                <% if user_signed_in? %>
                  <a class="btn_popup" id="close">Continue</a>
                <% else %>
                  <button class="btn_popup" onclick="redirectSheduledTourPage('/communities/<%= @community.id %>/scheduled_tours')">OkKKKKKKKKK</button>
                <% end %>
              </div>
            <% end %>
          <%# </section> %>
        </section>
        <section class="mt-15">
          <div class="container how_it_works">
            <h2 class="mt-40 mb-20"><b>How It Works</b></h2>
            <p class="how_it_works_p">Be at the property on the day your tour is scheduled within <b>10</b> minutes of your scheduled time</p>
             <div>
                <%= render 'shared/instruction_card' %>
             </div>
          </div>
        </section>
      <%# </div> %>
    </div>

    <script type="text/javascript">
      function redirectSheduledTourPage(url){
        window.location.href = url
      }
      $(document).ready(function(){
        $("#close").on('click', function(){
        $("#scheduleMyTourSuccess").addClass('hidden');
        $('#close').modal('test_widget.html.erb' + "#scheduleMyTour");

          // window.location.reload();
        });
      });
      // var success = "<%= flash[:success]  %>";
      // <% flash[:success] = "" %>
      // if(success){
      //   $("#modalLoginForm").modal('hide');
      //   $('.divLoading').addClass('hidden')
      //   $("#scheduleMyTourSuccess").show()
      //   $("html, body").animate({ scrollTop: 0 }, 600);
      // }
      // else
      // {
      //     $('.divLoading').addClass('hidden');
      // }
    </script>

  </body>

</html>