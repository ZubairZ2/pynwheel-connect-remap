- content_for :title, "Add Images - Pynwheel"
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-star
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .bs-example.bs-example-tabs{"data-example-id" => "togglable-tabs"}
      #myTabContent.tab-content
        / Start image-slide section
        #image-slide.tab-pane.fade.active.in{:role => "tabpanel"}
          .row
            .col-md-6
              %h4 Add Images
          .row
            .col-md-6
              .mt-35
                %span.btn.btn-success.btn-file.text-UP.pull-left{:onclick=>"$('#favorite-image-upload-holder').click();"}
                  %i.fa.fa-plus-circle
                  Add Files
                 
    .row
      
      .col-lg-12.col-md-12
        .text-center.image-upload.home-page-drag-box#favorite-image-upload-holder
          = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
          %p Drop files here or click to Upload
        #images-index
          = render 'index'
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "favorite_image_show_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
:javascript
  var community_id = "#{params[:community_id]}"
  var favorite_setting_id = "#{params[:favorite_setting_id]}"
  $(document).ready(function(e){
    $('[data-toggle="popover"]').popover();
  });
  function favorite_image_show_goBack()
    {
      if (window.history.length == 1)
      {
        window.location.reload();
      }
      else
      {
        window.history.back();
      }
    }

