-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Edit Elevator - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Elevator
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @elevator,url: community_elevator_path(current_community, @elevator),method: :put do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group.elevator-form-alignment
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control elevator_edit_field", :placeholder=>"Name",:maxlength=>"30"

            .form-group.elevator-form-alignment
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Description

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_area :description, :class=>"form-control elevator_edit_field elevator_description_edit_field elevator_description_edit_field_wysihtml5", :placeholder=>"Elevator Description",  :value=> @elevator.description
                <!-- %span.elevator_description_edit_field_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->
 
            .form-group.elevator-form-alignment
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_area :directional_text, :class=>"form-control elevator_edit_field elevator_directional_text_edit_field elevator_directional_text_edit_field_wysihtml5", :placeholder=>"Elevator Directional Text",  :value=> @elevator.directional_text
                <!-- %span.elevator_directional_text_edit_field_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 140 -->

            .form-group.elevator-form-alignment
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Floorplate Covering Range

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :floorplate_covering_range, :class=>"form-control elevator_edit_field", :placeholder=>"Floorplate Covering Range",:maxlength=>"70"
            .form-group.elevator-form-alignment
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building ,  class: "form-control elevator_edit_field", placeholder: "building"

            - if @community.enable_locks
              - locks_present_hash = {}
              - locks_present_hash["Dwelo"] = @community.multiple_locks_provider.include?("Dwelo") && @community.dwelo.present? && @all_locks[:dwelo_locks].any?
              - locks_present_hash["EdgeState"] = @community.multiple_locks_provider.include?("EdgeState") && @community.edge_state.present? && @all_locks[:edgestate_locks].any?
              - locks_present_hash["Latch"] = @community.multiple_locks_provider.include?("Latch") &&  @community.latch.present? && @all_locks[:latch_locks].any?
              - locks_present_hash["Zerv"] = @community.multiple_locks_provider.include?("Zerv") &&  @community.zerv.present? && @all_locks[:zerv_locks].any?
              - locks_present_hash["Igloohome"] = @community.multiple_locks_provider.include?("Igloohome") &&  @community.igloohome.present? && @all_locks[:igloohome_locks].any?

              // load options and input values start
              - if locks_present_hash["Dwelo"]
                = hidden_field_tag "dwelo_lock_input_value", @elevator.remote_locks.dwelo_locks.present? ? @elevator.remote_locks.dwelo_locks.last.name + " (" + @elevator.remote_locks.dwelo_locks.last.remote_lock_type + ")" : ''
                .dwelo_options.hide_it
                  - @all_locks[:dwelo_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - if locks_present_hash["EdgeState"]
                = hidden_field_tag "edgestate_lock_input_value", @elevator.remote_locks.edgestate_locks.present? ? @elevator.remote_locks.edgestate_locks.last.name + " (" + @elevator.remote_locks.edgestate_locks.last.remote_lock_type + ")" : ''
                .edgestate_options.hide_it
                  - @all_locks[:edgestate_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}  
              - if locks_present_hash["Latch"]
                = hidden_field_tag "latch_lock_input_value", @elevator.latch_locks.present? ?  @elevator.latch_locks.last.lock_name : ''
                .latch_options.hide_it
                  - @all_locks[:latch_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - if locks_present_hash["Zerv"]
                = hidden_field_tag "zerv_lock_input_value", @elevator.zerv_locks.present? ?  @elevator.zerv_locks.last.sub_location_name + " (" + @elevator.zerv_locks.last.sub_location_friendly_name + ")" : ''
                .zerv_options.hide_it
                  - @all_locks[:zerv_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - if locks_present_hash["Igloohome"]
                = hidden_field_tag "igloohome_lock_input_value",( @elevator.igloohome_locks.present? ? @elevator.igloohome_locks.first.device_name : '' )
                .igloohome_options.hide_it
                  - @all_locks[:igloohome_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Select Lock Type
                  %span Select the access provider for this stop
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select :lock_provider , options_for_select(@community.lock_options(locks_present_hash), f.object.lock_provider),{},{:class=>"form-control"}

              .form-group.hide_it#manual_access_code
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Access Code
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :access_code, :oninput => "this.value = this.value.replace(/[^0-9#*]/g, '')", :class=>"form-control elevator_edit_field", :placeholder=>"Access Code",:maxLength => "10"
              
              .form-group#lock_access_code.hide_it
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = text_field_tag :lock_input, '', :placeholder => "Search by lock name", :list => "locks_list", :autocomplete=> "off", :type => "text", :class => "form-control elevator_edit_field"
                  %datalist#locks_list
              
              #elevator-bank.hide_it
                = render :partial=>'elevator_bank_block.html'
                #elevator-bank-data{ data: { all_locks: @all_locks.to_json, bank_locks: @elevator_banks.to_json } }

    %span.btn.btn-primary.btn-file
      %i.fa.fa-upload
      Upload File
      %input#elevator-images{:type => "file"}/

    .text-center.image-upload.home-page-drag-box#elevator-image--upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container
          %a.preview-image{:href=>@elevator.image.present? ? @elevator.image.url : asset_path("elev2.png"),"data-toggle"=>"lightbox","data-title"=>"Elevator Image"}
            = image_tag @elevator.image.present? ? @elevator.image.url : "elev2.png",:height=>"100%",:width=>"100%",:id=>"preview-image"
    //////////////////////// Amenity Gallery
    .box.box-info.add-plan

      .col-lg-12
        %h4{:style => "color: grey;"}
          Upload Elevator Gallery
      .col-lg-12.mt-35
        /%span.btn.btn-primary.btn-file.pull-right.mb-20
        %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
          %i.fa.fa-plus-circle
          ADD FILES
          %input#elevator-gallery-images{:multiple => "multiple", :type => "file"}/
        .mt-10
          - if @community.is_sitemap && current_user.is_admin?
            = link_to "PLOT ELEVATORS", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
        .divLoading.hidden
        #images-index1
          = render :partial=>'edit_elevator'

.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %a.btn-primary.mb-20.done_btn{:href => "javascript:void(0)",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
              %button.btn-default.done_btn.mb-20{:onclick => "goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                Cancel


#edit-elevator-data{ data: {elevator_id: @elevator.id, community_id: @community.id} }

#edit-gallery-image.modal.fade.edit-gallery-image
:javascript
  var locks_input, locks_list, param_name;
  $(document).ready(function(){
    // run it on ready 
    update_locks_select_and_lock_code_field();
    handleElevatorBankVisibility();

    // provide locks on change 
    $('#elevator_lock_provider').change(function(){
      update_locks_select_and_lock_code_field();
      handleElevatorBankVisibility();
      if ($('#elevator_lock_provider').val().length == 0)
        $('.edit_elevator').submit();
    });

    function handleElevatorBankVisibility() {
      if( $('#elevator_lock_provider').val() === 'Latch')
        $('#elevator-bank').removeClass('hide_it');
      else
        $('#elevator-bank').addClass('hide_it');    
    }
    
    function update_locks_select_and_lock_code_field(){
      // if any lock selected selected
      if ($('#elevator_lock_provider').val().length > 0 && $('#elevator_lock_provider').val() != "Manual")
      {
        $('#manual_access_code').addClass('hide_it')
        // initialize elements 
        lock_provider_type = $('#elevator_lock_provider').val().toLowerCase()
        lock_input_value = "#" + lock_provider_type + "_lock_input_value"
        options = '.' + lock_provider_type + "_options"
        locks_input = "#lock_input"
        locks_list = "#locks_list"
        param_name = "lock_id"
        // assign values
        if (lock_provider_type == "zerv"){
          $('#lock_access_code').find('label').html("Lock <span>Assign the lock to this elevator</span>")
        }
        else{
          $('#lock_access_code').find('label').html(capitalize(lock_provider_type) + " Lock <span>Assign the lock to this elevator</span>")
        }

        $('#lock_input').val( $(lock_input_value).val() )
        $('datalist#locks_list').html($(options).html())
        $('#lock_access_code').removeClass('hide_it') 
      }

      else if ($('#elevator_lock_provider').val().length > 0)
      {
        $('#lock_access_code').addClass('hide_it')
        $('#manual_access_code').removeClass('hide_it')
        locks_input = undefined
      }
      else{
        $('#lock_access_code').addClass('hide_it')
        $('#manual_access_code').addClass('hide_it')
      }
    }


    $('#elevator_lock_provider').change(function(){
        $('.done_btn').click(function(){
          if ($('#elevator_lock_provider').val() == "Manual" && $("#elevator_access_code").val().length > 0)
            $('.edit_elevator').submit(); 
          else if ($('#elevator_lock_provider').val().length > 0 && $("#lock_input").val().length > 0){
            if (locks_input){
              var lock = $(locks_input)[0];
              if(typeof lock !== 'undefined'){
                if(lock.value == "")
                  lock.setCustomValidity('')

                if(lock.checkValidity() == true){
                  lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
                  input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
                  $("#" + lock.id).closest('form').append(input)
                  $('.edit_elevator').submit(); 
                }
                else{ 
                  //lock.reportValidity(); 
                  $('.edit_elevator').submit();
                }
              }
              else{
                  $('.edit_elevator').submit(); 
              }
          }
          else
            $('.edit_elevator').submit(); 
          }
          else
          {
            if (#{params[:floorNo].nil?})
              window.location.href = "/communities/#{@community.id}/tours";
            else
              window.location.href = "/communities/#{@community.id}/tours?floorNo=#{params[:floorNo]}";
            //window.location.reload()
          }
        });
    });
  });
  $('.elevator_edit_field').change(function(){
    setTimeout(function(){ 
      if (locks_input){
        var lock = $(locks_input)[0];
        if(lock.value == "")
          lock.setCustomValidity('')

        if(lock.checkValidity() == true){
          lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
          input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
          $("#" + lock.id).closest('form').append(input)
          $('.edit_elevator').submit(); 
        }
        else{ 
          //lock.reportValidity(); 
          $('.edit_elevator').submit();
        }
      }
      else
        $('.edit_elevator').submit();
    }, 300);

  });
  if (locks_input){
    var inputs = document.querySelectorAll('input[list]');
    for (var i = 0; i < inputs.length; i++) {
      inputs[i].addEventListener('change', function() {
        var optionFound = false,
        datalist = this.list;
        for (var j = 0; j < datalist.options.length; j++) {
            if (this.value == datalist.options[j].value) {
                optionFound = true;
                break;
            }
        }
        if (optionFound) {
          this.setCustomValidity('');
        } else {
          if ( $(locks_input).val() != "" )
              this.setCustomValidity('Lock does not exist');
        }
      });
    }
  }
  function goBack(){
    window.location.href = '/communities/#{@community.id}/tours';
  }