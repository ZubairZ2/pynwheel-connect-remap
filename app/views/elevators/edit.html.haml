-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Edit Elevator - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Elevator
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @elevator,url: community_elevator_path(current_community, @elevator),method: :put do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control elevator_edit_field", :placeholder=>"Name",:maxlength=>"30"

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Description

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :description, :class=>"form-control elevator_edit_field", :placeholder=>"Description",:maxlength=>"70"

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :directional_text, :class=>"form-control elevator_edit_field", :placeholder=>"Directional Text",:maxlength=>"70"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Floorplate Covering Range

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :floorplate_covering_range, :class=>"form-control elevator_edit_field", :placeholder=>"Floorplate Covering Range",:maxlength=>"70"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building ,  class: "form-control elevator_edit_field", placeholder: "building"

            - if @community.enable_locks
              - if @community.locks_provider == "EdgeState" and @community.edge_state.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Remote Lock
                    %span Assign the lock to this elevator
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :edgestate_locks_input, @elevator.remote_locks.present? ? @elevator.remote_locks.last.name + " (" + @elevator.remote_locks.last.remote_lock_type + ")" : '', :placeholder => "Search by lock name", :list => "edgestate_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control elevator_edit_field"
                    %datalist#edgestate_locks_list
                      - @all_locks[:edgestate_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Dwelo" and @community.dwelo.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Dwelo lock
                    %span Assign the lock to this elevator
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :dwelo_locks_input, @elevator.remote_locks.present? ? @elevator.remote_locks.last.name + " (" + @elevator.remote_locks.last.remote_lock_type + ")" : '', :placeholder => "Search by lock name", :list => "dwelo_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control elevator_edit_field"
                    %datalist#dwelo_locks_list
                      - @all_locks[:dwelo_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Latch" and @community.latch.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Latch lock
                    %span Assign the lock to this elevator
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :latch_locks_input, @elevator.latch_locks.present? ?  @elevator.latch_locks.last.lock_name : '', :placeholder => "Search by lock name", :list => "latch_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control elevator_edit_field"
                    %datalist#latch_locks_list
                      - @all_locks[:latch_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Zerv" and @community.zerv.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Pynwheel Access (zerv)
                    %span Assign the lock to this elevator
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :zerv_locks_input, @elevator.zerv_locks.present? ?  @elevator.zerv_locks.last.sub_location_name + " (" + @elevator.zerv_locks.last.sub_location_friendly_name + ")" : '', :placeholder => "Search by lock name", :list => "zerv_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control elevator_edit_field"
                    %datalist#zerv_locks_list
                      - @all_locks[:zerv_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              -# - elsif @community.locks_provider == nil or @community.locks_provider == ""
              -#   .form-group
              -#     %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              -#       Access Code
              -#     .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -#       = f.text_field :access_code, :oninput => "this.value = this.value.replace(/[^0-9#*]/, '')", :class=>"form-control elevator_edit_field", :placeholder=>"Access Code"

            = submit_tag 'Save', class: "hidden"

    %span.btn.btn-primary.btn-file
      %i.fa.fa-upload
      Upload File
      %input#elevator-images{:type => "file"}/

    .text-center.image-upload.home-page-drag-box#elevator-image--upload-holder
      = image_tag "upload-image.png",:class=>"drag-image-padding-top"
      %p Drag &amp; Drop images to Upload

.row
  .col-lg-12
    .form-group.logo-upload-bg.pt-15
      .select-logo.center-img.mb-20.mt-30.logo-upload-bg
        .select-logo-logo.logo-container.logo-upload-container
          %a.preview-image{:href=>@elevator.image.present? ? @elevator.image.url : asset_path("elev2.png"),"data-toggle"=>"lightbox","data-title"=>"Elevator Image"}
            = image_tag @elevator.image.present? ? @elevator.image.url : "elev2.png",:height=>"100%",:width=>"100%",:id=>"preview-image"
    //////////////////////// Amenity Gallery
    .box.box-info.add-plan

      .col-lg-12
        %h4{:style => "color: grey;"}
          Upload Elevator Gallery
      .col-lg-12.mt-35
        /%span.btn.btn-primary.btn-file.pull-right.mb-20
        %span.btn.btn-success.btn-file.some{ :style => "margin-right: 5px; width: 135px" }
          %i.fa.fa-plus-circle
          ADD FILES
          %input#elevator-gallery-images{:multiple => "multiple", :type => "file"}/
        .mt-10
          - if @community.is_sitemap && (current_user.is_super_admin? || current_user.is_community_admin? )
            = link_to "PLOT ELEVATORS", plot_amenities_community_sitemaps_path(@community), class: "btn btn-primary hidden btn-file plot_amenities_btn"
        .divLoading.hidden
        #images-index1
          = render :partial=>'edit_elevator'

.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %a.btn-primary.mb-20.done_btn{:href => "#{params[:floorNo].nil? ? community_tours_path(current_community) : community_tours_path(current_community) << '?floorNo=' + params[:floorNo]}",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#edit-gallery-image.modal.fade.edit-gallery-image
:javascript
  var locks_provider = "#{@locks_provider}"
  var locks_input, locks_list, param_name;

  if(locks_provider == "EdgeState"){
    locks_input = "#edgestate_locks_input"
    locks_list = "#edgestate_locks_list"
    param_name = "remote_lock"
  }
  else if(locks_provider == "Dwelo"){
    locks_input = "#dwelo_locks_input"
    locks_list = "#dwelo_locks_list"
    param_name = "dwelo_remote_lock"
  }
  else if(locks_provider == "Latch"){
    locks_input = "#latch_locks_input"
    locks_list = "#latch_locks_list"
    param_name = "latch_lock"
  }
  else if(locks_provider == "Zerv"){
    locks_input = "#zerv_locks_input"
    locks_list = "#zerv_locks_list"
    param_name = "zerv_lock"
  }

  $('.elevator_edit_field').change(function(){
    setTimeout(function(){ 

        var lock = $(locks_input)[0];
        if(lock.value == "")
          lock.setCustomValidity('')

        if(lock.checkValidity() == true){
          lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
          input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
          $("#" + lock.id).closest('form').append(input)
          $('.edit_elevator').submit(); 
        }
        else{ lock.reportValidity(); }

    }, 300);

  });

  var inputs = document.querySelectorAll('input[list]');
  for (var i = 0; i < inputs.length; i++) {
    inputs[i].addEventListener('change', function() {
      var optionFound = false,
      datalist = this.list;
      for (var j = 0; j < datalist.options.length; j++) {
          if (this.value == datalist.options[j].value) {
              optionFound = true;
              break;
          }
      }
      if (optionFound) {
        this.setCustomValidity('');
      } else {
        if ( $(locks_input).val() != "" )
            this.setCustomValidity('Lock does not exist');
      }
    });
  }

