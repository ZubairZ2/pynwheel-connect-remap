%div#elevator-container
.form-group
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    %button#add-elevator-btn.btn.btn-primary
      %i.fas.fa-plus
      Add Elevator

:javascript
  document.addEventListener("DOMContentLoaded", () => {
    let sectionIdCounter = 1;
    let allLocks = [];
    let providerSpecificlocks = [];

    const setDataAttributes = () => {
      if ($('#elevator-bank-data').data() != undefined) {
        const data = $('#elevator-bank-data').data();
        allLocks = data["allLocks"];
      }
    }

    const getLocksList = () => {
      switch (lock_provider_type) {
        case 'latch':
          providerSpecificlocks = allLocks?.latch_locks?.map(lock => ({ value: lock.id, name: lock.name }));
          return providerSpecificlocks;
        case 'zerv':
          // Add specific logic for 'zerv'
          break;
        case 'igloohome':
          // Add specific logic for 'igloohome'
          break;
        case 'dwelo':
          // Add specific logic for 'dwelo'
          break;
        case 'edgestate':
          // Add specific logic for 'edgestate'
          break;
        default:
          break;
      }
    };

    const createElevatorHeading = (sectionIdCounter) => `
      <div class="form-group">
        <h4 class="elevator-title">Elevator ${sectionIdCounter}</h4>
      </div>
    `;

    const createNameField = () => `
      <div class="form-group">
        <label class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">Name</label>
        <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
          <input type="text" name="name[]" class="form-control">
        </div>
      </div>
    `;

    const createPositionField = () => `
      <div class="form-group">
        <label class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">Position</label>
        <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
          <input type="text" name="position[]" class="form-control">
        </div>
      </div>
    `;

    const createLockSelectionField = (locks) => `
      <div class="form-group" id="lock_access_code">
        <label class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">
          Select Lock
          <span>Assign the lock to this elevator</span>
        </label>
        <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
          <input type="text" placeholder="Search by lock name" list="locks_list" class="form-control elevator_edit_field" autocomplete="off">
          <datalist id="locks_list">
            ${locks.map(lock => `<option value="${lock.value}" data-lock-name="${lock.name}">${lock.name}</option>`).join('')}
          </datalist>
        </div>
      </div>
    `;

    const createButtons = (sectionId) => `
      <div class="form-group text-right">
        <button type="button" class="btn btn-success assign-lock-btn" data-section-id="${sectionId}">
          <i class="fas fa-lock"></i> Assign Lock
        </button>
        <button type="button" class="btn btn-danger remove-section-btn" data-section-id="${sectionId}">
          <i class="fas fa-trash-alt"></i> Remove
        </button>
      </div>
    `;

    const createElevatorFields = (locks) => {
      const sectionId = `elevator-section-${sectionIdCounter}`;
      const html = `
        <div id="${sectionId}" class="elevator-section" style="border: 1px solid #ddd; padding: 15px; margin-bottom: 15px;">
          ${createElevatorHeading(sectionIdCounter)}
          ${createNameField()}
          ${createPositionField()}
          ${createLockSelectionField(locks)}
          ${createButtons(sectionId)}
        </div>
      `;
      sectionIdCounter++;
      return html;
    };

    const sendAssignmentData = (sectionId, name, position, lockName, lockValue) => {
      const url = `/communities/${community_id}/elevators/${elevator_id}/elevator_banks/assign_lock`;
      const data = { 
        name,
        position,
        lock_name: lockName,
        lock_type: lock_provider_type,
        lock_id: lockValue
      };

      $.ajax({
        url: url,
        type: "POST",
        dataType: "json",
        data: datas
      }).done(function (data) {
      });
    };


    document.getElementById("add-elevator-btn").addEventListener("click", (e) => {
      e.preventDefault();
      setDataAttributes();
      const elevatorContainer = document.getElementById("elevator-container");
      elevatorContainer.insertAdjacentHTML('beforeend', createElevatorFields(getLocksList()));
    });

    document.getElementById("elevator-container").addEventListener("click", (e) => {
      if (e.target.classList.contains('remove-section-btn')) {
        const sectionId = e.target.getAttribute('data-section-id');
        const sectionToRemove = document.getElementById(sectionId);
        if (sectionToRemove) sectionToRemove.remove();
      }

      if (e.target.classList.contains('assign-lock-btn')) {
        const sectionId = e.target.getAttribute('data-section-id');
        const section = document.getElementById(sectionId);

        if (section) {
          const name = section.querySelector('input[name="name[]"]').value;
          const position = section.querySelector('input[name="position[]"]').value;
          const lockNameInput = section.querySelector('input[list="locks_list"]');
          const lockName = lockNameInput.value;
          const lockValue = providerSpecificlocks?.find(option => option.name === lockName)?.value;

          if (lockValue) {
            sendAssignmentData(sectionId, name, position, lockName, lockValue);
          } else {
            alert('Invalid lock selection.');
          }
        } else {
          alert('Section not found!');
        }
      }
    });
  });
