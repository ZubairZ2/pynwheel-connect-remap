:javascript
  var t;
  var vertices;
  var visitedPoints = [];
  var canvas;
  var ctx;
  var img;
  var width;
  var height;
  var lock_access_time;
  var vertices_count = 0;
  var already_watched = [];
  var automateTracking = true;
  var is_community_sitemap = false;
  var tempVisitedStopsData = [];

  setTimeout(function(){
    draw_image_canvas(null);
  }, 2000);

  function draw_image_canvas(img_src)
  {
    console.log(img_src);
    canvas = document.getElementById("myCanvas");
    ctx = canvas.getContext("2d");
    img = document.getElementById("floorplane_img");
    //debugger;
    if(img_src != null)
      img.src = img_src

    width = $('#parent-div').width()
    height = ( width / img.width) * img.height;
    ctx.canvas.height = height;
    ctx.canvas.width = width;
    
    if(img_src != null) {
      img.onload = function(){
        ctx.drawImage(img, 0, 0, width, height);
      }
    } else {
      ctx.drawImage(img, 0, 0, width, height);
    }
        
    ctx.lineCap = "round";

    // variable to hold how many frames have elapsed in the animation
    t = 1;

    // define the path to plot
    vertices = [];
    visitedPoints = [];
  }
  
  function delete_image_canvas() {
    var canvas = document.getElementById("myCanvas");
    var context = canvas.getContext('2d');
    context.clearRect(0, 0, canvas.width, canvas.height);
  }
  // draw the complete line



  // set some style
 


  // calc waypoints traveling along vertices
  function calcWaypoints(vertices) {
      var waypoints = [];
      for (var i = 1; i < vertices.length; i++) {
          var pt0 = vertices[i - 1];
          var pt1 = vertices[i];
          var dx = pt1.x - pt0.x;
          var dy = pt1.y - pt0.y;
          for (var j = 0; j < 100; j = j+5) {
              var x = pt0.x + dx * j / 100;
              var y = pt0.y + dy * j / 100;
              waypoints.push({
                  x: x,
                  y: y
              });
          }

      }

      return (waypoints);
  }

  $('[data-toggle="popover-hover"]').popover({
    html: true,
    trigger: 'hover',
    placement: 'bottom',
    content: function () { return '<img style="height: 100px; max-height:100px; max-width:100px;" src="' + $(this).data('img') + '" />'; }
  });

  function show_imagee(stop){
    $(".abc").removeClass("hide_image");
  }
          
  if ("#{browser.device.iphone?}" == "true") {
    $(".user_id_image1").css("transform", "transform: rotate(90deg);");
    $(".user_id_image2").css("transform", "transform: rotate(90deg);");
  }

  function visitor_show_goBack() {
    if (window.history.length == 1)
      window.location.reload();
    else
      window.history.back();
  }

  $('[data-toggle="visitor_popover"]').popover();
  
  $('#chat-logs').on('click', function() {
    if ($('#msg_history_a').children().length == 0){
    
    var loadAdminChat, loadAdminChatHelper;

    loadAdminChatHelper = function(chat) {
      if(chat.name == "Support Team"){
          $('#msg_history_a').append(`
              <div class="outgoing_msg_a">
                  <div class="sent_msg_a">
                      <p>${chat.message}</p>
                      <span class="time_date_a"> ${moment(chat.client_date).format("h:mm A | MMM D")} </span>
                  </div>
              </div>
          `)
      }
      else {
          $('#msg_history_a').append(`
              <div class="incoming_msg_a">
                  <div class="incoming_msg_img_a"> <img id="img_id_a" src=${chat.tour_user.image} alt=${chat.tour_user.name}> </div>
                  <div class="received_msg_a">
                      <div class="received_withd_msg_a">
                          <p>${chat.message}</p>
