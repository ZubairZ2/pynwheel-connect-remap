:javascript

  $('[data-toggle="popover-hover"]').popover({
      html: true,
      trigger: 'hover',
      placement: 'bottom',
      content: function () { return '<img style="height: 100px; max-height:100px; max-width:100px;" src="' + $(this).data('img') + '" />'; }
    });
  function show_imagee(stop){
        $(".abc").removeClass("hide_image");
          }
          
   if ("#{browser.device.iphone?}" == "true")
   {
     $(".user_id_image1").css("transform", "transform: rotate(90deg);");
     $(".user_id_image2").css("transform", "transform: rotate(90deg);");
   }
   function visitor_show_goBack()
  {
    if (window.history.length == 1)
     {
      window.location.reload();
     }
     else
     {
      window.history.back();
     }
  }
  $('[data-toggle="visitor_popover"]').popover();
  
  $('#chat-logs').on('click', function(){
    if ($('#msg_history_a').children().length == 0){
    
    var loadAdminChat, loadAdminChatHelper;
    
    loadAdminChatHelper = function(chat) {
        if(chat.name == "Support Team"){
            $('#msg_history_a').append(`
                <div class="outgoing_msg_a">
                    <div class="sent_msg_a">
                        <p>${chat.message}</p>
                        <span class="time_date_a"> ${moment(chat.client_date).format("h:mm A | MMM D")} </span>
                    </div>
                </div>
            `)
        }
        else {
            $('#msg_history_a').append(`
                <div class="incoming_msg_a">
                    <div class="incoming_msg_img_a"> <img id="img_id_a" src=${chat.tour_user.image} alt=${chat.tour_user.name}> </div>
                    <div class="received_msg_a">
                        <div class="received_withd_msg_a">
                            <p>${chat.message}</p>
                            <span class="time_date_a"> ${moment(chat.client_date).format("h:mm A | MMM D")} </span>
                        </div>
                    </div>
                </div>
            `)
        }
    };

    loadAdminChat = function(chatArray) {
      for (var item in chatArray) {
          loadAdminChatHelper(chatArray[item])
      }
    };
    
    var chatroom_id = #{ raw @chatroom_id};

    if(chatroom_id != 0){
      $.ajax({
          type: 'GET',
          dataType: 'json',
          cache: false,
          url: '/chats/' + chatroom_id,
          success: function(data){
              loadAdminChat(data["chats"]);
              $("#msg_history_a").animate({ scrollTop: $('#msg_history_a').prop("scrollHeight")}, 1000);
          }
      });
    }
    }
  });
  function change_image(){
    if($('#floorplates_images :selected').text() != "Select the Floorplate"){
      var floorplate_id = $('#floorplates_images :selected').val()
      var community_id = #{ raw @community.id};

      $.ajax({
          type: 'GET',
          dataType: 'json',
          cache: false,
          url: '/communities/' + community_id + '/floorplates/' + floorplate_id + '/floatplate_images',
          success: function(data){
            $(".my_class").attr('src', data.image_src)
          },
          fail: function(data){
            console.log(data)
          }
      });
    }
  }

  function plot_data(){
    var is_sitemap = #{ @community.is_sitemap};
    var tour_history_id = $('#tour_histories_dates :selected').val()
    var dwelo_id;
    if(#{@community.dwelo.present?}){
     dwelo_id = "present"
     }
    else{
      dwelo_id = false
    }
    if (is_sitemap == false)
      var floorplate_id = $('#floorplates_images :selected').val()
    else
      var floorplate_id = 0
    var community_id = #{ raw @community.id};
    var tour_user_id = #{ raw @tour_user.id};
    
    if((is_sitemap == false && tour_history_id != "" && floorplate_id != "") || (is_sitemap == true && tour_history_id != "")){
      $.ajax({
          type: 'GET',
          dataType: 'json',
          cache: false,
          data:  {
          dwelo_id
            },
          url: '/communities/' + community_id + '/tour_users/' + tour_user_id + '/lock_ploting?tour_history_id=' + tour_history_id + '&floorplate_id=' + floorplate_id,
          success: function(data){
            $(".asdasd").children('i').remove()
            $("#unlock_history").children('h5').remove()
            // data.existing_stops.flat().forEach(draw_stop)
            data.lock_histories.flat().forEach(draw_history)
          },
          fail: function(data){
            console.log(data)
          }
      });
    }
    else{
      $(".asdasd").children('i').remove()
      $("#unlock_history").children('h5').remove()
    }
  }

  function draw_stop(stop, index){
    if(stop.x_plot + stop.y_plot > 1){
      var left_margin =  #{ ((@community.design.property_map_size_integer.to_f - 25) / 2.0).to_i }
      var right_margin = #{ ((20.0 / 25.0).to_f * (@community.design.property_map_size_integer)).to_i }

   //   $(".asdasd").append(`<i class="fa fa-unlock-alt stops" id="stop_${stop.id}" style="font-size: 35px; position: absolute; top: ${stop.y_plot - right_margin + 6}px; left: ${stop.x_plot - left_margin + 3}px; height:25px; width: 25px; color: #d37474; margin-top: 3px; "></i>`)
    }
  }

  function draw_history(stop, index){
      var time = stop.occured_at
      var occured_time = moment(time).zone(time);
      $("#unlock_history").append(`<h5 id="lock_histories_style" > <i class="fa fa-unlock-alt"></i> ${stop.stop_name} unlocked at ${occured_time.format("LT")}</h5>`)
  }

  $("#floorplates_images").change(function () {
        change_image()
        plot_data()
  });
  $("#tour_histories_dates").change(function () {
        plot_data()
  })

