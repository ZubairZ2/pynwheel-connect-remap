        - unless @chatroom_id == 0
          = link_to("Chat logs", "url" , class: "btn btn-success", id: "chat-logs", style: "float:right; margin-right: 8px;", data: { toggle: "modal", target: "#ChatSupport_a" })
        -#%span{:style => "float: right;"}
        -#  #{Time.zone.now}
        -#%span{:style => "float: right;"}
