.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "visitor_show_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
:javascript
   if ("#{browser.device.iphone?}" == "true")
   {
     $(".user_id_image1").css("transform", "transform: rotate(90deg);");
     $(".user_id_image2").css("transform", "transform: rotate(90deg);");
   }
   function visitor_show_goBack()
  {
    if (window.history.length == 1)
     {
      window.location.reload();
     }
     else
     {
      window.history.back();
     }
  }
  $('[data-toggle="visitor_popover"]').popover();