- content_for :title, "Visitor Details Page - Pynwheel"
/ Main content

%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          SUMMARY
          %span
            #{@tour_user.name}
        -#%span{:style => "float: right;"}
        -#  #{Time.zone.now}
        -#%span{:style => "float: right;"}
        -#  = image_tag  image_url("unlock.png"), :style => "height: 20px; width: 20px;"
        -#%span{:style => "float: right;"}
        -#  #{Time.zone.now}
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            .box.box-widget.panel-box.add-plan.pt-30
              .row
                .col-lg-6
                  .col-lg-12.name_div{:style => "background: #efefef; margin: 30px; left: 17px;  width: 92%; display: inline-flex; align-items: center;"}
                    .col-lg-3.col-md-3.col-sm-2.col-xs-6
                      = image_tag (@tour_user.image.present? ? @tour_user.image : "default-user128x128.jpg"), :class => "user_id_image1", :style => "height: 100%; width: 100px; margin-left: -48px; #{@tour_user.image.present? ? "" : ""}"
                    .col-lg-3.col-md-3.col-sm-3.col-xs-12.email_div{:style => " "}
                      %strong
                        #{(@tour_user.last_name.present? ? @tour_user.last_name + ", " : "") + (@tour_user.first_name.present? ? @tour_user.first_name : @tour_user.name)}
                      %br
                      %a.mt-5
                        #{@tour_user.email}
                      %br
                      .mt-5
                        #{@tour_user.phone_number}
                    .col-lg-6.col-md-6.col-sm-6.col-xs-6
                      = image_tag  (@tour_user.id_card.present? ? @tour_user.id_card : "default id card.jpg"), :class => "user_id_image2", :style => " width: 115px;  margin-left: 99px; #{@tour_user.id_card.present? ? "" : ""}"

                  .row
                    %h4{:style => "margin-left: 45px"}
                      Alert
                  .col-lg-12{:style => "background: #efefef; margin: 30px"}
                    - @alerts.order("id DESC").each_with_index do |alert,index|
                      - end_time = alert.left.present? ? alert.left : alert.lengthy_stay
                      .col-lg-6{:style => "#{index == 0 ? "margin-top: 5px" : "margin-top: 13px"}"}
                        .alert-div1{:style => "margin-top: 10px"}
                          = image_tag  image_url("icon-check.png"), :style => "height: 20px; width: 20px;", "data-content" => "Tour Start Time", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"
                          - if alert.arrived.present?
                            #{alert.arrived.to_date} #{alert.arrived.in_time_zone("Eastern Time (US & Canada)").strftime("%I:%M %p")}
                        %br
                        .alert-div2{:style => "margin-top: -10px"}
                          = image_tag  image_url("clock.png"), :style => "height: 20px; width: 20px;", "data-content" => "Time Duration", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"
                          #{((end_time.present? && alert.arrived.present? ? (end_time - alert.arrived) : 0) / 3600).to_i.to_s + " hour " + ((end_time.present? && alert.arrived.present? ? ((((alert.lengthy_stay - alert.arrived) / 3600) - ((alert.lengthy_stay - alert.arrived) / 3600).to_i ) * 60) : 0)).to_i.to_s + " Minutes"}
                        %br
                        .alert-div3{:style => "margin-top: -10px; margin-bottom: 10px"}
                          = image_tag  image_url("open.png"), :style => "height: 20px; width: 20px;", "data-content" => "Tour End Time", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"
                          - if end_time.present?
                            #{end_time.to_date} #{end_time.in_time_zone("Eastern Time (US & Canada)").strftime("%I:%M %p")}
                  //Tour Tracking
                  %h4{:style => "margin-left: 30px"}
                    Tour Tracking Tour 1
                  .col-lg-12.col-md-12.col-sm-12.col-xs-12{:style => "background: #efefef; margin: 30px"}
                    = image_tag  @community.is_sitemap ? @community.sitemap.image : @community.floorplates.first.image, :class => "my_class", :style => "height: 100%; width: 100%;"

                .col-lg-6
                  .col-lg-12{:style => "background: #efefef; margin: 30px; height: -webkit-fill-available; width: -webkit-fill-available; overflow: auto;"}
                    - @visited_stop.each do |stop|
                      - @stop = TourStop.find stop[0].to_i rescue next
                      - @stop = @stop.stop_type.classify.constantize.find_by_id(@stop.stop_id)
                      .row
                        - image_hit = true
                        - stop[1].each do |stop_image|
                          - if stop_image.image.present?
                            - if image_hit
                              .col-lg-12{:style => "margin-top: 10px; margin-bottom: 5px;"}
                                %strong{:style => "font-size: 16px;"}
                                  #{@stop.name}
                              .col-lg-2.col-md-2.col-sm-6.col-xs-6
                                Tour photo
                                %br
                                = image_tag  @stop.image, :class => "my_class", :style => "height: 72px; width: 100px; margin-top: 10px;"
                                - image_hit = false
                            .col-lg-2.col-md-2.col-sm-6.col-xs-6.user_photo
                              User photo
                              %br
                              - if stop_image.is_rotated == true
                                = image_tag  stop_image.image.url, :class => "", :style => "height: 100px; width: 72px; margin-top: -4px; margin-left: 10px; transform: rotate(90deg);"
                              - else
                                = image_tag  stop_image.image.url, :class => "", :style => "height: 74px; width: 100px; margin-top: 8px; margin-left: 0px; "
                        - stop[1].each do |stop_decription|
                          - if stop_decription.description.present?
                            .col-lg-8.col-md-6.col-sm-12.col-xs-12.user_description
                              User Notes
                              %br
                              .user_note{:style => "background: ;"}
                                -##{stop_decription.description}
                                = text_area_tag stop_decription.description,stop_decription.description,:class=>"form-control mb-20 ", :rows => "3", :readonly => true, :style => "background: white; margin-top: 10px;"

                    -#.col-lg-12{:style => "background: #efefef;  margin: 30px "}
                    -#  .col-lg-12
                    -#    Pool
                    -#  .col-lg-2
                    -#    Tour photo
                    -#    = image_tag  "default-user128x128.jpg", :class => "my_class", :style => "height: 50px; width: 50px;"
                    -#  .col-lg-2
                    -#    User photo
                    -#    = image_tag  "default-user128x128.jpg", :class => "my_class", :style => "height: 50px; width: 50px;"
                    -#  .col-lg-8
                    -#    User Notes
                    -#    %br
                    -#    jher gr grgr grag grgrgr grioghio grg r gr grugrbsg grugr grgrg
                    -#.col-lg-12{:style => "background: #efefef;  margin: 30px"}
                    -#  .col-lg-12
                    -#    Pool
                    -#  .col-lg-2
                    -#    Tour photo
                    -#    = image_tag  "default-user128x128.jpg", :class => "my_class", :style => "height: 50px; width: 50px;"
                    -#  .col-lg-2
                    -#    User photo
                    -#    = image_tag  "default-user128x128.jpg", :class => "my_class", :style => "height: 50px; width: 50px;"
                    -#  .col-lg-8
                    -#    User Notes
                    -#    %br
                    -#    jher gr grgr grag grgrgr grioghio grg r gr grugrbsg grugr grgrg




