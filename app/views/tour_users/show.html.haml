  function draw_a_line(vertices, data_array) {

    ctx.lineWidth = 5;
    ctx.strokeStyle = "blue";
    // calculate incremental points along the path
    already_displayed = false; 
    // already_displayed =isItemInArray(already_watched,[selected_floor[0],selected_building[0]])
    //already_displayed ? ( points = vertices) :  points = calcWaypoints(vertices)
    //debugger;
    points = calcWaypoints(visitedPoints);
    // extend the line from start to finish with animation

    animate(points);

    function animate() {
      if(already_displayed) {
        requestAnimationFrame(animate);
      }
      else {
        if (t <= points.length - 1) {
          
          if(points[t-2] != undefined &&  vertices[vertices_count] && points[t-2] && vertices[vertices_count].x == points[t-2].x && vertices[vertices_count].y == points[t-2].y ) { 
            //debugger;  
            close_pop();
            if (data_array[vertices_count] != undefined) {

              $('[data-toggle="propertyDetailNamePopover'+vertices_count+'"]:last').popover({
                              boundary:'window',
                              html: true,
                              trigger: "hover",
                              placement: 'top',
                              template: '<div class="popover pyn-popover visitor-popover" style="left: -43px !important; width: 250px; " ><div class="arrow visitors-hints-arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style = "height: 115px;color: black;background: #efefef;"><div style="float: right"></div><b>Stop Name:</b>'+data_array[vertices_count][1].name +'<br><b>Arrival Time:</b> '+ data_array[vertices_count][1].arrival_time +' <br><b>Departure Time:</b> '+ data_array[vertices_count][1].departure_time + '<br><b>Door Unlock Time:</b> '+ (data_array[vertices_count][1].is_lock_present ? data_array[vertices_count][1].arrival_time : "N/A") + '<br></div></div>'
                            }).popover('show');
            }
            
            vertices_count++;
            if(data_array[vertices_count - 1] == undefined)
              wait_time = 1000;
            else
              wait_time = 5000;
            
            setTimeout(function(){
              requestAnimationFrame(animate);
            }, wait_time);
          }
          else {
            requestAnimationFrame(animate);
          }
          
        }
        else {
          close_pop();
          if (data_array[vertices_count] != undefined) { 
            $('[data-toggle="propertyDetailNamePopover'+vertices_count+'"]:last').popover({
                        boundary: 'window',
                        html: true,
                        trigger: "hover",
                        placement: 'top',
                        template: '<div class="popover pyn-popover visitor-popover" style="left: -43px !important; width: 250px; " ><div class="arrow visitors-hints-arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style = "height: 115px;color: black;background: #efefef;"><div style="float: right"></div><b>Stop Name:</b>'+data_array[vertices_count][1].name +'<br><b>Arrival Time:</b> '+ data_array[vertices_count][1].arrival_time +' <br><b>Departure Time:</b> '+ data_array[vertices_count][1].departure_time +'<br><b>Door Unlock Time:</b> '+ (data_array[vertices_count][1].is_lock_present ? data_array[vertices_count][1].arrival_time : "N/A") +'<br></div></div>'
                      }).popover('show');
          }

          automateUserTracking();

          if(is_community_sitemap) {
            enableButtons();
            setTimeout(function(){$('.popover').popover('hide')}, 5000);
          }
          
          if(!automateTracking) {
            enableButtons();
            setTimeout(function(){$('.popover').popover('hide')}, 5000);
          }
        }
      }

      // draw a line segment from the last waypoint
      // to the current waypoint
    
      if(points.length > 1) {
        if(points[t] && points[t-1]) {
          ctx.beginPath();
          ctx.moveTo(points[t - 1].x, points[t - 1].y);
          ctx.lineTo(points[t].x, points[t].y);
          ctx.stroke();
        }
      }
      
      // increment "t" to get the next waypoint
      t++;

    }
  }

  function diableButtons() {
    disableAnimationBtns();
    $("#tour_histories_dates").attr("disabled", true);
  }

  function enableButtons() {
    enableAnimationBtns();
    $("#tour_histories_dates").attr("disabled", false); 
  }

  function automateUserTracking() {
    if(buildingIndex < buildingsArray.length && automateTracking) {
      if(floorIndex < floorsArray.length) {      
        if(floorIndex === (floorsArray.length -1)) {
          buildingIndex = buildingIndex + 1;
          floorIndex = 0;
          disableAutomateTracking();
          animateToNextFloor();

        } else {
          floorIndex = floorIndex + 1;
          animateToNextFloor();
        }
      }
    }
  }

  function disableAutomateTracking() {
    if(buildingIndex > (buildingsArray.length - 1)) {
      enableAnimationBtns();
      $("#tour_histories_dates").attr("disabled", false);
      automateTracking = false;
      setTimeout(function(){$('.popover').popover('hide')}, 5000);
    }
  }

  function animateToNextFloor() {
    if(checkNextFloor()) {
      setTimeout(function() {
        if(buildingsArray[buildingIndex]) {
          $('.building_btn').each(function( index, item ) { item.style.background = ""; $('#'+item.id).removeClass('selected_building');});
          $('#building_'+buildingsArray[buildingIndex])[0].style.background = "green";
          $('#building_'+buildingsArray[buildingIndex]).addClass('selected_building');
        }

        $(`#floor_${floorsArray[floorIndex]}`).click();
      }, 1000);
    } else {
      automateUserTracking();
    }
  }

  function checkNextFloor() {
    let isToDisplay = false

    for(let s = 0; s < tempVisitedStopsData.length; s++) {
      let currentFloor = ( tempVisitedStopsData[s] && (String(floorsArray[floorIndex]) ==  String(tempVisitedStopsData[s][1].floor) ) )
      let currentBuilding = ( tempVisitedStopsData[s] && (String(buildingsArray[buildingIndex]) ==  String(tempVisitedStopsData[s][1].building) ) )

      if( currentFloor && currentBuilding && tempVisitedStopsData[s] && (tempVisitedStopsData[s][2] === "unit" || tempVisitedStopsData[s][2] === "amenity")) {
        isToDisplay = true 
      }
    }

    return isToDisplay;
  }

  function enableAnimationBtns() {
    $(".btns").removeClass("tracking_btns");
  }

  function disableAnimationBtns() {
    $(".btns").addClass("tracking_btns");
  }

