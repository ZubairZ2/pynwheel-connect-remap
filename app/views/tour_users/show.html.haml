                            -# %i.fa.fa-camera-retro{:style => " font-size:12px; color: #d37474; margin-top: 3px; "}

                        -# - elsif stop.class.to_s == "Elevator"

                          -# - if (!@community.is_sitemap && (stop.floors.include?(@floor.to_i))) || (stop.floorplate_covering_range == "-")
                            -# %i.fa.fa-reorder.stops.stop{:id => "stop_#{stop.id}", :style => "font-size: 25px; position: absolute; top: #{stop.y_plot}px; left: #{stop.x_plot}px; height:25px;width: 25px; color: #d37474; margin-top: 3px; "}


                        -# - else
                          -# - next if (stop.y_plot + stop.x_plot) < 1
                          -# %i.fa.fa-map-marker.stops{:id => "stop_#{stop.id}", :style => "font-size: 35px; position: absolute; top: #{stop.y_plot - right_margin + 6}px; left: #{stop.x_plot - left_margin + 3}px; height:25px;width: 25px; color: #d37474; margin-top: 3px; "}
                  .col-lg-12.p-0
                    .col-lg-4
                    .col-lg-8#unlock_history
                      - @visited_units_history.each_with_index do |unit, index|
                        - if unit.event == "unlocked_event" 
                          %h5#lock_histories_style
                            %i.fa.fa-unlock-alt
                            #{unit.stop_name} unlocked at #{unit.occured_at.strftime("%l:%M %p")}
                      - @visited_amenities_history.each_with_index do |amenity, index|
                        - if amenity.event == "unlocked_event" 
                          %h5#lock_histories_style 
                            %i.fa.fa-unlock-alt
                            #{amenity.stop_name} unlocked at #{amenity.occured_at.strftime("%l:%M %p")}


                .col-lg-6
                  %h4{:style => "margin-left: 30px"}
                    Stops Visited
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridAvailableDatePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        This section will show you what time each stop that was visited on the tour, and photos and notes that were taken by the visitor at each stop.
                  .col-lg-12{:style => "background: #efefef; margin: 30px; height: -webkit-fill-available; width: -webkit-fill-available; overflow: auto;"}

                    - @visited_stop.each do |stop|
                      - @stop = TourStop.find stop[0].to_i rescue next
                      - @stop = @stop.stop_type.classify.constantize.find_by_id(@stop.stop_id)
                      -unless (@stop.is_a? Elevator) || (@stop.is_a? BuildingStartingPoint) || (stop[0].to_i == @community.tour.id)
                        .row{:style => "margin-top: 3px;"}
                          - image_hit = true
                          - description_hit = true
                          - is_data_loaded = false
                          %a.preview-image{:href=> @stop.image? ? @stop.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Stop Image"}
                            %img{:src => "/assets/checkbox.png", :style => "height:20px; width:20px;color:green; margin-left: 13px; color: green;", "data-placement" => "top", "data-img" => "#{@stop.image.url}", "data-toggle-placement"=>"right", "data-toggle" => "popover-hover"}
                          %strong{:style => "font-size: 16px; position: relative; margin-left: 5px;"}
                            #{@stop.name}
                          - stop[1].sort_by(&:id).reverse.each do |stop_image|
                            - if image_hit
                              .col-lg-12{:style => "margin-top: 10px; margin-bottom: 5px;"}
                              .row{:style => "margin-left: 13px; margin-right: 0px;"}
                                %text{:style => "color: gray"}
                                  - if (stop[1][0].present?) && (@virtual_list.include? stop[1][0].tour_key) 
                                    %img{:src => image_url("virtual_eye_black.png"), :width => "18px"}/
                                  - else
                                    %img{:src => "https://img.icons8.com/android/16/000000/walking.png"}/  
                                  -# -image_hit = false

                                  = stop_image.event_date.present? ? stop_image.event_date.strftime("%m/%d/%Y") : stop_image.created_at.strftime("%m/%d/%Y")
                                  = stop_image.event_time.present? ? stop_image.event_time.strftime("%I:%M %p") : stop_image.created_at.strftime("%I:%M %p")
                          - stop[1].each do |stop_image|
                            - if stop_image.image.url.present?
                              - is_data_loaded = true
                              = image_tag  @stop.image, :class => "my_class", id: "#{@stop.id}", :style => " display: none; height: 72px; width: 100px; margin-top: 10px;"
                              = " "
                              - if stop_image.is_rotated == true
                                = image_tag  stop_image.image.url, :class => "", :style => "height: 200px; width: auto; margin-top: -4px; margin-left: 28px; transform: rotate(90deg);"
                              - else
                                = image_tag  stop_image.image.url, :class => "", :style => "height: 148px; width: auto; margin-top: 8px; margin-left: 15px; "
                          - stop[1].each do |stop_decription|
                            - if stop_decription.description.present?
                              - is_data_loaded = true
                              - if description_hit
                                .col-lg-12{:style => "margin-bottom: 5px;"}
                                  -#%strong{:style => "font-size: 16px;"}
                                    -##{@stop.name}
                              - description_hit = false
                              .col-lg-8.col-md-6.col-sm-12.col-xs-12.user_description
                                %strong{:style => "font-size: 16px;"}
                                  Notes
                                %text{:style => "color: gray"}
                                %br
                                .user_note{:style => "background: ;"}
                                  -##{stop_decription.description}
                                  = text_area_tag stop_decription.description,stop_decription.description,:class=>"form-control mb-20 ", :rows => "3", :readonly => true, :style => "background: white; margin-top: 10px;"
                          / - unless is_data_loaded
                        %hr{:style => "border-top: 2px solid white; margin-left: -15px; margin-right: -15px;"}


