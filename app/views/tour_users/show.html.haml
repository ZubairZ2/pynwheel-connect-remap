  function draw_a_line(vertices, data_array)
  {
    ctx.lineWidth = 5;
          ctx.strokeStyle = "blue";
          // calculate incremental points along the path
          var points = calcWaypoints(vertices);
          // extend the line from start to finish with animation

          animate(points);
          
           function animate() {
          if (t < points.length - 1) {
              if(points[t-2] != undefined && vertices[vertices_count].x == points[t-2].x && vertices[vertices_count].y == points[t-2].y )
              { 
                $(".popover").popover('hide');

                if (data_array[vertices_count] != undefined)
                {$('[data-toggle="propertyDetailNamePopover'+vertices_count+'"]').popover({
                                  html: true,
                                  placement: 'top',
                                  template: '<div class="popover" style="left: -43px !important; width: 250px;" ><div class="arrow"></div><div class="popover-body popover-padding" style = "color: black;background: #efefef;"><b>Stop Name:</b>'+data_array[vertices_count][1].name +'<br><b>Access Code:</b>'+data_array[vertices_count][1].stop_pin +'<br><b>Arrival Time:</b> '+ data_array[vertices_count][1].arrival_time +' <br><b>Departure Time:</b> '+ data_array[vertices_count][1].departure_time +'<br><b>Locks Access Time:</b> 55<br><b>Door Unlock Time:</b> '+ lock_access_time +'<br></div></div>'
                                }).popover('show');}
                  vertices_count++;
                  setTimeout(function(){
                      //do what you need here
                  }, 2000);
                  requestAnimationFrame(animate);
              }
              else
              {
                requestAnimationFrame(animate);
              }
              
          }
          else
          {
            sleep(2000);
            $(".popover").popover('hide');
            if (data_array[vertices_count] != undefined)
            {$('[data-toggle="propertyDetailNamePopover'+vertices_count+'"]').popover({
                          html: true,
                          placement: 'top',
                          template: '<div class="popover" style="left: -43px !important; width: 250px;" ><div class="arrow"></div><div class="popover-body popover-padding" style = "color: black;background: #efefef;"><b>Stop Name:</b>'+data_array[vertices_count][1].name +'<br><b>Access Code:</b>'+data_array[vertices_count][1].stop_pin +'<br><b>Arrival Time:</b> '+ data_array[vertices_count][1].arrival_time +' <br><b>Departure Time:</b> '+ data_array[vertices_count][1].departure_time +'<br><b>Locks Access Time:</b> 55<br><b>Door Unlock Time:</b> '+ lock_access_time +'<br></div></div>'
                        }).popover('show');}
          }
          // draw a line segment from the last waypoint
          // to the current waypoint
          ctx.beginPath();
          ctx.moveTo(points[t - 1].x, points[t - 1].y);
          ctx.lineTo(points[t].x, points[t].y);
          ctx.stroke();
          // increment "t" to get the next waypoint
          t++;

      }
  }
