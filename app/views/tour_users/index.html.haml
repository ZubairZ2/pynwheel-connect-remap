- content_for :title, "Visitor Details Page - Pynwheel"
.divLoading.hidden
/ Main content
- time_zone = @community.get_time_zone()
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          VISITORS

    .row{:style => "margin-bottom: 70px;"}
      .col-lg-12.col-md-12
        .row
          .col-md-12#outer_div
            .box.box-widget.panel-box.add-plan.pt-30
              - if @tour_users.count == 0
                %h3{:style => "text-align: center; font-weight: bolder"}
                  No Visitor To Display
              %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units.schedule_tour_table
                %thead
                  %tr
                    %th Tour Date & Time
                    %th Image
                    %th Name
                    %th Email
                    %th Phone
                    %th
                    %th Visitor Details
                    - if @community.community_tour.visual_id_verification
                      %th ID Verification
                    - if (current_user.is_super_admin?)
                      %th Action

                %tbody
                  - @tour_users.each_with_index  do |user,index|
                    .row
                      %tr
                        %td.col-lg-2
                          .visitor_list.custom_label_color
                            #{(user.tour_histories.where(tour_id: @community.community_tour.id).last.arrived.in_time_zone(time_zone)).strftime("%Y-%m-%d") rescue nil} #{(user.tour_histories.where(tour_id: @community.community_tour.id).last.arrived.in_time_zone(time_zone)).strftime("%I:%M %p") rescue nil}
                        %td
                          .col-lg-1
                            - if user.image.present?
                              - if user.image.url.include? "default-user128x128.jpg"
                                Removed at Consumer Request
                              - else
                                = image_tag  user.image.present? ? user.image :  "default-user128x128.jpg", :class => "user_id_image", :style => "width: 100px; #{user.image.present? ? "" : ""}"
                            - else
                              = image_tag  user.image.present? ? user.image :  "default-user128x128.jpg", :class => "user_id_image", :style => "width: 100px; #{user.image.present? ? "" : ""}"
                          .col-lg-1{style: "float: right;"}
                            - if user.image.present?
                              - unless user.image.url.include? "default-user128x128.jpg"
                                - if (current_user.is_super_admin?)
                                  %i.fa.fa-remove{class: "image_cross" ,"data-name"=>"visitor image", "data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?image=true", "data-target" => "#confirm-delete-visitor", "data-toggle" => "modal"}
                        %td
                          .col-lg-2.visitor_list
                            - unless user.last_name == "Removed at Consumer Request" or user.first_name == "Removed at Consumer Request"or user.name == "Removed at Consumer Request"
                              = link_to "#{(user.last_name.present? ? user.last_name + ", " : "") + (user.first_name.present? ? user.first_name : user.name)}","/communities/#{@community.id}/tour_users/#{user.id}",:class => "name-list"
                            - else
                              = (user.first_name.present? ? user.first_name : user.name)
                          .col-lg-1{style: "float: right;"}
                            - if user.last_name.present? or user.first_name.present? or user.name.present?
                              - unless user.last_name == "Removed at Consumer Request" or user.first_name == "Removed at Consumer Request"or user.name == "Removed at Consumer Request"
                                - if (current_user.is_super_admin?)
                                  %i.fa.fa-remove{class: "name_cross", "data-name"=>"visitor name", "data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?name=true", "data-target" => "#confirm-delete-visitor", "data-toggle" => "modal"}

                        %td
                          .col-lg-2
                            .visitor_list
                              - if user.email ==  "Removed at Consumer Request"
                                = user.email
                              - else
                                = link_to "#{user.email}", "/communities/#{@community.id}/tour_users/#{user.id}"
                          .col-lg-1{style: "float: right;"}
                            - if (current_user.is_super_admin?)
                              - unless user.email ==  "Removed at Consumer Request"
                                .desing_cross
                                  %i.fa.fa-remove{class: "name_cross","data-name"=>"visitor email", "data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?email=true", "data-target" => "#confirm-delete-visitor", "data-toggle" => "modal"}

                        %td
                          .col-lg-1
                            .visitor_list
                              #{user.phone_number}
                          .col-lg-1{style: "float: right;"}
                            - if user.phone_number.present?
                              - if user.phone_number != "Removed at Consumer Request"
                                - if (current_user.is_super_admin?)
                                  .desing_cross
                                    %i.fa.fa-remove{class: "name_cross","data-name"=>"visitor phone number", "data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?phone_number=true", "data-target" => "#confirm-delete-visitor", "data-toggle" => "modal"}
                        %td.col-lg-2
                          .visitor_list
                            - if TourHistory.where(tour_user_id: user.id, tour_id: @community.community_tour.id, history: false).present?
                              - if TourHistory.where(tour_user_id: user.id,lengthy_stay_email_sent: true,tour_id: @community.community_tour.id).present?
                                = image_tag  "clock.png", :style => "height: 20px; width: 20px;  margin-left: 20px;", "data-content" => "Lengthy Stay", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"

                              - if TourHistory.where(tour_user_id: user.id,id_mismatch: true,tour_id: @community.community_tour.id).present?
                                = image_tag  "calender.png", :style => "height: 20px; width: 20px; margin-left: 20px;", "data-content" => "ID Mismatch", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"
                              - if TourHistory.where.not(tour_user_id: user.id,abandoned_tour_at_stop: true,tour_id: @community.community_tour.id).present?
                                = image_tag  "open.png", :style => "height: 20px; width: 20px;  margin-left: 20px;", "data-content" => "Tour Abandoned", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"
                              .col-lg-1{style: "float: right;"}
                                - if (current_user.is_super_admin?)
                                  %i.fa.fa-remove{class: "history_cross","data-name"=>"visitor history", "data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?history=true", "data-target" => "#confirm-delete-visitor", "data-toggle" => "modal"}
                              - if user.property_access_code.present? && @community.community_tour.tour_setting.enable_restricted_property_access
                                %div{style: "margin-top: inherit"}
                                  Access Code: #{user.property_access_code}
                                  - tour_length = @community.community_tour.tour_setting.length_stay_limit
                                  - if Time.now > (user.property_access_code_generated_at + tour_length.minutes)
                                    %i.fa.fa-exclamation-triangle.expiredTourToolTip{style: "margin-left: 3px", "data-content" => "Access Code has expired", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"}
                                  - else
                                    %i.propertyDetailName.fa.fa-question-circle{"data-content" => "Will be expired after #{tour_length} minutes", "data-toggle" => "visitor_popover", "data-trigger" => "hover",  "data-placement" => "top"}
                             
                              - if user.customized_tour(@community)
                                %div
                                  = link_to 'Reset Tour Stops', community_tour_user_reset_tour_stops_path(@community, user),:class=>"btn btn-success"

                            - else
                              - if user.customized_tour(@community)
                                %div
                                  = link_to 'Reset Tour Stops', community_tour_user_reset_tour_stops_path(@community, user),:class=>"btn btn-success"

                              Removed at Consumer Request

                        %td.col-lg-2
                          .visitor_list
                            = link_to 'Visitor Details' , community_tour_user_path(@community,user),:class=>"btn btn-default black-button loader_class"
                        - if @community.community_tour.visual_id_verification
                          %td.col-lg-2
                            - if (user.authentiq_verified_at.present? && ((Time.now.utc + 5.hours) < (user.authentiq_verified_at + 30.days))) && user.is_authentiq_verified && @community.community_tour.verification_type == "authenteq"
                              .visitor_list
                                #{(user.authentiq_verified_at).strftime("%Y-%m-%d") rescue nil} #{(user.authentiq_verified_at).strftime("%I:%M %p") rescue nil}
                                - if current_user.is_super_admin?
                                  %a{"data-name"=>"id verification","data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?authentiq_verified_at=true", "data-target" => "#confirm-reset-verification", "data-toggle" => "modal", "class" => "btn btn-default black-button", "style" => "margin-top: 2%;"}
                                    Reset
                            - elsif (user.checkpoint_verified_at.present? && ((Time.now.utc + 5.hours) < (user.checkpoint_verified_at + 30.days))) && user.is_checkpoint_verified && @community.community_tour.verification_type == "check_point_id"
                              .visitor_list
                                #{(user.checkpoint_verified_at).strftime("%Y-%m-%d") rescue nil} #{(user.checkpoint_verified_at).strftime("%I:%M %p") rescue nil}
                                - if current_user.is_super_admin?
                                  %a{"data-name"=>"id verification","data-href" => "/communities/#{@community.id}/tour_users/#{user.id}?checkpoint_verified_at=true", "data-target" => "#confirm-reset-verification", "data-toggle" => "modal", "class" => "btn btn-default black-button", "style" => "margin-top: 2%;"}
                                    Reset
                            - else
                              Never Verified
                        - if (current_user.is_super_admin?)
                          %td
                            %a.text-danger{"data-name"=>"visitor","data-href" => "/communities/#{@community.id}/tour_users/#{user.id}", "data-target" => "#confirm-delete-visitor", "data-toggle" => "modal"}
                              %i.fa.fa-trash.icon_size

.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "visitor_index_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE

:javascript
  $(document).ready(function () {
    $('#miyazaki').DataTable({
      "order": [[ 0, "desc" ]]
    });

    $('.dataTables_length').addClass('bs-select');
  });

  if ("#{browser.device.iphone?}" == "true")
    $(".user_id_image").css("transform", "transform: rotate(90deg);");

  function visitor_index_goBack() {
    window.location.reload();
  }

  $('[data-toggle="visitor_popover"]').popover();