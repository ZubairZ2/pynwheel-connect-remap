- content_for :title, "Visitor Details Page - Pynwheel"
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          VISITORS
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            .box.box-widget.panel-box.add-plan.pt-30
              - @tour_users.each_with_index  do |user,index|
                %a{:href => "/communities/#{@community.id}/tour_users/#{user.id}", :style => "display:block"}
                  .list-group-item{:style => "background: #{index%2 == 1 ? "#e8e8e8" : ""}", :onclick => "click_list(#{user.id})"}
                    .row
                      .col-lg-2.visitor_list.custom_label_color
                        #{Time.now}
                      .col-lg-1

                        = image_tag  user.image.present? ? user.image :  "default-user128x128.jpg", :class => "my_class", :style => "height: 75px; width: 75px; #{user.image.present? ? "transform: rotate(90deg);" : ""}"
                      .col-lg-2.visitor_list
                        = link_to "#{(user.last_name.present? ? user.last_name + ", " : "") + (user.first_name.present? ? user.first_name : user.name)}","/communities/#{@community.id}/tour_users/#{user.id}"
                      .col-lg-2.visitor_list
                        = link_to "#{user.email}", "/communities/#{@community.id}/tour_users/#{user.id}"
                      .col-lg-1.visitor_list
                        333.33333.3233
                      .col-lg-2.visitor_list
                        - if TourHistory.where(tour_user_id: user.id,lengthy_stay_email_sent: true,tour_id: @community.tour.id).present?
                          = image_tag  "clock.png", :style => "height: 20px; width: 20px;  margin-left: 30px;"
                        - if TourHistory.where(tour_user_id: user.id,id_mismatch: true,tour_id: @community.tour.id).present?
                          = image_tag  "calender.png", :style => "height: 20px; width: 20px; margin-left: 40px;"
                        - if TourHistory.where.not(tour_user_id: user.id,abandoned_tour_at_stop: true,tour_id: @community.tour.id).present?
                          = image_tag  "open.png", :style => "height: 20px; width: 20px;  margin-left: 30px;"

