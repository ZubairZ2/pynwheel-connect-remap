.divLoading.hidden
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-pagelines
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    / Start Tabs Secttions
    .bs-example.bs-example-tabs{"data-example-id" => "togglable-tabs"}
      #myTabContent.tab-content
        / Start image-slide section
        #image-slide.tab-pane.fade.active.in{:role => "tabpanel"}
          .row
            .col-md-6
              %h4 #{@imagepage.name.capitalize} Gallery - #{@page_images.count} #{@page_images.count > 1 ? "images" : "image"}
          .row
            %h4.col-lg-12{:style => "color: grey;"}
              Images will appear at a size of 1920 x 1080 px when fully expanded. Please note that images that are too small may appear pixelated.
            .col-md-6
              .mt-35
                %span.btn.btn-success.btn-file.text-UP.pull-left{:onclick=>"$('#additional-image-upload-holder').click();"}
                  %i.fa.fa-plus-circle
                  Add Files
                  / %input#gallery-images{:multiple => "multiple", :type => "file"}/

              .mt-35
          /       = form_tag save_gallery_video_community_gallery_path(@community,@gallery),:method=>"POST",:id=>"gallery-page-video-form",:multipart => true,:remote=>true  do 
          /         %span.btn.btn-primary.btn-file.ml-5.text-UP.pull-left
          /           %i.fa.fa-plus-circle
          /           Add Video
          /           = file_field_tag :gallery_page_video
          #images-index
            = render 'index'
        / End image-slide section
    / End Tabs Secttions
/ /.content
/ End Body right Section
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "imagepage_show_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  var imagepage_id = #{params[:id]}
  function imagepage_show_goBack()
    {
      if (window.history.length == 1)
      {
        window.location.reload();
      }
      else
      {
        window.history.back();
      }
    }