.text-center.image-upload.home-page-drag-box#additional-image-upload-holder
  = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
  %p Drop files here or click to Upload
.row.slide-imgage-boxs.sortable
  - sortable_fetch(@page_images) do |additional_image, id_tag|
    .col-lg-3{:id=> id_tag}
      .slide-image
        .image-box.video-box
          .images.height-200
            - rn =  rand(9999999999999999999999999)
            %a.preview-image{:href=>additional_image.image? ?  additional_image.image.url  + "?timestamp=#{rn}" : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>additional_image.name}
              = image_tag additional_image.image.url  + "?timestamp=#{rn}", :style => "min-height: 100%; min-width: 100%;"
          = image_tag "exclamation-mark.png", class: "waring_exal #{(additional_image.image.width < 500 && additional_image.image.height < 400) ? "" : "hidden"}", style: "width: 25px", "data-content" => "Too small image", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"

        .icons
          = link_to show_image_in_modal_community_imagepage_path(@community,@imagepage,additional_image_id: additional_image.id), remote: true do 
            %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}
          %a.text-danger{"data-name"=>"Image","data-href" => "#{ delete_additional_image_community_imagepage_path(@community,@imagepage,:additional_image_id => additional_image.id)}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
            %i.fa.fa-close
        %h4= additional_image.name

:javascript
  $(document).ready(function(e){
  $('[data-toggle="popover"]').popover();
  });