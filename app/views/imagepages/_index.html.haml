.text-center.image-upload.home-page-drag-box#additional-image-upload-holder
  = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
  %p Drop files here or click to Upload
.row.slide-imgage-boxs.sortable
  - sortable_fetch(@page_images) do |gallery_image, id_tag|
    .col-lg-3{:id=> id_tag}
      .slide-image
        .image-box.video-box
          .images.height-200
            %a.preview-image{:href=>gallery_image.image? ? gallery_image.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>gallery_image.name}
              = image_tag gallery_image.image.url
        .icons
          = link_to '#', remote: true do 
            %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}
          %a.text-danger{"data-href" => "#", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
            %i.fa.fa-close
        %h4= gallery_image.name