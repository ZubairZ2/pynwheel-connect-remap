- content_for :title, "Property Details - Pynwheel"
.divLoading.hidden
%section.is-community-page
  .content
    - if @community.creator_id.present? and @community.creator.present? and @community.creator.role == "Dwelo admin"
      .box-info.add-plan{style: "margin-right: 10px;"}
        %img.dwelo-logo{:alt => "Smiley face", :src => "/assets/Dwelo-Logo.png"}
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          PROPERTY
          %span DETAILS

      = form_for @community,:url=>company_community_path(current_company,@community),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , company_communities_path(current_company), :class=>"btn btn-default pull-right"
          = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right mr-10 loader_class"

:javascript
  $(document).ready(function(e){
    if (!(#{current_user.welcome_prompt}))
    {
      $('#welcome-prompt-modal1').modal('show');
    }
  });
  
  if("#{@chatroom&.id&.present?}" == "true")
  {
    show_modal();
  }

  function show_modal()
  {
    setTimeout(function(){
      $("#ChatSupport").modal('show');
      if ($("#chat_person_#{@chatroom&.id}").length == 0) {
        
       

        $('#support_sidebar').prepend(`
            <div class="chat_list" id="chat_with_#{@chatroom&.id}">
                <div class="chat_people">
                    <div class="chat_img"> <img id="img_id" src=#{@chatroom&.tour_user&.present? ? (@chatroom&.tour_user&.image.present? ? @chatroom&.tour_user&.image : "/assets/chat-tour-user.jpg") : ""} alt=#{@chatroom&.tour_user&.present? ? @chatroom&.tour_user&.name : ""}> </div>
                    <div class="chat_ib">
                        <a class="sidebar-chat" data-remote="true" href="/chats/#{@chatroom&.id}" style="overflow: hidden;display: block; width: 100%;" id="chat_person_#{@chatroom&.id}" > 
                            <p> <span style="color: black;"> #{@chatroom&.tour_user&.present? ? @chatroom&.tour_user&.name : ""} </span></p>
                            <p> <a> #{@chatroom&.tour_user&.present? ? @chatroom&.tour_user&.email : ""} </a> </p>
                        </a>
                    </div> 
                </div>
            </div>`);

        $("#chat_person_#{@chatroom&.id}").click();
        $("#chatroom_id").val( "#{@chatroom&.id}" );
      }
      else
      {
        $("#chat_person_#{@chatroom&.id}").click();
        $("#chatroom_id").val( "#{@chatroom&.id}" );  
      }
    }, 1000);
  }