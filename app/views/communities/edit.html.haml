- content_for :title, "Property Details - Pynwheel"
= render "theme"

.divLoading.hidden
%section.is-community-page
  .content
    .pyn-form.property-form-page
      = link_to root_path, class: "back" do
        %i.fa.fa-angle-left
        All properties
      %h1= @community.name.presence || "Property ##{@community.id}"
      %p.sub
        %b= current_company.name
        - if @community.code.present?
          %span.dot ·
          = @community.code
        - if @community.data_provider.present?
          %span.dot ·
          = "#{@community.data_provider} feed"

      - if @community.creator_id.present? && @community.creator.present? && @community.creator.role == "Dwelo admin"
        .dwelo-flag
          %img.dwelo-logo{alt: "Dwelo", src: "/assets/Dwelo-Logo.png"}

      = form_for @community, url: company_community_path(current_company, @community), html: { class: "property-form" } do |f|
        = render partial: "form", locals: { f: f }

        .pf-actionbar
          %span.grow Changes here affect the eBrochure, the app and the Neighborhood page.
          = link_to "Cancel", company_communities_path(current_company), class: "btn btn-ghost"
          = f.submit "Save changes", class: "btn btn-success loader_class"

:javascript
  $(document).ready(function(e){
    if (!(#{current_user.welcome_prompt}))
    {
      $('#welcome-prompt-modal1').modal('show');
    }
  });

  if("#{@chatroom&.id&.present?}" == "true")
  {
    show_modal();
  }

  function show_modal()
  {
    setTimeout(function(){
      $("#ChatSupport").modal('show');
      if ($("#chat_person_#{@chatroom&.id}").length == 0) {
        $('#support_sidebar').prepend(`
            <div class="chat_list" id="chat_with_#{@chatroom&.id}">
                <div class="chat_people">
                    <div class="chat_img"> <img id="img_id" src=#{@chatroom&.tour_user&.present? ? (@chatroom&.tour_user&.image.present? ? @chatroom&.tour_user&.image : "/assets/chat-tour-user.jpg") : ""} alt=#{@chatroom&.tour_user&.present? ? @chatroom&.tour_user&.name : ""}> </div>
                    <div class="chat_ib">
                        <a class="sidebar-chat" data-remote="true" href="/chats/#{@chatroom&.id}" style="overflow: hidden;display: block; width: 100%;" id="chat_person_#{@chatroom&.id}" >
                            <p> <span style="color: black;"> #{@chatroom&.tour_user&.present? ? @chatroom&.tour_user&.name : ""} </span></p>
                            <p> <a> #{@chatroom&.tour_user&.present? ? @chatroom&.tour_user&.email : ""} </a> </p>
                        </a>
                    </div>
                </div>
            </div>`);

        $("#chat_person_#{@chatroom&.id}").click();
        $("#chatroom_id").val( "#{@chatroom&.id}" );
      }
      else
      {
        $("#chat_person_#{@chatroom&.id}").click();
        $("#chatroom_id").val( "#{@chatroom&.id}" );
      }
    }, 1000);
  }
