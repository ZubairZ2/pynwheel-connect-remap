- content_for :title, "Settings Community - Pynwheel"
.divLoading.hidden
- if can? :edit_settings_page, current_user 
  %section.is-community-page
  - if @community.creator_id.present? and @community.creator.present? and @community.creator.role == "Dwelo admin"
    .box-info.add-plan{style: "margin-top: 15px; margin-right: 10px;"}
      %img.dwelo-logo{:alt => "Smiley face", :src => "/assets/Dwelo-Logo.png"}
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Settings
          %span Community
        -# = link_to("EdgeState Account", "edgestate_accounts/new" , class: "btn btn-primary", style: "float:right")
      = form_for @community,:url=>company_community_path(current_company,@community),:html=>{:class=>"form-horizontal form_class"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Company
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select :company_id, Company.all.order(:name).collect {|p| [ p.name, p.id ] },{} ,:class=>"form-control"
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Region
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select(:region_id, options_for_select(@all_regions,@community.region_id), {:include_blank => 'Select a region'}, { :class => 'form-control' })

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Beans.ai 3D Maps
                .col-sm-6.col-lg-6.col-md-6.col-xs-6
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :enable_three_d_maps
                    %label.label-primary{:for => "community_enable_three_d_maps"}
                    %span.pl-15 Yes

                    = link_to "3D Map Design Configurations".html_safe, "#", :class => "btn mr-5 map-design-configurations-btn map_type", 'data-toggle' => "tooltip", :title => "3D Maps Configuration", :style => "margin-left: 5rem;background: #138fd4;color:white;height: 38px;padding-top: 7px;border-radius: 4px;", "data-name" => "plot", "data-target" => "#configurations-modal", "data-toggle" => "modal", "data-href" => "/"
              .form-group.map_type
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Default Satellite View
                .col-sm-6.col-lg-6.col-md-6.col-xs-6
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :default_satellite_view
                    %label.label-primary{:for => "community_default_satellite_view"}
                    %span.pl-15 Yes
              -#.form-group#chat_control_row
              -#  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              -#    Chat Control
              -#  .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -#    .TriSea-technologies-Switch
              -#      %span.pr-15 No
              -#      = f.check_box :chat_control
              -#      %label.label-primary{:for => "community_chat_control"}
              -#      %span.pl-15 Yes
              - if current_user.is_super_admin?
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Pynwheel Touch
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    .TriSea-technologies-Switch
                      %span.pr-15 No
                      = f.check_box :touchscreen_app
                      %label.label-primary{:for => "community_touchscreen_app"}
                      %span.pl-15 Yes
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Activate Pynwheel Launch
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :pynwheel_launch_access
                    %label.label-primary{:for => "community_pynwheel_launch_access"}
                    %span.pl-15 Yes
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Pynwheel Tour
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :self_tour
                    %label.label-primary{:for => "community_self_tour"}
                    %span.pl-15 Yes
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Pynwheel Access
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :pynwheel_access
                    %label.label-primary{:for => "community_pynwheel_access"}
                    %span.pl-15 Yes
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Community Logo
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :community_logo
                    %label.label-primary{:for => "community_community_logo"}
                    %span.pl-15 Yes
                    
              .form-group#code_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Pynwheel Touch Code
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :code, :class=>"form-control", :placeholder=>"Code",:maxlength=>"30"
              .form-group#display_types_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Pynwheel Touch Display Type
                .col-sm-12.col-lg-3.col-md-3.col-xs-12
                  = f.radio_button :is_vertical_app, true
                  = f.label :is_vertical_app, "Vertical", :value => "true"
                .col-sm-12.col-lg-3.col-md-3.col-xs-12
                  = f.radio_button :is_vertical_app, false
                  = f.label :is_vertical_app, "Horizontal", :value => "false"
              .form-group#billing_rate_touch
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Billing Rate (Touch)
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :billing_rate_touch, :class=>"form-control billing_number", :placeholder=>"00.00",:maxlength=>"13", value: @community.billing_rate_touch.present? ? @community.billing_rate_touch : "$2,028"
              - if @community.company.name.downcase == "lincoln"
                .form-group.billing_rate_slef_lincoln
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Billing Rate (Pynwheel Tour)
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.text_field :lincoln_billing_rate, :class=>"form-control billing_number", :placeholder=>"00.00",:maxlength=>"13", value: @community.lincoln_billing_rate.present? ? @community.lincoln_billing_rate : "$295"
              - elsif @community.creator_id.present? and @community.creator.present? and @community.creator.role == "Dwelo admin"
                .form-group#billing_rate_slef_dwelo
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Billing Rate (Pynwheel Tour)
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.text_field :dwelo_billing_rate, :class=>"form-control billing_number", :placeholder=>"00.00",:maxlength=>"13", value: @community.dwelo_billing_rate.present? ? @community.dwelo_billing_rate : "$280"
              - else
              .form-group.billing_rate_slef
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Billing Rate (Pynwheel Tour)
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :billing_rate_selftour, :class=>"form-control billing_number", :placeholder=>"00.00",:maxlength=>"13", value: @community.billing_rate_selftour.present? ? @community.billing_rate_selftour : "$385"
              .form-group#billing_rate_not_maps
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Billing Rate (Maps)
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :billing_rate_maps, :class=>"form-control billing_number", :placeholder=>"00.00",:maxlength=>"13",value: @community.billing_rate_maps.present? ? @community.billing_rate_maps : "$50"
              .form-group#subscription_start_date_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Subscription Start Date
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :date_installed, :class=>"form-control datepicker", :placeholder=>"Installed date",:autocomplete=>"off",:readonly=>true
              .form-group#show_gesture_icons
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Show Gesture Icons in Pynwheel Touch
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :show_gesture_icons
                    %label.label-primary{:for => "community_show_gesture_icons"}
                    %span.pl-15 Yes
              .form-group#powered_by_pynwheel_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Show 'Powered by Pynwheel' on Pynwheel Touch Home Screen and Pynwheel Map
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :powered_by_btn,:value => true
                    %label.label-primary{:for => "community_powered_by_btn"}
                    %span.pl-15 Yes
              .form-group#show_map_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Show Map in Pynwheel Tour app
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :show_map
                    %label.label-primary{:for => "community_show_map"}
                    %span.pl-15 Yes   
              .form-group#show_map_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Automate Wayfinding
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :auto_wayfinding
                    %label.label-primary{:for => "community_auto_wayfinding"}
                    %span.pl-15 Yes   
              .form-group#mdu_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  MDU
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :mdu
                    %label.label-primary{:for => "community_mdu"}
                    %span.pl-15 Yes
              .form-group#show_enable_locks
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Enable Locks
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :enable_locks
                    %label.label-primary{:for => "community_enable_locks"}
                    %span.pl-15 Yes    
              .form-group#access_restrictions.access_restrictions_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Restrict Access to Pynwheel Tour app for this community
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :restrict_access
                    %label.label-primary{:for => "community_restrict_access"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Enable SVG Mode (for webpages)
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :enable_svg_mode
                    %label.label-primary{:for => "community_enable_svg_mode"}
                    %span.pl-15 Yes
              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Beans Generated SVG
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :is_beans_svg
                    %label.label-primary{:for => "community_is_beans_svg"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Enable SDK Map
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = f.check_box :enable_sdk_map
                    %label.label-primary{:for => "community_enable_sdk_map"}
                    %span.pl-15 Yes

              -# .form-group
              -#   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              -#     Enable SDK Map Cache
              -#   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -#     .TriSea-technologies-Switch
              -#       %span.pr-15 No
              -#       = f.check_box :enable_sdk_map_cache
              -#       %label.label-primary{:for => "community_enable_sdk_map_cache"}
              -#       %span.pl-15 Yes
            
              / .form-group#access_restrictions
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              /     Scheduler Widget
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = f.check_box :scheduler_widget
              /       %label.label-primary{:for => "community_scheduler_widget"}
              /       %span.pl-15 Yes
              / .form-group#access_restrictions
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              /     Pynwheel Widget
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = f.check_box :pynwheel_touch
              /       %label.label-primary{:for => "community_pynwheel_touch"}
              /       %span.pl-15 Yes            
              .form-group#allowed_emails.allowed_emails_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Allowed Emails
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "AlloweEmails","data-content" => " "}
                    %span#propertyDetailNameText
                      Enter the comma separated emails, only users with these emails are allowed to visit your community in mobile app
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_area :allowed_emails, :value => @community.allowed_emails.collect(&:email).join(", ") , :id=>"emails_allowed", :class=>"form-control", rows:5, :placeholder=>"Emails"
              -#- if current_user.is_super_admin?
              -#  .form-group
              -#    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              -#      Tour Setup Visible
              -#    .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -#      .TriSea-technologies-Switch
              -#        %span.pr-15 No
              -#        = f.check_box :tour_setup_visible
              -#        %label.label-primary{:for => "community_tour_setup_visible"}
              -#        %span.pl-15 Yes
              
              .form-group.verification_type_field.hidden
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  ID verification provider
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = select_tag :verification_type , options_for_select([["Check Point Id","check_point_id"],["Manual (Email)","email"] ], @community.community_tour.verification_type),:class => "form-control email_to"
                  
                  / = select_tag :verification_type , options_for_select([ ["Authenteq","authenteq"], ["Check Point Id","check_point_id"],["Manual (Email)","email"] ], @community.community_tour.verification_type),:class => "form-control email_to"
              /.form-group.email_field.hide_email
              /  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              /    ID verification email to be sent to
              /  .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /    = text_field_tag :email,  @community.email, {:class=>"form-control", :autocomplete=>"off",:readonly=>true}
              .form-group#inactive_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Inactivate
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .row
                    .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      .checkbox
                        = f.check_box :locked
                        %label Inactivate
              -#.form-group
              -#  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              -#    Equal housing opportunity logo
              -#  .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -#    .row
              -#      .col-sm-6.col-lg-6.col-md-4.col-xs-12
              -#        .checkbox
              -#          = f.check_box :equal_housing_opportunity_logo
              -#          %label Equal housing opportunity logo
              -#.form-group
              -#  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              -#    Handicap accessible logo
              -#  .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -#    .row
              -#      .col-sm-6.col-lg-6.col-md-4.col-xs-12
              -#        .checkbox
              -#          = f.check_box :handicap_accessible_logo
              -#          %label Handicap accessible logo
        
        / /.box-body
        .box-footer
          = link_to "CANCEL" , company_communities_path(current_company), :class=>"btn btn-default pull-right"
          = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right mr-10 loader_class"

  = render partial: "3d_map_configurations"
          
  :javascript
    var self_tour = #{@community.self_tour || false}
    if(self_tour)
      $(".verification_type_field").removeClass("hidden")
    populate_multiselect()
    $(".datepicker").datepicker({dateFormat: 'yy-mm-dd', maxDate: new Date, minDate: new Date(2007, 6, 12) });
    $(document).ready(function(e){
      if (!(#{current_user.welcome_prompt}))
      {
        $('#welcome-prompt-modal1').modal('show');
      }
    });
    $('.billing_number').keypress(function(event) {
    if ((event.which != 46 || $(this).val().indexOf('.') != -1) &&
      ((event.which < 48 || event.which > 57) &&
        (event.which != 0 && event.which != 8))) {
      event.preventDefault();
    }
    var text = $(this).val();
    if ((text.indexOf('.') != -1) &&
      (text.substring(text.indexOf('.')).length > 2) &&
      (event.which != 0 && event.which != 8) &&
      ($(this)[0].selectionStart >= text.length - 2)) {
      event.preventDefault();
    }
    });
    
    if ($("#community_self_tour").is(":checked") == false){
      $("#access_restrictions").addClass("hidden")
      $("#allowed_emails").addClass("hidden")
    }

    if ($("#community_restrict_access").is(":checked") == false){
      $("#allowed_emails").addClass("hidden")
    }

    $('#community_restrict_access').change(function() {
      if ($("#community_restrict_access").is(":checked"))
        $("#allowed_emails").removeClass("hidden")
      else
        $("#allowed_emails").addClass("hidden")
    })

    $(".form_class").submit(function(){
      if ($("#community_self_tour").is(":checked") == false){
        $("#community_restrict_access").prop('checked', false);
      }
      if ($("#community_restrict_access").is(":checked") == false)
        $("#emails_allowed").val('')
    })
    $( ".email_to" ).change(function() {
      if ($(".email_to").val() == "email") {
        $(".email_field").removeClass("hide_email");
        $(".email_field").removeClass("hidden");
      }
      else {
        $(".email_field").addClass("hide_email");
      }
    });
      if ($(".email_to").val() == "email") {
        $(".email_field").removeClass("hide_email");
        $(".email_field").removeClass("hidden");
      }



      // right code touch true change
      $('#community_touchscreen_app').change(function() {
      if ($("#community_touchscreen_app").is(":checked")){
        $("#code_row").removeClass("hidden")
        $("#display_types_row").removeClass("hidden")
        $("#subscription_start_date_row").removeClass("hidden")
        $("#show_gesture_icons").removeClass("hidden")
        $("#powered_by_pynwheel_row").removeClass("hidden")
        $("#billing_rate_touch").removeClass("hidden")
        $("#apply_phnwheel_touch").removeClass("hidden")
        $("#apply_now_pynwheel_touch_field_row").removeClass("hidden")

            }
        if (#{@community.company.name.downcase == "lincoln"}){
          $("#billing_rate_maps").addClass("hidden")
          $("#billing_rate_not_maps").addClass("hidden")
          $("#billing_rate_touch").addClass("hidden")
          $(".billing_rate_slef").addClass("hidden")
          $("#billing_rate_slef_dwelo").addClass("hidden")
          $(".billing_rate_slef_lincoln").removeClass("hidden")

        }
      if (#{@community.creator_id.present? and @community.creator.present? and @community.creator.role == "Dwelo admin"}) {
          $("#billing_rate_maps").addClass("hidden")
          $("#billing_rate_not_maps").addClass("hidden")
          $("#billing_rate_touch").addClass("hidden")
          $(".billing_rate_slef").addClass("hidden")
          if ($("#community_self_tour").is(":checked") == true){
          $("#billing_rate_slef_dwelo").removeClass("hidden")
          }
          else {
          $("#billing_rate_slef_dwelo").addClass("hidden")
          }
          $(".billing_rate_slef_lincoln").addClass("hidden")

        }
    })

    // right code touch false change
      $('#community_touchscreen_app').change(function() {
      if ($("#community_touchscreen_app").is(":checked") == false){
        if ($("#community_self_tour").is(":checked") == true){
          $("#billing_rate_maps").addClass("hidden")
          $("#billing_rate_not_maps").addClass("hidden")
          $(".verification_type_field").removeClass("hidden")
          if ($(".email_to").val() == "email") {
          $(".email_field").removeClass("hidden")
          }
          $("#billing_rate_touch").addClass("hidden")
          $(".billing_rate_slef").removeClass("hidden")
          $("#billing_rate_slef_dwelo").addClass("hidden")
          $(".billing_rate_slef_lincoln").addClass("hidden")
          if (#{@community.company.name.downcase == "lincoln"}){
            $("#billing_rate_not_maps").addClass("hidden")
            $("#billing_rate_maps").addClass("hidden")
            $("#billing_rate_touch").addClass("hidden")
            $(".billing_rate_slef").addClass("hidden")
            $("#billing_rate_slef_dwelo").addClass("hidden")
