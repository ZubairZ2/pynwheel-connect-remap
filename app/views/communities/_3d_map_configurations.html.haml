#configurations-modal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header#modal-title.config-modal-title
      = form_for @community,url: community_update_web_maps_configurations_path(@community),:html=>{:id=>"web_maps_configurations_form"},:remote=>true  do |f|
        %alert.alert.alert-success.map-configurations-alert.hidden
          %span 3D Maps Configuartions has been updated suceessfully
        .modal-body
          .form-group
            .col-md-12.mb-10
              %p.title-box Customize colors & opacity for Beans.ai 3D map renderings from options below.
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              Default Polygon Color
              %i.mapConfigurationToolTip.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#configDetailNameText
                  unit polygon (floor-plans) color
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i.addon-i
                  = f.text_field :default_polygon_color, class: "form-control property-map-marker-field",autocomplete: true,:value=>@community.default_polygon_color
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              Selected Polygon Color
              %i.mapConfigurationToolTip.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#configDetailNameText
                  highlighted/selected unit polygon color
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i.addon-i
                  = f.text_field :selected_polygon_color, class: "form-control property-map-marker-field",autocomplete: true,:value=>@community.selected_polygon_color
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              Default Polygon Opacity
              %i.mapConfigurationToolTip.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#configDetailNameText
                  default polygon opacity
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              = f.text_field :default_polygon_opacity,{class: "form-control property-map-marker-field ", :id => "default_polygon_opacity",:max => 2,:min => 0,:style => "line-height: 3.2;"}
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              Selected Polygon Opacity
              %i.mapConfigurationToolTip.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#configDetailNameText
                  highlighted/selected polygon opacity
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              = f.text_field :selected_polygon_opacity,{class: "form-control property-map-marker-field ", :id => "selected_polygon_opacity",:max => 2,:min => 0,:style => "line-height: 3.2;"}
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              Unit Color
              %i.mapConfigurationToolTip.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#configDetailNameText
                  unit (text) color
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i.addon-i
                  = f.text_field :unit_color, class: "form-control property-map-marker-field",autocomplete: true,:value=>@community.unit_color
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              Selected Unit Color
              %i.mapConfigurationToolTip.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#configDetailNameText
                  selected unit (text) color
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i.addon-i
                  = f.text_field :selected_unit_color, class: "form-control property-map-marker-field",autocomplete: true,:value=>@community.selected_unit_color
          .form-group.mt-30
            %label.col-sm-12.col-lg-5.col-md-5.col-xs-12.control-label.font-size-15
              POI Color
              %i.propertyDetailName.fa.fa-question-circle{"data-toggle"=>"tooltip","data-placement"=>"top","data-content"=>" "}
                %span#propertyDetailNameText
                  Points-of-Interest color (amenities,entrances, stairs, elevators etc) 
            .col-sm-12.col-lg-7.col-md-7.col-xs-12
              .input-group.colorpicker-style.hex-format-colorpicker
                .input-group-addon
                  %i.addon-i
                  = f.text_field :poi_color, class: "form-control property-map-marker-field",autocomplete: true,:value=>@community.poi_color
        .modal-footer
          = f.submit "Update",:class=>"btn btn-primary submit-click"
          %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel

:javascript

  $('#selected_polygon_opacity').on('change', function() {
    if ($('#selected_polygon_opacity').val() > 2)
    {
      $('#selected_polygon_opacity').val("2.0")
    }
    else if ($('#selected_polygon_opacity').val() < 0)
    {
      $('#selected_polygon_opacity').val("0.0")
    }
    else
    {
      $('#selected_polygon_opacity').val( Math.trunc( $('#selected_polygon_opacity').val()))
    }
  });

  $('#default_polygon_opacity').on('change', function() {
    if ($('#default_polygon_opacity').val() > 2)
    {
      $('#default_polygon_opacity').val("2.0")
    }
    else if ($('#default_polygon_opacity').val() < 0)
    {
      $('#default_polygon_opacity').val("0.0")
    }
    else
    {
      $('#default_polygon_opacity').val( Math.trunc( $('#default_polygon_opacity').val()))
    }
  });