.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name
    - if current_user.is_dwelo_admin?
      %i.unit_manualoverride.fa.fa-question-circle
        %span#unit_manualoverride_text
          (Dwelo) will be added as default at the start of name. Changing the Name will change the name of the property on the "Favorites" page.
    - else
      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailNamePopover1","data-content" => " "}
        %span#propertyDetailNameText
          Changing the Name will change the name of the property on the "Favorites" page.


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Name"
-#.form-group
-#  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
-#    Code
-#
-#  .col-sm-12.col-lg-9.col-md-9.col-xs-12
-#    = f.text_field :code, :class=>"form-control", :placeholder=>"Code",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the Address will change how it appears on the eBrochure, and will change the lat/long of the property on the "Neighborhood" page.


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :address, :class=>"form-control address_fields1",rows:5, :placeholder=>"Address", :id => "address"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-3.col-md-4.col-xs-12
        = f.text_field :city, :class=>"form-control address_fields1", :placeholder=>"City",:maxlength=>"20", :id => "city"
        %small City
      .col-sm-6.col-lg-3.col-md-4.col-xs-12
        = f.text_field :state, :class=>"form-control address_fields1", :placeholder=>"State",:maxlength=>"20", :id => "states"
        %small State
      .col-sm-6.col-lg-3.col-md-4.col-xs-12
        = f.text_field :zip, :class=>"form-control address_fields1", :placeholder=>"Zip",:maxlength=>"10"
        %small Zip
      -#.col-sm-6.col-lg-3.col-md-4.col-xs-12
      -#  = f.text_field :phone, :class=>"form-control address_fields", :placeholder=>"Phone",:maxlength=>"15"
      -#  %small Phone
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-6.col-md-6.col-xs-12
        = f.text_field :latitude, :class=>"form-control", :placeholder=>"Latitude",:maxlength=>"15", :id=>"latitude"
        %small Latitude
      .col-sm-6.col-lg-6.col-md-6.col-xs-12
        = f.text_field :longitude, :class=>"form-control", :placeholder=>"Longitude",:maxlength=>"15", :id=>"longitude"
        %small Longitude
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Override Latitude/Longitude
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
      %span#propertyDetailNameText
        When set to "False" then the lat/long will default to the lat/long provided by Google for this address. When set to "True" then the lat/long provided by Google will be overridden with the lat/long entered in the fields above.

  .col-sm-12.col-lg-3.col-md-3.col-xs-12
    = f.radio_button :manual_lat_long, true
    = f.label :manual_lat_long, "True", :value => "true"
  .col-sm-12.col-lg-3.col-md-3.col-xs-12
    = f.radio_button :manual_lat_long, false
    = f.label :manual_lat_long, "False", :value => "false"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Phone
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :phone, :class=>"form-control", :placeholder=>"Phone",:maxlength=>"15"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailEmailPopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the email address will change the "from" email address for the eBrochure.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :email, :class=>"form-control", :placeholder=>"Email",:maxlength=>"200", :style => "background: #f6f6f6; color: black;"


.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Website
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailWebsitePopover","data-content" => " "}
      %span#propertyDetailNameText
        Changing the website address will change how it appears on the eBrochure.


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :website, :class=>"form-control", :placeholder=>"Website URL"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Number of Units
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :number_of_units, :class=>"form-control validate[custom[onlyNumber]]", :placeholder=>"Number of Units",:maxlength=>"5"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Property Map / Floorplates

  .col-sm-12.col-lg-3.col-md-3.col-xs-12
    = f.radio_button :is_sitemap, true
    = f.label :is_sitemap, "Property Map", :value => "true"
  .col-sm-12.col-lg-3.col-md-3.col-xs-12
    = f.radio_button :is_sitemap, false
    = f.label :is_sitemap, "Floorplates", :value => "false"

- if @all_regions.any?
  .form-group
    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
      Region
    .col-sm-12.col-lg-9.col-md-9.col-xs-12
      - region_id = @community.region_id.blank? ? "" : @community.region_id
      = f.select(:region_id, options_for_select(@all_regions, region_id), {:include_blank => 'Select a region'}, { :class => 'form-control' })

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Notes

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :description, :class=>"form-control", rows:5, :placeholder=>"Notes"
= f.hidden_field :creator_id, :value=> current_user.id


