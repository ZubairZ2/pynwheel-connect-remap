.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Name"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :address, :class=>"form-control",rows:5, :placeholder=>"Address"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :city, :class=>"form-control address_fields validate[required,custom[onlyLetterSp]]", :placeholder=>"City"
        %small City
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :state, :class=>"form-control address_fields validate[required,custom[onlyLetterSp]]", :placeholder=>"State"
        %small State
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :zip, :class=>"form-control address_fields validate[required,custom[onlyNumberSp]]", :placeholder=>"Zip"
        %small Zip
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.email_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Description

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :description, :class=>"form-control", rows:5, :placeholder=>"Description"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-6.col-md-6.col-xs-12
        = f.text_field :latitude, :class=>"form-control validate[required,custom[onlyLatitude]]", :placeholder=>"Latitude"
        %small Latitude
      .col-sm-6.col-lg-6.col-md-6.col-xs-12
        = f.text_field :longitude, :class=>"form-control validate[required,custom[onlyLongitude]]", :placeholder=>"Longitude"
        %small Longitude

:javascript
  $("form").validationEngine();



