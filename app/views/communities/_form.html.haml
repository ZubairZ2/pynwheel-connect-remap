:javascript
  function non_readable()
  {
  if(!$('#community_manual_lat_long_true').prop('checked'))
  {
    document.getElementById("latitude").readOnly = true
    document.getElementById("latitude").style.background = "#ececec";
    document.getElementById("longitude").readOnly = true
    document.getElementById("longitude").style.background = "#ececec";
  }
  else
  {
    document.getElementById("latitude").readOnly = false
    document.getElementById("latitude").style.background = "";
    document.getElementById("longitude").readOnly = false
    document.getElementById("longitude").style.background = "";
  }
  }
  
  non_readable();
  $('#community_manual_lat_long_true').change(function() {
    non_readable();   
  });
  $('#community_manual_lat_long_false').change(function() {
    non_readable();   
  });
  $(document).on('change', '.address_fields1', function() {


  });
  com = #{@com_id};
  if(com == 0)
  {com = null;}
  
  function make_coord()
  {
    var geocoder = new google.maps.Geocoder();

    geocoder.geocode( { 'address': $('#address').val() +" "+ $('#city').val() + " "+ $('#states').val()}, function(results, status) {

        if (status == google.maps.GeocoderStatus.OK) {
            var latitude = results[0].geometry.location.lat().toFixed(8);
            var longitude = results[0].geometry.location.lng().toFixed(8);
            if (latitude != null){
                // console.log(longitude)
                document.getElementById('latitude').value = latitude;
                document.getElementById('longitude').value = longitude;
                $.ajax({
                  url: "/communities/make_cordinate",
                  type: "post",
                  data: {lat: latitude, long: longitude, community_id : com},
                  success: function(data) {

                  },
                  error: function(data) {}
                })
            }
        }
    });

  }
  $( ".address_fields1" ).keyup(function() {
    if(!$('#community_manual_lat_long_true').prop('checked'))
      make_coord()
  });
  $(document).ready(function() {
   // executes when HTML-Document is loaded and DOM is ready
   setTimeout(function(){
    if(!$('#community_manual_lat_long_true').prop('checked'))
      make_coord();
  }, 2000);
  });

    $(document).on("click", "#propertyDetailNameId" , function(){
