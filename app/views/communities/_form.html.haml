:javascript
  if (!#{current_user.welcome_property_details_page})
  {
    $('[data-toggle="propertyDetailNamePopover"]').popover({
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding">Changing the Name will change the name of the property on the "Favorites" page.</div><div class="popover-footer"><a id="propertyDetailNameId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }

    $(document).on("click", "#propertyDetailNameId" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="propertyDetailAddressPopover"]').popover({
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding">Changing the Address will change how it appears on the eBrochure, and will change the lat/long of the property on the "Neighborhood" page.</div><div class="popover-footer"><a id="propertyDetailAddressId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#propertyDetailAddressId" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="propertyDetailEmailPopover"]').popover({
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding">Changing the email address will change the "from" email address for the eBrochure.</div><div class="popover-footer"><a id="propertyDetailEmailId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#propertyDetailEmailId" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="propertyDetailWebsitePopover"]').popover({
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding">Changing the website address will change how it appears on the eBrochure.</div><div class="popover-footer"><a id="propertyDetailWebsiteId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#propertyDetailWebsiteId" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        #{current_user.welcome_property_details_page = true}
        #{current_user.save}
    });
