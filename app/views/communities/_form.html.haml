.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control", :placeholder=>"Name",:required=>true
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :address, :class=>"form-control",rows:5, :placeholder=>"Address"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :city, :class=>"form-control", :placeholder=>"City",:required=>true
        %small City
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :state, :class=>"form-control", :placeholder=>"State",:required=>true
        %small State
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :zip, :class=>"form-control", :placeholder=>"Zip",:required=>true
        %small Zip
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Email

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.email_field :email, :class=>"form-control", :placeholder=>"Email",:required=>true
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Description

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :description, :class=>"form-control", rows:5, :placeholder=>"Description",:required=>true
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label


  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-6.col-md-6.col-xs-12
        = f.text_field :latitude, :class=>"form-control", :placeholder=>"Latitude",:required=>true
        %small Latitude
      .col-sm-6.col-lg-6.col-md-6.col-xs-12
        = f.text_field :longitude, :class=>"form-control", :placeholder=>"Longitude",:required=>true
        %small Longitude

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      floor plan.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img= image_tag "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :logo
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Data Provider

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.select :data_provider , options_for_select([["Entrata","psi"],["RealPageSVC","realpagesvc"],["YardiRentCafe","yardirentcafe"],["Yard2","yardi2"],["Yard4","yardi4"]],f.object.data_provider),{},{:class=>"form-control"}

= f.fields_for :credential do |c|
  = render :partial=>"credential_form",:locals=>{:f=>c}
