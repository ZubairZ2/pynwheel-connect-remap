-# Property form, shared by new and edit. Every field name, element id and
-# validation class is unchanged from the flat Bootstrap layout this replaces -
-# only the structure and styling are new. In particular the geocoding script at
-# the bottom reads #address, #city, #states, #latitude, #longitude and
-# .address_fields1 by name, and the first-visit walkthrough hops between the
-# Name, Address, Email and Website tips by their data-toggle, so those all stay
-# put.

.pf-section
  .pf-section-head
    %h2 Property identity
    %p What this property is called across the app, and where it sits in your portfolio.
  .pf-section-body
    .pf-grid
      = pyn_field "Name", span: 2, badge: (current_user.is_dwelo_admin? ? property_tip("(Dwelo) will be added as default at the start of name. Changing the Name will change the name of the property on the favorites page.") : property_tip("Changing the Name will change the name of the property on the favorites page.", popover: "propertyDetailNamePopover1")) do
        = f.text_field :name, class: "form-control validate[required]", placeholder: "Property name"
      - if @all_regions.any?
        = pyn_field "Region" do
          = f.select :region_id, options_for_select(@all_regions, @community.region_id.presence), { include_blank: "Select a region" }, { class: "form-control" }
    .pf-stack{style: "margin-top:15px"}
      = pyn_field "Notes", hint: "Internal only — renters never see this." do
        = f.text_area :description, class: "form-control", rows: 4, placeholder: "Notes"

.pf-section
  .pf-section-head
    %h2 Location
    %p
      The address drives the eBrochure and the Neighborhood page. Coordinates are looked
      up from it automatically unless you override them below.
  .pf-section-body
    .pf-stack
      = pyn_field "Address", badge: property_tip('Changing the Address will change how it appears on the eBrochure, and will change the lat/long of the property on the "Neighborhood" page.', popover: "propertyDetailAddressPopover") do
        = f.text_area :address, class: "form-control address_fields1", rows: 3, placeholder: "Street address", id: "address"
    .pf-grid{style: "margin-top:15px"}
      = pyn_field "City" do
        = f.text_field :city, class: "form-control address_fields1", placeholder: "City", maxlength: "20", id: "city"
      = pyn_field "State" do
        = f.text_field :state, class: "form-control address_fields1", placeholder: "State", maxlength: "20", id: "states"
      = pyn_field "Zip" do
        = f.text_field :zip, class: "form-control address_fields1", placeholder: "Zip", maxlength: "10"

    .pf-stack{style: "margin-top:16px"}
      = pyn_field "Coordinates", hint: "Off: Google's coordinates for the address above are used, and refresh as you edit it. On: the values you enter here win." do
        .pf-toggle-row
          %label.pf-choice
            = f.radio_button :manual_lat_long, false
            %span
              %b Follow the address
              Look up the coordinates from Google.
          %label.pf-choice
            = f.radio_button :manual_lat_long, true
            %span
              %b Set them by hand
              Enter exact coordinates below.

    .pf-grid{style: "margin-top:15px"}
      = pyn_field "Latitude" do
        = f.text_field :latitude, class: "form-control", placeholder: "Latitude", maxlength: "15", id: "latitude"
      = pyn_field "Longitude" do
        = f.text_field :longitude, class: "form-control", placeholder: "Longitude", maxlength: "15", id: "longitude"

.pf-section
  .pf-section-head
    %h2 Contact details
    %p Shown to renters. The email address is also the "from" address on the eBrochure.
  .pf-section-body
    .pf-grid
      = pyn_field "Phone" do
        = f.text_field :phone, class: "form-control", placeholder: "Phone", maxlength: "15"
      = pyn_field "Email", badge: property_tip('Changing the email address will change the "from" email address for the eBrochure.', popover: "propertyDetailEmailPopover") do
        = f.text_field :email, class: "form-control", placeholder: "Email", maxlength: "200"
      = pyn_field "Website", span: 2, badge: property_tip("Changing the website address will change how it appears on the eBrochure.", popover: "propertyDetailWebsitePopover") do
        = f.text_field :website, class: "form-control", placeholder: "Website URL"

.pf-section
  .pf-section-head
    %h2 On-site team
    %p Who Pynwheel contacts about this property. Internal — not shown to renters.
  .pf-section-body
    .pf-grid
      = pyn_field "Manager name" do
        = f.text_field :property_manager_name, class: "form-control", placeholder: "Property manager name"
      = pyn_field "Manager phone" do
        = f.text_field :property_manager_phone, class: "form-control", placeholder: "Property manager phone", maxlength: "15"
      = pyn_field "Manager email" do
        = f.text_field :property_manager_email, class: "form-control", placeholder: "Property manager email", maxlength: "200"

.pf-section
  .pf-section-head
    %h2 Map &amp; inventory
    %p How this property is mapped in the app, and how many homes it holds.
  .pf-section-body
    .pf-stack
      = pyn_field "Map style" do
        .pf-toggle-row
          %label.pf-choice
            = f.radio_button :is_sitemap, true
            %span
              %b Property Map
              One map of the whole site.
          %label.pf-choice
            = f.radio_button :is_sitemap, false
            %span
              %b Floorplates
              A separate plan per floor.
    .pf-grid{style: "margin-top:15px"}
      = pyn_field "Number of units", hint: "Prefilled from the units currently imported for this property." do
        = f.text_field :number_of_units, class: "form-control validate[custom[onlyNumber]]", placeholder: "Number of units", maxlength: "5", value: @community.units.count

= f.hidden_field :creator_id, value: current_user.id

:javascript
  // The coordinate fields are only editable while the manual override is on;
  // otherwise they are filled in from the address and shown as read-only.
  function non_readable()
  {
  if(!$('#community_manual_lat_long_true').prop('checked'))
  {
    document.getElementById("latitude").readOnly = true
    document.getElementById("latitude").style.background = "#ececec";
    document.getElementById("longitude").readOnly = true
    document.getElementById("longitude").style.background = "#ececec";
  }
  else
  {
    document.getElementById("latitude").readOnly = false
    document.getElementById("latitude").style.background = "";
    document.getElementById("longitude").readOnly = false
    document.getElementById("longitude").style.background = "";
  }
  }

  non_readable();
  $('#community_manual_lat_long_true').change(function() {
    non_readable();
  });
  $('#community_manual_lat_long_false').change(function() {
    non_readable();
  });

  com = #{@com_id};
  if(com == 0)
  {com = null;}

  function make_coord()
  {
    var geocoder = new google.maps.Geocoder();

    geocoder.geocode( { 'address': $('#address').val() +" "+ $('#city').val() + " "+ $('#states').val()}, function(results, status) {

        if (status == google.maps.GeocoderStatus.OK) {
            var latitude = results[0].geometry.location.lat().toFixed(8);
            var longitude = results[0].geometry.location.lng().toFixed(8);
            if (latitude != null){
                document.getElementById('latitude').value = latitude;
                document.getElementById('longitude').value = longitude;
                $.ajax({
                  url: "/communities/make_cordinate",
                  type: "post",
                  data: {lat: latitude, long: longitude, community_id : com},
                  success: function(data) {

                  },
                  error: function(data) {}
                })
            }
        }
    });

  }
  $( ".address_fields1" ).keyup(function() {
    if(!$('#community_manual_lat_long_true').prop('checked'))
      make_coord()
  });
  $(document).ready(function() {
   setTimeout(function(){
    if(!$('#community_manual_lat_long_true').prop('checked'))
      make_coord();
  }, 2000);
  });

  // First-visit walkthrough: each popover's OK button opens the next one, and
  // the last marks the page as seen.
  $(document).on("click", "#propertyDetailNameId" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');

    $('[data-toggle="propertyDetailAddressPopover"]:first').popover({
      html: true,
      template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Changing the Address will change how it appears on the eBrochure, and will change the lat/long of the property on the "Neighborhood" page.</div><div class="popover-footer"><a id="propertyDetailAddressId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  });

  $(document).on("click", "#propertyDetailAddressId" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');

    $('[data-toggle="propertyDetailEmailPopover"]').popover({
      html: true,
      template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Changing the email address will change the "from" email address for the eBrochure.</div><div class="popover-footer"><a id="propertyDetailEmailId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  });

  $(document).on("click", "#propertyDetailEmailId" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');
      $('[data-toggle="propertyDetailWebsitePopover"]').popover({
      html: true,
      template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Changing the website address will change how it appears on the eBrochure.</div><div class="popover-footer"><a id="propertyDetailWebsiteId" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  });

  $(document).on("click", "#propertyDetailWebsiteId" , function(){
      $(this).parents(".popover").popover('hide');
      $(this).parents(".popover").addClass('hidden');
      #{current_user.welcome_property_details_page = true}
      #{current_user.save}
  });
