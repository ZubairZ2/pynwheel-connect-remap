- content_for :title, "Communities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-building-o
        = current_company.name.capitalize
        - if @community.present?
          %br
            %small.text-primary
              = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Communities
          .col-md-6
            .mt-35
              - if current_user.is_super_admin? or can? :crud, Company
                = link_to new_company_community_path(current_company),:class=>"btn btn-success pull-right mb-20" do
                  %i.fa.fa-plus-circle
                  ADD COMMUNITY
              - if current_user.is_super_admin?
                = link_to new_company_community_group_path(current_company),:class=>"btn btn-success pull-right mb-20 mr-10" do
                  %i.fa.fa-plus-circle
                  ADD COMMUNITY GROUP
              - if current_user.is_super_admin?
                = link_to new_company_region_path(current_company),:class=>"btn btn-success pull-right mb-20 mr-10" do
                  %i.fa.fa-plus-circle
                  ADD REGION
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header
            
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.community-index
                  %thead
                    %tr
                      %th{:width => "79"} Sr #

                      %th Community Name
                      %th 
                        Region Name
                      %th{:width => "250"} Actions
                  %tbody
                    - if current_user.is_super_admin? or can? :crud, Company
                      - alphabetical_sort(@communities).each_with_index  do |f,index|
                        %tr
                          %td
                            = index+1
                          %td
                            = link_to f.name, edit_company_community_path(current_company,f)
                          %td
                            = f.region.present? ? (link_to f.region.name, edit_company_region_path(current_company,f.region)) : "-"
                          %td
                            = link_to edit_company_community_path(current_company,f),:class=>"text-success" do
                              %i.fa.fa-edit.icon_size
                            %a.text-danger{"data-name"=>"Community","data-href" => "/companies/#{current_company.id}/communities/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash.icon_size
                            %a.btn-info.btn-xs.mr-5
                              Update now
                            %a.btn-success.btn-xs
                              Live
                    - else
                      - current_user.communities.where(company_id: current_company).each_with_index  do |f,index|
                        %tr
                          %td
                            = index+1
                          %td
                            = link_to f.name, community_home_page_index_path(f)
                          %td
                            = link_to community_home_page_index_path(f),:class=>"text-success" do
                              %i.fa.fa-edit.icon_size
                            %a.text-danger{"data-name"=>"Community","data-href" => "/companies/#{current_company.id}/communities/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                              %i.fa.fa-trash.icon_size
                            %a.btn-info.btn-xs.mr-5
                              Update now
                            %a.btn-success.btn-xs
                              Live

            
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12
