%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Companies
    %li
      %a{:href => "#{communities_path}"} Communities
    -#%li.active Floor Plans
  .clearfix
.clearfix

%section
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Communities
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Gables
          .col-md-6
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/communities/new"}
                %i.fa.fa-plus-circle
                ADD COMMUNITY  
        .box.box-widget.panel-box
          .box-headrer
            %div
              .col-sm-9
                
              .col-sm-3
                %input.form-control{"aria-controls" => "example1", :placeholder => "Search:", :type => "search"}
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #

                      %th Community Name
                      %th{:width => "250"} Actions
                  %tbody
                    - @communities.each_with_index  do |f,index|
                      %tr
                        %td
                          = index+1
                        %td
                          = f.name
                        %td
                          %a.text-success{:href => "/communities/#{f.id}/edit"}
                            %i.fa.fa-edit
                          %a.text-danger{:href => "/communities/#{f.id}","data-method"=>:delete}
                            %i.fa.fa-trash
                          %a.btn-info.btn-xs.mr-5{:href=>"/communities/#{f.id}/import"}
                            Update now
                          %a.btn-success.btn-xs
                            Live

            .row
              .col-md-6
                .pl-20.pt-5 
              .col-md-6
                %ul.pagination.pull-right.pr-20.mt-0
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12

        