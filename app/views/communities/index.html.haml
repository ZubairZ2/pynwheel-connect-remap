%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Home
    %li.active Communities
  .clearfix
.clearfix

%section
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Communities
    .row
      .col-md-12
        .mt-35
          %a.btn.btn-success.pull-right.mb-20{:href => "/communities/new"}
            %i.fa.fa-plus-circle
            ADD COMMUNITY
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            %h4.title Communities List
        .box.box-widget.panel-box
          .box-headrer
            %div
              .col-sm-9
                %label
                  %select.form-control
                    %option{:value => "10"} 10
                    %option{:value => "25"} 25
                    %option{:value => "50"} 50
                    %option{:value => "100"} 100
                records
              .col-sm-3
                %input.form-control{"aria-controls" => "example1", :placeholder => "Search:", :type => "search"}
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #
                      %th Name
                      %th Data Provider
                      %th Actions
                  %tbody
                    - @communities.each_with_index  do |f,index|
                      %tr
                        %td= index+1
                        %td= f.name
                        %td= f.data_provider
                        %td
                          %a.text-success{:href => "/communities/#{f.id}/edit"}
                            %i.fa.fa-edit
                          %a.text-danger{:href => "/communities/#{f.id}","data-method"=>:delete}
                            %i.fa.fa-trash

            .row
              .col-md-6
                .pl-20.pt-5  #{page_entries_info @communities}
              .col-md-6
                %ul.pagination.pull-right.pr-20.mt-0
                  = paginate @communities



