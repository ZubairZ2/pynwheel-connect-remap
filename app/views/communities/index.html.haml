- content_for :title, "Communities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Communities
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            / %h4.title #{current_company.name.capitalize}
          .col-md-6
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/communities/new"}
                %i.fa.fa-plus-circle
                ADD COMMUNITY
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header
            
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #

                      %th Community Name
                      %th{:width => "250"} Actions
                  %tbody
                    - @communities.each_with_index  do |f,index|
                      %tr
                        %td
                          = index+1
                        %td
                          = link_to f.name, community_home_page_index_path(f)
                        %td
                          %a.text-success{:href => "/communities/#{f.id}/edit"}
                            %i.fa.fa-edit
                          %a.text-danger{"data-name"=>"Community","data-href" => "/communities/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash
                          %a.btn-info.btn-xs.mr-5
                            Update now
                          %a.btn-success.btn-xs
                            Live

            
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12

        