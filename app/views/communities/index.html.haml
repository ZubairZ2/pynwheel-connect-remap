- content_for :title, "Communities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-building-o
        = current_company.name.capitalize
        - if @community.present?
          %br
            %small.text-primary
              = @community.company.name + '@' + @community.name
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Communities
          .col-md-6
            .mt-35
              = link_to new_company_community_path(current_company),:class=>"btn btn-success pull-right mb-20" do
                %i.fa.fa-plus-circle
                ADD COMMUNITY
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header
            
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #

                      %th Community Name
                      %th{:width => "250"} Actions
                  %tbody
                    - @communities.each_with_index  do |f,index|
                      %tr
                        %td
                          = index+1
                        %td
                          = link_to f.name, community_home_page_index_path(f)
                        %td
                          = link_to edit_company_community_path(current_company,f),:class=>"text-success" do
                            %i.fa.fa-edit
                          %a.text-danger{"data-name"=>"Community","data-href" => "/companies/#{current_company.id}/communities/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash
                          %a.btn-info.btn-xs.mr-5
                            Update now
                          %a.btn-success.btn-xs
                            Live

            
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12

        