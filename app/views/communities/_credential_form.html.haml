= form_for @community,:url=>community_path(@community),:html=>{:class=>"form-horizontal settings-form",:method=>'PUT'},:remote=>true do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Data Provider
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = f.select :data_provider , options_for_select([["Entrata","psi"],["RealPage","realpagesvc"],["YardiRentCafe","yardirentcafe"],["Yardi","yardi"]],f.object.data_provider),{},{:class=>"form-control"}
        = f.fields_for :credential do |c|
          .form-group.credential_fields#url
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              URL

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :url, :class=>"form-control", :placeholder=>"URL"
          .form-group.credential_fields#c_code
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              C-code

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :c_code, :class=>"form-control", :placeholder=>"C-Code"    
          .form-group.credential_fields#username
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Username

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :username, :class=>"form-control", :placeholder=>"username"
          .form-group.credential_fields#password
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Password

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :password, :class=>"form-control", :placeholder=>"Password"
          .form-group.credential_fields#property_id
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Property Id

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :property_id, :class=>"form-control", :placeholder=>"Property Id"
          .form-group.credential_fields#site_id
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              SITE ID

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :site_id, :class=>"form-control", :placeholder=>"SITE ID" 
          .form-group.credential_fields#p_code
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              P-Code

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :p_code, :class=>"form-control", :placeholder=>"P-Code"        
          .form-group.credential_fields#pmc_id
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              PMC ID

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :pmc_id, :class=>"form-control", :placeholder=>"PMC ID"
          .form-group.credential_fields#server_name
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Server Name

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :server_name, :class=>"form-control", :placeholder=>"Server Name"
          .form-group.credential_fields#database
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Database

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :database, :class=>"form-control", :placeholder=>"Database"
          .form-group.credential_fields#platform
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Platform

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :platform , options_for_select(["SQL Server"]),{},{:class=>"form-control"}
          .form-group.credential_fields#interface_entity
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Interface Entity

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :interface_entity , options_for_select(["Pynwheel"]),{},{:class=>"form-control"}
  .box-footer
    -#= f.submit "Update", :class=>"btn btn-success pull-right"
    %button.btn.btn-success.pull-right#seetings-submit-button{:type=>"button"} Update
:javascript  
  $('.import_data').attr("href","/communities/"+$('#communities_on_settings').val()+"/import"); 
  $('#seetings-submit-button').click(function(){
     if ($(".settings-form").validationEngine('validate')){
        $('.settings-form').submit();
     }
  });