:javascript
   var hide_fields = "#{(@community.use_company_level_data_settings)}"
   if (hide_fields === "true"){
     $('.field-to-hide').addClass('hidden');
   }
   else {
    $('.field-to-hide').removeClass('hidden');
   }
    function reloadPage(checkbox) {
    window.location.reload();
    }
  function credentials_goBack()
  {
    $('.settings-form').submit();
    window.location.reload();

  }

  function hideRentCafeCrmCredentials() {
    $('.yardirentcafe_marketing_api').hide();
    $('.yardirentcafe_property_id').hide();
    $('.yardirentcafe_property_code').hide();
    $('.rent-cafe-v2-note').show();
  }

  function showRentCafeCrmCredentials() {
    $('.yardirentcafe_marketing_api').show();
    $('.yardirentcafe_property_id').show();
    $('.yardirentcafe_property_code').show();
    $('.rent-cafe-v2-note').hide();
  }


  $('#community_credential_attributes_rentcafe_api_version').change(function(e){
  var selectedOption = $('#yardirentcafe_code_option').val();

    if($(this).val() == 'RentCafe V2')
      showYardiRentCafeVersion2Option();
    else
      showYardiRentCafeCodeInputOption(selectedOption);

    set_fields_for_crm();

  })

  $('.import_data').attr("href","/communities/"+$('#communities_on_settings').val()+"/import"); 

  $('#seetings-submit-button').click(function(){
     if ($(".settings-form").validationEngine('validate')){
        $('.settings-form').submit();
     }
  });
  $('.settings-field').change(function(){
    if ($(".settings-form").validationEngine('validate')){
      $('.settings-form').submit();
     }
  });
  $('.crm-settings-field').change(function(){
      $('.crm-settings-form').submit();
  });
  $('.sp_import_data').click(function(){
    if ($(".settings-form").validationEngine('validate')){
      $('#spreadsheet_method').val("0");
      $('.settings-form').submit();
     }
  });
  $('.sp_replace_data').click(function(){
    if ($(".settings-form").validationEngine('validate')){
      $('#spreadsheet_method').val("1");
      $('.settings-form').submit();
     }
  });
  $('.sp_swap_data').click(function(){
    if ($(".settings-form").validationEngine('validate')){
      $('#spreadsheet_method').val("2");
      $('.settings-form').submit();
     }
  });

  $('#yardirentcafe_code_option').change(function(){
    showYardiRentCafeCodeInputOption($(this).val());
  });

  var hide_crm_field = "#{(@community.data_provider == @crm_credential.crm_provider) || @crm_credential.crm_provider.nil?}" 

    if(hide_crm_field)
    {
      // $('.crm_credential_fields').hide();
       set_fields_for_crm();
    }
    else
    {
      set_fields_for_crm();
    }

  $('#crm_provider').change(function(){

    if($('#crm_provider').val() == $('#community_data_provider').val())
    {
      // $('.crm_credential_fields').hide();
      set_fields_for_crm();
    }
    else
    {
      set_fields_for_crm();
    }
  });

  function set_fields_for_crm()
  {
    $('.crm_credential_fields').hide();
    $('.rent-cafe-v2-note').hide();

    if($('#crm_provider').val() == "psi")
    {
      $('.entrata_domain').show();
      $('.entrata_username').show();
      $('.entrata_password').show();
      $('.entrata_property_id').show();     
    }
    else if ($('#crm_provider').val() == "realpagesvc")
    {
      $('.realpage_site_id').show();
      $('.realpage_pmc_id').show();
    }
    else if ($('#crm_provider').val() == "yardirentcafe")
    {
      if($('#community_credential_attributes_rentcafe_api_version').val() == "RentCafe V2")
        hideRentCafeCrmCredentials();
      else
        showRentCafeCrmCredentials();
    }
    else if ($('#crm_provider').val() == "salesforce")
    {
      $('.salesforce_username').show();
      $('.salesforce_password').show();
      $('.salesforce_client_id').show();
      $('.salesforce_secret_id').show();
      $('.salesforce_property_id').show();
      $('.salesforce_grant_type').show();
    }
    else if (($('#crm_provider').val() == "knock")) {
      $('.knock_community_id').show();
      $('.knock_company_id').show();
    }
    else if (($('#crm_provider').val() == "funnel")) {
      $('.funnel_community_id').show();
      $('.funnel_api_key').show();
    }

  }
  
  $('#community_credential_attributes_use_different_crm_provider_true').change(function(){
    $(".crm-settings-div").show();
  });
  $('#community_credential_attributes_use_different_crm_provider_false').change(function(){
    $(".crm-settings-div").hide();
  });
  if($('#community_credential_attributes_use_different_crm_provider_true').prop('checked'))
    $(".crm-settings-div").show();
  if($('#community_credential_attributes_use_different_crm_provider_false').prop('checked'))
    $(".crm-settings-div").hide();
  $('#community_credential_attributes_apply_now_separate_link').click(function(){
    $('#separate_link_field').removeClass("hidden")
  });
  $('#community_credential_attributes_apply_now_true').click(function(){
    $('#separate_link_field').addClass("hidden")
  });
  $('#community_credential_attributes_apply_now_false').click(function(){
    $('#separate_link_field').addClass("hidden")
  });
  if(#{@community.credential.apply_now.to_s == "separate_link"})
    $('#separate_link_field').removeClass("hidden");


  if($('#community_credential_attributes_is_perq_allowed_true').prop('checked'))
    $("#allow_perq_property_id").removeClass("hidden");

  if($('#community_credential_attributes_is_perq_allowed_false').prop('checked'))
    $("#allow_perq_property_id").addClass("hidden");

  $('#community_credential_attributes_is_perq_allowed_true').click(function(){
    $("#allow_perq_property_id").removeClass("hidden");
  });

  $('#community_credential_attributes_is_perq_allowed_false').click(function(){
    $("#allow_perq_property_id").addClass("hidden");
  });

  function confirmBeforeReload(checkbox) {
      reloadPage(checkbox);
  }

   handleProviderListCompanyLevelToggle()
  function handleProviderListCompanyLevelToggle(){
    var provider =$('#community_data_provider').val();

   if (provider === "" || provider === null) {
     $('.hide_form_fields').addClass('hidden');
   }
   else{
   $('.hide_form_fields').removeClass('hidden');
   }
   }