= form_for @community,:url=>community_path(@community),:html=>{:class=>"form-horizontal settings-form",:method=>'PUT'},:remote=>true do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        .form-group.company_level_toggle
          %label.col-sm-12.col-lg-4.col-md-3.col-xs-12.control-label
            Use Company Credentials
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorPopover","data-content" => " "}
              %span#propertyDetailNameText
                When Use Company Credentials is set to “Yes” then the data providers that are set up on the Company Data page will appear in this list. If a data provider does not appear in this list, that is because it needs to be set up on the Company Data page first.

          .col-sm-12.col-lg-8.col-md-9.col-xs-12
            .TriSea-technologies-Switch{style: "margin-left: -50px; "}
              %span.pr-15 No
              = f.check_box :use_company_level_data_settings,:class=>" settings-field", :onchange => "confirmBeforeReload(this)"
              %label.label-primary{for: "community_use_company_level_data_settings"}
              %span.pl-15 Yes

        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Data Provider
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = f.select :data_provider , options_for_select(data_provider_options(@community),f.object.data_provider),{},{:class=>"form-control", onchange: 'submitSettingFormOnChange()'}
        = f.fields_for :credential do |c|


          .form-group.credential_fields#url.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              URL

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :url, :class=>"form-control settings-field", :placeholder=>"URL"

          .form-group.credential_fields.entrata_url.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Domain

            .row.field-to-hide
              .col-sm-12.col-lg-2.col-md-9.col-xs-12.entrata_input.field-to-hide
                = c.text_field :entrata_url, :class=>"form-control settings-field", :placeholder=>"Domain"

              %span.col-sm-12.col-lg-4.col-md-9.col-xs-12.entrata_label
                \.entrata.com/api/v1/propertyunits

          .form-group.credential_fields#xml_filename.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Filename
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :xml_filename, :class=>"form-control settings-field", :placeholder=>"Filename"
              %span{:style => "color: #9ea2a5;"} Please include the directory name and file name (directory/file.xml)


          .form-group.credential_fields#xml_domain.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Domain
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :xml_domain, :class=>"form-control settings-field", :placeholder=>"Domian"


          .form-group.credential_fields#resman_api_version.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              API Version
            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.select :resman_api_version, ["GetMarketing2_0","GetMarketing4_0"], {}, { value: c.object.resman_api_version, class: 'form-control', onchange: 'submitSettingFormOnChange()' }
          
          .form-group.credential_fields#resman_account_id.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Account Id
            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :resman_account_id, :class=>"form-control settings-field", :placeholder=>"Account Id"

          .form-group.credential_fields#zaremba_username.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Username
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_username, :class=>"form-control settings-field", :placeholder=>"Username"


          .form-group.credential_fields#zaremba_password.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Password
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_password, :class=>"form-control settings-field", :placeholder=>"Password"

          .form-group.credential_fields#zaremba_filename.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Filename
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_filename, :class=>"form-control settings-field", :placeholder=>"Filename"

          .form-group.credential_fields#zaremba_property_id.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Property Id
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_property_id, :class=>"form-control settings-field", :placeholder=>"Property Id"

          .form-group.credential_fields#resman_property_id.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Property Id

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :resman_property_id, :class=>"form-control settings-field", :placeholder=>"Property Id"


          .form-group.credential_fields#yardirentcafe_api_options.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              API URL
            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.select :yardi_rent_cafe_api_url, YARDI_RENT_CAFE_API_BASE_URLS, {}, { value: c.object.yardi_rent_cafe_api_url, class: 'form-control', onchange: 'submitSettingFormOnChange()' }
          
          .form-group.credential_fields#yardirentcafe_api_version_options.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              API Version
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :rentcafe_api_version, ["RentCafe V1","RentCafe V2"], {}, { value: c.object.rentcafe_api_version, class: 'form-control', onchange: 'submitSettingFormOnChange()' }

          .form-group.credential_fields#yardirentcafe_option.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Select Option
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = select_tag :yardirentcafe_code_option, options_for_select(["Company Code","Api Token"],c.object.api_token.present? ? "Api Token" : "Company Code"),{:class=>"form-control"}

          .form-group.credential_fields#api_token.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Vendor Api Token
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :api_token, :class=>"form-control settings-field", :placeholder=>"Vendor Api Token"
              
          .form-group.credential_fields#c_code.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              C-code

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :c_code, :class=>"form-control settings-field", :placeholder=>"C-Code" 

          .form-group.credential_fields#rentmanager_base_url.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Domain

            .row.field-to-hide
              .col-sm-12.col-lg-2.col-md-9.col-xs-12.field-to-hide
                = c.text_field :rentmanager_base_url, :class=>"form-control settings-field", :placeholder=>"Domain"

              %span.col-sm-12.col-lg-4.col-md-9.col-xs-12.entrata_label .api.rentmanager.com

          .form-group.credential_fields#rentmanager_username.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Username
            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :rentmanager_username, :class=>"form-control settings-field", :placeholder=>"username"

          .form-group.credential_fields#rentmanager_password.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Password
            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :rentmanager_password, :class=>"form-control settings-field", :placeholder=>"password"

          .form-group.credential_fields#rentmanager_property_id.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Property Id
            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :rentmanager_property_id, :class=>"form-control settings-field", :placeholder=>"property_id"

          .form-group.credential_fields#username.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Username

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :username, :class=>"form-control settings-field", :placeholder=>"username"
          .form-group.credential_fields#password.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Password

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :password, :class=>"form-control settings-field", :placeholder=>"Password",:value=>c.object.password,:autocomplete=>"OFF"
          .form-group.credential_fields#property_id.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Property Id
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :property_id, :class=>"form-control settings-field", :placeholder=>"Property Id"
  
          .form-group.credential_fields#entrata_available_units_only.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Available units only

            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :entrata_available_units_only, "1", class: "settings-field"
              = c.label :entrata_available_units_only, "Yes", :value => "1"

            .col-sm-12.col-lg-1.col-md-2.col-xs-12
              = c.radio_button :entrata_available_units_only, "0", class: "settings-field"
              = c.label :entrata_available_units_only, "No", :value => "0"

          .form-group.credential_fields#entrata_show_unit_spaces.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Show unit spaces

            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :entrata_show_unit_spaces, "1", class: "settings-field"
              = c.label :entrata_show_unit_spaces, "Yes", :value => "1"

            .col-sm-12.col-lg-1.col-md-2.col-xs-12
              = c.radio_button :entrata_show_unit_spaces, "0", class: "settings-field"
              = c.label :entrata_show_unit_spaces, "No", :value => "0"

          .form-group.credential_fields#entrata_use_space_configuration.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Use space configuration

            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :entrata_use_space_configuration, "1", class: "settings-field"
              = c.label :entrata_use_space_configuration, "Yes", :value => "1"

            .col-sm-12.col-lg-1.col-md-2.col-xs-12
              = c.radio_button :entrata_use_space_configuration, "0", class: "settings-field"
              = c.label :entrata_use_space_configuration, "No", :value => "0"


          .form-group.credential_fields#site_id.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              SITE ID

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :site_id, :class=>"form-control settings-field", :placeholder=>"SITE ID" 
          .form-group.credential_fields#p_code.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              P-Code

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :p_code, :class=>"form-control settings-field", :placeholder=>"P-Code"        
          .form-group.credential_fields#pmc_id.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              PMC ID

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :pmc_id, :class=>"form-control settings-field", :placeholder=>"PMC ID"
          .form-group.credential_fields#server_name.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Server Name

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :server_name, :class=>"form-control settings-field", :placeholder=>"Server Name"
          .form-group.credential_fields#database.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Database

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.text_field :database, :class=>"form-control settings-field", :placeholder=>"Database"
          .form-group.credential_fields#platform.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Platform

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.select :platform , options_for_select(["SQL Server"]),{},{:class=>"form-control settings-field"}
          .form-group.credential_fields#interface_entity.field-to-hide
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
              Interface Entity

            .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
              = c.select :interface_entity , options_for_select(["Pynwheel"]),{},{:class=>"form-control settings-field"}
          .form-group.credential_fields#spreadsheet.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Upload Data File

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.file_field :file, :class=>"form-control settings-fields "


          .form-group.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Select Currency

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :currency, @community.all_currencies(Money::Currency::table), {}, { value: c.object.currency, class: 'form-control', onchange: 'submitSettingFormOnChange()' }

          .form-group.credential_fields#limit_result_field.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Limit Results
              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorPopover","data-content" => " "}
                %span#propertyDetailNameText
                  This will limit the number of units that appear as available if the data feed specified above includes a parameter or function to limit results.

            .col-sm-12.col-lg-2.col-md-3.col-xs-12
              = c.radio_button :limit_result, true, class: "settings-field"
              = c.label :limit_result, "Yes", :value => "true"
            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :limit_result, false, class: "settings-field"
              = c.label :limit_result, "No", :value => "false"
          
          .form-group.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Allow Apply Now
              %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorPopover","data-content" => " "}
                %span#propertyDetailNameText
                  This will display an "Apply" link on your app(s) if an "Apply" link is available in the data feed specified above. 
            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :apply_now, "true", class: "apply_now_true settings-field"
              = c.label :apply_now, "Yes", :value => "true"

            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :apply_now, "false", class: "apply_now_false settings-field"
              = c.label :apply_now, "No", :value => "false"

            .col-sm-12.col-lg-3.col-md-7.col-xs-12
              = c.radio_button :apply_now, "separate_link", class: "apply_now_separate_link settings-field"
              = c.label :apply_now, "Add a separate link", :value => "separate_link"

          .form-group.credential_fields-separate_link.hidden#separate_link_field
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Separate Link

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :separate_link, :class=>"form-control settings-field", :placeholder=>"Link"
          - if @community.self_tour
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Allow PERQ Tours
              .col-sm-12.col-lg-2.col-md-3.col-xs-12
                = c.radio_button :is_perq_allowed, true, class: "settings-field"
                = c.label :is_perq_allowed, "Yes", :value => "true"
              .col-sm-12.col-lg-2.col-md-2.col-xs-12
                = c.radio_button :is_perq_allowed, false, class: "settings-field"
                = c.label :is_perq_allowed, "No", :value => "false"    

            .form-group.hidden#allow_perq_property_id
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                PERQ Property Id

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = c.text_field :perq_property_id, :class=>"form-control settings-field", :placeholder=>"PERQ Property Id"

          .form-group.hide_form_fields
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Connect to CRM

            .col-sm-12.col-lg-2.col-md-3.col-xs-12
              = c.radio_button :use_different_crm_provider, true, class: "settings-field"
              = c.label :use_different_crm_provider, "Yes", :value => "true"
            .col-sm-12.col-lg-2.col-md-2.col-xs-12
              = c.radio_button :use_different_crm_provider, false, class: "settings-field"
              = c.label :use_different_crm_provider, "No", :value => "false"    

          %input#spreadsheet_method{:name => "spreadsheet_method", :type => "hidden", :value => "0"}/
            
= form_for @crm_credential,:url=>"/communities/#{@community.id}/crm_providers/#{@crm_credential.id}",:html=>{:class=>"form-horizontal crm-settings-form", style: "margin-top: -95px;", :method=>'PUT'},:remote=>true do |crm|
  .box-body.crm-settings-div
    .row
      .col-lg-9.col-lg-offset-1
        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Crm Data Provider
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = crm.select :crm_provider , options_for_select([["Entrata","psi"],["RealPage","realpagesvc"],["Salesforce","salesforce"],["Yardi Rent Cafe","yardirentcafe"], ["Knock", "knock"], ["Funnel", "funnel"]],crm.object.crm_provider.present? ? crm.object.crm_provider : @community.data_provider),{},{:class=>"form-control", :id => "crm_provider"}
        
            %p.rent-cafe-v2-note Note: Rentcafe CRM version 2 uses the same credentials as entered in the data providers section above.

        .form-group.crm_credential_fields.entrata_domain
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Domain

          .col-sm-12.col-lg-2.col-md-2.col-xs-12
            = crm.text_field :entrata_domain, :class=>"form-control crm-settings-field", :placeholder=>"Domain"
          %span.col-sm-12.col-lg-4.col-md-9.col-xs-12.entrata_label
            \.entrata.com/api/v1/propertyunits  
        .form-group.crm_credential_fields.entrata_username
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Username

          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = crm.text_field :entrata_username, :class=>"form-control crm-settings-field", :placeholder=>"Username"
        .form-group.crm_credential_fields.entrata_password
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Password

          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = crm.text_field :entrata_password, :class=>"form-control crm-settings-field", :placeholder=>"Password"
        .form-group.crm_credential_fields.entrata_property_id
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Property Id

          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = crm.text_field :entrata_property_id, :class=>"form-control crm-settings-field", :placeholder=>"Property Id"

        .form-group.crm_credential_fields.realpage_site_id
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Site Id

          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = crm.text_field :realpage_site_id, :class=>"form-control crm-settings-field", :placeholder=>"Site Id"

        .form-group.crm_credential_fields.realpage_pmc_id
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            PMC Id

          .col-sm-12.col-lg-9.col-md-9.col-xs-12
