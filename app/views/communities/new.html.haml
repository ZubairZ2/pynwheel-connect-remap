/ Main content
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Community

      = form_for @community,:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "ADD COMMUNITY", :class=>"btn btn-success pull-right"

