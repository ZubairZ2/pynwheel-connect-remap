.modal{:role => "dialog", :id => "pynwheelManageAccessesModal", :tabindex => "-1"}
  .modal-dialog.modal-lg{:role => "document"}
    .modal-content
      .modal-header
        %h3.modal-title 
          %strong.pynwheel-access-modal-title Manage pynwheel user accesses
      .modal-body
        = "Manage pynwheel user accesses"

      .modal-footer
        %button.btn.btn-default{:type => "button", :onclick => "closeManageAccessesModal()"} Cancel
        %button.btn.btn-primary.pynwheel-access-modal-button{:type => "button", :onclick => "managePynwheelUserAccesses()"} Update access
