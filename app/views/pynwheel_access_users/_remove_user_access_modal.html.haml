.modal{:role => "dialog", :id => "removePynwheelAccessModal", :tabindex => "-1"}
  .modal-dialog{:role => "document"}
    .modal-content
      .modal-header
        %h3.modal-title 
          %strong Remove Pynwheel User Access

      .modal-body
        %p Are you sure you want to remove user access? This cannot be undone.
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel
        %button.btn.btn-danger{:type => "button", :onclick => "deletePynwheelAccessUser()"} Delete