.row
  .col-md-12#outer_div
    .box.box-widget.panel-box.add-plan
      %table#access-miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units
        %thead
          %tr
            %th{:width => "79"} Sr #
            %th Name
            %th type
            %th{:width => "150"} Actions
        %tbody
          - order_number = 0
          - units&.each do |unit|
            %tr
              %td
                = order_number = order_number + 1
              %td
                = unit.marketing_name
              %td
                = "Unit"
              %td
                %a.text-danger{"data-name"=>"Access Point", "data-target" => "#removePynwheelAccessModal", "data-toggle" => "modal", "onclick" => "displayAccessWarningModal(#{unit.id}, 'unit')"}
                  %i.fa.fa-trash.pynwheel_access_user_action_icon_size.additionalPageAction
                    %span#additionalPageActionText 
                      Click on trash icon to remove the access of this unit.

                %a.text-success{"data-name"=>"Tour Stop", "data-toggle" => "modal", "href" => "/communities/#{community.id}/units/#{unit.id}/edit"}
                  %i.fa.fa-pencil-square-o.pynwheel_access_user_action_icon_size.additionalPageAction
                    %span#additionalPageActionText 
                      Click on the edit icon to edit the Unit. Add photos, videos, and text. 

                -# %a.text-default{"data-name"=>"Tour Stop", "data-target" => "#pynwheelAccessTimeModal", "data-toggle" => "modal"}
                -#   %i.fa.fa-clock-o.pynwheel_access_user_action_icon_size.additionalPageAction
                -#     %span#additionalPageActionText 
                -#       Click on the clock icon to manage the pynwheel user access times.

            = render :partial=>'access_timer', :locals => {community: community, access_point: unit}
            = render :partial=>'remove_user_access_modal', :locals => {community: community, access_point: unit, user: user}

          - amenities&.each do |amenity|
            %tr
              %td
                = order_number = order_number + 1
              %td
                = amenity.name
              %td
                = "Amenity"
              %td
                %a.text-danger{"data-name"=>"Access Point", "data-target" => "#removePynwheelAccessModal", "data-toggle" => "modal", "onclick" => "displayAccessWarningModal(#{amenity.id}, 'amenity')"}
                  %i.fa.fa-trash.pynwheel_access_user_action_icon_size.additionalPageAction
                    %span#additionalPageActionText 
                      Click on trash icon to remove the access of this amenity.

                %a.text-success{"data-name"=>"Tour Stop", "data-toggle" => "modal", "href" => "/communities/#{community.id}/amenities/#{amenity.id}/edit"}
                  %i.fa.fa-pencil-square-o.pynwheel_access_user_action_icon_size.additionalPageAction
                    %span#additionalPageActionText 
                      Click on the edit icon to edit the amenity. Add photos, videos, and text. 

                -# %a.text-default{"data-name"=>"Tour Stop", "data-target" => "#pynwheelAccessTimeModal", "data-toggle" => "modal"}
                -#   %i.fa.fa-clock-o.pynwheel_access_user_action_icon_size.additionalPageAction
                -#     %span#additionalPageActionText 
                -#       Click on the clock icon to manage the pynwheel user access times.

            = render :partial=>'access_timer', :locals => {community: community, access_point: amenity}
            = render :partial=>'remove_user_access_modal', :locals => {community: community, access_point: amenity, user: user}
