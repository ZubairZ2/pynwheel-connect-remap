-# Registry + API key management (add partner, generate/rotate, revoke).
-# Kept apart from _script, which owns the property association table.
:javascript
  (function(){
    var csrf       = $('meta[name="csrf-token"]').attr('content');
    var createUrl  = "#{create_partner_community_partner_configurations_path(current_community)}";
    var rotateUrl  = "#{rotate_key_community_partner_configurations_path(current_community)}";
    var revokeUrl  = "#{revoke_key_community_partner_configurations_path(current_community)}";
    var panel      = $('.pc-key-panel');
    var partnerKey = panel.data('partner');
    var partnerLbl = panel.data('label');

    function post(url, data, method){
      return $.ajax({
        url: url,
        method: method || 'POST',
        data: $.extend({ authenticity_token: csrf }, data),
        dataType: 'json'
      });
    }

    function failMessage(xhr, fallback){
      var res = xhr && xhr.responseJSON;
      return (res && res.message) || fallback;
    }

    // ---------- add partner ----------
    // Suggest the identifier from the display name until the user edits it.
    var keyTouched = false;
    $('#pcPartnerKey').on('input', function(){ keyTouched = true; });
    $('#pcPartnerLabel').on('input', function(){
      if (keyTouched) { return; }
      $('#pcPartnerKey').val(
        $(this).val().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '')
      );
    });

    $('#pcAddPartnerBtn').on('click', function(){
      keyTouched = false;
      $('#pcPartnerLabel, #pcPartnerKey').val('');
      $('#pcAddPartnerError').hide().text('');
      $('#pcAddPartnerModal').modal('show');
    });

    $('#pcAddPartnerSave').on('click', function(){
      var $btn = $(this).prop('disabled', true);
      post(createUrl, { label: $('#pcPartnerLabel').val(), key: $('#pcPartnerKey').val() })
        .done(function(){ window.location.reload(); })
        .fail(function(xhr){
          $('#pcAddPartnerError').text(failMessage(xhr, 'Could not add the partner.')).show();
          $btn.prop('disabled', false);
        });
    });

    // ---------- generate / rotate ----------
    $('#pcRotateBtn').on('click', function(){
      var hasKey = $('#pcKeyValue').hasClass('pc-key-value');
      $('#pcRotateTitle').text(hasKey ? 'Rotate API key' : 'Generate API key');
      $('#pcRotateConfirm').text(hasKey ? 'Rotate key' : 'Generate');
      $('#pcRotateBody').text(hasKey
        ? 'Generating a new key for ' + partnerLbl + ' immediately invalidates the current one. Any of their integrations still using it will start failing, so send them the new key first.'
        : 'Generate the Partner Maps API key for ' + partnerLbl + '.');
      $('#pcRotateModal').modal('show');
    });

    $('#pcRotateConfirm').on('click', function(){
      var $btn = $(this).prop('disabled', true);
      post(rotateUrl, { partner_key: partnerKey })
        .done(function(res){
          $('#pcRotateModal').modal('hide');
          showKeyLink(res);
        })
        .fail(function(xhr){ alert(failMessage(xhr, 'Could not generate the key. Please try again.')); })
        .always(function(){ $btn.prop('disabled', false); });
    });

    function showKeyLink(res){
      $('#pcKeyLinkIntro').text(res.message || '');
      $('#pcKeyLink').val(res.reveal_url);
      $('#pcKeyLinkEmail').attr('href',
        'mailto:?subject=' + encodeURIComponent('Your Pynwheel Partner API key') +
        '&body=' + encodeURIComponent(
          'Hello,\n\nYour Pynwheel Partner API key is ready. Open the link below to read it — ' +
          'it can only be opened once and expires in 72 hours:\n\n' + res.reveal_url +
          '\n\nStore the key somewhere safe; it cannot be shown again.\n\nThanks,\nPynwheel'
        ));
      $('#pcKeyLinkModal').modal('show');
      // Reflect the new masked key without a reload.
      $('#pcKeyValue').removeClass('pc-key-none').addClass('pc-key-value').text(res.partner.masked_key);
    }

    $('#pcKeyLinkCopy').on('click', function(){
      var $btn = $(this);
      navigator.clipboard.writeText($('#pcKeyLink').val()).then(function(){
        $btn.find('i').removeClass('fa-copy').addClass('fa-check');
        setTimeout(function(){ $btn.find('i').removeClass('fa-check').addClass('fa-copy'); }, 1600);
      });
    });

    // Reload on close so the panel reflects the rotated/revoked state exactly.
    $('#pcKeyLinkModal').on('hidden.bs.modal', function(){ window.location.reload(); });

    // ---------- revoke ----------
    $('#pcRevokeBtn').on('click', function(){
      $('#pcRevokePartnerName').text(partnerLbl);
      $('#pcRevokeModal').modal('show');
    });

    $('#pcRevokeConfirm').on('click', function(){
      var $btn = $(this).prop('disabled', true);
      post(revokeUrl, { partner_key: partnerKey }, 'DELETE')
        .done(function(){ window.location.reload(); })
        .fail(function(xhr){
          alert(failMessage(xhr, 'Could not revoke the key. Please try again.'));
          $btn.prop('disabled', false);
        });
    });
  })();
