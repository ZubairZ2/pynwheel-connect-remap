$('#images-index-unit').html("<%= escape_javascript render 'index' %>");
var message = '<div class="alert alert-success">Image uploaded successfully.</div>'
$('#flash-message').html(message);
setTimeout(function() {
    $('.alert').fadeOut('slow');
}, 10000);
if( <%= @unit.amenities.count %> == 0)
{
    $('#amenity_image').hide();
}
if( <%= @unit.amenities.count %> > 0)
{
    $('#amenity_image').show();
}
imageUnitAmenityDragNdrop();

$('.preview-image').click(function(event){
    event.preventDefault();
    $(this).ekkoLightbox({
        alwaysShowClose: true
    });
});