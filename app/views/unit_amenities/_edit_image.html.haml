.modal-dialog{:style=>"overflow-y: initial width: 1300px !important; width: 1300px;"}
  .modal-content
    = form_for @amenity,url: community_unit_amenity_path(@community,@unit,@amenity),method: :put do |f|
      .modal-body
        .image-crop{:style=>"overflow-y: auto;"}
          = image_tag @amenity.image.url, id: "cropbox"
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
            %i.fa.fa-close
        .form-group
          %label{:for => "exampleInputEmail1"} Image Title
          = f.text_field :name , class: "form-control", placeholder: "Name"
        .form-group
          %label{:for => "exampleInputEmail1"} Description
          = f.text_area :description , class: "form-control", placeholder: "Description", :max_length => 70
        -#.form-group
        -#  = link_to "Add Galleryyy", edit_community_amenity_path(@community,f), class: "btn btn-primary btn-sm mb-20"
        -#    -#%i.fa.fa-plus
        .form-group

        .form-group
          %button.btn.btn-success.pull-right.btn-sm.mb-20#crop_image{:type => "submit"}
            Apply Changes
            %i.fa.fa-check
        .clearfix

  .modal-footer{:style => "background: none;"}
    = link_to "Add Gallery", edit_community_amenity_path(@community,@amenity), :class => "btn-success pull-right btn-sm"

}