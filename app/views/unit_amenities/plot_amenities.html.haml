- content_for :title, "Plot Amenities - Pynwheel"
%section.is-amenity
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-database
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot
          %span= @unit.marketing_name + " Amenities"
          %span.hidden#active_x_plot 0
          
          %span.hidden#active_y_plot 0
        .pull-right.btn-btn-danger
          = link_to "Back",community_unit_amenities_path(@community,@sitemap), :class=>"btn btn-primary mr-5 hidden" 
          %a.btn.btn-danger{"data-name" => "unit's amenities plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/units/#{@sitemap.id}/amenities/remove_amenities_plot"} Reset all plots
      / /.box-header
      / form start
      %form.form-horizontal
        .box-body.map-body-top
          .row
            .col-lg-9#container.p-0
              .map-block{:style=>"position: relative;"}
                .plot-image#map
                  = image_tag @unit.standard_image_url.present? ? @unit.standard_image_url : (@floorplan.present? && @floorplan.standard_image_url.present? ? @floorplan.standard_image_url : "/assets/default.jpeg")
                  - @sitemap.amenities.each do |amenity|
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                      = link_to "<i class='fa fa-star'></i>".html_safe, "#", :class => "marker", 'data-toggle' => "tooltip", :title => amenity.name, :id => "m_#{amenity.id}", :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;", "data-name" => "plot", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/units/#{@sitemap.id}/amenities/#{amenity.id}/remove_amenity"
            .col-lg-3
              %h5.mt-40.mb-20 SELECT IMAGES TO PLOT
              .imageselect
                .show-categories
                  = "-- select image --"
                %ul#imageselect{:style => "display: none;"}
                  - amenity_arr = []
                  - @amenities.each do |amenity|
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i == 0
                      %li{"data-id" => "#{amenity.id}","data-name" => "#{amenity.name}"}
                        %a
                          = image_tag amenity.image.present? ? amenity.image.url : "upload-image.png"
                          %span.ml-5
                            = amenity.name
                    - amenity_arr.push([amenity.id.to_s, amenity.x_plot.to_i, amenity.y_plot.to_i, true, amenity.name])

              %h5.mt-40 SELECTED IMAGES
              .add-plan.mt-10.mb-20
                %ul#selected-units
              / %button.btn.btn-success#new{:type => "button"} PLOT NOW
              %label#newmsg Place marker for selected amenities on Map
        #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
          %i.icon-screenshot
:javascript
  var arr = #{raw amenity_arr}
  var community_id = #{params[:community_id]}
  var addmode = false;
  var unit_id_for_amenity = #{@sitemap.id}
  var amenity_type = "unit"