- content_for :title, "Invite User - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => "/"}
      = image_tag "pynwheel-logo.png"
    %p Invite User!
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
      .col-md-6.col-lg-4
        .text-center
          %h3 Send Invitation
        = form_for resource, :as => resource_name, :url => invitation_path(resource_name), :html => {:method => :post} do |f| 
          .form-group
            = f.select :role, options_for_select(@companies.collect{|c| [c.name,c.id]},f.object.company_id),{},{class: "form-control"}
          .form-group
            = f.select :role, options_for_select(User::ROLES,f.object.role),{},{class: "form-control"} 
          .form-group
            = f.text_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email", autofocus: true
            %i.fa.fa-envelope    
          = f.submit "Send Ivitation", :class=>"btn btn-primary btn-block" 
          = link_to "Cancel", employees_path, :class=>"btn btn-default btn-block"
        .text-center
          %p.copy-right © 2017 Pynwheel    
:javascript
  $("form").validationEngine();                      