- content_for :title, "Invite User - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => "/"}
      = image_tag "pynwheel-logo.png"
    %p Invite User!
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
      .col-md-6.col-lg-4
        .text-center
          %h3 Send Invitation
        = form_for resource, :as => resource_name, :url => invitation_path(resource_name), :html => {:method => :post} do |f| 
          = f.hidden_field :company_id, :value=>current_company.id
          .form-group
            = f.select :role, options_for_select(User::ROLES,f.object.role),{:include_blank => 'Select Admin'},{class: "form-control validate[required]"} 
          .form-group
            = f.email_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email", autofocus: true
            %i.fa.fa-envelope    
          = f.submit "Send Ivitation", :class=>"btn btn-primary btn-block" 
          = link_to "Cancel", company_employees_path(current_company), :class=>"btn btn-default btn-block"
        .text-center
          %p.copy-right © 2017 Pynwheel                         