- content_for :title, "Invite User - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => "/"}
      = image_tag "pyn-logo.png"
    %p Invite User!
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
      .col-md-8.col-lg-5.col-sm-12.col-xs-12
        .text-center
          %h3 Send Invitation
        = form_for resource, :as => resource_name, :url => invitation_path(resource_name), :html => {:method => :post, :id => "invitation_form"} do |f|
          .form-group
            - if current_user.is_super_admin?
              = f.select :role, options_for_select(User::ROLES,f.object.role),{},{class: "form-control validate[required] col-sm-12 col-xs-12"}
            - elsif current_user.is_dwelo_admin?
              = f.select :role, options_for_select(User::ROLES_DWELO_ADMIN,f.object.role),{},{class: "form-control validate[required] col-sm-12 col-xs-12"}
            - elsif current_user.is_community_admin?
              = f.select :role, options_for_select(User::ROLES_ADMIN,f.object.role),{},{class: "form-control validate[required]"}

          .pynwheel-existing-company-form
            %div.existing-company-name.form-group
              - if current_user.is_super_admin?
                = f.select :company, options_for_select(current_user.all_companies,f.object.role),{:include_blank => 'Select Company'},{class: "form-control validate[required] company_list"}
              - elsif current_user.is_dwelo_admin?
                = f.select :company, options_for_select(current_user.dwelo_companies,f.object.role),{:include_blank => 'Select Company'},{class: "form-control validate[required] company_list"}

            = hidden_field_tag "companies_hash", companies_hash.to_json
            = f.hidden_field "company_id"
            = f.hidden_field "region_id"

            - if current_user.is_super_admin? || current_user.is_dwelo_admin?
              .form-group.region_select.hide_it

            %div.existing-community-name.row
              .form-group
                .row
                  .col-lg-6.col-sm-6.col-xs-6.col-md-6
                    %p{:style => "text-align: center;"} Listed Communities
                  .col-lg-6.col-sm-6.col-xs-6.col-md-6
                    %p{:style => ""} Selected Communities
                .col-sm-12.col-xs-12.col-lg-12.col-md-12
                .col-sm-1.col-xs-1.col-lg-12.col-md-12
                .col-sm-10.col-xs-10.col-lg-12.col-md-12{:style => "text-align: -webkit-center;"}
                  = f.select :community_ids, options_for_select(''),{},{class: "form-control communities_box",:multiple=>true}
          %br
            .chat_feature
              .row{:style => "text-align: center; margin-top: 30px; margin-bottom: 15px;"}
                %label
                  Enable Chat
              .row
                .form-group
                  .row
                    .col-lg-6.col-sm-6.col-xs-6.col-md-6
                      %p{:style => "text-align: center;"} Listed Communities
                    .col-lg-6.col-sm-6.col-xs-6.col-md-6
                      %p{:style => ""} Selected Communities

                  .col-sm-12.col-xs-12.col-lg-12.col-md-12
                  .col-sm-1.col-xs-1.col-lg-12.col-md-12
                  .col-sm-10.col-xs-10.col-lg-12.col-md-12{:style => "text-align: -webkit-center;"}
                    = select_tag :chat_community_ids, options_for_select(''),{class: "form-control communities_box",:multiple=>true}
          %br
          
          %div#access-control{style: "margin-bottom: 15px;"}
            .form-group{style: "padding-top: 20px;"}
              %label.col-sm-12.col-lg-6.col-md-6.col-xs-12.control-label
                Pynwheel Connect
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = f.check_box :pynwheel_connect_access, :checked => "false", :class => "pynwheel_connect"
                  %label.label-primary{:for => "user_pynwheel_connect_access"}
                  %span.pl-5 Yes

            .form-group
              %label.col-sm-12.col-lg-6.col-md-6.col-xs-12.control-label
                Pynwheel Launch
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = f.check_box :pynwheel_launch_access, :checked => "checked", :class => "pynwheel_launch"
                  %label.label-primary{:for => "user_pynwheel_launch_access"}
                  %span.pl-5 Yes
            %p#access-control-error{style: "display: none; text-align: center; color: red;"}
              ** Please select atleast one access!
          .col-sm-12.col-xs-12.col-lg-12.col-md-12.email-id-row{style: "display: inline-flex;width: 100%;"}
            %span.to-input.fa.fa-envelope
            .all-mail
            = f.text_area :email, name: "user[email]", :class=>"form-control", :placeholder=>"Email",:maxlength=>"50", autofocus: true, :required => "required"
          %input.to-submit-id{:name => "to_sumbit", :type => "hidden"}/
          -# %button.btn.btn-primary.btn-block#invitation-submit-btn{ type: 'button' } Submit
          = f.submit "Send Invitation", :class=>"btn btn-primary btn-block invitation-submit-btn", data: { disable_with: false }
          = link_to "Cancel", company_employees_path(current_company), :class=>"btn btn-default btn-block"
        .text-center
          %p.copy-right © 2018 Pynwheel


:javascript
  var emails = [];
  $(".enter-mail-id").keydown(function (e) {
    if (e.keyCode == 13 || e.keyCode == 32) {
      //alert('You Press enter');
    var getValue = $(this).val().trim();
    if (getValue) {
      $('.all-mail').append('<span class="email-ids">'+ getValue +' <span class="cancel-email" data-email-to-cancel="'+ getValue +'">x</span></span>');
      emails.push(getValue)
      $(".to-submit-id").val(emails.join(','))
      $(this).val('');
    }
    }
  });

  $("#invitation_form").submit(function(event){
    let pynwheelConnect = document.getElementsByClassName('pynwheel_connect')[0].checked;
    let pynwheelLaunch = document.getElementsByClassName('pynwheel_launch')[0].checked;
    if (!pynwheelConnect && !pynwheelLaunch){
      event.preventDefault();
      $('#access-control').css('border', '2px solid red');
      $('#access-control-error').css('display', 'block');
      reset_alert_styles();
    }
  });
  function reset_alert_styles(){
    setTimeout(() => { 
      $('#access-control').css('border', 'none');
      $('#access-control-error').css('display', 'none');
    }, 5000);
  }
  $(document).on('click','.cancel-email',function(){
    var toCancel = $(this).data('email-to-cancel');
    $(this).parent().remove();
    emails = emails.filter(function(elem){
      return elem != toCancel;
    });
    $(".to-submit-id").val(emails.join(','))
  });

  $('#user_community_ids').multiSelect();
  $('#chat_community_ids').multiSelect();

  $(".company_list").change(function(){
    console.log("change called")
    companies_obj = JSON.parse($('#companies_hash').val())
    company_name = $(this).val()
    company_id = companies_obj[company_name]
    $('#user_company_id').val(company_id)

    user_role = $('#user_role').val()
    if (is_regional_admin(user_role)){
      add_region()
      add_or_replace_options()
    }else
      add_or_replace_options()
  });
  $('#user_community_ids').change(function(){
    user_role = $('#user_role').val()
    if (!is_visitor_detail(user_role)){
      $('#chat_community_ids').multiSelect('removeAllOptions');
      for(i = 0; i < $('#user_community_ids :selected').length ; i++)
      {
        $('#chat_community_ids').multiSelect('addOption', { value: $('#user_community_ids :selected')[i].value, text: $('#user_community_ids :selected')[i].text });
      }
    }
  });

  $('#user_role').change(function(){
    user_role = $('#user_role').val()
    if (is_regional_admin(user_role)){
      $('.chat_feature').removeClass('hide_it')
      $(".company_list").val("").trigger("change");
      add_region()
    }
    else if(is_visitor_detail(user_role)){
      $(".company_list").val("").trigger("change");
      $('.chat_feature').addClass('hide_it')
      $('.region_select').addClass('hide_it')
    }
    else{
      $('.chat_feature').removeClass('hide_it')
      $('.region_select').addClass('hide_it')
      add_or_replace_options()
    }

  });

  $(document).on('change', '#regions', function() {
    if ($(this).val().length > 0)
      $('#user_region_id').val($('#regions').val())
    else
      $('#user_region_id').val("")

    add_or_replace_options()
  });

  function isDweloCommunity() {
    if ( $("#pynwheel-dwelo-community-option").prop('checked') ) {
      updatedProductOptionsJson["dwelo_community"] = true;

    } else {
      updatedProductOptionsJson["dwelo_community"] = false;
    }
  }

  function handleCompanyFormVisibility(is_existing) {
    if(is_existing === "existing") {
      $(".existing-company-name").show();
      $(".pynwheel-new-company-name").hide();
      $(".pynwheel-new-community-name").show();
    } else{
      $(".existing-company-name").hide();
      $(".existing-community-name").hide();
      $(".pynwheel-new-company-name").show();
      $(".pynwheel-new-community-name").show();
    }
  }

  function enable_disable_communities(){
    user_role = $('#user_role').val()
    if ( is_company_admin(user_role) || is_regional_admin(user_role)){
      $('#user_community_ids').multiSelect('select_all');
      $('#user_community_ids').siblings('.ms-container').find('.ms-selection').find('ul.ms-list li').addClass('disabled')
    }
    else
    {
      $('#user_community_ids').multiSelect('deselect_all');
      $('#user_community_ids').siblings('.ms-container').find('.ms-selection').find('ul.ms-list li').removeClass('disabled')
    }
  }

  function add_or_replace_options(){
    var selected_company =  $(".company_list").val()
    user_role = $('#user_role').val()
    if (is_regional_admin(user_role)){
      selected_region = $('#regions').val()
      if ( $('#regions').length > 0  && selected_region.length == 0 )
        selected_region = "false"

      data = { company: selected_company, region: selected_region}
      append_communities(data)
    }
    else{
      data = { company: selected_company }
      append_communities(data)
    }
  }
  function append_communities(data){
    $.ajax({
      url: "/communities/invitation_communities",
      type: "POST",
      data: data,

      success: function(resp){
        $('#user_community_ids').multiSelect('removeAllOptions');
        $('#chat_community_ids').multiSelect('removeAllOptions');
        parsed_arr = $.parseJSON(resp.data);
        for (var i=0; i<parsed_arr.length  ; i++) {
          $('#user_community_ids').multiSelect('addOption', { value: parsed_arr[i][1], text: parsed_arr[i][0] });
        }
        enable_disable_communities()
      }
    });
  }
  function add_region(){
    selected_company =  $(".company_list").val()
    data = { company: selected_company }
    $('.region_select').removeClass('hide_it')
    $.ajax({
      url: "/companies/get_regions",
      type: "GET",
      data: data,
      success: function(resp){
        $('.region_select').html(resp)
      }
    });
  }
  function is_company_admin(val){
    return val == "Company admin"
  }
  function is_regional_admin(val){
    return val == "Regional admin"
  }
  function is_visitor_detail(val){
    return val == "visitor_detail_page"
  }
