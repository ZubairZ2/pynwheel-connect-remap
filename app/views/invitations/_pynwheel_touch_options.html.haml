.pynwheel-touch-option
  %input#pynwheel-touch{:name => "pynwheel-touch", :type => "checkbox"}
  %label Pynwheel Touch

  .sub-options.pynwheel-touch-sub-options
    .pynwheel-touch-design-style
      %label
        Design Style:
      .form-check
        %input#flexRadioDefault1.form-check-input{:name => "touchDesignStyleRadio", :value => "Futurist", :type => "radio", :checked=> "checked"}/
        %label.form-check-label{:for => "flexRadioDefault1"}
          Futurist
      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchDesignStyleRadio", :value => "Expressionist", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          Expressionist - Based on proprty brand

      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchDesignStyleRadio", :value => "Modernist Vertical", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          Modernist - Vertical main menu

      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchDesignStyleRadio", :value => "Modernist Horizontal", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          Modernist - Horizontal main menu

    %br


  .sub-options.pynwheel-touch-sub-options
    .pynwheel-touch-hardware
      %label
        Hardware:
      .form-check
        %input#flexRadioDefault1.form-check-input{:name => "touchScreenRadio", :value => "55” Touchscreen", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault1"}
          55” Touchscreen
      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchScreenRadio", :value => "65” Touchscreen", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          65” Touchscreen

      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchScreenRadio", :value => "42” Touchscreen", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          42” Touchscreen

      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchScreenRadio", :value => "No Touchscreen", :type => "radio", :checked=> "checked"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          No Touchscreen

    %br

    .pynwheel-touch-installation
      %label
        Installation:

      .form-check
        %input#flexRadioDefault1.form-check-input{:name => "touchInstallationRadio", :value => "Yes", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault1"}
          Yes
      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchInstallationRadio", :value => "No", :type => "radio", :checked=> "checked"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          No

    %br

    .pynwheel-touch-stand
      %label
        Stand:

      .form-check
        %input#flexRadioDefault1.form-check-input{:name => "touchStandRadio", :value => "Chief", :type => "radio", :checked=> "checked"}/
        %label.form-check-label{:for => "flexRadioDefault1"}
          Chief
      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchStandRadio", :value => "Olea", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          Olea
      .form-check
        %input#flexRadioDefault2.form-check-input{:name => "touchStandRadio", :value => "N/A", :type => "radio"}/
        %label.form-check-label{:for => "flexRadioDefault2"}
          N/A
