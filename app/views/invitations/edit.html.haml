- content_for :title, "Set Password - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => "/"}
      = image_tag "pyn-logo.png"
    %p Set your profile!
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
      .col-md-6.col-lg-4
        .text-center
          %h3 Set your profile
        = form_for resource, :as => resource_name, :url => invitation_path(resource_name), :html => { :method => :put } do |f|
          = f.hidden_field :invitation_token 
          .form-group
            = f.text_field :first_name, :class=>"form-control validate[required,custom[onlyLetterSp]", :placeholder=>"First Name",:maxlength=>"20"
            %i.fa.fa-user  
          .form-group
            = f.text_field :last_name, :class=>"form-control validate[required,custom[onlyLetterSp]", :placeholder=>"Last Name",:maxlength=>"20"  
            %i.fa.fa-user 
          .form-group
            = f.email_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email",:maxlength=>"50", autofocus: true ,:readonly => true
            %i.fa.fa-envelope   
          .form-group
            = f.password_field :password, :class=>"form-control validate[required]", :placeholder=>"Password",:maxlength=>"50", autocomplete: "off" 
            %i.fa.fa-envelope 
          .form-group
            = f.password_field :password_confirmation, :class=>"form-control validate[required]", :placeholder=>"Password Confirmation",:maxlength=>"50", autocomplete: "off"
            %i.fa.fa-envelope       
          = f.submit "Save Changes", :class=>"btn btn-primary btn-block"
        .text-center
          %p.copy-right © 2018 Pynwheel                                            