- if(@show_html && @community.community_tour.tour_setting.enable_header_footer)
  !!! Strict
  %html{:xmlns => "http://www.w3.org/1999/xhtml"}
    %head
      %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
      %meta{:content => "width=device-width, initial-scale=1.0", :name => "viewport"}/
      %meta{:content => "IE=edge,chrome=1", "http-equiv" => "X-UA-Compatible"}/
      %meta{:content => "telephone=no", :name => "format-detection"}/
      -# %link{:href => "https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap", :rel => "stylesheet"}/
      / disable auto telephone linking in iOS
      / %title Welcome
      :css
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap');
        body,#bodyTable,#bodyCell,#bodyCell{
          height:100% !important;
          margin:0;
          padding:0;
          width:100% !important;
          font-family:Helvetica, Arial, "Lucida Grande", sans-serif;
        }
        table{
          border-collapse:collapse;
        }
        table[id=bodyTable]{
          width:100%!important;
          margin:auto;
          max-width:620px!important;
          color:#7A7A7A;
          font-weight:normal;
        }
        img,a img{
         /* border:0;
          outline:none;
          text-decoration:none;
          height:auto;
          line-height:100%; */
        }
        a{
          text-decoration:none !important;
          border-bottom:0 !important;
        }
        h1,h3,h4,h5,h6{
          color:#5F5F5F;
          font-weight:normal;
          font-family:Helvetica, Arial, "Lucida Grande", sans-serif;
          font-size:20px;
          line-height:125%;
          text-align:Left;
          letter-spacing:normal;
          margin-top:0;
          margin-right:0;
          margin-bottom:10px;
          margin-left:0;
          padding-top:0;
          padding-bottom:0;
          padding-left:0;
          padding-right:0;
        }
        .ReadMsgBody{
          width:100%;
        }
        .ExternalClass{
          width:100%;
        }
        .ExternalClass,.ExternalClass p,.ExternalClass span,.ExternalClass font,.ExternalClass td,.ExternalClass div{
          line-height:100%;
        }
        table,td{
          mso-table-lspace:0pt;
          mso-table-rspace:0pt;
        }
        img{
         /* -ms-interpolation-mode:bicubic;
          display:block;
          outline:none;
          text-decoration:none; */
        }
        body,table,td,p,a,li,blockquote{
          -ms-text-size-adjust:100%;
          -webkit-text-size-adjust:100%;
          font-weight:normal!important;
        }
        .ExternalClass td[class=ecxflexibleContainerBox] h3{
          padding-top:10px !important;
        }
        h1{
          display:block;
          font-size:26px;
          font-style:normal;
          font-weight:normal;
          line-height:100%;
        }
        
        h3{
          display:block;
          font-size:17px;
          font-style:normal;
          font-weight:normal;
          line-height:110%;
        }
        h4{
          display:block;
          font-size:18px;
          font-style:italic;
          font-weight:normal;
          line-height:100%;
        }
        .flexibleImage{
          height:auto;
        }
        .video-wrapper {display:none;}
        @media (-webkit-min-pixel-ratio: 0) and (min-width:1024px) 
        {
        .video-wrapper { display:block!important; }
        .video-fallback { display:none!important; }
        }
        @supports (-webkit-overflow-scrolling:touch) and (color:#ffffffff) {
          div[class^=video-wrapper] { display:block!important; }
          div[class^=video-fallback] { display:none!important; }
        }
        #MessageViewBody .video-wrapper { display:block!important; }
        #MessageViewBody .video-fallback { display:none!important; }
        .linkRemoveBorder{
          border-bottom:0 !important;
        }
        table[class=flexibleContainerCellDivider]{
          padding-bottom:0 !important;
          padding-top:0 !important;
        }
        body,#bodyTable{
          background-color:#E1E1E1;
        }
        #emailHeader{
          background-color:#E1E1E1;
        }
        #emailBody{
          background-color:#FFFFFF;
        }
        #emailFooter{
          background-color:#33495f;
        }
        .textContent,.textContentLast{
          color:#8B8B8B;
          font-size:16px;
          line-height:125%;
          text-align:Left;
        }
        .textContent a,.textContentLast a{
          color:#205478;
          text-decoration:underline;
        }
        .nestedContainer{
          background-color:#F8F8F8;
          border:1px solid #CCCCCC;
        }
        .emailButton{
          background-color:#205478;
          border-collapse:separate;
        }
        .buttonContent{
          color:#FFFFFF;
          font-size:18px;
          font-weight:bold;
          line-height:100%;
          padding:15px;
          text-align:center;
        }
        
        .reschedule-btn-link {
          padding: 8px !important; 
          text-decoration: none; 
          align-items: center; 
          display: inline-grid; 
          font-size: 14px; 
          padding: 5px; 
          color: white; 
          border-radius: 4px; 
          background-color: rgb(32, 163, 69); 
          font-family: Roboto,RobotoDraft,Helvetica,Arial,sans-serif;
        }

        .buttonContent a{
          color:#FFFFFF;
          display:block;
          text-decoration:none!important;
          border:0!important;
        }
        .emailCalendar{
          background-color:#FFFFFF;
          border:1px solid #CCCCCC;
        }
        .emailCalendarMonth{
          background-color:#205478;
          color:#FFFFFF;
          font-family:Helvetica, Arial, sans-serif;
          font-size:16px;
          font-weight:bold;
          padding-top:10px;
          padding-bottom:10px;
          text-align:center;
        }
        .emailCalendarDay{
          color:#205478;
          font-family:Helvetica, Arial, sans-serif;
          font-size:60px;
          font-weight:bold;
          line-height:100%;
          padding-top:20px;
          padding-bottom:20px;
          text-align:center;
        }
        .imageContentText{
          margin-top:10px;
          line-height:0;
        }
        .imageContentText a{
          line-height:0;
        }
        .card_bottom {
          margin: -11% 2% 26% 2%;
        }
        #invisibleIntroduction{
          display:none !important;
        }
        span[class=ios-color-hack] a{
          color:#275100!important;
          text-decoration:none!important;
        }
        span[class=ios-color-hack2] a{
          color:#205478!important;
          text-decoration:none!important;
        }
        span[class=ios-color-hack3] a{
          color:#8B8B8B!important;
          text-decoration:none!important;
        }
        .a[href^=tel],a[href^=sms]{
          text-decoration:none!important;
          color:#606060!important;
          pointer-events:none!important;
          cursor:default!important;
        }
        .mobile_link a[href^=tel],.mobile_link a[href^=sms]{
          text-decoration:none!important;
          color:#606060!important;
          pointer-events:auto!important;
          cursor:default!important;
        }
        .cardStyle{
          -moz-box-shadow:    0 4px 8px 0 rgba(0, 0, 0, 0.5);
          -webkit-box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.5);
          box-shadow:         0 4px 8px 0 rgba(0, 0, 0, 0.5);
          border-style: solid;
          border-color: #f4f4f4;
        }

        @media only screen and (max-width: 1910px) {
          .howItWorks{
            margin-bottom: 45% !important;
          }
        }

        @media only screen and (max-width: 1445px) {
          .howItWorks{
            margin-bottom: 80% !important;
          }
        }

        @media only screen and (max-width: 1150px) {
          .howItWorks{
            margin-bottom: 90% !important;
          }
        }

        @media only screen and (max-width: 760px) {
          .howItWorks{
            height: 100% !important;
          }
          .cardMain{
            display: block !important;
          }
          .downloadApp {
            text-align: center !important;
            padding: 3% 0 5% !important;
          }
          .appImage {
            width: 31% !important;
          }
          .cardStyle {
            border-style: unset !important;
          }
          .textStyle {
            font-size: 17px;
            font-family:Helvetica, Arial, "Lucida Grande", sans-serif;
          }
        }
        
        @media only screen and (max-width: 480px){
          body{
            width:100% !important;
            min-width:100% !important;
          }
    
        }  
        @media only screen and (max-width: 480px){
          table[id=emailHeader],table[id=emailBody],table[id=emailFooter],table[class=flexibleContainer]{
            width:100% !important;
          }
    
        } 
        @media only screen and (max-width: 480px){
          td[class=flexibleContainerBox],td[class=flexibleContainerBox] table{
            display:block;
            width:100%;
            text-align:center !important;
          }
      
        } 
        @media only screen and (max-width: 480px){
          td[class=imageContent] img{
            height:auto !important;
            width:100% !important;
            max-width:100% !important;
          }
      
        } 
        @media only screen and (max-width: 480px){
          img[class=flexibleImage]{
            height:auto !important;
            width:100% !important;
            max-width:100% !important;
          }
      
        } 
        @media only screen and (max-width: 480px){
          img[class=flexibleImageSmall]{
            height:auto !important;
            width:auto !important;
          }
      
        } 
        @media only screen and (max-width: 480px){
          table[class=flexibleContainerBoxNext]{
            padding-top:10px !important;
          }
      
        } 
        @media only screen and (max-width: 480px){
          table[class=emailButton]{
            width:100% !important;
          }
      
        } @media only screen and (max-width: 480px){
          td[class=buttonContent]{
            padding:0 !important;
          }
      
        } 
        @media only screen and (max-width: 480px){
          td[class=buttonContent] a{
            padding:15px !important;
          }
        }
    %body{:bgcolor => "#E1E1E1", :leftmargin => "0", :marginheight => "0", :marginwidth => "0", :offset => "0", :topmargin => "0"}
      %center{:style => "background-color:#E1E1E1;"}
        %table#bodyTable{:border => "0", :cellpadding => "0", :cellspacing => "0", :height => "100%", :style => "table-layout: fixed;max-width:100% !important;width: 100% !important;min-width: 100% !important;", :width => "100%"}
          %tr
            %td#bodyCell{:align => "center", :valign => "top"}
              %table#emailHeader{:bgcolor => "#E1E1E1", :border => "0", :cellpadding => "0", :cellspacing => "0"}
                %tr
                  %td{:align => "center", :valign => "top"}
                    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                      %tr
                        %td{:align => "center", :valign => "top"}
                          %table.flexibleContainer{:border => "0", :cellspacing => "0", :width => "70%"}
                            %tr
                              %td.flexibleContainerCell{:valign => "top", :width => "70%"}
                                %table{:align => "left", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                  %tr
                                    %td#invisibleIntroduction.flexibleContainerBox{:align => "left", :style => "display:none !important;", :valign => "middle"}
                                      %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "max-width:100%;", :width => "100%"}
                                        %tr
                                          %td.textContent{:align => "left"}
                                            %div{:style => "font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#828282;text-align:center;line-height:120%;"}

              %table#emailBody{:bgcolor => "#FFFFFF", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "70%"}
                %tr
                  %td{:align => "center", :valign => "top"}
                    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF;", :width => "100%"}
                      %tr
                        %td{:align => "center", :valign => "top"}
                          %table.flexibleContainer{:border => "0", :cellpadding => "10", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                            %tr
                              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "70%"}
                                %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                                  %tr
                                    %td.textContent{:align => "center", :style => "padding: 8px 20px; background-color: #{@community.community_tour.tour_setting.email_header_color}", :valign => "top"}
                                      %h1{:style => "margin-bottom:0px;text-align:center;"}
                                        %div{:style => "width: 350px;display: inline-block;overflow: hidden;"}
                                          %img{:src => "#{@community.logo.url}", width: '150', :style => "max-width: 100%;height:auto;object-fit: contain;"}/ 
                %tr
                  %td{:align => "center", :valign => "top"}
                    %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#000000;", :width => "100%"}
                      %tr
                        %td{:align => "", :valign => "top"}
                          .divLoading.hidden
                          %section
                            .container{:style => "padding: 1% 5% 0;"}
                              = @email_body.html_safe 
                          %section.clearfix
                            .container.h-100.downloadApp{:style => "text-align: center;padding: 1% 0 1%"}
                              %a.appImage{:href => "#{@app_link}", :target => "_blank"}
                                -# %img{:src => "/assets/ios-store.png", width: '13%', :style => "margin-right: 20px", :class => "appImage"}/
                                = image_tag("ios-store.png", width: '13%', :style => "margin-right: 20px", :class => "appImage", alt: "IOS App Link")
                              %a.appImage{:href => "#{@android_link}", :target => "_blank"}
                                -# %img{:src => "/assets/android-store.png", width: '13%', :class => "appImage"}/
                                = image_tag("android-store.png", width: '13%', :class => "appImage", alt: "Android App Link")
                            -# = render 'shared/download_apps', obj: {ios_link: @app_link, android_link: @android_link }
                          %section.mt-15
                            %div.howItWorks{:style => "height: 375px; background: #008fd3;text-align: center; color: #fff; margin-bottom: 22%; padding-bottom: 3%;"}
                              %h2.headingStyle{:style => "font-size: 32px; padding-top: 2%;"}
                                %b How It Works
                              - if @property_tour_type == "remote_tour"
                                %p.textStyle{:style => "font-size: 18px;"}
                                  = SchedulerWidgetConstants::REMOTE_TOUR_TITLE
                              - elsif @property_tour_type == "unscheduled_self_tour"
                                %p.textStyle{:style => "font-size: 18px;"}
                                  = SchedulerWidgetConstants::UNSCHED_SELF_TOUR_TITLE
                                  %br/
                                  - if @community.community_tour.tour_setting.enable_restricted_property_access
                                    = SchedulerWidgetConstants::ACCESS_CODE_TEXT
                              - elsif @property_tour_type == "scheduled_tour" && @tour_type == "guided_tour"
                                %p.textStyle{:style => "font-size: 18px;"}
                                  Check-in at leasing center on the day your tour is scheduled within
                                  %b 10
                                  minutes of your scheduled time 
                                  %br/
                                  - if @community.community_tour.tour_setting.enable_restricted_property_access
                                    = SchedulerWidgetConstants::ACCESS_CODE_TEXT
                              - else
                                %p.textStyle{:style => "font-size: 18px;"}
                                  Be at the property on the day your tour is scheduled within
                                  %b 10
                                  minutes of your scheduled time
                                  %br/
                                  - if @community.community_tour.tour_setting.enable_restricted_property_access
                                    = SchedulerWidgetConstants::ACCESS_CODE_TEXT
                              .container.cardMain{:style => "display: flex; margin-top: 3%;margin-left: 2%;margin-right: 1%;"}
                                - @data.each do |i|
                                  .col-md-3{:style => "display: flex; flex-wrap: wrap; margin-right: 1%"}
                                    .card.cardStyle.mt-10.h-100{:style => "text-align: center;border-radius: 4%;margin-top: 10px;padding: 23px;background: #fff;"}
                                      %p{:style => "color: #000;"}
                                        %b= i[:key]
                                      = image_tag("#{i[:image]}", class: "card-style", style: "width: 50%; border-radius: 50%; background: #{i[:background]};", alt: "instruction card")
                                      .card-body.flex-fill
                                        %p.card-title.mt-10{:style => "color: #555555;margin-top: 10px;font-size: 16px;"}
                                          %b= (@property_tour_type == "unscheduled_self_tour" && !@id_verification && i[:key] == 2) || (@property_tour_type == "scheduled_tour" && @tour_type == "self_tour" && !@id_verification && i[:key] == 2) ? @unschedSelfTour[:title] : i[:title]
                                        %p.card-text{:style => "color: #555555;font-size: 14px;line-height: 1.42857143;"}
                                          = (@property_tour_type == "unscheduled_self_tour" && !@id_verification && i[:key] == 2) || (@property_tour_type == "scheduled_tour" && @tour_type == "self_tour" && !@id_verification && i[:key] == 2) ? @unschedSelfTour[:text] : i[:text]
              %table#emailFooter{:bgcolor => "#253339", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "70%"}
                %tr
                  %td
                    %table#templateBody{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "background-color: #{@community.community_tour.tour_setting.email_footer_color} ", :width => "100%"}
                      %tr
                        %td{:align => "center", :valign => "top"}
                          %table.templateContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "background-color: #{@community.community_tour.tour_setting.email_footer_color}", :width => ""}
                            %tr
                              %td.bodyContainer{:style => "padding-top:10px;", :valign => "top"}
                                %table.mcnTextBlock{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                  %tbody.mcnTextBlockOuter
                                    %tr
                                      %td.mcnTextBlockInner{:valign => "top"}
                                        %table.mcnTextContentContainer{:align => "center", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "70%"}
                                          %tbody
                                            %tr
                                              %td.mcnTextContent{:style => "padding-top:0px; padding-right: 18px; padding-bottom: 0px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                  = @community.name
                                            - if @community.address.present?
                                              %tr
                                                %td.mcnTextContent{:style => "padding-top:5px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                  %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                    = "#{@community.address}"
                                            - if @community.address.present?
                                              %tr
                                                %td.mcnTextContent{:style => "padding-top:0px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                  %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                    = "#{@community.city}, #{@community.state} #{@community.zip}"
                                            - if @community.phone.present?
                                              %tr
                                                %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                  %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                    = @community.phone
                                            - if @community.website.present?
                                              %tr
                                                %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF !important; text-align:center;", :valign => "top"}
                                                  %p{:style => "text-align:center; color:#FFFFFF !important; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                    %a{:href => "#{@community.website}", :style => "color:#FFF; text-decoration:none;"} #{@community.website}
                                                    -#= @community.website
                                            
                                            %tr
                                              %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 20px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                  © 2021 -
                                                  %a{:href => "http://pynwheeltouchscreens.com/", :style => "color:#FFF; text-decoration:none;"} Pynwheel.com
                                                  All rights reserved.
- else
  = @email_body.html_safe