
%header.main-header
  / Logo
  - if current_user.is_community_manager?
    %a.logo{:href => '#'}
      / mini logo for sidebar mini 50x50 pixels
      %span.logo-mini
        %img{:alt => "", :src => "/assets/logo-small.png", :title => ""}/
      / logo for regular state and mobile devices
      %span.logo-lg{:style => "text-align: left;"}
        %img{:alt => "", :src => "/assets/pynwheel_connect_logo_v2.png", :title => "",:style => "width: 265px; height: 60px; text-align: center;"}
        .col-lg-12{:style => "text-align: center;"}
          - unless (params[:controller] == "companies" && params[:action] == "index") || params[:controller] == "communities" && params[:action] == "index"  || params[:controller] == "communities" && params[:action] == "index"
            %span= current_company.name rescue ''
  - else
    %a.logo{:href => company_communities_path(current_company)}
      / mini logo for sidebar mini 50x50 pixels
      %span.logo-mini
        %img{:alt => "", :src => "/assets/logo-small.png", :title => ""}/
      / logo for regular state and mobile devices
      %span.logo-lg{:style => "text-align: left;"}
        %img{:alt => "", :src => "/assets/pynwheel_connect_logo_v2.png", :title => "",:style => "width: 265px; height: 60px;"}
        .col-lg-12{:style => "text-align: center;"}
          - unless (params[:controller] == "companies" && params[:action] == "index") || params[:controller] == "communities" && params[:action] == "index" || params[:controller] == "home" && params[:action] == "index"  || params[:controller] == "community_groups" && params[:action] == "index"
            %span= current_company.name rescue ''
  %nav.navbar.navbar-static-top{:style => "height: 81px;"}
    / Sidebar toggle button
    %a.sidebar-toggle{"data-toggle" => "push-menu", :href => "#", :role => "button"}
      %span.sr-only Toggle navigation
    .navbar-custom-menu
      - if user_signed_in?
        %ul.nav.navbar-nav
          - if current_community.present? and current_community.chat_control
            %li.mt-5
              %a.btn.mr-5.notification#widget-button{"data-name"=>"visitor", "data-target" => "#ChatSupport", "data-toggle" => "modal", "data-href" => "url", style: "background: #138fd4; color:white;  height: 34px;padding-top: 7px; border-radius: 4px;"}
                %span Chat Support
                %span#new_msgs.new_msgs.hidden
                  %i !
          %li.search-box.hidden
            / search form
            %form#sidebar-form.sidebar-form{:action => "#", :method => "get"}
              .input-group
                %input.form-control{:name => "q", :placeholder => "Search...", :type => "text"}/
                %span.input-group-btn
                  %button#search-btn.btn.btn-flat{:name => "search", :type => "submit"}
                    %i.fa.fa-search
            / /.search form
          - if current_user.is_super_admin? && current_community.present?
            %li.mt-5
              = link_to "Account Report" , community_account_report_path(current_community) , :class=>"btn mr-5", style: "background: #138fd4; color:white;  height: 34px;padding-top: 7px; border-radius: 4px;",:target => "_blank"
          %li.mt-5
            %input#publish_changes{:type => "button", :value => "How to Publish Changes" ,:class => "btn btn-primary"}/
          %li.hidden
            %a{"data-toggle" => "control-sidebar", :href => "#"}
              %i.fa.fa-gear
          %li.dropdown.user.user-menu
            %a.dropdown-toggle{"data-toggle" => "dropdown", :href => "#"}
              %img.user-image{:alt => "User Image", :src => current_user.avatar.present? ? current_user.avatar.url : "/assets/default-user128x128.jpg"}/
              %span.hidden-xs= current_user.name 
              %i.fa.fa-angle-down
            %ul.dropdown-menu
              / User image
              %li.user-header
                %img.img-circle{:alt => "User Image", :src => current_user.avatar.present? ? current_user.avatar.url : "/assets/default-user128x128.jpg"}/
                %p
                  = current_user.name 
                  %small Member since #{current_user.created_at.strftime("%b")}. #{current_user.created_at.strftime("%Y")}
              %li.user-footer
                .pull-left
                  - unless current_company.nil?
                    = link_to "Profile", company_employee_profile_path(current_company,current_user), :class=>"btn btn-default btn-flat"
                .pull-right
                  = link_to "Sign Out", destroy_user_session_path,:class=>"btn btn-default btn-flat",method: :delete