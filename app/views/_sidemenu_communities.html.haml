/ Start menu nav left Section
%aside.main-sidebar
  / sidebar: style can be found in sidebar.less
  %section.sidebar
    / Sidebar user panel
    %ul.sidebar-menu{"data-widget" => "tree",:style => "margin-top: 25px;"}
      %li.treeview{:class=>"#{accounts_dropdown_menu.include?(controller_name) ? 'active' : ''}"}
        %a{:href => "/"}
          %i.fa.fa-building-o
          %span All Accounts
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          - if (can? :crud, Company) || (current_user.is_super_admin? )
            %li{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
              %a{:href => "/companies"} Companies
          %li{:class=>"#{controller_name =='community_groups' ? 'active' : ''}"}
            - unless (current_user.is_dwelo_admin? || current_user.is_regional_admin?)
              %a{:href => "/companies/#{current_company.id}/community_groups"} Community Group
          - if (current_user.is_super_admin? || current_user.is_dwelo_admin?)
            %li{:class=>"#{controller_name =='regions' ? 'active' : ''}"}
              %a{:href => "/companies/#{current_company.id}/regions"} Region
          %li{:class=>"#{controller_name =='communities' ? 'active' : ''}"}
            = link_to "Communities",root_path
        - if current_user.is_admin?
          %li.loader_class{:class=>"#{controller_name =='analytics' && params[:action] =='index' ? 'active' : ''}"}
            = link_to analytics_path() do
              %i.fa.fa-bar-chart
              %span Analytics
          %li.treeview{:class=>"#{controller_name =='companies' ? 'active' : 'active'}"}
            %a{:href => "/"}
              %i.fa.fa-building
              %span Company
              %span.pull-right-container
                %i.fa.fa-angle-right.pull-right
            %ul.treeview-menu.property_map_intent_list{:style=>"#{controller_name =='companies'? 'display: block' : ''}"}
              %li.loader_class{:class=>"#{controller_name =='companies' && params[:action] == "edit"  ? 'active' : ''}"}
                %a{:href => "#{ edit_company_path(current_company)}"}
                  %i.fa.fa-info
                  %span Company Details
                  %span.pull-right-container

              %li.loader_class{:class=>"#{controller_name =='company_settings' &&  (params[:action] == 'edit' || params[:action] == 'new') ? 'active' : ''}"}
                %a{:href => "#{ current_company.company_setting.present? ? edit_company_company_setting_path(current_company, current_company.company_setting) : new_company_company_setting_path(current_company)}"}
                  %i.fa.fa-gears
                  %span Company Data
                  %span.pull-right-container
      - if (current_user.is_super_admin? || current_user.is_dwelo_admin? || current_user.is_company_admin? || current_user.is_regional_admin?)
        %li{:class=>"#{controller_name =='users' ? 'active' : ''}"}
          = link_to company_employees_path(current_company) do
            %i.fa.fa-user
            %span Users
      - if current_user.is_super_admin?
        %li{:class=>"#{controller_name =='svg_optimizer' && action_name == 'show' ? 'active' : ''}"}
          = link_to svg_optimizer_path do
            %i.fa.fa-compress
            %span SVG Optimizer
        %li{:class=>"#{controller_name =='svg_optimizer' && action_name != 'show' ? 'active' : ''}"}
          = link_to svg_optimizer_properties_path do
            %i.fa.fa-bolt
            %span SVG Optimize (Live)