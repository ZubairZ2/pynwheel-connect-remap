- content_for :title, "Save EdgeState - Pynwheel", class: "edgestate hide_edgestate"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span EdgeState Account
    .col-md-12

  .box-body
  .row
    .col-lg-9.col-lg-offset-1
      .col-sm-12.col-lg-3.col-md-3.col-xs-12
        %input{:name => "lock_authorization", :id => "client_credential_auth", :type => "radio", :value => "client credental", checked: EdgeState.active_client_credential_edgestate(current_community.edge_state) ? true : false}
        %label OAuth Client Credentials
      .col-sm-12.col-lg-3.col-md-3.col-xs-12
        %input{:name => "lock_authorization", :id => "code_grant_auth", :type => "radio", :value => "code grant", checked: EdgeState.active_code_grant_auth(current_community.edge_state) ? true : false}
        %label Authorization Code Grant
        
  .row.edgestate_auth_btn.mt-30
    .col-lg-9.col-lg-offset-1
      .col-sm-12.col-lg-12.col-md-12.col-xs-12.mb-20
        - if (current_community.edge_state && current_community.edge_state.refresh_token).present?        
          %p.pynwheel-authorized
            You have been authorized with EdgeState account registered under Pywheel (pynwheel.remotelock.com). 
            %a{:href => "https://pynwheel.remotelock.com/oauth/authorize?response_type=code&client_id=#{ENV['REMOTELOCK_CLIENT_ID']}&redirect_uri=#{ENV['REMOTELOCK_REDIRECT_URI']}", id: "pynwheel_auth"} 
              Click here to change account
          %p.connect-authorized
            You have been authorized with EdgeState account registered under RemoteLock (connect.remotelock.com). 
            %a{:href => "https://connect.remotelock.com/oauth/authorize?response_type=code&client_id=#{ENV['REMOTELOCK_CLIENT_ID']}&redirect_uri=#{ENV['REMOTELOCK_REDIRECT_URI']}", id: "connect_auth"} 
              Click here to change account
          = link_to "Remove Account" , remove_edgestate_auth_account_community_edgestate_accounts_path(current_community) , :method => :delete, :class=>"btn btn-danger", :style=> "background-color: #dd4b39d4;"
        - else
          %p
            This option allows you to authorize the lock without giving credentials, after selecting whether you signed up for EdgeState via RemoteLock or Pynwheel
          .row.mb-10
            -# .col-lg-9.col-lg-offset-1.mb-4
            .col-sm-12.col-lg-3.col-md-3.col-xs-12
              %input{:name => "auth_account", :id => "connect_auth_account", :type => "radio", :value => "connect authorization", checked: true}
                Signed up with Remotelock
            .col-sm-12.col-lg-3.col-md-3.col-xs-12
              %input{:name => "auth_account", :id => "pynwheel_auth_account", :type => "radio", :value => "pynwheel authorization"}
                Signed up with Pynwheel
          %a{:href => "https://pynwheel.remotelock.com/oauth/authorize?response_type=code&client_id=#{ENV['REMOTELOCK_CLIENT_ID']}&redirect_uri=#{ENV['REMOTELOCK_REDIRECT_URI']}", id: "code_grant_btn", class: "btn btn-primary pynwheel_acc"}
            Authorize
          %a{:href => "https://connect.remotelock.com/oauth/authorize?response_type=code&client_id=#{ENV['REMOTELOCK_CLIENT_ID']}&redirect_uri=#{ENV['REMOTELOCK_REDIRECT_URI']}", id: "code_grant_btn", class: "btn btn-primary connect_acc"}
            Authorize
          %p.mt-10.connect_account_note
            %strong NOTE: 
            You must have EdgeState account signed up via RemoteLock (connect.remotelock.com)
          %p.mt-10.pynwheel_account_note
            %strong NOTE: 
            You must have EdgeState account through Pynwheel (pynwheel.remotelock.com)
  
  = form_for :edgestate, :url=>community_edgestate_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal edgstate_auth_form"} do |f|
    = render :partial=>'edgestate_form', :locals=>{:f=>f}


  .igloohome-border

  = form_for :edgestate, :url=> add_lock_instructions_community_edgestate_accounts_path(current_community),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1
          .form-group{:style => "margin-bottom: 0px;"}
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Lock Instructions

            .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
              = f.text_area :lock_instruction_text, :class=>"form-control edgestate_lock_instruction_field edgestate_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.edge_state.present? ? @community.edge_state.lock_instruction_text : ""
              <!-- %span.edgestate_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

          .form-group.lock_img_background
            %span.btn.btn-primary.btn-file.ml-15
              %i.fa.fa-upload
              Upload File
              = file_field_tag :lock_image, :id => "edgestate-lock-image"

            .text-center.drag-box.mt-15.image-upload#edgestate-lock-upload-holder
              %span.icon-upload
                = image_tag "upload-image.png"
                %p Drag &amp; Drop file to Upload

            .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
              .select-logo-logo.logo-container.logo-upload-container

                - rn =  rand(9999999999999999999999999)
                - lock_image = @community.edge_state.present? ? @community.edge_state.lock_image : ""

                %a.preview-image{:href=> lock_image.present? ? lock_image  : asset_path("default.jpeg"), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                  = image_tag lock_image.present? ? lock_image : "default.jpeg",:height=>"100%",:width=>"100%",:id=>"edgestate-preview-image"
      .row
        .col-lg-9.col-lg-offset-1
          = f.submit "Save", :class=>"btn btn-success pull-right loader_class", :style => "padding: 10px 50px 10px 50px;"


.row#data-connection-buttons
  / Start Panel left Side
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title Test Data Connection
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to test connection settings in the data section.A new browser window will open and attempt to write the data feed output.
        = link_to "Test Connection" , test_edgestate_connection_community_edgestate_accounts_path(current_community) , :class=>"btn btn-primary",:target=>"_blank"
        %p{:style => "margin-bottom: -7px; margin-top: 10px;"}
          If the page that opens contains a bunch of data, it's probably good! If it contains one line that is an error message, then your data cannot be imported into Pynwheel. Please contact your data provider to troubleshoot.
    .row
      .col-md-6
        %h4.title Import Locks Data
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to import EdgeState lock data.
        .callout.callout-danger
          %p
            %i.fa.fa-warning
            This action will either import new, or update existing locks.
        .propertyDetailName{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
          %button.btn.btn-primary.impo#import_locks{:onclick => "import_edgestate_locks(#{@community.id})", :type => "button"} Import Locks Data
          - if @community.edge_state.present? and @community.edge_state.remote_locks.present?
            = link_to "Map Units" , map_edgestate_locks_community_edgestate_accounts_path(current_community) , :method => :post, :class=>"btn btn-success"
            = link_to "Delete all Existing Locks" , remove_edgestate_locks_community_edgestate_accounts_path(current_community) , :method => :delete, :class=>"btn btn-danger", :style=> "background-color: #dd4b39d4;"


:javascript
  $(document).ready(function () {
    if ($('#client_credential_auth')[0].checked == true) {
      $(".edgestate_auth_btn").hide()
    }
    else if ($('#code_grant_auth')[0].checked == true) {
      $(".edgstate_auth_form").hide()
    }
    else {
      $(".edgstate_auth_form").show()
      $(".edgestate_auth_btn").hide()
    }
    $('input[type=radio][name=lock_authorization]').change(function() {
    if (this.value == 'client credental') {
      $(".edgstate_auth_form").show()
      $(".edgestate_auth_btn").hide()
      }
    else if (this.value == 'code grant') {
      $(".edgstate_auth_form").hide()
      $(".edgestate_auth_btn").show()
      }
    });
    $(".pynwheel_account_note").hide()
    $(".pynwheel_acc").hide()
    $('input[type=radio][name=auth_account]').change(function(){
    if (this.value == 'connect authorization') {
      $(".connect_account_note").show()
      $(".pynwheel_account_note").hide()
      $(".pynwheel_acc").hide()
      $(".connect_acc").show()
    }
    else if (this.value == 'pynwheel authorization') {
      $(".connect_account_note").hide()
      $(".pynwheel_account_note").show()
      $(".pynwheel_acc").show()
      $(".connect_acc").hide()
    }
    });

    $(".pynwheel_acc").on("click", function() {
      localStorage.setItem("authorizedPynwheel", "pynwheel_authorized");
      localStorage.setItem("authorizedConnect", "");
    });

    $(".connect_acc").on("click", function() {
      localStorage.setItem("authorizedConnect", "connect_authorized");
      localStorage.setItem("authorizedPynwheel", "");
    });

    if (localStorage.getItem("authorizedPynwheel") == "pynwheel_authorized")
    {
      $(".pynwheel-authorized").show()
      $(".connect-authorized").hide()
    }
    else if (localStorage.getItem("authorizedConnect") == "connect_authorized") {
      $(".pynwheel-authorized").hide()
      $(".connect-authorized").show()
    }

  })
