- content_for :title, "Save EdgeState - Pynwheel", class: "edgestate hide_edgestate"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span EdgeState Account
    .col-md-12
    -#   = link_to "<Back to #{@unit_name} Unit", edit_community_unit_path(current_community,@unit_id), class: "btn btn-primary mt-10", style: "background: #8f4a9c; color: white;"
  / /.box-header
  / form start

  .box-body
  .row
    .col-lg-9.col-lg-offset-1
      .col-sm-12.col-lg-3.col-md-3.col-xs-12
        %input{:name => "lock_authorization", :id => "client_credential_auth", :type => "radio", :value => "client credental", checked: EdgeState.current_client_credential_edgestate(current_community.edge_state) ? true : false}
        %label Provide Client Credentials
      .col-sm-12.col-lg-3.col-md-3.col-xs-12
        %input{:name => "lock_authorization", :id => "code_grant_auth", :type => "radio", :value => "code grant", checked: (current_community.edge_state and current_community.edge_state.refresh_token && !current_community.edge_state.client_id and !current_community.edge_state.client_secret).present? ? true : false}
        %label Authorize With Pynwheel
        
  .row.edgestate_auth_btn.mt-30
    .col-lg-9.col-lg-offset-1
      .col-sm-12.col-lg-12.col-md-12.col-xs-12.mb-20
        - if (current_community.edge_state && current_community.edge_state.refresh_token).present?
          %p
            You have been authorized with pynwheel remote lock account. 
            %a{:href => "https://pynwheel.remotelock.com/oauth/authorize?response_type=code&client_id=#{ENV['REMOTELOCK_CLIENT_ID']}&redirect_uri=#{ENV['REMOTELOCK_REDIRECT_URI']}", id: "code_grant_btn"} 
              Click here to change account
          = link_to "Remove Account" , remove_edgestate_auth_account_community_edgestate_accounts_path(current_community) , :method => :delete, :class=>"btn btn-danger", :style=> "background-color: #dd4b39d4;"
        - else
          %p
            This option allows you to authorize the lock without giving credentials. Just click to authorize edgestate with pynwheel.
          %a{:href => "https://pynwheel.remotelock.com/oauth/authorize?response_type=code&client_id=#{ENV['REMOTELOCK_CLIENT_ID']}&redirect_uri=#{ENV['REMOTELOCK_REDIRECT_URI']}", id: "code_grant_btn", class: "btn btn-primary"}
            Authorize With Pynwheel
          %p{:style => "margin-bottom: -7px; margin-top: 10px;"}
            %strong NOTE: 
            You must have logged in EdgeState account under RemoteLock through Pynwheel (pynwheel.remotelock.com) to authorize pynwheel. 
  
  = form_for :edgestate, :url=>community_edgestate_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal edgstate_auth_form"} do |f|
    = render :partial=>'edgestate_form', :locals=>{:f=>f}

.row#data-connection-buttons
  / Start Panel left Side
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title Test Data Connection
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to test connection settings in the data section.A new browser window will open and attempt to write the data feed output.
        = link_to "Test Connection" , test_edgestate_connection_community_edgestate_accounts_path(current_community) , :class=>"btn btn-primary",:target=>"_blank"
        %p{:style => "margin-bottom: -7px; margin-top: 10px;"}
          If the page that opens contains a bunch of data, it's probably good! If it contains one line that is an error message, then your data cannot be imported into Pynwheel. Please contact your data provider to troubleshoot.
    .row
      .col-md-6
        %h4.title Import Locks Data
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to import EdgeState lock data.
        .callout.callout-danger
          %p
            %i.fa.fa-warning
            This action will either import new, or update existing locks.
        .propertyDetailName{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
          %button.btn.btn-primary.impo#import_locks{:onclick => "import_edgestate_locks(#{@community.id})", :type => "button"} Import Locks Data
          - if @community.edge_state.present? and @community.edge_state.remote_locks.present?
            = link_to "Map Units" , map_edgestate_locks_community_edgestate_accounts_path(current_community) , :method => :post, :class=>"btn btn-success"
            = link_to "Delete all Existing Locks" , remove_edgestate_locks_community_edgestate_accounts_path(current_community) , :method => :delete, :class=>"btn btn-danger", :style=> "background-color: #dd4b39d4;"


:javascript
  $(document).ready(function () {
    if ($('#client_credential_auth')[0].checked == true) {
      $(".edgestate_auth_btn").hide()
    }
    else if ($('#code_grant_auth')[0].checked == true) {
        $(".edgstate_auth_form").hide()
    }
    else {
      $(".edgstate_auth_form").show()
      $(".edgestate_auth_btn").hide()
    }
    $('input[type=radio][name=lock_authorization]').change(function() {
    if (this.value == 'client credental') {
      $(".edgstate_auth_form").show()
      $(".edgestate_auth_btn").hide()
      }
    else if (this.value == 'code grant') {
      $(".edgstate_auth_form").hide()
      $(".edgestate_auth_btn").show()
      }
    });
  })
