= form_for :igloohome, :url=> add_lock_instructions_community_igloohome_accounts_path(current_community),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        -# Amenity Lock Instruction & Image Uploader
        .lock-box-shadow
          .form-group{:style => "margin-bottom: 0px;"}
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Amenity Lock Instructions

            .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
              = f.text_area :amenity_lock_instruction_text, :class=>"form-control amenity_igloohome_lock_instruction_field amenity_igloohome_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.igloohome.present? ? @community.igloohome.amenity_lock_instruction_text : ""
              <!-- %span.amenity_igloohome_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

          .form-group.lock_img_background
            %span.btn.btn-primary.btn-file.ml-15
              %i.fa.fa-upload
              Upload File
              = file_field_tag :amenity_lock_image, :id => "amenity-igloohome-lock-image", :class => "amenity-igloohome-lock-image"

            .text-center.drag-box.mt-15.image-upload#amenity-igloohome-lock-upload-holder.amenity-igloohome-lock-upload-holder
              %span.icon-upload
                = image_tag "upload-image.png"
                %p Drag &amp; Drop file to Upload

            .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
              .select-logo-logo.logo-container.logo-upload-container

                - rn =  rand(9999999999999999999999999)
                - amenity_lock_image = @community&.igloohome&.amenity_lock_image&.url

                %a.preview-image{:href=> (amenity_lock_image || asset_path("default.jpeg")), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                  = image_tag (amenity_lock_image || "default.jpeg"),:height=>"100%",:width=>"100%",:id=>"amenity-igloohome-preview-image", :class=>"amenity-igloohome-preview-image"
        

    -# Unit Door Lock Instruction & Image Uploader
    .row
      .col-lg-9.col-lg-offset-1
        .lock-box-shadow
          .form-group{:style => "margin-bottom: 0px;"}
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Unit Door Lock Instructions

            .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
              = f.text_area :lock_instruction_text, :class=>"form-control igloohome_lock_instruction_field igloohome_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.igloohome.present? ? @community.igloohome.lock_instruction_text : ""
              <!-- %span.igloohome_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

          .form-group.lock_img_background
            %span.btn.btn-primary.btn-file.ml-15
              %i.fa.fa-upload
              Upload File
              = file_field_tag :lock_image, :id => "igloohome-lock-image", :class => "igloohome-lock-image"

            .text-center.drag-box.mt-15.image-upload#igloohome-lock-upload-holder.igloohome-lock-upload-holder
              %span.icon-upload
                = image_tag "upload-image.png"
                %p Drag &amp; Drop file to Upload

            .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
              .select-logo-logo.logo-container.logo-upload-container

                - rn =  rand(9999999999999999999999999)
                - lock_image = @community&.igloohome&.lock_image&.url

                %a.preview-image{:href=> (lock_image || asset_path("default.jpeg")), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                  = image_tag (lock_image || "default.jpeg"),:height=>"100%",:width=>"100%",:id=>"igloohome-preview-image", :class=>"igloohome-preview-image"
    .row
      .col-lg-9.col-lg-offset-1
        = f.submit "Save", :class=>"btn btn-success pull-right loader_class", :style => "padding: 10px 50px 10px 50px;"
