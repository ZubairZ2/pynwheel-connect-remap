= form_for :igloohome, url: community_igloohome_iglooworks_accounts_path(current_community), html: { class: "form-horizontal", multipart: true } do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            API Key
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            %input.form-control{name: "iglooworks_api_key", value: current_community&.igloohome&.iglooworks_api_key, placeholder: "API Key", type: "text", required: true}/

        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Department ID
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            %input.form-control{name: "iglooworks_department_id", value: current_community&.igloohome&.iglooworks_department_id, placeholder: "Department ID", type: "text", required: true}/

    .row
      .col-lg-9.col-lg-offset-1
        = f.submit "Save", class: "btn btn-success pull-right loader_class"
  
.igloohome-border
  = render :partial=>'dwelos/igloohomes/instructions_form'
  = render :partial=>'dwelos/igloohomes/iglooworks/test_connection_form'
