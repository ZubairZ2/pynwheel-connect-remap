= form_for :igloohome, :url=>community_igloohome_v2_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal igloohome_auth_form hide"} do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Client ID
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = f.text_field :client_id, :class=>"form-control validate[required]", :placeholder=>"Client id", :value=> @community.igloohome.present? ? @community.igloohome.client_id : ""
        
        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Client Secret
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = f.text_field :client_secret, :class=>"form-control validate[required]", :placeholder=>"Client Secret", :value=> @community.igloohome.present? ? @community.igloohome.client_secret : ""
          = f.hidden_field :community_id, :value=> current_community.id
    .row
      .col-lg-9.col-lg-offset-1
        - if current_community.igloohome.present? && current_community.igloohome.client_id.present? && current_community.igloohome.client_secret.present?
          = f.submit "Update Account", :class=>"btn btn-success pull-right loader_class"
        - else
          = f.submit "Save Account", :class=>"btn btn-success pull-right loader_class"