= form_for :igloohome, :url=>update_igloo_auth_toggle_community_igloohome_v2_accounts_path(current_community),:html=>{:class=>"form-horizontal authorization-form",  multipart: true} do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        .col-sm-12.col-lg-3.col-md-4.col-xs-12
          %input{:name => "is_authorized_with_pynwheel", :id => "code_grant_auth", :type => "radio", :value => "true", checked: current_community&.igloohome&.is_auth_code }
          %label Authorization Code Grant

        .col-sm-12.col-lg-3.col-md-6.col-xs-12
          %input{:name => "is_authorized_with_pynwheel", :id => "client_credential_auth", :type => "radio", :value => "false", checked: current_community&.igloohome&.is_client_auth }
          %label OAuth Client Credentials

= render :partial=>'dwelos/igloohomes/v2/auth_form'
= render :partial=>'dwelos/igloohomes/v2/credentials_form'

.igloohome-border
  = render :partial=>'dwelos/igloohomes/instructions_form'
  = render :partial=>'dwelos/igloohomes/v2/test_connection_form'

:javascript
  var isAuthCodeFlow = "#{current_community&.igloohome&.is_auth_code}";
  var isClientCredentialsFlow = "#{current_community&.igloohome&.is_client_auth}";

  $(document).ready(function () {
    if (isAuthCodeFlow === "true")
      showAuthFlow();
    else if (isClientCredentialsFlow === "true")
      credentialsFlow();

    $('input[type=radio][name=is_authorized_with_pynwheel]').change(function() {
      if(this.value === "false")
        credentialsFlow();
      else if (this.value === "true")
        showAuthFlow();

      $(".authorization-form").submit();
    });
  });

  function showAuthFlow(){
    $(".igloohome_auth_form").addClass("hide");
    $(".igloohome_auth_btn").removeClass("hide");
  }

  function credentialsFlow() {
    $(".igloohome_auth_form").removeClass("hide");
    $(".igloohome_auth_btn").addClass("hide");
  }
