= form_for :igloohome, :url=>update_igloo_home_name_community_igloohome_v2_accounts_path(current_community),:html=>{:class=>"form-horizontal igloohome-name-form",  multipart: true} do |f|
  .row
    .col-lg-9.col-lg-offset-1
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
        Home Name
      .col-sm-12.col-lg-9.col-md-9.col-xs-12
        = f.text_field :home_name, :class=>"form-control validate[required]", :placeholder=>"Home name", :value=> @community.igloohome.present? ? @community.igloohome.home_name : ""

:javascript
  $(document).ready(function () {
    $('#igloohome_home_name').change(function(){
      $(".igloohome-name-form").submit();
    });
  });
