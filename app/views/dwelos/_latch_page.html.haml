- content_for :title, "Save Latch - Pynwheel", class: "latch hide_latch"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span Latch Account
  = form_for :latch, :url=>community_latch_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1          
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Building Name
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :latch_property_name, :class=>"form-control validate[required]", :placeholder=>"Latch Property Name", :value=> @community.latch.present? ? @community.latch.latch_property_name : ""
          
          -# Amenity Lock Instruction & Image Uploader
          .lock-box-shadow
            .form-group{:style => "margin-bottom: 0px;"}
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Amenity Lock Instructions

              .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                = f.text_area :amenity_lock_instruction_text, :class=>"form-control amenity_latch_lock_instruction_field amenity_latch_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.latch.present? ? @community.latch.amenity_lock_instruction_text : LATCH_LOCK_INSTRUCTION_TEXT
                <!-- %span.latch_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

            .form-group.lock_img_background
              %span.btn.btn-primary.btn-file.ml-15
                %i.fa.fa-upload
                Upload File
                = file_field_tag :amenity_lock_image, :id => "amenity-latch-lock-image"

              .text-center.drag-box.mt-15.image-upload#amenity-latch-lock-upload-holder
                %span.icon-upload
                  = image_tag "upload-image.png"
                  %p Drag &amp; Drop file to Upload

              .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
                .select-logo-logo.logo-container.logo-upload-container

                  - rn =  rand(9999999999999999999999999)
                  - amenity_lock_image = @community.latch.present? ? @community.latch.amenity_lock_image : ""

                  %a.preview-image{:href=> amenity_lock_image.present? ? amenity_lock_image  : asset_path("latch-lock-image.png"), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                    = image_tag amenity_lock_image.present? ? amenity_lock_image : "latch-lock-image.png",:height=>"100%",:width=>"100%",:id=>"amenity-latch-preview-image"

          -# Unit Door Lock Instruction & Image Uploader
          .lock-box-shadow
            .form-group{:style => "margin-bottom: 0px;"}
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Unit Door Lock Instructions

              .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                = f.text_area :lock_instruction_text, :class=>"form-control latch_lock_instruction_field latch_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.latch.present? ? @community.latch.lock_instruction_text : LATCH_LOCK_INSTRUCTION_TEXT
                <!-- %span.latch_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

            .form-group.lock_img_background
              %span.btn.btn-primary.btn-file.ml-15
                %i.fa.fa-upload
                Upload File
                = file_field_tag :lock_image, :id => "latch-lock-image"

              .text-center.drag-box.mt-15.image-upload#latch-lock-upload-holder
                %span.icon-upload
                  = image_tag "upload-image.png"
                  %p Drag &amp; Drop file to Upload

              .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
                .select-logo-logo.logo-container.logo-upload-container

                  - rn =  rand(9999999999999999999999999)
                  - lock_image = @community.latch.present? ? @community.latch.lock_image : ""

                  %a.preview-image{:href=> lock_image.present? ? lock_image  : asset_path("latch-lock-image.png"), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                    = image_tag lock_image.present? ? lock_image : "latch-lock-image.png",:height=>"100%",:width=>"100%",:id=>"latch-preview-image"

    
    .box-footer
      - if current_community.latch.present?
        = f.submit "Update Account", :class=>"btn btn-success pull-right loader_class"
      - else
        = f.submit "Save Account", :class=>"btn btn-success pull-right loader_class"

.row#data-connection-buttons
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title Test Data Connection
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to test connection settings in the data section. A new browser window will open and attempt to write the data feed output.
        = link_to "Test Connection" , test_latch_connection_community_latch_accounts_path(current_community) , :class=>"btn btn-primary",:target=>"_blank"
        %p{:style => "margin-bottom: -7px; margin-top: 10px;"}
          If the page that opens contains a bunch of data, it's probably good! Otherwise you will get the alert message that, Data cannot be imported. Please check the credentails or contact your data provider to troubleshoot.
    .row
      .col-md-6
        %h4.title Import Locks Data
        
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to import latch lock data.
        .callout.callout-danger
          %p
            %i.fa.fa-warning
            This action will either import new, or update existing, Latch lock records, based on community.

        .propertyDetailName{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
          = link_to "Import Locks Data" , import_latch_locks_community_latch_accounts_path(community_id: current_community) , :method => :post, :class=>"btn btn-primary"

          - if @community.latch.present? and @community.latch.latch_locks.present?
            = link_to "Map Units" , map_latch_locks_community_latch_accounts_path(current_community) , :method => :post, :class=>"btn btn-success"
            = link_to "Delete all Existing Locks" , remove_latch_locks_community_latch_accounts_path(current_community) , :method => :delete, :class=>"btn btn-danger", :style=> "background-color: #dd4b39d4;"