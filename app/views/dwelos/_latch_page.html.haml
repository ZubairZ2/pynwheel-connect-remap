- content_for :title, "Save Latch - Pynwheel", class: "latch hide_latch"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span Latch Account
  = form_for :latch, :url=>community_latch_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Client ID
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :client_id, :class=>"form-control validate[required]", :placeholder=>"Client id", :value=> @community.latch.present? ? @community.latch.client_id : ""
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Client Secret
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :client_secret, :class=>"form-control validate[required]", :placeholder=>"Client Secret", :value=> @community.latch.present? ? @community.latch.client_secret : ""
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Upload CSV File
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = file_field_tag 'file'
            = f.hidden_field :community_id, :value=> current_community.id

          .form-group{:style => "margin-bottom: 0px;"}
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Lock Instructions

            .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
              = f.text_area :lock_instruction_text, :class=>"form-control latch_lock_instruction_field latch_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.latch.present? ? @community.latch.lock_instruction_text : ""
              %span.latch_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 200

          .form-group.lock_img_background
            %span.btn.btn-primary.btn-file.ml-15
              %i.fa.fa-upload
              Upload File
              = file_field_tag :lock_image, :id => "latch-lock-image"

            .text-center.drag-box.mt-15.image-upload#latch-lock-upload-holder
              %span.icon-upload
                = image_tag "upload-image.png"
                %p Drag &amp; Drop file to Upload

            .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
              .select-logo-logo.logo-container.logo-upload-container

                - rn =  rand(9999999999999999999999999)
                - lock_image = @community.zerv.present? ? @community.latch.lock_image : ""

                %a.preview-image{:href=> lock_image.present? ? lock_image  : asset_path("default.jpeg"), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                  = image_tag lock_image.present? ? lock_image : "default.jpeg",:height=>"100%",:width=>"100%",:id=>"latch-preview-image"
                  -# = image_tag "exclamation-mark.png", class: "waring_exal", style: "width: 25px", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"

            -# - if lock_image.present?
            -#   .row{:style => "padding-left: 47%;"}
            -#     = link_to show_lock_image_in_modal_community_latch_accounts_path(),:class => "", remote: true do
            -#       %span.btn.btn-primary.btn-success.ml-15{"data-target" => "#edit-name", "data-toggle" => "modal"}
            -#         Crop

    / /.box-body
    .box-footer
      - if current_community.latch.present?
        = f.submit "Update Account", :class=>"btn btn-success pull-right loader_class"
      - else
        = f.submit "Save Account", :class=>"btn btn-success pull-right loader_class"
      - if @community.latch.present?
        = link_to "Delete all Existing Locks" , remove_latch_locks_community_latch_accounts_path(current_community) , :class=>"btn btn-danger", :method => :delete, :style=> "background-color: #dd4b39d4;"