- content_for :title, "Save Zerv - Pynwheel", class: "zerv hide_zerv"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span Zerv Account
  = form_for :zerv, :url=>community_zerv_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal"} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Username
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :username, :class=>"form-control validate[required]", :placeholder=>"user name", :value=> @community.zerv.present? ? @community.zerv.username : ""
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Password
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :password, :class=>"form-control validate[required]", :placeholder=>"password", :value=> @community.zerv.present? ? @community.zerv.password : ""
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Facility ID
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.number_field :facility_id, :min => "0", :max => "255", :class=>"form-control", :placeholder=>"facility id", :value=> @community.zerv.present? ? @community.zerv.facility_id : ""
              %span{:style => "color: #9ea2a5;"} FacilityId should be in range of 0 to 255
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Badge ID
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.number_field :badge_id, :min => "0", :max => "65535", :class=>"form-control", :placeholder=>"badge id", :value=> @community.zerv.present? ? @community.zerv.badge_id : ""
              %span{:style => "color: #9ea2a5;"} BadgeId should be in range of 0 to 65535
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Card Format
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              - card_format_seleted = @community.zerv.present? ? @community.zerv.card_format : ""
              = f.select :card_format , options_for_select(cards_formats, card_format_seleted),{:include_blank => 'Choose Card'},{:class=>"form-control"}
            = f.hidden_field :community_id, :value=> current_community.id
    / /.box-body
    .box-footer
      - if current_community.zerv.present?
        = f.submit "Update Account", :class=>"btn btn-success pull-right loader_class"
      - else
        = f.submit "Save Account", :class=>"btn btn-success pull-right loader_class"

.row#data-connection-buttons
  / Start Panel left Side
  .col-lg-12.col-md-12
    .row
      .col-md-6
        %h4.title Test Data Connection
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to test connection settings in the data section.A new browser window will open and attempt to write the data feed output.
        = link_to "Test Connection" , test_zerv_connection_community_zerv_accounts_path(current_community) , :class=>"btn btn-primary",:target=>"_blank"
        %p{:style => "margin-bottom: -7px; margin-top: 10px;"}
          If the page that opens contains a bunch of data, it's probably good! If it contains one line that is an error message, then your data cannot be imported into Pynwheel. Please contact your data provider to troubleshoot.
    .row
      .col-md-6
        %h4.title Import Locks Data
    .box.box-widget.panel-box.pl-20.pr-20.pb-20
      .box-header
        %p
          This option allows you to import  Pynwheel Access (zerv) locks data.
        .callout.callout-danger
          %p
            %i.fa.fa-warning
            This action will either import new, or update existing locks.
        .propertyDetailName{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
          = link_to "Import Locks Data" , import_zerv_locks_community_zerv_accounts_path(current_community) , :method => :post, :class=>"btn btn-primary"

          -# - if @community.zerv.present? and @community.zerv.zerv_locks.present?
          = link_to "Map Units" , map_zerv_locks_community_zerv_accounts_path(current_community) , :method => :post, :class=>"btn btn-success"
          = link_to "Delete all Existing Locks" , remove_zerv_locks_community_zerv_accounts_path(current_community) , :method => :delete, :class=>"btn btn-danger", :style=> "background-color: #dd4b39d4;"