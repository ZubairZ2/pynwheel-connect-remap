- content_for :title, "Edit Dwelo Account - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Edit
          %span Dwelo Account
      = form_for @dwelo_user,url: community_dwelo_path(@community,@dwelo_user),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  API URL
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :api_url, :class=>"form-control dwelo_api_url", :placeholder=>"API URL", :required => true
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Client ID
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :client_id, :class=>"form-control dwelo_client_id", :placeholder=>"Client ID", :required => true

              .form-group#unit_virtual_tour_button_label_field
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Client Secret
                .col-sm-12.col-lg-9.col-md-9.col-xs-12

                  = f.text_field :client_secret, :class=>"form-control", :placeholder=>"Client Secret", :required => true

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Community ID
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :default_community_id, :class=>"form-control", :placeholder=>"Dwelo community ID", :required => true


          .box-footer
            = link_to "CANCEL", new_community_dwelo_path, :class=>"btn btn-default pull-right"
            = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right"