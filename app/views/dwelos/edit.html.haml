- content_for :title, "Edit Dwelo Account - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Edit
          %span Dwelo Account
      = form_for @dwelo_user,url: community_dwelo_path(@community,@dwelo_user),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  API URL
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :api_url, :class=>"form-control dwelo_api_url", :placeholder=>"API URL", :required => true
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Client ID
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :client_id, :class=>"form-control dwelo_client_id", :placeholder=>"Client ID", :required => true    

              .form-group#unit_virtual_tour_button_label_field
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Client Secret
                .col-sm-12.col-lg-9.col-md-9.col-xs-12

                  = f.text_field :client_secret, :class=>"form-control", :placeholder=>"Client Secret", :required => true

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Community ID
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :default_community_id, :class=>"form-control", :placeholder=>"Dwelo community ID", :required => true

              -# Amenity Lock Instruction & Image Uploader
              .lock-box-shadow
                .form-group{:style => "margin-bottom: 0px;"}
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Amenity Lock Instructions

                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :amenity_lock_instruction_text, :class=>"form-control amenity_dwelo_lock_instruction_field amenity_dwelo_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.dwelo.present? ? @community.dwelo.amenity_lock_instruction_text : ""
                    <!-- %span.amenity_dwelo_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

                .form-group.lock_img_background.theme-setting
                  %span.btn.btn-primary.btn-file.ml-15
                    %i.fa.fa-upload
                    Upload File
                    = file_field_tag :amenity_lock_image, :id => "amenity-dwelo-lock-image"

                  .text-center.drag-box.mt-15.image-upload#amenity-dwelo-lock-upload-holder
                    %span.icon-upload
                      = image_tag "upload-image.png"
                      %p Drag &amp; Drop file to Upload

                  .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
                    .select-logo-logo.logo-container.logo-upload-container

                      - rn =  rand(9999999999999999999999999)
                      - amenity_lock_image = @community&.dwelo&.amenity_lock_image&.url

                      %a.preview-image{:href=> (amenity_lock_image || asset_path("default.jpeg")), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                        = image_tag (amenity_lock_image || "default.jpeg"),:height=>"100%",:width=>"100%",:id=>"amenity-dwelo-preview-image"
              
              -# Unit Door Lock Instruction & Image Uploader
              .lock-box-shadow
                .form-group{:style => "margin-bottom: 0px;"}
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Unit Door Lock Instructions

                  .col-sm-12.col-lg-9.col-md-9.col-xs-12{:style => "margin-bottom: inherit;"}
                    = f.text_area :lock_instruction_text, :class=>"form-control dwelo_lock_instruction_field dwelo_lock_instruction_wysihtml5", :placeholder=>"Lock Instructions",  :value=> @community.dwelo.present? ? @community.dwelo.lock_instruction_text : ""
                    <!-- %span.dwelo_lock_instruction_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: 275 -->

                .form-group.lock_img_background.theme-setting
                  %span.btn.btn-primary.btn-file.ml-15
                    %i.fa.fa-upload
                    Upload File
                    = file_field_tag :lock_image, :id => "dwelo-lock-image"

                  .text-center.drag-box.mt-15.image-upload#dwelo-lock-upload-holder
                    %span.icon-upload
                      = image_tag "upload-image.png"
                      %p Drag &amp; Drop file to Upload

                  .select-logo.center-img.mb-20.mt-30.logo-upload-bg{:style => "border: 2px solid #ddd; margin-bottom: 30px"}
                    .select-logo-logo.logo-container.logo-upload-container

                      - rn =  rand(9999999999999999999999999)
                      - lock_image =@community&.dwelo&.lock_image&.url

                      %a.preview-image{:href=> (lock_image || asset_path("default.jpeg")), "data-toggle"=>"lightbox","data-title"=>"Lock Image"}
                        = image_tag (lock_image || "default.jpeg"),:height=>"100%",:width=>"100%",:id=>"dwelo-preview-image"


          .box-footer
            = link_to "CANCEL", new_community_dwelo_path, :class=>"btn btn-default pull-right"
            = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right"

#communityLock{data: {community_id: @community&.id}}