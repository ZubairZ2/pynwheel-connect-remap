%section{style: "margin-top: -45px"}
  .content
    .title-heading.mb-25
      = hidden_field_tag "is_dwelo", "#{@community.creator_id.present? and @community.creator.present? and @community.creator.role == 'Dwelo admin'}"
      %h4
        %i.fa.fa-laptop
        = @community.name.capitalize
        - if @community.creator_id.present? and @community.creator.present? and @community.creator.role == "Dwelo admin"
          .box-info.add-plan
            %img.dwelo-logo{style: "margin-top: -30px;" , :alt => "Smiley face", :src => "/assets/Dwelo-Logo.png"}
    .box.box-info
      .box-header
        = render :partial=>'locks'

#communityLock{data: {community_id: @community&.id}}

:javascript
  function import_dwelo_locks(community_dwelo_id){
    var community_id = #{@community.id}
    $.ajax({
      type: 'POST',
      url: '/api/v1/save_data',
      data: {dwelo_account_id: community_dwelo_id, community_id: community_id},
      success: function (data) {}
    });
  }

  function import_edgestate_locks(community_id){
    $.ajax({
      type: 'POST',
      url: '/communities/'+ community_id + '/edgestate_accounts/import_edgestate_locks',
      cache: false,
      success: function (data) {}
    });
  }