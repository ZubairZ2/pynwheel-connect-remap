%section.zerv.hide_zerv{style: "margin-top: -45px"}
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-laptop
        = @community.name.capitalize
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Create
          %span Zerv Account
      = form_for :latch, :url=>community_latch_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
