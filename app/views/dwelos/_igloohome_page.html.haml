- content_for :title, "Save IglooHome - Pynwheel", class: "igloohome hide_igloohome"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span Igloo Home Account
  = form_for :igloohome, :url=> community_igloohome_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Username
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :username, :class=>"form-control validate[required]", :placeholder=>"Username", :value=> @community.igloohome.present? ? @community.igloohome.username : ""
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Password
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = f.text_field :password, :class=>"form-control validate[required]", :placeholder=>"Password", :value=> @community.igloohome.present? ? @community.igloohome.password : ""
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Upload CSV File
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = file_field_tag 'file'
            = f.hidden_field :community_id, :value=> current_community.id
    / /.box-body
    .box-footer
      - if current_community.igloohome.present?
        = f.submit "Update Account", :class=>"btn btn-success pull-right loader_class"
      - else
        = f.submit "Save Account", :class=>"btn btn-success pull-right loader_class"
      - if @community.igloohome.present?
        = link_to "Delete all Existing Locks" , remove_igloohome_locks_community_igloohome_accounts_path(current_community) , :class=>"btn btn-danger", :method => :delete, :style=> "background-color: #dd4b39d4;"
