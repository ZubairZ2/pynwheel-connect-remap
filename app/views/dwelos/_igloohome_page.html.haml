- content_for :title, "Save IglooHome - Pynwheel", class: "igloohome hide_igloohome"
.box.box-info.add-plan
  .box-header
    %h3.box-title
      Create
      %span Igloo Home Account

  -# Form for adding single igloohome lock 
  = form_for :igloohome, :url=> import_single_lock_community_igloohome_accounts_path(current_community),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1
          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Device Name
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              %input.form-control{:name => "device_name", :placeholder => "Device Name e.g Pool, 101 etc", :type => "text"}/
          
          .form-group.remove_margin_igloohome
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Device ID
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              %input.form-control{:name => "device_id", :placeholder => "Unique Lock ID", :type => "text"}/
      .row
        .col-lg-9.col-lg-offset-1
          = f.submit "Add Lock", :class=>"btn btn-success pull-right loader_class"

  .igloohome-border
  
  -# Form for adding multiple igloohome lock 
  = form_for :igloohome, :url=> community_igloohome_accounts_path(:community_id=>current_community.id),:html=>{:class=>"form-horizontal",  multipart: true} do |f|
    .box-body
      .row
        .col-lg-9.col-lg-offset-1
          .form-group.remove_margin_igloohome
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Upload CSV File
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = file_field_tag 'file'
            = f.hidden_field :community_id, :value=> current_community.id
      .row
        .col-lg-9.col-lg-offset-1
          = f.submit "Add Locks", :class=>"btn btn-success pull-right loader_class"
    .box-footer
      - if current_community.igloohome.present?
        = link_to "Delete all Existing Locks" , remove_igloohome_locks_community_igloohome_accounts_path(current_community) , :class=>"btn btn-danger", :method => :delete, :style=> "background-color: #dd4b39d4;"