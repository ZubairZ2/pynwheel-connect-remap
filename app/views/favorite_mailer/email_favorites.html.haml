!!! Strict
%html{:xmlns => "http://www.w3.org/1999/xhtml"}
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:content => "width=device-width, initial-scale=1.0", :name => "viewport"}/
    %meta{:content => "IE=edge,chrome=1", "http-equiv" => "X-UA-Compatible"}/
    %meta{:content => "telephone=no", :name => "format-detection"}/
    / disable auto telephone linking in iOS
    / %title Welcome
    :css
      body,#bodyTable,#bodyCell,#bodyCell{
           height:100% !important;
           margin:0;
           padding:0;
           width:100% !important;
           font-family:Helvetica, Arial, "Lucida Grande", sans-serif;
         }
         table{
           border-collapse:collapse;
         }
         table[id=bodyTable]{
           width:100%!important;
           margin:auto;
           max-width:620px!important;
           color:#7A7A7A;
           font-weight:normal;
         }
         img,a img{
           border:0;
           outline:none;
           text-decoration:none;
           height:auto;
           line-height:100%;
         }
         a{
           text-decoration:none !important;
           border-bottom:1px solid;
         }
         h1,h2,h3,h4,h5,h6{
           color:#5F5F5F;
           font-weight:normal;
           font-family:Helvetica;
           font-size:20px;
           line-height:125%;
           text-align:Left;
           letter-spacing:normal;
           margin-top:0;
           margin-right:0;
           margin-bottom:10px;
           margin-left:0;
           padding-top:0;
           padding-bottom:0;
           padding-left:0;
           padding-right:0;
         }
         .ReadMsgBody{
           width:100%;
         }
         .ExternalClass{
           width:100%;
         }
         .ExternalClass,.ExternalClass p,.ExternalClass span,.ExternalClass font,.ExternalClass td,.ExternalClass div{
           line-height:100%;
         }
         table,td{
           mso-table-lspace:0pt;
           mso-table-rspace:0pt;
         }
         img{
           -ms-interpolation-mode:bicubic;
           display:block;
           outline:none;
           text-decoration:none;
         }
         body,table,td,p,a,li,blockquote{
           -ms-text-size-adjust:100%;
           -webkit-text-size-adjust:100%;
           font-weight:normal!important;
         }
         .ExternalClass td[class=ecxflexibleContainerBox] h3{
           padding-top:10px !important;
         }
         h1{
           display:block;
           font-size:26px;
           font-style:normal;
           font-weight:normal;
           line-height:100%;
         }
         h2{
           display:block;
           font-size:20px;
           font-style:normal;
           font-weight:normal;
           line-height:120%;
         }
         h3{
           display:block;
           font-size:17px;
           font-style:normal;
           font-weight:normal;
           line-height:110%;
         }
         h4{
           display:block;
           font-size:18px;
           font-style:italic;
           font-weight:normal;
           line-height:100%;
         }
         .flexibleImage{
           height:auto;
         }
         .video-wrapper {display:none;}
         @media (-webkit-min-device-pixel-ratio: 0) and (min-device-width:1024px) 
         {
          .video-wrapper { display:block!important; }
          .video-fallback { display:none!important; }
         }
          @supports (-webkit-overflow-scrolling:touch) and (color:#ffffffff) {
            div[class^=video-wrapper] { display:block!important; }
            div[class^=video-fallback] { display:none!important; }
          }
          #MessageViewBody .video-wrapper { display:block!important; }
          #MessageViewBody .video-fallback { display:none!important; }
         .linkRemoveBorder{
           border-bottom:0 !important;
         }
         table[class=flexibleContainerCellDivider]{
           padding-bottom:0 !important;
           padding-top:0 !important;
         }
         body,#bodyTable{
           background-color:#E1E1E1;
         }
         #emailHeader{
           background-color:#E1E1E1;
         }
         #emailBody{
           background-color:#FFFFFF;
         }
         #emailFooter{
           background-color:#33495f;
         }
         .textContent,.textContentLast{
           color:#8B8B8B;
           font-family:Helvetica;
           font-size:16px;
           line-height:125%;
           text-align:Left;
         }
         .textContent a,.textContentLast a{
           color:#205478;
           text-decoration:underline;
         }
         .nestedContainer{
           background-color:#F8F8F8;
           border:1px solid #CCCCCC;
         }
         .emailButton{
           background-color:#205478;
           border-collapse:separate;
         }
         .buttonContent{
           color:#FFFFFF;
           font-family:Helvetica;
           font-size:18px;
           font-weight:bold;
           line-height:100%;
           padding:15px;
           text-align:center;
         }
         .buttonContent a{
           color:#FFFFFF;
           display:block;
           text-decoration:none!important;
           border:0!important;
         }
         .emailCalendar{
           background-color:#FFFFFF;
           border:1px solid #CCCCCC;
         }
         .emailCalendarMonth{
           background-color:#205478;
           color:#FFFFFF;
           font-family:Helvetica, Arial, sans-serif;
           font-size:16px;
           font-weight:bold;
           padding-top:10px;
           padding-bottom:10px;
           text-align:center;
         }
         .emailCalendarDay{
           color:#205478;
           font-family:Helvetica, Arial, sans-serif;
           font-size:60px;
           font-weight:bold;
           line-height:100%;
           padding-top:20px;
           padding-bottom:20px;
           text-align:center;
         }
         .imageContentText{
           margin-top:10px;
           line-height:0;
         }
         .imageContentText a{
           line-height:0;
         }
         #invisibleIntroduction{
           display:none !important;
         }
         span[class=ios-color-hack] a{
           color:#275100!important;
           text-decoration:none!important;
         }
         span[class=ios-color-hack2] a{
           color:#205478!important;
           text-decoration:none!important;
         }
         span[class=ios-color-hack3] a{
           color:#8B8B8B!important;
           text-decoration:none!important;
         }
         .a[href^=tel],a[href^=sms]{
           text-decoration:none!important;
           color:#606060!important;
           pointer-events:none!important;
           cursor:default!important;
         }
         .mobile_link a[href^=tel],.mobile_link a[href^=sms]{
           text-decoration:none!important;
           color:#606060!important;
           pointer-events:auto!important;
           cursor:default!important;
         }
         @media only screen and (max-width: 480px){
          body{
           width:100% !important;
           min-width:100% !important;
         }
      
       }	
         @media only screen and (max-width: 480px){
          table[id=emailHeader],table[id=emailBody],table[id=emailFooter],table[class=flexibleContainer]{
           width:100% !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          td[class=flexibleContainerBox],td[class=flexibleContainerBox] table{
           display:block;
           width:100%;
           text-align:center !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          td[class=imageContent] img{
           height:auto !important;
           width:100% !important;
           max-width:100% !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          img[class=flexibleImage]{
           height:auto !important;
           width:100% !important;
           max-width:100% !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          img[class=flexibleImageSmall]{
           height:auto !important;
           width:auto !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          table[class=flexibleContainerBoxNext]{
           padding-top:10px !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          table[class=emailButton]{
           width:100% !important;
         }
      
        }	@media only screen and (max-width: 480px){
          td[class=buttonContent]{
           padding:0 !important;
         }
      
        }	
        @media only screen and (max-width: 480px){
          td[class=buttonContent] a{
           padding:15px !important;
         }
      }
  %body{:bgcolor => "#E1E1E1", :leftmargin => "0", :marginheight => "0", :marginwidth => "0", :offset => "0", :topmargin => "0"}
    %p
      -#= raw(@community.design.ebrochure_email_message.gsub("<community_name>",@community.name).gsub("\n","<br>"))
    %center{:style => "background-color:#E1E1E1;"}
      %table#bodyTable{:border => "0", :cellpadding => "0", :cellspacing => "0", :height => "100%", :style => "table-layout: fixed;max-width:100% !important;width: 100% !important;min-width: 100% !important;", :width => "100%"}
        %tr
          %td#bodyCell{:align => "center", :valign => "top"}
            %table#emailHeader{:bgcolor => "#E1E1E1", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
              %tr
                %td{:align => "center", :valign => "top"}
                  %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %table.flexibleContainer{:border => "0", :cellpadding => "10", :cellspacing => "0", :width => "620"}
                          %tr
                            %td.flexibleContainerCell{:valign => "top", :width => "620"}
                              %table{:align => "left", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                %tr
                                  %td#invisibleIntroduction.flexibleContainerBox{:align => "left", :style => "display:none !important;", :valign => "middle"}
                                    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "max-width:100%;", :width => "100%"}
                                      %tr
                                        %td.textContent{:align => "left"}
                                          %div{:style => "font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#828282;text-align:center;line-height:120%;"}

            %table#emailBody{:bgcolor => "#FFFFFF", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
              %tr
                %td{:align => "center", :valign => "top"}
                  %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF;", :width => "100%"}
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "640"}
                          %tr
                            %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                              %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                                %tr
                                  %td.textContent{:align => "center", :style => "padding: 8px 20px; background-color: #{@community.design.display_ebrochure_header_background_color  ? ( @community.theme_name == "futurist" ? (@community.design.futurist_ebrochure_header_background_color) : (@community.theme_name == "panther" ? (@community.design.panther_ebrochure_header_background_color ) : (@community.theme_name.include?('gables') ? (@community.design.gables_ebrochure_header_background_color) : (@community.theme_name == "modernist" ? (@community.design.modernist_ebrochure_header_background_color == "No color" ? (@community.design.primary_color.present? ? @community.design.primary_color : "#CF492E" ) : @community.design.modernist_ebrochure_header_background_color ) : (@community.theme_name == "expressionist" ? (@community.design.expressionist_ebrochure_header_background_color == "No color" ? "#808080" : @community.design.expressionist_ebrochure_header_background_color) : "#808080")) ))) : "@FF0000"};", :valign => "top"}
                                    %h1{:style => "margin-bottom:0px;text-align:center;"}
                                      %div{:style => "width: 350px;display: inline-block;overflow: hidden;"}
                                        %img{:src => "#{@community.logo.url}", width: '350', :style => "max-width: 100%;height:auto;object-fit: contain;"}/
                          - if @community.favorite_setting.present? and @community.favorite_setting.favorite_images.size > 0
                            %tr
                              - @community.favorite_setting.favorite_images.each do |img|
                                = render :partial => 'favorite_image', :locals => {:img => img}
              -#- if @community.favorite_setting.present? and @community.favorite_setting.favorite_images.size > 0
              -#  - @community.favorite_setting.favorite_images.each do |img|
              -#    = render :partial => 'favorite_image', :locals => {:img => img}
              - if @community.favorite_setting.present? and @community.favorite_setting.ebrochure_menu_buttons.size > 0
                %tr
                  %td{:style=>"padding: 13px 1px 0 1px;"}
                    %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :width => "100%"}
                      %tr
                        -#-%td{:style => " background-color:#253339; margin-right:10px;"}
                        - @community.favorite_setting.ebrochure_menu_buttons.each do |button|
                          %td.clickable_row{:style => " background-color:#253339; padding: 10px 20px; white-space: pre; word-break: normal; word-wrap: normal; border: 2px solid #ffffff; text-align: center;",:onclick => "table_row_onclick()", "data-href" => "#{button.url}"}
                            %a{:href => "#{button.url}",:style=>" text-decoration: none; text-align: center; color: #ffffff; "}
                              = button.name
              %tr
                %td{:align => "center", :valign => "top"}
                  %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#000000;", :width => "100%"}
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %h2{:style => "margin-bottom:20px;text-align:left;margin-top: 20px; font-size: 24px; font-weight: bold; margin-left: 20px; color: #000" }
                          Your Favorites
              - if @email_body.present?
                %tr
                  %td{:align => "center", :valign => "top"}
                    %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#000000; border-bottom:#000 1px solid;", :width => "100%"}
                      %tr
                        %td{:align => "center", :valign => "top"}
                          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "600"}
                            %tr
                              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "600"}
                                %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                                  %tr
                                    %td.textContent{:align => "left", :style => "padding: 0px 20px;", :valign => "top"}
                                      %p
                                        
                                        = raw(@email_body.gsub("<community_name>",@community.name).gsub("\n","<br>"))
              -#- if @community.favorite_setting.present? and @community.favorite_setting.favorite_images.size > 0
              -#  - @community.favorite_setting.favorite_images.each do |img|
              -#    = render :partial => 'favorite_image', :locals => {:img => img}
              - (0..(@favorites.count-1)).each_with_index do |f,index |

                - if @favorites[index].is_a?(Unit)
                  = render :partial => 'unit', :locals => {:unit => @favorites[index]}
                - elsif @favorites[index].is_a?(Floorplan)

                  - @unit = @units[@favorites[index].id.to_s]
                  - @unit.each_with_index do |uni,index2|
                    = render :partial => 'floorplan', :locals => {:floorplan => @favorites[index], :units => @unit[index2]}

                - elsif @favorites[index].is_a?(GalleryImage)
                  = render :partial => 'gallery_image', :locals => {:img => @favorites[index]}
                - elsif @favorites[index].is_a?(Amenity)
                  = render :partial => 'amenity_image', :locals => {:img => @favorites[index]}
                - elsif @favorites[index].is_a?(AdditionalImage)
                  = render :partial => 'additional_image', :locals => {:img => @favorites[index]}
                  
            %table#emailFooter{:bgcolor => "#253339", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => "650"}
              %tr
                %td
                  %table#templateBody{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "background-color:#{@community.design.display_ebrochure_header_background_color  ? ( @community.theme_name == "futurist" ? (@community.design.futurist_ebrochure_header_background_color) : (@community.theme_name == "panther" ? (@community.design.panther_ebrochure_header_background_color ) : (@community.theme_name.include?('gables') ? (@community.design.gables_ebrochure_header_background_color) : (@community.theme_name == "modernist" ? (@community.design.modernist_ebrochure_header_background_color == "No color" ? (@community.design.primary_color.present? ? @community.design.primary_color : "#CF492E" ) : @community.design.modernist_ebrochure_header_background_color ) : (@community.theme_name == "expressionist" ? (@community.design.expressionist_ebrochure_header_background_color == "No color" ? "#808080" : @community.design.expressionist_ebrochure_header_background_color) : "#808080")) ))) : "@FF0000"}; ", :width => "100%"}
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %table.templateContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :style => "background-color:#{@community.design.display_ebrochure_header_background_color  ? ( @community.theme_name == "futurist" ? (@community.design.futurist_ebrochure_header_background_color) : (@community.theme_name == "panther" ? (@community.design.panther_ebrochure_header_background_color ) : (@community.theme_name.include?('gables') ? (@community.design.gables_ebrochure_header_background_color) : (@community.theme_name == "modernist" ? (@community.design.modernist_ebrochure_header_background_color == "No color" ? (@community.design.primary_color.present? ? @community.design.primary_color : "#CF492E" ) : @community.design.modernist_ebrochure_header_background_color ) : (@community.theme_name == "expressionist" ? (@community.design.expressionist_ebrochure_header_background_color == "No color" ? "#808080" : @community.design.expressionist_ebrochure_header_background_color) : "#808080")) ))) : "@FF0000"};", :width => ""}
                          %tr
                            %td.bodyContainer{:style => "padding-top:10px;", :valign => "top"}
                              %table.mcnTextBlock{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                                %tbody.mcnTextBlockOuter
                                  %tr
                                    %td.mcnTextBlockInner{:valign => "top"}
                                      %table.mcnTextContentContainer{:align => "center", :border => "0", :cellpadding => "0", :cellspacing => "0", :width => ""}
                                        %tbody
                                          %tr
                                            %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                              %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                = @community.name
                                          - if @community.address.present?
                                            %tr
                                              %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                  = "#{@community.address}"
                                          - if @community.address.present?
                                            %tr
                                              %td.mcnTextContent{:style => "padding-top:0px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                  = "#{@community.city}, #{@community.state} #{@community.zip}"
                                          - if @community.phone.present?
                                            %tr
                                              %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                                %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                  = @community.phone
                                          - if @community.website.present?
                                            %tr
                                              %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 5px; padding-left: 18px; color:#FFFFFF !important; text-align:center;", :valign => "top"}
                                                %p{:style => "text-align:center; color:#FFFFFF !important; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                  %a{:href => "#{@community.website}", :style => "color:#FFF; text-decoration:none;"} #{@community.website}
                                                  -#= @community.website
                                          %tr
                                            %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 20px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                              %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                - if @community.equal_housing_opportunity_logo
                                                  = image_tag "equalhouselogo.png",width: '50', :style => "max-width: 100%; display: inline-block; border: none;"
                                                - if @community.handicap_accessible_logo
                                                  = image_tag "handicam.png",width: '50', :style => "max-width: 100%; display: inline-block; border: none;"
                                          %tr
                                            %td.mcnTextContent{:style => "padding-top:15px; padding-right: 18px; padding-bottom: 20px; padding-left: 18px; color:#FFFFFF; text-align:center;", :valign => "top"}
                                              %p{:style => "text-align:center; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height: 24px;margin: 0;"}
                                                © 2018 -
                                                %a{:href => "http://pynwheeltouchscreens.com/", :style => "color:#FFF; text-decoration:none;"} Pynwheel.com
                                                All rights reserved.
:javascript
  function table_row_onclick(ev) {
   window.open($(this).getAttribute("data-href"),'_blank');
  }