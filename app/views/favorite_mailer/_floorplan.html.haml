%tr
  %td{:align => "center", :valign => "top"}
    %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF; border-bottom:#000 1px solid;", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "600"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "600"}
                %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td.textContent{:align => "left", :style => "padding: 0px 20px;", :valign => "top"}
                      %h1{:style => "margin-bottom:0px;text-align:center; color:#323232; padding:20px 0;"}
                        %b #{floorplan.name}
    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td{:align => "center", :valign => "top"}
                      %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                        %tr
                          %td{:width => "400"}
                            %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :width => "100%"}
                              %tr
                                - puts "ppppp"*40, floorplan.id, '====', unit.id
                                - if unit.present?
                                  - if unit.secondary_image.present?
                                    %td{:style => "width:50%;"}
                                      %div{:style => "width:100%; overflow:hidden;"}
                                        - if floorplan.secondary_image.present? || unit.secondary_image.present?
                                          %img{:alt => "", :src => "#{unit.secondary_image.present? ? unit.secondary_image.url : floorplan.secondary_image.url}", :width => "100%", :height => "100%", :style => "margin:auto;", :title => ""}/
                                    %td{:style => "width:50%;"}
                                      %div{:style => "width:100%; overflow:hidden;"}
                                        - if floorplan.image.present? || unit.present?
                                          %img{:alt => "", :src => "#{unit.image.present? ? unit.image.url : floorplan.image.url}", :width => "100%", :height => "100%", :style => "margin:auto;", :title => ""}/
                                  - else
                                    %td
                                      %div{:style => "width:100%; overflow:hidden;"}
                                        - if unit.image.present? || floorplan.image.present?
                                          %img{:alt => "", :src => "#{unit.image.present? ? unit.image.url : floorplan.image.url}", :width => "320", :height => "250", :style => "max-width:350px; height:300px; margin:auto;", :title => ""}/
                          %td{:valign => "top", :width => "250"}
                            %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :style => "background-color:#878789;", :width => "100%"}
                              %tr
                                %td
                                  %p{:style => "color:#fff;"} Details
                                  %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                    %b #{number_with_delimiter(floorplan.square_feet.to_i, :delimiter => ',')} SF
                                  %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                    %b #{floorplan.bedrooms} #{"bed".pluralize(floorplan.bedrooms.to_i)}
                                  %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                    %b #{floorplan.bathrooms.ceil.to_i} #{"bath".pluralize(floorplan.bathrooms.ceil.to_i)}
                              %tr
                                %td
                            %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :style => "background-color:#4c4d4e;", :width => "100%"}
                              %tr
                                %td{:align => "center"}
                                  %p{:style => "font-family:Helvetica,Arial,sans-serif;font-size:30px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%;"}
                                    Floor Plan
                                  %p{:style => "font-family:Helvetica,Arial,sans-serif;font-size:24px; text-align:center;margin-bottom:0;margin-top:5px;color:#fff;line-height:normal;"} #{floorplan.name}
                              %tr
                                %td