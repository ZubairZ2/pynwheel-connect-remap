<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <title>Your Property Favorites</title>
  <style type="text/css">
    /* Client-specific Resets */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }

    /* Mobile Resets */
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; margin: auto !important; }
      .mobile-padding { padding: 20px 15px !important; }
      .hero-img { width: 100% !important; height: auto !important; }

      /* Button Stacking for Mobile */
      .mobile-button-wrap { display: block !important; width: 100% !important; margin-bottom: 15px !important; }
      .mobile-button { display: block !important; width: 100% !important; box-sizing: border-box !important; }
      .mobile-button-a { display: block !important; width: 100% !important; box-sizing: border-box !important; padding: 15px 10px !important; text-align: center !important; }

      /* Column Stacking */
      .stack-column { display: block !important; width: 100% !important; margin-bottom: 12px !important; }
    }
  </style>
</head>
<body width="100%" style="margin: 0; padding: 0 !important; background-color: #f5f6f4; mso-line-height-rule: exactly;">
  <center style="width: 100%; background-color: #f5f6f4;">
    <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600"
           style="margin: auto; width: 600px; max-width: 600px; background-color: #ffffff; margin-top: 30px; margin-bottom: 30px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);"
           class="email-container">

      <!-- Logo -->
      <tr>
        <td bgcolor="#ffffff" style="padding: 30px 20px; text-align: center; border-bottom: 3px solid #284b31;">
          <img src="<%= @community.logo_for_sdk_email %>" width="200" height="60" alt="<%= @community.name %>"
               style="display: block; margin: auto; max-width: 200px; max-height: 60px; width: auto; height: auto; font-family: -apple-system, sans-serif; color: #172a1d; font-size: 16px; border: 0;" />
        </td>
      </tr>

      <!-- Hero Image -->
      <tr>
        <td bgcolor="#e2e8f0" style="text-align: center;">
          <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=600&h=300&q=80" width="600" alt="Modern Apartment Community" class="hero-img" style="display: block; margin: auto; border: 0; width: 100%; max-width: 600px; height: auto;" />
        </td>
      </tr>

      <!-- Intro -->
      <tr>
        <td bgcolor="#ffffff" style="padding: 40px 30px 30px 30px;" class="mobile-padding">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
              <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 18px; line-height: 28px; color: #1f2937; text-align: center; padding-bottom: 30px;">
                Thanks for exploring <strong><%= @community.name %></strong>.<br>
                The floor plans and amenities you saved are just a click away &mdash; ready whenever you are.
              </td>
            </tr>
            <tr>
              <td align="center" style="text-align: center;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" class="mobile-button-wrap" align="center">
                  <tr>
                    <td align="center" bgcolor="#284b31" style="background-color: #284b31; border-radius: 6px;">
                      <a href="<%= @favorites_url %>" target="_blank"
                         style="font-size: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: bold; color: #ffffff; text-decoration: none; padding: 18px 36px; border: 1px solid #284b31; border-radius: 6px; display: inline-block;"
                         class="mobile-button-a">View My Favorites &rarr;</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- Divider -->
      <tr>
        <td bgcolor="#ffffff" style="padding: 0 30px;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr><td style="border-top: 1px solid #e5e7eb;">&nbsp;</td></tr>
          </table>
        </td>
      </tr>

      <% if @tour_url.present? || @apply_url.present? %>
      <!-- CTA Buttons -->
      <tr>
        <td bgcolor="#faf9f7" style="padding: 30px 30px 40px 30px; text-align: center;" class="mobile-padding">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
              <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 16px; font-weight: 600; color: #374151; text-align: center; padding-bottom: 20px;">
                Ready to make it home?
              </td>
            </tr>
            <tr>
              <td align="center">
                <% if @tour_url.present? && @apply_url.present? %>
                <!-- Both buttons -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                  <tr>
                    <td align="center" class="stack-column" style="padding: 0 10px;">
                      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                          <td align="center" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 6px; border: 1px solid #284b31;">
                            <a href="<%= @tour_url %>" target="_blank"
                               style="font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 600; color: #284b31; text-decoration: none; padding: 14px 20px; display: block;"
                               class="mobile-button-a">Schedule a Tour</a>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td width="20" class="stack-column" style="font-size: 0; line-height: 0;">&nbsp;</td>
                    <td align="center" class="stack-column" style="padding: 0 10px;">
                      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                          <td align="center" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 6px; border: 1px solid #284b31;">
                            <a href="<%= @apply_url %>" target="_blank"
                               style="font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 600; color: #284b31; text-decoration: none; padding: 14px 20px; display: block;"
                               class="mobile-button-a">Apply Now</a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <% elsif @apply_url.present? %>
                <!-- Apply only -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="center" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 6px; border: 1px solid #284b31;">
                      <a href="<%= @apply_url %>" target="_blank"
                         style="font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 600; color: #284b31; text-decoration: none; padding: 14px 40px; display: block;"
                         class="mobile-button-a">Apply Now</a>
                    </td>
                  </tr>
                </table>
                <% elsif @tour_url.present? %>
                <!-- Tour only -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="center" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 6px; border: 1px solid #284b31;">
                      <a href="<%= @tour_url %>" target="_blank"
                         style="font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 600; color: #284b31; text-decoration: none; padding: 14px 40px; display: block;"
                         class="mobile-button-a">Schedule a Tour</a>
                    </td>
                  </tr>
                </table>
                <% end %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <% end %>

      <!-- Footer -->
      <tr>
        <td bgcolor="#172a1d" style="padding: 30px; text-align: center; border-radius: 0 0 8px 8px;" class="mobile-padding">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
              <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; line-height: 22px; color: #d1d5db; text-align: center; padding-bottom: 15px;">
                <strong><%= @community.name %></strong><br>
                <%= @community.address %>, <%= @community.city %>, <%= @community.state %> <%= @community.zip %><br>
                <% if @community.phone.present? %>
                  <a href="tel:<%= @community.phone %>" style="color: #d1d5db; text-decoration: none;"><%= @community.phone %></a>
                <% end %>
              </td>
            </tr>
            <tr>
              <td style="padding-top: 15px; border-top: 1px solid #284b31; text-align: center;">
                <span style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; color: #6b7280;">Powered by Pynwheel</span>
              </td>
            </tr>
          </table>
        </td>
      </tr>

    </table>
  </center>
</body>
</html>
