%tr
  %td{:align => "center", :valign => "top"}
    %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF; border-bottom:#000 1px solid;", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "600"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "600"}
                %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td.textContent{:align => "left", :style => "padding: 0px 20px;", :valign => "top"}
                      -#%h1{:style => "margin-bottom:0px;text-align:center; color:#323232; padding:20px 0;"}
                        -#%b Image: #{img.name}
    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td{:align => "center", :valign => "top"}
                      %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                        %tr
                          %td{:width => "100%"}
                            - unless img.is_video? || img.video.present?
                              %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                                %tr
                                  %td
                                    %div{:style => "max-width:100%; overflow:hidden;"}
                                      %img{:alt => "", :src => "#{img.large_image_url}", :width => "580", :style => "max-width:100%; height:auto; margin:auto;", :title => ""}/
                            - else
                              %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                                %tr
                                  %td
                                    %video{:controls => "", :poster => "https://images-pynwheel-cms-v2.s3.amazonaws.com/uploads/amenity/image/1523/-1594379217-8bf70b78-file.png", :src => img.video.url, :width => "100%"}
                                      %a{:href => img.video.present? ? img.standard_image_url : img.image.url}
                                        %img{:src => "https://images-pynwheel-cms-v2.s3.amazonaws.com/uploads/amenity/image/1523/-1594379217-8bf70b78-file.png", :width => "100%"}/
                                      / %video{:autobuffer => "autobuffer", :controls => "controls", :src => img.video.url, :style => "width: 100%;"}

                                      / %img{:alt => "", :src => "https://images-pynwheel-cms-v2.s3.amazonaws.com/uploads/amenity/image/124/124-1518624577-video-placeholder.jpg", :width => "580", :height => "400"}/
                                /= img.image.file.filename          
                            
