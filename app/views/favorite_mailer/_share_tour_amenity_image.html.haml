%tr
  %td{:align => "center", :valign => "top"}
    %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF; border-bottom:#000 1px solid;", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "600"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "600"}
                %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td.textContent{:align => "left", :style => "padding: 0px 20px;", :valign => "top"}
                      %h1{:style => "margin-bottom:0px;text-align:center; color:#323232; padding:20px 0;"}
                        %b #{img.name}
    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td{:align => "center", :valign => "top"}
                      %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                        %tr
                          %td{:width => "100%"}
                            %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                              %tr
                                %td
                                  %div{:style => "width:100%; overflow:hidden;"}
                                    %img{:alt => "", :src => "#{img.image.url}", :width => "580", :height => "auto", :style => "max-width:580px; margin:auto;", :title => ""}/

                  - if img.video_link.present?
                    %tr
                      %td{:align => "center", :valign => "top"}
                        %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                          %tr
                            %td{:width => "100%"}
                              %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                              
                                %tr
                                  %td{:style=> "text-align: center;"}
                                    %div{:style => "width:100%; overflow:hidden;"}
                                      %form{:action => "#{img.video_link}"}
                                        %input{:type => "submit", :value => "#{img.video_link_button_label.upcase}", :style=> "font-size: large; background: #4c4d4e; border-radius: 0px; color: white; border-color: #878789; border-width: medium; width: 130px; height: 46px;  border-width: medium;  width: fit-content; height: 46px;"}/
                        
