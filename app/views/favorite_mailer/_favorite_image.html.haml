%tr
  %td{:align => "center", :valign => "top"}
    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "620"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td{:align => "center", :valign => "top"}
                      %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                        %tr
                          %td{:width => "100%"}
                            %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                              %tr
                                %td
                                  - unless (img.image.url.split('.')[(img.image.url.split('.').size - 1)]) == "pdf"
                                    %div{:style => "width:100%; overflow:hidden;"}
                                      %img{:alt => "", :src => "#{img.image.url}", :width => "650", :style => "max-width:650px; height:auto; margin:auto;", :title => ""}/
                                  - else
                                    %div{:style => "width:100%; overflow:hidden; text-align: center;"}
                                      %a{:href => "#{img.image.url}"} #{img.name}
