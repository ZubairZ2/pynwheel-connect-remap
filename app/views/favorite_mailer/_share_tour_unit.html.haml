%tr
  %td{:align => "center", :valign => "top"}
    %table{:bgcolor => "#fff", :border => "0", :cellpadding => "0", :cellspacing => "0", :style => "color:#FFFFFF; border-bottom:#000 1px solid;", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "600"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "600"}
                %table{:border => "0", :cellpadding => "30", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td.textContent{:align => "left", :style => "padding: 0px 20px;", :valign => "top"}
                      %h1{:style => "margin-bottom:0px;text-align:center; color:#323232; padding:20px 0;"}
                        %b #{unit.marketing_name}
    %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
      %tr
        %td{:align => "center", :valign => "top"}
          %table.flexibleContainer{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "640"}
            %tr
              %td.flexibleContainerCell{:align => "center", :valign => "top", :width => "620"}
                %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                  %tr
                    %td{:align => "center", :valign => "top"}
                      %table{:border => "0", :cellpadding => "0", :cellspacing => "0", :width => "100%"}
                        %tr
                          %td{:width => "400"}
                            %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :width => "100%", :style=> "text-align: center;"}
                              %tr
                                - if unit.secondary_image.present?
                                  %td{:style => "width:50%;"}
                                    %div{:style => "width:100%; overflow:hidden;"}
                                      - if @ios.present?
                                        %img{:alt => "", :src => "#{unit.secondary_image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;" , :title => ""}/
                                      - else
                                        -if unit.secondary_image.present?
                                          %img{:alt => "", :src => "#{unit.secondary_image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;", :title => ""}/
                                  %td{:style => "width:50%;"}
                                    %div{:style => "width:100%; overflow:hidden;"}
                                      - if @ios.present?
                                        %img{:alt => "", :src => "#{unit.image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;", :title => ""}/
                                      - else
                                        - if unit.image.present?
                                          %img{:alt => "", :src => "#{unit.image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;", :title => ""}/

                                - elsif unit.image.present?
                                  %td
                                    %div{:style => "width:auto; height: 300px; overflow:hidden;"}
                                      - if @ios.present?
                                        %img{:alt => "", :src => "#{unit.image.url}", :width => "320", :height => "270", :style => "width:auto; height:100%; margin:auto; margin-left: auto; margin-right: auto; display: block;", :title => ""}/
                                      - else
                                        %img{:alt => "", :src => "#{ unit.image.url}", :width => "320", :height => "270", :style => "width:auto; height:100%; margin:auto; margin-left: auto; margin-right: auto; display: block;", :title => ""}/

                                - elsif unit.floorplan.secondary_image.present?
                                  %td{:style => "width:50%;"}
                                    %div{:style => "width:100%; overflow:hidden;"}
                                      - if @ios.present?
                                        %img{:alt => "", :src => "#{unit.floorplan.secondary_image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;" , :title => ""}/
                                      - else
                                        -if unit.floorplan.secondary_image.present?
                                          %img{:alt => "", :src => "#{unit.floorplan.secondary_image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;", :title => ""}/
                                  %td{:style => "width:50%;"}
                                    %div{:style => "width:100%; overflow:hidden;"}
                                      - if @ios.present?
                                        %img{:alt => "", :src => "#{unit.floorplan.image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;", :title => ""}/
                                      - else
                                        - if unit.floorplan.image.present?
                                          %img{:alt => "", :src => "#{unit.floorplan.image.url}", :width => "160", :height => "140", :style => "margin:auto; max-width:175px;", :title => ""}/
                                - elsif unit.floorplan.image.present?
                                  %td
                                    %div{:style => "width:auto; height: 300px; overflow:hidden;"}
                                      - if @ios.present?
                                        %img{:alt => "", :src => "#{unit.floorplan.image.url}", :width => "320", :height => "270", :style => "width:auto; height:100%; margin:auto; margin-left: auto; margin-right: auto; display: block;", :title => ""}/
                                      - else
                                        %img{:alt => "", :src => "#{ unit.floorplan.image.url}", :width => "320", :height => "270", :style => "width:auto; height:100%; margin:auto; margin-left: auto; margin-right: auto; display: block;", :title => ""}/


                          %td{:valign => "top", :width => "250"}
                            %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :style => "background-color:#878789;", :width => "100%"}
                              %tr
                                %td
                                  %p{:style => "color:#fff;"} Details
                                  %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                    %b #{number_with_delimiter(unit.square_feet.present? ? unit.square_feet.to_i : unit.floorplan.square_feet.to_i, :delimiter => ',')} SF
                                  %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}

                                    - temp = unit.floorplan.bedrooms.to_s.split('.')
                                    - if temp[1].to_i > 0
                                      %b #{unit.floorplan.bedrooms} #{"bedroom".pluralize(unit.floorplan.bedrooms)}
                                    - else
                                      %b #{unit.floorplan.bedrooms.to_i} #{"bedroom".pluralize(unit.floorplan.bedrooms.to_i)}
                                  %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                    - temp2 = unit.floorplan.bathrooms.to_s.split('.')
                                    - if temp2[1].to_i > 0
                                      %b #{unit.floorplan.bathrooms} #{"bathroom".pluralize(unit.floorplan.bathrooms)}
                                    - else
                                      %b #{unit.floorplan.bathrooms.ceil.to_i} #{"bathroom".pluralize(unit.floorplan.bathrooms.ceil.to_i)}

                                  - unless unit.modal_unit
                                    - if unit.community.display_rent
                                      %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                        %b #{unit.community.get_currency_symbol()} #{unit.effective_rent.to_i} 

                                    - if unit.available_date.present?
                                      %p{:style => "text-align:left;font-family:Helvetica,Arial,sans-serif;font-size:14px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%; margin-left:10px;"}
                                        %b #{formatted_date_by_region(@community.country_code, unit.available_date)}
                              %tr
                                %td
                            %table{:border => "0", :cellpadding => "10", :cellspacing => "0", :style => "background-color:#4c4d4e;", :width => "100%"}
                              %tr
                                %td{:align => "center"}
                                  %p{:style => "font-family:Helvetica,Arial,sans-serif;font-size:30px;margin-bottom:0;margin-top:5px;color:#fff;line-height:135%;"}
                                  %p{:style => "font-family:Helvetica,Arial,sans-serif;font-size:24px; text-align:center;margin-bottom:0;margin-top:5px;color:#fff;line-height:normal;"} #{unit.floorplan.name}
                              %tr
                                %td



                    
