= form_for @company,:url=>company_data_credentials_company_path(@company, community_id: current_community&.id),:html=>{:class=>"form-horizontal settings-form",:method=>'PUT'},:remote=>true do |f|
  .box-body
    .row
      .col-lg-9.col-lg-offset-1
        .form-group
          %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
            Data Provider
          .col-sm-12.col-lg-9.col-md-9.col-xs-12
            = f.select :data_provider , options_for_select([["Entrata","psi"],["RealPage","realpagesvc"],["YardiRentCafe","yardirentcafe"],["Yardi","yardi"],["ResMan","resman"],["RE Data Systems (ftp)","zaremba"],["Xml","xml"],["Spreadsheet","spreadsheet"]],f.object.data_provider),{},{:class=>"form-control", onchange: 'submitSettingFormOnChange()'}
        = f.fields_for :credential do |c|
          .form-group.credential_fields#url
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              URL

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :url, :class=>"form-control settings-field", :placeholder=>"URL"

          .form-group.credential_fields.entrata_url
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Domain

            .row
              .col-sm-12.col-lg-2.col-md-9.col-xs-12.entrata_input
                = c.text_field :entrata_url, :class=>"form-control settings-field", :placeholder=>"Domain"

              %span.col-sm-12.col-lg-4.col-md-9.col-xs-12.entrata_label
                \.entrata.com/api/v1/propertyunits

          .form-group.credential_fields#xml_filename
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Filename
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :xml_filename, :class=>"form-control settings-field", :placeholder=>"Filename"

          .form-group.credential_fields#xml_domain
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Domain
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :xml_domain, :class=>"form-control settings-field", :placeholder=>"Domian"


          .form-group.credential_fields#resman_api_version
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              API Version
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              -# = c.select :resman_api_version, options_for_select(["GetMarketing2_0","GetMarketing4_0"], c.object.resman_api_version), {:class=>"form-control"}
              = c.select :resman_api_version, ["GetMarketing2_0","GetMarketing4_0"], {}, { value: c.object.resman_api_version, class: 'form-control', onchange: 'submitSettingFormOnChange()' }

          .form-group.credential_fields#resman_account_id
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Account Id
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :resman_account_id, :class=>"form-control settings-field", :placeholder=>"Account Id"

          .form-group.credential_fields#zaremba_username
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Username
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_username, :class=>"form-control settings-field", :placeholder=>"Username"


          .form-group.credential_fields#zaremba_password
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Password
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_password, :class=>"form-control settings-field", :placeholder=>"Password"

          .form-group.credential_fields#zaremba_filename
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Filename
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :zaremba_filename, :class=>"form-control settings-field", :placeholder=>"Filename"


          .form-group.credential_fields#yardirentcafe_api_options
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              API URL
            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :yardi_rent_cafe_api_url, YARDI_RENT_CAFE_API_BASE_URLS, {}, { value: c.object.yardi_rent_cafe_api_url, class: 'form-control', onchange: 'submitSettingFormOnChange()' }

          / .form-group.credential_fields#yardirentcafe_option
          /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
          /     Select Option
          /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
          /     = select_tag :yardirentcafe_code_option, options_for_select(["Company Code","Api Token"],c.object.api_token.present? ? "Api Token" : "Company Code"),{:class=>"form-control"}


          .form-group.credential_fields#api_token
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Api Token

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :api_token, :class=>"form-control settings-field", :placeholder=>"Api Token"

          .form-group.credential_fields#c_code
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              C-code

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :c_code, :class=>"form-control settings-field", :placeholder=>"C-Code"

          .form-group.credential_fields#username
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Username

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :username, :class=>"form-control settings-field", :placeholder=>"username"
          .form-group.credential_fields#password
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Password

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :password, :class=>"form-control settings-field", :placeholder=>"Password",:value=>c.object.password,:autocomplete=>"OFF"

          .form-group.credential_fields#site_id
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              SITE ID

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :site_id, :class=>"form-control settings-field", :placeholder=>"SITE ID"

          .form-group.credential_fields#pmc_id
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              PMC ID

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :pmc_id, :class=>"form-control settings-field", :placeholder=>"PMC ID"
          .form-group.credential_fields#server_name
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Server Name

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :server_name, :class=>"form-control settings-field", :placeholder=>"Server Name"
          .form-group.credential_fields#database
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Database

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :database, :class=>"form-control settings-field", :placeholder=>"Database"
          .form-group.credential_fields#platform
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Platform

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :platform , options_for_select(["SQL Server"]),{},{:class=>"form-control settings-field"}
          .form-group.credential_fields#interface_entity
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Interface Entity

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :interface_entity , options_for_select(["Pynwheel"]),{},{:class=>"form-control settings-field"}
          .form-group.credential_fields#spreadsheet
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Upload Data File

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.file_field :file, :class=>"form-control settings-fields validate[required]"

          .form-group
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Select Currency

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.select :currency, Community.last.all_currencies(Money::Currency::table), {}, { value: c.object.currency, class: 'form-control', onchange: 'submitSettingFormOnChange()' }

          .form-group.credential_fields-separate_link.hidden#separate_link_field
            %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
              Separate Link

            .col-sm-12.col-lg-9.col-md-9.col-xs-12
              = c.text_field :separate_link, :class=>"form-control settings-field", :placeholder=>"Link"


          %input#spreadsheet_method{:name => "spreadsheet_method", :type => "hidden", :value => "0"}/


:javascript
   var data_provider = $("#company_data_provider").val();
    selectDataProvider(data_provider);
    $("#company_data_provider").change(function(){
        selectDataProvider($(this).val());
    });
  function credentials_goBack()
  {
    $('.settings-form').submit();
    window.location.reload();

  }

  $('.settings-field').change(function(){
    if ($(".settings-form").validationEngine('validate')){
      $('.settings-form').submit();
     }
  });

  $('#yardirentcafe_code_option').change(function(){
    showYardiRentCafeCodeInputOption($(this).val());
  });


