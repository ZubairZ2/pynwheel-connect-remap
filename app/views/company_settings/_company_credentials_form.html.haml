.col
  .col-md-12.theme-setting
    .dropdown.mt-5.lock-dropdown
      %button.dropbtn.btn.btn-primary
        %i.fa.fa-plus-circle
        Add another data provider
      .dropdown-content.add-new-lock
        %a{:href => "#s-psi","aria-expanded" => "false", "data-toggle" => "tab", :role => "tab",:class =>   @company.data_providers.include?("psi") ? "disabled half_opacity" : "show" }  Entrata
        %a{:href => "#s-realpagesvc","aria-expanded" => "false", "data-toggle" => "tab", :role => "tab",:class => @company.data_providers.include?("realpagesvc")  ? "disabled half_opacity" : "show"} RealPage
        %a{:href => "#s-yardirentcafe","aria-expanded" => "false", "data-toggle" => "tab", :role => "tab",:class =>@company.data_providers.include?("yardirentcafe") ? "disabled half_opacity" : "show"} YardiRentCafe
        %a{:href => "#s-yardi","aria-expanded" => "false", "data-toggle" => "tab", :role => "tab",:class => @company.data_providers.include?("yardi") ? "disabled half_opacity" : "show"} Yardi
        %a{:href => "#s-resman","aria-expanded" => "false", "data-toggle" => "tab", :role => "tab",:class => @company.data_providers.include?("resman") ? "disabled half_opacity" : "show"} ResMan

    %ul#lock_tabs.nav.nav-tabs.add-new-lock{:role => "tablist"}
      %li{:role => "presentation",:class =>  !@company.data_providers.include?("psi") ? "hidden" : "show"}
        %a#psi-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-psi", :role => "tab"} Entrata
      %li{:role => "presentation",:class =>  !@company.data_providers.include?("realpagesvc")  ? "hidden" : "show"}
        %a#realpagesvc-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-realpagesvc", :role => "tab"} RealPage
      %li{:role => "presentation",:class => !@company.data_providers.include?("yardirentcafe") ? "hidden" : "show"}
        %a#yardirentcafe-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-yardirentcafe", :role => "tab"} YardiRentCafe
      %li{:role => "presentation",:class => !@company.data_providers.include?("yardi") ? "hidden" : "show"}
        %a#yardi-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-yardi", :role => "tab"} Yardi
      %li{:role => "presentation",:class => !@company.data_providers.include?("resman") ? "hidden" : "show"}
        %a#resman-tab{"aria-expanded" => "false", "data-toggle" => "tab", :href => "#s-resman", :role => "tab"} ResMan

    #s-psi.tab-pane.fade{:role => "tabpanel",:class => !@company.data_providers.include?("psi") ? "hidden" : "show"}
      = render :partial => 'entrata'
    #s-realpagesvc.tab-pane.fade{:role => "tabpanel",:class =>  !@company.data_providers.include?("realpagesvc") ? "hidden" : "show"}
      = render :partial => 'real_page'
    #s-yardirentcafe.tab-pane.fade{:role => "tabpanel",:class => !@company.data_providers.include?("yardirentcafe") ? "hidden" : "show"}
      = render :partial => 'yardirentcafe'
    #s-yardi.tab-pane.fade{:role => "tabpanel",:class => !@company.data_providers.include?("yardi") ? "hidden" : "show"}
      = render :partial => 'yardi'
    #s-resman.tab-pane.fade{:role => "tabpanel",:class => !@company.data_providers.include?("resman") ? "hidden" : "show"}
      = render :partial => 'resman'




:javascript
  $(document).ready(function() {
    if ($(".add-new-lock li.show").length > 0){
      $(".add-new-lock li.show").first().addClass('active')
      $('.tab-pane.show').first().addClass('active in')
    }
    if ($('#yardirentcafe_code_option').val() == "Api Token"){
      $('#c_code').hide();
    }

    if($('#company_credential_attributes_rentcafe_api_version').val() == 'RentCafe V2'){
      showYardiRentCafeVersion2Option()
      }
    else
    {
      if ($('#s-psi').val() == "true"){
        $(".add-new-lock li").first().removeClass('hidden').addClass('active')
        $('.tab-pane.hidden').first().removeClass('hidden').addClass('active in')
        $('.add-new-lock a.show').first().addClass('disabled half_opacity')
      }else{
        $(".add-new-lock li").last().removeClass('hidden').addClass('active')
        $('.tab-pane.hidden').last().removeClass('hidden').addClass('active in')
        $('.add-new-lock a.show').last().addClass('disabled half_opacity')
      }
    }
  });

  $(document).on("click",".add-new-lock a",function() {
    $('.tab-pane').addClass('hidden')
    tab_id = $(this).attr('href')
    $(tab_id).trigger('click');
    $(tab_id).removeClass('hidden')
    $('.dropdown-content').find(`a[href="${tab_id}"]`).addClass('half_opacity disabled')
    $('#lock_tabs li').removeClass('active')
    if ($(this).parent().hasClass('add-new-lock'))
      $("#" +tab_id.slice(3) + "-tab").parent().insertAfter($('.add-new-lock li').last());
    $("#" +tab_id.slice(3) + "-tab").parent().removeClass('hidden').addClass('active')
  });

  $('#company_credential_attributes_rentcafe_api_version').change(function(e){

    if($(this).val() == 'RentCafe V2')
      showYardiRentCafeVersion2Option();
    else
      showYardiRentCafeCodeInputOption($(this).val());

  })
  $('#yardirentcafe_code_option').change(function(){
    showYardiRentCafeCodeInputOption($(this).val());
  });

  $(document).on('click', '#submit-btn, #submit-btn-realpagesvc, #submit-btn-yardirentcafe, #submit-btn-yardi, #submit-btn-resman', function() {
    var providerName = $(this).attr('provider');
    $.ajax({
      type: 'GET',
      url: '/companies/company_data_provider_communities_list',
      data: { provider: providerName },
      dataType: 'script'
    });
  });
  $('.submit-credential').on('click', function() {
      $('.company-community').trigger('click');
    });

