= form_for @company, url: company_data_credentials_company_path(@company, community_id: current_community&.id), html: { class: "form-horizontal settings-form", method: 'PUT' }, remote: true do |f|

  .box.box-info.add-plan
    .box-header
      %h3.box-title
        Create
        %span YardiRentCafe Provider
        = f.hidden_field :data_providers, value: ["yardirentcafe"]
  = f.fields_for :credential do |c|
    .form-group.credential_fields#yardirentcafe_option.field-to-hide
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
        Select Option
      .col-sm-12.col-lg-9.col-md-9.col-xs-12
        = select_tag :yardirentcafe_code_option, options_for_select(["Company Code","Api Token"],c.object.api_token.present? ? "Api Token" : "Company Code"),{:class=>"form-control"}
    .form-group.credential_fields#yardirentcafe_api_version_options.field-to-hide
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
        API Version
      .col-sm-12.col-lg-9.col-md-9.col-xs-12
        = c.select :rentcafe_api_version, ["RentCafe V1","RentCafe V2"], {}, { value: c.object.rentcafe_api_version, class: 'form-control', onchange: 'submitSettingFormOnChange()' }

    .form-group.credential_fields#yardirentcafe_api_options
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
        API URL
      .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
        = c.select :yardi_rent_cafe_api_url, YARDI_RENT_CAFE_API_BASE_URLS, {}, { value: c.object.yardi_rent_cafe_api_url, class: 'form-control' }
    .form-group.credential_fields#api_token
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
        Vendor Api Token

      .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
        = c.text_field :api_token, :class=>"form-control settings-field", :placeholder=>" Vendor Api Token"

    .form-group.credential_fields#c_code
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.field-to-hide
        C-code

      .col-sm-12.col-lg-9.col-md-9.col-xs-12.field-to-hide
        = c.text_field :c_code, :class=>"form-control settings-field", :placeholder=>"C-Code"

    .form-group.field-to-hide
      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
        Select Currency

      .col-sm-12.col-lg-9.col-md-9.col-xs-12
        = c.select :currency, currencies, {}, { value: c.object.currency, class: 'form-control' }

    .box-footer
      = f.submit "Save Changes", :class=>"btn btn-success pull-right mr-10"
