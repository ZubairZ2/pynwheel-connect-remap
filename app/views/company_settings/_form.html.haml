.form-group
  %label.col-sm-12.col-lg-4.col-md-3.col-xs-12.control-label
    Activate Pynwheel Launch
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorPopover","data-content" => " "}
      %span#propertyDetailNameText
        Switching this 'Yes' will enable Pynwheel Launch Access for the Company.
  
  .col-sm-12.col-lg-8.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :pynwheel_launch_access
      %label.label-primary{:for => "company_setting_pynwheel_launch_access"}
      %span.pl-15 Yes
      = f.hidden_field :company_id, value: current_company.id

.form-group
  %label.col-sm-12.col-lg-4.col-md-3.col-xs-12.control-label
    Import Data at Company Level
    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "unitGridFloorPopover","data-content" => " "}
      %span#propertyDetailNameText
        Switching this 'Yes' will display a button in Pynwheel Launch that allows the user to mass import data for all properties.
  
  .col-sm-12.col-lg-8.col-md-9.col-xs-12
    .TriSea-technologies-Switch
      %span.pr-15 No
      = f.check_box :company_level_data_import
      %label.label-primary{:for => "company_setting_company_level_data_import"}
      %span.pl-15 Yes
      = f.hidden_field :company_id, value: current_company.id

:javascript
  document.addEventListener("DOMContentLoaded", function() {
    var checkboxes = ["company_setting_company_level_data_import", "company_setting_pynwheel_launch_access"];
    var form = document.getElementById("company_setting_from");

    checkboxes.forEach(function(id) {
      var checkbox = document.getElementById(id);
      if (checkbox) {
        checkbox.addEventListener("change", function() {
          if (form) form.submit();
        });
      }
    });
  });
