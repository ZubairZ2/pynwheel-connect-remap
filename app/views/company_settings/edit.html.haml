- content_for :title, " Settings Company - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Settings
          %span Company

      = form_for [@company, @company_setting], url: company_company_setting_path(@company, @company_setting,community_id: current_community&.id), method: :patch, html: { class: "form-horizontal" } do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , companies_path, :class=>"btn btn-default pull-right"
          = f.submit "Save Changes", :class=>"btn btn-success pull-right mr-10"


%section{style: "margin-top: -45px"}
  .content
    .title-heading.mb-25
      .box.box-info
      .box-header
        = render :partial=>'company_credentials_form'