- content_for :title, " Settings Company - Pynwheel"
%section{style: "padding: 20px"}
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Settings
          %span Company

      = form_for [@company, @company_setting], url: company_company_setting_path(@company, @company_setting,community_id: current_community&.id), method: :patch, html: { class: "form-horizontal", id: "company_setting_from" } do |f|
        .box-body
          .row
            .col-lg-10.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
              
%section{style: "margin-top: -45px"}
  .content
    .title-heading.mb-25
      .box.box-info
      .box-header
        = render :partial=>'company_credentials_form'