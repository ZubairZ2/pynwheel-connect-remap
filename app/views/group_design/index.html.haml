:javascript
  var community_group_id = "#{@community_group.id}"
  var group_design_id = "#{@group_design.id}"
  $("#file-load1").on('click', function(e) {
    $('#video_field').click();
  });
  if(localStorage.getItem("image_radio") == "true" || localStorage.getItem("image_radio") == null)
  {
    $('#video-slide').removeClass('active');
    $('#video-slide').removeClass('in');
    $('#image-slide').addClass('active');
    $('#image-slide').addClass('in');
    $("#upload_type").prop('checked',true)
    $("#upload_type1").prop('checked',false)
  }
  else
  {
    $('#image-slide').removeClass('active');
    $('#image-slide').removeClass('in');
    $('#video-slide').addClass('active');
    $('#video-slide').addClass('in');
    $("#upload_type").prop('checked',false)
    $("#upload_type1").prop('checked',true)
  }

  $("#upload_type").on('change', function(e) {
  saveLoopTypeForGroup(true)
    localStorage.setItem("image_radio", true);
    localStorage.setItem("video_radio", false);
      $('#image-slide').addClass('active');
      $('#image-slide').addClass('in');
      $('#video-slide').removeClass('active');
      $('#video-slide').removeClass('in');
  });
  $("#upload_type1").on('change', function(e) {
  saveLoopTypeForGroup(false)
    localStorage.setItem("video_radio", true);
    localStorage.setItem("image_radio", false);

     $('#image-slide').removeClass('active');
     $('#image-slide').removeClass('in');
     $('#video-slide').addClass('active');
     $('#video-slide').addClass('in');
  });
  $("#file-load-drop").on('drop', function(e) {
    // $("#video_submit").click();
  });

  $("#group_design_background_image").change(function(){
      readCommunityGroupHomepageImageURL(this);
  });
  var display_button_image = "#{@group_design.display_button_image}"
  if(display_button_image == "true"){
    $('#button_image_div').removeClass('hidden');
    }

  $('#group_design_display_button_image').change(function(){
    if($(this).is(':checked')){
        $('#button_image_div').removeClass('hidden');
      }
    else{
        $('#button_image_div').addClass('hidden');
     }
  });
  function dropHandler(e)
  {
    if (e.dataTransfer.files[0].size < 500000000)
    {
      if (e.dataTransfer.files[0].type == "video/mp4")
      {
        $(".divLoading").removeClass("hidden");
        e.preventDefault();
        console.log(e.dataTransfer);
        video_field.files = e.dataTransfer.files;
        $("#video_submit").click();
      }
      else
      {
        $('#video-upload-warning').modal('show');
      }
    }
    else
    {
      $('#video-size-warning').modal('show');
    }
  }
  $("#video_field").on('change', function(e) {
    if (e.currentTarget.files[0].size < 500000000)
    {
      if (e.currentTarget.files[0].type == "video/mp4")
      {
        $(".divLoading").removeClass("hidden");
        $("#video_submit").click();
      }
      else
      {
        $('#video-upload-warning').modal('show');
      }
    }
    else
    {
      $('#video-size-warning').modal('show');
    }
  });