- content_for :title, "Add Community Group - Pynwheel"
%section.is-community-page
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Community Group

      = form_for @group_design,:url=>"/community_groups/#{@community_group.id}/group_design/#{@community_group.group_design.id}",:html=>{:class=>"form-horizontal"} do |d|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Position of logo
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :logo_position , options_for_select(home_page_position_of_logo,d.object.logo_position.present? ? d.object.logo_position : "Centre"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button shape
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_shape , options_for_select(button_shape_options,d.object.button_shape.present? ? d.object.button_shape : "Rectangular"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button width
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_width , options_for_select(home_page_button_width,d.object.button_width.present? ? d.object.button_width : "450px"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button height
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_height , options_for_select(button_height_options,d.object.button_height.present? ? d.object.button_height : "150px"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button Spacing
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_spacing , options_for_select(spacing_between_buttons_options,d.object.button_spacing.present? ? d.object.button_spacing : "10px"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button border color
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_spacing , options_for_select(spacing_between_buttons_options,d.object.button_spacing.present? ? d.object.button_spacing : "10px"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button opacity
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_opacity , options_for_select(opacity_options,d.object.button_opacity.present? ? d.object.button_opacity : "100%"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button border side
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_border_side , options_for_select(border_options,d.object.button_border_side.present? ? d.object.button_border_side : "All sides"),{},{class: "form-control",id: ""}

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Button border color
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .input-group.colorpicker-style.hex-format-colorpicker
                    .input-group-addon
                      %i
                      = d.text_field :button_border_color , class: "form-control gables-field",autocomplete: true,"data-value"=>d.object.button_border_color.present? ? d.object.button_border_color : "#3B3B3B"

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button border opacity
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_border_opacity , options_for_select(opacity_options,d.object.button_border_opacity.present? ? d.object.button_border_opacity : "100%"),{},{class: "form-control",id: ""}

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button border thickness
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_border_thickness , options_for_select(global_navigation_border_thickness_space,d.object.button_border_thickness.present? ? d.object.button_border_thickness : "0px"),{},{class: "form-control",id: ""}
              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button font family
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_font_family , options_for_select(font_families,d.object.button_font_family),{},{class: "form-control",id: ""}
              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Button font size
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.select :button_font_size , options_for_select(font_sizes,d.object.button_font_size.present? ? d.object.button_font_size : "18px"),{},{class: "form-control",id: ""}

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Button font color
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .input-group.colorpicker-style.hex-format-colorpicker
                    .input-group-addon
                      %i
                      = d.text_field :button_font_color , class: "form-control gables-field",autocomplete: true,"data-value"=>d.object.button_font_color.present? ? d.object.button_font_color : "#3B3B3B"
              .form-group
                %h4.mt-30
                  Select Home Page Type
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "selectHomepageTypePopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Changing the Home Page Type will change whether the home page shows a video or slideshow.
                  .row
                    .col-lg-12
                      .form-group
                        .radio.radio-primary.pull-left
                          %input#images-loop-type-radio{:name => "loop_type_radio", :type => "radio", :value => "images_loop_type_radio",:checked=>d.object.has_images_loop_type? ? true : false}
                            %label{:for => "main_screen_radio",:style=>"cursor: auto;"}
                              Images
                        .radio.radio-primary.pull-left.ml-20{:style => "margin-top:12px;"}
                          %input#video-loop-type-radio{:name => "loop_type_radio", :type => "radio", :value => "video_loop_type_radio",:checked=>d.object.has_video_loop_type? ? true : false}
                            %label{:for => "home_screen_radio",:style=>"cursor: auto;"}
                              Video
                      -#- if gables_theme(@community)
                      -#  = link_to "Secondary Images", community_homepage_icons_path(@community), class: "btn btn-primary btn-file pull-right"

              .row
                .col-lg-12
                  .form-group.mt-30
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Bouncing effect
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = d.text_field :bouncing_effecting , class: "form-control gables-field",autocomplete: true,"data-value"=>d.object.bouncing_effecting.present? ? d.object.bouncing_effecting : "#3B3B3B"

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Background image

                  -#%span
                  -#  Upload logo for this community group.
                  -#  %br/

                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .image-box.video-box
                    .images.height-200
                      %a.preview-image{:href=>d.object.background_image.present? ? d.object.background_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Home page background image"}
                        = image_tag d.object.background_image.present? ? d.object.background_image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-community-group-homepage-background-image", :style => "max-height: 190px; max-width: 270px;"
                  %span.btn.btn-default.black-button.btn-sm.btn-file
                    Select Image
                    = d.file_field :background_image

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Background Video

                  -#%span
                  -#  Upload logo for this community group.
                  -#  %br/

                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .image-box.video-box
                    .images.height-200
                      = image_tag d.object.video.present? ? d.object.video.url : "default.jpeg",:height=>"",:width=>"170",:id=>"group_design_homepage_video", :style => "max-height: 190px; max-width: 270px;"
                  %span.btn.btn-default.black-button.btn-sm.btn-file#file-load
                    Select Image
                    = d.file_field :video
        .box-footer
          = link_to "CANCEL" , company_community_groups_path(Company. find @community_group.company_id), :class=>"btn btn-default pull-right"
          = d.submit "SUBMIT", :class=>"btn btn-success pull-right mr-10"
