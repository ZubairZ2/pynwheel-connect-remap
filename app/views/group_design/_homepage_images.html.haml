.text-center.image-upload.home-page-drag-box#home-page-image-upload-holder
  = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
  %p Drop files here or click to upload.
.row.slide-imgage-boxs.sortable
  - @community_group.group_design.group_homepage_images.each do |home_page_image, id_tag|
    .col-lg-3{:id=> id_tag}
      .slide-image
        .image-box
          - rn =  rand(9999999999999999999999999)
          .images.galleryimage-home{:style=>"background: url(#{ (home_page_image.crop_x.present? ? home_page_image.image.url(:large) + "?timestamp=#{rn}" : home_page_image.image.url(:large) + "?timestamp=#{rn}")}); background-repeat: no-repeat;height: 210px;background-position: center center;background-size: cover;"}
            %a.preview-image{:href=>home_page_image.image.url.present? ? (home_page_image.crop_x.present? ? home_page_image.image.url(:large) + "?timestamp=#{rn}" : home_page_image.image.url(:large) + "?timestamp=#{rn}") : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"#{home_page_image.name}"}

          .icons
            = link_to show_image_in_modal_community_home_page_index_path(current_community,home_page_image_id: home_page_image.id), remote: true do
              %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}

            %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{current_community.id}/home_page/delete_home_page_image?home_page_image_id=#{home_page_image.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
              %i.fa.fa-close
        = image_tag "exclamation-mark.png", class: "waring_exal #{(home_page_image.is_small) ? "" : "hidden"}", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"

        %h4= home_page_image.name

