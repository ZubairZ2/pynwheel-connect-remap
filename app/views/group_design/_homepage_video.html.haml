.text-center.image-upload.home-page-drag-box#file-load-drop{:ondrop => "dropHandler(event);"}
  = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
  %p Drop video file here or click to upload.
- if @community_group.group_design.group_homepage_video.present?
  .row
    .col-lg-3
      .slide-image
        .image-box.video-box
          .images.height-200
            = video_tag @community_group.group_design.group_homepage_video.video.url.present? ? @community_group.group_design.group_homepage_video.video.url : "", :controls => true, :autobuffer => true,:type => "video/mp4"
          .icons
            %a.text-danger{"data-name"=>"Video","data-href" => "/community_groups/#{@community_group.group_design.id}/group_design/delete_home_page_video?home_page_video_id=#{@community_group.group_design.group_homepage_video.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "##"}
              %i.fa.fa-close
        %h4= @community_group.group_design.group_homepage_video.video.filename
