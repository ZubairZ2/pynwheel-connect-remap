#addWebpage.modal.fade{:role => "dialog"}
	- if @webpage.new_record?
		- url = community_contentpages_path(@community)
	- else
		- url = community_contentpage_path(@community,@webpage)
	= form_for [@community,@webpage], url: url, remote: true do |f|
		.modal-dialog
			/ Modal content
			.modal-content
				.modal-header
					%button.close{"data-dismiss" => "modal", :type => "button"} ×
					%h4.modal-title Add Webpage
				.modal-body
					.row
						.col-md-12
							.mt-25.mb-40
								%label Enter Name
								= f.text_field :name, class: "form-control"
						.col-md-12
							.mt-25.mb-40
								%label Enter URL
								= f.text_field :url, class: "form-control"
					.row
						.col-md-4
							.mt-25.mb-40
								.checkbox
									= f.check_box :hide_page
									%label Hide this page
						.col-md-4
							.mt-25.mb-40
								.checkbox
									= f.check_box :display_on_homepage, {:id => "display"}
									%label Display on homepage
						.col-md-4
							.mt-25.mb-40
								%label 
									Position
								= f.select :position , options_for_select(display_position_on_homepage,f.object.position.present? ? f.object.position : ""),{},{class: "form-control",:id => "position"}
				.modal-footer
					= f.submit "Save", :class=>"btn btn-primary"
					%button.btn.btn-danger{"data-dismiss" => "modal", :type => "button"} Cancel


:javascript
	var $checkBox = $('#display');
	var $select = $('#position');
	$(document).ready( function() 
	{

		if ($checkBox.is(':checked'))
		{
			$select.removeAttr('disabled');
		}
		else
		{
			$select.attr('disabled','disabled');
		}
	});
	$checkBox.on('change',function(e){
		if ($(this).is(':checked'))
		{
			$select.removeAttr('disabled');
		}else{
			$select.attr('disabled','disabled');
			$select.val('');
		}
	});