- content_for :title, "#{@gallery.name} - Gallery"
.divLoading.hidden
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-cubes
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    %h5
      = link_to "< Back to All Galleries", community_galleries_path(@community), class: "btn mb-20",style: "background-color: #8f4a9b; color: white;"
    .bs-example.bs-example-tabs{"data-example-id" => "togglable-tabs",:style => "margin-bottom: 70px;"}
      #myTabContent.tab-content
        #image-slide.tab-pane.fade.active.in{:role => "tabpanel"}
          .row
            .col-md-12
              %h4#image_count #{@gallery.name.capitalize} Gallery - #{@gallery_images.count} #{@gallery_images.count > 1 ? "images" : "image"}
              %h4#gallery_header_span
                %p
                  Upload images and videos here for your gallery. You can also drag and drop them to rearrange them.
                %p
                  Images will appear at a size of 450 x 330 px and can be expanded up to 1100 x 800 px. Please note that images that are too small may appear pixelated.
          .row
            .col-md-6
              .mt-35
                %span.btn.btn-success.btn-file.text-UP.pull-left#file-load1{:onclick=>"$('#gallery-image-upload-holder').click();"}
                  %i.fa.fa-plus-circle
                  Add Files
              .mt-35
          #images-index
            = render 'index'
        = direct_upload_form_for @uploader, :id => "direct_form" do |f|
          = f.file_field :avatar, :id => "video_field",:class => "hidden"
          = f.submit "Upload Directly!", :id => "video_submit",:class => "hidden"
.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "show_gallery_image_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]};
  var gallery_id = #{params[:id]};

  $("#video_field").on('change', function(e) {
    if (e.currentTarget.files[0].size < 500000000){
      if ( e.currentTarget.files[0].type == "video/mp4") {
        $(".divLoading").removeClass("hidden");
        $("#video_submit").click();
      }
      else
        $('#video-upload-warning').modal('show');
    }
  });

  function show_gallery_image_goBack() {
    if (window.history.length == 1)
    window.location.reload();
    else
    window.history.back();
  }