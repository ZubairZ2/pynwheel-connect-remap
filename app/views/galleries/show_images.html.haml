- content_for :title, "#{@gallery.name} - Gallery"
.divLoading.hidden
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-cubes
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    %h5
      = link_to "< Back to All Galleries", community_galleries_path(@community), class: "btn mb-20",style: "background-color: #8f4a9b; color: white;"
    / Start Tabs Secttions
    .bs-example.bs-example-tabs{"data-example-id" => "togglable-tabs"}
      #myTabContent.tab-content
        / Start image-slide section
        #image-slide.tab-pane.fade.active.in{:role => "tabpanel"}
          .row
            .col-md-12
              %h4#image_count #{@gallery.name.capitalize} Gallery - #{@gallery_images.count} #{@gallery_images.count > 1 ? "images" : "image"}
              %h4#gallery_header_span
                %p
                  Upload images and videos here for your gallery. You can also drag and drop them to rearrange them.
                %p
                  Images will appear at a size of 100x100 px and can be expanded up to 200x200 px. Please note that images that are too small may appear pixelated.
          .row
            .col-md-6
              .mt-35
                %span.btn.btn-success.btn-file.text-UP.pull-left{:onclick=>"$('#gallery-image-upload-holder').click();"}
                  %i.fa.fa-plus-circle
                  Add Files
                  / %input#gallery-images{:multiple => "multiple", :type => "file"}/
              .mt-35
          /       = form_tag save_gallery_video_community_gallery_path(@community,@gallery),:method=>"POST",:id=>"gallery-page-video-form",:multipart => true,:remote=>true  do 
          /         %span.btn.btn-primary.btn-file.ml-5.text-UP.pull-left
          /           %i.fa.fa-plus-circle
          /           Add Video
          /           = file_field_tag :gallery_page_video
          #images-index
            = render 'index'
        / End image-slide section
    / End Tabs Secttions
/ /.content
/ End Body right Section
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  var gallery_id = #{params[:id]}
  