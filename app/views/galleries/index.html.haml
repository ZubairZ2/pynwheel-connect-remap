- content_for :title, "Gallery Page - Pynwheel"
/ Main content
.divLoading.hidden

%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          GALLERY
          %span PAGE

    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            .box.box-widget.panel-box.add-plan.pt-30
              = form_tag community_save_gallery_settings_path(@community) ,{:class => 'gallery-settings-form'} do
                = hidden_field_tag "community_id", @community.id
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                    Page Name
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "galleryPageNamePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Changing the Page Name will change the menu label for this page in the Pynwheel app.
                  .col-sm-12.col-lg-6.col-md-6.col-xs-12
                    = text_field_tag :gallery_page_name, @community.gallery_page_name, :class=>"form-control gallery-setting-field"
                
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                    Show this page
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "galleryShowThisPagePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Switching this will change whether or not this page appears in the Pynwheel app.
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    .TriSea-technologies-Switch
                      %span.pr-15 No
                      = check_box_tag :show_gallery, true, @community.show_gallery, class: "gallery-setting-"
                      %label.label-primary{:for => "show_gallery"}
                      %span.pl-15 Yes
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15.margin-bottom-30
                    Add to Home Page Menu
                    %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "galleryAddToHomePagePopover","data-content" => " "}
                      %span#propertyDetailNameText
                        Switching this will change whether or not there is a menu button for this page on the home page of the Pynwheel app.
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    .TriSea-technologies-Switch
                      %span.pr-15 No
                      = check_box_tag :display_gallery_on_homepage, true, @community.display_gallery_on_homepage, class: "gallery-setting"
                      %label.label-primary{:for => "display_gallery_on_homepage"}
                      %span.pl-15 Yes

                = submit_tag 'Save', class: "hidden"
              .form-group
                .col-md-12
                  %button.btn-primary.done_btn{:onclick => "gallery_goBack()"}
                    DONE
        -#.box.box-widget.panel-box.add-plan
        %h4{style: "color: grey;"}
          %p
            Add and manage galleries below.
          %p
            Click the "edit" icon to change the name of a gallery.
          %p
            Click on the gallery name to add, delete, and rearrange media within that gallery.
          %p
            Drag and drop the galleries in the list below to rearrange them.
        .box.box-widget.panel-box
          .row
            .col-md-12
              %table.table.table-bordered.table-striped.table-hover.table-responsive
                %thead
                  %tr
                    %th{:width => "79"} Sr #
                    %th
                      Gallery Name
                      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "galleryGridNamePopover","data-content" => " "}
                        %span#propertyDetailNameText
                          Click on the gallery name to load and reorder images in each gallery. Drag and drop the gallery name in the grid below to reorder the way the galleries appear in the Pynwheel app.
                    %th{:width => "100"}
                      Actions
                      %i.additionalPageAction.fa.fa-question-circle{ "data-toggle" => "galleryGridActionPopover","data-content" => " "}
                        %span#additionalPageActionText
                          Click the edit icon to view or change the gallery name.
                %tbody.sortable_list
                  - orderVar = 0
                  - sortable_fetch(@galleries) do |gallery,index|
                    %tr{:id=> index}
                      - orderVar = orderVar + 1
                      %td= orderVar
                      %td
                        = link_to gallery.name, show_images_community_gallery_path(@community,gallery.id), :class => "loader_class"
                      %td
                        -#%a.text-blue.ml-5{:href => "#{show_images_community_gallery_path(@community,gallery.id)}"}
                        -#  %i.fa.fa-eye
                        = link_to edit_community_gallery_path(@community,gallery), remote: true, class: "text-success ml-5" do
                          %i.fa.fa-edit.icon_size
                        %a.text-danger{"data-name"=>"Gallery","data-href" => "/communities/#{@community.id}/galleries/#{gallery.id}", "data-target" => "#confirm-delete-gallery", "data-toggle" => "modal", :href => "javascrip::;"}
                          %i.fa.fa-trash.icon_size
        .row
          .col-md-12
            = link_to new_community_gallery_path(@community), remote: true, class: "btn btn-success" do
              %i.fa.fa-plus-circle
              ADD GALLERY
        %label
          - dat = [] #PaperTrail::Version.all

      / End Panel left Side
/ /.content
#show_modal
:javascript
  function gallery_goBack()
  {
      $('.gallery-settings-form').submit();
      window.location.reload();
  }
  if (localStorage.getItem("galleryCropped") == "1")
  {


    localStorage.setItem("galleryCropped", "0");
    location.reload(true);
    // window.location.href = window.location.href;
    // location.reload(true);
  }
  $('.gallery-setting-field').change(function(){
    $('.gallery-settings-form').submit();
  });
   

  $('#show_gallery').change(function(){
    if (!($(this).is(':checked')))
    {
      $('#display_gallery_on_homepage').prop('checked',false); 
    }
    $('.gallery-settings-form').submit();
  });
  $('#display_gallery_on_homepage').change(function(){
    if (!($('#show_gallery').is(':checked')))
    {
      $('#display_gallery_on_homepage').prop('checked',false);
      $('.gallery-settings-form').submit();
    }
    else
    {
      $('.gallery-settings-form').submit();
    }
  });
  $('.sortable_list').railsSortable();

  if (!#{current_user.welcome_gallery_page})
  {
    $('[data-toggle="galleryPageNamePopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Changing the Page Name will change the menu label for this page in the Pynwheel app.</div><div class="popover-footer"><a id="galleryPageNamePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }

    $(document).on("click", "#galleryPageNamePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="galleryShowThisPagePopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Switching this will change whether or not this page appears in the Pynwheel app.</div><div class="popover-footer"><a id="galleryShowThisPagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#galleryShowThisPagePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="galleryAddToHomePagePopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Switching this will change whether or not there is a menu button for this page on the home page of the Pynwheel app.</div><div class="popover-footer"><a id="galleryAddToHomePagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#galleryAddToHomePagePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="galleryGridNamePopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Click on the gallery name to load and reorder images in each gallery. Drag and drop the gallery name in the grid below to reorder the way the galleries appear in the Pynwheel app.</div><div class="popover-footer"><a id="galleryGridNamePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#galleryGridNamePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="galleryGridActionPopover"]').popover({
        html: true,
        placement: 'left',
        template: '<div class="popover pyn-popover" style="width: max-content;"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Click the edit icon to view or change the gallery name.</div><div class="popover-footer"><a id="galleryGridActionPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#galleryGridActionPopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        #{current_user.welcome_gallery_page = true}
        #{current_user.save}
    });