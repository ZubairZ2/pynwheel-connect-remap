.divLoading.hidden
/ Main content
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-image>
        Gallery
    / Start Tabs Secttions
    .bs-example.bs-example-tabs{"data-example-id" => "togglable-tabs"}
      #myTabContent.tab-content
        / Start image-slide section
        #image-slide.tab-pane.fade.active.in{:role => "tabpanel"}
          .row
            .col-lg-12
              .pull-right
                %span.btn.btn-success.btn-file.pull-right.text-UP
                  %i.fa.fa-plus-circle
                  Add Files
                  %input#gallery-images{:multiple => "multiple", :type => "file"}/
          #images-index
            = render 'index'
        / End image-slide section
    / End Tabs Secttions
/ /.content
/ End Body right Section
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}