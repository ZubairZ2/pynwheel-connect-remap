.row.slide-imgage-boxs.sortable
  - sortable_fetch(@gallery_images) do |gallery_image, id_tag|
    .col-lg-3{:id=> id_tag}
      .slide-image
        .image-box
          .images
            %a.preview-image{:href=>gallery_image.image? ? gallery_image.image.url(:large) : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Gallery Image"}
              = image_tag gallery_image.image.url(:thumb)
        .icons
          = link_to show_image_in_modal_community_galleries_path(@community,gallery_image_id: gallery_image.id), remote: true do 
            %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}
          %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{@community.id}/galleries/delete_gallery_image?gallery_image_id=#{gallery_image.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
            %i.fa.fa-close
.text-center.image-upload.gallery-drag-box#gallery-image--upload-holder
  = image_tag "upload-image.png",:class=>"drag-image-padding-top"
  %p Drag &amp; Drop file to Upload

.modal.fade.bs-example-modal-lg.edit-image{"aria-hidden" => "true", "aria-labelledby" => "myLargeModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-body
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
            %i.fa.fa-close
        #carousel-example-generic.carousel.slide
          / Wrapper for slides
          .carousel-inner{:style=>"height: 500px;"}
            - @gallery_images.each_with_index do |gallery_image,index|
              .item.text-center{:class=>"#{index == 0 ? 'active' : ''}"}
                = image_tag gallery_image.image.url(:thumb)
                .carousel-caption
                  image
            
          / Controls
          %a.left.carousel-control{"data-slide" => "prev", :href => "#carousel-example-generic", :role => "button"}
            %span.glyphicon.glyphicon-chevron-left
          %a.right.carousel-control{"data-slide" => "next", :href => "#carousel-example-generic", :role => "button"}
            %span.glyphicon.glyphicon-chevron-right