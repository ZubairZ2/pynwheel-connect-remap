.text-center.image-upload.home-page-drag-box#gallery-image-upload-holder
  = image_tag "upload-image.png",:class=>"drag-image-padding-top dz-message"
  %p Drop files here or click to Upload
.row.slide-imgage-boxs.sortable.image_slide_view{:style => "overflow-y: hidden;"}
  -#- @gallery_images.reload()
  - sortable_fetch(@gallery_images) do |gallery_image, id_tag|
    .col-lg-2{:id=> id_tag}
      .slide-image
        .image-box.video-box
          .images.height-200
            - if gallery_image.is_video? || gallery_image.video.present?
              = video_tag (gallery_image.video.present? && gallery_image.standard_image_url.present? ? gallery_image.standard_image_url : asset_path("default.jpeg")), controls: true, autobuffer: true

            - else
              - rn =  rand(9999)
              %a.preview-image{ href: gallery_image.image&.url(:large).present? ? "#{gallery_image.image.url(:large)}?timestamp=#{rn}" : asset_path("default.jpeg"), "data-toggle": "lightbox", "data-title": gallery_image.name }
                = image_tag( gallery_image.image&.url(:large).present? ? "#{gallery_image.image.url(:large)}?timestamp=#{rn}" : asset_path("default.jpeg"), class: "image_#{gallery_image.id}" )

          - unless gallery_image.is_video? || gallery_image.video.present?
            = image_tag "exclamation-mark.png", class: "waring_exal hidden #{"image_warning_"+gallery_image.id.to_s}", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"
        .icons
          - unless gallery_image.is_video?
            = link_to  show_image_in_modal_community_gallery_path(@community,@gallery,gallery_image_id: gallery_image.id), remote: true do 
              %i.fa.fa-pencil{"data-target" => "#edit-name", "data-toggle" => "modal"}
          %a.text-danger{"data-name"=>"#{gallery_image.is_video? ? 'Video' : 'Image'}","data-href" => "/communities/#{@community.id}/galleries/#{@gallery.id}/delete_gallery_image?gallery_image_id=#{gallery_image.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
            %i.fa.fa-close
        %h4= gallery_image.name        

.modal.fade.bs-example-modal-lg.edit-image{"aria-hidden" => "true", "aria-labelledby" => "myLargeModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-body
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
            %i.fa.fa-close
        #carousel-example-generic.carousel.slide
          / Wrapper for slides
          .carousel-inner{:style=>"height: 500px;"}
            - @gallery_images.each_with_index do |gallery_image,index|
              .item.text-center{:class=>"#{index == 0 ? 'active' : ''}"}
                - unless gallery_image.is_video?

                  = image_tag (gallery_image.crop_x.present? ? gallery_image.image.url: gallery_image.image.url) rescue asset_path("default.jpeg")
                  .carousel-caption
                    image  
            
          / Controls
          %a.left.carousel-control{"data-slide" => "prev", :href => "#carousel-example-generic", :role => "button"}
            %span.glyphicon.glyphicon-chevron-left
          %a.right.carousel-control{"data-slide" => "next", :href => "#carousel-example-generic", :role => "button"}
            %span.glyphicon.glyphicon-chevron-right

:javascript

  $('.image_slide_view').bind("DOMSubtreeModified",function(){
    $('#image_count').text('#{@gallery.name.capitalize} Gallery - #{@gallery_images.count} #{@gallery_images.count > 1 ? "images" : "image"}');
  });
  $(document).ready(function(e){
  $('[data-toggle="popover"]').popover();
  });
  var ids = #{@gallery_images.map{|x| x.id unless (x.is_video? || x.video.present? )}.compact}
  $(window).bind("load", function() {
   for(var  i = 0; i < ids.length ; i++)
  {
    var myImg = document.querySelector(".image_"+ids[i]);
    if (myImg.naturalWidth < 400 && myImg.naturalHeight < 400)
    {
      $(".image_warning_"+ids[i]).removeClass("hidden");
    }
  }
  });

