- content_for :title, "Amenities - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.company.name + '@' + @community.name
    - if @floorplates.present?
      = render :partial=>'floorplates'
    - else
      .row
        / Start Panel left Side
        .col-lg-12.col-md-12
          .row
            .col-md-6
              %h4.title Amenities
            .col-md-6
              .mt-35
                %span.btn.btn-success.btn-file.pull-right.mb-20
                  %i.fa.fa-plus-circle
                  Add Amenity
                  %input#sitemap-amenity-images{:multiple => "multiple", :type => "file"}/ 
              .mt-35
                %a.btn.btn-primary.pull-right.mb-20.mr-10{:href => "#{plot_amenities_community_sitemaps_path(@community)}"}
                  PLOT AMENITIES
              .divLoading.hidden
      #images-index
        = render :partial=>'index'
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  var sitemap_id = #{@sitemap.id}

        