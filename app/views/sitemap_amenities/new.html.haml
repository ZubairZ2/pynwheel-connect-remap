- content_for :title, "Add Amenity - Pynwheel"
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.company.name + '@' + @community.name
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Add
          %span Amenity

      = form_for @amenity,:url=>community_sitemap_amenities_path(@community,@sitemap),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'shared/amenity_form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , community_sitemap_amenities_path(@community,@sitemap), :class=>"btn btn-default pull-right"
          = f.submit "ADD AMENITY", :class=>"btn btn-success pull-right mr-10"