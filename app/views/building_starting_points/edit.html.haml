-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Edit Building - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Building Starting Point
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @building_starting_point,url: "/communities/#{@community.id}/building_starting_points/#{@building_starting_point.id}" , method: :put ,:html => {:class => 'save-building-starting-point-form'} do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Name",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :directional_text, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Directional Text"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Building",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Floor

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.select :floor, (@floors),{} , class: "form-control building_starting_point_edit_field"

            - if @community.enable_locks

              - locks_present_hash = {}
              - locks_present_hash["Dwelo"] = @community.multiple_locks_provider.include?("Dwelo") && @community.dwelo.present? && @all_locks[:dwelo_locks].any?
              - locks_present_hash["EdgeState"] = @community.multiple_locks_provider.include?("EdgeState") && @community.edge_state.present? && @all_locks[:edgestate_locks].any?
              - locks_present_hash["Latch"] = @community.multiple_locks_provider.include?("Latch") &&  @community.latch.present? && @all_locks[:latch_locks].any?
              - locks_present_hash["Zerv"] = @community.multiple_locks_provider.include?("Zerv") &&  @community.zerv.present? && @all_locks[:zerv_locks].any?
              - locks_present_hash["Igloohome"] = @community.multiple_locks_provider.include?("Igloohome") &&  @community.igloohome.present? && @all_locks[:igloohome_locks].any?

              // load options and input values start
              - if locks_present_hash["Dwelo"]
                = hidden_field_tag "dwelo_lock_input_value", @building_starting_point.remote_locks.dwelo_locks.present? ? @building_starting_point.remote_locks.dwelo_locks.last.name + " (" + @building_starting_point.remote_locks.dwelo_locks.last.remote_lock_type + ")" : ''
                .dwelo_options.hide_it
                  - @all_locks[:dwelo_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - if locks_present_hash["EdgeState"]
                = hidden_field_tag "edgestate_lock_input_value", @building_starting_point.remote_locks.edgestate_locks.present? ? @building_starting_point.remote_locks.edgestate_locks.last.name + " (" + @building_starting_point.remote_locks.edgestate_locks.last.remote_lock_type + ")" : ''
                .edgestate_options.hide_it
                  - @all_locks[:edgestate_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}  
              - if locks_present_hash["Latch"]
                = hidden_field_tag "latch_lock_input_value", @building_starting_point.latch_locks.present? ?  @building_starting_point.latch_locks.last.lock_name : ''
                .latch_options.hide_it
                  - @all_locks[:latch_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - if locks_present_hash["Zerv"]
                = hidden_field_tag "zerv_lock_input_value", @building_starting_point.zerv_locks.present? ?  @building_starting_point.zerv_locks.last.sub_location_name + " (" + @building_starting_point.zerv_locks.last.sub_location_friendly_name + ")" : ''
                .zerv_options.hide_it
                  - @all_locks[:zerv_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - if locks_present_hash["Igloohome"]
                = hidden_field_tag "igloohome_lock_input_value", ( @building_starting_point.igloohome_locks.present? ? @building_starting_point.igloohome_locks.first.device_name : '' )
                .igloohome_options.hide_it
                  - @all_locks[:igloohome_locks].each do |lock|
                    %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Select Lock Type
                  %span Select the access provider for this stop
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.select :lock_provider , options_for_select(@community.lock_options(locks_present_hash), f.object.lock_provider),{},{:class=>"form-control"}

              .form-group.hide_it#manual_access_code
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                  Access Code
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = f.text_field :access_code, :oninput => "this.value = this.value.replace(/[^0-9#*]/g, '')", :class=>"form-control building_starting_point_edit_field", :placeholder=>"Access Code",:maxlength => "10"

              .form-group#lock_access_code.hide_it
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  = text_field_tag :lock_input, '', :placeholder => "Search by lock name", :list => "locks_list", :autocomplete=> "off", :type => "text", :class => "form-control building_starting_point_edit_field"
                  %datalist#locks_list

.row{:style => "margin-top: 245px;"}
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %button.btn-primary.mb-20.done_btn#on_done{:style => " margin-top: 0px;  margin-bottom: 0px;" }
                DONE
              %button.btn-default.done_btn.mb-20{:onclick => "goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                Cancel
:javascript

  var locks_input, locks_list, param_name, in_change = false;
  $(document).ready(function(){
    // run it on ready 
    update_locks_select_and_lock_code_field()
    // provide locks on change 
    $('#building_starting_point_lock_provider').change(function(){
      update_locks_select_and_lock_code_field();
      if ($('#building_starting_point_lock_provider').val().length == 0)
        $('.save-building-starting-point-form').submit();
    });

    function update_locks_select_and_lock_code_field(){
      // if any lock selected selected
      if ($('#building_starting_point_lock_provider').val().length > 0 && $('#building_starting_point_lock_provider').val() != "Manual")
      {
        $('#manual_access_code').addClass('hide_it')
        // initialize elements 
        lock_provider_type = $('#building_starting_point_lock_provider').val().toLowerCase()
        lock_input_value = "#" + lock_provider_type + "_lock_input_value"
        options = '.' + lock_provider_type + "_options"
        locks_input = "#lock_input"
        locks_list = "#locks_list"
        param_name = "lock_id"
        // assign values
        if (lock_provider_type == "zerv")
          $('#lock_access_code').find('label').html("Lock <span>Assign the lock to this building starting point</span>")
        else
          $('#lock_access_code').find('label').html(capitalize(lock_provider_type) + " Lock <span>Assign the lock to this building starting point</span>")

        $('#lock_input').val( $(lock_input_value).val() )
        $('datalist#locks_list').html($(options).html())
        $('#lock_access_code').removeClass('hide_it') 
      }
      else if ($('#building_starting_point_lock_provider').val().length > 0)
      {
        $('#lock_access_code').addClass('hide_it')
        $('#manual_access_code').removeClass('hide_it')
        locks_input = undefined
      }
      else
      {
        $('#lock_access_code').addClass('hide_it')
        $('#manual_access_code').addClass('hide_it')
      }
    }
  
    $('.building_starting_point_edit_field').change(function(){
       if (locks_input){
          setTimeout(function(){
            var lock = $(locks_input)[0];
            if(typeof lock !== 'undefined'){

              if(lock.checkValidity() == true){
                lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
                input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
                $("#" + lock.id).closest('form').append(input)
                $('.save-building-starting-point-form').submit()
              }
              else{ 
                //lock.reportValidity();
                $('.save-building-starting-point-form').submit()
              }
            }
          else{
            $('.save-building-starting-point-form').submit()
          }
        }, 300);
        }
        else
          $('.save-building-starting-point-form').submit()
      
    });

    $('#on_done').click(function(e){
        if (locks_input){
          setTimeout(function(){
            var lock = $(locks_input)[0];
            if(typeof lock !== 'undefined'){

              if(lock.checkValidity() == true){
                lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
                input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
                $("#" + lock.id).closest('form').append(input)
                $('.save-building-starting-point-form').append('<input type="hidden" name="done_action" value="true">');
                $('.save-building-starting-point-form').submit();
              }
              else{
                $('.save-building-starting-point-form').submit()
                //lock.reportValidity(); 
              }
            }
          else{
            $('.save-building-starting-point-form').submit()
          }
        }, 300);
        }
        else
          $('.save-building-starting-point-form').submit()
    })
  });
  if (locks_input){
    var inputs = document.querySelectorAll('input[list]');
    for (var i = 0; i < inputs.length; i++) {
      inputs[i].addEventListener('change', function() {
        var optionFound = false,
        datalist = this.list;
        for (var j = 0; j < datalist.options.length; j++) {
            if (this.value == datalist.options[j].value) {
                optionFound = true;
                break;
            }
        }
        if (optionFound) {
          this.setCustomValidity('');
        } else {
          if ( typeof locks_input !== 'undefined' && $(locks_input).val() != "" )
              this.setCustomValidity('Lock does not exist');
        }
      });
    }
  }
  function goBack(){
    window.location.href = '/communities/#{@community.id}/tours';
  }