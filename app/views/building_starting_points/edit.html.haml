-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Edit Elevator - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Elevator
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @building_starting_point,url: "/communities/#{@community.id}/building_starting_points/#{@building_starting_point.id}" , method: :put ,:html => {:class => 'save-building-starting-point-form'} do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Name",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :directional_text, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Directional Text"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Building",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Floor

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.select :floor, (@floors),{} , class: "form-control building_starting_point_edit_field" 
:javascript
  $('.building_starting_point_edit_field').change(function(){
    // alert("grgr");
    $('.save-building-starting-point-form').submit();
  });