-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Edit Building - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Building Starting Point
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @building_starting_point,url: "/communities/#{@community.id}/building_starting_points/#{@building_starting_point.id}" , method: :put ,:html => {:class => 'save-building-starting-point-form'} do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Name",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :directional_text, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Directional Text"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Building",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Floor

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.select :floor, (@floors),{} , class: "form-control building_starting_point_edit_field"

            - if @community.enable_locks
              - if @community.locks_provider == "EdgeState" and @community.edge_state.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Remote Lock
                    %span Assign the lock to this building starting point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :edgestate_locks_input, @building_starting_point.remote_locks.present? ? @building_starting_point.remote_locks.last.name + " (" + @building_starting_point.remote_locks.last.remote_lock_type + ")" : '', :placeholder => "Search by lock name", :list => "edgestate_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control building_starting_point_edit_field"
                    %datalist#edgestate_locks_list
                      - @all_locks[:edgestate_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - elsif @community.locks_provider == "Dwelo" and @community.dwelo.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Dwelo lock
                    %span Assign the lock to this building starting point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :dwelo_locks_input, @building_starting_point.remote_locks.present? ? @building_starting_point.remote_locks.last.name + " (" + @building_starting_point.remote_locks.last.remote_lock_type + ")" : '', :placeholder => "Search by lock name", :list => "dwelo_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control building_starting_point_edit_field"
                    %datalist#dwelo_locks_list
                      - @all_locks[:dwelo_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}
              - elsif @community.locks_provider == "Latch" and @community.latch.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Latch lock
                    %span Assign the lock to this building starting point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :latch_locks_input, @building_starting_point.latch_locks.present? ?  @building_starting_point.latch_locks.last.lock_name : '', :placeholder => "Search by lock name", :list => "latch_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control building_starting_point_edit_field"
                    %datalist#latch_locks_list
                      - @all_locks[:latch_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == "Zerv" and @community.zerv.present? and @all_locks.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Pynwheel Access (zerv)
                    %span Assign the lock to this building starting point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = text_field_tag :zerv_locks_input, @building_starting_point.zerv_locks.present? ?  @building_starting_point.zerv_locks.last.sub_location_name + " (" + @building_starting_point.zerv_locks.last.sub_location_friendly_name + ")" : '', :placeholder => "Search by lock name", :list => "zerv_locks_list", :autocomplete=> "off", :type => "text", :class => "form-control building_starting_point_edit_field"
                    %datalist#zerv_locks_list
                      - @all_locks[:zerv_locks].each do |lock|
                        %option{value: "#{lock[:name]}", 'data-value'=> "#{lock[:id]}"}

              - elsif @community.locks_provider == nil or @community.locks_provider == ""
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Access Code
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.text_field :access_code, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Access Code",:maxlength=>"30"

.row{:style => "margin-top: 245px;"}
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %button.btn-primary.mb-20.done_btn#on_done{:style => " margin-top: 0px;  margin-bottom: 0px;" }
                DONE
:javascript
  var locks_provider = "#{@locks_provider}"
  var locks_input, locks_list, param_name, in_change = false;

  if(locks_provider == "EdgeState"){
    locks_input = "#edgestate_locks_input"
    locks_list = "#edgestate_locks_list"
    param_name = "remote_lock"
  }
  else if(locks_provider == "Dwelo"){
    locks_input = "#dwelo_locks_input"
    locks_list = "#dwelo_locks_list"
    param_name = "dwelo_remote_lock"
  }
  else if(locks_provider == "Latch"){
    locks_input = "#latch_locks_input"
    locks_list = "#latch_locks_list"
    param_name = "latch_lock"
  }
  else if(locks_provider == "Zerv"){
    locks_input = "#zerv_locks_input"
    locks_list = "#zerv_locks_list"
    param_name = "zerv_lock"
  }

  $('.building_starting_point_edit_field').change(function(){
    var one_time_run = false
    in_change = true

    $('#on_done').click(function(e){
      one_time_run = true
      setTimeout(function(){
        var lock = $(locks_input)[0];
        if(lock.checkValidity() == true){
          lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
          input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
          $("#" + lock.id).closest('form').append(input)
          $('.save-building-starting-point-form').submit(function() {
            $(this).append('<input type="hidden" name="done_action" value="true">');
          });
        }
        else{ lock.reportValidity(); }
      }, 300);
    })

    if(one_time_run == false){
      setTimeout(function(){

          var lock = $(locks_input)[0];
          if(lock.value == "")
            lock.setCustomValidity('')

          if(lock.checkValidity() == true){
            lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
            input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
            $("#" + lock.id).closest('form').append(input)
            $('.save-building-starting-point-form').submit();
          }
          else{ lock.reportValidity(); }

      }, 300);
    }
  });

  $('#on_done').click(function(e){
    setTimeout(function(){
      if(in_change == false){ window.location.replace("#{session[:go_back]}");} }, 300)
  })

  var inputs = document.querySelectorAll('input[list]');
  for (var i = 0; i < inputs.length; i++) {
    inputs[i].addEventListener('change', function() {
      var optionFound = false,
      datalist = this.list;
      for (var j = 0; j < datalist.options.length; j++) {
          if (this.value == datalist.options[j].value) {
              optionFound = true;
              break;
          }
      }
      if (optionFound) {
        this.setCustomValidity('');
      } else {
        if ( $(locks_input).val() != "" )
            this.setCustomValidity('Lock does not exist');
      }
    });
  }
