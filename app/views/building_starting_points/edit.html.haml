-#%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Edit Building - Pynwheel"
.divLoading.hidden
%section.is-sitemap
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Edit Building Starting Point
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @building_starting_point,url: "/communities/#{@community.id}/building_starting_points/#{@building_starting_point.id}" , method: :put ,:html => {:class => 'save-building-starting-point-form'} do |f|
            = hidden_field_tag "community_id", @community.id

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Name

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :name, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Name",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Directional Text

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :directional_text, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Directional Text"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Building

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.text_field :building, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Building",:maxlength=>"30"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                Floor

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = f.select :floor, (@floors),{} , class: "form-control building_starting_point_edit_field"

            - if @community.enable_locks
              - if @community.locks_provider == "EdgeState" and @community.edge_state.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Remote Lock
                    %span Assign the lock to this building startin point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = select_tag :remote_lock, options_for_select(@community.edge_state.remote_locks.order(:id).collect{ |l| [l.name + " (" + l.remote_lock_type + ")", l.device_id] } , @building_starting_point.remote_locks.present? ?  @building_starting_point.remote_locks.last.device_id : ''), {:class => "form-control building_starting_point_edit_field", :prompt => "Select your option"}
              - elsif @community.locks_provider == "Dwelo" and @community.dwelo.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Dwelo lock
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = select_tag :dwelo_remote_lock, options_for_select(@community.dwelo.remote_locks.order(:id).collect{ |l| [l.name + " (" + l.remote_lock_type + ")", l.device_id] } , @building_starting_point.remote_locks.present? ?  @building_starting_point.remote_locks.last.device_id : ''), {:class => "form-control building_starting_point_edit_field", :prompt => "Select your option"}     
              - elsif @community.locks_provider == "Latch" and @community.latch.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Latch lock
                    %span Assign the lock to this building startin point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = select_tag :latch_lock, options_for_select(@community.latch.latch_locks.order(:id).collect{ |l| [l.lock_name, l.door_uuid] } , @building_starting_point.latch_locks.present? ?  @building_starting_point.latch_locks.last.door_uuid : ''), {:class => "form-control building_starting_point_edit_field", :prompt => "Select your option"}
              - elsif @community.locks_provider == "Zerv" and @community.zerv.present?
                .form-group.hide_on_new
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Pynwheel Access (zerv)
                    %span Assign the lock to this building startin point
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = select_tag :zerv_lock, options_for_select(@community.zerv.zerv_locks.order(:id).collect{ |l| [l.sub_location_name + " (" + l.sub_location_friendly_name + ")", l.mac_id] } , @building_starting_point.zerv_locks.present? ?  @building_starting_point.zerv_locks.last.mac_id : ''), {:class => "form-control building_starting_point_edit_field", :prompt => "Select your option"}
              - elsif @community.locks_provider == nil or @community.locks_provider == ""
                .form-group
                  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                    Access Code
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    = f.text_field :access_code, :class=>"form-control building_starting_point_edit_field", :placeholder=>"Access Code",:maxlength=>"30"

.row{:style => "margin-top: 245px;"}
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-lg-12.col-md-12
              %button.btn-primary.mb-20.done_btn#on_done{:style => " margin-top: 0px;  margin-bottom: 0px;" }
                DONE
:javascript
  $('.building_starting_point_edit_field').change(function(){

    $('#on_done').click(function(e){
      $('.save-building-starting-point-form').submit(function() {
          $(this).append('<input type="hidden" name="done_action" value="true">');
      });
    })

    setTimeout(function () {
         $('.save-building-starting-point-form').submit();
    }, 500);
  });

  $('#on_done').click(function(e){
    window.location.replace("#{session[:go_back]}");
  })
