- content_for :title, "Schedule Widget - Pynwheel"
.divLoading.hidden
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          Schedule Widget
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30.pb-40
          = form_tag save_schedule_widget_btn_setting_community_tours_path(@community) ,{:class => 'tour-settings-form'} do
            = hidden_field_tag "community_id", @community.id

            .form-group{:style => "text-align: center; "}
              %button.btn.btn-success.primary-button{:style => "float: center;", :id => "sample_btn"} Schedule a Visit
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Schedule Widget Text
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                = text_field_tag :btn_text , @community.tour.dotted_line_color.humanize,:class => "form-control", :id => "set_text"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Schedule Widget color family
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                = select_tag :btn_font_family , options_for_select(font_families, "ms-appx:/DesignTemplates/Expressionist/CutomFonts/Arial.ttf#Arial"),:class => "form-control", :id => "set_font"
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Schedule Widget color
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                .input-group.colorpicker-style.hex-format-colorpicker
                  .input-group-addon
                    %i
                
                    = text_field_tag :btn_color , "#20a345",:class => "form-control", :id => "set_color"
                  
:javascript
  $('#set_text').keyup(function(){
    $('#sample_btn').text(this.value)
  });
  $('#set_color').change(function(){
    $("#sample_btn").css("background-color", this.value);
  });