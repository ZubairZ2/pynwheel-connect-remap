:javascript
  var left_margin = #{raw left_margin}
  var top_margin = #{raw top_margin}

  $(document).ready(function () {
    enableZoom();
    bindPlottingEvents();
  })

  var floor = null;
  var locks_input, locks_list, param_name;
  $('#lock_provider').find('option:first').addClass('hide_it')
  // run it on ready 
  update_locks_select_and_lock_code_field()
  // provide locks on change 
  $('#lock_provider').change(function(){
    update_locks_select_and_lock_code_field();
    if ($('#lock_provider').val().length == 0)
      $('.save-starting-point-form').submit();
  });

  function update_locks_select_and_lock_code_field(){
    if ($('#lock_provider').val().length > 0 && $('#lock_provider').val() != "Manual")
    {
      $('#manual_access_code').addClass('hide_it')
      // initialize elements 
      lock_provider_type = $('#lock_provider').val().toLowerCase()
      lock_input_value = "#" + lock_provider_type + "_lock_input_value"
      options = '.' + lock_provider_type + "_options"
      locks_input = "#lock_input"
      locks_list = "#locks_list"
      param_name = "lock_id"
      // assign values
      if (lock_provider_type == "zerv")
        $('#lock_access_code').find('label').html("Lock <span>Assign the lock to this starting point</span>")
      else
        $('#lock_access_code').find('label').html(capitalize(lock_provider_type) + " Lock <span>Assign the lock to this starting point</span>")

      $('#lock_input').val( $(lock_input_value).val() )
      $('datalist#locks_list').html($(options).html())
      $('#lock_access_code').removeClass('hide_it') 
    }
    else if ($('#lock_provider').val().length > 0)
    {
      $('#lock_access_code').addClass('hide_it')
      $('#manual_access_code').removeClass('hide_it')
      locks_input = undefined
    }
    else
    {
      $('#lock_access_code').addClass('hide_it')
      $('#manual_access_code').addClass('hide_it')
    }
  }

  $('.save-starting-point-field').change(function(){
    setTimeout(function(){ 
      if (locks_input){
        var lock = $(locks_input)[0];
        if(lock.value == "")
            lock.setCustomValidity('')

        if(lock.checkValidity() == true){
          lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
          input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
          $("#" + lock.id).closest('form').append(input)
          $('.save-starting-point-form').submit(); 
        }
        else{ 
          //lock.reportValidity(); 
          $('.save-starting-point-form').submit();
        }
      }
      else
        $('.save-starting-point-form').submit();
    }, 300);
  });

  function starting_point_goBack()
  {
    if ($('#lock_provider').val().length > 0 ){
      if (locks_input){
          var lock = $(locks_input)[0];
          if(typeof lock !== 'undefined'){
            if(lock.value == "")
                lock.setCustomValidity('')

            if(lock.checkValidity() == true){
              lock_id = $(locks_list + ' [value="' + lock.value + '"]').data('value')
              input = $("<input>").attr("type", "hidden").attr("name", param_name).val(lock_id);
              $("#" + lock.id).closest('form').append(input)
              $('.save-starting-point-form').submit(); 
            }
            else{ 
              //lock.reportValidity(); 
              $('.save-starting-point-form').submit();
            }
          }
          else
            $('.save-starting-point-form').submit(); 
      }
      else
        $('.save-starting-point-form').submit();
    }  
  }
  function goBack(){
    window.location.href = '/communities/#{@community.id}/tours';
  }
  if (#{@tours.x_plot.to_i + @tours.y_plot.to_i == 0})
  {
    document.getElementById("m_7").disabled = false;
  }
  else
  {
    document.getElementById("m_7").disabled = true;
  }
  $('#m_7').click(function() {
    document.getElementById("m_7").disabled = true;
   });
  var tour_id = #{@tours.id};
  var unitsArr = #{raw tour_points.to_json};
  var lmargin = 0;
  var rmargin = 0;
  var addmode = false;
  var community_id = #{params[:community_id]}
  // var map;
  // function initMap() {
  //   map = new google.maps.Map(document.getElementById('map'), {
  //     center: {lat: -34.397, lng: 150.644},
  //     zoom: 8
  //   });
  // }
  // map = new google.maps.Map(document.getElementById('map'), {
  //     center: {lat: -34.397, lng: 150.644},
  //     zoom: 8
  // });
   // var historicalOverlay;
   //
   //    function initMap() {
   //      var map = new google.maps.Map(document.getElementById('map2'), {
   //        zoom: 22,
   //        center: {lat: 0}, lng: 0},
   //
   //      });
   //       map.setInterval(rotate90, 3000);
   //      // var imageBounds = {
   //      //   north: 31.484598,
   //      //   south: 31.484447,
   //      //   east:  74.409449,
   //      //   west: 74.409385
   //      // };
   //      var imageBounds = new google.maps.LatLngBounds(
   //        new google.maps.LatLng(31.484447, 74.409385),
   //        new google.maps.LatLng(31.484598, 74.409449),
   //      );
   //
   //      historicalOverlay = new google.maps.GroundOverlay(
   //          'abc.png',
   //          imageBounds );
   //      historicalOverlay.setMap(map);
   //    }
  if (locks_input){
    var inputs = document.querySelectorAll('input[list]');
    for (var i = 0; i < inputs.length; i++) {
      inputs[i].addEventListener('change', function() {
        var optionFound = false,
        datalist = this.list;
        for (var j = 0; j < datalist.options.length; j++) {
            if (this.value == datalist.options[j].value) {
                optionFound = true;
                break;
            }
        }
        if (optionFound) {
          this.setCustomValidity('');
        } else {
          if ( $(locks_input).val() != "" )
              this.setCustomValidity('Lock does not exist');
        }
      });
    }
  }