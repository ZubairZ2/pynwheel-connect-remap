  $('#schedule-btn-submit').click(function( event ){
    var days = []
    var times_list = $(".bg-grey-v")
    var times_hash = {}
    var i = 0;
    $(".list").children().children('select').each(function(){
      var selected = '#' + $(this).attr('id') + ' :selected'
      var day_ = $(selected).text()
      if(times_hash[day_] == undefined)
      {
        times_hash[day_] = []
      }
