
:css

  .text-grey-v {
      color: #9E9E9E
  }
  
  .fa-v {
      font-size: 25px;
      cursor: pointer
  }
  .day-list {
      padding: 2px 6px;
      border: none;
      border-bottom: 1px solid #bdb7b7;
      border-radius: none;
      box-sizing: border-box;
      color: #000000;
      background-color: transparent;
      font-size: 14px;
      letter-spacing: 1px;
      text-align: center !important
  }
  .day-list-guided {
      padding: 2px 6px;
      border: none;
      border-bottom: 1px solid #bdb7b7;
      border-radius: none;
      box-sizing: border-box;
      color: #000000;
      background-color: transparent;
      font-size: 14px;
      letter-spacing: 1px;
      text-align: center !important
  }
  input[type=time] {
    border: none;
    color: #2a2c2d;
    font-size: 14px;
    font-family: helvetica;
    width: 150px;
  }


  input[type=time]::-webkit-clear-button {
    display: none;
  }

  input[type=time]::-webkit-inner-spin-button {
    display: none;
  }
  
  ::placeholder {
      color: #fff;
      opacity: 1
  }
  
  :-ms-input-placeholder {
      color: #fff
  }
  
  ::-ms-input-placeholder {
      color: #fff
  }
  
  .btn-v {
      border-radius: 50px;
      width: 120px
  }

  .font-17-v{
    font-size: 17px !important;
  }

  .p-20-v{
      padding-left: 20px;
      padding-bottom: 35px
  }
  .p-8-v{
    padding: 8px;
  }
  .p-4-v{
    padding: 4px;
  }
  .mr-20-v{
    margin-right: 20px !important;
  }
  .mr-10-v{
    margin-right: 10px !important;
  }
  .bg-grey-v{
    background: #e3e3e3;
  }
  .bg-grey-v-guided{
    background: #e3e3e3;
  }

  .pt-5-v{
    padding-top: 5px !important;
  }
  .error-msg-v {
    margin-left: 450px;
    color: white;
  }
  .max-users-v {
    width: 125px;
    border-style: groove;
    border-color: #d8d8d8;
    border-width: 2px;
  }
  @media screen and (min-width: 1300px) {
    .add_minutes_span {
      margin-left: -4%;
    }
  }
  @media screen and (max-width: 1100px) {
    .add_minutes_span {
      margin-left: 4%;
    }
  }
  @media screen and (min-width: 1101px, max-width: 1299px) {
    .add_minutes_span {
      margin-left: 0%;
    }
  }

- content_for :title, "Pynwheel Tour Settings - Pynwheel"
.divLoading.hidden
- left_margin = ((@community.design.property_map_size_integer.to_f - 25) / 2.0).to_i rescue 0
- right_margin = ((20.0 / 25.0).to_f * (@community.design.property_map_size_integer)).to_i rescue 0
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          Pynwheel TOUR SETTINGS
          %span
        -# = link_to("EdgeState Account", "edgestate_accounts/new" , class: "btn btn-primary", style: "float:right")
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30.pb-40
          = form_tag community_save_tour_settings_path(@community) ,{:class => 'tour-settings-form'} do
            = hidden_field_tag "community_id", @community.id
            - if @community.self_tour
              .form-group#chat_control_row
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Chat Control
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :chat_control, true,  @community.chat_control
                    %label.label-primary{:for => "chat_control"}
                    %span.pl-15 Yes
            
            - if @community.touchscreen_app   
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Show "Start Tour" in Pynwheel Touch
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "1Popover","data-content" => " "}
                    %span#propertyDetailNameText
                      When this is switched to "yes" there will be a "Start Tour" button in the menu on your Pynwheel Touch app. When touched, the user will enter their cell phone umber or scan a QR code and receive a link to download / open the Pynwheel Tour app. 
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :show_tour_page, true, @community.show_tour_page, class: "show-tour-page"
                    %label.label-primary{:for => "show_tour_page"}
                    %span.pl-15 Yes

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                ID verification
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "2Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    When this is switched to "yes" the app will request that the in-person visitors upload an image of their ID and their face so that we can check the validity of the ID and match their identity. Please Note: There may be a cost associated with this service.
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :visual_id_verification, true, @community.community_tour.visual_id_verification, class: "visual-id-verification"
                  %label.label-primary{:for => "visual_id_verification"}
                  %span.pl-15 Yes
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15

                Charge User for ID Verfication
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "2Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    When set to “Yes” users will be charged $2.00 each time their ID is verified. When set to “No” the property will be charged each time the user’s ID is verified.
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :charge_user_for_id_verfication, true, @community.community_tour.tour_setting.charge_user_for_id_verfication  , class: "charge_user_for_id_verfication"
                  %label.label-primary{:for => "charge_user_for_id_verfication"}
                  %span.pl-15 Yes    
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Enable auto zoom
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "2Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    Auto-zoom on property map between stops.
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :enable_auto_zoom, true, @community.community_tour.enable_auto_zoom, class: "enable_auto_zoom"
                  %label.label-primary{:for => "enable_auto_zoom"}
                  %span.pl-15 Yes 
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Show Camera Button
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "3Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    When this is switched to "yes" the app will include a camera button that the prospect can use to take photos on tour. 
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :show_camera_button, true, @community.show_camera_button, class: "show-camera-button"
                  %label.label-primary{:for => "show_camera_button"}
                  %span.pl-15 Yes
            - unless @community&.credential&.use_different_crm_provider && @community&.crm_credential&.crm_provider == "salesforce"              
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Scheduler Tool
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "4Popover","data-content" => " "}
                    %span#propertyDetailNameText
                      If you plan on using the Pynwheel Scheduler tool to allow users to schedule Pynwheel Tours on your website, switch this to "Yes". You can then add email / text confirmation text below and get the scheduler widget code in the menu on the left.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :scheduler_widget, true, @community.scheduler_widget.nil? ? true : @community.scheduler_widget  , class: "scheduler_widget"
                    %label.label-primary{:for => "scheduler_widget"}
                    %span.pl-15 Yes
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Allow Restricted Access
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "4Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    Enabling this toggle will allow only visitors with property code to start a tour. 
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :enable_restricted_property_access, true, @community.community_tour.tour_setting.enable_restricted_property_access, class: "enable_restricted_property_access" 
                  %label.label-primary{:for => "enable_restricted_property_access"}
                  %span.pl-15 Yes
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15

                Set Max Tours at One Time
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "4Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    Limit the number of tours that can be taken at one time. 
                
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :do_limit_max_tour, true, @community.community_tour.tour_setting.do_limit_max_tour  , class: "do_limit_max_tour"
                  %label.label-primary{:for => "do_limit_max_tour"}
                  %span.pl-15 Yes      
            
            .form-group.limit_max_tour_class.hidden
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Max Tours at One Time
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "4Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    Enter the maximum number of in-person tours you would like at the property at one time. Leave blank if there is no limit.
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                %input.day-list.max-users-v.form-control{type: "number", id: "limit_max_tour", name: "limit_max_tour", min: "1", max: "60", step: "1", onkeydown: "return false", value: @community.community_tour.tour_setting.limit_max_tour}         
            - if @tour_setting.allow_self_tour.nil? || @tour_setting.allow_self_tour
              .form-group.limit_max_tour_class.hidden
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Max App Guided Tours at One Time
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "7Popover","data-content" => " "}
                    %span#propertyDetailNameText
                      Enter the maximum number of app guided tours visitors you would like at the property at one time. Leave blank if there is no limit. 
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  %input.day-list.max-users-v.form-control{type: "number", id: "max_self_tour_users", name: "max_self_tour_users", min: "1", max:"10", value: @community.community_tour.max_self_tour_users}
            - if (@tour_setting.allow_guided_tour.nil? || @tour_setting.allow_guided_tour) && !@community.is_salesforce_community?
              .form-group.limit_max_tour_class.hidden
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Max Person Guided Tours at One Time
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "7Popover","data-content" => " "}
                    %span#propertyDetailNameText
                      Enter the maximum number of person guided tours visitors you would like at the property at one time. Leave blank if there is no limit. 
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  %input.day-list.max-users-v.form-control{type: "number", id: "max_guided_tour_users", name: "max_guided_tour_users", min: "1", max:"10", value: @community.community_tour.max_guided_tour_users}    
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Length of tour
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "7Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    If a visitor stays on tour past the time allotted here, the property will get a notification to check in with them.
                    - if @community.community_tour.tour_setting.enable_restricted_property_access
                      Also, property access code will be expired after this time period.
              .col-sm-12.col-lg-2.col-md-2.col-xs-12
                %input.day-list.max-users-v.form-control{type: "number", id: "length_stay_limit", name: "length_stay_limit", min: "10", max:"300", value: @community.community_tour.tour_setting.length_stay_limit} 
              .col-sm-12.col-lg-2.col-md-2.col-xs-12.add_minutes_span{:style => "margin-top: 13px;"}
                %span
                  Minutes
            - unless @community.is_sitemap
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15{:style => "padding-right: 0px;"}
                  Bypass Access Control en route to starting point
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "4Popover","data-content" => " "}
                    %span#propertyDetailNameText
                      Enabling this toggle will allow prospects to bypass access control en route to starting point
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :bypass_stop_lock_access, true, @community.community_tour.tour_setting.bypass_stop_lock_access, class: "bypass_stop_lock_access" 
                    %label.label-primary{:for => "bypass_stop_lock_access"}
                    %span.pl-15 Yes

            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Allow Customize Tours in Pynwheel Tour
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "4Popover","data-content" => " "}
                  %span#propertyDetailNameText
                    Enabling this toggle will allow prospects to choose available units and amenities of their own choice to customize their tours 
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :enable_tour_customization, true, @community.community_tour.tour_setting.enable_tour_customization, class: "enable_tour_customization" 
                  %label.label-primary{:for => "enable_tour_customization"}
                  %span.pl-15 Yes
            
            - if current_user.is_super_admin?
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Add Unit Stops Based on Availability
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "6Popover","data-content" => " "}
                    %span#propertyDetailNameText
                      Selecting this option will automate which vacant units will appear in the tour. One vacant unit per available floor plan will appear in the list each day. You can hide or unhide units in the list below.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :automate_unit_stop, true, @community.automate_unit_stop, class: "automate-unit-stop"
                    %label.label-primary{:for => "automate_unit_stop"}
                    %span.pl-15 Yes

              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Dotted line color
                .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  = select_tag :dotted_line_color, options_for_select(Tour::DOTTED_LINE_COLORS.map { |name, code| [name, code] }, @community.community_tour.dotted_line_color), class: "form-control"


            
            .box-footer  
              = submit_tag 'Save', class: "btn btn-success pull-right mr-10", style: "margin-bottom: -36px;"
    ///////////////////// Scheduler Widget setting /////////////////////////
    - if @community.scheduler_widget || @community.scheduler_widget.nil?
      -unless @community&.credential&.use_different_crm_provider && @community&.crm_credential&.crm_provider == "salesforce"
        .box.box-info.add-plan.mt-20#logo_header
          .box-header
            %h3.box-title
              SCHEDULER WIDGET
              %span
          .box-body{style: "padding: 0px 20px !important;"}
            .row
              .col-lg-12 
                = form_tag community_save_tour_settings_path(@community) ,{:class => 'tour-settings-form', :style => "margin-top: 40px;"} do
                  = hidden_field_tag "community_id", @community.id
                  = hidden_field_tag :widget_settings, value: "widget_settings"
                  .div_checklist.hidden{:style => "margin-left: 15px;"}
                    %label Tour Types Offered
                      
                    %br
                    %br  
                    .col-sm-12.col-lg-12.col-md-12.col-xs-12
                      .row
                        .col-sm-6.col-lg-6.col-md-4.col-xs-12
                          .checkbox
                            = check_box_tag :allow_self_tour, true, @tour_setting.allow_self_tour.nil? ? true :  @tour_setting.allow_self_tour
                            %label App Guided Tour

                    .col-sm-12.col-lg-12.col-md-12.col-xs-12
                      .row
                        .col-sm-6.col-lg-6.col-md-4.col-xs-12
                          .checkbox
                            = check_box_tag :allow_guided_tour, true, @tour_setting.allow_guided_tour.nil? ? true : @tour_setting.allow_guided_tour
                            %label Person Guided Tour

                    -# .col-sm-12.col-lg-12.col-md-12.col-xs-12
                    -#   .row
                    -#     .col-sm-6.col-lg-6.col-md-4.col-xs-12
                    -#       .checkbox
                    -#         = check_box_tag :allow_virtual_tour, true, @tour_setting.allow_virtual_tour.nil? ? true : @tour_setting.allow_virtual_tour
                    -#         %label Virtual Tour

                  .div_checklist.hidden{:style => "margin-left: 15px; margin-top: 40px;"}
                    %label Select Fields
                    .form-group{:style => "height: 190px; margin-top: ;"}
                      -# .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      -#   .row
                      -#     .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      -#       .checkbox
                      -#         = check_box_tag :show_first_name, true, @tour_setting.show_first_name.nil? ? true :  @tour_setting.show_first_name
                      -#         %label Name
                      -# .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      -#   .row
                      -#     .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      -#       .checkbox
                      -#         = check_box_tag :show_email, true, @tour_setting.show_email.nil? ? true : @tour_setting.show_email
                      -#         %label Email Address
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .row
                          .col-sm-6.col-lg-6.col-md-4.col-xs-12
                            .checkbox
                              = check_box_tag :show_desired_bedroom, true, @tour_setting.show_desired_bedroom.nil? ? true : @tour_setting.show_desired_bedroom
                              %label Desired bedrooms
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .row
                          .col-sm-6.col-lg-6.col-md-4.col-xs-12
                            .checkbox
                              = check_box_tag :show_desired_move_in_date, true, @tour_setting.show_desired_move_in_date.nil? ? true : @tour_setting.show_desired_move_in_date
                              %label Desired move-in date
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .row
                          .col-sm-6.col-lg-6.col-md-4.col-xs-12
                            .checkbox
                              = check_box_tag :credit_card_required, true, @community.community_tour.credit_card_required
                              %label Credit card required
                      - if @community.data_provider == "realpagesvc"
                        .col-sm-12.col-lg-9.col-md-9.col-xs-12
                          .row
                            .col-sm-6.col-lg-6.col-md-4.col-xs-12
                              .checkbox
                                = check_box_tag :marketing_source_required, true, @community.community_tour.marketing_source_required
                                %label Lead source
                  .div_checklist{:class => "#{(@community.credential.present? and  @community.crm_credential.present? and @community.crm_credential.crm_provider.present? and @community.crm_credential.crm_provider == "salesforce") ? '' : ( (@community.scheduler_widget.present? and @community.scheduler_widget == true) ? '' : 'hidden')}"}
                    .form-group
                      %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                        Only allow scheduled tours
                        %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "5Popover","data-content" => " "}
                          %span#propertyDetailNameText
                            Only give on-site access via the Pynwheel Tour app to users who have scheduled a tour in advance and start their tour at the scheduled time.
                      .col-sm-12.col-lg-9.col-md-9.col-xs-12
                        .TriSea-technologies-Switch
                          %span.pr-15 No
                          = check_box_tag :only_scheduled_tour, true, @community.community_tour.only_scheduled_tour , class: "only_scheduled_tour"
                          %label.label-primary{:for => "only_scheduled_tour"}
                          %span.pl-15 Yes
                    .dev{:style => "margin-left: 60px;margin-top: -10px;margin-bottom: -10px;"}
                      .form-group.hidden#grace_time_period
                        .col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15{style:"margin-right: -35px;"}
                          Grace period
                        .col-sm-12.col-lg-9.col-md-9.col-xs-12
                          %input.day-list.max-users-v.form-control{type: "number", id: "grace_time", name: "grace_time", min: "10", max: "60", step: "5", onkeydown: "return false", value: @community.community_tour.grace_period}              
                  
                  .form-group
                    %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label.font-size-15
                      Allow Visitors to Schedule Tours in the following time increments:
                      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "8Popover","data-content" => " "}
                        %span#propertyDetailNameText
                          Choose the time increments for scheduled tours. 
                  .row 
                    .form-group
                      .form-group.col-lg-6.col-md-6
                        
                        .col-sm-1.col-lg-1.col-md-1.col-xs-1
                          .row
                            .col-sm-6.col-lg-6.col-md-4.col-xs-12.time_intervel_class
                              .radiobutton.check_t
                                = radio_button_tag :time_intervel_15, true, @tour_setting.time_intervel == "15 min" ? true : false, :id => "time_intervel_id15"
