        line = createLine(path_array[path_array.length-1], path_array[path_array.length-2])
        $(".plot-image").append(line)
      }
      else if(db_data.line_start_point == null){
        line = createLine(path_array[path_array.length-1], path_array[path_array.length-2])
        $(".plot-image").append(line) 
      }
