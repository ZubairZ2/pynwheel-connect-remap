        = select_tag "tour_stop_ids", options_for_select(select_tag_amenity, ""), :class => 'chosen-select-amenity',:"data-placeholder" => "- select amenity -", :multiple => "multiple", :name => "amenity_data_selected", style: "width: 100%;"  
        %input{:type => "submit", :id=> 'add_amenity_to_stop', :class => 'hidden', :style => "border-radius: 6px; margin-top: 6px;"}/     

      - if @community.mdu
        - units = @units.sort_by{|u| u.marketing_name}
        .col-lg-6
          %h5.mt-40.mb-20
            Add Units
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "add_unit_Popover","data-content" => " "}
