      .box-header
        %h3.box-title
          TOUR SETUP PAGE
          %span
        -# = link_to("EdgeState Account", "edgestate_accounts/new" , class: "btn btn-primary", style: "float:right")
    
    - unless @community.is_sitemap
      - unless @building_list.count < 2
        %h3 Select a Building
        .building_sortable#building_buttons
