        stop_ids = [stop_1_id, stop_2_id]
        stop_types = [stop_1_type, stop_2_type]
        $.ajax({
          type: "POST",
          url: this.href,
          data: {stop_ids: stop_ids, stop_types: stop_types},
          success: function(response) {
            if (response.path_points.length > 0) {
