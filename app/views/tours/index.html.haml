    function detectNearestUnits(){
      neighbour_unit_ids = []
      $.each(cords_arr, function(index, unit){
        xp = Math.pow((unit.x - mouseX), 2)
        yp = Math.pow((unit.y - mouseY), 2)

        d = Math.sqrt(xp + yp)
        if(d <= radius)
          neighbour_unit_ids.push(index)
      });
      
      return neighbour_unit_ids
    }

