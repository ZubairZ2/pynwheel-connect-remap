
:css

  .text-grey-v {
      color: #9E9E9E
  }
  
  .fa-v {
      font-size: 25px;
      cursor: pointer
  }

  .day-list {
      padding: 2px 6px;
      border: none;
      border-bottom: 1px solid #bdb7b7;
      border-radius: none;
      box-sizing: border-box;
      color: #000000;
      background-color: transparent;
      font-size: 14px;
      letter-spacing: 1px;
      text-align: center !important
  }
  input[type=time] {
    border: none;
    color: #2a2c2d;
    font-size: 14px;
    font-family: helvetica;
    width: 150px;
  }



  input[type=time]::-webkit-clear-button {
    display: none;
  }

  input[type=time]::-webkit-inner-spin-button {
    display: none;
  }
  
  ::placeholder {
      color: #fff;
      opacity: 1
  }
  
  :-ms-input-placeholder {
      color: #fff
  }
  
  ::-ms-input-placeholder {
      color: #fff
  }
  
  .btn-v {
      border-radius: 50px;
      width: 120px
  }

  .font-17-v{
    font-size: 17px !important;
  }

  .p-20-v{
      padding-left: 20px;
      padding-bottom: 35px
  }
  .p-8-v{
    padding: 8px;
  }
  .p-4-v{
    padding: 4px;
  }
  .mr-20-v{
    margin-right: 20px !important;
  }
  .mr-10-v{
    margin-right: 10px !important;
  }
  .bg-grey-v{
    background: #e3e3e3;
  }

  .pt-5-v{
    padding-top: 5px !important;
  }
  .error-msg-v {
    margin-left: 450px;
    color: white;
  }
  .max-users-v {
    width: 125px;
    border-style: groove;
    border-color: #d8d8d8;
    border-width: 2px;
  }

- content_for :title, "Tour Setup Page - Pynwheel"
.divLoading.hidden
- left_margin = ((@community.design.property_map_size_integer.to_f - 25) / 2.0).to_i
- right_margin = ((20.0 / 25.0).to_f * (@community.design.property_map_size_integer)).to_i
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          TOUR SETUP PAGE
          %span
        -# = link_to("EdgeState Account", "edgestate_accounts/new" , class: "btn btn-primary", style: "float:right")
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30.pb-40
          = form_tag community_save_tour_settings_path(@community) ,{:class => 'tour-settings-form'} do
            = hidden_field_tag "community_id", @community.id

            .form-group.alert-contact
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Alert Contact

              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                = collection_radio_buttons(:community, :alert_contact, Community.alert_contacts, :first, :first, {}, {class: "btn"})
                = submit_tag 'Update', class: "btn btn-success btn-sm pull-right"
            - if @community.touchscreen_app   
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Show "Start Tour" in Pynwheel Touch
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "secondaryLogoPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      When this is set to "on" there will be a "Start Tour" button in your Pynwheel Touch app. When touched, the user will enter their cell phone number or scan a QR code and receive a link to download / open the Self Tour app.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :show_tour_page, true, @community.show_tour_page, class: "show-tour-page"
                    %label.label-primary{:for => "show_tour_page"}
                    %span.pl-15 Yes
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Visual id verification
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :visual_id_verification, true, @community.tour.visual_id_verification, class: "visual-id-verification"
                  %label.label-primary{:for => "visual_id_verification"}
                  %span.pl-15 Yes
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Show Camera Button
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :show_camera_button, true, @community.show_camera_button, class: "show-camera-button"
                  %label.label-primary{:for => "show_camera_button"}
                  %span.pl-15 Yes
            / .form-group
            /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            /     Visual id verification
            /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
            /     .TriSea-technologies-Switch
            /       %span.pr-15 No
            /       = check_box_tag :visual_id_verification, true, @community.tour.visual_id_verification, class: "visual-id-verification"
            /       %label.label-primary{:for => "visual_id_verification"}
            /       %span.pl-15 Yes 
            / .form-group
            /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            /     Add fields to the registration page
            /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
            /     .TriSea-technologies-Switch
            /       %span.pr-15 No
            /       = check_box_tag :show_checklist, true, @tour_setting.show_checklist, class: "show_checklist"
            /       %label.label-primary{:for => "show_checklist"}
            /       %span.pl-15 Yes 
            
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Scheduler Widget
                %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "secondaryLogoPopover","data-content" => " "}
                  %span#propertyDetailNameText
                    If you plan on using the Pynwheel Scheduler widget to allow users to schedule Self Tours on your website, switch this to "Yes". Tou can then add email / text confirmation text below and get the scheduler widget code in the menu on the left.
              .col-sm-12.col-lg-9.col-md-9.col-xs-12
                .TriSea-technologies-Switch
                  %span.pr-15 No
                  = check_box_tag :scheduler_widget, true, @community.scheduler_widget.nil? ? true : @community.scheduler_widget  , class: "scheduler_widget"
                  %label.label-primary{:for => "scheduler_widget"}
                  %span.pl-15 Yes
            .div_checklist.hidden{:style => "margin-left: 60px;"}
              %label Select Fields for Schedule Widget:
              .form-group{:style => "height: 190px; margin-top: ;"}
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .row
                    .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      .checkbox
                        = check_box_tag :show_first_name, true, @tour_setting.show_first_name.nil? ? true :  @tour_setting.show_first_name
                        %label Name
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .row
                    .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      .checkbox
                        = check_box_tag :show_phone, true, @tour_setting.show_phone.nil? ? true : @tour_setting.show_phone
                        %label Phone
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .row
                    .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      .checkbox
                        = check_box_tag :show_desired_bedroom, true, @tour_setting.show_desired_bedroom.nil? ? true : @tour_setting.show_desired_bedroom
                        %label Desired bedrooms
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .row
                    .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      .checkbox
                        = check_box_tag :show_desired_move_in_date, true, @tour_setting.show_desired_move_in_date.nil? ? true : @tour_setting.show_desired_move_in_date
                        %label Desired move-in date
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .row
                    .col-sm-6.col-lg-6.col-md-4.col-xs-12
                      .checkbox
                        = check_box_tag :credit_card_required, true, @community.tour.credit_card_required
                        %label Credit card required
                - if @community.data_provider == "realpagesvc"
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    .row
                      .col-sm-6.col-lg-6.col-md-4.col-xs-12
                        .checkbox
                          = check_box_tag :marketing_source_required, true, @community.tour.marketing_source_required
                          %label Lead source
              / .form-group
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              /     Display name
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = check_box_tag :show_first_name, true, @tour_setting.show_first_name, class: "show_first_name"
              /       %label.label-primary{:for => "show_first_name"}
              /       %span.pl-15 Yes
              / .form-group
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              /     Display last name
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = check_box_tag :show_last_name, true, @tour_setting.show_last_name, class: "show_last_name"
              /       %label.label-primary{:for => "show_last_name"}
              /       %span.pl-15 Yes
              / .form-group
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              /     Display phone
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = check_box_tag :show_phone, true, @tour_setting.show_phone, class: "show_phone"
              /       %label.label-primary{:for => "show_phone"}
              /       %span.pl-15 Yes
              / .form-group
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              /     Display email
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = check_box_tag :show_email, true, @tour_setting.show_email, class: "show_email"
              /       %label.label-primary{:for => "show_email"}
              /       %span.pl-15 Yes
              / .form-group
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              /     Display desired bedroom
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = check_box_tag :show_desired_bedroom, true, @tour_setting.show_desired_bedroom, class: "show_desired_bedroom"
              /       %label.label-primary{:for => "show_desired_bedroom"}
              /       %span.pl-15 Yes
              / .form-group
              /   %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
              /     Display desired move in date
              /   .col-sm-12.col-lg-9.col-md-9.col-xs-12
              /     .TriSea-technologies-Switch
              /       %span.pr-15 No
              /       = check_box_tag :show_desired_move_in_date, true, @tour_setting.show_desired_move_in_date, class: "show_desired_move_in_date"
              /       %label.label-primary{:for => "show_desired_move_in_date"}
              /       %span.pl-15 Yes

              /       %span.pl-15 Yes
            .div_checklist.hidden
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Only allow scheduled tours
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "secondaryLogoPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Unscheduled and early or late arrived guests before or after the scheduled time will get proper customizable messages.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :only_scheduled_tour, true, @community.tour.only_scheduled_tour , class: "only_scheduled_tour"
                    %label.label-primary{:for => "only_scheduled_tour"}
                    %span.pl-15 Yes
              .dev{:style => "margin-left: 60px;margin-top: -10px;margin-bottom: -10px;"}
                .form-group.hidden#grace_time_period
                  .col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15{style:"margin-right: -35px;"}
                    Grace period
                  .col-sm-12.col-lg-9.col-md-9.col-xs-12
                    %input.day-list.max-users-v{type: "number", id: "grace_time", name: "grace_time", min: "5", max: "60", step: "5", onkeydown: "return false", value: @community.tour.grace_period}
            - if current_user.is_super_admin?
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Add Unit Stops Based in Availability
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Selecting this option will automate which vacant units that appear in the tour. One vacant unit per available floor plan will appear in the list each day. You can hide or unhide units in the list below.
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  .TriSea-technologies-Switch
                    %span.pr-15 No
                    = check_box_tag :automate_unit_stop, true, @community.automate_unit_stop, class: "automate-unit-stop"
                    %label.label-primary{:for => "automate_unit_stop"}
                    %span.pl-15 Yes
            .form-group
              %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                Dotted line color
              .col-sm-12.col-lg-6.col-md-6.col-xs-12
                = select_tag :dotted_line_color , options_for_select([ "Green", "White","Black" ], @community.tour.dotted_line_color.humanize),:class => "form-control"
            
            - if (current_community.scheduler_widget.nil? ? true : current_community.scheduler_widget )
              .form-group
                %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                  Max Tour At One Time
                .col-sm-12.col-lg-9.col-md-9.col-xs-12
                  %input.day-list.max-users-v{type: "number", id: "max_tour_users", name: "max_tour_users", min: "1", max:"10", value: @community.tour.max_tour_users}
              .form-group
                %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label.font-size-15
                  Allow visitors to schedule tours
              .row 
                .form-group
                  .form-group.col-lg-6.col-md-6
                    
                    .col-sm-1.col-lg-1.col-md-1.col-xs-1
                      .row
                        .col-sm-6.col-lg-6.col-md-4.col-xs-12.time_intervel_class
                          .radiobutton.check_t
                            = radio_button_tag :time_intervel_15, true, @tour_setting.time_intervel == "15 min" ? true : false, :id => "time_intervel_id15"
                    %label.col-sm-12.col-lg-6.col-md-6.col-xs-12
                      In 15 minute increments (ie, 10:00, 10:15, 10:30)
                  .form-group.col-lg-6.col-md-6
                    
                    .col-sm-1.col-lg-1.col-md-1.col-xs-1
                      .row
                        .col-sm-6.col-lg-6.col-md-4.col-xs-12.time_intervel_class
                          .radiobutton.check_t
                            = radio_button_tag :time_intervel_1, true, @tour_setting.time_intervel == "1 hr" ? true : false, :id => "time_intervel_id1"
                    %label.col-sm-12.col-lg-6.col-md-6.col-xs-12
                      In hourly increments (ie, 10:00, 11:00, 12:00)        
              .row 
                .form-group
                  .form-group.col-lg-6.col-md-6
                    
                    .col-sm-1.col-lg-1.col-md-1.col-xs-1
                      .row
                        .col-sm-6.col-lg-6.col-md-4.col-xs-12.time_intervel_class
                          .radiobutton.check_t
                            = radio_button_tag :time_intervel_30, true, @tour_setting.time_intervel == "30 min" ? true : false, :id => "time_intervel_id30"
                    %label.col-sm-12.col-lg-6.col-md-6.col-xs-12
                      In 30 minute increments (ie, 10:00, 10:30, 11:00)        
                  .form-group.col-lg-6.col-md-6
                    
                    .col-sm-1.col-lg-1.col-md-1.col-xs-1
                      .row
                        .col-sm-6.col-lg-6.col-md-4.col-xs-12.time_intervel_class
                          .radiobutton.check_t
                            = radio_button_tag :time_intervel_2, true, @tour_setting.time_intervel == "2 hrs" ? true : false, :id => "time_intervel_id2"
                    %label.col-sm-12.col-lg-6.col-md-6.col-xs-12
                      Every 2 hours (ie, 10:00, 12:00, 2:00)        
               
            -#.form-groups
            -#  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            -#    Show Notepad Button
            -#  .col-sm-12.col-lg-9.col-md-9.col-xs-12
            -#    .TriSea-technologies-Switch
            -#      %span.pr-15 No
            -#      = check_box_tag :show_notepad_button, true, @community.show_notepad_button, class: "show-notepad-button"
            -#      %label.label-primary{:for => "show_notepad_button"}
            -#      %span.pl-15 Yes
            -#.form-group.mt-30
            -#  %label.col-sm-16.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
            -#    Self Tour icon size
            -#  .col-sm-12.col-lg-6.col-md-6.col-xs-12
            -#    = select_tag :marker_icon_size , options_for_select(self_tour_icon_size,@community.tour.marker_icon_size ), :class => "form-control"
            = submit_tag 'Save', class: "hidden"
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          VISITING HOURS
          %span
      %i.fa.fa-v.fa-check-circle#save_hours{ style: "color: green; display: none;"}
      %i.fa.fa-v.fa-check-circle#save_hours{ style: "color: white"}
      %h4.error-msg-v#same-days{style: "margin-top: 0px; margin-bottom: 0px;"} same time exists or invalid time

      .box-body{style: "padding: 0px 20px !important;"}
        .row
          .col-lg-12 
            = form_tag save_opening_hours_community_tours_path(@community) ,{:class => 'tour-settings-form'} do
              .col-sm-12.list
                - @community.opening_hours.each_with_index do |current_day,index| 
                  .row.p-8-v
                    %select.day-list.font-17-v.pull-left.mr-20-v{id: "day_#{index+1}",name: "day_#{index+1}"}
                      - if current_day.day == "Monday"
                        %option{selected: "", value: "Monday"} Monday
                      - else
                        %option{value: "Monday"} Monday
                      - if current_day.day == "Tuesday"
                        %option{selected: "", value: "Tuesday"} Tuesday
                      - else
                        %option{value: "Tuesday"} Tuesday
                      - if current_day.day == "Wednesday"
                        %option{selected: "", value: "Wednesday"} Wednesday
                      - else
                        %option{value: "Wednesday"} Wednesday
                      - if current_day.day == "Thursday"
                        %option{selected: "", value: "Thursday"} Thursday
                      - else
                        %option{value: "Thursday"} Thursday
                      - if current_day.day == "Friday"
                        %option{selected: "", value: "Friday"} Friday
                      - else
                        %option{value: "Friday"} Friday
                      - if current_day.day == "Saturday"
                        %option{selected: "", value: "Saturday"} Saturday
                      - else
                        %option{value: "Saturday"} Saturday
                      - if current_day.day == "Sunday"
                        %option{selected: "", value: "Sunday"} Sunday
                      - else
                        %option{value: "Sunday"} Sunday
                    .font-17-v.pull-left.mr-20-v
                      .p-4-v.pull-left.mr-10-v
                        %label.text-grey-v From
                      %input.day-list.bg-grey-v{name: "from_#{index+1}", type: "time", value: "#{current_day.opening_time}", id: "from_t"}
                    .font-17-v.pull-left.mr-20-v
                      .p-4-v.pull-left.mr-10-v
                        %label.text-grey-v To
                      %input.day-list.bg-grey-v{name: "to_#{index+1}", type: "time", value: "#{current_day.closing_time}", id: "to_t"}
                    .font-17-v.pt-5-v.cancel.fa.fa-v.fa-times.text-danger
                - if @community.opening_hours.blank?
                  .row.p-8-v
                    %select.day-list.font-17-v.pull-left.mr-20-v#day_1{name: "day_1"}
                      %option{selected: "", value: "Monday"} Monday
                      %option{value: "Tuesday"} Tuesday
                      %option{value: "Wednesday"} Wednesday
                      %option{value: "Thursday"} Thursday
                      %option{value: "Friday"} Friday
                      %option{value: "Saturday"} Saturday
                      %option{value: "Sunday"} Sunday
                    .font-17-v.pull-left.mr-20-v
                      .p-4-v.pull-left.mr-10-v
                        %label.text-grey-v From
                      %input.day-list.bg-grey-v{name: "from_1", type: "time", value: "09:00"}
                    .font-17-v.pull-left.mr-20-v
                      .p-4-v.pull-left.mr-10-v
                        %label.text-grey-v To
                      %input.day-list.bg-grey-v{name: "to_1", type: "time", value: "05:00"}
                    .font-17-v.pt-5-v.cancel.fa.fa-v.fa-times.text-danger
              .asd{style: "padding-bottom: 20px;"}
                %button.btn.btn-primary#add-btn{style: "margin-left: 10;"}
                  %span.fa.fa-v.fa-plus.font-17-v
                  Add
                %input.btn.btn-success.pull-right.mr-10#schedule-btn-submit{type: "submit", value: "Save"}
    #logo_header.box.box-info.add-plan.mt-50.hidden
      .box-header
        %h3.box-title
          COMPOSE TEXT/EMAILS
          %span
    
    .row
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30{style: "margin-top: 60px;"}
          = form_for @community,:url=>community_save_tour_settings_path(@community),:html=>{:class=>"form-horizontal"}, method: :post do |f|
            = f.hidden_field :community_id, value: @community.id
            = f.hidden_field :optional_mails, value: "optional_mails"
            .box-body
