                  = check_box_tag :show_tour_page, true, @community.show_tour_page, class: "show-tour-page"
                  %label.label-primary{:for => "show_tour_page"}
                  %span.pl-15 Yes
            = submit_tag 'Save', class: "hidden"
    #logo_header.box.box-info.add-plan.mt-50.hidden
      .box-header
        %h3.box-title
          COMPOSE TEXT/EMAILS
          %span
    .row.hidden
      .col-md-12
        .box.box-widget.panel-box.add-plan.pt-30
          = form_for @community,:url=>community_save_tour_settings_path(@community),:html=>{:class=>"form-horizontal"}, method: :post do |f|
            = f.hidden_field :community_id, value: @community.id
            .box-body
              .row
                .col-lg-9.col-lg-offset-1
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Sms Text
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = f.text_area :sms_text, :class=>"form-control", :placeholder=>"Sms Text", :rows => 5
                .col-lg-9.col-lg-offset-1
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
                      Email Text
                    .col-sm-12.col-lg-9.col-md-9.col-xs-12
                      = f.text_area :email_text, :class=>"form-control", :placeholder=>"Email Text", :rows => 5
            /
              \/.box-body
            .box-footer
              = f.submit "Save", :class=>"btn btn-success pull-right mr-10"
