- content_for :title, "Users - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-user
        = current_company.name.capitalize
        %br
          
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title USERS
          .col-md-6
            .mt-35
              - unless current_user.is_community_manager? || current_user.is_company_admin? || current_user.is_regional_admin?
                %a.btn.btn-success.pull-right.mb-20{:href => "/users/invitation/new"}
                  %i.fa.fa-plus-circle
                  INVITE USER
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header
            #users-index
              = render 'index'
            

            
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12

        