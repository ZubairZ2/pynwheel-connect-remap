.row
  .col-md-12
    %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.user_community_data
      %thead
        %tr
          %th{:width => "79"} Sr #
          %th First Name
          %th Last Name
          %th Email
          %th Community
          %th Company
          %th Role
          %th Actions
      %tbody
        -if current_user.is_super_admin? or current_user.is_dwelo_admin? or current_user.is_company_admin? or current_user.is_regional_admin?
          - @users.each_with_index  do |u,index|
            %tr
              %td= index+1
              %td= u.first_name
              %td= u.last_name
              %td
                %b 
                  =u.email
              %td
                %b
                  =u.communities.map(&:name).uniq.sort.to_sentence
              - company_names = u.communities.filter_map { |com| com.company&.name }.uniq.sort
              %td
                %b
                  - if company_names.present?
                    = company_names.to_sentence
              %td= u.role.sub("Super","Pynwheel")
              %td
                %a.text-success{:href => "/companies/#{current_company.id}/employees/#{u.id}/edit"}
                  %i.fa.fa-edit.icon_size
                - unless current_user.is_company_admin? or current_user.is_regional_admin?
                  %a.text-danger{"data-name"=>"User","data-href" => "/companies/#{current_company.id}/employees/#{u.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                    %i.fa.fa-trash.icon_size
        -else
          - (@invited_users || []).each_with_index  do |u,index|
            %tr
              %td= index+1
              %td= u.first_name
              %td= u.last_name
              %td
                %b 
                  =u.email
              %td
                %b
                  =u.communities.map(&:name).uniq.sort.to_sentence
              - company_names = u.communities.filter_map { |com| com.company&.name }.uniq.sort
              %td
                %b
                  - if company_names.present?
                    = company_names.to_sentence
              %td= u.role.sub("Super","Pynwheel")
              %td
                %a.text-success{:href => "/companies/#{current_company.id}/employees/#{u.id}/edit"}
                  %i.fa.fa-edit
                %a.text-danger{"data-name"=>"User","data-href" => "/companies/#{current_company.id}/employees/#{u.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash

:javascript
  $('#miyazaki.user_community_data').DataTable({
        'aoColumnDefs': [{
            'bSortable': false,
            'aTargets': [1,2,3,6,7],
        }],
        "ordering": true,
        "stateSave": false,
        "paging": true,
        "searching": true
  });