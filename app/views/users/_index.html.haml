.row
  .col-md-12
    %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
      %thead
        %tr
          %th{:width => "79"} Sr #
          %th First Name
          %th Last Name
          %th Email
          %th Community
          %th Company
          %th Role
          %th Actions
      %tbody
        -if current_user.is_super_admin?
          - @users.each_with_index  do |u,index|
            %tr
              %td= index+1
              %td= u.first_name
              %td= u.last_name
              %td
                %b 
                  =u.email
              %td
                %b 
                  =u.communities.map(&:name).sort.to_sentence
              - company = []
              - if u.communities.present?
                - u.communities.each do |com|
                  - unless company.include?((Company.find com.company_id).name)
                    - company << (Company.find com.company_id).name
              %td
                %b
                  - if company.present?
                    = company.sort.to_sentence
              %td= u.role.sub("Super","Pynwheel")
              %td
                %a.text-success{:href => "/companies/#{current_company.id}/employees/#{u.id}/edit"}
                  %i.fa.fa-edit.icon_size
                %a.text-danger{"data-name"=>"User","data-href" => "/companies/#{current_company.id}/employees/#{u.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash.icon_size
        -else
          - s = User.where(invited_by_id: current_user.id)
          - s.each_with_index  do |u,index|
            %tr
              %td= index+1
              %td= u.first_name
              %td= u.last_name
              %td
                %b 
                  =u.email
              %td
                %b 
                  =u.communities.map(&:name).to_sentence
              - company = []
              - if u.communities.present?
                - u.communities.each do |com|
                  - unless company.include?((Company.find com.company_id).name)
                    - company << (Company.find com.company_id).name
              %td
                %b
                  - if company.present?
                    = company.sort.to_sentence
              %td= u.role.sub("Super","Pynwheel")
              %td
                %a.text-success{:href => "/companies/#{current_company.id}/employees/#{u.id}/edit"}
                  %i.fa.fa-edit
                %a.text-danger{"data-name"=>"User","data-href" => "/companies/#{current_company.id}/employees/#{u.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash