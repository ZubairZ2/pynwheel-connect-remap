- content_for :title, "Edit User - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Edit  
          %span User
      = form_for @user,url: company_employee_path(current_company,@user),:html=>{:class=>"form-horizontal"} do |f|    
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render 'form' , :f=>f                   
              
        .box-footer
          = link_to "CANCEL", company_employees_path(current_company), :class=>"btn btn-default pull-right"
          = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right"
  #crop-floorplan-secondary-image.modal.fade.edit-image
  #crop-floorplan-image.modal.fade.edit-image
:javascript

  $("#floorplan_image").change(function(){
    readURL(this);
  });
  $("#floorplan_secondary_image").change(function(){
    readSecondaryURL(this);
  });