- content_for :title, "Floor plans - Pynwheel"
.divLoading.hidden
%section
  .content
    / .row.mt-25.mb-20
    /   .form-group
    /     %label.col-sm-12.col-lg-12.col-md-12.col-xs-12.control-label
    /       Select Community
    /     .col-sm-12.col-lg-12.col-md-12.col-xs-12
    /       = select_tag :communities_at_floorplans, options_for_select(@communities.collect{|c| [c.name,c.id]},params[:community_id]), :class=>"form-control"
    .title-heading
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          FLOOR PLANS
    -#= render 'units/floor_plan_button'

    .row
      #floorplans-index
        = render 'index'
      .col-lg-4.col-md-12.floor_plan_upload_image
        -#.row
        -#  .col-md-12
        -#    %h4{style: "color: grey;"}
        -#      %p
        -#        Add and manage floor plans below.*
        -#      %p
        -#        Click the "edit" icon to change the floor plan details. Details that have been changed manually will appear in red in the grid below.
        -#      %p
        -#        Click on "manage images" to add interior images to each floor plan.
        -#      %p
        -#        Click on the desired column title to rearrange how available floor plans appear in the floor plan gallery.
        -#      %a.btn.btn-success.pull-right.mb-20{:href => "/communities/#{@community.id}/floorplans/new"}
        -#        %i.fa.fa-plus-circle
        -#        ADD FLOOR PLAN
        -#    .mt-35
        -#      %a.btn.btn-success.pull-right.mb-20{:href => "##","data-target" => "#modal-to-add-floorplan-description", "data-toggle" => "modal", :style => "margin-right : 5px;"}
        -#        ADD DETAILS TO MULTIPLE
        .row{style: "margin-top: 405px;"}
          .col-md-12#holder
            .box.box-widget.panel-box.pl-20.pr-20.pb-10{:style => "max-height: 675px !important; overflow: scroll;"}
              .row
                .col-md-12.col-lg-9.col-xs-9
                  %h4
                    Mass Upload Floor Plan Images
                    %i.floorplanMassUploadPopName.fa.fa-question-circle{ "data-toggle" => "floorplanMassUploadPopover","data-content" => " "}
                      %span#floorplanMassUploadPopNameText
                        Use this area to easily upload multiple floor plan images.
                  %p.pt-10.mb-20 Upload files here, then drag and drop them to the floor plan image column in the table. Only jpeg, jpg and png files are accepted.
                  %p.pt-10.mb-20 Images will appear at a size of 270 x 270 px when fully expanded. Please note that images that are too small may appear pixelated.
                .col-md-12.col-lg-3.col-xs-3
                  %img{:alt => "", :src => "/assets/upload-image.jpg", :style => "max-width:100%;", :title => ""}
              %span.btn.btn-success.btn-file
                %i.fa.fa-plus
                Add Files
                %input#mutiple-files{:type => "file",:multiple=>true}
              %table.table-striped.table.upload-image#pre-save-floorplan-images-table
                %tr{:valign => "middle"}
                - if current_community.has_temporary_images?
                  - current_community.temporary_images.each do |image|
                    %tr{:valign => "middle",:id=>"row#{image.position}"}
                      %td{:align => "left"}
                        .drop-img.generated-class{:ondragover => "allowDrop(event)", :ondrop => "dropBack(event)",:id=>"parent-#{image.position}"}
                          %img{:alt => "", :draggable => "true", :ondragstart => "drag(event)", :src => "#{image.image}", :title => "",:id=>"drag-#{image.position}"}/
                      %td{:id=>"img-name-#{image.position}"}
                        = image.name
                      %td
                        %a.btn.btn-danger.btn-sm{:href => "javascript::;", :onclick => "removeDivWithTemporaryImage(#{image.position});"} Remove
                        //.text-center.mt-10.drag-drop-section
              .text-center.mt-10.drag-drop-section
                %img{:alt => "", :src => "/assets/upload-image.png", :style => "max-width:100%;", :title => ""}
                %p.mt-10
                Drag & Drop file to Upload
.row
  .col-md-12
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "floorplan_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#modal-to-add-floorplan-description.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Add Description
      = form_tag add_description_community_floorplans_path(@community) do
        .modal-body.set-description-modal-body
          = text_field_tag :description_title, nil, :class=>"form-control mb-20", :placeholder=>"Enter Title"
          = text_area :description, nil,:class=>"form-control mb-20 validate[required] wysihtml5",:placeholder=>"Enter Description"
          .row
            .col-md-4
              = check_box_tag 'select_all_floorplan_for_description'
              %label Select all
          .row
            - @floorplans.each do |floorplan|
              .col-md-2.pt-5.pb-5
                = check_box_tag 'floorplan_ids[]', floorplan.id,false,class: 'description-floorplan-checkbox'
                = h floorplan.name
        .modal-footer
          = submit_tag 'Submit',:class=>"btn btn-success"
          %button.btn.btn-primary{"data-dismiss" => "modal", :type => "button"} Cancel

  /End Panel Right Side
:javascript
  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
      });
  })
  $('#select_all_floorplan_for_description').change(function(){
      if($(this).is(':checked')){
        $('.description-floorplan-checkbox').prop('checked',true)
      }
      else{
        $('.description-floorplan-checkbox').prop('checked',false)
      }
    });
  $("#communities_at_floorplans").change(function(){
    var community_id = $('#communities_at_floorplans').val();

    $.ajax({
      url: "/communities/"+community_id+"/floorplans",
      type: "GET",
      dataType: "script"
    });
  });
  $('.apartment-setting-field').change(function(){
    $('.apartment-settings-form').submit();
  });
  $(document).ready(function(){
    $('.floor_plan_upload_image').affix({offset: {top: 675} });
  });
  if (!#{current_user.welcome_floorplan_page})
  {
    $('[data-toggle="floorplanDetailsToMultiplePopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Add or change details for multiple floor plans. Details will appear in the "Additional Details" tab. </div><div class="popover-footer"><a id="floorplanDetailsToMultiplePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }

    $(document).on("click", "#floorplanDetailsToMultiplePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="floorplanMassUploadPopover"]').popover({
        placement: 'left',
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Use this area to easily upload multiple floor plan images.</div><div class="popover-footer"><a id="floorplanMassUploadPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#floorplanMassUploadPopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="floorplanInteriorImagesPopover"]').popover({
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Add or change images (such as interior photography or renderings) associated with each floor plan.</div><div class="popover-footer"><a id="floorplanInteriorImagesPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });

    $(document).on("click", "#floorplanInteriorImagesPopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="floorplanGridActionPopover"]').popover({
        placement: 'left',
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding" style="color: ;">Click the edit icon to view or change the details associated with each floor plan such as name, images, virtual tour, and details.</div><div class="popover-footer"><a id="floorplanGridActionPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
      }).popover('show');
    });
    $(document).on("click", "#floorplanGridActionPopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        #{current_user.welcome_floorplan_page = true}
        #{current_user.save}
    });