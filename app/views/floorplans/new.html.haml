%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Home
    %li
      %a{:href => "#"} Appartments
    %li
      %a{:href => "#{community_floorplans_path(@community)}"} Floor Plans
    %li.active Add Floor Plan
  .clearfix
.clearfix
/ Main content
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add 
          %span Floor Plan
      / /.box-header
      / form start
      / <form class="form-horizontal">
      = form_for @floorplan,:url=>community_floorplans_path(:community_id=>@community.id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "ADD FLOOR PLAN", :class=>"btn btn-success pull-right"


:javascript

  $("#floorplan_file_url").change(function(){
      readURL(this);
  });
