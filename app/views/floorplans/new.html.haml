- content_for :title, "Add Floor plan - Pynwheel"
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Add 
          %span Floor Plan
      / /.box-header
      / form start
      / <form class="form-horizontal">
      = form_for @floorplan,:url=>community_floorplans_path(:community_id=>@community.id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , community_floorplans_path(:community_id=>current_community.id), :class=>"btn btn-default pull-right"
          = f.submit "ADD FLOOR PLAN", :class=>"btn btn-success pull-right mr-10"


:javascript

  $("#floorplan_image").change(function(){
      readURL(this);
  });
