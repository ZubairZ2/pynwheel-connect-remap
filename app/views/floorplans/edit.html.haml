- content_for :title, "Floor plan Details - Pynwheel"
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan
      .box-header
        .row.col-lg-12
          %h3.box-title
            Floor Plan Details
            %span
        = link_to "<Back to All Floor Plans", community_floorplans_path(@community), class: "btn btn-primary mt-20", style: "background: #8f4a9c; color: white;"
      / /.box-header
      / form start
      = form_for @floorplan,:url=>community_floorplan_path(:id=>@floorplan.id,:community_id=>@community.id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "Save Changes", :class=>"btn btn-success pull-right"

:javascript

  $("#floorplan_image").change(function(){
      readURL(this);
  });
  $("#floorplan_secondary_image").change(function(){
      readSecondaryURL(this);
  });