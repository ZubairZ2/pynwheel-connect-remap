<!--Start Body right Section-->
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <section class="content-header">
    <ol class="breadcrumb">
      <li><a href="#">Home</a></li>
      <li><a href="#">Appartments</a></li>
      <li><a href="#">Floor Plans</a></li>
      <li class="active">Add Floor Plan</li>
    </ol>
    <div class="clearfix"></div>
  </section>
  <div class="clearfix"></div>
  <!-- Main content -->
  <section>
    <div class="content">
      <div class="box box-info add-plan mt-20">
        <div class="box-header">
          <h3 class="box-title">Add Floor <span>Plan</span></h3>
        </div>
        <!-- /.box-header -->
        <!-- form start -->
       <!-- <form class="form-horizontal">-->
          <%= form_for @floorplan,:url=>community_floorplans_path(:community_id=>@community.id),:html=>{:class=>"form-horizontal"} do |f|%>
          <div class="box-body">
            <div class="row">
              <div class="col-lg-9 col-lg-offset-1">
                <div class="form-group">
                  <label  class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">
                    Floor Plan Name
                    <span>Specify name here</span>
                  </label>

                  <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
                    <%= f.text_field :name, :class=>"form-control", :placeholder=>"Floor Plan Name",:required=>true%>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">
                    Extrernal Floor Plan ID
                    <span>Specify ID here</span>
                  </label>

                  <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
                    <%= f.text_field :provider_floorplan_id, :class=>"form-control", :placeholder=>"From 3rd Party Vendor",:required=>true%>
                  </div>
                </div>
                <div class="form-group">
                  <label  class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">
                    Floor Plan Info
                    <span>Specify name here</span>
                  </label>
                  <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
                    <div class="row">
                      <div class="col-sm-6 col-lg-3 col-md-3 col-xs-12">
                        <%= f.text_field :square_feet, :class=>"form-control", :placeholder=>"250",:required=>true%>
                        <small>Square Feet</small>
                      </div>
                      <div class="col-sm-6 col-lg-3 col-md-3 col-xs-12">
                        <%= f.text_field :bedrooms, :class=>"form-control", :placeholder=>"2",:required=>true%>
                        <small>Bedrooms</small>
                      </div>
                      <div class="col-sm-6 col-lg-3 col-md-3 col-xs-12">
                        <%= f.text_field :bathrooms, :class=>"form-control", :placeholder=>"1",:required=>true%>
                        <small>Bathrooms</small>
                      </div>
                      <div class="col-sm-6 col-lg-3 col-md-3 col-xs-12">
                        <%= f.text_field :market_rent, :class=>"form-control", :placeholder=>"0.00",:required=>true%>
                        <small>Base Rent</small>
                      </div>
                    </div>

                  </div>
                </div>
                <div class="form-group">
                  <label  class="col-sm-12 col-lg-3 col-md-3 col-xs-12 control-label">
                    Upload Image
                    <span>Upload image of this<br> floor plan.</span>
                  </label>

                  <div class="col-sm-12 col-lg-9 col-md-9 col-xs-12">
                    <div class="select-img mb-20">
                      <div class="select-img-img"></div>
                    </div>
                    <span class="btn btn-default black-button btn-sm btn-file">
                                    Select Image
                                  <%= f.file_field :file_url%>
                                </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- /.box-body -->
          <div class="box-footer">
            <%= f.submit "ADD FLOOR PLAN", :class=>"btn btn-success pull-right"%>
          </div>
          <!-- /.box-footer -->
        <%end%>
      </div>

    </div>
  </section>
  <!-- /.content -->
</div>