.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Name
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Floor Plan Name",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    External Floor Plan ID
    %span Specify ID here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :provider_floorplan_id, :class=>"form-control validate[required]", :placeholder=>"From 3rd Party Vendor",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Info
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :square_feet, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of square feet",:maxlength=>"10"
        %small Square Feet
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bedrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bedrooms",:maxlength=>"10"
        %small Bedrooms
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bathrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bathrooms",:maxlength=>"10"
        %small Bathrooms
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :market_rent, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"0.00",:maxlength=>"10"
        %small Base Rent
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Virtual Tour URL
    %span Specify URL here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :virtual_tour_url, :class=>"form-control", :placeholder=>"Virtual Tour URL"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      floor plan.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img
        %a.preview-image{:href=>f.object.image.present? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Floor Plan Image"}
          = image_tag f.object.image.present? ? f.object.image.url : "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :image     