.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Manual Override
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditManualoverridePopover","data-content" => " "}
      %span#tooltiptext1
        When Manual Override is set to Yes, then the items that have been changed will not update automatically from the property's property management software data feed (if the property is using a third party data feed).

  .col-sm-12.col-lg-1.col-md-1.col-xs-12
    = f.radio_button :manual_override, true
    = f.label :manual_override, "Yes"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :manual_override, false
    = f.label :manual_override, "No"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Name
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditNamePopover","data-content" => " "}
      %span#tooltiptext1
        Changing the floor plan name will change how the name appears.

    %span Specify name here (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Floor Plan Name",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Provider Floor Plan ID
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditProviderIdPopover","data-content" => " "}
      %span#tooltiptext1
        The provider floor plan ID is the code assigned to this floor plan in the property management software.

    %span Provider Floor Plan ID (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :provider_floorplan_id, :class=>"form-control validate[required]", :placeholder=>"From 3rd Party Vendor",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Info
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditInfoPopover","data-content" => " "}
      %span#tooltiptext1
        Changing the number of bedrooms and number of bathrooms will change how they appear in the app. Changing square footage will change how it appears in the Pynwheel app only if there is not square footage associated with each unit in your data. Changing the price here will not affect the price that is displayed for each unit.

    %span Specify floor plan info here (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :square_feet, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of square feet",:maxlength=>"10", :value => f.object.square_feet.to_i
        %small Square Feet (Manual Override Required)
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bedrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bedrooms",:maxlength=>"10", :value => f.object.bedrooms.to_i
        %small Bedrooms (Manual Override Required)
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bathrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bathrooms",:maxlength=>"10"
        %small Bathrooms (Manual Override Required)
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :market_rent, :class=>"form-control validate[required]", :placeholder=>"0.00",:maxlength=>"10", :value => f.object.market_rent.to_i
        %small Base Price (Manual Override Required)

.form-group#virtual_tour_button_label_field
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Virtual Tour Button Label

    %span Specify virtual tour button label here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :virtual_tour_button_label, :class=>"form-control", :placeholder=>"Virtual Tour Button Label"


.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Virtual Tour URL
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditTourUrlPopover","data-content" => " "}
      %span#tooltiptext1
        Add a URL to add a virtual tour specific to this floor plan which will appear on the interactive map and in the floor plan gallery.

    %span Specify URL here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :virtual_tour_url, :class=>"form-control", :placeholder=>"Virtual Tour URL"

/Additional Button
.form-group#virtual_tour_button_label_field
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Additional Button Label

    %span Specify Additional button label here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :additional_button, :class=>"form-control", :placeholder=>"Additional Button Label"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Additional Button URL
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanAdditionalButtonUrlPopover","data-content" => " "}
      %span#tooltiptext1
        Add a URL to add a Additional details specific to this floor plan which will appear on the interactive map and in the floor plan gallery.

    %span Specify URL here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :additional_url, :class=>"form-control", :placeholder=>"Additional Button URL"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Additional Details
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanAdditionalUrlDetailsPopover","data-content" => " "}
      %span#tooltiptext1
        Add details such as finishes and floor-plan specific features and they will appear in the "Additional Details" tab for this floor plan.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :description,:class=>"form-control mb-20  wysihtml5",:placeholder=>"Enter Description"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Primary Image
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditPrimaryImagePopover","data-content" => " "}
      %span#tooltiptext1
        This is the image that will appear of this floor plan.

    %span
      Upload primary image of this floor plan.
      %br/
      Images will appear at a size of 325 x 300 px when fully expanded. Please note that images that are too small may appear pixelated.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .col-lg-5.col-md-5.col-sm-6.col-xs-6
      .slide-image
        .image-box.video-box
          .image-box.video-box
            .images.height-200
              - rn =  rand(9999999999999999999999999)
              %a.preview-image{:href=>f.object.image.present? ? (f.object.image.url  + "?timestamp=#{rn}") : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Floor Plan Image"}
                = image_tag f.object.image.present? ? (f.object.image.url  + "?timestamp=#{rn}") : "default.jpeg",:height=>"",:width=>"100%",:id=>"preview-image", :style => "max-height: 190px; max-width: 270px;  min-height: 190px; min-width: 270px;"
            = image_tag "exclamation-mark.png", class: "waring_exal #{ (f.object.image.present? ? ((f.object.image.width < 300 && f.object.image.height < 250) ? "" : "hidden") : "hidden") rescue "hidden" }", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"
          - if f.object.image.present?
            .icons
              %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{@community.id}/floorplans/#{@floorplan.id}/remove_pri_scnd_image?image=primary", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                %i.fa.fa-close
          .row
            .col-lg-6
              %span.btn.btn-default.black-button.btn-sm.btn-file
                Upload a new image
                = f.file_field :image
            .col-lg-6
              - if  f.object.image.present? && f.object.image.content_type != 'image/svg+xml'
                .icon
                  = link_to show_floorplan_image_in_modal_community_floorplan_path(), remote: true do
                    %span.btn.btn-default.black-button.btn-sm.btn-file{"data-target" => "#edit-name", "data-toggle" => "modal"}
                      Crop
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Secondary Image
    %i.tooltip1.fa.fa-question-circle{ "data-toggle" => "floorplanEditSecondaryImagePopover","data-content" => " "}
      %span#tooltiptext1
        Add a secondary image (such as a 3D image or photo) that will appear alongside the primary image for this floor plan.

    %span
      Upload secondary image of this floor plan.
      %br/
      Images will appear at a size of 325 x 300 px when fully expanded. Please note that images that are too small may appear pixelated.

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .col-lg-5.col-md-5.col-sm-6.col-xs-6
      .slide-image
        .image-box.video-box
          .images.height-200
            - rn =  rand(9999999999999999999999999)
            %a.preview-image{:href=>f.object.secondary_image.present? ? (f.object.secondary_image.url  + "?timestamp=#{rn}") : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Unit Secondary Image"}
              = image_tag f.object.secondary_image.present? ? (f.object.secondary_image.url  + "?timestamp=#{rn}") : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-secondary-image", :style => "max-height: 190px; max-width: 270px; min-height: 190px; min-width: 270px;"
          = image_tag "exclamation-mark.png", class: "waring_exal #{ (f.object.secondary_image.present? ? ((f.object.secondary_image.width < 300 && f.object.secondary_image.height < 250) ? "" : "hidden") : "hidden") rescue "hidden" }", style: "width: 25px", "data-content" => "Small Image. May appear pixelated.", "data-toggle" => "popover", "data-trigger" => "hover", :href => "#"
        - if f.object.secondary_image.present?
          .icons
            %a.text-danger{"data-name"=>"Image","data-href" => "/communities/#{@community.id}/floorplans/#{@floorplan.id}/remove_pri_scnd_image?image=secondary", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
              %i.fa.fa-close
        .row
          .col-lg-6
            %span.btn.btn-default.black-button.btn-sm.btn-file
              Upload a new image
              = f.file_field :secondary_image
          - if  f.object.secondary_image.present? && f.object.secondary_image.content_type != 'image/svg+xml'
            .col-lg-6
              .icon
                = link_to show_floorplan_secondary_image_in_modal_community_floorplan_path(), remote: true do
                  %span.btn.btn-default.black-button.btn-sm.btn-file{"data-target" => "#edit-name", "data-toggle" => "modal"}
                    Crop

= link_to "Manage Images", "/communities/#{@community.id}/floorplans/#{@floorplan.id}/amenities", class: "btn btn-default black-button loader_class"

:javascript
  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
      });
  });
  if (localStorage.getItem("floorplanCropped") == "1")
  {
    localStorage.setItem("floorplanCropped", "0");
    location.reload(true);
  }
  if (!#{current_user.welcome_edit_floorplan_page})
  {
    $('[data-toggle="floorplanEditManualoverridePopover"]').popover({
        html: true,
        placement: 'left',
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">When Manual Override is set to Yes, then the items that have been changed will not update automatically from the property"s property management software data feed (if the property is using a third party data feed). </div><div class="popover-footer"><a id="floorplanEditManualoverridePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }

    $(document).on("click", "#floorplanEditManualoverridePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="floorplanEditNamePopover"]').popover({
        placement: 'left',
        html: true,
        template: '<div class="popover pyn-popover"><div class="arrow pyn-popover-arrow"></div><div class="popover-body popover-padding">Changing the floor plan name will change how the name appears.</div><div class="popover-footer"><a id="floorplanEditNamePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
