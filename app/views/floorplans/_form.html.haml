.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Manual Override
    %i.tooltip1.fa.fa-question-circle
      %span#tooltiptext1
        When Manual Override is set to Yes, then the items that have been changed will not update automatically from the property's property management software data feed (if the property is using a third party data feed).

  .col-sm-12.col-lg-1.col-md-1.col-xs-12
    = f.radio_button :manual_override, true
    = f.label :manual_override, "Yes"
  .col-sm-12.col-lg-2.col-md-2.col-xs-12
    = f.radio_button :manual_override, false
    = f.label :manual_override, "No"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Name
    %span Specify name here (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Floor Plan Name",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Provider Floor Plan ID
    %span Provider Floor Plan ID (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :provider_floorplan_id, :class=>"form-control validate[required]", :placeholder=>"From 3rd Party Vendor",:maxlength=>"30"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Info
    %span Specify floor plan info here (Manual Override Required)
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :square_feet, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of square feet",:maxlength=>"10", :value => f.object.square_feet.to_i
        %small Square Feet (Manual Override Required)
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bedrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bedrooms",:maxlength=>"10", :value => f.object.bedrooms.to_i
        %small Bedrooms (Manual Override Required)
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bathrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bathrooms",:maxlength=>"10", :value => f.object.bathrooms.to_i
        %small Bathrooms (Manual Override Required)
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :market_rent, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"0.00",:maxlength=>"10", :value => f.object.market_rent.to_i
        %small Base Price (Manual Override Required)
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Virtual Tour URL
    %span Specify URL here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :virtual_tour_url, :class=>"form-control", :placeholder=>"Virtual Tour URL"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Additional Details

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :description,:class=>"form-control mb-20 validate[required] wysihtml5",:placeholder=>"Enter Description"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Primary Image
    %span
      Upload primary image of this floor plan.
      -#%br/

  .col-sm-12.col-lg-9.col-md-9.col-xs-12

    .image-box.video-box
      .images.height-200
        %a.preview-image{:href=>f.object.image.present? ? f.object.image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Floor Plan Image"}
          = image_tag f.object.image.present? ? f.object.image.url : "default.jpeg",:height=>"",:width=>"100%",:id=>"preview-image", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :image
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Secondary Image
    %span
      Upload secondary image of this floor plan.
      -#%br/

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    -#.select-img.mb-20
    -#  .select-img-img
    .image-box.video-box
      .images.height-200
        %a.preview-image{:href=>f.object.secondary_image.present? ? f.object.secondary_image.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Unit Secondary Image"}
          = image_tag f.object.secondary_image.present? ? f.object.secondary_image.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-secondary-image", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :secondary_image

:javascript
  $(document).ready(function(){
      $('.wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false}});
      });
  })