.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Name
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control", :placeholder=>"Floor Plan Name",:required=>true
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Extrernal Floor Plan ID
    %span Specify ID here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :provider_floorplan_id, :class=>"form-control", :placeholder=>"From 3rd Party Vendor",:required=>true
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Info
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :square_feet, :class=>"form-control", :placeholder=>"250",:required=>true
        %small Square Feet
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bedrooms, :class=>"form-control", :placeholder=>"2",:required=>true
        %small Bedrooms
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bathrooms, :class=>"form-control", :placeholder=>"1",:required=>true
        %small Bathrooms
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :market_rent, :class=>"form-control", :placeholder=>"0.00",:required=>true
        %small Base Rent
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      floor plan.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img= image_tag "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :file_url