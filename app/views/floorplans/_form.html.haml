.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Name
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Floor Plan Name"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Extrernal Floor Plan ID
    %span Specify ID here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :provider_floorplan_id, :class=>"form-control validate[required]", :placeholder=>"From 3rd Party Vendor"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Floor Plan Info
    %span Specify name here
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :square_feet, :class=>"form-control validate[required,custom[onlyNumber]]", :placeholder=>"No of square feet"
        %small Square Feet
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bedrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bedrooms"
        %small Bedrooms
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :bathrooms, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"No of bathrooms"
        %small Bathrooms
      .col-sm-6.col-lg-3.col-md-3.col-xs-12
        = f.text_field :market_rent, :class=>"form-control validate[required,custom[onlyDecimal]]", :placeholder=>"0.00"
        %small Base Rent
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Image
    %span
      Upload image of this
      %br/
      floor plan.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img= image_tag "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :file_url
:javascript
  $("form").validationEngine();       