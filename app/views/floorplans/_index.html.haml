/ Start Panel left Side
.col-lg-8.col-md-12
  -#.row
  -#  .col-md-12
  -#    %h4.title Floor Plans
  .row
    .ml-15
      %a.btn.btn-success.mb-20{:href => "/communities/#{@community.id}/floorplans/new"}
        %i.fa.fa-plus-circle
        ADD FLOOR PLAN
    .ml-15
      %a.btn.btn-success.mb-20{:href => "##","data-target" => "#modal-to-add-floorplan-description", "data-toggle" => "modal", :style => "margin-right : 5px;"}
        %i.fa.fa-plus-circle
        ADD DETAILS TO MULTIPLE
      %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplanDetailsToMultiplePopover","data-content" => " "}
        %span#propertyDetailNameText
          Add or change details for multiple floor plans. Details will appear in the "Additional Details" tab.
  .row{ style: "margin-left: 0px;"}
    -#.box.box-widget.panel-box.ml-15
    %h4{style: "color: grey; font-size: 17px; "}
      %p
        Add and manage floor plans below.*
      %p
        Click the "edit" icon to change the floor plan details. Details that have been changed manually will appear in red in the grid below.
      %p
        Click on "manage images" to add interior images to each floor plan.
      %p
        Click on the desired column title to rearrange how available floor plans appear in the floor plan gallery.
  .row.mr-15
    .box.box-widget.panel-box.ml-15.alert-danger
      %h5{style: "color: ; margin-left: 10px; font-size: 13px;"}
        %p
          *Note: If you have made changes to floor plans in your property management software, please contact Pynwheel support at support@pynwheel.com to import your data.
  .box.box-widget.panel-box
    .box-header
      
      .row
        .col-md-12
          %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.floorplan_data_table
            %thead
              %tr
                %th.floorplan_sr_col Sr #
                %th.floorplan_name_col Name
                %th SF
                %th BR
                %th BA
                -#%th Description
                %th
                  Interior Images
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplanInteriorImagesPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Add or change images (such as interior photography or renderings) associated with each floor plan.
                %th Floor Plan Image
                %th
                  Actions
                  %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "floorplanGridActionPopover","data-content" => " "}
                    %span#propertyDetailNameText
                      Click the edit icon to view or change the details associated with each floor plan such as name, images, virtual tour, and details.
            %tbody
              - @floorplans.map{|x| x.name = '' if x.name.nil? }
              - @floorplans.map {|i| i.name.gsub(/\d+/) {|s| "%08d" % s.to_i } }.zip(@floorplans).sort.map{|x,y| y}.each_with_index  do |f,index|
                %tr{style: "color: #{f.manual_override ? "#dd4a39" : ""};"}
                  %td= index+1
                  -# %td{style: "color: #{f.name_is_updated ? "#dd4a39" : ""}; "}= f.name
                  %td{ style: "color: #{f.name_is_updated ? '#dd4a39' : ''};" }
                    = f.name
                    - if current_community.turn_availability_on
                      = form_with model: f, url: update_availability_status_community_floorplan_path(current_community, f), method: :patch, local: true do |form|
                        = form.select :availability_status, Floorplan.availability_statuses.keys.map { |s| [s.humanize, s] }, {}, { onchange: 'this.form.submit();', style: "margin-top: 10px;" }

                  %td{style: "color: #{f.square_feet_is_updated ? "#dd4a39" : ""}; "}= f.square_feet.to_i
                  %td{style: "color: #{f.bedroom_is_updated ? "#dd4a39" : ""}; "}= f.bedrooms.to_i
                  %td{style: "color: #{f.bathroom_is_updated ? "#dd4a39" : ""}; "}= f.bathrooms
                  -#%td= raw(f.description)
                  %td
                    = link_to "Manage Images",community_floorplan_amenities_path(current_community,f), class: "btn btn-default black-button loader_class"
                  %td
                    - if f.standard_image_url.present?
                      .drop-img{style: "color: #{f.manual_override ? "black" : ""};"}
                        = image_tag f.standard_image_url
                    - else  
                      .drop-img.drop-img-left.image-holder{:ondrop => "drop(event)",:id=>f.id,style: "color: #{f.manual_override ? "black" : ""};"}
                  %td
                    %a.text-success{:href => "/communities/#{@community.id}/floorplans/#{f.id}/edit"}

                      %i.fa.fa-edit.icon_size.loader_class{style: "color: #{f.manual_override ? "" : ""};"}
                    %a.text-danger{"data-name"=>"Floor plan","data-href" => "/communities/#{@community.id}/floorplans/#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
                      %i.fa.fa-trash.icon_size{style: "color: #{f.manual_override ? "" : ""};"}

      
/ End Panel left Side
