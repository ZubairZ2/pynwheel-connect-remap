/ Start Panel left Side
.col-lg-8.col-md-12
  .row
    .col-md-12
      %h4.title FLOOR PLANS FOR #{@community.name}
  .box.box-widget.panel-box
    .box-header
      
      .row
        .col-md-12
          %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
            %thead
              %tr
                %th{:width => "79"} Sr #
                %th Plan Name
                %th Sq.Ft
                %th Bedrooms
                %th Bathrooms
                %th Plot Amenity
                %th Image
                %th Actions
            %tbody
              - @floorplans.each_with_index  do |f,index|
                %tr
                  %td= index+1
                  %td= f.name
                  %td= f.square_feet
                  %td= f.bedrooms
                  %td= f.bathrooms
                  %td
                    %button.btn.btn-default.black-button Plot Now
                  %td
                    - if f.image.present?
                      .drop-img.drop-img-left{:ondragover => "allowDrop(event)", :ondrop => "drop(event)",:id=>f.id}
                        = image_tag f.image.url
                    - else  
                      .drop-img.drop-img-left{:ondragover => "allowDrop(event)", :ondrop => "drop(event)",:id=>f.id}
                  %td
                    %a.text-success{:href => "/communities/#{@community.id}/floorplans/#{f.id}/edit"}
                      %i.fa.fa-edit
                    %a.text-danger{:href => "/communities/#{@community.id}/floorplans/#{f.id}","data-method"=>:delete,"data-confirm"=>"Are you sure?"}
                      %i.fa.fa-trash

      
/ End Panel left Side
/ Start Panel Right Side
