- content_for :title, "Companies - Pynwheel"
/ Main content
.container
  %section
    .row
      .col-md-12
        %h2 Community Groups
        %h5
          All community groups are listed here.
        %p.mb-30
          This Admin feature allows you to directly access any community groups in the system
    .row
      .col-md-12
        .col-md-6
          .mt-35
            %a.btn.btn-success.mb-20{:href => "/"}
              List all communities


    .box.box-widget.panel-box
      #new-search-area
      %table#companies.table.table-hover.table-responsive
        %thead
          %tr
            %th Community Groups
            %th{:width => "250"} Actions
        %tbody
          - @community_groups.each do |com_grp|
            %tr
              %td
                %h4.h4
                  = link_to com_grp.name, company_community_group_path(current_company.id,com_grp.id)
              %td
                %a.text-success{:href => "/community_groups/#{com_grp.id}/edit"}
                  %i.fa.fa-edit.icon_size
                %a.text-danger{"data-name"=>"Community Group","data-href" => "/companies/#{current_company.id}/community_groups/#{com_grp.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash.icon_size

