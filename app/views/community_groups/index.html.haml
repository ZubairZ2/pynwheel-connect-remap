- content_for :title, "Community Group - Pynwheel"
/ Main content
.container
  %section
    .row
      .col-md-12
        %h2 Community Groups
        %h5
          All community groups are listed here.
        - if current_user.is_super_admin?
          %p.mb-30
            This Admin feature allows you to directly access any community groups in the system
        - elsif current_user.is_dwelo_admin?
          %p.mb-30
            This Dwelo admin feature allows you to directly access any dwelo community groups in the system </br>
    .row
      .col-md-12
        .col-md-6
          .mt-35
            %a.btn.btn-success.mb-20{:href => "/companies"}
              List all Companies


    .box.box-widget.panel-box
      #new-search-area
      %table#community_groups.table.table-hover.table-responsive
        %thead
          %tr
            %th Community Groups
            %th{:width => "250"} Company
            %th{:width => "250"} Actions
        %tbody
          - @community_groups.each do |com_grp|
            %tr
              %td
                %h4.h4
                  = link_to com_grp.name, company_community_group_path((Company.find com_grp.company_id).id,com_grp.id)
              %td
                %h5.h5
                  = com_grp.company.name rescue ""
              %td
                %a.text-success{:href => "/community_groups/#{com_grp.id}/edit"}
                  %i.fa.fa-edit.icon_size
                %a.text-danger{"data-name"=>"Community Group","data-href" => "/companies/#{(Company.find com_grp.company_id).id}/community_groups/#{com_grp.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash.icon_size

