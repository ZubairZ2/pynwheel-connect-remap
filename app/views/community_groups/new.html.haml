- content_for :title, "Add Community Group - Pynwheel"
%section.is-community-page
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Community Group

      = form_for @community_group,:url=>company_community_groups_path(Company.find @community_group.company_id),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , company_communities_path(Company.find @community_group.company_id), :class=>"btn btn-default pull-right"
          = f.submit "ADD COMMUNITY GROUP", :class=>"btn btn-success pull-right mr-10"

