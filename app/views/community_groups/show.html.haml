- content_for :title, "Community Group - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-group
        = @community_group.name.capitalize
        - if @community_group.present?
          %br
            %small.text-primary
              = @community_group.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Communities
          .col-md-6
            .mt-35
              - if current_user.is_super_admin?
                = link_to add_community_community_groups_path(@community_group),:class=>"btn btn-success pull-right mb-20" do
                  %i.fa.fa-plus-circle
                  ADD COMMUNITY
                = link_to edit_community_group_path(@community_group),:class=>"btn btn-success pull-right mb-20 mr-10" do
                  %i.fa.fa-plus-circle
                  COMMUNITY GROUP DETAILS
              -#- if current_user.is_super_admin?
              -#  = link_to new_company_community_group_path(current_company),:class=>"btn btn-success pull-right mb-20" do
              -#    %i.fa.fa-plus-circle
              -#    ADD COMMUNITY GROUP
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header

            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #

                      %th Community Name
                      -#%th Master Community
                      %th{:width => "250"} Actions
                  %tbody
                    - alphabetical_sort(@community_group.communities).each_with_index  do |f,index|
                      %tr
                        %td
                          = index+1
                        %td

                          = link_to f.name, edit_company_community_path((Company.find f.company_id),f)
                        -#%td
                        -#  = radio_button_tag "efe",f.master_community
                        %td
                          -#= link_to edit_company_community_path(current_company,f),:class=>"text-success" do
                          -#  %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Company","data-href" => "/community_groups/#{@community_group.id}/remove_community?community=#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size
                          -#%a.btn-info.btn-xs.mr-5
                          -#  Update now
                          -#%a.btn-success.btn-xs
                          -#  Live

      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12