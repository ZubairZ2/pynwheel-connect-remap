.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name
    - if current_user.is_dwelo_admin?
      %i.unit_manualoverride.fa.fa-question-circle
        %span#unit_manualoverride_text
          (Dwelo) will be added as default at the start of name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Name"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :address, :class=>"form-control", :placeholder=>"Address"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Code
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :code, :class=>"form-control", :placeholder=>"Code"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Page Type

  .col-sm-12.col-lg-3.col-md-3.col-xs-12
    = f.radio_button :page_type, true
    = f.label :page_type, "Map", :value => "true"

  .col-sm-12.col-lg-3.col-md-3.col-xs-12
    = f.radio_button :page_type, false
    = f.label :page_type, "Menu", :value => "false"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Page Name
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :page_name, :class=>"form-control", :placeholder=>"Page Name"

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Region
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.select(:region_id, options_for_select(@all_regions,f.object.region_id), {:include_blank => 'Select a region'}, { :class => 'form-control' })

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Logo

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .image-box.video-box
      .images.height-200
        %a.preview-image{:href=>f.object.logo.present? ? f.object.logo.url : asset_path("default.jpeg"),"data-toggle"=>"lightbox","data-title"=>"Community Group Logo"}
          = image_tag f.object.logo.present? ? f.object.logo.url : "default.jpeg",:height=>"",:width=>"170",:id=>"preview-community-group-logo", :style => "max-height: 190px; max-width: 270px;"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :logo

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Inactivated
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-6.col-md-4.col-xs-12
        .checkbox
          = f.check_box :inactivate
          %label Inactivate

- if params[:action] == "edit"
  = link_to "Design" , community_group_group_design_index_path(@community_group.id), :class=>"btn btn-success"
  = f.hidden_field :creator_id, :value=> current_user.id
  = f.hidden_field :company_id, :class=>"form-control", :value=>"#{@community_group.company_id.present? ? @community_group.company_id : current_company.id}"

:javascript
  $("#community_group_logo").change(function(){
    readCommunityGroupLogoURL(this);
  });
  
  $("#community_group_group_design_attributes_background_image").change(function(){
    readCommunityGroupHomepageImageURL(this);
  });

  $("#file-load").on('click', function(e) {
    $('#video_field').click();
  });

  $("#video_field").on('change', function(e) {
    input = this.files[0];

    if (input.files && input.files[0]) {
      if(true){
        let reader = new FileReader();
        reader.onload = function (e) {
          $('#group_design_homepage_video').parent().attr('href', e.target.result);
        }
        reader.readAsDataURL(input.files[0]);
      }
      else{
        $(input).val('');
        $('#image-upload-warning').modal('show');
      }
    }
  });