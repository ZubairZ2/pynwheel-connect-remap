$(".locks-section-in-modal").empty()
$('#access_point_modal').find(".locks-section-in-modal").replaceWith("<%= j render partial: 'shared/locks_info_in_modal', locals: { community: @community, door: @active_access_point , locks_present_hash: JSON.parse(params[:locks_present_hash]) } %>");
$('#access_point_modal').find("#lock_provider").closest("form").attr('action', "<%= update_access_point_lock_community_floorplate_access_point_path(@community, @property_type, @active_access_point) %>");
$('#access_point_modal').find(".delete-access-point").attr("href", "<%= remove_access_point_plot_community_floorplate_access_point_path(@community, @property_type, @active_access_point, plotted_id: params[:plotted_id]) %>")
$('#access_point_modal').find("#door-name").html("<%= @active_access_point.name %>")
$('#access_point_modal').find(".access-points-in-door-modal").html("<%= j render partial: 'shared/access_point_buttons', locals: { community: @community, property_type: @property_type, same_access_points: @same_access_points, active_button: params[:id], plotted_id: params[:plotted_id], locks_present_hash: params[:locks_present_hash] } %>")
$('#access_point_modal').modal()
update_locks_fields()

<%# change the underlying access plot data related to the selected one %>
$('#access_point_' + <%= params[:plotted_id] %>).attr(
    {
        "id": "access_point_" + <%= params[:id] %>,
        "title": '<%= @active_access_point.name %>',
        "data-door-id": '<%= params[:id] %>',
        "href": '<%= open_access_point_modal_community_floorplate_access_point_path(@community, @property_type, @active_access_point, x_plot: @active_access_point.x_plot, y_plot: @active_access_point.y_plot, plotted_id: @active_access_point.id, locks_present_hash: params[:locks_present_hash])%>'
    }
)

remaining_floors = <%= raw @remaining_floors %>
setTimeout(function() { $(".save_lock").css('visibility', 'hidden') }, 1500);

$('#lock_provider').change(function(){
    update_locks_fields();
});

$('#lock_name').change(function(){
    var optionFound = false,
    datalist = this.list;

    for(var j = 0; j < datalist.options.length; j++) {
        if(this.value == datalist.options[j].value) {
            optionFound = true;
            break;
        }
    }

    if(optionFound) {
        this.setCustomValidity('');
    } 
    else if( $('#lock_name').val() != "" ) {
        this.setCustomValidity('Lock does not exist');
    }
    else{
        this.setCustomValidity('Select the lock');
    }
})








//----------- to be on secure side, in case DB has in-valid values ---------------//

if(typeof $('#locks_list')[0] !== 'undefined'){
    var optionFound = false, datalist_options = $('#locks_list')[0].options;

    for(var i = 0; i < datalist_options.length; i++) {
        if($('#lock_name').val()  == datalist_options[i].value) {
            optionFound = true;
            break;
        }
    }

    if(optionFound) {
        $('#lock_name')[0].setCustomValidity('');
    } 
    else if( $('#lock_name').val() != "" ) {
        $('#lock_name')[0].setCustomValidity('Lock does not exist');
    }
    else{
        $('#lock_name')[0].setCustomValidity('Select the lock');
    }
}