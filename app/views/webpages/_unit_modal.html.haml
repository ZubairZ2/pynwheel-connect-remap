#unitModal.modal.fade{:role => "dialog"}
  .c-popup
    .c-modal
      .c-modal-dialog.modal-xl
        .div.c-modal-header.virtual-tour-unit-modal-header
          .header-left
            %h5.c-modal-title#unit-marketing-name
            %i.propertyDetailName{style: "display: block"}
              %span#propertyDetailNameText Added to Favorites.

          .header-right
            %a.scheduled-tour-btn{ href: "", data: { toggle: "modal", target: "#scheduledTourModal" } } Scheduled Tour
            %a.additional-btn{ href: "", data: { toggle: "modal", target: "#additionalButtonModal" } } Additional Button
            %a.virtual-tour-btn{ href: "", data: { toggle: "modal", target: "#unitVirtualTourModal" } } 3D Tour

          %button.c-close{ type: "button", data: { dismiss: "modal" }, id: "close-modal" }
            %span ×
            
        %aside.c-modal-sidebar
          .c-modal-sidebar-inner
            .modal-sidebar-title
              %h1.section-title#floorplan-name

              .plan-image-pop
                .icon-heart#fav-icon-tag
                  %a{:href => "##", :id => "add-to-fav"}
                    %i.far.fa-heart
                  %a.hide{:href => "##", :id => "add-to-fav"}
                    %i.fa.fa-heart
            .modal-wrapper-mobile.hidden{style: "overflow: hidden"}
              .c-modal-body#zoomable-modal-image-responsive.centered-image
                .c-m-iframe-content
                  %img#responsive-floorplan-image{:src => "/assets/default.jpeg", :title => ""}/
            .c-modal-footer.zooming-content.zoomable-map-container
              %a.plus-action.zooming-action.zoom-in-res-modal.zoom-controls{:href => "#"}
                %img{:src => "/assets/plus.png"}/
              %a.minus-action.zooming-action.zoom-out-res-modal.zoom-controls{:href => "#"}
                %img{:src => "/assets/minus.png"}/
              %a.refresh-action.zooming-action.reset-res-modal.zoom-controls{:href => "#"}
                %img{:src => "/assets/refresh.png"}/
            .modal-middle-section
              .module-info
                %ul.module-list
                  - unless @community.hide_bedrooms_bathrooms
                    %li
                      %b
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span#bedrooms
                      %span.bedrooms
                        Bedrooms
                  - unless @community.hide_bedrooms_bathrooms
                    %li
                      %b
                        %img{:src => "/assets/bathroom-icon.png"}/
                        %span#bathrooms
                      %span.bathrooms
                        Bathrooms
                  %li
                    %b
                      %img{:src => "/assets/sq-feet-icon.png"}/
                      %span#square-feet
                    Sq Feet

              .availabilty-container-start
                %span.available-heading#available-text
                %b
                  %span#available-date

              %div#overall-scroller.overall-scroller.mobile_modal
                - if @community.display_rent && @community.display_pricing_options
                  #unit-lease-pricing-text-li.availabilty-container
                    %span.text-left.available-info

                    %span.text-right.show-more-option.available-info#leas-price-option
                      %a.show-more#show-more-price Show more prices
                      %a.show-more#hide-more-price.hidden Hide more prices

                    %span#first-unit-lease-pricing
                    #pricing-option.hidden
                      -# %div{style: "max-height: 6em; overflow-y: auto;"}
                      %div
                        %span#unit-lease-pricing

                .c-modal-sidebar-fees.availabilty-container{style: "font-size: 13px;"}
                  %a.show-more.show-fees{ href: "javascript:void(0);", onclick: "showFees()" } Show Fees
                  %a.show-more.hide-fees{ href: "javascript:void(0);", onclick: "hideFees()", style: "display: none;" } Hide Fees
                  %div.unit-additional-fees{style: "display: none;" }

                .c-modal-sidebar-description
                  %h4.des-heading More Details
                  %p.c-m-description#unit-description

                %div{style: "padding: 0px 0px 8px 7px"}
                  .unit-buttons

            .c-modal-sidebar-filters
              - if !params[:partner].present? && @community_info.credential.present? and @community_info.credential.apply_now.to_s == "true"
                .m-filters
                  - if @community_info.data_provider == "psi" || @community_info.data_provider == "realpagesvc" || @community_info.data_provider == "resman"
                    .m-filter-1.c-m-filter{style: 'display: none;'}
                      %label= @community_info.data_provider == "psi" ? 'Lease Start Date' : "Move In Date"
                      %input.c-m-input-control.datepicker#leasing-start-date{:type => "text", :style => "display: block !important", :readonly => "readonly"}/
                  - if @community_info.data_provider == "resman"
                    .m-filter-2.c-m-filter
                      %label Lease Term
                      = select_tag :lease_term , options_for_select([]),{:id => "lease_term", :class=>"lease-term-custom-select", :include_blank => "All "}
                .filter-action{style: 'display: flex !important;'}
                  - if @community_info.data_provider == "realpagesvc"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now","##",:onclick=>"set_realpagesvc_url(this);",:id=>"realpagesvc-anchor-tag", class: "apply-now apply_now"
                  - elsif @community_info.data_provider == "resman"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now", "##",:onclick=>"set_resman_url(this);",:id=>"psi-anchor-tag", class: "apply-now apply_now"

                  - elsif @community_info.data_provider == "psi"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now", "##",:onclick=>"set_psi_url(this);",:id=>"psi-anchor-tag", class: "apply-now apply_now"
                  - elsif @community_info.data_provider == "yardirentcafe"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now", "##",:onclick=>"set_yardirentcafe_url(this);",:id=>"psi-anchor-tag", class: "apply-now apply_now"
                  
                  - elsif @community_info.data_provider == "appfolio"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now", "##", :onclick=>"setAppFolioUrl(this);", :id=>"psi-anchor-tag", class: "apply-now apply_now"

                  - elsif @community_info.data_provider == "xml"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now", "##", :onclick=>"setXmlProviderUrl(this);", :id=>"psi-anchor-tag", class: "apply-now apply_now"

                  - elsif @community_info.data_provider == "beans"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price#total-market-rent
                        %span.per-month-price-text /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                    = link_to "Apply Now", "##", :onclick=>"setBeansProviderUrl(this);", :id=>"psi-anchor-tag", class: "apply-now apply_now"

                  - else
                    .unit-total-pricing{style: 'text-align: center'}
                      - if @community.display_rent
                        %span.fix-text
                          %span.c-m-total-price#total-market-rent
                          %span{style: 'font-size: 12px'} /month
                    %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost

                - if @community.display_rent
                  %span.move-in-date-text Pricing is based on a move-in date of today. Click “apply now” for more options.
                -else
                  %span.move-in-date-text Click “Apply Now” for pricing options or contact us for a quote.

              - elsif !params[:partner].present? && @community_info.credential.present? and @community_info.credential.apply_now.to_s == "separate_link"
                .m-filters
                  .m-filter-1.c-m-filter{style: 'display: none;'}
                    %label= @community_info.data_provider == "psi" ? 'Lease Start Date' : "Move In Date"
                    %input.c-m-input-control.datepicker#leasing-start-date{:type => "text", :style => "display: block !important", :readonly => "readonly"}/
                .filter-action{style: 'display: flex !important;'}
                  - if @community.display_rent
                    %span.fix-text
                      %span.c-m-total-price#total-market-rent
                      %span.per-month-price-text /month
                  %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                  %a.apply-now.apply_now{:href => @community_info.credential.separate_link,:target => "_blank" } Apply Now

                - if @community.display_rent
                  %span.move-in-date-text Pricing is based on a move-in date of today. Click “apply now” for more options.
                -else
                  %span.move-in-date-text Click “Apply Now” for pricing options or contact us for a quote.
              
              - else
                .disabaled-apply-now{style: 'text-align: center'}
                  %a.calculate-cost-btn.hidden{ href: "javascript:void(0);", onclick: "openExpenseCalculatorFromModal();" } Calculate Cost
                  - if @community.display_rent
                    %span.fix-text
                      %span.c-m-total-price#total-market-rent
                      %span{style: 'font-size: 12px'} /month
                  - else
                    %span.move-in-date-text{:style => "display: flex; justify-content: center; vertical-align: middle;align-items: center;"}
                      = @community.pricing_message
        
        .c-modal-wrapper
          = render partial: "image_with_zoom_controls"
