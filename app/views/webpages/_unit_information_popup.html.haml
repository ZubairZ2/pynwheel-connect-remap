#marker-popover.media.hidden
  %b#popover-marketing-name
  %i.fa.fa-heart.fav-heart.hidden
  %p#popover-floorplan
  .popupover-image{style: "text-align: center"}
    %img#media-object{:alt => "Sample Image", :src => "/assets/default.jpeg"}/
  .media-body
    - unless @community.hide_square_feet
      %p
        %b#popover-square-feet
        %small
          Square Feet
    - unless @community.hide_bedrooms_bathrooms
      %p
        %b#popover-bathrooms
        %small
          Bathrooms
    - unless @community.hide_bedrooms_bathrooms
      %p
        %b#popover-bedrooms
        %small
          Bedrooms
    %p
      %small#hover-available-text Available
      %b#popover-available-date
    %p
      - if @community.display_rent
        %b#popover-price