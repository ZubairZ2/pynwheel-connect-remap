- style = "position: relative; flex: 1;"
- if @community_info.is_beans_svg?
  - background_svg_url = @community_info&.validated_background_svg_image_url
  - if background_svg_url.present?
    %div#background-map-layer
      = inline_svg_from_url(background_svg_url, class_name: "background-map-svg")

- if @community_info.has_floorplates?
  - @floors.each do |floor|
    - floorplate = @floorplate_by_floor[floor]
    - svg_data = svg_image_url_and_dimensions(floorplate)
    - svg_exists = svg_data && svg_data.values_at(:width, :height).sum.positive?
    - if svg_exists
      %div.floorplate-wrapper{ data: svg_data, id: "floorplate_#{floor}", class: floor == @min_floor ? '' : 'hidden', style: style }
    - else
      %div.floorplate-wrapper{ id: "floorplate_#{floor}", style: 'margin: auto; flex: 1;', class: floor == @min_floor ? '' : 'hidden' }
        = image_tag "/assets/default.jpeg", class: "map-image-align sitemap-image floorplate-image", id: "f_#{floor}"
- else
  - svg_data = svg_image_url_and_dimensions(@community_info&.sitemap)
  - svg_exists = svg_data && svg_data.values_at(:width, :height).sum.positive?

  - if svg_exists
    %div#property-map.floorplate-wrapper{ data: svg_data, style: style }
  - else
    %div.floorplate-wrapper{ id: "property-map", style: "margin: auto; flex: 1;" }
      = image_tag "/assets/default.jpeg", class: "floorplate-image sitemap-image map-image-align", id: "property-map-image"

