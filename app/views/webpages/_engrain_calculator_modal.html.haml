#engrainCalculatorModal.modal.fade{role: "dialog", aria: {hidden: "true", labelledby: "engrainCalcLabel"}, tabindex: "-1"}
  .modal-dialog.modal-xl.engrain-calc-dialog
    .modal-content.engrain-calc-content
      .engrain-calc-header
        %h5.engrain-calc-title#engrainCalcLabel Calculate Estimated Cost
        %button.engrain-calc-close{type: "button", data: {dismiss: "modal"}, aria: {label: "Close"}}
          %span ×
      .engrain-calc-body
