
- coordinates_array = []
- units.each do |unit|
  - coordinates_array.push([unit.x_plot, unit.y_plot].map(&:to_i))

- unless svg_enabled
  - units.each do |unit|
    - x_plot, y_plot = coords = [unit.x_plot, unit.y_plot].map(&:to_i)
    - if coords.sum.positive? && floorplans_map[unit.floorplan_id].present?
      - unless coordinates_array.include?(coords)
        - coordinates_array.push(coords)
      = link_to "<div id='s_#{unit.id}' class='fas fa-map-marker-alt fa-map-marker-alt-responsive unit_marker' style='font-size: 22px; color: #{map_marker_color};'> <span style = '#{coordinates_array.count(coords) > 9 ? "position: absolute; left: #{spanSize_y - 1}px; top: #{spanSize_x + 2}px; font-size: #{spanSize_size - 4}px;" : "position: absolute; left: #{spanSize_y}px; top: #{spanSize_x}px; font-size: #{spanSize_size}px;"}' ></span> </div>".html_safe, "##", class: "marker #{coordinates_array.count(coords) > 1 ? 'overlapping-unit' : ''}", id: "m_#{unit.id}", style: "font-size: #{fontsize}px; position: absolute; left: #{x_plot}; top: #{y_plot};", **(fetch_unit_info_struct_for_webpage(unit, floorplans_map[unit.floorplan_id]))[:data_attributes], "data-unit-x-plot": (x_plot).to_i, "data-unit-y-plot": (y_plot).to_i

  - if community_info.show_amenity_key
    - if amenities.present?
      - if community_info.has_floorplates?
        - floors.each do |floor|
          - floorplate = floorplates.select{ |f| f.floors.include?(floor) }.first
          - fp_amenities = floorplate.amenities.select { |am| [floor, nil].include?(am.floor) }
          - fp_amenities.each do |amenity|
            - x_plot, y_plot = coords = [amenity.x_plot, amenity.y_plot].map(&:to_i)
            - if coords.sum.positive?
              = link_to "<span class='camera-icon camera-icon-responsive' style='border: 2px solid  #{amenity_marker_color};'><i class='fas fa-camera-retro' style='color: #{amenity_marker_color};'></i></span><span class='amenitytooltiptext'><h2 style='display:#{community_info.show_amenity_name ? "block": "none"}' >#{amenity.name}</h2><img src=#{amenity.standard_image_url} alt='Image Title'></span>".html_safe, "#", style: "left: #{x_plot}px; top: #{y_plot}px; position: absolute;", class: "a_#{floor} sitemap-amenity-marker amenity-marker hidden slider-amenity amenityTooltip", id: "a_#{amenity.id}", "data-amenity-id": amenity.id, "data-amenity-x-plot": x_plot, "data-amenity-y-plot": y_plot, "data-floor": floor, onclick: "openAmenityViewerModal(#{amenity.to_json}, #{amenity.amenity_galleries.to_json})"
      - else
        - amenities.each do |amenity|
          - x_plot, y_plot = coords = [amenity.x_plot, amenity.y_plot].map(&:to_i)
          - if coords.sum.positive?
            = link_to "<span class='camera-icon camera-icon-responsive' style='border: 2px solid  #{amenity_marker_color};'><i class='fas fa-camera-retro' style='color: #{amenity_marker_color};'></i></span><span class='amenitytooltiptext'><h2 style='display:#{community_info.show_amenity_name ? "block": "none"}' >#{amenity.name}</h2> <img src=#{amenity.standard_image_url} alt='Image Title'></span>".html_safe, "#", style: "left: #{x_plot}px; top: #{y_plot}px; position: absolute;", class: "sitemap-amenity-marker amenity-marker slider-amenity amenityTooltip", id: "a_#{amenity.id}", "data-amenity-id": amenity.id, "data-amenity-x-plot": x_plot, "data-amenity-y-plot": y_plot, onclick: "openAmenityViewerModal(#{amenity.to_json}, #{amenity.amenity_galleries.to_json})"