%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title Pynwheel | Favorites
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    %script{:src => "https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"}
    %script{:src => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"}
    = csrf_meta_tags
    = stylesheet_link_tag 'jquery.mCustomScrollbar.css'
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'jquery.arrayUtilities'
    = javascript_include_tag "update_session"
    = stylesheet_link_tag 'slick.css'
    = javascript_include_tag 'slick'
    %link{:href => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css", :rel => "stylesheet"}/
    %link{:href => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css", :rel => "stylesheet"}/
    %link{:href => "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css", :rel => "stylesheet"}/
    %link{:href => "https://fonts.googleapis.com", :rel => "preconnect"}/
    %link{:crossorigin => "", :href => "https://fonts.gstatic.com", :rel => "preconnect"}/
    %link{:href => "https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=swap", :rel => "stylesheet"}/
    = favicon_link_tag 'logo-small.png'
    / Google Font
    %link{:href => "https://fonts.googleapis.com/css?family=Raleway:100,200,300,400,500,600,700,800,900", :rel => "stylesheet"}/
  %body.floor-plan{style: "background-color:#303a3c; overflow: hidden"}
    .divLoading.hidden
    / Main content
    %div.alert_message
      = render partial: "/messages"
    %section.is-favorites.maps-analytics-container
      .mydiv-fav
        .select-list.select-list-fav
          = hidden_field_tag :maps_community_id, @community.id
          .need-to{:style=>"text-align: center;"}
            -if @community.map_logo.present?
              = image_tag map_logo_url(@community, true), :style => "width: 150px; padding: 1px 0px 5px 4px"
              
          - if @units.present?
            .need-to
              %p{:style => "margin-bottom: 20px"} Explore available floor plans on the interactive site map.
              = link_to "Take me there", community_webpages_path, :class=> "btn btn-primary apply-now btn-block btn-lg",:target => "_parent"
          .need-to
            %h3 Want to share your list?
            %p{:style => "margin-bottom: 20px"} Click the share button

            %button.btn.btn-primary.btn-block.btn-lg.apply-now.share-favorite{"data-toggle"=>"modal","data-target"=>"#share-favorites"} Share 
          .need-to
            %h3 Need to pare down your list?
            %p{:style => "margin-bottom: 20px"} Tap the heart to remove an item from the page, or click the clear button below to remove all items.
            %button.btn.btn-primary.btn-block.btn-lg.clear-all.apply-now{"data-toggle"=>"modal","data-target"=>"#confirm-favorites-delete"} Clear All   
          - if @community.self_tour && @community.scheduler_widget
            .need-to
              %h3 Want to schedule a tour?
              %p{:style => "margin-bottom: 20px"} Click the schedule a tour below button and schedule a tour.
              = link_to "SCHEDULE A TOUR", "#{@scheduler_widget_link}", :class=>"btn btn-primary apply-now btn-block btn-lg", :target=> "_blank"
          %span.logo-lg{:style => "text-align: center;"}
            %img{:alt => "", :src => '/assets/pyn-logo.png' , :title => "",:class => "pynwheel-logo-at-sidebar-bottom"}
        - if @units.nil? || !@units.present? && @units.count == 0
          = render partial: "empty_favorites_page"
        - else
          = render partial: "favorites_modal"

    .secondary-sidebar-color#sidebar-for-responsive{style: "text-align: center"}
      %ul.add-fav-options.res-fav-footer
        %li
          %a{:href => "#{community_webpages_path}",:target => "pynwheel_iframe"}
            %img{:src => "/assets/map-icon.png"}/
            %span.fav-option-icon-text View Map
        %li
          %a.share-favorite{"data-toggle"=>"modal","data-target"=>"#share-favorites"}
            %img{:src => "/assets/share-icon.png"}/
            %span.fav-option-icon-text Share Map
        %li
          %a{"data-toggle"=>"modal","data-target"=>"#confirm-favorites-delete"}
            %img{:src => "/assets/clear-all.png"}/
            %span.fav-option-icon-text Clear all

#confirm-favorites-delete.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Clear
      .modal-body
        Are you sure? You want to clear all selections?
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel   
        = link_to "Clear", clear_favorites_community_webpages_path(@community), :class=>"btn btn-danger btn-ok"
#share-favorites.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Share
      .modal-body
        %input.form-control#url{:value => favorites_share_link_community_webpages_url(:community_id=>@community,:session_id=>(@favorite.present? ? @favorite.session_id : "" )  )}/
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} cancel
        %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#url"} Copy to clipboard  

#communityWebpagesFavoriteData{data: {currency: @community.get_currency_symbol(), units: @fav_units_info} }

:javascript
  var data_provider = "#{@community.data_provider}"
  var units = $("#communityWebpagesFavoriteData").data("units"); //"#{@fav_units_info}";
  //units = units.replace(/&quot;/g,'"');
  //units = JSON.parse(units);

  var clipboardButton = document.getElementsByClassName('clipboard-btn')[0]
  clipboardButton.addEventListener('click', function(){
    document.getElementById('url').select();
  })
  var apply_now_url = "#{apply_now_community_webpages_url(@community)}"
  var redirect_url = "#{community_webpages_url(@community)}"
  $('.show-more-option-fav').click(function(){
      
    $('.show-more-option-fav').addClass('hidden');
    $('.hide-more-option').removeClass('hidden');
    $('.pricing-option-for-fav').removeClass('hidden');
  });

  $('.hide-more-option').click(function(){
      $('.hide-more-option').addClass('hidden');
      $('.show-more-option-fav').removeClass('hidden');
      $('.pricing-option-for-fav').addClass('hidden');
  });