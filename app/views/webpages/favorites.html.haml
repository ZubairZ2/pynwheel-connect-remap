%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title Pynwheel | Favorites
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    = csrf_meta_tags
    = stylesheet_link_tag 'jquery.mCustomScrollbar.css'
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'jquery.arrayUtilities'
    /%script{:async => "", :defer => "defer", :src => "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_API_KEY']}", :type => "text/javascript"}
    /%link{:href => "https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800", :rel => "stylesheet"}/
    = favicon_link_tag 'logo-small.png'
    / %link{:href => "css/bootstrap.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/font-awesome.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/slider.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/skins/_all-pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/jquery.mCustomScrollbar.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn-custom.css", :rel => "stylesheet"}/
    / HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries
    / WARNING: Respond.js doesn't work if you view the page via file://
    / /[if lt IE 9]
    /   <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    /   <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    / Google Font
    %link{:href => "https://fonts.googleapis.com/css?family=Raleway:100,200,300,400,500,600,700,800,900", :rel => "stylesheet"}/
  %body.floor-plan{style: "background-color:#303a3c;"}
    / Main content
    = render partial: "/messages"
    %section.is-favorites
      %a#favoriteclickme{href: "#"} Share and Clear
      .left-side.mydiv
        .select-list.select-list-fav
          / .select-title
          /   %h3.pull-left
          /     Send A
          /     %span Brochure
          / .thank-u
          /   %p
          /     Thank you for exploring all the great features offered at Atelier
          /     Apartments. Now it’s time to share. Email a customized brochure of your favorites by typing an email address below:
          / %form.send-to
          /   %label SEND TO:
          /   .form-group
          /     %input.form-control{type: "text"}/
          /     %button.send-btn{type: "submit"}
          /       %i.fa.fa-location-arrow
          .bg-bottom
            .need-to{:style => "margin-bottom: 40px;"}
              = image_tag @community.logo.present? ? @community.logo.url : "default.jpeg", :width => "288px"
              -#%button.btn.btn-primary.btn-block.btn-lg{:href=>community_favorite_settings_path} Take me there
          .bg-bottom
            .need-to
              %h3 Want to add favorites?
              %p{:style => "margin-bottom: 20px"} Explore available floor plans on the interactive site map.
              = link_to "Take me there", community_webpages_path, :class=> "btn btn-primary btn-block btn-lg",:target => "pynwheel_iframe"
              -#%button.btn.btn-primary.btn-block.btn-lg{:href=>community_favorite_settings_path} Take me there
          .bg-bottom
            .need-to
              %h3 Want to share your list?
              %p{:style => "margin-bottom: 20px"} Click the share button and share your favorites link
              %button.btn.btn-primary.btn-block.btn-lg{"data-toggle"=>"modal","data-target"=>"#share-favorites"} Share 
          .bg-bottom
            .need-to
              %h3 Need to pare down your list?
              %p{:style => "margin-bottom: 20px"} Tap the heart to remove an item from the page, or click the clear button below to remove all items.
              %button.btn.btn-primary.btn-block.btn-lg{"data-toggle"=>"modal","data-target"=>"#confirm-favorites-delete"} Clear All   
      .right-side
        - if @units.count == 0
          %b{:style => "color: #FFFFFF; position: relative; top: 45%; left: 45%;"} You have no favorites
        - @units.each do |unit|
          - floorplan = @floorplans.select{|f| f.provider_floorplan_id == unit.floorplan_id}.first
          .row{:id=>"row-#{unit.id}"}
            .col-md-12
              .modal-content.plan-modal
                .modal-body
                  .row
                    .col-md-6
                      .plane-details
                        .plan-modal
                          .modal-header
                            %h4.modal-title 
                              = unit.unit_market
                        .name
                          = floorplan.present? ? floorplan.name : nil
                        %ul
                          %li
                            %b= floorplan.present? ? hide_decimals(floorplan.square_feet) : nil
                            Sq Feet
                          %li
                            %b= floorplan.present? ? hide_decimals(floorplan.bathrooms) : nil
                            = "#{bathroom_text(floorplan)}" if floorplan.present?
                          %li
                            %b= floorplan.present? ? floorplan.bedrooms : nil
                            = "#{bedroom_text(floorplan)}" if floorplan.present?
                          %li 
                            %b= unit.available_date.strftime("%m/%d/%Y")
                            Available Date  
                          
                        .price-details
                          .price-count.pull-left
                            %span= "$#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}" 
                          .available-now
                            %p= unit.availability == "Unoccupied" ? "Available" : ""
                        - if @community.data_provider == "psi"
                          .date-select
                            %h5{:style => "margin-top: 20px;"}
                              Lease Start Date
                            .form-group
                              %input.form-control.datepicker.leasing-start-date{:type => "text", :readonly => "readonly",:value=>Date.today.strftime("%m/%d/%Y"),:style => "box-shadow: none;"}/
                              %i.fa.fa-calendar
                        .btn-apply
                          - if @community.data_provider == "realpagesvc"
                            = link_to "Apply Now", apply_now_community_webpages_path(@community), :target=> "_blank"
                          - elsif @community.data_provider == "psi" and floorplan.present?
                            = link_to "Apply Now", "##",:onclick=>"set_psi_url_on_favorite(this);",:id=>"psi-anchor-tag","data-community-property-id"=>@community.credential.property_id,"data-website"=>@community.website,"data-uri"=>uri(@community.website),"data-unit-provider-id"=>unit.provider_unit_id,"data-floorplan-provider-id"=>floorplan.provider_floorplan_id
                    .col-md-6
                      .plan-image
                        = image_tag unit.image.present? ? unit.image.url : (floorplan.present? && floorplan.image.present? ? floorplan.image.url : "/assets/default.jpeg")
                        .icon-heart
                          %a{"data-href"=> "/communities/#{@community.id}/webpages/delete_favorite?unit_id=#{unit.id}&from_favorites=true",href: "##",onclick: "deleteFavorite(this);"}
                            %i.fa.fa-heart#fav-icon-tag
#confirm-favorites-delete.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Clear Favorites
      .modal-body
        Are you sure? You want to clear all favorites.
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel   
        = link_to "Clear", clear_favorites_community_webpages_path(@community), :class=>"btn btn-danger btn-ok"
#share-favorites.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Share Favorites Link
      .modal-body
        %input.form-control#url{:value => favorites_share_link_community_webpages_url(:community_id=>@community,:session_id=>@favorite.session_id)}/
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} cancel
        %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#url"} Copy to clipboard     
