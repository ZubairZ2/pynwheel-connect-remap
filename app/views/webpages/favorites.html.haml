%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title Pynwheel | Favorites
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    %script{:src => "https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"}
    %script{:src => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"}
    = csrf_meta_tags
    = stylesheet_link_tag 'jquery.mCustomScrollbar.css'
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'jquery.arrayUtilities'
    = javascript_include_tag "update_session"
    = stylesheet_link_tag 'slick.css'
    = javascript_include_tag 'slick'
    %link{:href => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css", :rel => "stylesheet"}/
    %link{:href => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css", :rel => "stylesheet"}/
    %link{:href => "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css", :rel => "stylesheet"}/
    %link{:href => "https://fonts.googleapis.com", :rel => "preconnect"}/
    %link{:crossorigin => "", :href => "https://fonts.gstatic.com", :rel => "preconnect"}/
    %link{:href => "https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=swap", :rel => "stylesheet"}/
    /%script{:async => "", :defer => "defer", :src => "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_API_KEY']}", :type => "text/javascript"}
    /%link{:href => "https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800", :rel => "stylesheet"}/
    = favicon_link_tag 'logo-small.png'
    / %link{:href => "css/bootstrap.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/font-awesome.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/slider.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/skins/_all-pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/jquery.mCustomScrollbar.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn-custom.css", :rel => "stylesheet"}/
    / HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries
    / WARNING: Respond.js doesn't work if you view the page via file://
    / /[if lt IE 9]
    /   <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    /   <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    / Google Font
    %link{:href => "https://fonts.googleapis.com/css?family=Raleway:100,200,300,400,500,600,700,800,900", :rel => "stylesheet"}/
  %body.floor-plan{style: "background-color:#303a3c;"}
    / Main content
    = render partial: "/messages"
    %section.is-favorites
    %a#favoriteclickme{href: "#"} Share and Clear
    .mydiv_fav
      .select-list.select-list-fav
        = hidden_field_tag :maps_community_id, @community.id
        .need-to{:style=>"text-align: center;"}
          -if @community.logo.present?
            = image_tag @community.logo.present? ? @community.logo.url : "default.jpeg", :style => "width: 150px; padding: 1px 0px 5px 4px"
        .need-to
          %h3 Want to add favorites?
          %p{:style => "margin-bottom: 20px"} Explore available floor plans on the interactive site map.
          = link_to "Take me there", community_webpages_path, :class=> "btn btn-primary apply-now btn-block btn-lg",:target => "pynwheel_iframe"
        .need-to
          %h3 Want to share your list?
          %p{:style => "margin-bottom: 20px"} Click the share button and share your favorites link
          %button.btn.btn-primary.btn-block.btn-lg.apply-now.share-favorite{"data-toggle"=>"modal","data-target"=>"#share-favorites"} Share 
        .need-to
          %h3 Need to pare down your list?
          %p{:style => "margin-bottom: 20px"} Tap the heart to remove an item from the page, or click the clear button below to remove all items.
          %button.btn.btn-primary.btn-block.btn-lg.apply-now{"data-toggle"=>"modal","data-target"=>"#confirm-favorites-delete"} Clear All   
        - if @community.self_tour && @community.scheduler_widget
          .need-to
            %h3 Want to schedule a tour?
            %p{:style => "margin-bottom: 20px"} Click the schedule a tour below button and schedule a tour.
            = link_to "SCHEDULE A TOUR", "#{@scheduler_widget_link}", :class=>"btn btn-primary apply-now btn-block btn-lg", :target=> "_blank"
        %span.logo-lg{:style => "text-align: center;"}
          %img{:alt => "", :src => '/assets/pynwheel-logo.png' , :title => "",:class => "pynwheel-logo-at-sidebar-bottom"}
      - if @units.nil?
        %b{:style => "color: #FFFFFF; position: relative; top: 350px; left: 45%;"} You have no favorites
      - if !@units.present? && @units.count == 0
        %b{:style => "color: #FFFFFF; position: relative; top: 350px; left: 45%;"} You have no favorites
      .c-connect-map-wrapper
        .c-modal-body-content
          - @units = [] if @units.nil?
          - @units.each do |unit|
            - floorplan = @floorplans.select{|f| f.provider_floorplan_id == unit.floorplan_id}.first
            .map-slide-item
              .c-modal-header
                %h5.c-modal-title 
                  = unit.unit_market
                %button.c-close{:type => "button"}
                  .plan-image-pop
                    .icon-heart
                      %a{"data-href"=> "/communities/#{@community.id}/webpages/delete_favorite?unit_id=#{unit.id}&from_favorites=true",href: "##",onclick: "deleteFavorite(this);"}
                      %i.fa.fa-heart#fav-icon-tag
              .c-modal-sidebar
                .c-modal-sidebar-inner
                  .modal-sidebar-title
                    %h1.section-title 
                      = floorplan.present? ? floorplan.name : nil
                  .module-info
                    %ul.module-list
                      %li
                        %b
                          %img{:src => "/assets/bedroom-icon.png"}/
                          %b= floorplan.present? ? floorplan.bedrooms : nil
                        = "#{bedroom_text(floorplan)}" if floorplan.present?
                      %li
                        %b
                          %img{:src => "/assets/bathroom-icon.png"}/
                          %b= floorplan.present? ? hide_decimals(floorplan.bathrooms) : nil
                        = "#{bathroom_text(floorplan)}" if floorplan.present?
                      %li
                        %b
                          %img{:src => "/assets/sq-feet-icon.png"}/
                          %b= floorplan.present? ? hide_decimals(floorplan.square_feet) : nil 
                        Sq Feet
                  .availabilty-container-start
                    %span.available-heading= unit.availability == "Unoccupied" ? "Available" : ""
                    %b
                      %span{style: "margin-left: 4%"}= unit.available_date.strftime("%m/%d/%Y")
                  .availabilty-container
                    = unit.available_date.strftime("%m/%d/%Y")
                    %b
                      %span{style: "margin-left: 4%"}= "$#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"                       
                    %span.text-right.available-info{:id => "#{unit.id}-leas-price-option"}
                      %a.show-more.show-more-option{:id => "#{unit.id}-show-more-option"} Show more prices
                      %a.show-more.hide-more-option.hidden{:id => "#{unit.id}-hide-more-option"} Hide more prices
                  .c-modal-sidebar-description
                    %h4.des-heading Description
                    %p.c-m-description= unit.description.present? ? unit.description : (floorplan.description.present? ? floorplan.description : "Not Available")

                    - if @community.display_rent
                      %div.pricing-option-for-fav.hidden{:id => "#{unit.id}-pricing-option-for-fav"}
                        %h4.des-heading Pricing Options
                        %span{:id => "#{unit.id}-lease-pricing"}= unit.lease_pricing
                  -# .c-modal-sidebar-filters
                  - if @community.credential.present? and @community.credential.apply_now.to_s == "true"
                    .c-modal-sidebar-filters
                      .m-filters
                        - if @community.data_provider == "resman"
                          .m-filter-2.c-m-filter
                            %label Lease Term
                            %input.c-m-input-control#lease-term{:type => "number", :min => "1", :max => "36", :value => "12"}/
                        - if @community.data_provider == "psi" || @community.data_provider == "realpagesvc" || @community.data_provider == "resman"
                          .m-filter-1.c-m-filter
                            %label= @community.data_provider == "psi" ? 'Lease Start Date' : "Move In Date"
                            %input.c-m-input-control.datepicker#leasing-start-date{:type => "text", :style => "display: block !important", :readonly => "readonly",:value=>Date.today.strftime("%m/%d/%Y")}/
                      .filter-action
                        - if @community.data_provider == "realpagesvc"
                          - if @community.display_rent
                            %span.c-m-total-price= "$#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                          = link_to "Apply Now","##",:onclick=>"set_realpagesvc_url(this);",:id=>"realpagesvc-anchor-tag", class: "apply-now apply_now"
                        - elsif @community.data_provider == "resman"
                          - if @community.display_rent
                            %span.c-m-total-price= "$#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                          = link_to "Apply Now", "##",:onclick=>"set_resman_url(this);",:id=>"psi-anchor-tag", class: "apply-now apply_now"
                          
                        - else
                          - if @community.display_rent
                            %span.c-m-total-price= "$#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                          = link_to "Apply Now", "##",:onclick=>"set_psi_url(this);",:id=>"psi-anchor-tag", class: "apply-now apply_now"
                  - elsif @community.credential.present? and @community.credential.apply_now.to_s == "separate_link"
                    .m-filters
                      .m-filter-1.c-m-filter
                        %label= @community.data_provider == "psi" ? 'Lease Start Date' : "Move In Date"
                        %input.m-filter-1.c-m-filter.datepicker#leasing-start-date{:type => "text", :readonly => "readonly",:value=>Date.today.strftime("%m/%d/%Y")}/
                    .filter-action
                      - if @community.display_rent
                        %span.c-m-total-price= "$#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                      %a.apply-now.apply_now{:href => @community.credential.separate_link,:target => "_blank" } Apply Now
              .c-modal-wrapper
                .c-m-iframe-content
                  = image_tag unit.image.present? ? unit.image.url : (floorplan.present? && floorplan.image.present? ? floorplan.image.url : "/assets/default.jpeg")
                -# .c-modal-footer.zooming-content
                -#   %span.plus-action.zooming-action
                -#     %img{:src => "/assets/plus.png"}/
                -#   %span.minus-action.zooming-action
                -#     %img{:src => "/assets/minus.png"}/
                -#   %span.refresh-action.zooming-action
                -#     %img{:src => "/assets/refresh.png"}/
#confirm-favorites-delete.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Clear Favorites
      .modal-body
        Are you sure? You want to clear all favorites.
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Cancel   
        = link_to "Clear", clear_favorites_community_webpages_path(@community), :class=>"btn btn-danger btn-ok"
#share-favorites.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", :role => "dialog", :tabindex => "-1"}
  .modal-dialog
    .modal-content
      .modal-header
        Share Favorites Link
      .modal-body
        %input.form-control#url{:value => favorites_share_link_community_webpages_url(:community_id=>@community,:session_id=>(@favorite.present? ? @favorite.session_id : "" )  )}/
      .modal-footer
        %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} cancel
        %button.btn.btn-primary.clipboard-btn{"data-clipboard-target" => "#url"} Copy to clipboard  

