  %body.floor-plan{style: "background-color:#303a3c;"}
    / Main content
    = render partial: "/messages"
    -# %section.is-favorites
    %a#favoriteclickme{href: "#"} Share and Clear
    -# .mydiv
    .select-list.select-list-fav
      = hidden_field_tag :maps_community_id, @community.id
      -# .bg-bottom
      .need-to
        = image_tag @community.logo.present? ? @community.logo.url : "default.jpeg", :width => "100%"
      -#%button.btn.btn-primary.btn-block.btn-lg{:href=>community_favorite_settings_path} Take me there
      -# .bg-bottom
      .need-to
        %h3 Want to add favorites?
        %p{:style => "margin-bottom: 20px"} Explore available floor plans on the interactive site map.
        = link_to "Take me there", community_webpages_path, :class=> "btn btn-primary btn-block btn-lg",:target => "pynwheel_iframe"
      -#%button.btn.btn-primary.btn-block.btn-lg{:href=>community_favorite_settings_path} Take me there
      -# .bg-bottom
      .need-to
        %h3 Want to share your list?
        %p{:style => "margin-bottom: 20px"} Click the share button and share your favorites link
        %button.btn.btn-primary.btn-block.btn-lg.share-favorite{"data-toggle"=>"modal","data-target"=>"#share-favorites"} Share 
      -# .bg-bottom
      .need-to
        %h3 Need to pare down your list?
        %p{:style => "margin-bottom: 20px"} Tap the heart to remove an item from the page, or click the clear button below to remove all items.
        %button.btn.btn-primary.btn-block.btn-lg{"data-toggle"=>"modal","data-target"=>"#confirm-favorites-delete"} Clear All   
      - if @community.self_tour && @community.scheduler_widget
        -# .bg-bottom
        .need-to
          = link_to "SCHEDULE A TOUR", "#{@scheduler_widget_link}", :class=>"btn btn-primary", :target=> "_blank", :style => ' width: 290px; margin-top: 15px; height: 57px; font-size: 18px; padding-top: 17px; color: white;'
      %span.logo-lg{:style => "text-align: center;"}
        %img{:alt => "", :src => '/assets/pynwheel-logo.png' , :title => "",:style => "width: 60%; text-align: center;  margin-top: 15px; display: block; margin-left: auto; margin-right: auto;"}
    -# - binding.pry
    - if @units.nil?
      -# - binding.pry
      %b{:style => "color: #FFFFFF; position: relative; top: 45%; left: 45%;"} You have no favorites
    - if !@units.present? && @units.count == 0
      -# - binding.pry
      %b{:style => "color: #FFFFFF; position: relative; top: 45%; left: 45%;"} You have no favorites
    - @units = [] if @units.nil?
    - @units.each do |unit|
      - floorplan = @floorplans.select{|f| f.provider_floorplan_id == unit.floorplan_id}.first
      .row{:id=>"row-#{unit.id}"}
        .c-connect-map-wrapper
          .c-modal-header
            %h5.c-modal-title
              = unit.unit_market
          .name
            = floorplan.present? ? floorplan.name : nil
            %button.c-close{:type => "button"}
              %span
                %img.wishlist-icon{:src => "/assets/heart-icon.png"}/
          .c-modal-body-content
            .map-slide-item
              .c-modal-sidebar
                .c-modal-sidebar-inner
                  .modal-sidebar-title
                    %h1.section-title The Animation
                  .module-info
                    %ul.module-list
                      %li
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span 1 Bedroom
                      %li
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span 1 Bedroom
                      %li
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span 1 Bedroom
                  .availabilty-container
                    %h5.available-heading Available Now
                    %span.text-left.available-info 12 months $1910.00
                    %span.text-right.available-info
                      %a.show-more{:href => "#"} Show more prices
                  .c-modal-sidebar-description
                    %h4.des-heading Description
                    %p.c-m-description
                      Currently on special! Your first month is free when you sign a
                      12-month lease.
                  .c-modal-sidebar-filters
                    .m-filters
                      .m-filter-1.c-m-filter
                        %label Move in date
                        %input.c-m-input-control{:type => "date"}/
                      .m-filter-2.c-m-filter
                        %label Move in date
                        %select.c-m-input-control
                          %option{:selected => "selected"} All
                          %option{:value => "1"} One
                          %option{:value => "2"} Two
                          %option{:value => "3"} Three
                    .filter-action
                      %span.c-m-total-price $1910.00
                      %button.apply-now{:type => "button"} Apply Now
              .c-modal-wrapper
                .c-m-iframe-content
                  %img{:src => "/assets/module-map.png"}/
                .c-modal-footer.zooming-content
                  %span.plus-action.zooming-action
                    %img{:src => "/assets/plus.png"}/
                  %span.minus-action.zooming-action
                    %img{:src => "/assets/minus.png"}/
                  %span.refresh-action.zooming-action
                    %img{:src => "/assets/refresh.png"}/
            .map-slide-item
              .c-modal-sidebar
                .c-modal-sidebar-inner
                  .modal-sidebar-title
                    %h1.section-title The Animation
                  .module-info
                    %ul.module-list
                      %li
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span 1 Bedroom
                      %li
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span 1 Bedroom
                      %li
                        %img{:src => "/assets/bedroom-icon.png"}/
                        %span 1 Bedroom
                  .availabilty-container
                    %h5.available-heading Available Now
                    %span.text-left.available-info 12 months $1910.00
                    %span.text-right.available-info
                      %a.show-more{:href => "#"} Show more prices
                  .c-modal-sidebar-description
                    %h4.des-heading Description
                    %p.c-m-description
                      Currently on special! Your first month is free when you sign a
                      12-month lease.
                  .c-modal-sidebar-filters
                    .m-filters
                      .m-filter-1.c-m-filter
                        %label Move in date
                        %input.c-m-input-control{:type => "date"}/
                      .m-filter-2.c-m-filter
                        %label Move in date
                        %select.c-m-input-control
                          %option{:selected => "selected"} All
                          %option{:value => "1"} One
                          %option{:value => "2"} Two
                          %option{:value => "3"} Three
                    .filter-action
                      %span.c-m-total-price $1910.00
                      %button.apply-now{:type => "button"} Apply Now
              .c-modal-wrapper
                .c-m-iframe-content
                  %img{:src => "/assets/module-map.png"}/
                .c-modal-footer.zooming-content
                  %span.plus-action.zooming-action
                    %img{:src => "/assets/plus.png"}/
                  %span.minus-action.zooming-action
                    %img{:src => "/assets/minus.png"}/
                  %span.refresh-action.zooming-action
                    %img{:src => "/assets/refresh.png"}/
