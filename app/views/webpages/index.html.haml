%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title Pynwheel | Dashboard
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    = csrf_meta_tags
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    /%script{:async => "", :defer => "defer", :src => "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_API_KEY']}", :type => "text/javascript"}
    /%link{:href => "https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800", :rel => "stylesheet"}/
    = favicon_link_tag 'logo-small.png'
    / %link{:href => "css/bootstrap.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/font-awesome.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/slider.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/skins/_all-pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/jquery.mCustomScrollbar.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn-custom.css", :rel => "stylesheet"}/
    / HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries
    / WARNING: Respond.js doesn't work if you view the page via file://
    /[if lt IE 9]
      <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    / Google Font
    %link{:href => "https://fonts.googleapis.com/css?family=Raleway:100,200,300,400,500,600,700,800,900", :rel => "stylesheet"}/
  %body.floor-plan{:style => "background-color:#303a3c;"}
    / Main content
    %section.is-webpage
      %a#clickme{:href => "#"} Select Filter
      .left-side.mydiv
        .select-list
          .select-title
            %h3.pull-left
              Filter
              %span Map
            .pull-right
              .checkbox.checkbox-primary.pb-10
                %input{:type => "checkbox"}/
                %label
                  Select All
          .list-select
            %h4 Bedrooms
            / .checkbox.checkbox-primary.pb-15
            /   %input.filters#all-bedrooms-checkbox{:type => "checkbox",:name=>"bedrooms"}/
            /   %label
            /     All
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#one-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label
                1 Bedroom
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#two-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label
                2 Bedrooms
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#three-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label
                3 Bedrooms
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#four-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label
                4 Bedrooms
          .bg-bottom
            .list-select
              %h4 Available
              .checkbox.checkbox-primary.pb-15
                %input.filters#now-checkbox{:type => "checkbox",:name=>"available"}/
                %label
                  Now
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#thirty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label
                  In the next 30 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#thirty-to-sixty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label
                  In 31-60 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#sixty-to-ninty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label
                  In 61-90 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#ninty-to-one-twenty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label
                  In 91-120 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#one-twenty-plus-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label
                  In 121+ days
            .select-price
              %h3 Maximum Price Range
              .form-group
                %select.form-control
                  %option $ 2000
                  %option $ 1500
                  %option $ 1000
                  %option $ 500
            .select-price
              %h3 Maximum Square Footage
              .form-group
                %select.form-control
                  %option 200
                  %option 150
                  %option 100
                  %option 50
        - if current_community.has_floorplates?          
          .select-floorP
            %h4 Select Floor
            .select-floor-bg
              .showcase
                #content-3.content
                  .select-floor
                    %ul
                      %li
                        - current_community.floorplates.each do |floorplate|
                          = link_to floorplate.number,community_webpages_path(:floorplate_number=>floorplate.number), :class=>"#{floorplate.id == @floorplate.id ? 'selected' : ''}"
                          
                    
      .right-side
        / %button.btn.btn-info.btn-lg{"data-target" => "#myModal", "data-toggle" => "modal", :type => "button"} Open Modal
        .image-map#map{:style => "position: relative;"}
          - if current_community.has_floorplates?
            %img{:alt => "", :src => "#{@floorplate.image.url}", :title => ""}/
          - else
            %img{:alt => "", :src => "#{@community.sitemap.image.url}", :title => ""}/
          - units = @units.to_a.sort!{ |a,b| [a['building'].to_s,a['marketing_name'].to_s] <=> [b['building'].to_s,b['marketing_name'].to_s] }
          - units.each do |unit|
            - if unit.x_plot.to_i + unit.y_plot.to_i > 0
              = link_to "<i class='fa fa-asterisk'></i>".html_safe, "javascript::;", :class => "marker hidden", 'data-toggle' => "tooltip", :title => unit.marketing_name, :id => "m_#{unit.marketing_name}", :style => "left:#{unit.x_plot}px; top:#{unit.y_plot}px; position:absolute;","data-target" => "#unitModal", "data-toggle" => "modal","data-floorplan-name"=>unit.floorplan.name,"data-unit-marketing-name"=>unit.marketing_name,"data-market-rent"=>unit.floorplan.market_rent,"data-square-feet"=>unit.floorplan.square_feet,"data-availability"=>unit.availability,"data-available-date"=>unit.available_date,"data-bedrooms"=>unit.floorplan.bedrooms,"data-bathrooms"=>unit.floorplan.bathrooms
    / /.content
    / Trigger the modal with a button
    / Modal
    #unitModal.modal.fade{:role => "dialog"}
      .modal-dialog.modal-lg{:style => "width: 100%;max-width: 1330px;"}
        / Modal content
        .modal-content.plan-modal
          .modal-header
            %button.close{"data-dismiss" => "modal", :type => "button"} ×
            %h4.modal-title#unit-marketing-name 
          .modal-body
            .row
              .col-md-5
                .plane-details
                  .name#floorplan-name
                    
                  %ul
                    %li
                      %b
                        %span#square-feet 
                      Sq Feet
                    %li
                      %b
                        %span#bathrooms 
                      Bathrooms
                    %li
                      %b
                        %span#bedrooms 
                      Bedrooms
                    %li
                      %b
                        %span#available-date 
                      Available Date  
                  .price-details
                    .price-count.pull-left#market-rent
                     
                    .available-now
                      %p#availability
                  .btn-apply
                    %a{:href => "#"} Apply Now
              .col-md-7
                .plan-image
                  //%img{:alt => "", :src => "/assets/plan-image.jpg", :title => ""}/
    / jQuery 3
    / %script{:src => "js/jquery.min.js"}
    / %script{:src => "js/bootstrap.min.js"}
    / / Morris.js charts
    / %script{:src => "js/pyn.min.js"}
    / %script{:src => "js/bootstrap-slider.js"}
    / %script{:src => "js/jquery.mCustomScrollbar.concat.min.js"}
:javascript
  (function($){
    $(window).on("load",function(){
        
        $("#content-3").mCustomScrollbar({
            scrollButtons:{enable:true},
            theme:"light-thick",
            scrollbarPosition:"outside"
        });
      
        
    });
  })(jQuery);

  $('#clickme').click(function() {
      var $slider = $('.mydiv');
    //$('.right-side').css('margin-left', '0');
      $slider.animate({
        left: parseInt($slider.css('left'),10) == -331 ?
         0 : -331
      });
    });


  var units = "#{@units_with_floorplan_info}";
  units = units.replace(/&quot;/g,'"');
  units = JSON.parse(units);