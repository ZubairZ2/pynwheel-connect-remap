                    amenities = amenities.replace(/&quot;/g,'"');
                    amenities = JSON.parse(amenities);
                    //renderChangedUnits(units, is_floorplate, community);
          %footer.c-footer#footer.responsive-content.mobile-footer
            %ul.location-items.location-responsive.responsive-content.responsive-legends.align-home-buttons
              - if @community.enable_home_legend
                %li
                  %i.fas.fa-map-marker-alt{:style => "color: #{map_marker_color}; font-size: #{marker_font_size}px"}
                  %span Available home
              - if @community.enable_amenity_legend
                %li
                  .custom-icon{:style => "height:#{marker_font_size}px; width: #{marker_font_size}px; border: 2px solid  #{amenity_marker_color};"}
                    %i.fas.fa-camera-retro{:style => "color: #{amenity_marker_color}; font-size: #{camera_font_size}px; margin-top:#{camera_margin}px;"}
                  %span Amenity image

          %footer.c-footer#footer.desktop-content
            .inner-footer
              .footer-logo.desktop-content{:style=> "visibility: #{@community.powered_by_btn ? "" : "hidden" }"}
                %img{:src => "/assets/powered_by_logo.png"}/
                
              %ul.location-items
                - if @community.enable_home_legend
                  %li
                    %i.fas.fa-map-marker-alt{:style => "color: #{map_marker_color}; font-size: #{marker_font_size}px"}
                    %span Available home
                - if @community.enable_amenity_legend
                  %li
                    .custom-icon{:style => "height:#{marker_font_size}px; width: #{marker_font_size}px; border: 2px solid  #{amenity_marker_color};"}
                      %i.fas.fa-camera-retro{:style => "color: #{amenity_marker_color}; font-size: #{camera_font_size}px; margin-top:#{camera_margin}px;"}
                    %span Amenity image
              
              .div.map-instruction-text
                %span 
                  %strong Note: 
                  Press the Control (or Ctrl ⌃) key before you move your mouse and while you navigate
                
              .zooming-content.zoomable-map-container.desktop-content
                %a.plus-action.zooming-action.zoom-in-webpage.zoom-controls.zooming-content-h{:href => "#"}
                  %img{:src => "/assets/plus.png"}/
                %a.minus-action.zooming-action.zoom-out-webpage.zoom-controls.zooming-content-h{:href => "#"}
                  %img{:src => "/assets/minus.png"}/
                  - if @community.enable_three_d_maps
                    %a.refresh-action.zooming-action.reset-res-modal.zoom-controls.satelite-view-icon.hidden{:href => "#", style: "height: 45px", :onclick => "toggleToSateliteView()"}
                      %img{:src => "/assets/satellite.png"}/
                    %a.refresh-action.zooming-action.zoom-controls.map-options.3d-map-option{:href => "#", "data-current-map-type"=>"3d-current-map"}
                      %img{:src => "/assets/3D_modeling.svg"}/
                    %a.refresh-action.zooming-action.zoom-controls.map-options.2d-map-option.hidden{:href => "#", "data-current-map-type"=>"2d-current-map"}
                      %img{:src => "/assets/2D_modeling.svg"}/
                
      // Trigger the modal with a button
      = render partial: "unit_modal"
                
    - else
      .alert.alert-danger Community is Inactivated.

- @amenities&.each do |amenity|
  - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
    = render partial: "amenities_slider", locals: { amenity: amenity, galleries: amenity.amenity_galleries, show_amenity_name: @community.show_amenity_name }

= render partial: "unit_information_popup"
= render partial: "unit_num_popup"
= render partial: "3d_amenity_modal"
= render partial: "virtual_tour_modal"
= render partial: "amenity_virtual_tour_modal"

#communityWebpagesData{data: {currency: @community.get_currency_symbol(), community: @community.to_json, is_floorplate: @community_info.has_floorplates?, amenities: @amenities.to_json, map_configurations: @community&.three_d_maps_configuration.to_json} }

:javascript
  var large_image_height = 166;
  var apply_now_url = "#{apply_now_community_webpages_url(@community)}"
  var redirect_url = "#{community_webpages_url(@community)}"
  var has_floorplate = "#{@community_info.has_floorplates?}";
  var community_name = "#{@community_info.name}"
  var display_rent = "#{@community_info.display_rent}"
  var isSiteMap = "#{@community.sitemap.present?}"
  var img_width = "#{@community.sitemap.present? && @community.sitemap.image.present? ? (@community.sitemap.width || @community.sitemap.image.width) : nil}"
  var img_height = "#{@community.sitemap.present? && @community.sitemap.image.present? ? (@community.sitemap.height || @community.sitemap.image.height) : nil}"
  var current_floor = "#{@floors.present? and @floors.size > 0 ? min_unit_floor : 0}";
  var floors = "#{@floors.present? and @floors.size > 0 ? @floors : []}";
  floors = JSON.parse(floors);
  var current_width = $(window).width();
  
  if ((current_width > 767 && current_width < 993) && (window.matchMedia("(orientation: landscape)").matches)) {
   $(".c-modal-dialog").css("margin-top", "12%")
  }
  else if (current_width < 767 && (window.matchMedia("(orientation: landscape)").matches)) {
   $(".c-modal-dialog").css("margin-top", "27%")
   $("#responsive-floorplan-image").css("max-height", '300px')
  }
  
  function iOSversion() {

    if (/iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream)
      return true;
    else
      return false;
  }

  $("embed").ready(function(){
    if(iOSversion()){
      var target = $('#clickme');
      if (target.length) {
        $('html, body').animate({
          scrollTop: target.offset().top
        }, 500);
      }
    }
  });



  $(".webPageLoader").removeClass("hidden");
  $(window).on( "orientationchange", function( event ) {
        $(".webPageLoader").removeClass("hidden");
        window.location.reload();
    });
  setTimeout(function(){
    $(".webPageLoader").addClass("hidden");
  }, 1000);

  var window_height = window.innerHeight;
  var diff = 0
  var diffL = 0
  var ele = document.getElementsByClassName('fa-map-marker-alt-responsive');
  var amenityEle = document.getElementsByClassName('custom-icon-responsive');
  if (current_width < 993)
  {
    for (var i = 0; i < ele.length; i++ ) {
      ele[i].style.fontSize = (current_width * .76) / 30 + ((#{fontsize} - 25) / 5)
      ele[i].style.marginTop = diff - 3
      ele[i].style.marginLeft = diffL + 1
      ele[i].children[0].style.marginTop = -3
      ele[i].children[0].style.marginLeft = 1
      ele[i].children[0].style.left = (current_width * .20) / 30 + ((#{fontsize} - 25) / 9)
      factor = 0
      if ($(window).height() > 800)
      {
        factor = (($(window).height() ) / 800)
      }
      ele[i].children[0].style.top = (current_width * .15) / 30 + factor + ((#{fontsize} - 25) / 5)
      ele[i].children[0].style.fontSize = (current_width * .20) / 30 + ((#{fontsize} - 25) / 10)
    }
    for (var i = 0; i < amenityEle.length; i++ ) {
      amenityEle[i].style.height = (#{marker_font_size} / (1100 / current_width)  )
      amenityEle[i].style.width = (#{marker_font_size} / (1100 / current_width)  )
      amenityEle[i].children[0].style.marginTop = 1 * ( current_width / 250)
      amenityEle[i].children[0].style.fontSize = (#{marker_font_size} / (2800 / current_width)  )
    }
  }
  else if(current_width > 993 < current_width < 1500){
    for (var i = 0; i < ele.length; i++ ) {
      ele[i].style.fontSize = 20
      ele[i].children[0].style.left = 6
      ele[i].children[0].style.top = 4
      ele[i].children[0].style.fontSize = 6
    }
    for (var i = 0; i < amenityEle.length; i++ ) {
      amenityEle[i].style.height = 20
      amenityEle[i].style.width = 20
      amenityEle[i].children[0].style.marginTop = 3
      amenityEle[i].children[0].style.fontSize = 10
    }
  }
  var slides_to_show = 4;
  var slides_to_scroll = 1;
  var $slider = $("#slider");
  var initial_start;

  floors.length < 5 ? initial_start = 0 : initial_start = 0
  $(window).on('resize', function(){
    var win = $(this);
    $(".webPageLoader").removeClass("hidden");
    window.location.reload();
    if (win.width() >= 568) {
      $('#slider').slick('unslick');
      $slider.on('init', () => {
        mouseWheel($slider);
      }).slick({
        infinite: false,
        slidesToShow: 4,
        slidesToScroll: 1,
        vertical: true,
        initialSlide: initial_start,
        prevArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_left'><i class='fa fa-angle-left'></i></div>",
        nextArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_right'><i class='fa fa-angle-right'></i></div>",
      });
    } else if (win.width() <= 567) {
      $('#slider').slick('unslick');
      $slider.on('init', () => {mouseWheel($slider)}).slick({
        infinite: false,
        slidesToShow: 3,
        slidesToScroll: 1,
        vertical: false,
        speed: 6,
        initialSlide: floors.length < 4 ? 0 : 0,
        prevArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_left'><i class='fa fa-angle-left'></i></div>",
        nextArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_right'><i class='fa fa-angle-right'></i></div>",
      });

      $('.slick-track').css("width", "235px")
    }
  });
    
  if ($("#slider")[0]){
    if (current_width >= 568) {
      $slider.on('init', () => {mouseWheel($slider)}).slick({
        infinite: false,
        slidesToShow: 4,
        slidesToScroll: 1,
        vertical: true,
        speed: 6,
        initialSlide: initial_start,
        prevArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_left'><i class='fa fa-angle-left'></i></div>",
        nextArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_right'><i class='fa fa-angle-right'></i></div>",
      });
    }else{
      $slider.on('init', () => {
        mouseWheel($slider)
      }).slick({
        infinite: false,
        slidesToShow: 3,
        slidesToScroll: 1,
        vertical: false,
        speed: 6,
        initialSlide: floors.length < 4 ? 0 : 0,
        prevArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_left'><i class='fa fa-angle-left'></i></div>",
        nextArrow:
          "<div class='product-single__thumb-arrow product-single__thumb-arrow_right'><i class='fa fa-angle-right'></i></div>",
      });
      $('.slick-track').css("width", "235px")
    }

    function mouseWheel($slider) {
      $('#slider').on('wheel', { $slider: $slider }, mouseWheelHandler)
    }
    function mouseWheelHandler(event) {
      event.preventDefault()
      const $slider = event.data.$slider
      const delta = event.originalEvent.deltaY
      if(delta > 0) {
        $slider.slick('slickNext')
      }
      else {
        $slider.slick('slickPrev')
      }
    }
  }
  
  $(".slick-slide").click(function() {
    var anchorTag = $(this).find('a.floorplate-anchor');
    _3dFilterByFloor(anchorTag);
    anchorTag.click();
  });

  $(document).ready(function () {
    if(current_width >= 993){

      let main_container_height = $('.c-body').height() - $('.c-footer').height();
      console.log("main_container_height "+main_container_height)
      $('.floorplate-image').attr("height", main_container_height - large_image_height)

      /*if(isSiteMap == 'true') {
        $('.floorplate-image').attr("width", img_width)
      }*/
    }
    
    if(current_width <= 993){
      $("._3d-apply-filter-button").hide();
      $(".web-reset-button").hide();
    }
    
    $("#max_price_responsive").html("Max Price");
    $("#sq_feet_responsive").html("Min Sq Feet");
    $("#unit_availability").html("All");
    $("#bedroom_responsive").html("All");
    
    $(".mobile-trigger").click(function(){
      $(this).next('.mobile-filter-mega-menu').slideToggle();
    });

    if (current_width <= 767){
      $('.modal-wrapper-mobile').removeClass("hidden");
      $('.c-modal-wrapper').addClass("hidden");
    }
  });

  document.getElementById('filter').addEventListener('change', () => {
    var units = "#{@units_with_floorplan_info}";
    units = units.replace(/&quot;/g,'"');
    units = JSON.parse(units);
    var is_floorplate = "#{@community_info.has_floorplates?}"
    var community_name = "#{@community_info.name}"
    renderChangedUnits();
  });

  $("#show-more-price").click(function(){
    $('#show-more-price').addClass('hidden');
    $('#hide-more-price').removeClass('hidden');
    $("#pricing-option").removeClass('hidden')
  });

  $("#hide-more-price").click(function(){
    $('#hide-more-price').addClass('hidden');
    $('#show-more-price').removeClass('hidden');
    $("#pricing-option").addClass('hidden')
  }); 
  /////////////////////////////////////////
  var current_units = [];
  /////////////////////////////////////////
  var units = "#{@units_with_floorplan_info}";
  units = units.replace(/&quot;/g,'"');
  units = JSON.parse(units);
  _beansApiKey = "#{ENV['BEANS_API_KEY']}"
  
  var community_logo = "#{@community.logo.present? ? true : false}"
  if(community_logo == "false" && current_width < 567){
    $(".mobile-trigger").addClass("pt");
  }
