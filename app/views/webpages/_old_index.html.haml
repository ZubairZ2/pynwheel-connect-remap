- unless @community_info.locked
  = hidden_field_tag :maps_community_id, @community_info.id
  %section.is-webpage.maps-analytics-container{ style: "max-height: 100%;" }
    .c-wrapper{class: "#{@community_info.has_floorplates? ? 'floorplate' : 'no-floorplate'}", style: "max-height: 100%;" }
      %header.app-header
        .header-inner
          .app-logo-mobile
            - if @community.community_logo
              %a.logo{:href => @community.community_website}
                %img{:alt => "", :class => "webpage_logo", :src => "#{@community.logo.present? ? @community.logo : '/assets/pynwheel-connect-logo.png'}", :title => ""}
          .selection-fields
            .selectable-field
              %label Bedrooms
              = select_tag :unit_bedroom, options_for_select(@unit_bedrooms.present? ? @unit_bedrooms : []),{:class=>"custom-select", :include_blank => "All "}

            .selectable-field{ class: !@community_info.display_rent ? "pricing_filter_visibility" : nil }
              %label Max Price
              = select_tag :market_rent, options_for_select(@market_rent.present? ? @market_rent : []), { class: "custom-select" }

            .selectable-field
              %label Min Square Footage
              = select_tag :square_feet, options_for_select(@square_feet.present? ? @square_feet : []),{:class=>"custom-select"}
            .selectable-field
              %label Availability
              = select_tag :available_unit, options_for_select(@available_units.present? ? @available_units : []),{:class=>"custom-select", :include_blank => "All "}
            
            %button._3d-apply-filter-button{:type => "button", :onclick => "apply3DFilters();"}
              Apply
              %i.fa.fa-filter

            %button.reset-filter-button.web-reset-button{:type => "button", :onclick => "resetFilters();"}
              Reset
              %i.fa.fa-refresh
                
          .header-buttons-groups
            - if @square_feet.present?
              %a.transparent-btn.header-action-btn.view-saved-btn{:href => "#{favorites_community_webpages_path(@community)}",:target=>"_parent"}
                View Saved
                %i.fa.fa-heart
                
            - crm_provider = @community&.crm_credential&.crm_provider
            - data_provider = @community&.data_provider

            - if @community.self_tour && @community.scheduler_widget && (data_provider != "yardirentcafe" || data_provider != "yardi") && crm_provider != "yardirentcafe" 
              %a.colourd-btn.header-action-btn.schedule-tour-btn{:href => "#{@scheduler_widget_link}",:target=>"_blank"}
                Schedule Tour
              
            .footer-logo.responsive-content{:style=> "visibility: #{@community.powered_by_btn ? "" : "hidden" }"}
              %img{:src => "/assets/powered_by_logo.png"}/
              
          .mobile-trigger.responsive-content
            %span.filter-btn Filters
            %img{:src => "/assets/menu-icon.png"}/
          .mobile-filter-mega-menu.responsive-content
            .selectable-field
              %label Bedrooms
              = select_tag :responsive_unit_bedroom, options_for_select(@unit_bedrooms.present? ? @unit_bedrooms : []),{:class=>"custom-select", :include_blank => "All "}
            
            .selectable-field{ class: !@community_info.display_rent ? "pricing_filter_visibility" : nil }
              %label  Maximum Price
              = select_tag :responsive_market_rent, options_for_select(@market_rent.present? ? @market_rent : []), { class: "custom-select" }

            .selectable-field
              %label Min Square Footage
              = select_tag :responsive_square_feet, options_for_select(@square_feet.present? ? @square_feet : []),{:class=>"custom-select"}
            .selectable-field
              %label Availability
              = select_tag :responsive_available_unit, options_for_select(@available_units.present? ? @available_units : []),{:class=>"custom-select", :include_blank => "All "}
            
            %div{:style => "text-align: center; padding-bottom: 9px;display: flex;justify-content: center;"}
              %button.apply-now-responsive{:type => "button", :onclick => "applyFilters();"}
                Apply
                %i.fa.fa-filter

              %button.reset-filter-button{:type => "button", :onclick => "resetFilters();"}
                Reset
                %i.fa.fa-refresh
          .app-logo
            - if @community.community_logo
              %a.logo{:href => @community.community_website}
                %img{:alt => "", :class => "webpage_logo", :src => "#{@community.logo.present? ? @community.logo : '/assets/pynwheel-connect-logo.png'}", :title => ""}
      
      - if @community_info.has_floorplates?
        .c-sidebar#sidebar
          %a.c-sidebar-brand{:href => "#"}
            .sidebar-logo
              %h6 Floor
              %small Vacant Unit
          %ul.floor-counts.c-sidebar-nav.slider_class#slider
            - @floors.each do |floor|
              - floorplate = @floorplates.select{|f| f.floors.include?(floor)}.first
              %li.digits-list-item#digits-list-item{:class => "#{floor == min_unit_floor ? 'selected' : ''}"}
                = link_to (floorplate.floor_name_added ? (floorplate.floor_name.present? ? floorplate.floor_name : "Nil") : floor),'javascript:;;',"data-interest" => "", :style => "margin: 0;color: white;font-size: 28pt;font-weight: 600", :class=>"floorplate-anchor #{floor == min_unit_floor ? 'selected' : ''}",:id=>floor, "onclick": "_3dFilterByFloor(this)"
                %div.units-no{style: "margin-top: 11px"}
                  %span.teg-line{:id => "u_#{floor}"}

      .w-100.d-flex-justify-content-center.beans-map-container
        .beanswidget#beanswidget.some{:style => "width:100%; height:100%"}

      .c-body{style: "overflow: hidden", position: "fixed"}
        %div#tab
          %div.tablinks.active_unit_view
            = button_tag :onClick => "change_units_view(event, 'map_view')" do
              %i.fa.fa-map-marker
              %strong Map View

          %div.tablinks
            = button_tag :onClick => "change_units_view(event, 'list_view')" do
              %i.fa.fa-list
              %strong List View


        %div.map-body.map-container-center-align
          .right-side.parent.tabcontent.map_view{ id: "image-container", style: "position: relative;" }
            .alert.alert-danger.units-alert.fade.in{:style => "display:none;position:absolute;top:0%;width:100%;"}
              - if @community_info.has_floorplates?
                There are currently no available unit options on this floor.
              - else 
                There are currently no available unit options on this property.

            .image-map#zoomable.zoomable-map-container{style: "text-align: center"}
              - if @community_info.has_floorplates?
                - @floors.each do |floor|
                  - floorplate = @floorplates.select{|f| f.floors.include?(floor)}.first
                  - width, height = image_original_dimensions(floorplate).values
                  = image_tag (floorplate.validated_image_url || "/assets/default.jpeg"), class: "map-image-align sitemap-image floorplate-image #{floor == min_unit_floor ? '' : 'hidden'}", id: "f_#{floor}", data: { height: height, width: width }
              - else
                - width, height = image_original_dimensions(@community_info.sitemap).values
                %img.floorplate-image.sitemap-image.map-image-align{alt: "", src: (@community.sitemap.validated_image_url || "/assets/default.jpeg"), id: "property-map-image", title: "", data: { height: height, width: width } }

              - coordinates_array = []
              - units.each do |unit|
                - coordinates_array.push([unit.x_plot,unit.y_plot])
              - units.each do |unit|
                - if unit.x_plot.to_i + unit.y_plot.to_i > 0 and @floorplans.any?{|f| f.provider_floorplan_id == unit.floorplan_id}
                  - floorplan = @floorplans.select{|f| f.provider_floorplan_id == unit.floorplan_id}.first

                  - unless coordinates_array.include?([unit.x_plot,unit.y_plot])
                    - coordinates_array.push([unit.x_plot,unit.y_plot])
                  - if @community_info.has_floorplates?
                    = link_to "<div id='s_#{unit.id}' class='fas fa-map-marker-alt fa-map-marker-alt-responsive unit_marker' style='font-size: #{fontsize}; color: #{map_marker_color};'> <span style = '#{coordinates_array.count([unit.x_plot,unit.y_plot]) > 9 ? "position: absolute; left:#{spanSize_y - 1}px; top:#{spanSize_x + 2}px; font-size: #{spanSize_size - 4}px;" : "position: absolute; left:#{spanSize_y}px; top:#{spanSize_x}px; font-size: #{spanSize_size}px;"}' ></span> </div>".html_safe, "##", :class => "marker #{coordinates_array.count([unit.x_plot,unit.y_plot]) > 1 ? 'overlapping-unit' : ''}", :id => "m_#{unit.id}", :style => "position:absolute;","data-target" => "#unitModal", "data-toggle" => "modal","data-community-id"=>@community.id,"data-floor" => unit.floor ,"data-unit-id"=>unit.id,"data-is-fav"=>unit_id_is_in_cookies?(cookies[:favorite_unit_ids],unit.id),"data-provider"=>@community_info.data_provider,"data-website"=>@community_info.website,"data-availability-url"=>(unit.get_availability_url()),"data-community-property-id"=>(@community_info.credential.present? && @community_info.credential.property_id.present? ? @community_info.credential.property_id : 0),"data-unit-provider-id"=>unit.provider_unit_id,"data-floorplan-provider-id"=>floorplan.provider_floorplan_id,"data-floorplan-name"=>floorplan.present? ? floorplan.name : '',"data-unit-marketing-name"=>unit.api_unit_marketing_name,"data-market-rent"=> number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ','),"data-total-market-rent"=> number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ','),"data-square-feet"=>unit.square_feet? ? hide_decimals(unit.square_feet) : (floorplan.present? ? hide_decimals(floorplan.square_feet) : nil),"data-availability"=>unit.availability,"data-available-date"=>unit.available_date.present? ? determine_available_date(unit.available_date) : nil,"data-bedrooms"=>floorplan.present? ? floorplan.bedrooms.to_i : nil,"data-bathrooms"=>floorplan.present? ? hide_decimals(floorplan.bathrooms.to_i) : nil,"data-floorplan-image"=>unit.standard_image_url.present? ? unit.standard_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.standard_image_url : "/assets/default.jpeg"),"data-unit-x-plot"=>unit.x_plot,"data-unit-y-plot"=>unit.y_plot,"data-title"=>unit.api_unit_marketing_name,"data-sold"=>unit.sold,"data-available"=>unit.available,"data-unit-lease-pricing"=>unit.lease_pricing, "data-unit-additional-fees" => @community.get_additional_fees(unit), "data-unit-description"=>(unit.description.present? ? unit.description : (floorplan.description.present? ? floorplan.description : "")), "data-unit-virtual-tour-label"=>unit.get_virtual_tour_label, "data-unit-virtual-tour-url"=>unit.get_virtual_tour_url
                  - else
                    = link_to "<div id='s_#{unit.id}' class='fas fa-map-marker-alt fa-map-marker-alt-responsive unit_marker' style='font-size: #{fontsize}; color: #{map_marker_color};'> <span style = '#{coordinates_array.count([unit.x_plot,unit.y_plot]) > 9 ? "position: absolute; left:#{spanSize_y - 1}px; top:#{spanSize_x + 2}px; font-size: #{spanSize_size - 4}px;" : "position: absolute; left:#{spanSize_y}px; top:#{spanSize_x}px; font-size: #{spanSize_size}px;"}' ></span> </div>".html_safe, "##", :class => "marker #{coordinates_array.count([unit.x_plot,unit.y_plot]) > 1 ? 'overlapping-unit' : ''}", :id => "m_#{unit.id}", :style => "left:#{(unit.x_plot.to_f).to_s}px; top:#{(unit.y_plot.to_f)}px; position:absolute;","data-floor" => unit.floor ,"data-target" => "#unitModal", "data-toggle" => "modal","data-community-id"=>@community.id,"data-unit-id"=>unit.id,"data-is-fav"=>unit_id_is_in_cookies?(cookies[:favorite_unit_ids],unit.id),"data-provider"=>@community_info.data_provider,"data-website"=>@community_info.website,"data-availability-url"=>(unit.get_availability_url()),"data-community-property-id"=>(@community_info.credential.present? && @community_info.credential.property_id.present? ? @community_info.credential.property_id : 0),"data-unit-provider-id"=>unit.provider_unit_id,"data-floorplan-provider-id"=>floorplan.provider_floorplan_id,"data-floorplan-name"=>floorplan.present? ? floorplan.name : '',"data-unit-marketing-name"=>unit.api_unit_marketing_name,"data-market-rent"=> number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ','),"data-total-market-rent"=> number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ','),"data-square-feet"=>unit.square_feet? ? hide_decimals(unit.square_feet) : (floorplan.present? ? hide_decimals(floorplan.square_feet) : nil),"data-availability"=>unit.availability,"data-available-date"=>unit.available_date.present? ? determine_available_date(unit.available_date) : nil,"data-bedrooms"=>floorplan.present? ? floorplan.bedrooms.to_i : nil,"data-bathrooms"=>floorplan.present? ? hide_decimals(floorplan.bathrooms.to_i) : nil,"data-floorplan-image"=>unit.standard_image_url.present? ? unit.standard_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.standard_image_url : "/assets/default.jpeg"),"data-unit-x-plot"=>unit.x_plot,"data-unit-y-plot"=>unit.y_plot,"data-title"=>unit.api_unit_marketing_name,"data-sold"=>unit.sold,"data-available"=>unit.available,"data-unit-lease-pricing"=>unit.lease_pricing, "data-unit-additional-fees" => @community.get_additional_fees(unit), "data-unit-description"=>(unit.description.present? ? unit.description : (floorplan.description.present? ? floorplan.description : "")), "data-unit-virtual-tour-label" => unit.get_virtual_tour_label, "data-unit-virtual-tour-url" => unit.get_virtual_tour_url
              .hidden-units
              
              - if @community_info.show_amenity_key
                - if @amenities.present?
                  - if @community_info.has_floorplates?
                    - @floors.each do |floor|
                      - floorplate = @floorplates.select{|f| f.floors.include?(floor)}.first
                      - floorplate.amenities.where(floor: [floor, nil]).each do |amenity|
                        - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                          = link_to "<span class='camera-icon' style='border: 2px solid  #{amenity_marker_color};'><i class='fas fa-camera-retro' style='color: #{amenity_marker_color};'></i></span><span class='amenitytooltiptext'><h2 style='display:#{@community.show_amenity_name ? "block": "none"}' >#{amenity.name}</h2><img src=#{amenity.standard_image_url} alt='Image Title'></span>".html_safe, "#", :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;",:class=>"a_#{floor} amenity-marker hidden slider-amenity amenityTooltip", :id => "a_#{amenity.id}", "data-amenity-id"=>amenity.id, "data-amenity-x-plot"=>amenity.x_plot,"data-amenity-y-plot"=>amenity.y_plot, :onclick => "openAmenityViewerModal(#{amenity.to_json}, #{amenity.amenity_galleries.to_json})"
                  - else
                    - @amenities.each do |amenity|
                      - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                        = link_to "<span class='camera-icon' style='border: 2px solid  #{amenity_marker_color};'><i class='fas fa-camera-retro' style='color: #{amenity_marker_color};'></i></span><span class='amenitytooltiptext'><h2 style='display:#{@community.show_amenity_name ? "block": "none"}' >#{amenity.name}</h2> <img src=#{amenity.standard_image_url} alt='Image Title'></span>".html_safe, "#", :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;",:class=>"sitemap-amenity-marker amenity-marker slider-amenity amenityTooltip", :id => "a_#{amenity.id}", "data-amenity-id"=>amenity.id, "data-amenity-x-plot"=>amenity.x_plot,"data-amenity-y-plot"=>amenity.y_plot, :onclick => "openAmenityViewerModal(#{amenity.to_json}, #{amenity.amenity_galleries.to_json})"

            %footer.c-footer#footer.responsive-content.mobile-footer
              %ul.location-items.location-responsive.responsive-content.responsive-legends.align-home-buttons
                - if @community.enable_home_legend
                  %li
                    %i.fas.fa-map-marker-alt{:style => "color: #{map_marker_color};"}
                    %span Available home
                - if @community.enable_amenity_legend
                  %li
                    .custom-icon{:style => "height:#{marker_font_size}px; width: #{marker_font_size}px; border: 2px solid  #{amenity_marker_color};"}
                      %i.fas.fa-camera-retro{:style => "color: #{amenity_marker_color}; font-size: #{camera_font_size}px; margin-top:#{camera_margin}px;"}
                    %span Amenity image

            %footer.c-footer#footer.desktop-content
              .inner-footer
                .footer-logo.desktop-content{:style=> "visibility: #{@community.powered_by_btn ? "" : "hidden" }"}
                  %img{:src => "/assets/powered_by_logo.png"}/
                  
                %ul.location-items
                  - if @community.enable_home_legend
                    %li
                      %i.fas.fa-map-marker-alt{:style => "color: #{map_marker_color};"}
                      %span Available home
                  - if @community.enable_amenity_legend && @community.show_amenity_key
                    %li
                      .custom-icon{:style => "height:#{marker_font_size}px; width: #{marker_font_size}px; border: 2px solid  #{amenity_marker_color};"}
                        %i.fas.fa-camera-retro{:style => "color: #{amenity_marker_color}; font-size: #{camera_font_size}px; margin-top:#{camera_margin}px;"}
                      %span Amenity image
                
                .div.map-instruction-text
                  %span 
                    %strong Note: 
                    Press the Control (or Ctrl ⌃) key before you move your mouse and while you navigate
                  
                .zooming-content.zoomable-map-container.desktop-content
                  %a.plus-action.zooming-action.zoom-in-webpage.zoom-controls.zooming-content-h{:href => "#"}
                    %img{:src => "/assets/plus.png"}/
                  %a.minus-action.zooming-action.zoom-out-webpage.zoom-controls.zooming-content-h{:href => "#"}
                    %img{:src => "/assets/minus.png"}/
                    - if @community.enable_three_d_maps
                      %a.refresh-action.zooming-action.reset-res-modal.zoom-controls.satelite-view-icon.hidden{:href => "#", style: "height: 45px", :onclick => "toggleToSateliteView()"}
                        %img{:src => "/assets/satellite.png"}/
                      %a.refresh-action.zooming-action.zoom-controls.map-options.3d-map-option{:href => "#", "data-current-map-type"=>"3d-current-map"}
                        %img{:src => "/assets/3D_modeling.svg"}/
                      %a.refresh-action.zooming-action.zoom-controls.map-options.2d-map-option.hidden{:href => "#", "data-current-map-type"=>"2d-current-map"}
                        %img{:src => "/assets/2D_modeling.svg"}/

          .left-side.tabcontent.list_view
            -all_details = @units_with_floorplan_info.present? ? JSON.parse(@units_with_floorplan_info) : []
            %div.left-side-title
              %div.webpage-left-list-view-title.webpage-header
                %p#unit-title-count
                  #{all_details.count} Units Found

                - if @community_info.display_rent
                  = select_tag :filter,  options_for_select([["Sort by"],["Price: Low to High"], ["Price: High to Low"], ["Availability: Soonest to Latest"], ["Availability: Latest to Soonest"], ["Sq Ft: More to Less"], ["Sq Ft: Less to More"]])
                - else
                  = select_tag :filter,  options_for_select([["Sort by"], ["Availability: Soonest to Latest"], ["Availability: Latest to Soonest"], ["Sq Ft: More to Less"], ["Sq Ft: Less to More"]])
            
            %div#units-body

  // Trigger the modal with a button
  = render partial: "unit_modal"
            
- else
  .alert.alert-danger Community is Inactivated.
