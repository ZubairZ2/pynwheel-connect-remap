%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title Pynwheel | Favorites
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    = csrf_meta_tags
    = stylesheet_link_tag 'jquery.mCustomScrollbar.css'
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'jquery.arrayUtilities'
    = javascript_include_tag "update_session"
    = stylesheet_link_tag 'slick.css'
    = javascript_include_tag 'slick'
    %link{:href => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css", :rel => "stylesheet"}/
    %link{:href => "https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css", :rel => "stylesheet"}/
    %link{:href => "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css", :rel => "stylesheet"}/
    %link{:href => "https://fonts.googleapis.com", :rel => "preconnect"}/
    %link{:crossorigin => "", :href => "https://fonts.gstatic.com", :rel => "preconnect"}/
    %link{:href => "https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=swap", :rel => "stylesheet"}/
    = favicon_link_tag 'logo-small.png'
    /[if lt IE 9]
      <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    / Google Font
    %link{:href => "https://fonts.googleapis.com/css?family=Raleway:100,200,300,400,500,600,700,800,900", :rel => "stylesheet"}/
  %body.floor-plan{style: "background-color:#303a3c;"}
    .divLoading.hidden
    / Main content
    %section.is-favorites
      .modal-content.plan-modal.mb-10.border-zero
        .modal-body
          .container
            .row
              .col-xs-8.col-sm-8.col-md-9.custom-left-column
                .plane-details
                  .plan-modal
                    -# %h1.mb-20.text-primary
                      -# My Selections
                    %h3= @community.name
                    %p= @community.address
                    %p= @community.website if @community.website.present?

              .col-xs-4.col-sm-4.col-md-3.custom-right-column
                .plan-image
                  .plan-image-pop
                    = image_tag map_logo_url(@community, true) ,class: "img-responsive"
              .clear-fix
      .container{style: "width: 100%; display: inline-block; padding: inherit;"}
        = render partial: "favorites_modal"                                                       