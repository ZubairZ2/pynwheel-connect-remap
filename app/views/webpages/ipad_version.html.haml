%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %title Pynwheel | Dashboard
    %meta{:content => "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", :name => "viewport"}/
    = csrf_meta_tags
    = stylesheet_link_tag 'jquery.mCustomScrollbar.css'
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'jquery.arrayUtilities'
    /%script{:async => "", :defer => "defer", :src => "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_MAPS_API_KEY']}", :type => "text/javascript"}
    /%link{:href => "https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800", :rel => "stylesheet"}/
    = favicon_link_tag 'logo-small.png'
    / %link{:href => "css/bootstrap.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/font-awesome.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/slider.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/skins/_all-pyn.min.css", :rel => "stylesheet"}/
    / %link{:href => "css/jquery.mCustomScrollbar.css", :rel => "stylesheet"}/
    / %link{:href => "css/pyn-custom.css", :rel => "stylesheet"}/
    / HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries
    / WARNING: Respond.js doesn't work if you view the page via file://
    
    / Google Font
    /%link{:href => "https://fonts.googleapis.com/css?family=Raleway:100,200,300,400,500,600,700,800,900", :rel => "stylesheet"}/
  %body.floor-plan{:style => "background-color:#303a3c;"}
    / Main content
    %section.is-webpage
      %a#clickme{:href => "#"} Select Filter
      .left-side.mydiv
        .select-list{:class => @community.has_floorplates? ? "" : "adjust-width"}
          .select-title
            %h3.pull-left
              Filter
              %span Map
            .pull-right
              .checkbox.checkbox-primary.pb-10
                %input#select-all-filters-checkbox{:type => "checkbox",:name=>"all-filters-checkbox"}/
                %label.filter-label
                  Select All
          .list-select
            %h4 Bedrooms
            / .checkbox.checkbox-primary.pb-15
            /   %input.filters#all-bedrooms-checkbox{:type => "checkbox",:name=>"bedrooms"}/
            /   %label
            /     All
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#one-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label.filter-label
                1 Bedroom
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#two-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label.filter-label
                2 Bedrooms
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#three-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label.filter-label
                3 Bedrooms
            .checkbox.checkbox-primary.pb-15.hidden
              %input.filters#four-bedroom-checkbox{:type => "checkbox",:name=>"bedrooms"}/
              %label.filter-label
                4 Bedrooms
          .bg-bottom
            .list-select
              %h4 Available
              .checkbox.checkbox-primary.pb-15
                %input.filters#now-checkbox{:type => "checkbox",:name=>"available"}/
                %label.filter-label
                  Now
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#thirty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label.filter-label
                  In the next 30 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#thirty-to-sixty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label.filter-label
                  In 31-60 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#sixty-to-ninty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label.filter-label
                  In 61-90 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#ninty-to-one-twenty-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label.filter-label
                  In 91-120 days
              .checkbox.checkbox-primary.pb-15.hidden
                %input.filters#one-twenty-plus-days-checkbox{:type => "checkbox",:name=>"available"}/
                %label.filter-label
                  In 121+ days
            - if @market_rent.present?
              .select-price
                %h3 Maximum Price Range
                .form-group
                  = select_tag :market_rent, options_for_select(@market_rent),{:class=>"form-control", :include_blank => "select price range"}
            - if @square_feet.present?
              .select-price
                %h3 Maximum Square Footage
                .form-group
                  = select_tag :square_feet, options_for_select(@square_feet),{:class=>"form-control", :include_blank => "select area range"}
                %div
                  = link_to "View Saved", favorites_community_webpages_path(@community), :class=>"btn btn-primary btn-block view-btn", :target=> "_blank"
                     
       
        - if @community.has_floorplates?          
          .select-floorP
            %h4 Select Floor
            .select-floor-bg
              .showcase
                #content-3.content
                  .select-floor
                    %ul
                      - @community.floorplates.each do |floorplate|
                        %li
                          = link_to floorplate.number,'javascript:;;', :class=>"floorplate-anchor #{floorplate.id == @floorplate.id ? 'selected' : ''}",:id=>floorplate.number
                          
                    
      .right-side
        / %button.btn.btn-info.btn-lg{"data-target" => "#myModal", "data-toggle" => "modal", :type => "button"} Open Modal
        .image-map#map{:style => "position: relative;"}
          - if @community.has_floorplates?
            - @community.floorplates.each do |floorplate|
              =# image_tag floorplate.image.url,:class=>"floorplate-image #{floorplate.id == @floorplate.id ? '' : 'hidden'}",:id=>"f_#{floorplate.number}"
              .panzoom
                = image_tag "410.svg",:height=>"400",:width=>"400"
          - else
            /%img{:alt => "", :src => "#{@community.sitemap.present? ? @community.sitemap.image.url(:ipad) : "/assets/default.jpeg"}", :title => ""}/
            .panzoom
              = image_tag "410.svg",:height=>"800",:width=>"700"
            .buttons
              %button.zoom-in Zoom In
              %button.zoom-out Zoom Out
              
              %button.reset Reset
          - units = @units.to_a.sort!{ |a,b| [a['building'].to_s,a['marketing_name'].to_s] <=> [b['building'].to_s,b['marketing_name'].to_s] }
          - units.each do |unit|
            - if unit.x_plot.to_i + unit.y_plot.to_i > 0 and !unit.floorplan.nil?
              = link_to "<span class='custom-icon'>#{unit_count(@units_in_xy_group,unit.x_plot,unit.y_plot)}</span>".html_safe, "##", :class => "marker", 'data-toggle' => "tooltip", :title => unit.marketing_name, :id => "m_#{unit.marketing_name}", :style => "left:#{(unit.x_plot.to_f/1.37890625)}px; top:#{unit.y_plot.to_f/1.378698225}px; position:absolute;","data-target" => "#unitModal", "data-toggle" => "modal","data-community-id"=>@community.id,"data-unit-id"=>unit.id,"data-is-fav"=>unit_id_is_in_cookies?(cookies[:favorite_unit_ids],unit.id),"data-provider"=>@community.data_provider,"data-website"=>@community.website,"data-community-property-id"=>@community.credential.property_id,"data-unit-provider-id"=>unit.provider_unit_id,"data-floorplan-provider-id"=>unit.floorplan.provider_floorplan_id,"data-floorplan-name"=>unit.floorplan.present? ? unit.floorplan.name : '',"data-unit-marketing-name"=>unit.marketing_name,"data-market-rent"=>unit.effective_rent,"data-square-feet"=>unit.floorplan.present? ? unit.floorplan.square_feet : nil,"data-availability"=>unit.availability,"data-available-date"=>unit.available_date,"data-bedrooms"=>unit.floorplan.present? ? unit.floorplan.bedrooms : nil,"data-bathrooms"=>unit.floorplan.present? ? unit.floorplan.bathrooms : nil,"data-floorplan-image"=>unit.floorplan.present? ? unit.floorplan.image : nil,"data-lease-term"=>unit.lease_term
          - if @amenities.present?
            - if @community.has_floorplates?
              - @amenities.each do |amenity|
                - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                  = link_to "<i class='fa fa-star custom-icon-black'></i>".html_safe, "##", :title => amenity.name, :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;",:id=>"a_#{find_floorplate_number(amenity.amenityable_id)}",:class=>"amenity-marker hidden"
            - else
              - @amenities.each do |amenity|
                - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                  = link_to "<i class='fa fa-star custom-icon-black'></i>".html_safe, "##", :title => amenity.name, :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;"
    / /.content
    / Trigger the modal with a button
    / Modal
    #unitModal.modal.fade{:role => "dialog"}
      .modal-dialog.modal-lg{:style => "width: 100%;max-width: 1330px;"}
        / Modal content
        .modal-content.plan-modal
          .modal-header
            %button.close{"data-dismiss" => "modal", :type => "button"} ×
            %h4.modal-title#unit-marketing-name 
          .modal-body
            .row
              .col-md-5
                .plane-details
                  .name#floorplan-name
                    
                  %ul
                    %li
                      %b
                        %span#square-feet 
                      Sq Feet
                    %li
                      %b
                        %span#bathrooms 
                      Bathrooms
                    %li
                      %b
                        %span#bedrooms 
                      Bedrooms
                    %li
                      %b
                        %span#available-date 
                      Available Date  
                  .price-details
                    .price-count.pull-left#market-rent
                     
                    .available-now
                      %p#availability
                  - if @community.data_provider == "psi"    
                    .date-select 
                      %h5 Lease Start Date 
                      .form-group 
                        %input.form-control.datepicker#leasing-start-date{:type => "text",:value=>Date.today.strftime("%m/%d/%Y")}/ 
                        %i.fa.fa-calendar#leasing-start-date-icon    
                  .btn-apply
                    - if @community.data_provider == "realpagesvc"
                      = link_to "Apply Now", apply_now_community_webpages_path(@community), :target=> "_blank"
                    - elsif @community.data_provider == "psi"
                      = link_to "Apply Now", "##",:onclick=>"set_psi_url(this);",:id=>"psi-anchor-tag"
              .col-md-7
                .plan-image-pop
                  %img#floorplan-image{:src => "/assets/default.jpeg", :title => ""}/
                  .icon-heart#fav-icon-tag
                    %a{:href => "##"}
                      %i.fa.fa-heart-o
                    %a.hide{:href => "##"}
                      %i.fa.fa-heart
    / jQuery 3
    / %script{:src => "js/jquery.min.js"}
    / %script{:src => "js/bootstrap.min.js"}
    / / Morris.js charts
    / %script{:src => "js/pyn.min.js"}
    / %script{:src => "js/bootstrap-slider.js"}
    / %script{:src => "js/jquery.mCustomScrollbar.concat.min.js"}
:javascript
   (function() {
      var $section = $('#map');
      var $panzoom = $section.find('.panzoom').panzoom({
        $zoomIn: $section.find(".zoom-in"),
        $zoomOut: $section.find(".zoom-out"),
        $zoomRange: $section.find(".zoom-range"),
        $reset: $section.find(".reset"),
        startTransform: 'scale(0.9)',
        maxScale: 0.9,
        increment: 0.1,
        contain: true
      });
    })();



  $(".datepicker").datepicker({dateFormat: 'mm/dd/yy' }); 
  (function($){
    $(window).on("load",function(){
        
        $("#content-3").mCustomScrollbar({
            scrollButtons:{enable:true},
            theme:"light-thick",
            scrollbarPosition:"outside"
        });
      
        
    });
  })(jQuery);

  $('#clickme').click(function() {
      var $slider = $('.mydiv');
    //$('.right-side').css('margin-left', '0');
      $slider.animate({
        left: parseInt($slider.css('left'),10) == -331 ?
         0 : -331
      });
    });

  var has_floorplate = "#{@community.has_floorplates?}";
  var current_floorplate_number = "#{@floorplate.present? ? @floorplate.number : 0}";
  var floorplate_numbers = "#{@floorplate_numbers.present? ? @floorplate_numbers : []}";
  floorplate_numbers = JSON.parse(floorplate_numbers);
  /////////////////////////////////////////
  var current_units = [];
  /////////////////////////////////////////
  var units = "#{@units_with_floorplan_info}";
  units = units.replace(/&quot;/g,'"');
  units = JSON.parse(units);
  populateCurrentUnits();
