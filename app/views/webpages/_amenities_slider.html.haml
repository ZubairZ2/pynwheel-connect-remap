.modal{:role => "dialog", :id => "amenitySliderModal-#{amenity.id}", :tabindex => "-1", "aria-hidden" => "true", :style => "overflow-y: scroll;"}
  .modal-dialog.modal-xl.slider-amenity-modal-height
    .modal-content
      .modal-header
        .amenity-3d-modal-button
          .am-modal-title-div{:style => "visibility: #{show_amenity_name ? "" : "hidden"}"}
            %h4 #{amenity.name}
          .am-modal-button-div{style: "visibility: #{amenity.video_link.present? ? "flex" : "hidden" }"}
            %button.am-modal-button{onclick: "openAmenity3DTourModal(#{amenity.to_json})"} #{amenity.video_link_button_label.present? ? amenity.video_link_button_label : '3D Tour' }
          
          %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button", :onclick => "closeAmenityViewerModal(#{amenity.id})"} 
            %span{"aria-hidden" => "true"}
              %i.fa.fa-close
    
      .modal-body
        - amenity_url = amenity&.validated_image_url
        - if galleries.length > 0
          .amenity-carousel{id: "amenity-carousel-#{amenity.id}"}
            - if amenity_url.present?
              = image_tag amenity&.validated_image_url, class: "amenity-modal-image"

            - galleries.each do |gallery_image|
              = image_tag gallery_image&.image&.url, class: "amenity-modal-image"
        - else 
          - if amenity_url.present?
            = image_tag amenity&.validated_image_url, class: "amenity-modal-image"

:javascript
  var selectedAmenity = null
  var selectedGalleries = [];

  $(document).ready(function(){ });
