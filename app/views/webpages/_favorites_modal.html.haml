.c-connect-map-wrapper{"data-action": "#{params[:action]}"}
  .c-modal-body-content
    - @units = [] if @units.nil?
    - @units.each do |unit|
      - floorplan = unit.floorplan #@floorplans.select{|f| f.provider_floorplan_id == unit.floorplan_id}.first
      .map-slide-item
        .c-modal-header
          %h5.c-modal-title 
            = unit.unit_market
          %div.c-close
            .plan-image-pop
              .icon-heart
                %a{"data-href"=> "/communities/#{@community.id}/webpages/delete_favorite?unit_id=#{unit.id}&from_favorites=true",href: "##",onclick: "deleteFavorite(this);"}
                  %i.fa.fa-heart#fav-icon-tag
        .c-modal-sidebar
          .c-modal-sidebar-inner
            .modal-sidebar-title
              %h1.section-title 
                = floorplan.present? ? floorplan.name : nil
            .c-modal-wrapper.modal-image-fav
              .c-modal-body
                .c-m-iframe-content
                  = image_tag unit.standard_image_url.present? ? unit.validated_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.validated_image_url : "/assets/default.jpeg"), :id => "#{unit.id}-res-zoomable-image"
              .c-modal-footer-fav.zooming-content.zoomable-map-container
                %a.plus-action.zooming-action.zoom-controls{:href => "#", :id => "#{unit.id}-res-fav-zoom-in"}
                  %img{:src => "/assets/plus.png"}/
                %a.minus-action.zooming-action.zoom-controls{:href => "#", :id => "#{unit.id}-res-fav-zoom-out"}
                  %img{:src => "/assets/minus.png"}/
                %a.refresh-action.zooming-action.zoom-controls{:href => "#", :id => "#{unit.id}-res-fav-reset-zoom"}
                  %img{:src => "/assets/refresh.png"}/
            .module-info
              %ul.module-list
                %li
                  %b
                    %img{:src => "/assets/bedroom-icon.png"}/
                    %b= floorplan.present? ? floorplan.bedrooms : nil
                  = "#{bedroom_text(floorplan)}" if floorplan.present?
                %li
                  %b
                    %img{:src => "/assets/bathroom-icon.png"}/
                    %b= floorplan.present? ? hide_decimals(floorplan.bathrooms) : nil
                  = "#{bathroom_text(floorplan)}" if floorplan.present?
                %li
                  %b
                    %img{:src => "/assets/sq-feet-icon.png"}/
                    %b= floorplan.present? ? hide_decimals(floorplan.square_feet) : nil 
                  Sq Feet
            .availabilty-container-start
              - available_date = unit.availability == "Unoccupied" ? (unit.available_date.present? ? determine_available_date(unit.available_date) : nil) : "Unavailable"
              %span.available-heading= available_date.present? ? "Available" : ""
              %b
                %span{style: "margin-left: 4%"}= DateFormatter.formatted_date_by_region(@community.country_code, available_date)
            
            %div{style: "overflow-y: auto; height: max-content; max-height: 28em;"}
              .availabilty-container{:id => "#{unit.id}-unit-lease-pricing-text-li"}
                %span.available-info{:id => "#{unit.id}-leas-price-option"}
                
                - if @community.display_rent && @community.display_pricing_options
                
                  %div.show-pricing-options
                    %span.available-info
                      %a.show-more.show-more-option-fav{:id => "#{unit.id}-show-more-option-fav"} Show more prices
                      %a.show-more.hide-more-option.hidden{:id => "#{unit.id}-hide-more-option"} Hide more prices

                  %span{:id => "#{unit.id}-first-unit-lease-pricing"}
                  .pricing-option-for-fav.hidden{:id => "#{unit.id}-pricing-option-for-fav"}
                    %div{style: "max-height: 6em; overflow-y: auto;"}
                      %span{:id => "#{unit.id}-lease-pricing"}= unit.lease_pricing
                
              - additional_fees = @community.get_additional_fees(unit)

              - if additional_fees.present?
                .c-modal-sidebar-fees.availabilty-container
                  %a.show-more.show-fees{ href: "javascript:void(0);", onclick: "showFees()" } Show Fees
                  %a.show-more.hide-fees{ href: "javascript:void(0);", onclick: "hideFees()", style: "display: none;" } Hide Fees
                  %div.unit-additional-fees{style: "display: none;" }
                    = additional_fees.html_safe

              .c-modal-sidebar-description
                %h4.des-heading More Details
                .c-m-description= (unit.description.present? ? unit.description : (floorplan.description.present? ? floorplan.description : "Not Available")).html_safe

          .c-modal-sidebar-filters.sidebar-footer
            - if @community.credential.present? and @community.credential.apply_now.to_s == "true"
              - available_date = determine_available_date(unit.available_date)
              .c-modal-sidebar-filters.sidebar-footer
                .m-filters
                  - if @community.data_provider == "resman"
                    .m-filter-2.c-m-filter
                      %label Lease Term
                      = select_tag :lease_term , options_for_select([]),{:id => "#{unit.id}-lease_term", :class=>"lease-term-custom-select", "data-unit-id"=>(unit.id), onchange: 'changeEffectiveRent(this)', :include_blank => "All "}
                  - if @community.data_provider == "psi" || @community.data_provider == "realpagesvc" || @community.data_provider == "resman"
                    .m-filter-1.c-m-filter{style: 'display: none;'}
                      %label= @community.data_provider == "psi" ? 'Lease Start Date' : "Move In Date"
                      %input.c-m-input-control.datepicker.leasing-start-date{:id => "#{unit.id}-leasing-start-date", :type => "text", :style => "display: block !important", :readonly => "readonly", :value=>unit.available_date.present? ? available_date == "Now" ? Date.today : available_date : nil, "data-available_date"=>unit.available_date.present? ? determine_available_date(unit.available_date) : nil}/ 
                .filter-action
                  - if @community.data_provider == "realpagesvc"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',', :value=>unit.available_date.present? ? available_date == "Now" ? Date.today : available_date : nil)}"
                        %span.per-month-price-text.text-p /month
                    = link_to "Apply Now", apply_now_community_webpages_path(@community), :target=> "_blank", class: "apply-now apply_now"
                  - elsif @community.data_provider == "resman"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                        %span.per-month-price-text.text-p /month
                    = link_to "Apply Now", "##",:onclick=>"set_resman_url_on_favorites(this);",:id=>"psi-anchor-tag","data-unit-id"=>(unit.id),"data-availability-url"=>(unit.get_availability_url()),"data-community-property-id"=>@community.credential.property_id, class: "apply-now apply_now"
                  - elsif @community.data_provider == "psi"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                        %span.per-month-price-text.text-p /month
                    
                    - if unit.get_availability_url()
                      = link_to "Apply Now", "##",:onclick=>"set_psi_url_on_favorite(this);",:id=>"psi-anchor-tag","data-community-property-id"=>@community.credential.property_id,"data-availability-url"=>(unit.get_availability_url()),"data-website"=>@community.website,"data-uri"=>uri(@community.website),"data-unit-provider-id"=>unit.provider_unit_id,"data-floorplan-provider-id"=>floorplan.provider_floorplan_id, class: "apply-now apply_now"
                  - elsif @community.data_provider == "yardirentcafe"
                    - if @community.display_rent
                      %span.fix-text
                        %span.c-m-total-price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                        %span.per-month-price-text.text-p /month
                    = link_to "Apply Now", "##",:onclick=>"set_yardirentcafe_url_on_favrite(this);",:id=>"psi-anchor-tag", "data-community-property-id"=>@community.credential.property_id,"data-availability-url"=>(unit.get_availability_url()),"data-website"=>@community.website,"data-uri"=>uri(@community.website),"data-unit-provider-id"=>unit.provider_unit_id,"data-floorplan-provider-id"=>floorplan.provider_floorplan_id, class: "apply-now apply_now"
                  - else
                    .unit-total-pricing{style: 'text-align: center'}
                      - if @community.display_rent
                        %span.fix-text
                          %span.price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                          %span.per-month /month

                - if @community.display_rent
                  %span.move-in-date-text Pricing is based on a move-in date of today. Click “apply now” for more options.
                -else
                  %span.move-in-date-text Click “Apply Now” for pricing options or contact us for a quote.           
            
            - elsif @community.credential.present? and @community.credential.apply_now.to_s == "separate_link"
              .m-filters
                .m-filter-1.c-m-filter{style: 'display: none;'}
                  %label= @community.data_provider == "psi" ? 'Lease Start Date' : "Move In Date"
                  %input.m-filter-1.c-m-filter.datepicker.leasing-start-date{:id => "#{unit.id}-leasing-start-date", :type => "text", :readonly => "readonly", :value=>unit.available_date.present? ? available_date == "Now" ? Date.today : available_date : nil}/
              .filter-action
                - if @community.display_rent
                  %span.fix-text
                    %span.c-m-total-price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                    %span.per-month-price-text /month
                %a.apply-now.apply_now{:href => @community.credential.separate_link,:target => "_blank" } Apply Now
              
              - if @community.display_rent
                %span.move-in-date-text Pricing is based on a move-in date of today. Click “apply now” for more options.
              -else
                %span.move-in-date-text Click “Apply Now” for pricing options or contact us for a quote.
            
            - else
              .disabaled-apply-now
                - if @community.display_rent
                  %span.fix-text
                    %span.c-m-total-price{id: "#{unit.id}-total-price"}= "#{@community.get_currency_symbol}#{number_with_precision(unit.effective_rent, :precision => 2, :delimiter => ',')}"
                    %span{style: 'font-size: 12px'} /month
                - else
                  %span.move-in-date-text{:style => "display: flex; justify-content: center; vertical-align: middle;align-items: center;"} 
                    = @community.pricing_message

        .c-modal-wrapper.h-class
          .c-modal-body.centered-image
            .c-m-iframe-content
              = image_tag unit.standard_image_url.present? ? unit.validated_image_url : (floorplan.present? && floorplan.standard_image_url.present? ? floorplan.validated_image_url : "/assets/default.jpeg"), :id => "#{unit.id}-zoomable-fav-image"
          .c-modal-footer-fav.zooming-content.zoomable-map-container
            %a.plus-action.zooming-action.zoom-in-modal.zoom-controls{:href => "#", :id => "#{unit.id}-fav-zoom-in"}
              %img{:src => "/assets/plus.png"}/
            %a.minus-action.zooming-action.zoom-controls{:href => "#", :id => "#{unit.id}-fav-zoom-out"}
              %img{:src => "/assets/minus.png"}/
            %a.refresh-action.zooming-action.zoom-controls{:href => "#", :id => "#{unit.id}-fav-reset-zoom"}
              %img{:src => "/assets/refresh.png"}/

#communityWebpagesFavoriteData{data: {currency: @community.get_currency_symbol(), units: @fav_units_info} }

:javascript
  var data_provider = "#{@community.data_provider}"
  var units = $("#communityWebpagesFavoriteData").data("units");//"#{@fav_units_info}";
  //units = units.replace(/&quot;/g,'"');
  //units = JSON.parse(units);
  var apply_now_url = "#{apply_now_community_webpages_url(@community)}"
  var redirect_url = "#{community_webpages_url(@community)}"
  $('.show-more-option-fav').click(function(){   
    $('.show-more-option-fav').addClass('hidden');
    $('.hide-more-option').removeClass('hidden');
    $('.pricing-option-for-fav').removeClass('hidden');
  });
  
  $('.hide-more-option').click(function(){
    $('.hide-more-option').addClass('hidden');
    $('.show-more-option-fav').removeClass('hidden');
    $('.pricing-option-for-fav').addClass('hidden');
  });