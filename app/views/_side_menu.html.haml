/ Start menu nav left Section
%aside.main-sidebar
  / sidebar: style can be found in sidebar.less
  %section.sidebar
    / Sidebar user panel
    %ul.sidebar-menu{"data-widget" => "tree"}
      %li.treeview{:class=>"#{(controller_name =='communities' && params[:action] != 'import_page') || controller_name =='companies' ? 'active' : ''}"}
        %a{:href => "/"}
          %i.fa.fa-building-o
          %span Companies
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
            %a{:href => "/companies"} Companies
          %li{:class=>"#{controller_name =='communities' && params[:action] != 'import_page' ? 'active' : ''}"}
            = link_to "Communities", company_communities_path(current_company)
      - if params[:community_id].present?
        %li{:class=>"#{controller_name =='communities' && params[:action] =='edit' ? 'active' : ''}"}
          = link_to edit_company_community_path(current_company,current_community) do
            %i.fa.fa-info
            %span Community Info
      %li{:class=>"#{controller_name =='design' && params[:action] !='logo' ? 'active' : ''}"}
        = link_to community_design_index_path(current_community) do
          %i.fa.fa-tv
          %span Design
      %li{:class=>"#{controller_name =='settings' ? 'active' : ''}"}
        %a{:href => "#{community_settings_path(current_community)}"}
          %i.fa.fa-gears
          %span Data
          %span.pull-right-container
      %li{:class=>"#{controller_name =='design' && params[:action] =='logo' ? 'active' : ''}"}
        = link_to logo_community_design_index_path(current_community) do
          %i.fa.fa-image
          %span Logo
      %li{:class=>"#{controller_name =='home_page' ? 'active' : ''}"}
        = link_to community_home_page_index_path(current_community) do
          %i.fa.fa-home
          %span Home Page
      %li{:class=>"#{controller_name =='floorplans' ? 'active' : ''}"}
        %a{:href => "#{community_floorplans_path(current_community)}"}
          %i.fa.fa-columns
          %span Floor Plans
          %span.pull-right-container
      %li{:class=>"#{controller_name =='units' ? 'active' : ''}"}
        = link_to community_units_path(current_community)  do 
          %i.fa.fa-laptop
          %span Units
      - if (current_community.sitemap.present? && !(current_community.sitemap.new_record?)) || current_community.floorplates.present?
        %li{:class=>"#{controller_name =='sitemap_amenities' || controller_name =='floorplate_amenities' || (controller_name =='floorplates' && params[:amenities].present?) || params[:action] == 'plot_amenities' ? 'active' : ''}"}
          - if current_community.floorplates.present?
            = link_to community_floorplates_path(current_community,:amenities=>true)  do 
              %i.fa.fa-plus-square
              %span Amenities
          - else
            = link_to community_sitemap_amenities_path(current_community,current_community.sitemap)  do 
              %i.fa.fa-plus-square
              %span Amenities
      %li{:class=>"#{controller_name =='sitemaps' && params[:action] != 'plot_amenities' ? 'active' : ''}"}
        %a{:href => "#{plotexp_community_sitemaps_path(current_community)}"}
          %i.fa.fa-map-marker
          %span Property Map
          %span.pull-right-container 
      %li{:class=>"#{controller_name =='floorplates' && params[:amenities].blank? ? 'active' : ''}"}
        %a{:href => "#{community_floorplates_path(current_community)}"}
          %i.fa.fa-database
          %span Floor Plates
          %span.pull-right-container
      %li{:class=>"#{controller_name =='galleries' ? 'active' : ''}"}
        %a{:href => "#{community_galleries_path(current_community)}"}
          %i.fa.fa-cubes
          %span Galleries
      %li{:class=>"#{controller_name =='neighborhoods' ? 'active' : ''}"}
        %a{:href => "#{community_neighborhoods_path(current_community)}"}
          %i.fa.fa-bank
          %span Neighborhood
      %li{:class=>"#{controller_name =='favorite_settings' ? 'active' : ''}"}
        %a{:href => "#{community_favorite_settings_path(current_community)}"}
          %i.fa.fa-star
          %span Favorites   
      %li{:class=>"#{controller_name =='additional_pages' ? 'active' : ''}"}
        %a{:href => "#{community_additional_pages_path(current_community)}"}
          %i.fa.fa-pagelines
          %span Additional Pages
  / /.sidebar
/ End menu nav left Section 
