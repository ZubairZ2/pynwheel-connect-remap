/ Start menu nav left Section
%aside.main-sidebar{:style => "margin-top: 25px;"}
  / sidebar: style can be found in sidebar.less
  %section.sidebar
    / Sidebar user panel
    %ul.sidebar-menu{"data-widget" => "tree"}
      - if current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager? 
        %li.treeview{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
          %a{:href => "/"}
            %i.fa.fa-building-o
            %span All Accounts
            %span.pull-right-container
              %i.fa.fa-angle-right.pull-right
          %ul.treeview-menu
            - if (can? :crud, Company) || (current_user.is_super_admin? )
              %li.loader_class{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
                %a{:href => "/companies"} Companies
            %li.loader_class{:class=>"#{controller_name =='community_group' ? 'active' : ''}"}
              %a{:href => "/community_groups"} Community Group
            %li.loader_class{:class=>"#{controller_name =='communities' && params[:action] != 'import_page' ? 'active' : ''}"}
              = link_to "Communities", root_path
      - if current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager? 
        %li.loader_class{:class=>"#{controller_name =='communities' && params[:action] =='edit' ? 'active' : ''}"}
          = link_to edit_company_community_path(current_company,current_community) do
            %i.fa.fa-info
            %span Property Details
      - if (can? :edit_settings_page, current_user) || (current_user.is_super_admin?)
        %li.loader_class{:class=>"#{controller_name =='communities' && params[:action] =='settings_page' ? 'active' : ''}"}
          = link_to community_settings_page_path(current_community) do
            %i.fa.fa-cog
            %span Settings
      - if (current_user.is_super_admin? && current_community.touchscreen_app)
        %li.loader_class{:class=>"#{controller_name =='design' && params[:action] != 'logo' && params[:action] != 'secondary_logo' && params[:action] !='map_marker_design' ? 'active' : ''}"}
          = link_to community_design_index_path(current_community) do
            %i.fa.fa-tv
            %span Design
      - if (current_user.is_super_admin? || current_user.is_community_admin? ) && current_community.mdu
        %li.loader_class{:class=>"#{controller_name =='settings' ? 'active' : ''}"}
          %a{:href => "#{community_settings_path(current_community)}"}
            %i.fa.fa-gears
            %span Data
            %span.pull-right-container
      - if current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager? 
        %li.loader_class{:class=>"#{controller_name =='design' && (params[:action] =='logo' || params[:action] =='secondary_logo') ? 'active' : ''}"}
          = link_to logo_community_design_index_path(current_community) do
            %i.fa.fa-cubes
            %span Logo
      - if (current_community.touchscreen_app) && (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager?)
        %li.loader_class{:class=>"#{controller_name =='home_page' || controller_name =='homepage_icons' ? 'active' : ''}"}
          = link_to community_home_page_index_path(current_community) do
            %i.fa.fa-home
            %span Home Page

      - if current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager?       
        %li.treeview{:class=>"#{controller_name =='sitemaps' || controller_name =='floorplates' || controller_name =='sitemap_amenities' || controller_name =='floorplans' || controller_name =='units' || controller_name =='floorplate_amenities' || controller_name =='amenities' || controller_name =='floorplates' ? 'active' : ''}"}
          %a{:href => "/"}
            - if current_community.is_sitemap
              %i.fa.fa-map-marker
            - else
              %i.fa.fa-database
            %span Property Map Page
            %span.pull-right-container
              %i.fa.fa-angle-right.pull-right
          %ul.treeview-menu.property_map_intent_list{:style=>"#{controller_name =='elevators'? 'display: block' : ''}"}
            - if (current_community.is_sitemap && current_community.show_map && (current_user.is_super_admin? || current_user.is_community_admin? ))
              %li.loader_class{:class=>"#{controller_name =='sitemaps' && params[:action] != 'plot_amenities' ? 'active' : ''}"}
                %a{:href => "#{plotexp_community_sitemaps_path(current_community)}"}
                  %i.fa.fa-map-marker
                  %span Property Map
                  %span.pull-right-container
            - elsif current_community.show_map && (current_user.is_super_admin? || current_user.is_community_admin? )
              %li.loader_class{:class=>"#{controller_name =='floorplates' && params[:amenities].blank? ? 'active' : ''}"}
                %a{:href => "#{community_floorplates_path(current_community)}"}
                  %i.fa.fa-database
                  %span Property Map
                  %span.pull-right-container
            - if (current_community.sitemap.present? && !(current_community.sitemap.new_record?)) || current_community.floorplates.present?

              %li.loader_class{:class=>"#{controller_name =='sitemap_amenities' || controller_name =='floorplate_amenities' || controller_name =='amenities' || (controller_name =='floorplates' && params[:amenities].present?) || (params[:action] == 'plot_amenities' && controller_name != "floorplan_amenities" )? 'active' : ''}"}
                = link_to community_amenities_path(current_community)  do
                  %i.fa.fa-plus-square
                  %span Amenity Images
            - if (current_user.is_super_admin? || current_user.is_community_admin? ) && current_community.mdu
              %li.loader_class{:class=>"#{controller_name =='floorplans' || controller_name =='floorplan_amenities' ? 'active' : ''}"}
                %a{:href => "#{community_floorplans_path(current_community)}"}
                  %i.fa.fa-columns
                  %span Floor Plans
                  %span.pull-right-container
            - if (current_user.is_super_admin? || current_user.is_community_admin? ) && current_community.mdu
              %li.loader_class{:class=>"#{controller_name =='units' ? 'active' : ''}"}
                = link_to community_units_path(current_community)  do
                  %i.fa.fa-laptop
                  %span Units
      -#- if (current_community.is_sitemap && (current_user.is_super_admin? || current_user.is_community_admin? ))
      -#  %li{:class=>"#{controller_name =='sitemaps' && params[:action] != 'plot_amenities' ? 'active' : ''}"}
      -#    %a{:href => "#{plotexp_community_sitemaps_path(current_community)}"}
      -#      %i.fa.fa-map-marker
      -#      %span Property Map
      -#      %span.pull-right-container
      -#- elsif (current_user.is_super_admin? || current_user.is_community_admin? )
      -#  %li{:class=>"#{controller_name =='floorplates' && params[:amenities].blank? ? 'active' : ''}"}
      -#    %a{:href => "#{community_floorplates_path(current_community)}"}
      -#      %i.fa.fa-database
      -#      %span Property Map
      -#      %span.pull-right-container
      -#- if (current_community.sitemap.present? && !(current_community.sitemap.new_record?)) || current_community.floorplates.present?
      -#  %li{:class=>"#{controller_name =='sitemap_amenities' || controller_name =='floorplate_amenities' || controller_name =='amenities' || (controller_name =='floorplates' && params[:amenities].present?) || (params[:action] == 'plot_amenities' && controller_name != "floorplan_amenities" )? 'active' : ''}"}
      -#    = link_to community_amenities_path(current_community)  do
      -#      %i.fa.fa-plus-square
      -#      %span Amenity Images
      -#- if (current_user.is_super_admin? || current_user.is_community_admin? )
      -#  %li{:class=>"#{controller_name =='floorplans' || controller_name =='floorplan_amenities' ? 'active' : ''}"}
      -#    %a{:href => "#{community_floorplans_path(current_community)}"}
      -#      %i.fa.fa-columns
      -#      %span Floor Plans
      -#      %span.pull-right-container
      -#- if (current_user.is_super_admin? || current_user.is_community_admin? )
