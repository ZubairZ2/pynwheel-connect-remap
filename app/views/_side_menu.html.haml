/ Start menu nav left Section
%aside.main-sidebar
  / sidebar: style can be found in sidebar.less
  %section.sidebar
    / Sidebar user panel
    %ul.sidebar-menu{"data-widget" => "tree"}
      %li.treeview{:class=>"#{(controller_name =='communities' && params[:action] != 'import_page') || controller_name =='companies' ? 'active' : ''}"}
        %a{:href => "/"}
          %i.fa.fa-building-o
          %span Companies
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
            %a{:href => "/companies"} Companies
          %li{:class=>"#{controller_name =='communities' && params[:action] != 'import_page' ? 'active' : ''}"}
            %a{:href => "/communities"} Communities
      %li
        %a{:href => "#"}
          %i.fa.fa-home
          %span HomePage
      %li
        %a{:href => "#"}
          %i.fa.fa-tv
          %span Design
      %li.treeview{:class=>"#{controller_name =='floorplans' ? 'active' : ''}"}
        %a{:href => "#{community_floorplans_path(current_community)}"}
          %i.fa.fa-columns
          %span Appartments
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li{:class=>"#{controller_name =='floorplans' ? 'active' : ''}"}
            = link_to "Floor Plans", community_floorplans_path(current_community)
          %li
            %a{:href => "#"} Floor Plan Amenity Images
      %li.treeview{:class=>"#{controller_name =='units' ? 'active' : ''}"}
        %a{:href => "#"}
          %i.fa.fa-laptop
          %span Units
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li{:class=>"#{controller_name =='units' ? 'active' : ''}"}
            = link_to "Units", community_units_path(current_community)  
          %li
            %a{:href => "#"} Unit Amenity Images
      %li.treeview
        %a{:href => "#"}
          %i.fa.fa-map-marker
          %span Property Map
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li
            %a{:href => "#"} Name Here
          %li
            %a{:href => "#"} Name Here
          %li
            %a{:href => "#"} Name Here
      %li.treeview
        %a{:href => "#"}
          %i.fa.fa-database
          %span Floor Plates
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li
            %a{:href => "#"} Name Here
          %li
            %a{:href => "#"} Name Here
          %li
            %a{:href => "#"} Name Here
      %li
        %a{:href => "#"}
          %i.fa.fa-cubes
          %span Galleries
      %li
        %a{:href => "#"}
          %i.fa.fa-bank
          %span Neighborhood
      %li
        %a{:href => "#"}
          %i.fa.fa-star
          %span Favorites
      - if can? :manage, current_user    
        %li{:class=>"#{controller_name =='users' ? 'active' : ''}"}
          = link_to employees_path do 
            %i.fa.fa-user
            %span Users  
      %li.treeview{:class=>"#{controller_name =='settings' || (controller_name =='communities' && params[:action] =='import_page') ? 'active' : ''}"}
        %a{:href => "javascript::;"}
          %i.fa.fa-gears
          %span Settings
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu 
          - if can? :add_settings, current_user   
            %li{:class=>"#{controller_name =='settings' ? 'active' : ''}"}
              = link_to "Add Credentials",community_settings_path(current_community)
          %li{:class=>"#{controller_name =='communities' && params[:action] =='import_page' ? 'active' : ''}"}
            = link_to "Import Unit Data" , community_import_page_path(current_community)      
  / /.sidebar
/ End menu nav left Section
