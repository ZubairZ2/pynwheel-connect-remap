      -#    = link_to community_units_path(current_community)  do
      -#      %i.fa.fa-laptop
      -#      %span Units
      - if (current_community.touchscreen_app) && (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager?)
        %li.loader_class{:class=>"#{controller_name =='galleries' ? 'active' : ''}"}
          %a{:href => "#{community_galleries_path(current_community)}"}
            %i.fa.fa-image
            %span Gallery Page
        - if (current_community.touchscreen_app) && (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager?)
          %li.loader_class{:class=>"#{controller_name =='neighborhoods' ? 'active' : ''}"}
            %a{:href => "#{community_neighborhoods_path(current_community)}"}
              %i.fa.fa-bank
              %span Neighborhood Page
        - if (current_community.touchscreen_app) && (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager?) 
          %li.loader_class{:class=>"#{controller_name =='favorite_settings' || controller_name == 'ebrochure_menu_buttons' || controller_name == 'favorite_images' ? 'active' : ''}"}
            %a{:href => "#{community_favorite_settings_path(current_community)}"}
              %i.fa.fa-heart
              %span Favorites Page & eBrochure
        - if (current_community.touchscreen_app) && (current_user.is_super_admin? || current_user.is_community_admin?)
          %li.loader_class{:class=>"#{controller_name =='additional_pages' || controller_name =='imagepages' ? 'active' : ''}"}
            %a{:href => "#{community_additional_pages_path(current_community)}"}
              %i.fa.fa-star
              %span Additional Pages
      - if (current_user.is_super_admin? || current_user.is_community_admin? )
        %li
          %a{"data-toggle"=>"modal","data-target"=>"#share-webpages",:href => "##"}
            %i.fa.fa-share
            %span Webpages
      - if (current_community.self_tour && (current_user.is_super_admin? || current_user.is_community_admin?) && (current_community.scheduler_widget.nil? ? true : current_community.scheduler_widget ))
        %li
          %a{"data-toggle"=>"modal","data-target"=>"#share-scheduler-widget",:href => "##"}
            %i.fa.fa-share
            %span Tour Scheduler Widget
      -# - if (current_community.chat_control)
      -#   %li
      -#     %a{"data-toggle"=>"modal","data-target"=>"#share-chat-widget",:href => "##"}
      -#       %i.fa.fa-share
      -#       %span Chat Widget
      - if (current_community.self_tour) && current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager? 
        %li.loader_class{:class=>"#{controller_name =='tours_setup' || controller_name =='tours' ? 'active' : ''}"}
          %a{:href => "#{community_tours_path(current_community)}"}
            %i.fa.fa-plane
            %span Tour Setup
      - if (current_community.self_tour) && current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager? || current_user.is_view_visitor_details_page?
        %li.loader_class{:class=>"#{controller_name =='tour_users' ? 'active' : ''}"}
          %a{:href => "#{community_tour_users_path(current_community)}"}
            %i.fa.fa-sticky-note-o
            %span Visitor Details
      - if (current_community.self_tour && current_user.is_super_admin?) || current_user.is_view_visitor_details_page?
        %li.loader_class{:class=>"#{controller_name =='schedual_tours' ? 'active' : ''}"}
          %a{:href => "#{community_schedual_tours_path(current_community)}"}
            %i.fa.fa-sticky-note-o
            %span Scheduled Tours      
      - if (current_user.is_super_admin? || current_user.is_view_visitor_details_page?) && current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager? 
        %li.loader_class{:class=>"#{controller_name =='Community' && params[:action] == "logs" ? 'active' : ''}"}
          %a{:href => "#{community_logs_path(current_community)}"}
            %i.fa.fa-history
            %span CMS Logs
  / /.sidebar
/ End menu nav left Section 

