/ Start menu nav left Section
%aside.main-sidebar
  / sidebar: style can be found in sidebar.less
  %section.sidebar
    / Sidebar user panel
    %ul.sidebar-menu{"data-widget" => "tree"}
      - if params[:community_id].present?
        %li{:class=>"#{controller_name =='communities' && params[:action] =='edit' ? 'active' : ''}"}
          = link_to edit_community_path(current_community) do
            %i.fa.fa-info
            %span Community Info
      %li.treeview{:class=>"#{(controller_name =='communities' && params[:action] != 'import_page') || controller_name =='companies' ? 'active' : ''}"}
        %a{:href => "/"}
          %i.fa.fa-building-o
          %span Companies
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
            %a{:href => "/companies"} Companies
          %li{:class=>"#{controller_name =='communities' && params[:action] != 'import_page' ? 'active' : ''}"}
            %a{:href => "/communities"} Communities
      %li{:class=>"#{controller_name =='design' && params[:action] !='logo' ? 'active' : ''}"}
        = link_to community_design_index_path(current_community) do
          %i.fa.fa-tv
          %span Design
      %li.treeview{:class=>"#{controller_name =='settings' || (controller_name =='communities' && params[:action] =='import_page') ? 'active' : ''}"}
        %a{:href => "javascript::;"}
          %i.fa.fa-gears
          %span Data
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu 
          - if can? :add_settings, current_user   
            %li{:class=>"#{controller_name =='settings' ? 'active' : ''}"}
              = link_to "Add Credentials",community_settings_path(current_community)
          %li{:class=>"#{controller_name =='communities' && params[:action] =='import_page' ? 'active' : ''}"}
            = link_to "Import Unit Data" , community_import_page_path(current_community)  
      %li{:class=>"#{controller_name =='design' && params[:action] =='logo' ? 'active' : ''}"}
        = link_to logo_community_design_index_path(current_community) do
          %i.fa.fa-image
          %span Logo
      %li{:class=>"#{controller_name =='home_page' ? 'active' : ''}"}
        = link_to community_home_page_index_path(current_community) do
          %i.fa.fa-home
          %span Home Page
      %li{:class=>"#{controller_name =='floorplans' ? 'active' : ''}"}
        %a{:href => "#{community_floorplans_path(current_community)}"}
          %i.fa.fa-columns
          %span Floor Plans
          %span.pull-right-container
      %li{:class=>"#{controller_name =='units' ? 'active' : ''}"}
        = link_to community_units_path(current_community)  do 
          %i.fa.fa-laptop
          %span Units
      %li.treeview{:class=>"#{controller_name =='sitemaps' || controller_name == 'sitemap_amenities' ? 'active' : ''}"}
        %a{:href => "#"}
          %i.fa.fa-map-marker
          %span Property Map
          %span.pull-right-container
            %i.fa.fa-angle-right.pull-right
        %ul.treeview-menu
          %li{:class=>"#{controller_name =='sitemaps' && params[:action] == 'map' ? 'active' : ''}"}
            = link_to "Sitemap", map_community_sitemaps_path(current_community)
          %li{:class=>"#{controller_name =='sitemaps' && params[:action] == 'plotexp' ? 'active' : ''}"}
            = link_to "Plot Units", plotexp_community_sitemaps_path(current_community)
          - if Sitemap.exists? community_id: current_community.id  
            %li{:class=>"#{controller_name =='sitemap_amenities' && params[:action] == 'index' ? 'active' : ''}"}
              = link_to "Amenities",  community_sitemap_amenities_path(current_community,current_community.sitemap)  
      %li{:class=>"#{controller_name =='floorplates' ? 'active' : ''}"}
        %a{:href => "#{community_floorplates_path(current_community)}"}
          %i.fa.fa-database
          %span Floor Plates
          %span.pull-right-container
      %li{:class=>"#{controller_name =='galleries' ? 'active' : ''}"}
        %a{:href => "#{community_galleries_path(current_community)}"}
          %i.fa.fa-cubes
          %span Galleries
      %li{:class=>"#{controller_name =='neighborhoods' ? 'active' : ''}"}
        %a{:href => "#{community_neighborhoods_path(current_community)}"}
          %i.fa.fa-bank
          %span Neighborhood
      %li{:class=>"#{controller_name =='favorite_settings' ? 'active' : ''}"}
        %a{:href => "#{community_favorite_settings_path(current_community)}"}
          %i.fa.fa-star
          %span Favorites    
  / /.sidebar
/ End menu nav left Section
