%aside.main-sidebar{:style => "margin-top: 25px;"}
  %section.sidebar
    %ul.sidebar-menu{"data-widget" => "tree"}
      - if current_user.is_admin?
        %li.treeview{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
          %a{:href => "/"}
            %i.fa.fa-building-o
            %span All Accounts
            %span.pull-right-container
              %i.fa.fa-angle-right.pull-right
          %ul.treeview-menu
            - if (can? :crud, Company) || (current_user.is_super_admin? )
              %li.loader_class{:class=>"#{controller_name =='companies' ? 'active' : ''}"}
                %a{:href => "/companies"} Companies
            %li.loader_class{:class=>"#{controller_name =='community_group' ? 'active' : ''}"}
              - unless (current_user.is_dwelo_admin? || current_user.is_regional_admin?)
                %a{:href => "/companies/#{current_company.id}/community_groups"} Community Group

            - if (current_user.is_super_admin? || current_user.is_dwelo_admin?)
              %li{:class=>"#{controller_name =='regions' ? 'active' : ''}"}
                %a{:href => "/companies/#{current_company.id}/regions"} Region
            %li.loader_class{:class=>"#{controller_name =='communities' && params[:action] != 'import_page' ? 'active' : ''}"}
              = link_to "Communities", root_path
          - if current_user.is_admin?
            %li.loader_class{:class=>"#{controller_name =='analytics' && params[:action] =='index' ? 'active' : ''}"}
              = link_to analytics_path(community: current_community.id) do
                %i.fa.fa-bar-chart
                %span Analytics
        %li.treeview{:class=>"#{controller_name =='companies' ? 'active' : 'active'}"}
          %a{:href => "/"}
            %i.fa.fa-building
            %span Company
            %span.pull-right-container
              %i.fa.fa-angle-right.pull-right
          %ul.treeview-menu{:style=>"#{controller_name =='companies'? 'display: block' : ''}"}
            %li.loader_class{:class=>"#{controller_name =='companies' && params[:action] == "edit"  ? 'active' : ''}"}
              %a{:href => "#{ edit_company_path(current_company)}"}
                %i.fa.fa-info
                %span Company Details
                %span.pull-right-container

            %li.loader_class{:class=>"#{controller_name =='company_settings' &&  (params[:action] == 'edit' || params[:action] == 'new') ? 'active' : ''}"}
              %a{:href => "#{ current_company.company_setting.present? ? edit_company_company_setting_path(current_company, current_company.company_setting,community_id: current_community.id) : new_company_company_setting_path(current_company, community_id: current_community.id)}"}
                %i.fa.fa-gears
                %span Company Data
                %span.pull-right-container
      - if current_user.is_admin? || current_user.is_community_assistant?
        %li.loader_class{:class=>"#{controller_name =='communities' && params[:action] =='edit' ? 'active' : ''}"}
          = link_to edit_company_community_path(current_company,current_community) do
            %i.fa.fa-info
            %span Property Details
      - if (can? :edit_settings_page, current_user) || (current_user.is_super_admin?)
        %li.loader_class{:class=>"#{controller_name =='communities' && params[:action] =='settings_page' ? 'active' : ''}"}
          = link_to community_settings_page_path(current_community) do
            %i.fa.fa-cog
            %span Settings
            
      - if current_user.is_super_admin?
        %li.loader_class{:class=>"#{controller_name =='design' && params[:action] != 'logo' && params[:action] != 'secondary_logo' && params[:action] !='map_marker_design' ? 'active' : ''}"}
          = link_to community_design_index_path(current_community) do
            %i.fa.fa-tv
            %span Design

      - if (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_company_admin? || current_user.is_regional_admin? ) && current_community.mdu
        %li.loader_class{:class=>"#{controller_name =='settings' ? 'active' : ''}"}
          %a{:href => "#{community_settings_path(current_community)}"}
            %i.fa.fa-gears
            %span Data
            %span.pull-right-container
      - if (current_user.is_super_admin? || current_user.is_dwelo_admin?) and current_community.self_tour and current_community.enable_locks
        %li.loader_class{:class=>"#{controller_name =='dwelos' ? 'active' : ''}"}
          %a{:href => "#{new_community_dwelo_path(current_community)}"}
            %i.fa.fa-lock
            %span Locks
            %span.pull-right-container
            
      - if current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_community_manager?
        %li.loader_class{:class=>"#{controller_name =='design' && (params[:action] =='logo' || params[:action] =='secondary_logo') ? 'active' : ''}"}
          = link_to logo_community_design_index_path(current_community) do
            %i.fa.fa-cubes
            %span Logo
      - if (current_community.touchscreen_app) && (current_user.is_admin? )
        %li.loader_class{:class=>"#{controller_name =='home_page' || controller_name =='homepage_icons' ? 'active' : ''}"}
          = link_to community_home_page_index_path(current_community) do
            %i.fa.fa-home
            %span Home Page

      - if current_user.is_admin?
        %li.treeview.menu-open{:class=>"#{controller_name =='sitemaps' || controller_name =='floorplates' || controller_name =='sitemap_amenities' || controller_name =='floorplans' || controller_name =='units' || controller_name =='floorplate_amenities' || controller_name =='amenities' || controller_name =='floorplates' ? 'active' : ''}"}
          %a{:href => "/"}
            - if current_community.is_sitemap
              %i.fa.fa-map-marker
            - else
              %i.fa.fa-database
            %span Property Map
            %span.pull-right-container
              %i.fa.fa-angle-right.pull-right
          %ul.treeview-menu.property_map_intent_list{:style=>"display: block"}
            - if (current_community.is_sitemap && current_community.show_map && current_user.is_admin? )
              %li.loader_class{:class=>"#{controller_name =='sitemaps' && params[:action] != 'plot_amenities' ? 'active' : ''}"}
                %a{:href => "#{plotexp_community_sitemaps_path(current_community)}"}
                  %i.fa.fa-map-marker
                  %span Property Map
                  %span.pull-right-container
            - elsif current_community.show_map && (current_user.is_admin? )
              %li.loader_class{:class=>"#{controller_name =='floorplates' && params[:amenities].blank? ? 'active' : ''}"}
                %a{:href => "#{community_floorplates_path(current_community)}"}
                  %i.fa.fa-database
                  %span Property Map
                  %span.pull-right-container
            - if (current_community.sitemap.present? && !(current_community.sitemap.new_record?)) || current_community.floorplates.present?

              %li.loader_class{:class=>"#{controller_name =='sitemap_amenities' || controller_name =='floorplate_amenities' || controller_name =='amenities' || (controller_name =='floorplates' && params[:amenities].present?) || (params[:action] == 'plot_amenities' && controller_name != "floorplan_amenities" )? 'active' : ''}"}
                = link_to community_amenities_path(current_community)  do
                  %i.fa.fa-plus-square
                  %span Amenities
            - if (current_user.is_admin? ) && current_community.mdu
              %li.loader_class{:class=>"#{controller_name =='floorplans' || controller_name =='floorplan_amenities' ? 'active' : ''}"}
                %a{:href => "#{community_floorplans_path(current_community)}"}
                  %i.fa.fa-columns
                  %span Floor Plans
                  %span.pull-right-container
            - if current_user.is_admin? && current_community.mdu
              %li.loader_class{:class=>"#{controller_name =='units' ? 'active' : ''}"}
                = link_to community_units_path(current_community)  do
                  %i.fa.fa-laptop
                  %span Units

      - if current_community.touchscreen_app && current_user.is_admin?
        %li.loader_class{:class=>"#{controller_name =='galleries' ? 'active' : ''}"}
          %a{:href => "#{community_galleries_path(current_community)}"}
            %i.fa.fa-image
            %span Gallery Page
        - if current_community.touchscreen_app && current_user.is_admin?
          %li.loader_class{:class=>"#{controller_name =='neighborhoods' ? 'active' : ''}"}
            %a{:href => "#{community_neighborhoods_path(current_community)}"}
              %i.fa.fa-bank
              %span Neighborhood Page
        - if current_community.touchscreen_app && current_user.is_admin?
          %li.loader_class{:class=>"#{controller_name =='favorite_settings' || controller_name == 'ebrochure_menu_buttons' || controller_name == 'favorite_images' ? 'active' : ''}"}
            %a{:href => "#{community_favorite_settings_path(current_community)}"}
              %i.fa.fa-heart
              %span Favorites Page & eBrochure
        - if (current_community.touchscreen_app) && (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_company_admin? || current_user.is_regional_admin?)
          %li.loader_class{:class=>"#{controller_name =='additional_pages' || controller_name =='imagepages' ? 'active' : ''}"}
            %a{:href => "#{community_additional_pages_path(current_community)}"}
              %i.fa.fa-star
              %span Additional Pages
      - if (current_user.is_super_admin? || current_user.is_community_admin? || current_user.is_company_admin? || current_user.is_regional_admin? )
        %li
          %a{"data-toggle"=>"modal","data-target"=>"#share-webpages",:href => "##"}
            %i.fa.fa-share
            %span Pynwheel Map

      - if (current_user.is_admin? || current_user.is_community_assistant?) and current_community.self_tour
        %li.treeview{:class=>"#{controller_name =='tours' ? 'active' : 'active'}"}
          %a{:href => "/"}
            %i.fa.fa-plane
            %span Tour Setup
            %span.pull-right-container
              %i.fa.fa-angle-right.pull-right
          %ul.treeview-menu.property_map_intent_list{:style=>"#{controller_name =='tour'? 'display: block' : ''}"}
            %li.loader_class{:class=>"#{controller_name =='tours' && params[:action] == "settings"  ? 'active' : ''}"}
              %a{:href => "#{settings_community_tours_path(current_community)}"}
                %i.fa.fa-bars
                %span Settings
                %span.pull-right-container

            %li.loader_class{:class=>"#{controller_name =='tours' && params[:action] == "index" ? 'active' : ''}"}
              %a{:href => "#{community_tours_path(current_community)}"}
                %i.fa.fa-plane
                %span Tour Stops
                %span.pull-right-container

            - if current_community.present? && current_community.auto_wayfinding
              %li.loader_class{:class=>"#{controller_name =='automate_plotting' && params[:action] == "index" ? 'active' : ''}"}
                %a{:href => "#{automate_plotting_index_path(community_id:current_community)}"}
                  %i.fa.fa-robot
                  %span Auto Wayfinding
                  %span.pull-right-container

      - if (current_community.self_tour) && (current_user.is_admin? || current_user.is_view_visitor_details_page? || current_user.is_community_assistant?)
        %li.loader_class{:class=>"#{controller_name =='tour_users' ? 'active' : ''}"}
          %a{:href => "#{community_tour_users_path(current_community)}"}
            %i.fa.fa-sticky-note-o
            %span Visitors

      - if current_community.self_tour
        %li.loader_class{:class=>"#{controller_name =='schedual_tours' ? 'active' : ''}"}
          %a{:href => "#{community_schedual_tours_path(current_community)}"}
            %i.fa.fa-sticky-note-o
            %span Scheduled Tours

      - if current_community.pynwheel_access && current_user.is_super_admin?
        %li.loader_class{:class=>"#{controller_name =='pynwheel_access_users' ? 'active' : ''}"}
          %a{:href => "#{community_pynwheel_access_users_path(current_community)}"}
            %i.fa.fa-lock
            %span Pynwheel Access Users

      - if current_user.is_super_admin?
        %li.loader_class{:class=>"#{controller_name =='Community' && params[:action] == "reports" ? 'active' : ''}"}
          %a{:href => "#{community_reports_path(current_community)}"}
            %i.fa.fa-file
            %span Reports

      -# - if (current_user.is_super_admin? || current_user.is_view_visitor_details_page?) && current_user.is_super_admin?
      -#   %li.loader_class{:class=>"#{controller_name =='Community' && params[:action] == "logs" ? 'active' : ''}"}
      -#     %a{:href => "#{community_logs_path(current_community)}"}
      -#       %i.fa.fa-history
      -#       %span CMS Logs

      -if (current_user.email == ENV["PYNWHEEL_DEV_EMAIL"])
        %li.loader_class{:class=>"#{controller_name =='impressions' ? 'active' : ''}"}
          %a{:href => "#{community_impressions_path(current_community)}"}
            %i.fa.fa-history
            %span Impressions Logs
            
      - unless (current_user.is_view_visitor_details_page? || current_user.is_community_assistant?)
        %li.loader_class{:class=>"#{controller_name =='tutorials' ? 'active' : ''}"}
          %a{:href => "#{community_tutorials_path(current_community)}"}
            %i.fa.fa-video-camera
            %span Tutorials