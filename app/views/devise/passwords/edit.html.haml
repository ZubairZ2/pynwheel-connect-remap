- content_for :title, "Password - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => "/"}
      = image_tag "pyn-logo.png"
    %p Change Password
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
      .col-md-6.col-lg-4
        .text-center
          %h3 Change Password
        = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| 
          = f.hidden_field :reset_password_token 
          .form-group
            = f.password_field :password, :class=>"form-control validate[required]", :placeholder=>"Password",:maxlength=>"50", autofocus: true ,autocomplete: "off"
            %i.fa.fa-key
          .form-group
            = f.password_field :password_confirmation, :class=>"form-control validate[required]", :placeholder=>"Password Confirmation",:maxlength=>"50",autocomplete: "off" 
            %i.fa.fa-key  
          = f.submit "Change my password", :class => "btn btn-primary btn-block" 
        .text-center
          %p.copy-right © 2018 Pynwheel                  