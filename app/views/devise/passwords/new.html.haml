- content_for :title, "Password - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => "/"}
      = image_tag "pyn-logo.png"
    %p Enter Email
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
      .col-md-6.col-lg-4
        .text-center
          %h3 Enter Email
        = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
          .form-group
            = f.email_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email",:maxlength=>"50", autofocus: true 
            %i.fa.fa-envelope
          = f.submit "Send me reset password instructions", :class => "btn btn-primary btn-block" 
        .text-center
          %p.copy-right © 2018 Pynwheel                  