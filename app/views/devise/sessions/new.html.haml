- content_for :title, "Login - Pynwheel"
.login-bg
  .container.text-center.login-top
    %a{:href => ""}
      %img{:alt => "", :src => "images/pynwheel-logo.png", :title => ""}/
    %p Dear user, log in to access the admin area!
.login-from
  .container
    %i.fa.fa-caret-down
    .row
      .col-md-3.col-lg-4
        .col-md-6.col-lg-4
          .text-center
            %h3 Login to your account
          = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
            .form-group
              = f.text_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email", autofocus: true 
              %i.fa.fa-user
            .form-group
              = f.password_field :password, :class=>"form-control validate[required]", :placeholder=>"Password", autocomplete: "off"
              %i.fa.fa-key
            .checkbox
              - if devise_mapping.rememberable?   
                %label
                  = f.check_box :remember_me 
                  Remember
              %a.pull-right{:href => "#"} Forgot Password ?
            = f.submit "Login", :class => "btn btn-primary btn-block" 
        .text-center
          %p.copy-right © 2017 Pynwheel





