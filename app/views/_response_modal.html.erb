 <script type="text/javascript">

    $(document).ready(function(){
        var community_name = '<%= @community.present? ? ( (@community.name.gsub(/[^0-9a-z ]/i, '') + "_with_id_" + @community.id.to_s).gsub(' ', '_') ) : 'undefined' %>'
        var locks_provider = '<%= @community.present? ? ( (@community.enable_locks and @community.multiple_locks_provider.present?) ? @community.multiple_locks_provider : 'undefined' ) : 'undefined' %>'


        var pusher, generic_channel;
        
        if(community_name != "undefined" && locks_provider.includes("Latch"){
            var latch_import_status;
            var latch_channel_name = "latch_channel_for_" + community_name;
            console.log(latch_channel_name)

            latch_import_status = function(data) {
                if(data.error != "undefined" && data.error.length > 1){
                    $('#latch-service-response').find('#latch-response-header').html("Importing Latch Locks");
                    $('#latch-service-response').find('#latch-response-body').html(data.error);

                    $('#latch-service-response').modal();
                }
            }

            pusher = new Pusher('<%= ENV["PUSHER_KEY"] %>', {
                cluster: '<%= ENV["PUSHER_CLUSTER"] %>',
                encrypted: true
            });

            generic_channel = pusher.subscribe(latch_channel_name);

            generic_channel.bind('data-import', function(data) {
                return latch_import_status(data);
            });
        }
    })

 </script>