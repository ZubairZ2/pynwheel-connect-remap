
- content_for :title, "Home - Pynwheel"
.container
  %section
    .row
      .col-md-4
        %h2 Communities
        %h5
          All communities are listed here.
        - if current_user.is_super_admin?
          %p.mb-30
            This Admin feature allows you to directly access any community in the system
        - elsif current_user.is_dwelo_admin?
          %p.mb-30
            This Dwelo admin feature allows you to directly access any dwelo community in the system </br>
      - if can? :read, Company     
        .col-md-2
          - if current_user.is_super_admin? or current_user.is_dwelo_admin?
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/companies"}
                List all companies
          
        - allowed_emails = ["johnhall@pynwheel.com", "lizzy@pynwheel.com", ENV["PYNWHEEL_DEV_EMAIL"], "jennifer@pynwheel.com", "kellie@pynwheel.com"]

        - if allowed_emails.include?(current_user.email)
          .col-md-2
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/companies/generate_webpages_report", :format => "csv"}
                Webpages report

          .col-md-2
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/companies/generate_salesforce_report", :format => "csv"}
                Salesforce report

          .col-md-2
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/companies/properties_average_data_report", :format => "csv"}
                Properties Data Report
          
          .col-md-2
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/companies/generate_sessions_report", :format => "csv"}
                Sessions Report
          


    .box.box-widget.panel-box
      #new-search-area
      %table#communities.table.table-hover.table-responsive
        %thead
          %tr
            %th Community
            %th{:width => "250"} Company
        %tbody
          - @communities.each do |community|
            %tr
              %td
                %h4.h4
                  - if current_user.is_view_visitor_details_page?
                    = link_to community.name, community_tour_users_path(community),:title=>community.data_provider
                  - elsif community&.company.present?
                    = link_to community.name, edit_company_community_path(community.company,community),:title=>community.data_provider
                %h6.h6 Timezone: #{community.time_zone}
                %h6 Provider: #{community&.data_provider}, Updated: #{community.data_provider_updated_on}
              %td
                %h5.h5
                  = community.company.name rescue ""