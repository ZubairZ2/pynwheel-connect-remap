- content_for :title, "Properties - Pynwheel"

:css
  /* Column widths and the two cells that are particular to this grid.
     Everything else - the toolbar, table, badges, pager - comes from
     pyn_grid.scss, shared with the units grid. */
  .properties-page .c-property { min-width: 240px; }
  .properties-page .c-company { min-width: 150px; }
  .properties-page .c-location { min-width: 130px; }
  .properties-page .c-provider { min-width: 140px; text-transform: capitalize; }
  .properties-page .c-map-type { min-width: 110px; }
  .properties-page .c-products { min-width: 190px; max-width: 320px; }
  .properties-page .c-property .cell-sub .dot { color: #d8dde4; margin: 0 5px; }
  /* Now that the toolbar is one row, the search box takes only the space the
     dropdowns leave rather than all of it. */
  .properties-page .f-search { flex: 1 1 260px; min-width: 180px; max-width: 560px; }
  .properties-page .grid-table tbody tr[data-href] { cursor: pointer; }
  /* This page sets no breadcrumbs, so the shared crumb strip is an empty band
     of padding between the app header and the title. The grid owns its own
     padding, so the theme's .content box need not add a second layer. */
  .content-wrapper > .content-header { display: none; }
  section > .content { padding: 0; }

%section
  .content
    .pyn-grid.properties-page
      .page-head
        .grow
          %h1 Properties
          %p.sub
            - if current_user.is_super_admin?
              Every property in the system.
            - else
              The properties you have access to.
        - if current_user.is_super_admin? || current_user.is_dwelo_admin?
          .head-actions
            = link_to companies_path, class: "btn btn-primary" do
              %i.fa.fa-building-o
              All companies

      %form.toolbar#property-filters{method: "get", action: root_path}
        .row1
          %input.f-input.f-search{type: "text", name: "q", value: params[:q], placeholder: "Search property, code, city, address or company…", autocomplete: "off"}
          = grid_filter_select :company_id, @filter_options[:companies], "All companies"
          = grid_filter_select :state, @filter_options[:states].map { |s| [s, s] }, "All states"
          = grid_filter_select :data_provider, @filter_options[:providers].map { |p| [p.titleize, p] } + [["No data feed", CommunityFilterQuery::NONE]], "All data feeds"
          = grid_filter_select :product, Community::FEATURES.map { |key, f| [f[:title], key] }, "Any product"
          = grid_filter_select :map_type, [["SDK map", "sdk"], ["SVG map", "svg"], ["3D map", "three_d"], ["Sitemap", "sitemap"], ["Floor-level map", "floor_level"]], "Any map type"
          - if @filter_options[:regions].any?
            = grid_filter_select :region_id, @filter_options[:regions], "All regions"
          - if @filter_options[:groups].any?
            = grid_filter_select :community_group_id, @filter_options[:groups], "All groups"
          %a.btn.btn-ghost#clear-filters{href: root_path, style: ("display:none" unless @filter.filtering?)} Clear filters
          %span.spin#filter-spin

      #property-results
        = render "communities_table"

:javascript
  PynGrid.init({
    form: "#property-filters",
    results: "#property-results",
    spinner: "#filter-spin",
    clear: "#clear-filters"
  });

  // The whole row opens the property. The links inside it - the company, the
  // action icon, the sort headers and the pager - keep their own behaviour,
  // and a click that ends a text selection is someone copying a value rather
  // than asking to navigate. Bound on the container, which survives the
  // toolbar swapping the rows underneath it.
  (function () {
    var results = document.getElementById("property-results");

    function rowHref(e) {
      if (e.target.closest("a, button, input, select, label")) return null;
      var row = e.target.closest("tr[data-href]");
      if (!row) return null;
      var selection = window.getSelection && window.getSelection().toString();
      return selection ? null : row.getAttribute("data-href");
    }

    results.addEventListener("click", function (e) {
      var href = rowHref(e);
      if (!href) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey) window.open(href, "_blank");
      else window.location.href = href;
    });

    results.addEventListener("auxclick", function (e) {
      if (e.button !== 1) return;
      var href = rowHref(e);
      if (href) window.open(href, "_blank");
    });
  })();
