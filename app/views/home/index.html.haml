
- content_for :title, "Home - Pynwheel"
.container
  %section
    .row
      .col-md-6
        %h2 Communities
        %h5
          All communities are listed here.
        - if current_user.is_super_admin?
          %p.mb-30
            This Admin feature allows you to directly access any community in the system
      - if can? :read, Company     
        .col-md-6
        - if current_user.is_super_admin?
          .mt-35
            %a.btn.btn-success.pull-right.mb-20{:href => "/companies"}
              List all companies

    .box.box-widget.panel-box
      #new-search-area
      %table#communities.table.table-hover.table-responsive
        %thead
          %tr
            %th Community
            %th{:width => "250"} Company
        %tbody
          - @communities.each do |community|
            %tr
              %td
                %h4.h4
                  = link_to community.name, edit_company_community_path(community.company,community),:title=>community.data_provider
                %h6.h6 Updated: #{community.updated_at.to_date}  
              %td
                %h5.h5
                  = community.company.name rescue ""


