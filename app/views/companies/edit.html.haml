%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "/"} Home
    %li
      %a{:href => "/companies"} Companies
    %li.active Edit Company
  .clearfix
.clearfix
/ Main content
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Edit
          %span Company

      = form_for @company,:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = f.submit "EDIT COMPANY", :class=>"btn btn-success pull-right"


