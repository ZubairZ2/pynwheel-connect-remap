.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Company Name"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :address, :class=>"form-control", :placeholder=>"Address", rows: 4
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :city, :class=>"form-control validate[required,custom[onlyLetterSp]]", :placeholder=>"City"
        %small City
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :state, :class=>"form-control validate[required,custom[onlyLetterSp]]", :placeholder=>"State"
        %small State
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :zip, :class=>"form-control validate[required,custom[onlyNumberSp]]", :placeholder=>"Zip"
        %small Zip
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :phone, :class=>"form-control validate[required,custom[onlyNumberSp]]", :placeholder=>"Phone"
        %small Phone
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.email_field :email, :class=>"form-control validate[required,custom[email]]", :placeholder=>"Email"
        %small Email

:javascript
  $("form").validationEngine();      