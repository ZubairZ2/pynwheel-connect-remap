.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Name

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_field :name, :class=>"form-control validate[required]", :placeholder=>"Company Name"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Address

  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    = f.text_area :address, :class=>"form-control validate[required]", :placeholder=>"Address", rows: 4
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :city, :class=>"form-control validate[required]", :placeholder=>"City"
        %small City
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :state, :class=>"form-control validate[required]", :placeholder=>"State"
        %small State
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :zip, :class=>"form-control validate[required]", :placeholder=>"Zip"
        %small Zip
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .row
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :phone, :class=>"form-control validate[required]", :placeholder=>"Phone"
        %small Phone
      .col-sm-6.col-lg-4.col-md-4.col-xs-12
        = f.text_field :email, :class=>"form-control validate[required]", :placeholder=>"Email"
        %small Email

.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label
    Upload Logo
    %span
      Upload logo of this
      %br/
      company.
  .col-sm-12.col-lg-9.col-md-9.col-xs-12
    .select-img.mb-20
      .select-img-img= image_tag "default.jpeg",:height=>"170",:width=>"170",:id=>"preview-image"
    %span.btn.btn-default.black-button.btn-sm.btn-file
      Select Image
      = f.file_field :logo
:javascript
  $("form").validationEngine();      