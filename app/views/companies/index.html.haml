%section.content-header
  %ol.breadcrumb
    %li
      %a{:href => "#"} Companies
  .clearfix
.clearfix

%section
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        Companies
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Pynwheel
          .col-md-6
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "#"}
                %i.fa.fa-plus-circle
                ADD COMPANY
        .box.box-widget.panel-box
          .box-headrer
            %div
              .col-sm-9
                
              .col-sm-3
                %input.form-control{"aria-controls" => "example1", :placeholder => "Search:", :type => "search"}
            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #
                      %th Company Name
                      %th{:width => "250"} Actions
                  %tbody
                    - @companies.each_with_index do |company,index|
                      %tr
                        %td
                          =index+1
                        %td
                          =company.name
                        %td
                          %a.text-success{:href => "#"}
                            %i.fa.fa-edit
                          %a.text-danger{:href => "#"}
                            %i.fa.fa-trash
                          %a.btn-info.btn-xs.mr-5
                            Update now
                          %a.btn-success.btn-xs
                            Live

            .row
              .col-md-6
                .pl-20.pt-5 
              .col-md-6
                %ul.pagination.pull-right.pr-20.mt-0
                  
      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12

        