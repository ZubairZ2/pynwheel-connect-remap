- content_for :title, "Companies - Pynwheel"
/ Main content
.container
  %section
    .row
      .col-md-12
        %h2 Companies
        %h5
          All companies are listed here.
          - if current_user.is_super_admin?
            %p.mb-30
              This Admin feature allows you to directly access any company in the system
          - elsif current_user.is_dwelo_admin?
            %p.mb-30
              This Dwelo admin feature allows you to directly access any dwelo company in the system </br>
    .row
      .col-md-12
        .col-md-6
          .mt-35
            %a.btn.btn-success.mb-20{:href => "/"}
              List all communities
        - if can? :crud, Company
          .col-md-6
            .mt-35
              %a.btn.btn-success.pull-right.mb-20{:href => "/companies/new"}
                %i.fa.fa-plus-circle
                ADD COMPANY

    .box.box-widget.panel-box
      #new-search-area
      %table#companies.table.table-hover.table-responsive
        %thead
          %tr
            %th Company
            %th{:width => "250"} Actions
        %tbody
          - @companies.each do |company|
            %tr
              %td
                %h4.h4
                  = link_to company.name, company_communities_path(company)
              %td
                %a.text-success{:href => "/companies/#{company.id}/edit"}
                  %i.fa.fa-edit.icon_size
                %a.text-danger{"data-name"=>"Company","data-href" => "/companies/#{company.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash.icon_size