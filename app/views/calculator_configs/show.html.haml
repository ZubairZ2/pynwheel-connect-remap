    document.getElementById('globalDisclaimers').value = 'All fees subject to change. Some charges payable directly to third-party providers.';

    const b1=createNewBucket('Monthly Leasing Costs','Core monthly charges included in every lease.');
    const c1=addCategory(b1,'Rent & Base Fees','Standard fixed monthly charges.');
    addFeeRow(c1,{name:'Base Rent',logic:'Fixed',val1:'2500',mndt:true,frequency:'Monthly',multiplier:'None',isBasePrice:true,desc:'Monthly base rent for the unit as agreed in your lease.'});
    addFeeRow(c1,{name:'Unit Maintenance Fee',logic:'Fixed',val1:'50',mndt:true,frequency:'Monthly',multiplier:'None',desc:'Covers routine in-unit maintenance.',preInfo:'Billed monthly with rent.',postInfo:'Thank you for keeping your unit in great shape.'});
    addFeeRow(c1,{name:'Lease Concession',logic:'Fixed',val1:'-100',mndt:true,frequency:'Situational',multiplier:'None',desc:'Move-in concession applied when a qualifying promotion is active.'});

    const b2=createNewBucket('Unit-Type Based Fees','Fees that vary depending on bedroom count.');
    const c2=addCategory(b2,'Bedroom-Based Charges');
    addFeeRow(c2,{name:'Trash Valet Service',logic:'Unit Type',mndt:true,frequency:'Monthly',multiplier:'None',bedroom:true,bedPrices:{Studio:'20','1 BR':'25','2 BR':'30','3+ BR':'35'},desc:'Doorstep trash collection priced by unit size.'});

    const b3=createNewBucket('Utility & Service Fees','Variable charges billed within a set range.');
    const c3a=addCategory(b3,'Utilities','Estimates only — actual usage billed directly.');
    addFeeRow(c3a,{name:'Electricity',logic:'Range',val1:'60',val2:'140',mndt:true,frequency:'Monthly',multiplier:'None',desc:'Estimated monthly electricity. Varies with consumption.'});
    addFeeRow(c3a,{name:'Water & Sewer',logic:'Range',val1:'30',val2:'70',mndt:true,frequency:'Monthly',multiplier:'None'});

    const b4=createNewBucket('Optional Amenity Add-Ons','Select any add-ons you would like.');
    const c4a=addCategory(b4,'Parking');
    addFeeRow(c4a,{name:'Covered Parking',logic:'Fixed',val1:'100',mndt:false,frequency:'Monthly',multiplier:'None',preInfo:'Add a covered parking spot to your lease.',postInfo:'Parking pass issued at move-in.'});
    const c4b=addCategory(b4,'Pet Fees','Pets must be registered at leasing office.');
    addFeeRow(c4b,{name:'Monthly Pet Rent',logic:'Fixed',val1:'75',mndt:false,frequency:'Monthly',multiplier:'Per Pet',desc:'Monthly pet rent per pet.',preInfo:'Set number of pets using the Pets control.'});
    addFeeRow(c4b,{name:'Pet Damage Waiver',logic:'Fixed',val1:'30',mndt:false,frequency:'Monthly',multiplier:'Per Pet'});

    const b5=createNewBucket('Move-In / One-Time Costs');
    const c5=addCategory(b5,'Application & Move-In Charges');
    addFeeRow(c5,{name:'Application Fee',logic:'Fixed',val1:'75',mndt:true,frequency:'One-Time',multiplier:'Per Applicant',desc:'Non-refundable application fee per applicant.',preInfo:'Adjust number of applicants in the calculator.'});
    addFeeRow(c5,{name:'Admin Fee',logic:'Fixed',val1:'250',mndt:true,frequency:'One-Time',multiplier:'None',desc:'One-time non-refundable administration fee.'});
    addFeeRow(c5,{name:'Security Deposit',logic:'Varies',mndt:true,frequency:'One-Time',multiplier:'None',desc:'Refundable security deposit. Amount determined by credit screening.',preInfo:'Amount determined after application approval.'});
    addFeeRow(c5,{name:'Move-In Fee',logic:'Fixed',val1:'500',mndt:true,frequency:'One-Time',multiplier:'None'});
    addFeeRow(c5,{name:'Pet Deposit',logic:'Fixed',val1:'300',mndt:false,frequency:'One-Time',multiplier:'Per Pet',desc:'Refundable pet deposit per pet.'});

    showToast('✓ All scenarios loaded! Click Export JSON to test in SDK.', 'success');
  }
