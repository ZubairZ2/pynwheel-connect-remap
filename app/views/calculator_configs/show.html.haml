  // ─── Drag & Drop ──────────────────────────────────────────────────────────
  function initDragAndDrop(element, typeClass) {
    element.setAttribute('draggable', true);
    element.classList.add('draggable-item');
    element.addEventListener('dragstart', function(e) {
      draggedItem = this; draggedType = typeClass;
      e.dataTransfer.effectAllowed = 'move';
      setTimeout(() => this.style.opacity = '0.5', 0); e.stopPropagation();
    });
    element.addEventListener('dragover', function(e) {
      if (draggedType !== typeClass) return;
      e.preventDefault(); e.dataTransfer.dropEffect = 'move';
      if (this !== draggedItem && this.classList.contains(typeClass)) this.classList.add('drag-over');
      return false;
    });
    element.addEventListener('dragleave', function() { this.classList.remove('drag-over'); });
    element.addEventListener('drop', function(e) {
      e.stopPropagation(); this.classList.remove('drag-over');
      if (draggedItem !== this && this.classList.contains(typeClass) && draggedType === typeClass) {
        const parent = this.parentNode;
        if (draggedItem.parentNode !== parent) return;
        const siblings = Array.from(parent.children);
        const di = siblings.indexOf(draggedItem), ti = siblings.indexOf(this);
        if (di < ti) parent.insertBefore(draggedItem, this.nextSibling);
        else parent.insertBefore(draggedItem, this);
      }
      return false;
    });
    element.addEventListener('dragend', function() {
      this.style.opacity = '1';
      document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
      draggedItem = null; draggedType = null;
    });
  }

  document.addEventListener('click', e => {
    if (!e.target.closest('.dropdown-container'))
      document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
  });

  function toggleDropdown(button) {
    const menu = button.nextElementSibling;
    const vis = menu.style.display === 'flex';
    document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
    menu.style.display = vis ? 'none' : 'flex';
  }

