- content_for :title, "#{@community.name} | Pricing Calculator CMS"
- content_for :head do
  %link{href: "https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined", rel: "stylesheet"}
  %link{href: "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap", rel: "stylesheet"}

:css
  :root {
    --primary:#0f172a;--primary-light:#1e293b;
    --accent:#6366f1;--accent-light:#818cf8;--accent-bg:#eef2ff;
    --surface:#fff;--surface-2:#f8fafc;--surface-3:#f1f5f9;
    --border:#e2e8f0;--text:#0f172a;--text-2:#475569;--text-3:#94a3b8;
    --success:#10b981;--success-bg:#f0fdf4;
    --warning:#f59e0b;--warning-bg:#fffbeb;
    --danger:#ef4444;--danger-bg:#fef2f2;
    --radius:10px;--radius-lg:14px;
    --shadow-sm:0 1px 3px rgba(0,0,0,.06);--shadow:0 4px 12px rgba(0,0,0,.06);--shadow-lg:0 12px 32px rgba(0,0,0,.08);
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  #calc-cms-root{font-family:'Inter',sans-serif;background:var(--surface-2);color:var(--text);padding:24px;font-size:13px;line-height:1.5;-webkit-font-smoothing:antialiased;}

  /* Page Header */
  .cms-page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border);}
  .cms-breadcrumb{font-size:.75rem;color:var(--text-3);margin-bottom:4px;}
  .cms-breadcrumb a{color:var(--accent);text-decoration:none;}
  .cms-page-header h1{font-size:1.3rem;font-weight:700;}

  /* Embed URLs */
  .embed-urls-panel{background:var(--primary);color:#e2e8f0;border-radius:var(--radius-lg);padding:20px 24px;margin-bottom:24px;}
  .embed-urls-panel h3{font-size:.85rem;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
  .embed-url-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
  .embed-url-row label{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;min-width:80px;}
  .embed-url-row input{flex:1;background:#020617;color:#34d399;border:1px solid #1e3a5f;padding:7px 12px;font-family:monospace;font-size:.75rem;border-radius:6px;outline:none;}
  .btn-copy-url{background:#334155;color:#e2e8f0;border:none;padding:0 12px;height:32px;border-radius:6px;cursor:pointer;font-size:.75rem;font-family:inherit;}
  .btn-copy-url:hover{background:#475569;}

  /* Tools Grid */
  .tools-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;}
  .panel{background:var(--surface);border-radius:var(--radius-lg);padding:20px;border:1px solid var(--border);box-shadow:var(--shadow-sm);transition:box-shadow .2s;}
  .panel:hover{box-shadow:var(--shadow);}
  .panel-title{font-size:1rem;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:8px;color:var(--primary);}
  .panel-desc{font-size:.8rem;color:var(--text-2);margin-bottom:16px;line-height:1.4;}
  .import-section{border-left:4px solid var(--accent);}
  .import-section textarea{background:var(--surface-2);color:var(--text);border:1px solid var(--border);height:120px;font-family:'Monaco',monospace;font-size:.75rem;padding:12px;border-radius:var(--radius);width:100%;resize:vertical;outline:none;transition:all .2s;}
  .import-section textarea:focus{border-color:var(--accent);background:var(--surface);box-shadow:0 0 0 3px var(--accent-bg);}

  /* Buttons */
  .btn{font-family:inherit;font-size:.75rem;font-weight:600;padding:0 16px;height:36px;cursor:pointer;border:1px solid var(--border);border-radius:8px;transition:all .2s;display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--surface);color:var(--text-2);text-decoration:none;}
  .btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-bg);}
  .btn-primary{background:var(--accent);color:white;border-color:var(--accent);}
  .btn-primary:hover{background:#4f46e5;color:white;}
  .btn-success{background:var(--success);color:white;border-color:var(--success);}
  .btn-success:hover{background:#059669;color:white;}
  .btn-dark{background:var(--primary);color:white;border-color:var(--primary);}
  .btn-dark:hover{background:var(--primary-light);color:white;}
  .btn-outline-danger{color:var(--danger);border-color:var(--border);}
  .btn-outline-danger:hover{background:var(--danger-bg);border-color:var(--danger);}
  .btn-ghost{background:transparent;border:none;color:var(--text-3);padding:4px;border-radius:4px;}
  .btn-ghost:hover{background:var(--surface-3);color:var(--text);}
  .btn-save{background:var(--primary);color:white;border-color:var(--primary);}
  .btn-save:hover{background:var(--primary-light);color:white;}

  /* Drag */
  .drag-handle{cursor:grab;color:var(--text-3);margin-right:8px;user-select:none;display:flex;align-items:center;transition:color .2s;}
  .drag-handle:hover{color:var(--accent);}
  .drag-handle:active{cursor:grabbing;color:var(--accent);}
  .draggable-item{transition:transform .2s,box-shadow .2s;}
  .drag-over{border:2px dashed var(--accent)!important;opacity:.5;transform:scale(.98);}

  /* Global Disclaimers */
  .global-disclaimer-box{margin-bottom:24px;background:var(--surface);padding:20px;border-radius:var(--radius-lg);border:1px solid var(--border);box-shadow:var(--shadow-sm);}
  .global-disclaimer-box label{font-weight:700;font-size:.7rem;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
  .global-disclaimer-box textarea{height:80px;font-size:.8rem;width:100%;padding:12px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface-2);transition:all .2s;outline:none;}
  .global-disclaimer-box textarea:focus{border-color:var(--accent);background:var(--surface);}

  /* Bucket */
  .bucket-container{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);margin-bottom:24px;box-shadow:var(--shadow);overflow:hidden;}
  .bucket-header{background:var(--surface-3);padding:16px 20px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:12px;}
  .bucket-header-top{display:flex;justify-content:space-between;align-items:center;width:100%;}
  .bucket-name-input{font-size:1.1rem;font-weight:700;color:var(--text);border:1px solid transparent;background:transparent;padding:4px 8px;margin-left:-8px;width:300px;outline:none;border-radius:6px;transition:all .2s;}
  .bucket-name-input:focus{background:var(--surface);border-color:var(--border);}
  .inline-disclaimer-input{font-size:.75rem;color:var(--text-3);border:1px solid transparent;background:transparent;padding:3px 6px;border-radius:6px;outline:none;flex:1;transition:all .2s;}
  .inline-disclaimer-input:focus{background:var(--surface);border-color:var(--border);color:var(--text-2);}
  .inline-disclaimer-input::placeholder{font-style:italic;}
  .bucket-body{padding:20px;}
  .collapsed{display:none!important;}

  /* Category */
  .category-block{background:var(--surface-2);padding:16px;margin-bottom:16px;border-radius:var(--radius);border:1px solid var(--border);position:relative;}
  .cat-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
  .cat-name-input{font-weight:600;font-size:.95rem;background:transparent;border:1px solid transparent;width:250px;padding:4px 8px;margin-left:-8px;outline:none;border-radius:6px;transition:all .2s;}
  .cat-name-input:focus{background:var(--surface);border-color:var(--border);}

  /* Fee Card */
  .fee-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:6px;padding:10px;position:relative;box-shadow:var(--shadow-sm);}
  .fee-card:hover{box-shadow:var(--shadow);}
  .fee-card-body.collapsed{display:none!important;}
  .fee-card-header{display:flex;align-items:center;gap:6px;margin-bottom:8px;}

  .card-row-core{display:grid;grid-template-columns:2fr 1.1fr .9fr .9fr 1.1fr;gap:10px;margin-bottom:10px;align-items:end;}
  .card-row-rules{display:grid;grid-template-columns:1.5fr 1.5fr 1fr 1fr 1.5fr;gap:10px;margin-bottom:10px;align-items:end;padding-bottom:10px;border-bottom:1px dashed var(--border);}
  .card-row-meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px dashed var(--border);}
  .card-row-unit{display:none;background:var(--surface-3);padding:12px;border-radius:var(--radius);border:1px solid var(--border);margin-bottom:10px;}
  .bedroom-fields{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;}
  .br-wrapper{display:none;flex:1;min-width:160px;background:var(--surface);padding:12px;border:1px solid var(--border);border-radius:var(--radius);}

  .dropdown-container{position:relative;width:100%;max-width:250px;}
  .dropdown-btn{width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:8px;background:var(--surface);text-align:left;cursor:pointer;font-size:.8rem;display:flex;justify-content:space-between;color:var(--text-2);}
  .dropdown-menu{position:absolute;top:100%;left:0;width:100%;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);z-index:100;padding:8px;box-shadow:var(--shadow-lg);display:none;flex-direction:column;gap:4px;margin-top:4px;}
  .dropdown-menu label{display:flex!important;align-items:center!important;gap:10px!important;font-size:.8rem!important;cursor:pointer;padding:6px 8px!important;margin:0!important;border-radius:6px;color:var(--text-2);}
  .dropdown-menu label:hover{background:var(--surface-3);}
  .dropdown-menu input[type="checkbox"]{margin:0!important;width:16px!important;height:16px!important;cursor:pointer;accent-color:var(--accent);}

  .card-row-text{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .input-group{display:flex;flex-direction:column;gap:4px;}
  .input-group label{font-size:.6rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em;}
  input,select,textarea{font-size:.78rem;padding:6px 10px;border:1px solid var(--border);border-radius:8px;width:100%;color:var(--text);outline:none;background:var(--surface);transition:all .2s;}
  input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg);}
  input:disabled,select:disabled{background:var(--surface-3);color:var(--text-3);cursor:not-allowed;}
  textarea{height:52px;resize:vertical;line-height:1.4;}
  .value-container{display:flex;gap:8px;}
  .check-group{display:flex;align-items:center;gap:8px;font-size:.8rem;font-weight:500;height:36px;cursor:pointer;color:var(--text-2);transition:color .2s;}
  .check-group:hover{color:var(--text);}
  .check-group input{width:18px;height:18px;margin:0;cursor:pointer;accent-color:var(--accent);}

  /* Base Price toggle */
  .base-price-toggle-label{display:flex;align-items:center;gap:5px;cursor:pointer;flex-shrink:0;}
  .base-price-toggle-label input{display:none;}
  .base-price-badge{font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;border:1.5px solid var(--border);color:var(--text-3);background:var(--surface-3);transition:all .2s;white-space:nowrap;}
  .base-price-toggle-label input:checked + .base-price-badge{background:#fef3c7;border-color:#f59e0b;color:#92400e;}
  .fee-card.is-base-price{border-color:#f59e0b;box-shadow:0 0 0 2px #fef3c7;}

  .btn-del-card{position:static;margin-left:2px;color:var(--text-3);background:var(--surface-3);border:none;border-radius:6px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;}
  .btn-del-card:hover{background:var(--danger-bg);color:var(--danger);}
  .fee-dropzone{min-height:4px;border-radius:var(--radius);transition:background .2s;}
  .highlight-yellow{background-color:#fefce8;border-color:#fde047;}

  /* Modal */
  .modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:1000;}
  .modal-content{background:var(--surface);padding:32px;border-radius:var(--radius-lg);width:900px;max-width:95vw;height:85vh;display:flex;flex-direction:column;box-shadow:var(--shadow-lg);}
  .modal-content textarea{flex:1;width:100%;font-family:'Monaco',monospace;font-size:.8rem;margin:20px 0;background:var(--surface-2);border:1px solid var(--border);padding:16px;border-radius:var(--radius);resize:none;overflow-y:auto;color:var(--text);}
  .modal-actions{display:flex;justify-content:flex-end;gap:12px;padding-top:20px;border-top:1px solid var(--border);}

  /* Toast */
  .calc-toast{position:fixed;bottom:24px;right:24px;background:#0f172a;color:white;padding:12px 20px;border-radius:10px;font-size:.8rem;font-weight:600;box-shadow:var(--shadow-lg);z-index:9999;opacity:0;transform:translateY(8px);transition:all .3s;pointer-events:none;}
  .calc-toast.show{opacity:1;transform:translateY(0);}
  .calc-toast.success{background:var(--success);}
  .calc-toast.error{background:var(--danger);}

#calc-cms-root
  .cms-page-header
    %div
      .cms-breadcrumb
        = link_to @community.name, "#"
        |  / Pricing Calculator
      %h1 Pricing Calculator CMS
    %div{style: "display:flex;gap:8px;"}
      = link_to "Preview", community_pricing_calculators_path(@community.id), target: "_blank", class: "btn"
      %button.btn.btn-save{onclick: "saveToDatabase()", type: "button"}
        %span.material-icons{style: "font-size:18px;"} save
        Save Configuration

  - property_url = community_pricing_calculators_url(@community.id)
  - unit_url     = unit_community_pricing_calculators_url(@community.id) + "?unit_id={unit_id}"

  .embed-urls-panel
    %h3
      %span.material-icons{style: "font-size:18px;"} link
      Embed URLs
    .embed-url-row
      %label Property
      %input{type: "text", value: property_url, readonly: true, id: "url-property"}
      %button.btn-copy-url{onclick: "copyUrl('url-property')"} Copy
    .embed-url-row
      %label Unit
      %input{type: "text", value: unit_url, readonly: true, id: "url-unit"}
      %button.btn-copy-url{onclick: "copyUrl('url-unit')"} Copy

  .tools-grid
    .panel
      .panel-title
        %span.material-icons{style: "color:var(--accent);"} settings
        Pricing Bucket Manager
      .panel-desc Drag the handle to reorder. Visual order = customer UI order.
      %div{style: "display:flex;gap:8px;flex-wrap:wrap;"}
        %button.btn.btn-primary{onclick: "createNewBucket('New Pricing Bucket')", type: "button"}
          %span.material-icons{style: "font-size:18px;"} add_circle_outline
          Add Pricing Bucket
        %button.btn.btn-dark{onclick: "exportJSON()", type: "button"}
          %span.material-icons{style: "font-size:18px;"} file_download
          Export JSON
        %button.btn{onclick: "toggleCollapseAll()", id: "collapseAllBtn", type: "button"}
          %span.material-icons{style: "font-size:18px;", id: "collapseAllIcon"} unfold_less
          Collapse All
        %button.btn{style: "background:var(--warning-bg);color:#92400e;border-color:#fcd34d;", onclick: "populateAllScenarios()", type: "button"}
          %span.material-icons{style: "font-size:18px;"} science
          Populate All Scenarios
        %button.btn.btn-outline-danger{onclick: "if(confirm('Clear all data?')){document.getElementById('dynamic-fee-containers').innerHTML='';document.getElementById('globalDisclaimers').value='';}", type: "button"}
          %span.material-icons{style: "font-size:18px;"} delete_sweep
          Clear

    .panel.import-section
      .panel-title
        %span.material-icons{style: "color:var(--accent);"} auto_awesome
        Smart Bulk Import
      .panel-desc
        Paste raw pricing text below. Disclaimers in &lt; &gt; map globally.
        Use the
        %b Seed from Community Fees
        button to pre-fill from existing property data.
      %textarea#importString{placeholder: "Paste full text here..."}
      %div{style: "display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;"}
        %button.btn.btn-success{onclick: "processAutoFill()", type: "button"}
          %span.material-icons{style: "font-size:18px;"} bolt
          Auto-Fill Intelligently
        %button.btn{onclick: "seedFromCommunityFees()", type: "button"}
          %span.material-icons{style: "font-size:16px;"} download
          Seed from Community Fees

  .global-disclaimer-box
    %label
      %span.material-icons{style: "font-size:16px;"} info_outline
      Global Property Disclaimers (Applies to entire receipt)
    %textarea#globalDisclaimers{placeholder: "e.g. All fees paid to property unless indicated by ‡ symbol..."}

  #dynamic-fee-containers

  .modal-overlay#exportModal
    .modal-content
      %h2{style: "display:flex;align-items:center;gap:10px;"}
        %span.material-icons{style: "color:var(--accent);font-size:28px;"} code
        JSON Export Payload
      %p{style: "margin:8px 0 0;color:var(--text-2);font-size:.85rem;"} Includes explicit orderIndex values based on your custom sorting.
      %textarea#exportResult{readonly: true}
      .modal-actions
        %button.btn{onclick: "document.getElementById('exportModal').style.display='none'", type: "button"} Close
        %button.btn.btn-primary{onclick: "copyJSON()", type: "button"}
          %span.material-icons{style: "font-size:18px;"} content_copy
          Copy to Clipboard

  .calc-toast#calcToast

:javascript
  const SAVE_URL   = "#{community_calculator_config_path(@community.id)}";
  const CSRF_TOKEN = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const COMMUNITY_ADDITIONAL_FEE = #{raw @additional_fee_seed.to_json};

  let uniqueIdCounter = 0, draggedItem = null, draggedType = null, allCollapsed = false;

  // ─── Toast ────────────────────────────────────────────────────────────────
  function showToast(msg, type='') {
    const t = document.getElementById('calcToast');
    t.textContent = msg;
    t.className = 'calc-toast show' + (type?' '+type:'');
    setTimeout(() => { t.className = 'calc-toast'; }, 3500);
  }

  // ─── Persistence ──────────────────────────────────────────────────────────
  function saveToDatabase() {
    fetch(SAVE_URL, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify(buildPayload())
    })
    .then(r => r.json())
    .then(d => showToast(d.success ? 'Saved!' : 'Error: ' + d.message, d.success ? 'success' : 'error'))
    .catch(() => showToast('Network error', 'error'));
  }

  function copyUrl(id) {
    const el = document.getElementById(id); el.select(); document.execCommand('copy');
    showToast('URL copied!', 'success');
  }

  // ─── Seed helpers ─────────────────────────────────────────────────────────
  function _sfcHasPrice(t)   { return /\$[\d.,]+/.test(t) || /\bfree\b/i.test(t); }
  function _sfcHasPct(t)     { return /\d+(\.\d+)?%/.test(t); }
  function _sfcHasVaries(t)  { return /\bvaries\b/i.test(t); }
  function _sfcIsBedLine(t)  { return /\b(studio|one\s*bed|two\s*bed|three\s*bed|four\s*bed|\d\s*(bedroom|br))\b/i.test(t) && _sfcHasPrice(t); }

  function _sfcParseFee(line, feeType, defaultMandatory) {
    const namePart = line
      .replace(/\s*[-–:]\s*\$[\d.,].*/,'').replace(/\s+\$[\d.,].*/,'')
      .replace(/\s+\d+%.*/,'').replace(/\s+varies.*/i,'')
      .replace(/[:\-–]+$/,'').replace(/\s*\(.*?\)\s*$/,'').trim();
    const hasDollar=/\$/.test(line), hasPct=/\d+%/.test(line), variesStr=/\bvaries\b/i.test(line);
    const rangeMatch=line.match(/\$?([\d.,]+)\s*(?:to|[-–])\s*\$?([\d.,]+)/i);
    const pctMatch=line.match(/([\d.,]+)%/);
    const singleMatch=line.match(/\$?([\d.,]+)/);
    let logic='Fixed', val1='', val2='';
    if (variesStr && !hasDollar && !hasPct) { logic='Varies'; }
    else if (rangeMatch && rangeMatch[1]!==rangeMatch[2]) { logic='Range'; val1=rangeMatch[1]; val2=rangeMatch[2]; }
    else if (hasPct && !hasDollar) { logic='Percentage'; val1=pctMatch?pctMatch[1]:''; }
    else if (singleMatch) { logic='Fixed'; val1=singleMatch[1]; }
    const nm=(namePart||'').toLowerCase();
    let frequency='Monthly';
    if (feeType==='one_time'||/one[-\s]?time/i.test(line)||/\bdeposit\b/.test(nm)||/\bapplication\b|\badmin\b|\bsetup\b|\butility\s*service\b/.test(nm)) frequency='One-Time';
    if (/\blate\s*fee\b|\binsufficient\b|\btransfer\b|\bpenalty\b|\bpayment\s*processing\b/i.test(nm)) frequency='Situational';
    let multiplier='None', counter=false;
    if (/per\s*applicant/i.test(line)) { multiplier='Per Applicant'; counter=true; }
    else if (/per\s*pet/i.test(line))  { multiplier='Per Pet'; counter=true; }
    else if (/per\s*vehicle/i.test(line)) { multiplier='Per Vehicle'; counter=true; }
    let mndt = defaultMandatory!==false;
    if (/\boptional\b/i.test(line)||multiplier!=='None'||/\bper\s*pet\b/i.test(line)||/\bparking\b/.test(nm)||/\bpet\b/.test(nm)) mndt=false;
    return { name:namePart||line.substring(0,50), logic, val1, val2,
             mndt, counter, qMin:1, qMax:counter?3:2,
             bedroom:false, bedPrices:{}, desc:'', preInfo:'', postInfo:'',
             frequency, multiplier, isBasePrice:false };
  }

  function seedFromCommunityFees() {
    if (!COMMUNITY_ADDITIONAL_FEE) return showToast('No community fees configured yet.', '');

    document.getElementById('dynamic-fee-containers').innerHTML = '';
    document.getElementById('globalDisclaimers').value = '';

    let raw = COMMUNITY_ADDITIONAL_FEE;

    // Extract *footnotes at end into global disclaimers
    const disclaimers = [];
    raw = raw.replace(/\*{1,2}([^•*\n][^•*\n]*)/g, (_, d) => { disclaimers.push(d.trim()); return ' '; });
    if (disclaimers.length) document.getElementById('globalDisclaimers').value = disclaimers.join('\n\n');

    // Known top-level section headers with their fee type
    const BUCKET_DEFS = [
      { re:/^Application\s*Fees?/i,     name:'Application Fees',   feeType:'one_time',    mandatory:true  },
      { re:/^Monthly\s*Fees?/i,         name:'Monthly Fees',       feeType:'monthly',     mandatory:true  },
      { re:/^Recurring\s*Charges?/i,    name:'Recurring Charges',  feeType:'monthly',     mandatory:true  },
      { re:/^Add[-\s]?Ons?$/i,          name:'Add-Ons',            feeType:'monthly',     mandatory:false },
      { re:/^Incidentals?$/i,           name:'Incidentals',        feeType:'situational', mandatory:false },
      { re:/^One[-\s]?Time\s*(?:Fees?|Charges?)?$/i, name:'One-Time Fees', feeType:'one_time', mandatory:false },
      { re:/^Move[-\s]?In/i,            name:'Move-In Fees',       feeType:'one_time',    mandatory:false },
      { re:/^(?:Security\s*)?Deposits?$/i, name:'Deposits',        feeType:'one_time',    mandatory:false },
      { re:/^Pet\s*(?:Fees?|Policies?)?$/i, name:'Pet Fees',       feeType:'monthly',     mandatory:false },
    ];

    // Insert newline before each known section header when it appears mid-text
    // (i.e. immediately after a word/digit char with no bullet between them).
    // Use explicit literal patterns — no regex transformation, no greedy wildcards.
    [
      /([a-z0-9)])\s*(Application\s*Fees?)/gi,
      /([a-z0-9)])\s*(Monthly\s*Fees?)/gi,
      /([a-z0-9)])\s*(Recurring\s*Charges?)/gi,
      /([a-z0-9)])\s*(Add[-\s]?Ons?)(?=\s*•|\s*$)/gi,
      /([a-z0-9)])\s*(Incidentals?)(?=\s*•|\s*$)/gi,
      /([a-z0-9)])\s*(Move[-\s]?In(?:\s*Fees?)?)/gi,
      /([a-z0-9)])\s*(One[-\s]?Time(?:\s*Fees?)?)/gi,
    ].forEach(re => { raw = raw.replace(re, '$1\n$2'); });

    // Put each bullet on its own line
    raw = raw.replace(/•/g, '\n•').replace(/\n{2,}/g, '\n').trim();

    const lines = raw.split('\n').map(l => l.trim()).filter(l => l);

    const parsedBuckets = [];
    let curBucket = null, curCat = null, curFee = null;

    function flushFee() {
      if (!curFee) return;
      if (!curCat) { curCat = { name:(curBucket?curBucket.name:'General')+' Fees', fees:[] }; if (curBucket) curBucket.categories.push(curCat); }
      curCat.fees.push(curFee); curFee = null;
    }

    for (const line of lines) {
      const isBullet = line.startsWith('•');
      const clean = line.replace(/^[•\s]+/,'').trim();
      if (!clean) continue;

      // Bucket header?
      if (!isBullet) {
        const bd = BUCKET_DEFS.find(d => d.re.test(clean));
        if (bd) {
          flushFee();
          curBucket = { name:bd.name, feeType:bd.feeType, mandatory:bd.mandatory, categories:[] };
          curCat    = { name:bd.name+' Fees', fees:[] };
          curBucket.categories.push(curCat);
          parsedBuckets.push(curBucket);
          // Handle any text pasted right after the header on same token
          const remainder = clean.replace(bd.re,'').trim();
          if (remainder && _sfcHasPrice(remainder)) { curFee = _sfcParseFee(remainder, bd.feeType, bd.mandatory); }
          continue;
        }

        // Sub-category line (no price/%, short, title-like)
        if (curBucket && !_sfcHasPrice(clean) && !_sfcHasPct(clean) && !_sfcHasVaries(clean) && clean.length < 70) {
          flushFee();
          curCat = { name:clean.replace(/:$/,'').trim(), fees:[] };
          curBucket.categories.push(curCat);
          continue;
        }
      }

      // Annotation lines (Varies by …, Not required …)
      if (/^(?:varies\s*by|not\s*required|inclusive\s*of)/i.test(clean)) {
        if (curFee) curFee.desc += (curFee.desc?' ':'')+clean;
        continue;
      }

      // Bedroom-price continuation (Studio: $250, One Bedroom: $350 …)
      if (_sfcIsBedLine(clean) && curFee) {
        curFee.logic='Unit Type'; curFee.bedroom=true;
        const pm=clean.match(/\$?([\d.,]+)/); const price=pm?pm[1]:'0';
        if (/studio/i.test(clean))                   curFee.bedPrices['Studio']=price;
        if (/one\s*bed|1\s*(br|bed)/i.test(clean))   curFee.bedPrices['1 BR']=price;
        if (/two\s*bed|2\s*(br|bed)/i.test(clean))   curFee.bedPrices['2 BR']=price;
        if (/three\s*bed|3\s*(br|bed)/i.test(clean)) curFee.bedPrices['3+ BR']=price;
        if (/four\s*bed|4\s*(br|bed)/i.test(clean))  curFee.bedPrices['4+ BR']=price;
        continue;
      }

      // Default: parse as a fee line
      if (!curBucket) {
        curBucket = { name:'Fees', feeType:'monthly', mandatory:true, categories:[] };
        curCat    = { name:'General Fees', fees:[] };
        curBucket.categories.push(curCat); parsedBuckets.push(curBucket);
      }
      flushFee();
      curFee = _sfcParseFee(clean, curBucket.feeType, curBucket.mandatory);
    }
    flushFee();

    if (!parsedBuckets.length) {
      document.getElementById('importString').value = COMMUNITY_ADDITIONAL_FEE;
      return processAutoFill();
    }

    // Build UI (reverse so first bucket ends up at top after prepend)
    parsedBuckets.reverse().forEach(bucket => {
      const bId = createNewBucket(bucket.name);
      bucket.categories.forEach(cat => {
        if (!cat.fees.length) return;
        const cId = addCategory(bId, cat.name);
        cat.fees.forEach(fd => addFeeRow(cId, fd));
      });
    });

    showToast('Seeded from community fees — review and save!', 'success');
  }

