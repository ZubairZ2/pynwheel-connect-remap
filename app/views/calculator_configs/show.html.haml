        <div class="card-row-rules">
          <div class="input-group"><label>Visibility</label>
            <label class="check-group"><input type="checkbox" class="mndt-check" ${d.mndt?'checked':''}> Visible By Default</label>
          </div>
          <div class="input-group"><label>Quantity</label>
            <label class="check-group"><input type="checkbox" class="counter-check" onchange="toggleQty(this)" ${d.counter?'checked':''}> Enable +/-</label>
