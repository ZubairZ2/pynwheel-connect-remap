  // ─── Logic handlers ───────────────────────────────────────────────────────
  function toggleSpecificBedroom(checkbox) {
    const card = checkbox.closest('.fee-card');
    card.querySelector('.br-' + checkbox.value.replace(/\s|\+/g,'')).style.display = checkbox.checked ? 'block' : 'none';
  }

  function handleLogicChange(select) {
    const card = select.closest('.fee-card');
    const targetSelect = card.querySelector('.percent-target');
    const minVal = card.querySelector('.min-val-field'), maxVal = card.querySelector('.max-val-field');
    const valLabel = card.querySelector('.val-label');
    const isBed = card.querySelector('.bed-toggle')?.checked;
    const isRange = select.value === 'Range';
    targetSelect.disabled = select.value !== 'Percentage';
    targetSelect.style.opacity = select.value === 'Percentage' ? '1' : '0.4';
    targetSelect.classList.toggle('highlight-yellow', select.value === 'Percentage');
    if (isRange) { maxVal.disabled=false; valLabel.innerText='Min Price'; minVal.placeholder='Min'; maxVal.placeholder='Max'; }
    else { maxVal.disabled=true; maxVal.value=''; maxVal.placeholder=''; valLabel.innerText='Base Price'; minVal.placeholder=select.value==='Percentage'?'10%':'Amount'; }
    card.querySelectorAll('.br-max-val').forEach(f => f.style.display = isRange ? 'block' : 'none');
    card.querySelectorAll('.br-min-val').forEach(f => f.placeholder = isRange ? 'Min' : 'Amount');
    if (isBed) { minVal.disabled=true; minVal.placeholder='Mapped Below'; maxVal.disabled=true; }
    else if (!card.querySelector('.base-price-check')?.checked) { minVal.disabled=false; }
  }

  function handleMultiplierChange(select) {
    const card = select.closest('.fee-card');
    const hasMultiplier = select.value !== 'None';
    const counterCheck = card.querySelector('.counter-check');
    counterCheck.disabled = hasMultiplier;
    if (hasMultiplier) counterCheck.checked = false;
    toggleQty(counterCheck);
  }

  function handleFreqChange(select) {
    const card = select.closest('.fee-card');
    const mndtCheck = card.querySelector('.mndt-check');
    const isBase = card.querySelector('.base-price-check')?.checked;
    if (select.value === 'Situational') { mndtCheck.checked=true; mndtCheck.disabled=true; }
    else if (!isBase) { mndtCheck.disabled=false; }
  }

  function toggleBasePrice(checkbox) { applyBasePriceState(checkbox.closest('.fee-card'), checkbox.checked); }

  function applyBasePriceState(card, isBase) {
    const logicSel=card.querySelector('.logic-select'), mndtCheck=card.querySelector('.mndt-check');
    const counterCheck=card.querySelector('.counter-check'), freqSel=card.querySelector('.freq-select');
    const multSel=card.querySelector('.multiplier-select'), bedToggle=card.querySelector('.bed-toggle');
    if (isBase) {
      document.querySelectorAll('.base-price-check').forEach(cb => {
        if (cb !== card.querySelector('.base-price-check') && cb.checked) {
          cb.checked=false; applyBasePriceState(cb.closest('.fee-card'), false);
        }
      });
      card.classList.add('is-base-price');
      card.querySelector('.base-price-check').checked=true;
      logicSel.value='Fixed'; logicSel.disabled=true;
      mndtCheck.checked=true; mndtCheck.disabled=true;
      counterCheck.checked=false; counterCheck.disabled=true; toggleQty(counterCheck);
      freqSel.disabled=true; multSel.value='None'; multSel.disabled=true;
      if (bedToggle) bedToggle.disabled=true;
      handleLogicChange(logicSel);
    } else {
      card.classList.remove('is-base-price');
      const isBed = bedToggle?.checked;
      logicSel.disabled=isBed; mndtCheck.disabled=(freqSel.value==='Situational');
      counterCheck.disabled=false; freqSel.disabled=false; multSel.disabled=false;
      if (bedToggle) bedToggle.disabled=false;
      handleLogicChange(logicSel);
    }
  }

  function toggleQty(checkbox) {
    const card = checkbox.closest('.fee-card');
    card.querySelector('.qty-min').disabled = !checkbox.checked;
    card.querySelector('.qty-max').disabled = !checkbox.checked;
  }

  function toggleBedroomRow(checkbox) {
    const card = checkbox.closest('.fee-card');
    card.querySelector('.card-row-unit').style.display = checkbox.checked ? 'block' : 'none';
    const logicSel = card.querySelector('.logic-select');
    if (checkbox.checked) { logicSel.value='Unit Type'; logicSel.disabled=true; }
    else { if (!card.querySelector('.base-price-check')?.checked) logicSel.disabled=false; }
    handleLogicChange(logicSel);
  }

  // ─── Smart Auto-Fill ──────────────────────────────────────────────────────
  function processAutoFill(rawInputOverride) {
    try {
      let rawInput = rawInputOverride || document.getElementById('importString').value.trim();
      if (!rawInput) return showToast('No text to import.', '');

      document.getElementById('dynamic-fee-containers').innerHTML = '';
      document.getElementById('globalDisclaimers').value = '';

      // Extract <angle-bracket> disclaimers
      const disclaimerRegex = /<([\s\S]+?)>/g;
      let match, disclaimers = [];
      while ((match = disclaimerRegex.exec(rawInput)) !== null) disclaimers.push(match[1].trim());
      if (disclaimers.length) {
        document.getElementById('globalDisclaimers').value = disclaimers.join('\n\n');
        rawInput = rawInput.replace(/<[\s\S]+?>/g,'').trim();
      }

      // Extract *footnotes into global disclaimers
      const footnotes = [];
      rawInput = rawInput.replace(/\*{1,2}([^•*\n][^•*\n]*)/g, (_, d) => { footnotes.push(d.trim()); return ' '; });
      if (footnotes.length) {
        const existing = document.getElementById('globalDisclaimers').value;
        document.getElementById('globalDisclaimers').value = [existing, ...footnotes].filter(Boolean).join('\n\n');
      }

      // Insert newline before each known section header appearing mid-text
      [
        /([a-z0-9)])\s*(Application\s*Fees?)/gi,
        /([a-z0-9)])\s*(Monthly\s*Fees?)/gi,
        /([a-z0-9)])\s*(Recurring\s*Charges?)/gi,
        /([a-z0-9)])\s*(Add[-\s]?Ons?)(?=\s*•|\s*$)/gi,
        /([a-z0-9)])\s*(Incidentals?)(?=\s*•|\s*$)/gi,
        /([a-z0-9)])\s*(Move[-\s]?In(?:\s*Fees?)?)/gi,
        /([a-z0-9)])\s*(One[-\s]?Time(?:\s*Fees?)?)/gi,
      ].forEach(re => { rawInput = rawInput.replace(re, '$1\n$2'); });

      // Put each bullet on its own line
      rawInput = rawInput.replace(/•/g, '\n•').replace(/\n{2,}/g, '\n').trim();

      const lines = rawInput.split('\n').map(l => l.trim()).filter(l => l);

      const BUCKET_DEFS = [
        { re:/^Application\s*Fees?/i,     name:'Application Fees',   feeType:'one_time',    mandatory:true  },
        { re:/^Monthly\s*Fees?/i,         name:'Monthly Fees',       feeType:'monthly',     mandatory:true  },
        { re:/^Recurring\s*Charges?/i,    name:'Recurring Charges',  feeType:'monthly',     mandatory:true  },
        { re:/^Add[-\s]?Ons?$/i,          name:'Add-Ons',            feeType:'monthly',     mandatory:false },
        { re:/^Incidentals?$/i,           name:'Incidentals',        feeType:'situational', mandatory:false },
        { re:/^One[-\s]?Time\s*(?:Fees?|Charges?)?$/i, name:'One-Time Fees', feeType:'one_time', mandatory:false },
        { re:/^Move[-\s]?In/i,            name:'Move-In Fees',       feeType:'one_time',    mandatory:false },
        { re:/^(?:Security\s*)?Deposits?$/i, name:'Deposits',        feeType:'one_time',    mandatory:false },
        { re:/^Pet\s*(?:Fees?|Policies?)?$/i, name:'Pet Fees',       feeType:'monthly',     mandatory:false },
      ];

      const parsedBuckets = [];
      let curBucket = null, curCat = null, curFee = null;

      function flushFee() {
        if (!curFee) return;
        if (!curCat) { curCat = { name:(curBucket?curBucket.name:'General')+' Fees', fees:[] }; if (curBucket) curBucket.categories.push(curCat); }
        curCat.fees.push(curFee); curFee = null;
      }

      for (const line of lines) {
        const isBullet = line.startsWith('•');
        const clean = line.replace(/^[•\s]+/,'').trim();
        if (!clean) continue;

        // Bucket header?
        if (!isBullet) {
          const bd = BUCKET_DEFS.find(d => d.re.test(clean));
          if (bd) {
            flushFee();
            curBucket = { name:bd.name, feeType:bd.feeType, mandatory:bd.mandatory, categories:[] };
            curCat    = { name:bd.name+' Fees', fees:[] };
            curBucket.categories.push(curCat);
            parsedBuckets.push(curBucket);
            const remainder = clean.replace(bd.re,'').trim();
            if (remainder && _sfcHasPrice(remainder)) { curFee = _sfcParseFee(remainder, bd.feeType, bd.mandatory); }
            continue;
          }

          // Sub-category line (no price, short, title-like)
          if (curBucket && !_sfcHasPrice(clean) && !_sfcHasPct(clean) && !_sfcHasVaries(clean) && clean.length < 70) {
            flushFee();
            curCat = { name:clean.replace(/:$/,'').trim(), fees:[] };
            curBucket.categories.push(curCat);
            continue;
          }
        }

        // Annotation lines
        if (/^(?:varies\s*by|not\s*required|inclusive\s*of)/i.test(clean)) {
          if (curFee) curFee.desc += (curFee.desc?' ':'')+clean;
          continue;
        }

        // Bedroom-price continuation
        if (_sfcIsBedLine(clean) && curFee) {
          curFee.logic='Unit Type'; curFee.bedroom=true;
          const pm=clean.match(/\$?([\d.,]+)/); const price=pm?pm[1]:'0';
          if (/studio/i.test(clean))                   curFee.bedPrices['Studio']=price;
          if (/one\s*bed|1\s*(br|bed)/i.test(clean))   curFee.bedPrices['1 BR']=price;
          if (/two\s*bed|2\s*(br|bed)/i.test(clean))   curFee.bedPrices['2 BR']=price;
          if (/three\s*bed|3\s*(br|bed)/i.test(clean)) curFee.bedPrices['3+ BR']=price;
          if (/four\s*bed|4\s*(br|bed)/i.test(clean))  curFee.bedPrices['4+ BR']=price;
          continue;
        }

        // Default: parse as a fee line
        if (!curBucket) {
          curBucket = { name:'Fees', feeType:'monthly', mandatory:true, categories:[] };
          curCat    = { name:'General Fees', fees:[] };
          curBucket.categories.push(curCat); parsedBuckets.push(curBucket);
        }
        flushFee();
        curFee = _sfcParseFee(clean, curBucket.feeType, curBucket.mandatory);
      }
      flushFee();

      // Build UI (reverse so first bucket ends up at top after prepend)
      parsedBuckets.reverse().forEach(bucket => {
        const bId = createNewBucket(bucket.name);
        bucket.categories.forEach(cat => {
          if (!cat.fees.length) return;
          const cId = addCategory(bId, cat.name);
          cat.fees.forEach(fd => addFeeRow(cId, fd));
        });
      });

      showToast('Auto-filled — review and save!', 'success');
    } catch (err) {
      console.error('Auto-Fill Error:', err);
      showToast('Auto-fill error — check console.', 'error');
    }
  }

  // ─── Build Payload ────────────────────────────────────────────────────────
  function buildPayload() {
    const payload = { globalPropertyDisclaimers: document.getElementById('globalDisclaimers').value, buckets: [] };
    let bi=1;
    document.querySelectorAll('.bucket-container').forEach(bucket => {
      const bucketObj = {
        orderIndex: bi++,
        receiptBucket: bucket.querySelector('.bucket-name-input').value,
        bucketDisclaimer: bucket.querySelector('.bucket-header .inline-disclaimer-input')?.value || '',
        categories: []
      };
      let ci=1;
      bucket.querySelectorAll('.category-block').forEach(cat => {
        const catObj = { orderIndex:ci++, categoryName:cat.querySelector('.cat-name-input').value, categoryDisclaimer:cat.querySelector('.cat-disclaimer-input')?.value||'', fees:[] };
        let fi=1;
        cat.querySelectorAll('.fee-card').forEach(card => {
          const logic=card.querySelector('.logic-select').value, isBed=card.querySelector('.bed-toggle').checked;
          let unitPricing={};
          if (isBed) {
            card.querySelectorAll('.unit-chk:checked').forEach(chk => {
              const br=chk.value, w=card.querySelector('.br-'+br.replace(/\s|\+/g,''));
              unitPricing[br]={minPrice:w.querySelector('.br-min-val').value, maxPrice:logic==='Range'?w.querySelector('.br-max-val').value:null};
            });
          }
          catObj.fees.push({
            orderIndex:fi++,
            feeName:card.querySelector('.fee-name-input').value,
            pricingLogic:logic,
            baseMinPrice:isBed?null:card.querySelector('.min-val-field').value,
            baseMaxPrice:(logic==='Range'&&!isBed)?card.querySelector('.max-val-field').value:null,
            percentageTarget:logic==='Percentage'?card.querySelector('.percent-target').value:null,
            isMandatoryDefault:card.querySelector('.mndt-check').checked,
            hasQuantityCounter:card.querySelector('.counter-check').checked,
            qtyMinLimit:card.querySelector('.counter-check').checked?parseInt(card.querySelector('.qty-min').value):null,
            qtyMaxLimit:card.querySelector('.counter-check').checked?parseInt(card.querySelector('.qty-max').value):null,
            variesByBedroom:isBed,
            bedroomPricing:isBed?unitPricing:null,
            displayText:card.querySelector('.desc-input').value,
            preSelectionInfo:card.querySelector('.pre-info-input').value,
            postSelectionInfo:card.querySelector('.post-info-input').value,
            feeFrequency:card.querySelector('.freq-select').value,
            multiplier:card.querySelector('.multiplier-select').value,
            isBasePrice:card.querySelector('.base-price-check')?.checked||false
          });
        });
        bucketObj.categories.push(catObj);
      });
      payload.buckets.push(bucketObj);
    });
    return payload;
  }

  function exportJSON() {
    document.getElementById('exportResult').value = JSON.stringify(buildPayload(), null, 2);
    document.getElementById('exportModal').style.display = 'flex';
  }
  function copyJSON() {
    const el=document.getElementById('exportResult'); el.select(); document.execCommand('copy');
    showToast('JSON copied!', 'success');
  }

  // ─── Hydrate from DB on load ──────────────────────────────────────────────
  (function hydrateFromDB() {
    const cfg = #{raw @config_json};
    if (!cfg || !cfg.buckets || !cfg.buckets.length) {
      if (COMMUNITY_ADDITIONAL_FEE) {
        setTimeout(() => seedFromCommunityFees(), 100);
      }
      return;
    }
    document.getElementById('globalDisclaimers').value = cfg.globalPropertyDisclaimers || '';
    cfg.buckets.forEach(b => {
      const bId = createNewBucket(b.receiptBucket, b.bucketDisclaimer||'');
      (b.categories||[]).forEach(c => {
        const cId = addCategory(bId, c.categoryName, c.categoryDisclaimer||'');
        (c.fees||[]).forEach(f => {
          const bp={};
          if (f.bedroomPricing) Object.entries(f.bedroomPricing).forEach(([k,v]) => {
            bp[k] = typeof v==='object' ? v : {minPrice:v, maxPrice:v};
          });
          // Legacy schema migration
          let frequency = f.feeFrequency || (b.feeType==='one_time'?'One-Time':'Monthly');
          let multiplier = f.multiplier || (f.perApplicant?'Per Applicant':f.perPet?'Per Pet':'None');
          addFeeRow(cId, {
            name:f.feeName, logic:f.pricingLogic, val1:f.baseMinPrice||'', val2:f.baseMaxPrice||'',
            mndt:f.isMandatoryDefault, counter:f.hasQuantityCounter,
            qMin:f.qtyMinLimit||1, qMax:f.qtyMaxLimit||2,
            bedroom:f.variesByBedroom, bedPrices:bp,
            desc:f.displayText||'', preInfo:f.preSelectionInfo||'', postInfo:f.postSelectionInfo||'',
            frequency, multiplier, isBasePrice:!!f.isBasePrice
          });
        });
      });
    });
  })();

  // ─── Populate All Scenarios (test data) ──────────────────────────────────
  function populateAllScenarios() {
