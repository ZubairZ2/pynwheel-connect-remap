.modal-dialog.modal-lg
  .modal-content
    = form_for @amenity,url: community_floorplan_amenity_path(@community,@floorplan,@amenity),method: :put do |f|
      .modal-body
        .image-crop{:style=>"max-height: fit-content;"}
          - rn =  rand(9999999999999999999999999)
          = image_tag (@amenity.crop_x.present? ? @amenity.image.url + "?timestamp=#{rn}" : @amenity.image.url + "?timestamp=#{rn}"), id: "cropbox"
          - %w[x y w h].each do |attribute|
            = f.hidden_field "crop_#{attribute}"
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
            %i.fa.fa-close
        
        .form-group
          %label{:for => "exampleInputEmail1"} Image Title
          = f.text_field :name , class: "form-control", placeholder: "Name"

        .form-group
          %label
            Description
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "propertyDetailAddressPopover","data-content" => " "}
              %span#propertyDetailNameText
                This description will appear above the image. Only the first #{ENV["DESCRIPTION_LIMIT"].to_i} characters will appear on the page with the image; the rest of the description can be accessed by pulling up a separate page in the app.

          = f.text_area :description, :class=>"form-control amenity_edit_field amenity_edit_wysihtml5", :placeholder=>"Description"
          <!-- %span.amenity_description_count{:style => "float: right; margin: 10px 15px 0px 0px;"} Character limit: #{ENV["DESCRIPTION_LIMIT"].to_i} -->
          %span#characterLimitCount{:style => "display: none"} #{ENV["DESCRIPTION_LIMIT"].to_i}
        .form-group
          %button.btn.btn-success.pull-right.btn-sm.mt-20.mb-20#crop_image{:type => "submit"}
            Apply Changes
            %i.fa.fa-check
        .clearfix

:javascript
  var characterLimit = parseInt("#{ENV["DESCRIPTION_LIMIT"]}")
  $('.amenity_edit_wysihtml5').each(function(i, elem) {
        $(elem).wysihtml5({'toolbar': {'image': false,'link' : false, 'emphasis' : false},
        events: {
            load:function(){
                $('.wysihtml5-sandbox').contents().find('body').on("keydown",function(event) {
                  if (wysihtml5Editor.getValue() != "")
                  {
                    var text_split = $('.amenity_description_count').text().split(" ")
                    var total_length = wysihtml5Editor.getValue().replace(/<(?:.|\n)*?>/gm, '').replace(/(\r\n|\n|\r)/gm,"").replace(/\&nbsp;/g, '').length
                    $('.amenity_description_count').text( text_split[0] + " " + text_split[1] + " " + (characterLimit - total_length)).toString()
                  }
                });
                var wysihtml5Editor = $('#amenity_description').data("wysihtml5").editor;
                var t = wysihtml5Editor.getValue();
                if(t!= '')
                {
                  t1 = t.substr(0, characterLimit)
                  t2 = t.substr(characterLimit, t.length)
                  <!-- t2 = t2.fontcolor("red"); -->
                  wysihtml5Editor.setValue(t1 + t2);
                  var text_split = $('.amenity_description_count').text().split(" ")
                  var total_length = wysihtml5Editor.getValue().replace(/<(?:.|\n)*?>/gm, '').replace(/(\r\n|\n|\r)/gm,"").replace(/\&nbsp;/g, '').length
                  $('.amenity_description_count').text( text_split[0] + " " + text_split[1] + " " + (characterLimit - total_length)).toString()
                }
            },
        change: function() {
            $('.amenity_edit_field').change();
        }
        }
        });
    });
  $("#crop_image").on("click",function(e){
    $(".divLoading").removeClass("hidden");
    localStorage.setItem("galleryCropped", "1");
  });

  $('#cropbox').Jcrop({

  boxWidth: 600, boxHeight: 550,
    onSelect: update_crop,
    onChange: update_crop,
  });


  function update_crop(coords){
    console.log(coords);
    var ratioW = $('#cropbox')[0].naturalWidth / $('#cropbox').width();
    var ratioH = $('#cropbox')[0].naturalHeight / $('#cropbox').height();
    var currentRatio = Math.min(ratioW, ratioH);
    //$('#gallery_image_crop_x').val(Math.round(coords.x * currentRatio));
    $('#amenity_crop_x').val(coords.x);
    //$('#gallery_image_crop_y').val(Math.round(coords.y * currentRatio));
    $('#amenity_crop_y').val(coords.y);
    //$('#gallery_image_crop_w').val(Math.round(coords.w * currentRatio));
    $('#amenity_crop_w').val(coords.w);
    //$('#gallery_image_crop_h').val(Math.round(coords.h * currentRatio));
    $('#amenity_crop_h').val(coords.h);
    console.log(coords.x);
    console.log(coords.y);
    console.log(coords.w);
    console.log(coords.h);
  }

  function update_preview(coords){
  var width = Math.round(100/coords.w * $('#cropbox').width()) + 'px';
  var height = Math.round(100/coords.h * $('#cropbox').height()) + 'px';
  var margin_left = '-' + Math.round(100/coords.w * coords.x) + 'px';
  var margin_top = '-' + Math.round(100/coords.h * coords.y) + 'px';
  $('#preview').css({"width": width,"height": height,"marginLeft": margin_left,"marginTop": margin_top});
  }
}