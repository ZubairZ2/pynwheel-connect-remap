%link{:crossorigin => "anonymous", :href => "https://use.fontawesome.com/releases/v5.7.2/css/all.css", :integrity => "sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr", :rel => "stylesheet"}/
= render '/font_awesome_v5'
- content_for :title, "Plot Images - Pynwheel"
%section.is-amenity
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    = link_to "<Back to All Floor Plans", community_floorplans_path(@community), class: "btn btn-primary ", style: "background: #8f4a9c; color: white;"
    %h4{:style => "color: grey;"}
      If no images appear in the list, there are no available images to plot.
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Plot Floor
          %span Plan Images
          %span.hidden#active_x_plot 0
          
          %span.hidden#active_y_plot 0

          - marker_font_size = @community.design.amenity_map_marker_size_integer
          - if @community.theme_name.include?('gables')
            - marker_color = @community.design.gables_unit_floorplan_map_marker_color.present? ? @community.design.gables_unit_floorplan_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'modernist'
            - marker_color = @community.design.modernist_unit_floorplan_map_marker_color.present? ? @community.design.modernist_unit_floorplan_map_marker_color : (@community.design.primary_color.present? ? @community.design.primary_color : "#CF492F")
          - elsif @community.theme_name == 'futurist'
            - marker_color = @community.design.futurist_unit_floorplan_map_marker_color.present? ? @community.design.futurist_unit_floorplan_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'expressionist'
            - marker_color = @community.design.expressionist_unit_floorplan_map_marker_color.present? ? @community.design.expressionist_unit_floorplan_map_marker_color : "#d37474"
          - elsif @community.theme_name == 'panther'
            - marker_color = @community.design.panther_unit_floorplan_map_marker_color.present? ? @community.design.panther_unit_floorplan_map_marker_color : "#d37474"
          - else
            - marker_color = 'rgba(247, 0, 0, 0.61)'
          -#- marker_color = @community.theme_name.include?('gables') ? @community.design.amenity_map_marker_color : (@community.theme_name == 'modernist' ? (@community.design.modernist_map_marker_color == 'no color' || @community.design.modernists_amenity_map_marker_color == '' ? (@community.design.primary_color.present? ? @community.design.primary_color : '#cf492f') : @community.design.modernists_amenity_map_marker_color) : 'rgba(247, 0, 0, 0.61)')
          - marker_font_size = marker_font_size -5
          - marker_font_size = 27
          - camera_font_size = marker_font_size / 2
          - camera_margin = (@community.design.amenity_map_marker_size_integer <= 27 ? 3 : (@community.design.amenity_map_marker_size_integer <= 30 ? 4 : (@community.design.amenity_map_marker_size_integer <= 33 ? 5 : (@community.design.amenity_map_marker_size_integer <= 35 ? 6 : 6))))
          - camera_margin = 5
          %span.hidden#marker_font_size #{marker_font_size}
          %span.hidden#marker_color #{marker_color}
          %span.hidden#camera_margin #{camera_margin}

        .pull-right.btn-btn-danger
          = link_to "Back", community_floorplan_amenities_path(@community,@sitemap), class: "btn btn-primary"
          %a.btn.btn-danger{"data-name" => "floorplan's images plots", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/floorplans/#{@sitemap.id}/amenities/remove_amenities_plot#{is_svg ? '?svg_deletion=true' : ''}"} Reset all plots
      / /.box-header
      / form start
      %form.form-horizontal
        .box-body.map-body-top
          .row
            .col-lg-9#container{:style => "float: right;"}
              .map-block{:style=>"position: relative;"}
                #map.plot-image
                  = image_tag @sitemap.present? ? @sitemap.image.url : ""
                  - @amenities.each do |amenity|
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0
                      = link_to "<i class='custom-icon' style=' height:#{marker_font_size}px; width: #{marker_font_size}px; border: 2px solid  #{marker_color};'  ><i class='fas fa-camera-retro' style=' font-size:#{camera_font_size}px; color: #{marker_color}; margin-top:#{camera_margin}px;'  ></i></i>".html_safe, "#", :class => "marker", 'data-toggle' => "tooltip", :title => amenity.name, :id => "m_#{amenity.id}", :style => "left:#{amenity.x_plot}px; top:#{amenity.y_plot}px; position:absolute;", "data-name" => "plot", "data-target" => "#confirm-delete", "data-toggle" => "modal", "data-href" => "/communities/#{@community.id}/floorplans/#{@sitemap.id}/amenities/#{amenity.id}/remove_amenity"
              .pull-right
                -#= link_to "Done!", community_floorplans_path(@community), class: "btn btn-primary mt-15"
            .col-lg-3
              %h5.mt-40.mb-20 SELECT IMAGES TO PLOT
              .imageselect
                .show-categories
                  = "-- select image --"
                %ul#imageselect{:style => "display: none;"}
                  - amenity_arr = []
                  - @amenities.each do |amenity|
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i == 0
                      %li{"data-id" => "#{amenity.id}","data-name" => "#{amenity.name}"}
                        %a
                          = image_tag amenity.image.present? ? amenity.image.url : "upload-image.png"
                          %span.ml-5
                            = amenity.name
                    - if amenity.x_plot.to_i + amenity.y_plot.to_i > 0        
                      - amenity_arr.push({providerId: amenity.id.to_s, xPlot: amenity.x_plot.to_i, yPlot: amenity.y_plot.to_i, name: amenity.name})
              %h5.mt-40 SELECTED IMAGES
              .add-plan.mt-10.mb-20
                %ul#selected-units
              / %button.btn.btn-success#new{:type => "button"} PLOT NOW
              %label#newmsg Place marker for selected images on Map
        #map-marker{"data-toggle" => "tooltip", :onclick => "selMarker()", :title => "new marker"}
          %i.icon-screenshot

    ////////////// Amenity Grid
  .box.box-widget.panel-box{:style => "margin-bottom: 80px;"}
    .row
      .col-md-12
        %table.table.table-bordered.table-striped.table-hover.table-responsive
          %thead
            %tr
              %th{:width => "79"} Sr #
              %th Tour Stop
          %tbody.amenity_sortable_list
            - orderVar = 0
            - if @sitemap.amenities.present?
              - sortable_fetch(@sitemap.amenities.order(:sort)) do |amenity,index|
                - unless amenity.x_plot.to_i + amenity.y_plot.to_i == 0
                  %tr{:id=> index}
                    - orderVar = orderVar + 1
                    %td= orderVar
                    %td
                      = amenity.name
.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "floorplan_plotting_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
:javascript
  $(document).ready(function () {
    document.addEventListener("touchstart", touchHandler, true);
    document.addEventListener("touchmove", touchHandler, true);
    document.addEventListener("touchend", touchHandler, true);
    document.addEventListener("touchcancel", touchHandler, true);
    let elem = document.querySelector('#map');
    const key = `${elem.tagName.toLowerCase()}-${elem.id}`
    if (window.mapPanZoom) {
      window.mapPanZoom[key] = panzoom(elem, {
        minZoom: 0.5,
        maxZoom: 1.0,
        bounds: true,
        boundsPadding: 0.3
      })
    } else {
      window.mapPanZoom = {
        [key]: panzoom(elem, {
          minZoom: 0.5,
          maxZoom: 1.0,
          bounds: true,
          boundsPadding: 0.3
        }),
      };
    }

    var transform = mapPanZoom?.[key] ? mapPanZoom[key].getTransform() : {};
    var scaleFactor = (1 / (transform.scale || 1));
    var previous_scale = 0;
    while($('#map').width()/scaleFactor > $('.map-block').width()  || $('#map').height()/scaleFactor > $('.map-block').height()){
       mapPanZoom[key].zoomInOut(189);
           transform = mapPanZoom[key] ? mapPanZoom[key].getTransform() : {};
           scaleFactor = (1 / (transform.scale || 1));
           if(scaleFactor === previous_scale)
           {
            break;
           }
           previous_scale = scaleFactor
    }
    mapPanZoom[key].moveTo(0,0);
  })

  function touchHandler(event) {
    var touch = event.changedTouches[0];

    var simulatedEvent = document.createEvent("MouseEvent");
        simulatedEvent.initMouseEvent({
        touchstart: "mousedown",
        touchmove: "mousemove",
        touchend: "mouseup"
    }[event.type], true, true, window, 1,
        touch.screenX, touch.screenY,
        touch.clientX, touch.clientY, false,
        false, false, false, 0, null);

    touch.target.dispatchEvent(simulatedEvent);
    // event.preventDefault();
  }
  var floor = null;
  var unitsArr = #{raw amenity_arr.to_json}
  var lmargin = 0
  var rmargin = 0
  var community_id = #{params[:community_id]}
  var addmode = false;
  var floorplan_id = #{@sitemap.id}
  var amenity_type = "floorplan"
  $('.amenity_sortable_list').railsSortable();
  function floorplan_plotting_goBack()
  {
    if (window.history.length)
    {
    window.location.reload();
    }
    else
    {
    window.history.back();
    }
  }

:css
  @media (max-width: 1200px) {
    .map-body-top > div.row {
      flex-direction: column;
    }
  }

  .overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background-color: #fff;
    opacity: .9;
    display:none;
  }
