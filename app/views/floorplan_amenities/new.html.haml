- content_for :title, "Add Image - Pynwheel"
%section
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
    .box.box-info.add-plan
      .box-header
        %h3.box-title
          Add
          %span Image

      = form_for @amenity,:url=>community_floorplan_amenities_path(@community,@floorplan),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'shared/amenity_form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , community_floorplan_amenities_path(@community,@floorplan), :class=>"btn btn-default pull-right"
          = f.submit "ADD IMAGE", :class=>"btn btn-success pull-right mr-10"