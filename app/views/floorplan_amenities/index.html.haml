- content_for :title, "Images - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title 
              = @floorplan.name + " Floor Plan Images"
            = link_to "Plot Images on Floor Plan", plot_amenities_community_floorplan_amenities_path(@community,@floorplan), class: "btn btn-primary mb-20", id: "amenity_image"
          .col-md-6
            .mt-35
              %span.btn.btn-success.btn-file.pull-right.mb-20
                %i.fa.fa-plus-circle
                Add Image
                %input#floorplan-amenity-images{:multiple => "multiple", :type => "file"}/ 
            .divLoading.hidden
        #images-index
          = render :partial=>'index'
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  var floorplan_id = #{@floorplan.id}
  
  if(#{@floorplan.amenities.count} == 0)
  {
    $('#amenity_image').hide();
  }
  if(#{@floorplan.amenities.count.to_i} > 0)
  {
    $('#amenity_image').show();
  }
  $('.row').bind("DOMSubtreeModified",function(){
     location.reload();
  });