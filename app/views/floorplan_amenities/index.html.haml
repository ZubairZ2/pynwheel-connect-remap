- content_for :title, "Images - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-columns
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-lg-12
            = link_to "<Back to All Floor Plans", community_floorplans_path(@community), class: "btn btn-primary mt-20", style: "background: #8f4a9c; color: white;"
          .col-md-12
            %h4.title 
              = @floorplan.name + " Floor Plan Images"
            %h4{:style => "color: grey;"}
              %p
                Use the “Add Image” button or drag & drop area below to import images associated with the floor plan.
              %p  
                Once images have been added, a button will appear to allow you to plot them on the floor plan.
            = link_to "PLOT IMAGES ON FLOOR PLAN", plot_amenities_community_floorplan_amenities_path(@community,@floorplan), class: "btn btn-primary mb-20", id: "amenity_image"
          .col-md-6
            .mt-35
              %span.btn.btn-success.btn-file
                %i.fa.fa-plus-circle
                ADD IMAGE
                %input#floorplan-amenity-images{:multiple => "multiple", :type => "file"}/
              %i.propertyDetailName.fa.fa-question-circle
                %span#propertyDetailNameText
                  Import photos or renderings here associated with the floor plan here. After you import an image, you will be able to plot a marker on the floor plan image. For example, add an image of the kitchen and then plot a marker for the image in the kitchen.
            .divLoading.hidden
        #images-index
          = render :partial=>'index'
.row
  .col-md-12{:style => "bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "floorplan_edit_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE
#edit-image.modal.fade.edit-image
:javascript
  var community_id = #{params[:community_id]}
  var floorplan_id = #{@floorplan.id}
  
  if(#{@floorplan.amenities.count} == 0)
  {
    $('#amenity_image').hide();
  }
  if(#{@floorplan.amenities.count.to_i} > 0)
  {
    $('#amenity_image').show();
  }
  $('.row').bind("DOMSubtreeModified",function(){
     location.reload();
  });
  function floorplan_edit_goBack()
  {
     if (window.history.length == 1)
     {
      window.location.reload();
     }
     else
     {
      window.history.back();
     }
  }
