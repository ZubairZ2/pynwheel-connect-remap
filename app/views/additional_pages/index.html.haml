- content_for :title, "Additional Pages - Pynwheel"
.divLoading.hidden
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-star
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          ADDITIONAL PAGES
          %span
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .box.box-widget.panel-box
          .row
            .col-md-12
              %table.table.table-bordered.table-striped.table-hover.table-responsive
                %thead
                  %tr
                    %th{:width => "79"} Sr #
                    %th Name
                    %th Type
                    %th Position
                    %th Add to Home Page Menu
                    %th{:width => "100"}
                      Actions
                      %i.additionalPageAction.fa.fa-question-circle{ "data-toggle" => "additionalPageGridActionsPopover","data-content" => " "}
                        %span#additionalPageActionText
                          Click the edit icon to view or change the details associated with each page including its name; whether or not it will appear in the Pynwheel app; whether or not it will appear in the home page menu; and in what position it will appear on the home page menu.
                %tbody
                  - @pages.each_with_index do |page,index|
                    %tr
                      %td= index+1
                      %td
                        = link_to page.name, page.is_a?(Imagepage) ? community_imagepage_path(@community,page) : '#'
                      %td= page.class
                      %td= page.position
                      %td= page.display_on_homepage ? "Yes" : "No"
                      %td
                        - if page.is_a? Webpage
                          = link_to edit_community_contentpage_path(@community,page), remote: true, class: "text-success ml-5" do
                            %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Page","data-href" => "/communities/#{@community.id}/contentpages/#{page.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size
                        - else
                          = link_to edit_community_imagepage_path(@community,page), remote: true, class: "text-success ml-5" do
                            %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Page","data-href" => "/communities/#{@community.id}/imagepages/#{page.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size
                          %a.text-blue.ml-5{:href => "#{community_imagepage_path(@community,page)}"}
                            %i.fa.fa-eye
        .row
          .col-md-12
            = link_to new_community_contentpage_path(@community), remote: true, class: "btn btn-success mb-10" do
              %i.fa.fa-plus-circle
              ADD WEBPAGE
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "AdditionalPageAddWebpagePopover","data-content" => " ", :style => "padding-left: 5px;"}
              %span#propertyDetailNameText{:style => "width: 400px"}
                Click "Add Webpage" to add a webpage such as a 3D
                %br
                tour or integration such as TransitScreen or BuildingLink.
            = link_to new_community_imagepage_path(@community), remote: true, class: "btn btn-primary mb-10 ml-10" do
              %i.fa.fa-plus-circleEnter
              ADD IMAGE PAGE
            %i.propertyDetailName.fa.fa-question-circle{ "data-toggle" => "AdditionalPageAddImagepagePopover","data-content" => " ", :style => "padding-left: 5px;"}
              %span#propertyDetailNameText{:style => "width: 400px"}
                Click "Add Image Page" to add an image page such as an
                %br
                "About Page" static image, sliding image, or slide show.
          -#.col-lg-12.col-md-12
          -#  %button.btn-primary.done_btn{:onclick => "additional_goBack()"}
          -#    DONE
      / End Panel left Side
/ /.content
#show_modal
.row
  .col-md-12{:style => "position: absolute; bottom: 51px;"}
    .box-footer.mt-30.pt-15
      .row
        .col-lg-10
          .form-group{:style => "margin-left: -16px;  margin-bottom: 0px;"}
            .col-md-12.col-lg-12
              %button.btn-primary.done_btn.mb-20{:onclick => "additional_goBack()",:style => " margin-top: 0px;  margin-bottom: 0px;"}
                DONE

:javascript
  if (!#{current_user.welcome_additional_page})
  {
    $('[data-toggle="additionalPageGridActionsPopover"]').popover({
        placement: 'left',
        html: true,
        template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding" style="color: black;">Click the edit icon to view or change the details associated with each page including its name; whether or not it will appear in the Pynwheel app; whether or not it will appear in the home page menu; and in what position it will appear on the home page menu.</div><div class="popover-footer"><a id="additionalPageGridActionsPopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
    }).popover('show');
  }
  function additional_goBack()
  {
      window.location.reload();
  }

    $(document).on("click", "#additionalPageGridActionsPopoverClose" , function(){
     $('#addWebpage').modal('show');
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="AdditionalPageAddWebpagePopover"]').popover({
            html: true,
            template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding"  style="color: black;">Click "Add Webpage" to add a webpage such as a 3D tour or integration such as TransitScreen or BuildingLink.</div><div class="popover-footer"><a id="AdditionalPageAddWebpagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
    });
    $(document).on("click", "#AdditionalPageAddWebpagePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        $('[data-toggle="AdditionalPageAddImagepagePopover"]').popover({
            html: true,
            template: '<div class="popover"><div class="arrow"></div><div class="popover-body popover-padding"  style="color: black;">Click "Add Image Page" to add an image page such as an "About Page" static image, sliding image, or slide show.</div><div class="popover-footer"><a id="AdditionalPageAddImagepagePopoverClose" href="#" class="btn btn-info btn-sm">OK</a></div></div>'
        }).popover('show');
    });
    $(document).on("click", "#AdditionalPageAddImagepagePopoverClose" , function(){
        $(this).parents(".popover").popover('hide');
        $(this).parents(".popover").addClass('hidden');
        #{current_user.welcome_additional_page = true}
        #{current_user.save}
    });