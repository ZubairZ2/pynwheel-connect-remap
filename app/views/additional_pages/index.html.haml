- content_for :title, "Additional Pages - Pynwheel"
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-star
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          ADDITIONAL PAGES
          %span
    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .box.box-widget.panel-box
          .row
            .col-md-12
              %table.table.table-bordered.table-striped.table-hover.table-responsive
                %thead
                  %tr
                    %th{:width => "79"} Sr #
                    %th Name
                    %th Type
                    %th Position
                    %th Add to Home Page Menu
                    %th{:width => "100"}
                      Actions
                      %i.additionalPageAction.fa.fa-question-circle
                        %span#additionalPageActionText
                          Click the edit icon to view or change the details associated with each page including its name; whether or not it will appear in the Pynwheel app; whether or not it will appear in the home page menu; and in what position it will appear on the home page menu.
                %tbody
                  - @pages.each_with_index do |page,index|
                    %tr
                      %td= index+1
                      %td
                        = link_to page.name, page.is_a?(Imagepage) ? community_imagepage_path(@community,page) : '#'
                      %td= page.class
                      %td= page.position
                      %td= page.display_on_homepage ? "Yes" : "No"
                      %td
                        - if page.is_a? Webpage
                          = link_to edit_community_contentpage_path(@community,page), remote: true, class: "text-success ml-5" do
                            %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Page","data-href" => "/communities/#{@community.id}/contentpages/#{page.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size
                        - else
                          = link_to edit_community_imagepage_path(@community,page), remote: true, class: "text-success ml-5" do
                            %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Page","data-href" => "/communities/#{@community.id}/imagepages/#{page.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size
                          %a.text-blue.ml-5{:href => "#{community_imagepage_path(@community,page)}"}
                            %i.fa.fa-eye
        .row
          .col-md-12
            = link_to new_community_contentpage_path(@community), remote: true, class: "btn btn-success mb-10" do
              %i.fa.fa-plus-circle
              ADD WEBPAGE
              %i.propertyDetailName.fa.fa-question-circle
                %span#propertyDetailNameText{:style => "width: 400px"}
                  Click "Add Webpage" to add a webpage such as a 3D
                  %br
                  tour or integration such as TransitScreen or BuildingLink.
            = link_to new_community_imagepage_path(@community), remote: true, class: "btn btn-primary mb-10 ml-10" do
              %i.fa.fa-plus-circle
              ADD IMAGE PAGE
              %i.propertyDetailName.fa.fa-question-circle
                %span#propertyDetailNameText{:style => "width: 400px"}
                  Click "Add Image Page" to add an image page such as an
                  %br
                  "About Page" static image, sliding image, or slide show.
      / End Panel left Side
/ /.content
#show_modal

