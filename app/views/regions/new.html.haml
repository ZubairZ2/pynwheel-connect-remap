- content_for :title, "Add Region - Pynwheel"
%section
  .content
    .box.box-info.add-plan.mt-20
      .box-header
        %h3.box-title
          Add
          %span Region

      = form_for @region,:url=>company_regions_path(current_company),:html=>{:class=>"form-horizontal"} do |f|
        .box-body
          .row
            .col-lg-9.col-lg-offset-1
              = render :partial=>'form',:locals=>{:f=>f}
        / /.box-body
        .box-footer
          = link_to "CANCEL" , company_regions_path(current_company), :class=>"btn btn-default pull-right"
          = f.submit "ADD REGION", :class=>"btn btn-success pull-right mr-10"

