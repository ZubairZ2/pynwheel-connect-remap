- content_for :title, "Region - Pynwheel"
/ Main content
.container
  %section
    .row
      .col-md-12
        %h2 Regions
        %h5
          All regions are listed here.
        - if current_user.is_super_admin?
          %p.mb-30
            This Admin feature allows you to directly access any community groups in the system
    .row
      .col-md-12
        .col-md-6
          .mt-35
            %a.btn.btn-success.mb-20{:href => "/companies"}
              List all Companies

    .box.box-widget.panel-box
      #new-search-area
      %table#regions.table.table-hover.table-responsive
        %thead
          %tr
            %th Regions
            %th{:width => "250"} Company
            %th{:width => "250"} Actions
        %tbody
          - @regions.each do |region|
            %tr
              %td
                %h4.h4
                  = link_to region.name, company_region_path((Company.find region.company_id).id, region.id)
              %td
                %h5.h5
                  = region.company.name rescue ""
              %td
                = link_to edit_company_region_path(current_company.id,region.id), :class => "text-success"  do 
                  %i.fa.fa-edit.icon_size

                %a.text-danger{"data-name"=>"region","data-href" => "/companies/#{(Company.find region.company_id).id}/regions/#{region.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                  %i.fa.fa-trash.icon_size
