- content_for :title, "Region - Pynwheel"
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-group
        = @region.name.capitalize

    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-6
            %h4.title Communities
          .col-md-6
            .mt-35
              - if current_user.is_super_admin? || current_user.is_dwelo_admin?
                = link_to edit_company_region_path(current_company.id, @region),:class=>"btn btn-success pull-right mb-20 mr-10" do
                  %i.fa.fa-plus-circle
                  EDIT REGION
            .divLoading.hidden
        .box.box-widget.panel-box
          .box-header

            .row
              .col-md-12
                %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive
                  %thead
                    %tr
                      %th{:width => "79"} Sr #
                      %th Community Name
                      %th{:width => "250"} Actions
                  %tbody
                    - alphabetical_sort(@region.communities).each_with_index  do |f,index|
                      %tr
                        %td
                          = index+1
                        %td
                          = link_to f.name, edit_company_community_path((Company.find f.company_id),f)
                        %td
                          %a.text-danger{"data-name"=>"Community","data-href" => "/companies/#{current_company.id}/regions/#{@region.id}/remove_community?community=#{f.id}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"}
                            %i.fa.fa-trash.icon_size

      / End Panel left Side
      / Start Panel Right Side
      .col-lg-4.col-md-12
        .row
          .col-md-12