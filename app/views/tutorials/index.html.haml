- content_for :title, "Tutorial Page - Pynwheel"
.divLoading.hidden
/ Main content
%section
  .content
    .title-heading
      %h4
        %i.fa.fa-image
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code
    .box.box-info.add-plan.mt-20#logo_header
      .box-header
        %h3.box-title
          TUTORIAL
          %span
    .row{:style => "margin-bottom: 70px;"}
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12#outer_div
            .box.box-widget.panel-box.add-plan.pt-30
            
              %table#miyazaki.table.table-bordered.table-striped.table-hover.table-responsive.units.tour_user_table
                %thead
                  %tr
                    %th
                      Sr
                    %th
                      Name
                    %th
                      Description
                    %th
                      Video
                    %th
                      Uploaded at
                    %th
                      Action

              
                %tbody
                  - @tutorials.each_with_index  do |t,index|
                    .row
                      %tr
                        %td.col-lg-2
                          = index + 1
                        %td.col-lg-2
                          = t.name
                        %td.col-lg-2
                          = t.description
                        %td.col-lg-2
                          = t.created_at
                        %td.col-lg-2
                          - if t.video.present?
                            = video_tag t.video.url , :controls => true, :autobuffer => true,:type => "video/mp4", :width => "400px"
                        %td
                          %a.text-success{:href => "#{edit_community_tutorial_path(@community,t)}"}
                            %i.fa.fa-edit.icon_size
                          %a.text-danger{"data-name"=>"Tutorial","data-href" => "#{community_tutorial_path(@community,t)}", "data-target" => "#confirm-delete", "data-toggle" => "modal", :href => "javascrip::;"} 
                            %i.fa.fa-trash.icon_size  
                    

    = link_to new_community_tutorial_path(@community), class: "btn btn-primary mr-5", id: "add-tutorial", :style => "font-weight: bold;" do
      %i.fa.fa-plus-circle
      ADD TUTORIAL