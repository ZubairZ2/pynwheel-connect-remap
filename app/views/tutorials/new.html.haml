= render '/font_awesome_v5'
.divLoading.hidden
- content_for :title, "Add Tutorial - Pynwheel"
%section.is-amenity
  .content
    .title-heading.mb-25
      %h4
        %i.fa.fa-map-marker
        = @community.name.capitalize
        %br
          %small.text-primary
            = @community.code

    .row
      / Start Panel left Side
      .col-lg-12.col-md-12
        .row
          .col-md-12
            .box.box-widget.panel-box.add-plan.pt-30
              .form-group{:style => "margin-left: 40px;"}
                = form_for @tutorial,:url=>"/communities/#{@community.id}/tutorials",:html=>{:class=>"form-horizontal tutorial-form"} do |f|
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Name
                    .col-sm-12.col-lg-6.col-md-6.col-xs-12
                      = f.text_field :name, :maxlength=>"90", :class=>"form-control save-tutorial-field validate[required]", :placeholder => "Name"
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Description
                    .col-sm-12.col-lg-6.col-md-6.col-xs-12
                      = f.text_area :description, :class=>"form-control save-tutorial-field", :placeholder => "Description", :rows => "5"
                  .form-group
                    %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
                      Product Line
                    .col-sm-12.col-lg-3.col-md-3.col-xs-12
                      .checkbox
                        = f.check_box :pynwheel_touch, :class=>"form-control save-tutorial-field" 
                        %label Pynwheel Touch
                    .col-sm-12.col-lg-3.col-md-3.col-xs-12
                      .checkbox
                        = f.check_box :pynwheel_maps, :class=>"form-control save-tutorial-field" 
                        %label Pynwheel Maps
                    .col-sm-12.col-lg-3.col-md-3.col-xs-12
                      .checkbox
                        = f.check_box :self_tour, :class=>"form-control save-tutorial-field" 
                        %label Pynwheel Tour
                  / .form-group
                  /   .col-sm-12.col-lg-6.col-md-6.col-xs-12
                  /     %span.btn.btn-success.btn-file.text-UP#file-load
                  /       %i.fa.fa-plus-circle
                  /       Add Video
                  .col-sm-12.col-lg-12.col-md-12.col-xs-12
                    .box-footer
                    = f.submit "SAVE CHANGES", :class=>"btn btn-success pull-right mr-10 "      
      
                  
                  = submit_tag 'Save', class: "hidden"
    = direct_upload_form_for @uploader, :id => "direct_form" do |f|
      = f.file_field :avatar, :id => "video_field",:class => "hidden"
      = f.submit "Upload Directly!", :id => "video_submit",:class => "hidden"            

:javascript
  $("#file-load").on('click', function(e) {
    $('#video_field').click();
  });
  function home_page_goBack()
  {
    $('#home-page-image-form').submit();
    window.location.reload();

  }

  $("#file-load-drop").on('drop', function(e) {
    // $("#video_submit").click();
  });
  function dropHandler(e)
  {
    if (e.dataTransfer.files[0].size < 500000000)
    {
      if (e.dataTransfer.files[0].type == "video/mp4")
      {
        $(".divLoading").removeClass("hidden");
        e.preventDefault();
        console.log(e.dataTransfer);
        video_field.files = e.dataTransfer.files;
        $("#video_submit").click();
      }
      else
      {
        $('#video-upload-warning').modal('show');
      }
    }
    else
    {
      $('#video-size-warning').modal('show');
    }
  }
  $("#video_field").on('change', function(e) {
    if (e.currentTarget.files[0].size < 500000000)
    {
      if (e.currentTarget.files[0].type == "video/mp4" || e.currentTarget.files[0].type == "video/quicktime")
      {
        $(".divLoading").removeClass("hidden");
        $("#video_submit").click();
      }
      else
      {
        $('#video-upload-warning').modal('show');
      }
    }
    else
    {
      $('#video-size-warning').modal('show');
    }
  });
  $(".divLoading").addClass("hidden");                
  $('.save-tutorial-field1').change(function(){
  $(".divLoading").removeClass("hidden");
    $('.tutorial-form').submit();
  });            