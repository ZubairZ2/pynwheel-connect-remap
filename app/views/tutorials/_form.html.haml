= hidden_field_tag "tutorial_id", @tutorial.id
= hidden_field_tag "community_id", @community.id
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
    Name
  .col-sm-12.col-lg-6.col-md-6.col-xs-12
    = f.text_field :name, :maxlength=>"30", :class=>"form-control save-tutorial-field", :placeholder => "Name"
.form-group
  %label.col-sm-12.col-lg-3.col-md-3.col-xs-12.control-label.font-size-15
    Description
  .col-sm-12.col-lg-6.col-md-6.col-xs-12
    = f.text_field :description, :maxlength=>"15", :class=>"form-control save-tutorial-field", :placeholder => "Latitude"


= submit_tag 'Save', class: "hidden"

.form-group
  %span.btn.btn-success.btn-file.text-UP#file-load
    %i.fa.fa-plus-circle
    Add Video


